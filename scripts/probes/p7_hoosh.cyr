# Probe 7 (port plan P8, §4 step 9; since M8 part 2 the client itself): rasayan's `ai` client (src/ai.cyr and
# src/ai_http.cyr, on sandhi) against the loopback stub scripts/probes/p7_hoosh_stub.py, which answers as hoosh
# 2.12.3 does and records each raw request.
#
# - The same eight calls as the reference client scripts/probes/probe_ai.py (rasayan 1.2.0's BiochemClient on hoosh
#   1.3's HooshClient, read as text): query, chat (three turns), enzyme_query, pathway_query, protein_query, query
#   under a custom system prompt, health and list_models, each through `ry_biochem_client_*`. Each outcome is printed
#   as probe_ai prints Rust's InferenceResponse, Vec<ModelInfo> and health bool, so scripts/probes/p7_compare.py
#   compares the two outputs line for line and the two stub logs request for request (port-parity.md §3, probe 7).
# - tests/ai.tcyr runs every call against a server that is not there; this probe the full exchange.
# - sandhi is included from the pinned toolchain: it is not in [deps] stdlib (cyrius.cyml, [lib.ai]).
#
#   python3 -I -B scripts/probes/p7_hoosh_stub.py 18742 build/p7/cyrius.log 8 &
#   cyrius build scripts/probes/p7_hoosh.cyr build/probes/p7_hoosh && ./build/probes/p7_hoosh http://127.0.0.1:18742

include "lib/sandhi.cyr"
include "lib/bayan.cyr"
include "lib/args.cyr"
include "src/constants.cyr"
include "src/fmtf.cyr"
include "src/error.cyr"
include "src/logging.cyr"
include "src/json.cyr"
include "src/ai_data.cyr"
include "src/ai_client_data.cyr"
include "src/ai.cyr"
include "src/ai_http.cyr"

# Prints a C string as Rust's `{:?}` prints a plain one: quoted (the probe's texts have nothing to escape).
fn _p7_dbg(s): i64 {
    print("\"", 1);
    if (s != 0) { print(s, strlen(s)); }
    print("\"", 1);
    return 0;
}

# One inference call's outcome, printed as probe_ai prints Rust's InferenceResponse (or the error's name).
fn _p7_show(label, t, v, r: *RyInferenceResponse): i64 {
    print(label, strlen(label));
    if (is_err_result(t) == 1) {
        print(": err ", 6);
        var name = ry_error_name(v);
        println(name);
        return 0;
    }
    print(": ok text=", 10);
    _p7_dbg(r.text);
    print(" model=", 7);
    _p7_dbg(r.model);
    print(" usage=", 7);
    fmt_int(r.prompt_tokens);
    print("/", 1);
    fmt_int(r.completion_tokens);
    print("/", 1);
    fmt_int(r.total_tokens);
    print(" provider=", 10);
    _p7_dbg(r.provider);
    print(" latency_ms=", 12);
    fmt_int(r.latency_ms);
    print(" tool_calls=", 12);
    fmt_int(r.tool_calls);
    println("");
    return 0;
}

# The eight calls against the stub at `base`.
fn _p7_online(base): i64 {
    var c: RyBiochemClient;
    ry_biochem_client_new(&c, base, "llama3");
    var r: RyInferenceResponse;
    var t1, v1 = ry_biochem_client_query(&c, "What is the Km of hexokinase for glucose?", &r);
    _p7_show("query", t1, v1, &r);
    var turns[48];                               # three RyMessage records
    store64(&turns, RY_ROLE_USER);
    store64(&turns + 8, "What does PFK-1 do?");
    store64(&turns + 16, RY_ROLE_ASSISTANT);
    store64(&turns + 24, "It phosphorylates fructose 6-phosphate.");
    store64(&turns + 32, RY_ROLE_USER);
    store64(&turns + 40, "And its main allosteric inhibitor?");
    var t2, v2 = ry_biochem_client_chat(&c, &turns, 3, &r);
    _p7_show("chat", t2, v2, &r);
    var t3, v3 = ry_biochem_client_enzyme_query(&c, "hexokinase", &r);
    _p7_show("enzyme_query", t3, v3, &r);
    var t4, v4 = ry_biochem_client_pathway_query(&c, "glycolysis", &r);
    _p7_show("pathway_query", t4, v4, &r);
    var t5, v5 = ry_biochem_client_protein_query(&c, "MKTAYIAKQR", &r);
    _p7_show("protein_query", t5, v5, &r);
    var d: RyBiochemClient;
    ry_biochem_client_new(&d, base, "llama3");
    ry_biochem_client_with_system_prompt(&d, "Answer as a \"textbook\" would.\tUse SI units \\ cite sources.");
    var t6, v6 = ry_biochem_client_query(&d, "Define Kcat.", &r);
    _p7_show("custom_prompt", t6, v6, &r);
    if (ry_biochem_client_health(&c) == 1) { println("health: ok true"); } else { println("health: ok false"); }
    var models = alloc(1024);                    # sixteen RyModelInfo records, on the heap
    var tm, n = ry_biochem_client_list_models(&c, models, 16);
    if (is_err_result(tm) == 1) {
        print("list_models: err ", 17);
        println(ry_error_name(n));
        return 0;
    }
    print("list_models: ok [", 17);
    var i = 0;
    while (i < n) {
        var w = models + 64 * i;
        if (i > 0) { print(", ", 2); }
        print("{id=", 4);
        _p7_dbg(load64(w));
        print(" name=", 6);
        _p7_dbg(load64(w + 8));
        print(" provider=", 10);
        _p7_dbg(load64(w + 16));
        print(" parameters=None context_length=None available=", 47);
        if (load64(w + 56) == 1) { print("true}", 5); } else { print("false}", 6); }
        i = i + 1;
    }
    println("]");
    return 0;
}

fn main(): i64 {
    alloc_init();
    var base = "http://127.0.0.1:18742";
    if (argc() > 1) { base = argv(1); }
    return _p7_online(base);
}

var rr = main();
sys_exit_group(rr);
