# rasayan — src/calcium.cyr: Rust 1.2.0's calcium tests, ported
# Stdlib auto-included via cyrius.cyml
#
# The 17 unit tests of `calcium.rs` and the 2 integration tests (tests/integration.rs) that call only the calcium
# model, as they are written; tests/golden/calcium.tsv checks every method, single tick and trajectory besides. Beyond
# them: the trace event and every codec's round trip.

include "src/constants.cyr"
include "src/constants_private.cyr"
include "src/mathx_data.cyr"
include "src/mathx.cyr"
include "src/fmtf.cyr"
include "src/error.cyr"
include "src/guard.cyr"
include "src/integrate.cyr"
include "src/logging.cyr"
include "src/json.cyr"
include "src/calcium_data.cyr"
include "src/calcium.cyr"

# 1 when the state validates.
fn cs_ok(p: *RyCalciumState) {
    var t, v = ry_calcium_state_validate(p);
    return is_ok(t);
}

# 1 when the config validates.
fn cc_ok(c: *RyCalciumConfig) {
    var t, v = ry_calcium_config_validate(c);
    return is_ok(t);
}

# Rust's test helper `total`: the total amount.
fn total(s: *RyCalciumState): f64 {
    var t: f64 = ry_calcium_state_total_amount(s);
    return t;
}

# `n` ticks at IP3 `ip3` and step `dt`.
fn ticks(s: *RyCalciumState, c: *RyCalciumConfig, n, ip3: f64, dt: f64) {
    var f: RyCalciumFlux;
    var k = 0;
    while (k < n) {
        ry_calcium_state_tick(s, c, ip3, dt, &f);
        k = k + 1;
    }
    return 0;
}

# Rust's test helper `run`: `(seconds / dt).round()` ticks at IP3 `ip3`.
fn run(s: *RyCalciumState, c: *RyCalciumConfig, ip3: f64, dt: f64, seconds: f64) {
    var q: f64 = seconds / dt;
    var r: f64 = f64_round(q);
    var steps = _ry_f64_to_u32(r);
    ticks(s, c, steps, ip3, dt);
    return 0;
}

# 1 when |a − b| < tol.
fn near(a: f64, b: f64, tol: f64) {
    var d: f64 = a - b;
    if (f64_abs(d) < tol) { return 1; }
    return 0;
}

# ── the captured events ──
var _ev_buf[1024];
var _ev_len = 0;

# sakshi's subscriber: keeps the last event's message.
fn _ev_hook(ts, level, category, msg, msg_len, extra) {
    var n = msg_len;
    if (n > 1024) { n = 1024; }
    memcpy(&_ev_buf, msg, n);
    _ev_len = msg_len;
    return 0;
}

# 1 if the last captured event is the C string `want`.
fn _ev_is(want) {
    var n = strlen(want);
    if (_ev_len != n) { return 0; }
    return memeq(&_ev_buf, want, n);
}

# rust src/calcium.rs: test_default_valid, test_validate_rejects_nan_and_zero_divisors
fn validation() {
    test_group("calcium: defaults and validation");
    var s: RyCalciumState;
    var c: RyCalciumConfig;
    ry_calcium_state_default(&s);
    ry_calcium_config_default(&c);
    assert(cs_ok(&s) == 1 && cc_ok(&c) == 1, "the defaults validate");
    var leak: f64 = RY_CALCIUM_PM_CA_LEAK;
    assert(leak > 0.0 && _ry_is_finite(leak) == 1, "PM_CA_LEAK is positive and finite");
    var nan: f64 = _ry_nan();
    var refused = 0;
    var k = 0;
    while (k < 7) {
        ry_calcium_config_default(&c);
        if (k == 0) { c.ip3r_km_ip3 = 0.0; }
        if (k == 1) { c.cicr_km = 0.0; }
        if (k == 2) { c.serca_km = 0.0; }
        if (k == 3) { c.ip3r_inactivation_threshold = 0.0; }
        if (k == 4) { c.ip3r_inactivation_threshold = 0.0 - 1.0; }
        if (k == 5) { c.serca_vmax = nan; }
        if (k == 6) { c.er_leak_rate = nan; }
        if (cc_ok(&c) == 0) { refused = refused + 1; }
        k = k + 1;
    }
    assert_eq(refused, 7, "each of Rust's seven bad configs is refused");
    s.cytoplasmic_ca = nan;
    assert_eq(cs_ok(&s), 0, "a NaN cytosolic Ca2+ is refused");
    return 0;
}

# rust src/calcium.rs: test_ip3_raises_calcium, test_no_ip3_low_calcium, test_serca_returns_ca_to_er, test_bounded
# rust src/calcium.rs: test_negative_ip3_is_zero
fn dynamics() {
    test_group("calcium: the dynamics");
    var s: RyCalciumState;
    var c: RyCalciumConfig;
    var f: RyCalciumFlux;
    ry_calcium_config_default(&c);
    ry_calcium_state_default(&s);
    var initial: f64 = s.cytoplasmic_ca;
    ticks(&s, &c, 100, 1.0, 0.01);
    var raised: f64 = s.cytoplasmic_ca;
    assert(raised > initial, "IP3 raises cytoplasmic Ca2+");
    ry_calcium_state_default(&s);
    ticks(&s, &c, 500, 0.0, 0.01);
    var low: f64 = s.cytoplasmic_ca;
    assert(low < 0.5, "Ca2+ stays low without IP3");
    ry_calcium_state_default(&s);
    s.cytoplasmic_ca = 5.0;
    ry_calcium_state_tick(&s, &c, 0.0, 0.01, &f);
    var up: f64 = f.serca_uptake;
    assert(up > 0.0, "SERCA pumps Ca2+ back to the ER");
    ry_calcium_state_default(&s);
    ticks(&s, &c, 2000, 0.5, 0.005);
    var ca: f64 = s.cytoplasmic_ca;
    var er: f64 = s.er_ca;
    assert(ca >= 0.0 && er >= 0.0 && ca < 100.0, "2000 steps stay non-negative and bounded");
    var a: RyCalciumState;
    var b: RyCalciumState;
    ry_calcium_state_default(&a);
    ry_calcium_state_default(&b);
    ry_calcium_state_tick(&a, &c, 0.0 - 0.4, 0.01, &f);
    ry_calcium_state_tick(&b, &c, 0.0, 0.01, &f);
    var same1 = memeq(&a, &b, 24);
    var nan: f64 = _ry_nan();
    ry_calcium_state_tick(&a, &c, nan, 0.01, &f);
    ry_calcium_state_tick(&b, &c, 0.0, 0.01, &f);
    assert(same1 == 1 && memeq(&a, &b, 24) == 1 && cs_ok(&a) == 1, "a negative or NaN IP3 is no IP3");
    return 0;
}

# rust src/calcium.rs: test_default_state_is_steady_at_rest_for_two_hours, test_store_depletion_and_refill
fn rest_and_stores() {
    test_group("calcium: rest and the store");
    var c: RyCalciumConfig;
    var s: RyCalciumState;
    var f: RyCalciumFlux;
    ry_calcium_config_default(&c);
    ry_calcium_state_default(&s);
    s.ip3r_open = 0.0;
    var start: f64 = total(&s);
    var kept = 0;
    var h = 0;
    while (h < 2) {
        run(&s, &c, 0.0, 1.0, 3600.0);
        if (near(total(&s), start, 0.000000001 * start) == 1) { kept = kept + 1; }
        h = h + 1;
    }
    var ca: f64 = s.cytoplasmic_ca;
    var er: f64 = s.er_ca;
    assert(kept == 2 && near(ca, 0.1, 0.000000001) == 1 && near(er, RY_CALCIUM_ER_CA_REFERENCE, 0.000001) == 1,
      "the closed-IP3R rest holds its total, 0.1 uM and the reference ER for two hours");
    ry_calcium_state_tick(&s, &c, 0.0, 0.01, &f);
    var j_in: f64 = ry_plasma_membrane_influx(s.er_ca);
    var out: f64 = f.pmca_extrusion;
    assert_eq(near(out, j_in, 0.000000001), 1, "influx balances PMCA at rest");
    ry_calcium_state_default(&s);
    run(&s, &c, 0.0, 1.0, 7200.0);
    ca = s.cytoplasmic_ca;
    er = s.er_ca;
    assert(near(total(&s), start, 0.000001 * start) == 1 && near(ca, 0.1, 0.000001) == 1
      && near(er, RY_CALCIUM_ER_CA_REFERENCE, 0.001) == 1, "the default state returns to the same rest");
    ry_calcium_state_default(&s);
    run(&s, &c, 0.5, 0.01, 300.0);
    er = s.er_ca;
    ca = s.cytoplasmic_ca;
    assert(er < 0.5 * RY_CALCIUM_ER_CA_REFERENCE && er > 0.05 * RY_CALCIUM_ER_CA_REFERENCE && ca > 0.3 && ca < 3.0,
      "IP3 0.5 for 5 min: the ER partly empties, SOCE holds a raised plateau");
    var plateau: f64 = s.cytoplasmic_ca;
    run(&s, &c, 0.5, 0.01, 60.0);
    ca = s.cytoplasmic_ca;
    var j_dep: f64 = ry_plasma_membrane_influx(s.er_ca);
    assert(near(ca, plateau, 0.001) == 1 && j_dep > 5.0 * RY_CALCIUM_PM_CA_LEAK, "the plateau is a steady state");
    run(&s, &c, 0.0, 0.05, 300.0);
    er = s.er_ca;
    assert(er > 0.6 * RY_CALCIUM_ER_CA_REFERENCE, "5 min without IP3 refill the store past 60 %");
    run(&s, &c, 0.0, 0.05, 3300.0);
    er = s.er_ca;
    ca = s.cytoplasmic_ca;
    assert(near(er, RY_CALCIUM_ER_CA_REFERENCE, 0.02 * RY_CALCIUM_ER_CA_REFERENCE) == 1 && near(ca, 0.1, 0.01) == 1
      && cs_ok(&s) == 1, "an hour on, the store and cytosol are back at rest");
    return 0;
}

# rust src/calcium.rs: test_amount_changes_only_through_plasma_membrane, test_er_change_uses_volume_ratio
# rust src/calcium.rs: test_flux_is_mean_rate
fn bookkeeping() {
    test_group("calcium: the amount's bookkeeping");
    var c: RyCalciumConfig;
    var s: RyCalciumState;
    var f: RyCalciumFlux;
    ry_calcium_config_default(&c);
    ry_calcium_state_default(&s);
    var exact = 1;
    var r = 0;
    while (r < 4) {
        var ip3: f64 = 0.0;
        if (r == 1) { ip3 = 0.5; }
        if (r == 2) { ip3 = 1.0; }
        if (r == 3) { ip3 = 0.2; }
        var k = 0;
        while (k < 500) {
            var before: f64 = total(&s);
            var j_in: f64 = ry_plasma_membrane_influx(s.er_ca);
            ry_calcium_state_tick(&s, &c, ip3, RY_CALCIUM_SUBSTEP_MAX_DT, &f);
            var expected: f64 = (j_in - f.pmca_extrusion) * RY_CALCIUM_SUBSTEP_MAX_DT;
            var after: f64 = total(&s);
            var change: f64 = after - before;
            if (near(change, expected, 0.000000000001) == 0) { exact = 0; }
            k = k + 1;
        }
        r = r + 1;
    }
    assert_eq(exact, 1, "the amount changes only by influx − PMCA, to 1e-12 a sub-step");
    var sc: RyCalciumConfig;
    ry_calcium_config_default(&sc);
    sc.er_leak_rate = 0.0;
    sc.pmca_rate = 0.0;
    s.cytoplasmic_ca = 2.0;
    s.er_ca = 300.0;
    s.ip3r_open = 0.0;
    var j0: f64 = ry_plasma_membrane_influx(s.er_ca);
    ry_calcium_state_tick(&s, &sc, 0.0, RY_CALCIUM_SUBSTEP_MAX_DT, &f);
    var pumped: f64 = f.serca_uptake * RY_CALCIUM_SUBSTEP_MAX_DT;
    var er_want: f64 = 300.0 + pumped / RY_CALCIUM_ER_CYTOSOL_VOLUME_RATIO;
    var ca_want: f64 = 2.0 - pumped + j0 * RY_CALCIUM_SUBSTEP_MAX_DT;
    var ext: f64 = f.pmca_extrusion;
    assert(pumped > 0.0 && near(s.er_ca, er_want, 0.000000000001) == 1
      && near(s.cytoplasmic_ca, ca_want, 0.000000000001) == 1 && ext == 0.0,
      "SERCA alone: x out of the cytosol is x / ratio into the ER");
    ry_calcium_state_default(&s);
    var b2: f64 = total(&s);
    ry_calcium_state_tick(&s, &c, 0.5, 2.0, &f);
    var a2: f64 = total(&s);
    var gained: f64 = a2 - b2 + f.pmca_extrusion * 2.0;
    var lo: f64 = RY_CALCIUM_PM_CA_LEAK * 2.0 - 0.000000001;
    var hi: f64 = (RY_CALCIUM_PM_CA_LEAK + RY_CALCIUM_SOCE_MAX) * 2.0 + 0.000000001;
    assert(gained >= lo && gained <= hi, "the mean-rate flux: 2 s of influx between the leak and leak + SOCE");
    return 0;
}

# rust src/calcium.rs: test_plasma_membrane_influx_shape
fn influx() {
    test_group("calcium: plasma-membrane influx");
    var full: f64 = ry_plasma_membrane_influx(RY_CALCIUM_ER_CA_REFERENCE);
    assert_eq(near(full, 0.05, 0.000000000000001), 1, "0.05 uM/s with a full store");
    var empty: f64 = ry_plasma_membrane_influx(0.0);
    var half: f64 = ry_plasma_membrane_influx(RY_CALCIUM_SOCE_K_ER);
    assert(near(empty, RY_CALCIUM_PM_CA_LEAK + RY_CALCIUM_SOCE_MAX, 0.000000000000001) == 1
      && near(half, RY_CALCIUM_PM_CA_LEAK + 0.5 * RY_CALCIUM_SOCE_MAX, 0.000000000000001) == 1,
      "leak + SOCE_MAX empty, half of SOCE at K_ER");
    var inf: f64 = _RY_INF;
    var nan: f64 = _ry_nan();
    var at_inf: f64 = ry_plasma_membrane_influx(inf);
    var at_nan: f64 = ry_plasma_membrane_influx(nan);
    var at_neg: f64 = ry_plasma_membrane_influx(0.0 - 5.0);
    assert(at_inf == RY_CALCIUM_PM_CA_LEAK && at_nan == empty && at_neg == empty,
      "+inf gives the leak alone; NaN and negatives are an empty store");
    var mono = 1;
    var prev: f64 = inf;
    var i = 0;
    while (i <= 100) {
        var fi: f64 = f64_from(i);
        var er: f64 = fi * 10.0;
        var j: f64 = ry_plasma_membrane_influx(er);
        if (j > prev || j < RY_CALCIUM_PM_CA_LEAK) { mono = 0; }
        prev = j;
        i = i + 1;
    }
    assert_eq(mono, 1, "non-increasing in the ER level, never below the leak");
    return 0;
}

# rust src/calcium.rs: test_substepping_matches_fine_steps, test_large_dt_stable_and_non_negative
fn substeps() {
    test_group("calcium: sub-stepping");
    var c: RyCalciumConfig;
    var coarse: RyCalciumState;
    var fine: RyCalciumState;
    ry_calcium_config_default(&c);
    ry_calcium_state_default(&coarse);
    ry_calcium_state_default(&fine);
    ticks(&coarse, &c, 20, 0.5, 0.5);
    ticks(&fine, &c, 1000, 0.5, 0.01);
    assert(near(coarse.cytoplasmic_ca, fine.cytoplasmic_ca, 0.000000001) == 1
      && near(coarse.er_ca, fine.er_ca, 0.000000001) == 1, "20 ticks of 0.5 s are 1000 of 0.01 s");
    var s: RyCalciumState;
    var f: RyCalciumFlux;
    var stable = 1;
    var r = 0;
    while (r < 2) {
        var ip3: f64 = 0.0;
        if (r == 1) { ip3 = 1.0; }
        var d = 0;
        while (d < 7) {
            var dt: f64 = 0.05;
            if (d == 1) { dt = 0.1; }
            if (d == 2) { dt = 1.0; }
            if (d == 3) { dt = 10.0; }
            if (d == 4) { dt = 100.0; }
            if (d == 5) { dt = 1000.0; }
            if (d == 6) { dt = 1000000.0; }
            ry_calcium_state_default(&s);
            var k = 0;
            while (k < 50) {
                ry_calcium_state_tick(&s, &c, ip3, dt, &f);
                var ca: f64 = s.cytoplasmic_ca;
                var er: f64 = s.er_ca;
                if (cs_ok(&s) == 0 || ca >= 100.0 || er >= 2.0 * RY_CALCIUM_ER_CA_REFERENCE) { stable = 0; }
                k = k + 1;
            }
            d = d + 1;
        }
        r = r + 1;
    }
    assert_eq(stable, 1, "every dt to 1e6 s: valid, cytosol < 100 uM, ER < twice the reference");
    ry_calcium_state_default(&s);
    run(&s, &c, 0.0, 10.0, 3600.0);
    var rest: f64 = s.cytoplasmic_ca;
    assert_eq(near(rest, 0.1, 0.000001), 1, "an hour at 10 s, the full sub-step budget: rest stays at rest");
    return 0;
}

# rust src/calcium.rs: test_invalid_dt_is_noop
fn hardening() {
    test_group("calcium: hardening");
    var s: RyCalciumState;
    var d: RyCalciumState;
    var c: RyCalciumConfig;
    var f: RyCalciumFlux;
    var zero: RyCalciumFlux;
    ry_calcium_config_default(&c);
    ry_calcium_state_default(&d);
    ry_calcium_flux_default(&zero);
    var inf: f64 = _RY_INF;
    var nan: f64 = _ry_nan();
    var k = 0;
    while (k < 4) {
        var dt: f64 = 0.0;
        if (k == 1) { dt = -0.01; }
        if (k == 2) { dt = nan; }
        if (k == 3) { dt = inf; }
        ry_calcium_state_default(&s);
        memset(&f, 255, 24);
        ry_calcium_state_tick(&s, &c, 1.0, dt, &f);
        assert(memeq(&s, &d, 24) == 1 && memeq(&f, &zero, 24) == 1, "an invalid dt changes nothing, a zero flux");
        k = k + 1;
    }
    return 0;
}

# Rust's trace event, under the target `rasayan::calcium`, its fields in Rust's order (IP3 sanitized).
fn events() {
    test_group("calcium: trace event");
    sakshi_set_emit_hook(&_ev_hook);
    sakshi_set_level(SK_TRACE);
    var s: RyCalciumState;
    var c: RyCalciumConfig;
    var f: RyCalciumFlux;
    ry_calcium_state_default(&s);
    ry_calcium_config_default(&c);
    ry_calcium_state_tick(&s, &c, 0.0 - 2.0, 0.01, &f);
    assert_eq(_ev_is("rasayan::calcium: calcium_tick dt=0.01 ip3=0 ca=0.1"), 1, "calcium_tick");
    _ev_len = 0;
    ry_calcium_state_tick(&s, &c, 0.5, 0.0, &f);
    assert_eq(_ev_len, 0, "no event for an invalid dt");
    sakshi_set_level(SK_INFO);
    ry_calcium_state_tick(&s, &c, 0.5, 0.01, &f);
    assert_eq(_ev_len, 0, "below TRACE, nothing");
    sakshi_clear_emit_hook();
    return 0;
}

# rust src/calcium.rs: test_serde_roundtrip
# rust tests/integration.rs: test_calcium_config_serde_roundtrip, test_calcium_flux_serde_roundtrip
fn serde() {
    test_group("calcium: serde round trips");
    var sb = str_builder_new();
    var s: RyCalciumState;
    var sb2: RyCalciumState;
    ry_calcium_state_default(&s);
    var t1, v1 = ry_calcium_state_to_json(sb, &s);
    var t2, v2 = ry_calcium_state_from_json(load64(sb), load64(sb + 8), &sb2);
    assert(is_ok(t2) == 1 && memeq(&sb2, &s, 24) == 1, "the state reads back");
    var c: RyCalciumConfig;
    var cb: RyCalciumConfig;
    ry_calcium_config_default(&c);
    store64(sb + 8, 0);
    var t3, v3 = ry_calcium_config_to_json(sb, &c);
    var t4, v4 = ry_calcium_config_from_json(load64(sb), load64(sb + 8), &cb);
    assert(is_ok(t4) == 1 && memeq(&cb, &c, 88) == 1, "the config reads back");
    var f: RyCalciumFlux;
    var fb: RyCalciumFlux;
    ry_calcium_state_tick(&s, &c, 0.5, 0.01, &f);
    store64(sb + 8, 0);
    var t5, v5 = ry_calcium_flux_to_json(sb, &f);
    var t6, v6 = ry_calcium_flux_from_json(load64(sb), load64(sb + 8), &fb);
    assert(is_ok(t6) == 1 && memeq(&fb, &f, 24) == 1, "a tick's flux reads back, bit for bit");
    return 0;
}

# Runs the calcium suite.
fn main() {
    alloc_init();
    validation();
    dynamics();
    rest_and_stores();
    bookkeeping();
    influx();
    substeps();
    hardening();
    events();
    serde();
    return assert_summary();
}

var exit_code = main();
# assert_summary() returns the failure count; a wait status is 8 bits, so any failure exits 1.
if (exit_code > 0) { exit_code = 1; }
sys_exit_group(exit_code);
