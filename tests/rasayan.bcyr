# rasayan benchmarks
# Stdlib auto-included via cyrius.cyml
#
# Pattern: bench_new -> bench_batch_start -> tight loop -> bench_batch_stop -> bench_report.
# For sub-1us ops use batch_size >= 1000 to amortize clock_gettime overhead
# (~240 ns per start/stop pair on x86_64 Linux). See lib/bench.cyr header for
# the full overhead-vs-batching guidance.
#
# M0 part 2c-2: the correctly rounded primitives (src/mathx.cyr, ADR 0003) beside the stdlib functions they replace
# (the harness's shadow lines; docs/development/port-parity.md §2c, §2f). Each loop walks its argument over a range
# rasayan calls the function on, so the fast path's table index varies; every result goes into a sum that is kept.
# The Rust twins arrive with each milestone.
#
# M1 part 1: the guard layer and the integrators (src/guard.cyr, src/integrate.cyr). They are crate-private in Rust and
# inlined into every tick, so no Rust benchmark measures them alone: these are the Cyrius baseline the ticks' twins
# (M2 on) build on. Each integrator runs on both sides of SERIES_MAX: a real-time step (k·dt = 0.01, the Estrin
# series) and a coarse one (k·dt = 5, _ry_cr_expm1).

include "src/constants.cyr"
include "src/constants_private.cyr"
include "src/mathx_data.cyr"
include "src/mathx.cyr"
include "src/fmtf.cyr"
include "src/error.cyr"
include "src/guard.cyr"
include "src/integrate.cyr"

# Keeps the loops' results observable.
var _bn_sink = 0;

# Empty workload: measures the benchmark loop's own overhead.
fn bench_noop(): i64 { return 0; }

# Folds a loop's sum into the sink.
fn _bn_keep(s: f64) {
    var t: f64 = s;
    _bn_sink = _bn_sink ^ load64(&t);
    return 0;
}

# n calls of exp over [-20, 20): _ry_cr_exp (which = 0) or the f64_exp builtin (1).
fn _bn_exp(which, n): i64 {
    var x: f64 = -20.0;
    var s: f64 = 0.0;
    var i = 0;
    while (i < n) {
        if (which == 0) {
            var r0: f64 = _ry_cr_exp(x);
            s = s + r0;
        } else {
            var r1: f64 = f64_exp(x);
            s = s + r1;
        }
        x = x + 0.0000390625;
        if (x >= 20.0) { x = -20.0; }
        i = i + 1;
    }
    _bn_keep(s);
    return 0;
}

# n calls of ln over [0.001, 1000): _ry_cr_ln (which = 0) or the f64_ln builtin (1).
fn _bn_ln(which, n): i64 {
    var x: f64 = 0.001;
    var s: f64 = 0.0;
    var i = 0;
    while (i < n) {
        if (which == 0) {
            var r0: f64 = _ry_cr_ln(x);
            s = s + r0;
        } else {
            var r1: f64 = f64_ln(x);
            s = s + r1;
        }
        x = x * 1.0000131;
        if (x >= 1000.0) { x = 0.001; }
        i = i + 1;
    }
    _bn_keep(s);
    return 0;
}

# n calls of expm1 over [-40, 0), the integrators' `(-y).exp_m1()` branch: _ry_cr_expm1 (which = 0) or ganita's
# private _gn_expm1 (1), the stdlib's only expm1.
fn _bn_expm1(which, n): i64 {
    var x: f64 = -40.0;
    var s: f64 = 0.0;
    var i = 0;
    while (i < n) {
        if (which == 0) {
            var r0: f64 = _ry_cr_expm1(x);
            s = s + r0;
        } else {
            var r1: f64 = _gn_expm1(x);
            s = s + r1;
        }
        x = x + 0.0000390625;
        if (x >= 0.0) { x = -40.0; }
        i = i + 1;
    }
    _bn_keep(s);
    return 0;
}

# n calls of pow, x over [0.5, 10) and y over [0.5, 5) (Hill and Q10 exponents): _ry_cr_pow (which = 0) or
# ganita_f64_pow (1).
fn _bn_pow(which, n): i64 {
    var x: f64 = 0.5;
    var y: f64 = 0.5;
    var s: f64 = 0.0;
    var i = 0;
    while (i < n) {
        if (which == 0) {
            var r0: f64 = _ry_cr_pow(x, y);
            s = s + r0;
        } else {
            var r1: f64 = ganita_f64_pow(x, y);
            s = s + r1;
        }
        x = x + 0.0000095367431640625;
        if (x >= 10.0) { x = 0.5; }
        y = y + 0.000003814697265625;
        if (y >= 5.0) { y = 0.5; }
        i = i + 1;
    }
    _bn_keep(s);
    return 0;
}

# One benchmark: `n` calls of primitive `kind` (0 exp, 1 ln, 2 expm1, 3 pow) on implementation `which`.
fn _bn_math(name, kind, which, n): i64 {
    var b = bench_new(name);
    bench_batch_start(b);
    if (kind == 0) { _bn_exp(which, n); }
    elif (kind == 1) { _bn_ln(which, n); }
    elif (kind == 2) { _bn_expm1(which, n); }
    else { _bn_pow(which, n); }
    bench_batch_stop(b, n);
    bench_report(b);
    return 0;
}

# n steps of integrator `kind` (0 relax, 1 produce_decay, 2 activate) at k·dt = `y`, the state fed back each step
# (as a tick does) and nudged so the inputs vary.
fn _bn_integrate(kind, y: f64, n): i64 {
    var dt: f64 = 0.01;
    var k: f64 = y / dt;
    var x: f64 = 0.3;
    var s: f64 = 0.0;
    var i = 0;
    while (i < n) {
        if (kind == 0) {
            x = _ry_integrate_relax(x, 0.7, k, dt);
        } elif (kind == 1) {
            x = _ry_integrate_produce_decay(x, 2.0, k, dt);
        } else {
            x = _ry_integrate_activate(x, k, 0.25, dt);
        }
        s = s + x;
        x = x * 0.999;
        i = i + 1;
    }
    _bn_keep(s);
    return 0;
}

# n calls of guard `kind`: 0 conc, 1 take, 2 shift (both directions), 3 the validator `positive` on accepted values.
fn _bn_guard(kind, n): i64 {
    var x: f64 = -1.0;
    var s: f64 = 0.0;
    var oks = 0;
    var i = 0;
    while (i < n) {
        if (kind == 0) {
            var r0: f64 = _ry_guard_conc(x);
            s = s + r0;
        } elif (kind == 1) {
            var r1: f64 = _ry_guard_take(x, 0.5);
            s = s + r1;
        } elif (kind == 2) {
            var r2: f64 = _ry_guard_shift(x, 0.5, 0.25);
            s = s + r2;
        } else {
            var t, c = _ry_guard_positive("km", x);
            oks = oks + c;
        }
        x = x + 0.0000019073486328125;
        if (x >= 1.0) { x = -1.0; }
        if (kind == 3 && x <= 0.0) { x = 0.0001; }
        i = i + 1;
    }
    _bn_keep(s);
    _bn_sink = _bn_sink ^ oks;
    return 0;
}

# One benchmark of `n` integrator steps (`kind` per _bn_integrate) at k·dt = y.
fn _bn_int(name, kind, y: f64, n): i64 {
    var b = bench_new(name);
    bench_batch_start(b);
    _bn_integrate(kind, y, n);
    bench_batch_stop(b, n);
    bench_report(b);
    return 0;
}

# One benchmark of `n` guard calls (`kind` per _bn_guard).
fn _bn_g(name, kind, n): i64 {
    var b = bench_new(name);
    bench_batch_start(b);
    _bn_guard(kind, n);
    bench_batch_stop(b, n);
    bench_report(b);
    return 0;
}

# Runs the benchmark suite (Rust twins arrive with each milestone).
fn main(): i64 {
    alloc_init();
    var b = bench_new("noop");
    bench_batch_start(b);
    var i = 0;
    while (i < 1000000) { bench_noop(); i = i + 1; }
    bench_batch_stop(b, 1000000);
    bench_report(b);
    _bn_math("mathx/cr_exp", 0, 0, 1000000);
    _bn_math("stdlib/f64_exp", 0, 1, 1000000);
    _bn_math("mathx/cr_ln", 1, 0, 1000000);
    _bn_math("stdlib/f64_ln", 1, 1, 1000000);
    _bn_math("mathx/cr_expm1", 2, 0, 1000000);
    _bn_math("stdlib/_gn_expm1", 2, 1, 1000000);
    _bn_math("mathx/cr_pow", 3, 0, 1000000);
    _bn_math("stdlib/ganita_f64_pow", 3, 1, 1000000);
    _bn_int("integrate/relax series", 0, 0.01, 1000000);
    _bn_int("integrate/relax expm1", 0, 5.0, 1000000);
    _bn_int("integrate/produce_decay series", 1, 0.01, 1000000);
    _bn_int("integrate/produce_decay expm1", 1, 5.0, 1000000);
    _bn_int("integrate/activate series", 2, 0.01, 1000000);
    _bn_int("integrate/activate expm1", 2, 5.0, 1000000);
    _bn_g("guard/conc", 0, 1000000);
    _bn_g("guard/take", 1, 1000000);
    _bn_g("guard/shift", 2, 1000000);
    _bn_g("guard/positive ok", 3, 1000000);
    if (_bn_sink == 1) { println(""); }
    return 0;
}

var r = main();
sys_exit_group(r);
