# rasayan benchmarks
# Stdlib auto-included via cyrius.cyml
#
# Pattern: bench_new -> bench_batch_start -> tight loop -> bench_batch_stop -> bench_report.
# For sub-1us ops use batch_size >= 1000 to amortize clock_gettime overhead
# (~240 ns per start/stop pair on x86_64 Linux). See lib/bench.cyr header for
# the full overhead-vs-batching guidance.
#
# M0 part 2c-2: the correctly rounded primitives (src/mathx.cyr, ADR 0003) beside the stdlib functions they replace
# (the harness's shadow lines; docs/development/port-parity.md §2c, §2f). Each loop walks its argument over a range
# rasayan calls the function on, so the fast path's table index varies; every result goes into a sum that is kept.
# The Rust twins arrive with each milestone.
#
# M1 part 1: the guard layer and the integrators (src/guard.cyr, src/integrate.cyr). They are crate-private in Rust and
# inlined into every tick, so no Rust benchmark measures them alone: these are the Cyrius baseline the ticks' twins
# (M2 on) build on. Each integrator runs on both sides of SERIES_MAX: a real-time step (k·dt = 0.01, the Estrin
# series) and a coarse one (k·dt = 5, _ry_cr_expm1).

include "src/constants.cyr"
include "src/constants_private.cyr"
include "src/mathx_data.cyr"
include "src/mathx.cyr"
include "src/fmtf.cyr"
include "src/error.cyr"
include "src/guard.cyr"
include "src/integrate.cyr"
include "src/logging.cyr"
include "src/json.cyr"
include "src/protein_data.cyr"
include "src/alignment_data.cyr"
include "src/enzyme_data.cyr"
include "src/enzyme.cyr"
include "src/membrane_data.cyr"
include "src/membrane.cyr"
include "src/signal_data.cyr"
include "src/signal.cyr"
include "src/metabolism_data.cyr"
include "src/metabolism.cyr"
include "src/energy_data.cyr"
include "src/energy.cyr"
include "src/protein_data.cyr"
include "src/protein.cyr"

# Keeps the loops' results observable.
var _bn_sink = 0;

# Empty workload: measures the benchmark loop's own overhead.
fn bench_noop(): i64 { return 0; }

# Folds a loop's sum into the sink.
fn _bn_keep(s: f64) {
    var t: f64 = s;
    _bn_sink = _bn_sink ^ load64(&t);
    return 0;
}

# n calls of exp over [-20, 20): _ry_cr_exp (which = 0) or the f64_exp builtin (1).
fn _bn_exp(which, n): i64 {
    var x: f64 = -20.0;
    var s: f64 = 0.0;
    var i = 0;
    while (i < n) {
        if (which == 0) {
            var r0: f64 = _ry_cr_exp(x);
            s = s + r0;
        } else {
            var r1: f64 = f64_exp(x);
            s = s + r1;
        }
        x = x + 0.0000390625;
        if (x >= 20.0) { x = -20.0; }
        i = i + 1;
    }
    _bn_keep(s);
    return 0;
}

# n calls of ln over [0.001, 1000): _ry_cr_ln (which = 0) or the f64_ln builtin (1).
fn _bn_ln(which, n): i64 {
    var x: f64 = 0.001;
    var s: f64 = 0.0;
    var i = 0;
    while (i < n) {
        if (which == 0) {
            var r0: f64 = _ry_cr_ln(x);
            s = s + r0;
        } else {
            var r1: f64 = f64_ln(x);
            s = s + r1;
        }
        x = x * 1.0000131;
        if (x >= 1000.0) { x = 0.001; }
        i = i + 1;
    }
    _bn_keep(s);
    return 0;
}

# n calls of expm1 over [-40, 0), the integrators' `(-y).exp_m1()` branch: _ry_cr_expm1 (which = 0) or ganita's
# private _gn_expm1 (1), the stdlib's only expm1.
fn _bn_expm1(which, n): i64 {
    var x: f64 = -40.0;
    var s: f64 = 0.0;
    var i = 0;
    while (i < n) {
        if (which == 0) {
            var r0: f64 = _ry_cr_expm1(x);
            s = s + r0;
        } else {
            var r1: f64 = _gn_expm1(x);
            s = s + r1;
        }
        x = x + 0.0000390625;
        if (x >= 0.0) { x = -40.0; }
        i = i + 1;
    }
    _bn_keep(s);
    return 0;
}

# n calls of pow, x over [0.5, 10) and y over [0.5, 5) (Hill and Q10 exponents): _ry_cr_pow (which = 0) or
# ganita_f64_pow (1).
fn _bn_pow(which, n): i64 {
    var x: f64 = 0.5;
    var y: f64 = 0.5;
    var s: f64 = 0.0;
    var i = 0;
    while (i < n) {
        if (which == 0) {
            var r0: f64 = _ry_cr_pow(x, y);
            s = s + r0;
        } else {
            var r1: f64 = ganita_f64_pow(x, y);
            s = s + r1;
        }
        x = x + 0.0000095367431640625;
        if (x >= 10.0) { x = 0.5; }
        y = y + 0.000003814697265625;
        if (y >= 5.0) { y = 0.5; }
        i = i + 1;
    }
    _bn_keep(s);
    return 0;
}

# One benchmark: `n` calls of primitive `kind` (0 exp, 1 ln, 2 expm1, 3 pow) on implementation `which`.
fn _bn_math(name, kind, which, n): i64 {
    var b = bench_new(name);
    bench_batch_start(b);
    if (kind == 0) { _bn_exp(which, n); }
    elif (kind == 1) { _bn_ln(which, n); }
    elif (kind == 2) { _bn_expm1(which, n); }
    else { _bn_pow(which, n); }
    bench_batch_stop(b, n);
    bench_report(b);
    return 0;
}

# n steps of integrator `kind` (0 relax, 1 produce_decay, 2 activate) at k·dt = `y`, the state fed back each step
# (as a tick does) and nudged so the inputs vary.
fn _bn_integrate(kind, y: f64, n): i64 {
    var dt: f64 = 0.01;
    var k: f64 = y / dt;
    var x: f64 = 0.3;
    var s: f64 = 0.0;
    var i = 0;
    while (i < n) {
        if (kind == 0) {
            x = _ry_integrate_relax(x, 0.7, k, dt);
        } elif (kind == 1) {
            x = _ry_integrate_produce_decay(x, 2.0, k, dt);
        } else {
            x = _ry_integrate_activate(x, k, 0.25, dt);
        }
        s = s + x;
        x = x * 0.999;
        i = i + 1;
    }
    _bn_keep(s);
    return 0;
}

# n calls of guard `kind`: 0 conc, 1 take, 2 shift (both directions), 3 the validator `positive` on accepted values.
fn _bn_guard(kind, n): i64 {
    var x: f64 = -1.0;
    var s: f64 = 0.0;
    var oks = 0;
    var i = 0;
    while (i < n) {
        if (kind == 0) {
            var r0: f64 = _ry_guard_conc(x);
            s = s + r0;
        } elif (kind == 1) {
            var r1: f64 = _ry_guard_take(x, 0.5);
            s = s + r1;
        } elif (kind == 2) {
            var r2: f64 = _ry_guard_shift(x, 0.5, 0.25);
            s = s + r2;
        } else {
            var t, c = _ry_guard_positive("km", x);
            oks = oks + c;
        }
        x = x + 0.0000019073486328125;
        if (x >= 1.0) { x = -1.0; }
        if (kind == 3 && x <= 0.0) { x = 0.0001; }
        i = i + 1;
    }
    _bn_keep(s);
    _bn_sink = _bn_sink ^ oks;
    return 0;
}

# One benchmark of `n` integrator steps (`kind` per _bn_integrate) at k·dt = y.
fn _bn_int(name, kind, y: f64, n): i64 {
    var b = bench_new(name);
    bench_batch_start(b);
    _bn_integrate(kind, y, n);
    bench_batch_stop(b, n);
    bench_report(b);
    return 0;
}

# One benchmark of `n` guard calls (`kind` per _bn_guard).
fn _bn_g(name, kind, n): i64 {
    var b = bench_new(name);
    bench_batch_start(b);
    _bn_guard(kind, n);
    bench_batch_stop(b, n);
    bench_report(b);
    return 0;
}

# n calcium_tick-shaped trace events (three f64 fields), each built only past its gate: the cost an event adds to a
# tick, filtered out or written (to sakshi's ring buffer). Rust's filtered `trace!` is a load and a compare.
fn _bn_event(n): i64 {
    var x: f64 = 0.01;
    var built = 0;
    var i = 0;
    while (i < n) {
        if (_ry_trace_on() == 1) {
            var h[24];
            var b[256];
            var e = _ry_ev(&h, &b, 256, "rasayan::calcium", "calcium_tick");
            _ry_ev_f(e, "dt", x);
            _ry_ev_f(e, "ip3", 0.25);
            _ry_ev_f(e, "ca", 0.1);
            _ry_trace(e);
            built = built + 1;
        }
        x = x + 0.0000001;
        i = i + 1;
    }
    _bn_keep(x);
    _bn_sink = _bn_sink ^ built;
    return 0;
}

# n f64 texts, serde_json's form (which = 0) or Display's (1), x walking geometrically over 1e-30 .. 1e30 so the
# digit count and the form vary; the builder reset each call.
fn _bn_fmt(which, n): i64 {
    var sb = str_builder_new();
    var a = default_alloc();
    var x: f64 = 0.000000000000000000000000000001;
    var total = 0;
    var i = 0;
    while (i < n) {
        store64(sb + 8, 0);
        if (which == 0) {
            _ry_jw_f64(a, sb, x);
        } else {
            if (_ry_jw_reserve(a, sb, 400) == 0) { _ry_fmt_f64_display(sb, x); }
        }
        total = total + load64(sb + 8);
        x = x * 1.0137;
        if (x > 1000000000000000000000000000000.0) { x = 0.000000000000000000000000000001; }
        i = i + 1;
    }
    _bn_sink = _bn_sink ^ total;
    return 0;
}

# n documents of ten f64 fields (a tick state's size), written field by field as the codecs will write them.
fn _bn_doc(n): i64 {
    var sb = str_builder_new();
    var a = default_alloc();
    var x: f64 = 0.731;
    var total = 0;
    var i = 0;
    while (i < n) {
        store64(sb + 8, 0);
        var e = _ry_jw_byte(a, sb, 123);
        var k = 0;
        while (k < 10) {
            e = e | _ry_jw_key(a, sb, "glucose", k == 0);
            var v: f64 = x + 0.25;
            e = e | _ry_jw_f64(a, sb, v);
            x = x * 1.0001;
            k = k + 1;
        }
        e = e | _ry_jw_byte(a, sb, 125);
        total = total + load64(sb + 8) + e;
        i = i + 1;
    }
    _bn_sink = _bn_sink ^ total;
    return 0;
}

# n reads of document `text` as a struct of `nf` f64 fields named `names`: bayan's tree on an arena reset per document,
# then serde's rules.
fn _bn_read(text, nf, names, n): i64 {
    var a = arena_allocator_growable(65536);
    var len = strlen(text);
    var w[80];
    var good = 0;
    var i = 0;
    while (i < n) {
        reset_via(a);
        var v = _ry_jr_parse(a, text, len);
        good = good + _ry_jr_f64_fields(v, &w, nf, names);
        i = i + 1;
    }
    _bn_sink = _bn_sink ^ good;
    return 0;
}

# ── M2 part 1: enzyme, the Rust benches' twins (rust-old/benches/benchmarks.rs: the same inputs) ──

# n calls of enzyme benchmark `kind`, its result kept: 0 michaelis_menten(1, 10, 1), 1 hill_equation(0.5, 10, 1, 4),
# 2 mixed_inhibition(1, 0.5, 10, 1, 2, 3), 3 ping_pong(1, 2, 10, 0.5, 1), 4 arrhenius(1e10, 50000, 310),
# 5 lineweaver_burk_fit of seven MM(10, 1) points, 6 lookup_enzyme("Catalase").
fn _bn_enzyme(kind, n): i64 {
    var data[112];
    var ss[56];
    store64(&ss, 0x3FB999999999999A);
    store64(&ss + 8, 0x3FD0000000000000);
    store64(&ss + 16, 0x3FE0000000000000);
    store64(&ss + 24, 0x3FF0000000000000);
    store64(&ss + 32, 0x4000000000000000);
    store64(&ss + 40, 0x4014000000000000);
    store64(&ss + 48, 0x4024000000000000);
    var k = 0;
    while (k < 7) {
        var sk: f64 = load64(&ss + 8 * k);
        var vk: f64 = ry_michaelis_menten(sk, 10.0, 1.0);
        store64(&data + 16 * k, load64(&sk));
        store64(&data + 16 * k + 8, load64(&vk));
        k = k + 1;
    }
    var fit: RyKineticFit;
    var s: f64 = 0.0;
    var hits = 0;
    var i = 0;
    while (i < n) {
        if (kind == 0) {
            var r0: f64 = ry_michaelis_menten(1.0, 10.0, 1.0);
            s = s + r0;
        } elif (kind == 1) {
            var r1: f64 = ry_hill_equation(0.5, 10.0, 1.0, 4.0);
            s = s + r1;
        } elif (kind == 2) {
            var r2: f64 = ry_mixed_inhibition(1.0, 0.5, 10.0, 1.0, 2.0, 3.0);
            s = s + r2;
        } elif (kind == 3) {
            var r3: f64 = ry_ping_pong(1.0, 2.0, 10.0, 0.5, 1.0);
            s = s + r3;
        } elif (kind == 4) {
            var r4: f64 = ry_arrhenius(10000000000.0, 50000.0, 310.0);
            s = s + r4;
        } elif (kind == 5) {
            hits = hits + ry_lineweaver_burk_fit(&data, 7, &fit);
        } else {
            hits = hits + ry_lookup_enzyme("Catalase", 8);
        }
        i = i + 1;
    }
    _bn_keep(s);
    _bn_sink = _bn_sink ^ hits;
    return 0;
}

# One enzyme benchmark of `n` calls.
fn _bn_enz(name, kind, n): i64 {
    var b = bench_new(name);
    bench_batch_start(b);
    _bn_enzyme(kind, n);
    bench_batch_stop(b, n);
    bench_report(b);
    return 0;
}

# ── M2 part 2: membrane, the Rust benches' twins (the same inputs) ──

# n calls of membrane benchmark `kind`, its result kept: 0 nernst(310, 1, 4, 155), 1 goldman(310) over the default
# IonicState and permeabilities, 2 fick_flux(1e-9, 100, 5e-9).
fn _bn_membrane(kind, n): i64 {
    var ions: RyIonicState;
    ry_ionic_state_default(&ions);
    var perm: RyMembranePermeability;
    ry_membrane_permeability_default(&perm);
    var d: f64 = 0.000000001;
    var dx: f64 = 0.000000005;
    var s: f64 = 0.0;
    var i = 0;
    while (i < n) {
        if (kind == 0) {
            var r0: f64 = ry_nernst(310.0, 1, 4.0, 155.0);
            s = s + r0;
        } elif (kind == 1) {
            var r1: f64 = ry_goldman(310.0, &ions, &perm);
            s = s + r1;
        } else {
            var r2: f64 = ry_fick_flux(d, 100.0, dx);
            s = s + r2;
        }
        i = i + 1;
    }
    _bn_keep(s);
    return 0;
}

# One membrane benchmark of `n` calls.
fn _bn_mem(name, kind, n): i64 {
    var b = bench_new(name);
    bench_batch_start(b);
    _bn_membrane(kind, n);
    bench_batch_stop(b, n);
    bench_report(b);
    return 0;
}

# ── M2 part 3: signal, the Rust benches' twins (the same inputs), and SecondMessenger (Cyrius only) ──

# n calls of signal benchmark `kind`, its result kept: 0 dose_response(0.5, 1, 1, 2), 1 receptor_occupancy(0.5, 1),
# 2 a SecondMessenger tick at dt 0.01 (the series branch), 3 at dt 1 (exp_m1), 4 activate_gq(0.1).
fn _bn_signal(kind, n): i64 {
    var sm: RySecondMessenger;
    ry_second_messenger_default(&sm);
    var s: f64 = 0.0;
    var i = 0;
    while (i < n) {
        if (kind == 0) {
            var r0: f64 = ry_dose_response(0.5, 1.0, 1.0, 2.0);
            s = s + r0;
        } elif (kind == 1) {
            var r1: f64 = ry_receptor_occupancy(0.5, 1.0);
            s = s + r1;
        } elif (kind == 2) {
            ry_second_messenger_tick(&sm, 0.01);
        } elif (kind == 3) {
            ry_second_messenger_tick(&sm, 1.0);
        } else {
            ry_second_messenger_activate_gq(&sm, 0.1);
        }
        i = i + 1;
    }
    var c: f64 = sm.camp;
    s = s + c;
    _bn_keep(s);
    return 0;
}

# One signal benchmark of `n` calls.
fn _bn_sig(name, kind, n): i64 {
    var b = bench_new(name);
    bench_batch_start(b);
    _bn_signal(kind, n);
    bench_batch_stop(b, n);
    bench_report(b);
    return 0;
}

# ── M2 part 4: metabolism, the Rust bench's twin (the same loop body), and MetabolicState (Cyrius only) ──

# n calls of metabolism benchmark `kind`, its result kept: 0 metabolic_tick (Rust's body: a default state, consume 2,
# regenerate 0.1 s), 1 regenerate_atp at 100 s (the lactate clearance on exp_m1), 2 energy_charge.
fn _bn_metabolism(kind, n): i64 {
    var m: RyMetabolicState;
    ry_metabolic_state_default(&m);
    var s: f64 = 0.0;
    var i = 0;
    while (i < n) {
        if (kind == 0) {
            ry_metabolic_state_default(&m);
            var c: f64 = ry_metabolic_state_consume_atp(&m, 2.0);
            ry_metabolic_state_regenerate_atp(&m, 0.1);
            var a: f64 = m.atp;
            s = s + a;
        } elif (kind == 1) {
            ry_metabolic_state_regenerate_atp(&m, 100.0);
        } else {
            var e: f64 = ry_metabolic_state_energy_charge(&m);
            s = s + e;
        }
        i = i + 1;
    }
    var l: f64 = m.lactate;
    s = s + l;
    _bn_keep(s);
    return 0;
}

# One metabolism benchmark of `n` calls.
fn _bn_met(name, kind, n): i64 {
    var b = bench_new(name);
    bench_batch_start(b);
    _bn_metabolism(kind, n);
    bench_batch_stop(b, n);
    bench_report(b);
    return 0;
}

# ── M2 part 5: energy, the Rust bench's twin (the same loop body), and the bridges (Cyrius only) ──

# n calls of energy benchmark `kind`, its result kept: 0 bioenergy_tick (Rust's body: a default state,
# set_exertion(6), tick(1 min)), 1 met_from_power(150, 70), 2 a BioenergyState tick at 12 MET and 0.5 min (exp_m1).
fn _bn_energy(kind, n): i64 {
    var b: RyBioenergyState;
    ry_bioenergy_state_default(&b);
    var s: f64 = 0.0;
    var i = 0;
    while (i < n) {
        if (kind == 0) {
            ry_bioenergy_state_default(&b);
            ry_bioenergy_state_set_exertion(&b, 6.0);
            ry_bioenergy_state_tick(&b, 1.0);
            var p: f64 = b.phosphocreatine;
            s = s + p;
        } elif (kind == 1) {
            var m: f64 = ry_met_from_power(150.0, 70.0);
            s = s + m;
        } else {
            b.met = 12.0;
            ry_bioenergy_state_tick(&b, 0.5);
        }
        i = i + 1;
    }
    var g: f64 = b.glycogen;
    s = s + g;
    _bn_keep(s);
    return 0;
}

# One energy benchmark of `n` calls.
fn _bn_en(name, kind, n): i64 {
    var b = bench_new(name);
    bench_batch_start(b);
    _bn_energy(kind, n);
    bench_batch_stop(b, n);
    bench_report(b);
    return 0;
}

# ── M3 part 1: protein, the Rust benches' twins (the same inputs) ──

# n calls of protein benchmark `kind` on the 20-residue alphabet (Chou-Fasman on Rust's own 20-residue peptide), its
# result kept: 0 lookup('W'), 1 molecular_weight, 2 isoelectric_point, 3 isoelectric_point_with Bjellqvist,
# 4 extinction_coefficient, 5 chou_fasman, 6 net_charge at 7, 7 composition.
fn _bn_protein(kind, n): i64 {
    var seq = "ACDEFGHIKLMNPQRSTVWY";
    var cf = "AAAAAELLLLVVVIIYNGPS";
    var arena = arena_allocator_growable(4096);
    var ss[32];
    var pairs[416];
    var ec: RyExtinctionCoefficient;
    var x: f64 = 0.0;
    var s: f64 = 0.0;
    var hits = 0;
    var i = 0;
    while (i < n) {
        if (kind == 0) {
            hits = hits + ry_lookup(87);
        } elif (kind == 1) {
            hits = hits + ry_molecular_weight(seq, 20, &x);
            s = s + x;
        } elif (kind == 2) {
            hits = hits + ry_isoelectric_point(seq, 20, &x);
            s = s + x;
        } elif (kind == 3) {
            hits = hits + ry_isoelectric_point_with(seq, 20, RY_PKA_SET_BJELLQVIST, &x);
            s = s + x;
        } elif (kind == 4) {
            hits = hits + ry_extinction_coefficient(seq, 20, &ec);
        } elif (kind == 5) {
            reset_via(arena);
            var t5, v5 = ry_chou_fasman_a(arena, cf, 20, &ss, 32);
            hits = hits + v5;
        } elif (kind == 6) {
            var z: f64 = ry_net_charge(seq, 20, 7.0);
            s = s + z;
        } else {
            var t7, v7 = ry_composition(seq, 20, &pairs, 26);
            hits = hits + v7;
        }
        i = i + 1;
    }
    _bn_keep(s);
    _bn_sink = _bn_sink ^ hits;
    return 0;
}

# One protein benchmark of `n` calls.
fn _bn_prot(name, kind, n): i64 {
    var b = bench_new(name);
    bench_batch_start(b);
    _bn_protein(kind, n);
    bench_batch_stop(b, n);
    bench_report(b);
    return 0;
}

# One benchmark of the JSON writers: `kind` 0 the serde_json f64 form, 1 the Display form, 2 a ten-field document.
fn _bn_json(name, kind, n): i64 {
    var b = bench_new(name);
    bench_batch_start(b);
    if (kind == 2) { _bn_doc(n); } else { _bn_fmt(kind, n); }
    bench_batch_stop(b, n);
    bench_report(b);
    return 0;
}

# One benchmark of `n` events at the current level.
fn _bn_ev(name, n): i64 {
    var b = bench_new(name);
    bench_batch_start(b);
    _bn_event(n);
    bench_batch_stop(b, n);
    bench_report(b);
    return 0;
}

# Runs the benchmark suite (Rust twins arrive with each milestone).
fn main(): i64 {
    alloc_init();
    var b = bench_new("noop");
    bench_batch_start(b);
    var i = 0;
    while (i < 1000000) { bench_noop(); i = i + 1; }
    bench_batch_stop(b, 1000000);
    bench_report(b);
    _bn_math("mathx/cr_exp", 0, 0, 1000000);
    _bn_math("stdlib/f64_exp", 0, 1, 1000000);
    _bn_math("mathx/cr_ln", 1, 0, 1000000);
    _bn_math("stdlib/f64_ln", 1, 1, 1000000);
    _bn_math("mathx/cr_expm1", 2, 0, 1000000);
    _bn_math("stdlib/_gn_expm1", 2, 1, 1000000);
    _bn_math("mathx/cr_pow", 3, 0, 1000000);
    _bn_math("stdlib/ganita_f64_pow", 3, 1, 1000000);
    _bn_int("integrate/relax series", 0, 0.01, 1000000);
    _bn_int("integrate/relax expm1", 0, 5.0, 1000000);
    _bn_int("integrate/produce_decay series", 1, 0.01, 1000000);
    _bn_int("integrate/produce_decay expm1", 1, 5.0, 1000000);
    _bn_int("integrate/activate series", 2, 0.01, 1000000);
    _bn_int("integrate/activate expm1", 2, 5.0, 1000000);
    _bn_g("guard/conc", 0, 1000000);
    _bn_g("guard/take", 1, 1000000);
    _bn_g("guard/shift", 2, 1000000);
    _bn_g("guard/positive ok", 3, 1000000);
    sakshi_output_buffer();
    _ry_log_apply(LOG_INFO);
    _bn_ev("logging/trace event, filtered out", 1000000);
    _ry_log_apply(LOG_TRACE);
    _bn_ev("logging/trace event, 3 f64 fields, to the ring buffer", 100000);
    _ry_log_apply(LOG_INFO);
    _bn_json("json/f64 serde_json form", 0, 200000);
    _bn_json("json/f64 Display form", 1, 200000);
    _bn_json("json/document of ten f64 fields", 2, 20000);
    _bn_enz("michaelis_menten", 0, 1000000);
    _bn_enz("hill_equation", 1, 1000000);
    _bn_enz("mixed_inhibition", 2, 1000000);
    _bn_enz("ping_pong", 3, 1000000);
    _bn_enz("arrhenius", 4, 1000000);
    _bn_enz("lineweaver_burk_fit", 5, 200000);
    _bn_enz("enzyme_lookup", 6, 1000000);
    _bn_mem("nernst", 0, 1000000);
    _bn_mem("goldman", 1, 1000000);
    _bn_mem("fick_flux", 2, 1000000);
    _bn_sig("dose_response", 0, 1000000);
    _bn_sig("receptor_occupancy", 1, 1000000);
    _bn_sig("signal/second_messenger tick dt 0.01", 2, 1000000);
    _bn_sig("signal/second_messenger tick dt 1", 3, 1000000);
    _bn_sig("signal/second_messenger activate_gq", 4, 1000000);
    _bn_met("metabolic_tick", 0, 1000000);
    _bn_met("metabolism/regenerate_atp dt 100", 1, 1000000);
    _bn_met("metabolism/energy_charge", 2, 1000000);
    _bn_en("bioenergy_tick", 0, 1000000);
    _bn_en("energy/met_from_power", 1, 1000000);
    _bn_en("energy/tick 12 MET dt 0.5", 2, 1000000);
    _bn_prot("protein_lookup", 0, 1000000);
    _bn_prot("molecular_weight", 1, 1000000);
    _bn_prot("isoelectric_point", 2, 20000);
    _bn_prot("isoelectric_point_bjellqvist", 3, 20000);
    _bn_prot("extinction_coefficient", 4, 1000000);
    _bn_prot("chou_fasman", 5, 200000);
    _bn_prot("net_charge", 6, 200000);
    _bn_prot("composition", 7, 1000000);
    var br = bench_new("json/read MembranePermeability (3 f64)");
    bench_batch_start(br);
    _bn_read("{\"p_na\":0.04,\"p_k\":1.0,\"p_cl\":0.45}", 3, "p_na\0p_k\0p_cl\0", 100000);
    bench_batch_stop(br, 100000);
    bench_report(br);
    var t10 = "{\"a\":0.731,\"b\":96485.33212331001,\"c\":1e-7,\"d\":2.5,\"e\":310.15,\"f\":0.0001,";
    var u10 = "\"g\":8.31446261815324,\"h\":700.0,\"i\":-0.0,\"j\":123456.789}";
    var sb10 = str_builder_new();
    str_builder_add_cstr(sb10, t10);
    str_builder_add_cstr(sb10, u10);
    str_builder_putc(sb10, 0);
    var b10 = bench_new("json/read a ten-field document (17-digit values)");
    bench_batch_start(b10);
    _bn_read(load64(sb10), 10, "a\0b\0c\0d\0e\0f\0g\0h\0i\0j\0", 50000);
    bench_batch_stop(b10, 50000);
    bench_report(b10);
    if (_bn_sink == 1) { println(""); }
    return 0;
}

var r = main();
sys_exit_group(r);
