# rasayan — src/constants.cyr compiles, and its literals are the source's bits
# Stdlib auto-included via cyrius.cyml
#
# src/constants.cyr is generated from rust-old's source text (never typed by hand). This
# suite compiles it and checks a sample of its constants bit for bit against
# tests/golden/constants.tsv: the two module-qualified pairs whose Rust names repeat
# (SUBSTEP_MAX_DT, MAX_SUBSTEPS), both const expressions (PM_CA_LEAK, PCR_RECOVERY_RATE), a
# negative value, small decimals, and the integers. scripts/oracle/validate.py checks every
# literal against its golden row; tests/parity.tcyr replays every row (M0 step 7).

include "src/constants.cyr"

# The IEEE-754 bit pattern of an f64.
fn bits_of(x: f64) {
    var y: f64 = x;
    return load64(&y);
}

# Every f64 constant in the sample against its golden bits.
fn check_f64() {
    test_group("constants: f64 bits");
    assert_eq(bits_of(RY_R_GAS), 0x4020a1013e8990be, "R_GAS");
    assert_eq(bits_of(RY_FARADAY), 0x40f78e555060882c, "FARADAY");
    assert_eq(bits_of(RY_CALCIUM_SUBSTEP_MAX_DT), 0x3f847ae147ae147b, "calcium SUBSTEP_MAX_DT");
    assert_eq(bits_of(RY_MAPK_SUBSTEP_MAX_DT), 0x3fe0000000000000, "mapk SUBSTEP_MAX_DT");
    assert_eq(bits_of(RY_PATHWAY_NETWORK_MAX_SUBSTEP), 0x3f947ae147ae147b, "NETWORK_MAX_SUBSTEP");
    assert_eq(bits_of(RY_CALCIUM_PM_CA_LEAK), 0x3fa55f07a629cb94, "PM_CA_LEAK (const fn)");
    assert_eq(bits_of(RY_ENERGY_PCR_RECOVERY_RATE), 0x3ff62e42fefa39ef, "PCR_RECOVERY_RATE (LN_2 / 0.5)");
    assert_eq(bits_of(RY_ENERGY_ATP_HYDROLYSIS_DG), 0xc03e800000000000, "ATP_HYDROLYSIS_DG (negative)");
    assert_eq(bits_of(RY_ENERGY_GLYCOGEN_ANAEROBIC_RATE), 0x3f30624dd2f1a9fc, "GLYCOGEN_ANAEROBIC_RATE");
    assert_eq(bits_of(RY_ETC_COMPLEX_I_KM_NADH), 0x3f60624dd2f1a9fc, "COMPLEX_I_KM_NADH");
    assert_eq(bits_of(RY_PATHWAY_NAD_RATIO_MAX), 0x409f400000000000, "NAD_RATIO_MAX");
    return 0;
}

# The integer constants are integers, and the f64 ones take part in f64 arithmetic.
fn check_types() {
    test_group("constants: integers and f64 arithmetic");
    assert_eq(RY_CALCIUM_MAX_SUBSTEPS, 1000, "calcium MAX_SUBSTEPS");
    assert_eq(RY_MAPK_MAX_SUBSTEPS, 1000, "mapk MAX_SUBSTEPS");
    assert_eq(RY_PATHWAY_NETWORK_MAX_SUBSTEPS, 5000, "NETWORK_MAX_SUBSTEPS");
    assert_eq(RY_MCP_MAX_SEQUENCE_LEN, 100000, "MAX_SEQUENCE_LEN");
    assert_eq(RY_MCP_MAX_ALIGNMENT_CELLS, 25000000, "MAX_ALIGNMENT_CELLS");
    assert_eq(RY_CALCIUM_MAX_SUBSTEPS + 1, 1001, "an integer const adds as an integer");
    var two_r: f64 = RY_R_GAS * 2.0;
    assert_eq(bits_of(two_r), 0x4030a1013e8990be, "R_GAS * 2.0 is f64 arithmetic");
    var neg: f64 = -RY_ENERGY_ATP_HYDROLYSIS_DG;
    assert_eq(bits_of(neg), 0x403e800000000000, "unary minus flips the sign bit");
    return 0;
}

# The constants suite: bit patterns, then integer and f64 typing.
fn main() {
    alloc_init();
    check_f64();
    check_types();
    return assert_summary();
}

var exit_code = main();
# Clamp before exiting: assert_summary() returns the raw failure COUNT, and a wait status is
# only 8 bits. Any failure at all is exit 1.
if (exit_code > 0) { exit_code = 1; }
sys_exit_group(exit_code);
