        var t2, v2 = ry_carbon_skeleton_output_to_json(_fz_sb, &r);
        var t3, v3 = ry_carbon_skeleton_output_from_json_a(_fz_arena, load64(_fz_sb), load64(_fz_sb + 8), &rb);
        if (fz_all_finite(&r, 6) == 0 || is_ok(t2) == 0 || is_ok(t3) == 0 || memeq(&rb, &r, 48) == 0) {
            _fz_bad = _fz_bad + 1;
        }
    }
    var dc: RyAminoCatabConfig;
    ry_amino_catab_config_default(&dc);
    var s: RyAminoCatabState;
    var sb2: RyAminoCatabState;
    var t4, v4 = ry_amino_catab_state_from_json_a(_fz_arena, data, len, &s);
    if (is_ok(t4) == 1) {
        _fz_amino = _fz_amino + 1;
        store64(_fz_sb + 8, 0);
        var t5, v5 = ry_amino_catab_state_to_json(_fz_sb, &s);
        var t6, v6 = ry_amino_catab_state_from_json_a(_fz_arena, load64(_fz_sb), load64(_fz_sb + 8), &sb2);
        if (fz_all_finite(&s, 3) == 0 || is_ok(t5) == 0 || is_ok(t6) == 0 || memeq(&sb2, &s, 24) == 0) {
            _fz_bad = _fz_bad + 1;
        }
        var tv, vv = ry_amino_catab_state_validate(&s);
        var huge: f64 = 0x7E37E43C8800759C;     # 1e300
        var aa: f64 = s.amino_acid_pool;
        var glu: f64 = s.glutamate;
        var nh4: f64 = s.ammonium;
        if (is_ok(tv) == 1 && aa < huge && glu < huge && nh4 < huge) { fz_amino_step(&s, &dc); }
    }
    var c2: RyAminoCatabConfig;
    var cb: RyAminoCatabConfig;
    var t7, v7 = ry_amino_catab_config_from_json_a(_fz_arena, data, len, &c2);
    if (is_ok(t7) == 1) {
        _fz_amino = _fz_amino + 1;
        store64(_fz_sb + 8, 0);
        var t8, v8 = ry_amino_catab_config_to_json(_fz_sb, &c2);
        var t9, v9 = ry_amino_catab_config_from_json_a(_fz_arena, load64(_fz_sb), load64(_fz_sb + 8), &cb);
        if (fz_all_finite(&c2, 13) == 0 || is_ok(t8) == 0 || is_ok(t9) == 0 || memeq(&cb, &c2, 104) == 0) {
            _fz_bad = _fz_bad + 1;
        }
        var tc, vc = ry_amino_catab_config_validate(&c2);
        if (is_ok(tc) == 1) {
            var d: RyAminoCatabState;
            ry_amino_catab_state_default(&d);
            fz_amino_step(&d, &c2);
        }
    }
    var fx: RyAminoCatabFlux;
    var fb: RyAminoCatabFlux;
    var ta, va = ry_amino_catab_flux_from_json_a(_fz_arena, data, len, &fx);
    if (is_ok(ta) == 1) {
        _fz_amino = _fz_amino + 1;
        store64(_fz_sb + 8, 0);
        var tb, vb = ry_amino_catab_flux_to_json(_fz_sb, &fx);
        var tf, vf = ry_amino_catab_flux_from_json_a(_fz_arena, load64(_fz_sb), load64(_fz_sb + 8), &fb);
        if (fz_all_finite(&fx, 12) == 0 || is_ok(tb) == 0 || is_ok(tf) == 0 || memeq(&fb, &fx, 96) == 0) {
            _fz_bad = _fz_bad + 1;
        }
    }
    return 0;
}

# A failure unless the `n` words at `w` are finite f64s, but for the integer word `skip` (-1: none), and written then
# read back (`ok` 1 when both calls succeeded) they come back bit for bit in the `size` bytes at `back`.
fn fz_net_check(w, n, skip, ok, back, size) {
    var good = ok;
    var j = 0;
    while (j < n) {
        if (j != skip && fz_all_finite(w + 8 * j, 1) == 0) { good = 0; }
        j = j + 1;
    }
    if (good == 0 || memeq(back, w, size) == 0) { _fz_bad = _fz_bad + 1; }
    return 0;
}

# 1 when both a write's and a read's Result tags are Ok.
fn fz_both(t1, t2) {
    if (is_ok(t1) == 1 && is_ok(t2) == 1) { return 1; }
    return 0;
}

# Steps network *w 0.1 s, then 2 s, on the default config in the resting environment when it validates with pools
# under 1e300: a failure unless it still validates, every tick value is finite, and ATP + ADP is conserved to 1e-12.
fn fz_net_step(w: *RyMetabolicNetwork) {
    var tv, vv = ry_metabolic_network_validate(w);
    if (is_ok(tv) == 0) { return 0; }
    var huge: f64 = 0x7E37E43C8800759C;     # 1e300
    var wb = w;                                  # a plain address: `w + n` would step n networks
    var k = 0;
    while (k < 33) {
        var x: f64 = load64(wb + 8 * k);
        if (x >= huge) { return 0; }
        k = k + 1;
    }
    _fz_net_stepped = _fz_net_stepped + 1;
    var c: RyNetworkConfig;
    var e: RyNetworkEnvironment;
    var tk: RyNetworkTick;
    ry_network_config_default(&c);
    ry_network_environment_default(&e);
    var before: f64 = w.atp + w.adp;
    ry_metabolic_network_tick_in(w, &c, &e, 0.1, &tk);
    var ok = fz_all_finite(&tk, 67);
    ry_metabolic_network_tick_in(w, &c, &e, 2.0, &tk);
    if (fz_all_finite(&tk, 67) == 0) { ok = 0; }
    var after: f64 = w.atp + w.adp;
    var drift: f64 = f64_abs(after - before);
    var bound: f64 = 0.000000000001 * before;
    var ta, va = ry_metabolic_network_validate(w);
    if (is_ok(ta) == 0 || ok == 0 || drift > bound) { _fz_bad = _fz_bad + 1; }
    return 0;
}

# pathway: the six network codecs on one input; each accepted value holds only finite f64s (the config's chain length
# an integer in u32's range) and reads back bit for bit from what it writes, and an accepted network is stepped
# (fz_net_step).
fn fuzz_network(data, len) {
    reset_via(_fz_arena);
    var w[832];
    var back[832];
    var t1, v1 = ry_metabolic_network_from_json_a(_fz_arena, data, len, &w);
    if (is_ok(t1) == 1) {
        _fz_network = _fz_network + 1;
        store64(_fz_sb + 8, 0);
        var a1, b1 = ry_metabolic_network_to_json(_fz_sb, &w);
        var c1, d1 = ry_metabolic_network_from_json_a(_fz_arena, load64(_fz_sb), load64(_fz_sb + 8), &back);
        fz_net_check(&w, 33, 0 - 1, fz_both(a1, c1), &back, 264);
        fz_net_step(&w);
    }
    var t2, v2 = ry_network_config_from_json_a(_fz_arena, data, len, &w);
    if (is_ok(t2) == 1) {
        _fz_network = _fz_network + 1;
        var chain = load64(&w + 8 * 84);
        if (chain < 0 || chain > 4294967295) { _fz_bad = _fz_bad + 1; }
        store64(_fz_sb + 8, 0);
        var a2, b2 = ry_network_config_to_json(_fz_sb, &w);
        var c2, d2 = ry_network_config_from_json_a(_fz_arena, load64(_fz_sb), load64(_fz_sb + 8), &back);
        fz_net_check(&w, 104, 84, fz_both(a2, c2), &back, 832);
    }
    var t3, v3 = ry_network_flux_from_json_a(_fz_arena, data, len, &w);
    if (is_ok(t3) == 1) {
        _fz_network = _fz_network + 1;
        store64(_fz_sb + 8, 0);
        var a3, b3 = ry_network_flux_to_json(_fz_sb, &w);
        var c3, d3 = ry_network_flux_from_json_a(_fz_arena, load64(_fz_sb), load64(_fz_sb + 8), &back);
        fz_net_check(&w, 62, 0 - 1, fz_both(a3, c3), &back, 496);
    }
    var t4, v4 = ry_network_environment_from_json_a(_fz_arena, data, len, &w);
    if (is_ok(t4) == 1) {
        _fz_network = _fz_network + 1;
        store64(_fz_sb + 8, 0);
        var a4, b4 = ry_network_environment_to_json(_fz_sb, &w);
        var c4, d4 = ry_network_environment_from_json_a(_fz_arena, load64(_fz_sb), load64(_fz_sb + 8), &back);
        fz_net_check(&w, 4, 0 - 1, fz_both(a4, c4), &back, 32);
    }
    var t5, v5 = ry_network_exchange_from_json_a(_fz_arena, data, len, &w);
    if (is_ok(t5) == 1) {
        _fz_network = _fz_network + 1;
        store64(_fz_sb + 8, 0);
        var a5, b5 = ry_network_exchange_to_json(_fz_sb, &w);
        var c5, d5 = ry_network_exchange_from_json_a(_fz_arena, load64(_fz_sb), load64(_fz_sb + 8), &back);
        fz_net_check(&w, 5, 0 - 1, fz_both(a5, c5), &back, 40);
    }
    var t6, v6 = ry_network_tick_from_json_a(_fz_arena, data, len, &w);
    if (is_ok(t6) == 1) {
        _fz_network = _fz_network + 1;
        store64(_fz_sb + 8, 0);
        var a6, b6 = ry_network_tick_to_json(_fz_sb, &w);
        var c6, d6 = ry_network_tick_from_json_a(_fz_arena, load64(_fz_sb), load64(_fz_sb + 8), &back);
        fz_net_check(&w, 67, 0 - 1, fz_both(a6, c6), &back, 536);
    }
    return 0;
}

# Ticks MAPK state *s on config *c at growth factor 0.5 for 0.1 s and then 100 s (200 sub-steps): a failure unless it
# still validates and every flux value is finite.
fn fz_mapk_step(s: *RyMapkState, c: *RyMapkConfig) {
    var f: RyMapkFlux;
    ry_mapk_state_tick(s, c, 0.5, 0.1, &f);
    var ok = fz_all_finite(&f, 4);
    ry_mapk_state_tick(s, c, 0.5, 100.0, &f);
    if (fz_all_finite(&f, 4) == 0) { ok = 0; }
    var tv, vv = ry_mapk_state_validate(s);
    if (is_ok(tv) == 0 || ok == 0) { _fz_bad = _fz_bad + 1; }
    return 0;
}

# mapk: the three codecs on one input (an accepted value holds only finite f64s and reads back bit for bit from what
# it writes); a valid state stepped on the default config, and the default state on an accepted config that
# validates (fz_mapk_step).
fn fuzz_mapk(data, len) {
    reset_via(_fz_arena);
    var dc: RyMapkConfig;
    ry_mapk_config_default(&dc);
    var s: RyMapkState;
    var sb2: RyMapkState;
    var t1, v1 = ry_mapk_state_from_json_a(_fz_arena, data, len, &s);
    if (is_ok(t1) == 1) {
        _fz_mapk = _fz_mapk + 1;
        store64(_fz_sb + 8, 0);
        var t2, v2 = ry_mapk_state_to_json(_fz_sb, &s);
        var t3, v3 = ry_mapk_state_from_json_a(_fz_arena, load64(_fz_sb), load64(_fz_sb + 8), &sb2);
        if (fz_all_finite(&s, 4) == 0 || is_ok(t2) == 0 || is_ok(t3) == 0 || memeq(&sb2, &s, 32) == 0) {
            _fz_bad = _fz_bad + 1;
        }
        var tv, vv = ry_mapk_state_validate(&s);
        if (is_ok(tv) == 1) { fz_mapk_step(&s, &dc); }
    }
    var c2: RyMapkConfig;
    var cb: RyMapkConfig;
    var t4, v4 = ry_mapk_config_from_json_a(_fz_arena, data, len, &c2);
    if (is_ok(t4) == 1) {
        _fz_mapk = _fz_mapk + 1;
        store64(_fz_sb + 8, 0);
        var t5, v5 = ry_mapk_config_to_json(_fz_sb, &c2);
        var t6, v6 = ry_mapk_config_from_json_a(_fz_arena, load64(_fz_sb), load64(_fz_sb + 8), &cb);
        if (fz_all_finite(&c2, 12) == 0 || is_ok(t5) == 0 || is_ok(t6) == 0 || memeq(&cb, &c2, 96) == 0) {
            _fz_bad = _fz_bad + 1;
        }
        var tc, vc = ry_mapk_config_validate(&c2);
        if (is_ok(tc) == 1) {
            var d: RyMapkState;
            ry_mapk_state_default(&d);
            fz_mapk_step(&d, &c2);
        }
    }
    var fx: RyMapkFlux;
    var fb: RyMapkFlux;
    var t7, v7 = ry_mapk_flux_from_json_a(_fz_arena, data, len, &fx);
    if (is_ok(t7) == 1) {
        _fz_mapk = _fz_mapk + 1;
        store64(_fz_sb + 8, 0);
        var t8, v8 = ry_mapk_flux_to_json(_fz_sb, &fx);
        var t9, v9 = ry_mapk_flux_from_json_a(_fz_arena, load64(_fz_sb), load64(_fz_sb + 8), &fb);
        if (fz_all_finite(&fx, 4) == 0 || is_ok(t8) == 0 || is_ok(t9) == 0 || memeq(&fb, &fx, 32) == 0) {
            _fz_bad = _fz_bad + 1;
        }
    }
    return 0;
}

# Ticks PI3K state *s on config *c at receptor activity 0.5 for 0.1 s and then 100 s: a failure unless it
# still validates and every flux value is finite.
fn fz_pi3k_step(s: *RyPi3kState, c: *RyPi3kConfig) {
    var f: RyPi3kFlux;
    ry_pi3k_state_tick(s, c, 0.5, 0.1, &f);
    var ok = fz_all_finite(&f, 3);
    ry_pi3k_state_tick(s, c, 0.5, 100.0, &f);
    if (fz_all_finite(&f, 3) == 0) { ok = 0; }
    var tv, vv = ry_pi3k_state_validate(s);
    if (is_ok(tv) == 0 || ok == 0) { _fz_bad = _fz_bad + 1; }
    return 0;
}

# pi3k: the three codecs on one input (an accepted value holds only finite f64s and reads back bit for bit from what
# it writes); a valid state stepped on the default config, and the default state on an accepted config that
# validates (fz_pi3k_step).
fn fuzz_pi3k(data, len) {
    reset_via(_fz_arena);
    var dc: RyPi3kConfig;
    ry_pi3k_config_default(&dc);
    var s: RyPi3kState;
    var sb2: RyPi3kState;
    var t1, v1 = ry_pi3k_state_from_json_a(_fz_arena, data, len, &s);
    if (is_ok(t1) == 1) {
        _fz_pi3k = _fz_pi3k + 1;
        store64(_fz_sb + 8, 0);
        var t2, v2 = ry_pi3k_state_to_json(_fz_sb, &s);
        var t3, v3 = ry_pi3k_state_from_json_a(_fz_arena, load64(_fz_sb), load64(_fz_sb + 8), &sb2);
        if (fz_all_finite(&s, 3) == 0 || is_ok(t2) == 0 || is_ok(t3) == 0 || memeq(&sb2, &s, 24) == 0) {
            _fz_bad = _fz_bad + 1;
        }
        var tv, vv = ry_pi3k_state_validate(&s);
        if (is_ok(tv) == 1) { fz_pi3k_step(&s, &dc); }
    }
    var c2: RyPi3kConfig;
    var cb: RyPi3kConfig;
    var t4, v4 = ry_pi3k_config_from_json_a(_fz_arena, data, len, &c2);
    if (is_ok(t4) == 1) {
        _fz_pi3k = _fz_pi3k + 1;
        store64(_fz_sb + 8, 0);
        var t5, v5 = ry_pi3k_config_to_json(_fz_sb, &c2);
        var t6, v6 = ry_pi3k_config_from_json_a(_fz_arena, load64(_fz_sb), load64(_fz_sb + 8), &cb);
        if (fz_all_finite(&c2, 9) == 0 || is_ok(t5) == 0 || is_ok(t6) == 0 || memeq(&cb, &c2, 72) == 0) {
            _fz_bad = _fz_bad + 1;
        }
        var tc, vc = ry_pi3k_config_validate(&c2);
        if (is_ok(tc) == 1) {
            var d: RyPi3kState;
            ry_pi3k_state_default(&d);
            fz_pi3k_step(&d, &c2);
        }
    }
    var fx: RyPi3kFlux;
    var fb: RyPi3kFlux;
    var t7, v7 = ry_pi3k_flux_from_json_a(_fz_arena, data, len, &fx);
    if (is_ok(t7) == 1) {
        _fz_pi3k = _fz_pi3k + 1;
        store64(_fz_sb + 8, 0);
        var t8, v8 = ry_pi3k_flux_to_json(_fz_sb, &fx);
        var t9, v9 = ry_pi3k_flux_from_json_a(_fz_arena, load64(_fz_sb), load64(_fz_sb + 8), &fb);
        if (fz_all_finite(&fx, 3) == 0 || is_ok(t8) == 0 || is_ok(t9) == 0 || memeq(&fb, &fx, 24) == 0) {
            _fz_bad = _fz_bad + 1;
        }
    }
    return 0;
}

# A NUL-terminated copy of the document builder `sb` holds (a seed).
fn fz_seed_of(sb): i64 {
    var n = load64(sb + 8);
    var s = alloc(n + 1);
    memcpy(s, load64(sb), n);
    store8(s + n, 0);
    return s;
}

# A word as a *RyPtmSite (the cast-helper idiom).
#must_use
fn _fz_as_sites(p): *RyPtmSite { return p; }

# ptm: the scan on every input: Ok(-1) for an empty one, else at most three sites per byte, sorted, each inside the
# sequence with a residue its pattern names and a motif range inside the input; the disulfide count is half the Cys
# sites.
fn fuzz_ptm(data, len) {
    reset_via(_fz_arena);
    var cap = RY_PTM_MAX_SITES_PER_RESIDUE * len;
    var sites: *RyPtmSite = _fz_as_sites(alloc_via(_fz_arena, 40 * cap + 40));
    var t, count = ry_scan_ptm_sites(data, len, sites, cap);
    if (is_ok(t) == 0) {
        _fz_bad = _fz_bad + 1;
        return 0;
    }
    if (len == 0 || count < 0 || count > cap) {
        if (len != 0 || count != 0 - 1) { _fz_bad = _fz_bad + 1; }
        return 0;
    }
    # The characters as src/ptm.cyr reads them: an ASCII byte, or any other byte and the continuation bytes after it.
    var chars = 0;
    var b = 0;
    while (b < len) {
        var lead = load8(data + b);
        b = b + 1;
        if (lead >= 128) {
            while (b < len && (load8(data + b) & 192) == 128) { b = b + 1; }
        }
        chars = chars + 1;
    }
    var cys = 0;
    var last = 0;
    var k = 0;
    while (k < count) {
        var s: *RyPtmSite = sites + k;
        var r = s.residue;
        var named = r == 78 || r == 89 || r == 83 || r == 84 || r == 67 || r == 71;
        if (s.position < last || s.position >= chars || named == 0) { _fz_bad = _fz_bad + 1; }
        if (s.ptm_type < 0 || s.ptm_type >= RY_PTM_TYPE_COUNT) { _fz_bad = _fz_bad + 1; }
        if (s.motif_start < 0 || s.motif_len < 1 || s.motif_len > 24 || s.motif_start + s.motif_len > len) {
            _fz_bad = _fz_bad + 1;
        }
        if (s.ptm_type == RY_PTM_TYPE_DISULFIDE_BOND) { cys = cys + 1; }
        last = s.position;
        k = k + 1;
    }
    if (ry_disulfide_bond_count(data, len) != cys / 2) { _fz_bad = _fz_bad + 1; }
    _fz_ptm = _fz_ptm + count;
    return 0;
}

# A word as a *RyDomainHit (the cast-helper idiom).
#must_use
fn _fz_as_hits(p): *RyDomainHit { return p; }

# domain: the scan on every input: Ok(-1) for an empty one, else at most nine hits per byte, sorted by start, each
# inside the sequence (start <= end), of a type the scan reports, with a fragment range inside the input.
fn fuzz_domain(data, len) {
    reset_via(_fz_arena);
    var cap = RY_DOMAIN_MAX_HITS_PER_RESIDUE * len;
    var hits: *RyDomainHit = _fz_as_hits(alloc_via(_fz_arena, 40 * cap + 40));
    var t, count = ry_scan_domains(data, len, hits, cap);
    if (is_ok(t) == 0) {
        _fz_bad = _fz_bad + 1;
        return 0;
    }
    if (len == 0 || count < 0 || count > cap) {
        if (len != 0 || count != 0 - 1) { _fz_bad = _fz_bad + 1; }
        return 0;
    }
    var chars = 0;
    var b = 0;
    while (b < len) {
        var lead = load8(data + b);
        b = b + 1;
        if (lead >= 128) {
            while (b < len && (load8(data + b) & 192) == 128) { b = b + 1; }
        }
        chars = chars + 1;
    }
    var last = 0;
    var k = 0;
    while (k < count) {
        var h: *RyDomainHit = hits + k;
        var ty = h.domain_type;
        if (h.start < last || h.start > h.end || h.end >= chars || h.end - h.start > 24) { _fz_bad = _fz_bad + 1; }
        if (ty < 0 || ty >= RY_DOMAIN_TYPE_COUNT || ty == RY_DOMAIN_TYPE_CATALYTIC_TRIAD) { _fz_bad = _fz_bad + 1; }
        var fs = h.fragment_start;
        var fl = h.fragment_len;
        if (fs < 0 || fl < h.end - h.start + 1 || fl > RY_DOMAIN_MAX_FRAGMENT_BYTES || fs + fl > len) {
            _fz_bad = _fz_bad + 1;
        }
        last = h.start;
        k = k + 1;
    }
    _fz_domain = _fz_domain + count;
    return 0;
}

# Copies seed `s` into buf and applies up to three random edits. Returns the new length.
fn fz_mutate(buf, cap, s): i64 {
    var n = strlen(s);
    if (n > cap) { n = cap; }
    memcpy(buf, s, n);
    var edits = fz_below(4);
    var k = 0;
    while (k < edits) {
        var op = fz_below(5);
        if (op == 0 && n > 0) { store8(buf + fz_below(n), fz_below(256)); }
        if (op == 1 && n < cap) {
            var at = fz_below(n + 1);
            var j = n;
            while (j > at) { store8(buf + j, load8(buf + j - 1)); j = j - 1; }
            store8(buf + at, fz_below(256));
            n = n + 1;
        }
        if (op == 2 && n > 0) {
            var at2 = fz_below(n);
            var j2 = at2;
            while (j2 + 1 < n) { store8(buf + j2, load8(buf + j2 + 1)); j2 = j2 + 1; }
            n = n - 1;
        }
        if (op == 3) { n = fz_below(n + 1); }
        if (op == 4 && n > 0) {
            var at3 = fz_below(n);
            var c = load8(buf + at3);
            if (c >= 97 && c <= 122) { store8(buf + at3, c - 32); }
        }
        k = k + 1;
    }
    return n;
}

# Runs the targets over 50,000 seeded inputs and reports.
fn main() {
    alloc_init();
    var cap = 2048;
    var buf = alloc(cap + 1);
    _fz_arena = arena_allocator_growable(65536);
    _fz_sb = str_builder_new();
    var seeds = alloc(8 * 67);
    store64(seeds, "trace");
    store64(seeds + 8, "DEBUG");
    store64(seeds + 16, "info,warn");
    store64(seeds + 24, "off");
    store64(seeds + 32, "rasayan=debug");
    store64(seeds + 40, "rasayan=+3,warn");
    store64(seeds + 48, "rasayan");
    store64(seeds + 56, "rasayan=");
    store64(seeds + 64, ",,,");
    store64(seeds + 72, "0000000000000000000000000000005");
    store64(seeds + 80, "rasayan::pathway=debug,rasayan=warn");
    store64(seeds + 88, "rasayan[{x=1}]=debug");
    store64(seeds + 96, "other=trace,rasayan=error");
    store64(seeds + 104, " debug ");
    store64(seeds + 112, "5,4,3,2,1,0");
    store64(seeds + 120, "rasayan=OFF,rasayan=Trace");
    store64(seeds + 128, "{\"p_na\":0.04,\"p_k\":1.0,\"p_cl\":0.45}");
    store64(seeds + 136, "[0.04,1.0,0.45]");
    store64(seeds + 144, "{\"p_cl\":1e400,\"x\":[1,{\"y\":null}],\"p_na\":-0,\"p_k\":2}");
    store64(seeds + 152, "[1.5,-0.0,0.04,1e-7,100]");
    store64(seeds + 160, "\"a\\u00e9\\ud83d\\ude00\\n\"");
    store64(seeds + 168, "4294967295");
    store64(seeds + 176, "{\"p_na\":96485.33212331001,\"p_k\":2.2250738585072011e-308,\"p_cl\":5e-324}");
    store64(seeds + 184, "[[[[[[1]]]]],{\"a\":\"\\u0000\"},true,false,null]");
    store64(seeds + 192, "{\"na_in\":12.0,\"na_out\":145,\"k_in\":155.0,\"k_out\":4,\"cl_in\":4.0,\"cl_out\":120}");
    store64(seeds + 200, "[12,145,155,4,4,1.2e2]");
    store64(seeds + 208, "{\"camp\":0.1,\"calcium\":0.05,\"ip3\":0.05}");
    store64(seeds + 216, "{\"atp\":6,\"adp\":0.5,\"nad_ratio\":700,\"glucose\":5,\"oxygen\":1,\"lactate\":1}");
    store64(seeds + 224, "{\"phosphocreatine\":0.9,\"glycogen\":0.8,\"met\":1,\"anaerobic_threshold\":6}");
    store64(seeds + 232, "MQIFVKTLTGKTITLEVEPSDTIENVKAKIQDKEGIPPDQQRLIFAGKQLEDGRTLSDYNIQKESTLHLVLRLRGG");
    store64(seeds + 240, "ACDEFGHIKLMNPQRSTVWY");
    store64(seeds + 248, "AAAAAELLLLVVVIIYNGPS");
    store64(seeds + 256, "acdkAAAAAAPAAANPDGvvvvv");
    store64(seeds + 264, "HEAGAWGHEEPAWHEAE");
    store64(seeds + 272, "MKTAYIAKQRQISFVKSHFSRQMKVLAAGIVGLLLAQPSHAEKR");
    store64(seeds + 280, "MGSNKSKPKDKRASNSTAYCSAAERRSSNASA");
    store64(seeds + 288, "MGÉ🧬ASANÉSARRÉSSÉÉEcCnasa");
    store64(seeds + 296, "RGDAADEADKKAKGAAAAGKSDKDGDGTITTKEAKDEL");
    store64(seeds + 304, "PYACPVESCDRRFSRSDELTRHIRIHTGQKLAAAAAALAAAAAALAAAAAALCAACCCALLLAAAAAAHHHAHHHHH");
    # The glycolysis documents: the default state in the sequence form, the default config and a step's flux as
    # written.
    store64(seeds + 312, "[5,0.083,0.014,0.031,0.14,0.019,0.001,0.12,0.03,0.023,0.051]");
    var gc: RyGlycolysisConfig;
    var gs: RyGlycolysisState;
    var gf: RyGlycolysisFlux;
    ry_glycolysis_config_default(&gc);
    ry_glycolysis_state_default(&gs);
    ry_glycolysis_state_tick(&gs, &gc, 6.0, 0.5, 700.0, 0.1, &gf);
    store64(_fz_sb + 8, 0);
    var tg1, vg1 = ry_glycolysis_config_to_json(_fz_sb, &gc);
    store64(seeds + 320, fz_seed_of(_fz_sb));
    store64(_fz_sb + 8, 0);
    var tg2, vg2 = ry_glycolysis_flux_to_json(_fz_sb, &gf);
    store64(seeds + 328, fz_seed_of(_fz_sb));
    # The TCA documents: the default state in the sequence form, the default config and a step's flux as written.
    store64(seeds + 336, "[0.05,0.3,0.02,0.3,0.1,0.5,0.05,0.3,0.01]");
    var tc: RyTcaConfig;
    var tst: RyTcaState;
    var tfx: RyTcaFlux;
    ry_tca_config_default(&tc);
    ry_tca_state_default(&tst);
    ry_tca_state_tick(&tst, &tc, 0.1, 6.0, 0.5, 700.0, 0.1, &tfx);
    store64(_fz_sb + 8, 0);
    var tt1, vt1 = ry_tca_config_to_json(_fz_sb, &tc);
    store64(seeds + 344, fz_seed_of(_fz_sb));
    store64(_fz_sb + 8, 0);
    var tt2, vt2 = ry_tca_flux_to_json(_fz_sb, &tfx);
    store64(seeds + 352, fz_seed_of(_fz_sb));
    # The ETC documents: the default state, the default config and a step's flux as written.
    store64(seeds + 360, "{\"pmf\":0.6,\"qh2_fraction\":0.3,\"cytc_reduced\":0.2}");
    var ecf: RyEtcConfig;
    var est: RyEtcState;
    var efx: RyEtcFlux;
    ry_etc_config_default(&ecf);
    ry_etc_state_default(&est);
    ry_etc_state_tick(&est, &ecf, 0.5, 0.1, 1.0, 0.5, 0.1, &efx);
    store64(_fz_sb + 8, 0);
    var te1, ve1 = ry_etc_config_to_json(_fz_sb, &ecf);
    store64(seeds + 368, fz_seed_of(_fz_sb));
    store64(_fz_sb + 8, 0);
    var te2, ve2 = ry_etc_flux_to_json(_fz_sb, &efx);
    store64(seeds + 376, fz_seed_of(_fz_sb));
    # The β-oxidation documents: the default state, the default config (its chain length an integer) and a step's flux.
    store64(seeds + 384, "{\"acyl_coa\":0.02,\"free_fatty_acid\":0.3}");
    store64(seeds + 392, "[16,0.05,0.1,0.03,0.01,0.01]");
    var bxc: RyBetaOxConfig;
    var bxs: RyBetaOxState;
    var bxf: RyBetaOxFlux;
    ry_beta_ox_config_default(&bxc);
    ry_beta_ox_state_default(&bxs);
    ry_beta_ox_state_tick(&bxs, &bxc, 0.0, 700.0, 0.1, &bxf);
    store64(_fz_sb + 8, 0);
    var tb1, vb1 = ry_beta_ox_flux_to_json(_fz_sb, &bxf);
    store64(seeds + 400, fz_seed_of(_fz_sb));
    # The amino-acid catabolism documents: the default routing, the default state in the sequence form, the default
    # config (its routing a nested object) and a step's flux as written.
    store64(seeds + 416, "[2,0.5,0.05]");
    var amc: RyAminoCatabConfig;
    var ams: RyAminoCatabState;
    var amf: RyAminoCatabFlux;
    ry_amino_catab_config_default(&amc);
    ry_amino_catab_state_default(&ams);
    ry_amino_catab_state_tick(&ams, &amc, 0.3, 700.0, 0.1, &amf);
    var amr: RyCarbonSkeletonOutput;
    ry_carbon_skeleton_output_default(&amr);
    store64(_fz_sb + 8, 0);
    var ta0, va0 = ry_carbon_skeleton_output_to_json(_fz_sb, &amr);
    store64(seeds + 408, fz_seed_of(_fz_sb));
    store64(_fz_sb + 8, 0);
    var ta1, va1 = ry_amino_catab_config_to_json(_fz_sb, &amc);
    store64(seeds + 424, fz_seed_of(_fz_sb));
    store64(_fz_sb + 8, 0);
    var ta2, va2 = ry_amino_catab_flux_to_json(_fz_sb, &amf);
    store64(seeds + 432, fz_seed_of(_fz_sb));
    # The network documents: the default network, config, flux, environment, exchange and tick as written.
    var nwn: RyMetabolicNetwork;
    var nwc: RyNetworkConfig;
    var nwf: RyNetworkFlux;
    var nwe: RyNetworkEnvironment;
    var nwx: RyNetworkExchange;
    var nwt: RyNetworkTick;
    ry_metabolic_network_default(&nwn);
    ry_network_config_default(&nwc);
    ry_network_flux_default(&nwf);
    ry_network_environment_default(&nwe);
    ry_network_exchange_default(&nwx);
    ry_network_tick_default(&nwt);
    store64(_fz_sb + 8, 0);
    var tn1, vn1 = ry_metabolic_network_to_json(_fz_sb, &nwn);
    store64(seeds + 440, fz_seed_of(_fz_sb));
    store64(_fz_sb + 8, 0);
    var tn2, vn2 = ry_network_config_to_json(_fz_sb, &nwc);
    store64(seeds + 448, fz_seed_of(_fz_sb));
    store64(_fz_sb + 8, 0);
    var tn3, vn3 = ry_network_flux_to_json(_fz_sb, &nwf);
    store64(seeds + 456, fz_seed_of(_fz_sb));
    store64(_fz_sb + 8, 0);
    var tn4, vn4 = ry_network_environment_to_json(_fz_sb, &nwe);
    store64(seeds + 464, fz_seed_of(_fz_sb));
    store64(_fz_sb + 8, 0);
    var tn5, vn5 = ry_network_exchange_to_json(_fz_sb, &nwx);
    store64(seeds + 472, fz_seed_of(_fz_sb));
    store64(_fz_sb + 8, 0);
    var tn6, vn6 = ry_network_tick_to_json(_fz_sb, &nwt);
    store64(seeds + 480, fz_seed_of(_fz_sb));
    # The MAPK documents: the default state in the sequence form, the default config and a tick's flux as written.
    store64(seeds + 488, "[0.05,0.02,0.01,0.01]");
    var mkc: RyMapkConfig;
    var mks: RyMapkState;
    var mkf: RyMapkFlux;
    ry_mapk_config_default(&mkc);
    ry_mapk_state_default(&mks);
    ry_mapk_state_tick(&mks, &mkc, 0.5, 0.1, &mkf);
    store64(_fz_sb + 8, 0);
    var tm1, vm1 = ry_mapk_config_to_json(_fz_sb, &mkc);
    store64(seeds + 496, fz_seed_of(_fz_sb));
    store64(_fz_sb + 8, 0);
    var tm2, vm2 = ry_mapk_flux_to_json(_fz_sb, &mkf);
    store64(seeds + 504, fz_seed_of(_fz_sb));
    # The PI3K documents: the default state in the sequence form, the default config and a tick's flux as written.
    store64(seeds + 512, "[0.05,0.03,0.02]");
    var pkc: RyPi3kConfig;
    var pks: RyPi3kState;
    var pkf: RyPi3kFlux;
    ry_pi3k_config_default(&pkc);
    ry_pi3k_state_default(&pks);
    ry_pi3k_state_tick(&pks, &pkc, 0.5, 0.1, &pkf);
    store64(_fz_sb + 8, 0);
    var tp1, vp1 = ry_pi3k_config_to_json(_fz_sb, &pkc);
    store64(seeds + 520, fz_seed_of(_fz_sb));
    store64(_fz_sb + 8, 0);
    var tp2, vp2 = ry_pi3k_flux_to_json(_fz_sb, &pkf);
    store64(seeds + 528, fz_seed_of(_fz_sb));
    var i = 0;
    while (i < 50000) {
        var n = 0;
        if (fz_below(4) == 0) {
            n = fz_below(41);
            var k = 0;
            while (k < n) { store8(buf + k, fz_below(256)); k = k + 1; }
        } else {
            n = fz_mutate(buf, cap, load64(seeds + 8 * fz_below(67)));
        }
        fuzz_main(buf, n);
        fuzz_json(buf, n);
        fuzz_membrane(buf, n);
        fuzz_protein(buf, n);
        fuzz_alignment(buf, n);
        fuzz_ptm(buf, n);
        fuzz_domain(buf, n);
        fuzz_glycolysis(buf, n);
        fuzz_tca(buf, n);
        fuzz_etc(buf, n);
        fuzz_beta_ox(buf, n);
        fuzz_amino(buf, n);
        fuzz_network(buf, n);
        fuzz_mapk(buf, n);
        fuzz_pi3k(buf, n);
        i = i + 1;
    }
    if (_fz_bad != 0) {
        print("fuzz: out-of-range results: ", 28);
        println_int(_fz_bad);
        return 1;
    }
    print("fuzz: ok (50000 inputs; RASAYAN_LOG values read: ", 50);
    fmt_int(_fz_read);
    print(", JSON documents read as a struct: ", 35);
    fmt_int(_fz_json_read);
    print(", as one of the five struct codecs, written and read back: ", 59);
    fmt_int(_fz_codec_read);
    print(", isoelectric points defined: ", 30);
    fmt_int(_fz_protein);
    print(", halves aligned: ", 18);
    fmt_int(_fz_aligned);
    print(", PTM sites: ", 13);
    fmt_int(_fz_ptm);
    print(", domain hits: ", 15);
    fmt_int(_fz_domain);
    print(", glycolysis documents read: ", 29);
    fmt_int(_fz_glycolysis);
    print(", TCA documents read: ", 22);
    fmt_int(_fz_tca);
    print(", ETC documents read: ", 22);
    fmt_int(_fz_etc);
    print(", beta-oxidation documents read: ", 33);
    fmt_int(_fz_beta_ox);
    print(", amino-acid catabolism documents read: ", 40);
    fmt_int(_fz_amino);
    print(", network documents read: ", 26);
    fmt_int(_fz_network);
    print(", networks stepped: ", 20);
    fmt_int(_fz_net_stepped);
    print(", MAPK documents read: ", 23);
    fmt_int(_fz_mapk);
    print(", PI3K documents read: ", 23);
    fmt_int(_fz_pi3k);
    println(")");
    return 0;
}

var r = main();
sys_exit_group(r);
