            if (is_ok(tw) == 0 || fz_all_finite(&f, 14) == 0 || balance > bound) { _fz_bad = _fz_bad + 1; }
        }
    }
    var c2: RyTcaConfig;
    var cb: RyTcaConfig;
    var t4, v4 = ry_tca_config_from_json_a(_fz_arena, data, len, &c2);
    if (is_ok(t4) == 1) {
        _fz_tca = _fz_tca + 1;
        store64(_fz_sb + 8, 0);
        var t5, v5 = ry_tca_config_to_json(_fz_sb, &c2);
        var t6, v6 = ry_tca_config_from_json_a(_fz_arena, load64(_fz_sb), load64(_fz_sb + 8), &cb);
        if (fz_all_finite(&c2, 32) == 0 || is_ok(t5) == 0 || is_ok(t6) == 0 || memeq(&cb, &c2, 256) == 0) {
            _fz_bad = _fz_bad + 1;
        }
    }
    var fx: RyTcaFlux;
    var fb: RyTcaFlux;
    var t7, v7 = ry_tca_flux_from_json_a(_fz_arena, data, len, &fx);
    if (is_ok(t7) == 1) {
