}

# The ETC codecs on one input: an accepted state, config or flux is finite and reads back bit for bit. An accepted
# state that validates stays valid through a 0.5 s and a 50 s step, consumes no more NADH, FADH2 or ADP than it is
# offered, and balances its electron pairs: what enters (NADH and FADH2 oxidized) is the water made plus what Q and
# cytochrome c now hold more, to 1e-12.
fn fuzz_etc(data, len) {
    reset_via(_fz_arena);
    var s: RyEtcState;
    var sb2: RyEtcState;
    var t1, v1 = ry_etc_state_from_json_a(_fz_arena, data, len, &s);
    if (is_ok(t1) == 1) {
        _fz_etc = _fz_etc + 1;
        if (fz_all_finite(&s, 3) == 0) { _fz_bad = _fz_bad + 1; }
        store64(_fz_sb + 8, 0);
        var t2, v2 = ry_etc_state_to_json(_fz_sb, &s);
        var t3, v3 = ry_etc_state_from_json_a(_fz_arena, load64(_fz_sb), load64(_fz_sb + 8), &sb2);
        if (is_ok(t2) == 0 || is_ok(t3) == 0 || memeq(&sb2, &s, 24) == 0) { _fz_bad = _fz_bad + 1; }
        var tv, vv = ry_etc_state_validate(&s);
        if (is_ok(tv) == 1) {
            var c: RyEtcConfig;
            var f: RyEtcFlux;
            ry_etc_config_default(&c);
            var stored0: f64 = s.qh2_fraction + s.cytc_reduced;
            ry_etc_state_tick(&s, &c, 0.5, 0.1, 1.0, 0.5, 0.5, &f);
            var e_in: f64 = f.nadh_consumed + f.fadh2_consumed;
            var e_out: f64 = f.h2o_produced;
            var over = 0;
            var n1: f64 = f.nadh_consumed;
            var a1: f64 = f.atp_produced;
            if (n1 > 0.5 || a1 > 0.5) { over = 1; }
            ry_etc_state_tick(&s, &c, 2.0, 0.5, 1.0, 0.5, 50.0, &f);
            e_in = e_in + (f.nadh_consumed + f.fadh2_consumed);
            e_out = e_out + f.h2o_produced;
            var n2: f64 = f.nadh_consumed;
            var fa2: f64 = f.fadh2_consumed;
            if (n2 > 2.0 || fa2 > 0.5) { over = 1; }
            var stored: f64 = s.qh2_fraction + s.cytc_reduced - stored0;
            var imbalance: f64 = f64_abs(e_in - e_out - stored);
            var tw, vw = ry_etc_state_validate(&s);
            if (is_ok(tw) == 0 || over == 1 || fz_all_finite(&f, 10) == 0 || imbalance > 0.000000000001) {
                _fz_bad = _fz_bad + 1;
            }
        }
    }
    var c2: RyEtcConfig;
    var cb: RyEtcConfig;
    var t4, v4 = ry_etc_config_from_json_a(_fz_arena, data, len, &c2);
    if (is_ok(t4) == 1) {
        _fz_etc = _fz_etc + 1;
        store64(_fz_sb + 8, 0);
        var t5, v5 = ry_etc_config_to_json(_fz_sb, &c2);
        var t6, v6 = ry_etc_config_from_json_a(_fz_arena, load64(_fz_sb), load64(_fz_sb + 8), &cb);
        if (fz_all_finite(&c2, 14) == 0 || is_ok(t5) == 0 || is_ok(t6) == 0 || memeq(&cb, &c2, 112) == 0) {
            _fz_bad = _fz_bad + 1;
        }
    }
    var fx: RyEtcFlux;
    var fb: RyEtcFlux;
    var t7, v7 = ry_etc_flux_from_json_a(_fz_arena, data, len, &fx);
    if (is_ok(t7) == 1) {
        _fz_etc = _fz_etc + 1;
        store64(_fz_sb + 8, 0);
        var t8, v8 = ry_etc_flux_to_json(_fz_sb, &fx);
        var t9, v9 = ry_etc_flux_from_json_a(_fz_arena, load64(_fz_sb), load64(_fz_sb + 8), &fb);
        if (fz_all_finite(&fx, 10) == 0 || is_ok(t8) == 0 || is_ok(t9) == 0 || memeq(&fb, &fx, 80) == 0) {
            _fz_bad = _fz_bad + 1;
        }
    }
    return 0;
}

# The β-oxidation codecs on one input: an accepted state, config or flux is finite (its chain length a u32) and reads
# back bit for bit. An accepted state that validates, with both pools below 1e300, stays valid through a 0.5 s and a
# 50 s step on the default config, and conserves its carbon (what it holds plus 2 per acetyl-CoA released), to 1e-12.
fn fuzz_beta_ox(data, len) {
    reset_via(_fz_arena);
    var s: RyBetaOxState;
    var sb2: RyBetaOxState;
    var t1, v1 = ry_beta_ox_state_from_json_a(_fz_arena, data, len, &s);
    if (is_ok(t1) == 1) {
        _fz_beta_ox = _fz_beta_ox + 1;
        if (fz_all_finite(&s, 2) == 0) { _fz_bad = _fz_bad + 1; }
        store64(_fz_sb + 8, 0);
        var t2, v2 = ry_beta_ox_state_to_json(_fz_sb, &s);
        var t3, v3 = ry_beta_ox_state_from_json_a(_fz_arena, load64(_fz_sb), load64(_fz_sb + 8), &sb2);
        if (is_ok(t2) == 0 || is_ok(t3) == 0 || memeq(&sb2, &s, 16) == 0) { _fz_bad = _fz_bad + 1; }
        var tv, vv = ry_beta_ox_state_validate(&s);
        var huge: f64 = 0x7E37E43C8800759C;     # 1e300
        var acyl0: f64 = s.acyl_coa;
        var ffa0: f64 = s.free_fatty_acid;
        if (is_ok(tv) == 1 && acyl0 < huge && ffa0 < huge) {
            var c: RyBetaOxConfig;
            var f: RyBetaOxFlux;
            ry_beta_ox_config_default(&c);
            var n: f64 = f64_from(c.chain_length);
            var before: f64 = n * (acyl0 + ffa0);
            ry_beta_ox_state_tick(&s, &c, 0.0, 700.0, 0.5, &f);
            var out: f64 = f.acetyl_coa_produced;
            ry_beta_ox_state_tick(&s, &c, 0.0, 700.0, 50.0, &f);
            out = out + f.acetyl_coa_produced;
            var held: f64 = s.acyl_coa + s.free_fatty_acid;
            var after: f64 = n * held + 2.0 * out;
            var drift: f64 = f64_abs(after - before);
            var bound: f64 = 0.000000000001 * before;
            var tw, vw = ry_beta_ox_state_validate(&s);
            if (is_ok(tw) == 0 || fz_all_finite(&f, 8) == 0 || drift > bound) { _fz_bad = _fz_bad + 1; }
        }
    }
    var c2: RyBetaOxConfig;
    var cb: RyBetaOxConfig;
    var t4, v4 = ry_beta_ox_config_from_json_a(_fz_arena, data, len, &c2);
    if (is_ok(t4) == 1) {
        _fz_beta_ox = _fz_beta_ox + 1;
        store64(_fz_sb + 8, 0);
        var t5, v5 = ry_beta_ox_config_to_json(_fz_sb, &c2);
        var t6, v6 = ry_beta_ox_config_from_json_a(_fz_arena, load64(_fz_sb), load64(_fz_sb + 8), &cb);
        var chain = c2.chain_length;
        if (chain < 0 || chain > 4294967295 || fz_all_finite(&c2 + 8, 5) == 0 || is_ok(t5) == 0 || is_ok(t6) == 0
          || memeq(&cb, &c2, 48) == 0) {
            _fz_bad = _fz_bad + 1;
        }
    }
    var fx: RyBetaOxFlux;
    var fb: RyBetaOxFlux;
    var t7, v7 = ry_beta_ox_flux_from_json_a(_fz_arena, data, len, &fx);
    if (is_ok(t7) == 1) {
        _fz_beta_ox = _fz_beta_ox + 1;
        store64(_fz_sb + 8, 0);
        var t8, v8 = ry_beta_ox_flux_to_json(_fz_sb, &fx);
        var t9, v9 = ry_beta_ox_flux_from_json_a(_fz_arena, load64(_fz_sb), load64(_fz_sb + 8), &fb);
        if (fz_all_finite(&fx, 8) == 0 || is_ok(t8) == 0 || is_ok(t9) == 0 || memeq(&fb, &fx, 64) == 0) {
            _fz_bad = _fz_bad + 1;
        }
    }
    return 0;
}

# Steps amino-acid catabolism state *s on config *c 0.5 s, then 50 s, at α-KG 0.3 and NAD+/NADH 700: a failure when
# the state stops validating, a flux is not finite, or the nitrogen (the three pools plus what the sink cleared) moves
# more than 1e-12 of the start.
fn fz_amino_step(s: *RyAminoCatabState, c: *RyAminoCatabConfig) {
    var f: RyAminoCatabFlux;
    var before: f64 = s.amino_acid_pool + s.glutamate + s.ammonium;
    ry_amino_catab_state_tick(s, c, 0.3, 700.0, 0.5, &f);
    var cleared: f64 = f.nh4_cleared;
    var ok = fz_all_finite(&f, 12);
    ry_amino_catab_state_tick(s, c, 0.3, 700.0, 50.0, &f);
    cleared = cleared + f.nh4_cleared;
    if (fz_all_finite(&f, 12) == 0) { ok = 0; }
    var after: f64 = s.amino_acid_pool + s.glutamate + s.ammonium + cleared;
    var drift: f64 = f64_abs(after - before);
    var bound: f64 = 0.000000000001 * before;
    var tv, vv = ry_amino_catab_state_validate(s);
    if (is_ok(tv) == 0 || ok == 0 || drift > bound) { _fz_bad = _fz_bad + 1; }
    return 0;
}

# amino_catabolism: the four codecs on one input (an accepted value holds only finite f64s and reads back bit for bit
# from what it writes); a valid state with pools under 1e300, and the default state on an accepted config that
# validates, each stepped by fz_amino_step.
fn fuzz_amino(data, len) {
    reset_via(_fz_arena);
    var r: RyCarbonSkeletonOutput;
