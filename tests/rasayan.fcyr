# rasayan fuzz harness
#
# `cyrius fuzz --poison --bounds` runs it (port plan §6: every reader of untrusted input), over 50,000 seeded inputs:
# a quarter random bytes, the rest mutations of seeds (ushma's harness: xorshift64*, byte edits, insertions, deletions,
# truncations, case flips). M1: RASAYAN_LOG, which comes from the environment, and the JSON readers (part 3b: a
# document parsed on an arena reset per input, then read as an all-f64 struct, a [f64; 5], a string and an integer).
# The sequence readers and each type's codec join with their milestones: M2 part 2, IonicState's and
# MembranePermeability's; part 3, SecondMessenger's; part 4, MetabolicState's; part 5, BioenergyState's. M3 part 1:
# every protein function on the input as a sequence; part 2, alignment on its two halves; parts 3 and 4, the PTM and
# domain scans. M4a part 1: the three glycolysis codecs, and a tick of every state the reader accepts.

include "src/constants.cyr"
include "src/constants_private.cyr"
include "src/mathx_data.cyr"
include "src/mathx.cyr"
include "src/fmtf.cyr"
include "src/error.cyr"
include "src/guard.cyr"
include "src/logging.cyr"
include "src/json.cyr"
include "src/membrane_data.cyr"
include "src/membrane.cyr"
include "src/integrate.cyr"
include "src/enzyme_data.cyr"
include "src/enzyme.cyr"
include "src/signal_data.cyr"
include "src/signal.cyr"
include "src/metabolism_data.cyr"
include "src/metabolism.cyr"
include "src/energy_data.cyr"
include "src/energy.cyr"
include "src/protein_data.cyr"
include "src/protein.cyr"
include "src/alignment_data.cyr"
include "src/alignment.cyr"
include "src/ptm.cyr"
include "src/domain.cyr"
include "src/glycolysis_data.cyr"
include "src/glycolysis.cyr"

var _fz_state = 0x2545F4914F6CDD1D;
var _fz_bad = 0;
var _fz_read = 0;
var _fz_cstr[2056];
var _fz_arena = 0;
var _fz_json_read = 0;
var _fz_codec_read = 0;
var _fz_sb = 0;
var _fz_protein = 0;
var _fz_aligned = 0;
var _fz_ptm = 0;
var _fz_domain = 0;
var _fz_glycolysis = 0;

# xorshift64*: the next pseudo-random word.
fn fz_next(): i64 {
    var x = _fz_state;
    x = x ^ ((x >> 12) & 0x000FFFFFFFFFFFFF);
    x = x ^ (x << 25);
    x = x ^ ((x >> 27) & 0x0000001FFFFFFFFF);
    _fz_state = x;
    return x * 0x2545F4914F6CDD1D;
}

# A pseudo-random integer in 0 .. n - 1.
fn fz_below(n): i64 {
    var r = fz_next() & 0x7FFFFFFFFFFFFFFF;
    return r % n;
}

# RASAYAN_LOG's readers on one input: each answers a level in range without reading past the bytes; a value the port
# reads is the level ry_log_level_of applies over any default; the same bytes as a default (NUL-terminated, up to its
# first NUL) give a level in range too.
fn fuzz_main(data, len) {
    var lv = ry_log_parse(data, len);
    if (lv < 0 - 1 || lv > RY_LOG_OFF) { _fz_bad = _fz_bad + 1; }
    var r = ry_log_level_of(data, len, "warn");
    if (r < 0 || r > RY_LOG_OFF) { _fz_bad = _fz_bad + 1; }
    if (lv >= 0) {
        _fz_read = _fz_read + 1;
        if (r != lv) { _fz_bad = _fz_bad + 1; }
    } elif (r != LOG_WARN) {
        _fz_bad = _fz_bad + 1;
    }
    var n = len;
    if (n > 2048) { n = 2048; }
    memcpy(&_fz_cstr, data, n);
    store8(&_fz_cstr + n, 0);
    var d = ry_log_level_of(0, 0, &_fz_cstr);
    if (d < 0 || d > RY_LOG_OFF) { _fz_bad = _fz_bad + 1; }
    return 0;
}

# The JSON readers on one input: any outcome is fine, but an accepted struct or array holds only finite f64s, an
# accepted string is valid UTF-8, an accepted u32 is in range.
fn fuzz_json(data, len) {
    reset_via(_fz_arena);
    var v = _ry_jr_parse(_fz_arena, data, len);
    if (v == 0) { return 0; }
    var w[40];
    if (_ry_jr_f64_fields(v, &w, 3, "p_na\0p_k\0p_cl\0") == 1) {
        _fz_json_read = _fz_json_read + 1;
        var k = 0;
        while (k < 3) {
            var x: f64 = load64(&w + 8 * k);
            if (_ry_is_finite(x) == 0) { _fz_bad = _fz_bad + 1; }
            k = k + 1;
        }
    }
    if (_ry_jr_f64_array(v, &w, 5) == 1) {
        var j = 0;
        while (j < 5) {
            var y: f64 = load64(&w + 8 * j);
            if (_ry_is_finite(y) == 0) { _fz_bad = _fz_bad + 1; }
            j = j + 1;
        }
    }
    var sp[8];
    var sn[8];
    if (_ry_jr_str(v, &sp, &sn) == 1 && _ry_utf8_valid(load64(&sp), load64(&sn)) == 0) { _fz_bad = _fz_bad + 1; }
    var u[8];
    if (_ry_jr_int(v, 0, 4294967295, &u) == 1 && (load64(&u) < 0 || load64(&u) > 4294967295)) { _fz_bad = _fz_bad + 1; }
    return 0;
}

# 1 when the `n` f64 words at `w` are all finite.
fn fz_all_finite(w, n): i64 {
    var k = 0;
    while (k < n) {
        var x: f64 = load64(w + 8 * k);
        if (_ry_is_finite(x) == 0) { return 0; }
        k = k + 1;
    }
    return 1;
}

# The membrane, signal, metabolism and energy codecs on one input: an accepted IonicState, MembranePermeability,
# SecondMessenger, MetabolicState or BioenergyState holds
# only finite f64s, and the document its writer makes reads back to the same bits; a SecondMessenger stepped from it
# stays in [0, 1]; a MetabolicState's energy charge is in [0, 1] and a step from valid pools conserves ATP + ADP; a
# BioenergyState's reserves stay in [0, 1] after a tick.
fn fuzz_membrane(data, len) {
    reset_via(_fz_arena);
    var ions: RyIonicState;
    var back: RyIonicState;
    var t1, v1 = ry_ionic_state_from_json_a(_fz_arena, data, len, &ions);
    if (is_ok(t1) == 1) {
        _fz_codec_read = _fz_codec_read + 1;
        if (fz_all_finite(&ions, 6) == 0) { _fz_bad = _fz_bad + 1; }
        store64(_fz_sb + 8, 0);
        var t2, v2 = ry_ionic_state_to_json(_fz_sb, &ions);
        var t3, v3 = ry_ionic_state_from_json_a(_fz_arena, load64(_fz_sb), load64(_fz_sb + 8), &back);
        if (is_ok(t2) == 0 || is_ok(t3) == 0 || memeq(&back, &ions, 48) == 0) { _fz_bad = _fz_bad + 1; }
    }
    var perm: RyMembranePermeability;
    var pb: RyMembranePermeability;
    var t4, v4 = ry_membrane_permeability_from_json_a(_fz_arena, data, len, &perm);
    if (is_ok(t4) == 1) {
        _fz_codec_read = _fz_codec_read + 1;
        if (fz_all_finite(&perm, 3) == 0) { _fz_bad = _fz_bad + 1; }
        store64(_fz_sb + 8, 0);
        var t5, v5 = ry_membrane_permeability_to_json(_fz_sb, &perm);
        var t6, v6 = ry_membrane_permeability_from_json_a(_fz_arena, load64(_fz_sb), load64(_fz_sb + 8), &pb);
        if (is_ok(t5) == 0 || is_ok(t6) == 0 || memeq(&pb, &perm, 24) == 0) { _fz_bad = _fz_bad + 1; }
    }
    var sm: RySecondMessenger;
    var sb2: RySecondMessenger;
    var t7, v7 = ry_second_messenger_from_json_a(_fz_arena, data, len, &sm);
    if (is_ok(t7) == 1) {
        _fz_codec_read = _fz_codec_read + 1;
        if (fz_all_finite(&sm, 3) == 0) { _fz_bad = _fz_bad + 1; }
        store64(_fz_sb + 8, 0);
        var t8, v8 = ry_second_messenger_to_json(_fz_sb, &sm);
        var t9, v9 = ry_second_messenger_from_json_a(_fz_arena, load64(_fz_sb), load64(_fz_sb + 8), &sb2);
        if (is_ok(t8) == 0 || is_ok(t9) == 0 || memeq(&sb2, &sm, 24) == 0) { _fz_bad = _fz_bad + 1; }
        # Whatever it holds, a tick and the activations leave every level in [0, 1].
        ry_second_messenger_activate_gq(&sm, 0.5);
        ry_second_messenger_tick(&sm, 0.5);
        var k = 0;
        while (k < 3) {
            var x: f64 = load64(&sm + 8 * k);
            if (x != x || x < 0.0 || x > 1.0) { _fz_bad = _fz_bad + 1; }
            k = k + 1;
        }
    }
    var mt: RyMetabolicState;
    var mb: RyMetabolicState;
    var t10, v10 = ry_metabolic_state_from_json_a(_fz_arena, data, len, &mt);
    if (is_ok(t10) == 1) {
        _fz_codec_read = _fz_codec_read + 1;
        if (fz_all_finite(&mt, 6) == 0) { _fz_bad = _fz_bad + 1; }
        store64(_fz_sb + 8, 0);
        var t11, v11 = ry_metabolic_state_to_json(_fz_sb, &mt);
        var t12, v12 = ry_metabolic_state_from_json_a(_fz_arena, load64(_fz_sb), load64(_fz_sb + 8), &mb);
        if (is_ok(t11) == 0 || is_ok(t12) == 0 || memeq(&mb, &mt, 48) == 0) { _fz_bad = _fz_bad + 1; }
        # The energy charge stays finite in [0, 1]; a step conserves ATP + ADP when both pools are valid.
        var ec: f64 = ry_metabolic_state_energy_charge(&mt);
        if (ec != ec || ec < 0.0 || ec > 1.0) { _fz_bad = _fz_bad + 1; }
        var a0: f64 = mt.atp;
        var d0: f64 = mt.adp;
        var c: f64 = ry_metabolic_state_consume_atp(&mt, 0.5);
        ry_metabolic_state_regenerate_atp(&mt, 0.5);
        var a1: f64 = mt.atp;
        var d1: f64 = mt.adp;
        var before: f64 = a0 + d0;
        var after: f64 = a1 + d1;
        var drift: f64 = f64_abs(after - before);
        var bound: f64 = 0.000000000001 * (1.0 + f64_abs(before));
        if (a0 >= 0.0 && d0 >= 0.0 && drift > bound) { _fz_bad = _fz_bad + 1; }
    }
    var be: RyBioenergyState;
    var bb: RyBioenergyState;
    var t13, v13 = ry_bioenergy_state_from_json_a(_fz_arena, data, len, &be);
    if (is_ok(t13) == 1) {
        _fz_codec_read = _fz_codec_read + 1;
        if (fz_all_finite(&be, 4) == 0) { _fz_bad = _fz_bad + 1; }
        store64(_fz_sb + 8, 0);
        var t14, v14 = ry_bioenergy_state_to_json(_fz_sb, &be);
        var t15, v15 = ry_bioenergy_state_from_json_a(_fz_arena, load64(_fz_sb), load64(_fz_sb + 8), &bb);
        if (is_ok(t14) == 0 || is_ok(t15) == 0 || memeq(&bb, &be, 32) == 0) { _fz_bad = _fz_bad + 1; }
        # Whatever it holds, a tick leaves both reserves in [0, 1].
        ry_bioenergy_state_tick(&be, 1.0);
        var pcr: f64 = be.phosphocreatine;
        var gly: f64 = be.glycogen;
        if (pcr != pcr || pcr < 0.0 || pcr > 1.0 || gly != gly || gly < 0.0 || gly > 1.0) { _fz_bad = _fz_bad + 1; }
    }
    return 0;
}

# The protein functions on one input as a sequence: any outcome is fine, but a weight is finite and positive, the
# composition has at most 26 letters and no more counts than bytes, the net charge at pH 7 is finite, a pI is in
# [0, 14] for every set, an extinction coefficient is oxidized >= reduced >= 0, and a Chou-Fasman prediction has one
# value in 0 .. 3 per byte or none.
fn fuzz_protein(data, len) {
    var w: f64 = 0.0;
    if (ry_molecular_weight(data, len, &w) == 1 && (_ry_is_finite(w) == 0 || w <= 0.0)) { _fz_bad = _fz_bad + 1; }
    var pairs[416];
    var tc, nc = ry_composition(data, len, &pairs, 26);
    var total = 0;
    var k = 0;
    while (k < nc) {
        total = total + load64(&pairs + 16 * k + 8);
        k = k + 1;
    }
    if (is_ok(tc) == 0 || nc > 26 || total > len) { _fz_bad = _fz_bad + 1; }
    var z: f64 = ry_net_charge(data, len, 7.0);
    if (_ry_is_finite(z) == 0) { _fz_bad = _fz_bad + 1; }
    var set = 0;
    while (set < RY_PKA_SET_COUNT) {
        var pi: f64 = 0.0;
        if (ry_isoelectric_point_with(data, len, set, &pi) == 1) {
            _fz_protein = _fz_protein + 1;
            if (pi < 0.0 || pi > 14.0) { _fz_bad = _fz_bad + 1; }
        }
        set = set + 1;
    }
    var ec: RyExtinctionCoefficient;
    if (ry_extinction_coefficient(data, len, &ec) == 1) {
        var ox: f64 = ec.oxidized;
        var red: f64 = ec.reduced;
        if (ox < red || red < 0.0) { _fz_bad = _fz_bad + 1; }
    }
    reset_via(_fz_arena);
    var ss = alloc(len + 1);
    var tf, nf = ry_chou_fasman_a(_fz_arena, data, len, ss, len);
    if (is_ok(tf) == 0 || (nf != 0 && nf != len)) { _fz_bad = _fz_bad + 1; }
    k = 0;
    while (k < nf) {
        if (load8(ss + k) > RY_SECONDARY_STRUCTURE_COIL) { _fz_bad = _fz_bad + 1; }
        k = k + 1;
    }
    return 0;
}

# Alignment on the input's two halves: a score has at most `length` identities and an identity in [0, 1];
# Needleman-Wunsch (gap -4, far from saturating at this size) is symmetric, and a sequence aligned with itself never
# scores below its ungapped self-score.
fn fuzz_alignment(data, len) {
    var h = len / 2;
    var r: RyAlignmentScore;
    if (ry_score_alignment(data, h, data + h, h, RY_MATRIX_BLOSUM62, &r) == 1) {
        var id: f64 = r.identity;
        if (r.identities > r.length || id < 0.0 || id > 1.0) { _fz_bad = _fz_bad + 1; }
    }
    reset_via(_fz_arena);
    var ab[8];
    var ba[8];
    var t1, v1 = ry_needleman_wunsch_a(_fz_arena, data, h, data + h, len - h, RY_MATRIX_PAM250, 0 - 4, &ab);
    var t2, v2 = ry_needleman_wunsch_a(_fz_arena, data + h, len - h, data, h, RY_MATRIX_PAM250, 0 - 4, &ba);
    if (is_ok(t1) == 0 || is_ok(t2) == 0 || v1 != v2) { _fz_bad = _fz_bad + 1; }
    if (v1 == 1 && load64(&ab) != load64(&ba)) { _fz_bad = _fz_bad + 1; }
    if (v1 == 1) { _fz_aligned = _fz_aligned + 1; }
    var self[8];
    var t3, v3 = ry_needleman_wunsch_a(_fz_arena, data, h, data, h, RY_MATRIX_BLOSUM62, 0 - 4, &self);
    if (v3 == 1 && ry_score_alignment(data, h, data, h, RY_MATRIX_BLOSUM62, &r) == 1 && load64(&self) < r.score) {
        _fz_bad = _fz_bad + 1;
    }
    return 0;
}

# The glycolysis codecs on one input: an accepted state, config or flux is finite and reads back bit for bit. An
# accepted state that validates, with every pool below 1e300 (no sum can overflow), stays valid through a step of
# 0.5 s and one of 50 s on the default config, and neither creates carbon nor loses it beyond rounding.
fn fuzz_glycolysis(data, len) {
    reset_via(_fz_arena);
    var s: RyGlycolysisState;
    var sb2: RyGlycolysisState;
    var t1, v1 = ry_glycolysis_state_from_json_a(_fz_arena, data, len, &s);
    if (is_ok(t1) == 1) {
        _fz_glycolysis = _fz_glycolysis + 1;
        if (fz_all_finite(&s, 11) == 0) { _fz_bad = _fz_bad + 1; }
        store64(_fz_sb + 8, 0);
        var t2, v2 = ry_glycolysis_state_to_json(_fz_sb, &s);
        var t3, v3 = ry_glycolysis_state_from_json_a(_fz_arena, load64(_fz_sb), load64(_fz_sb + 8), &sb2);
        if (is_ok(t2) == 0 || is_ok(t3) == 0 || memeq(&sb2, &s, 88) == 0) { _fz_bad = _fz_bad + 1; }
        var tv, vv = ry_glycolysis_state_validate(&s);
        var huge: f64 = 0x7E37E43C8800759C;                  # 1e300
        var big = 0;
        var k = 0;
        while (k < 11) {
            var x: f64 = load64(&s + 8 * k);
            if (x >= huge) { big = 1; }
            k = k + 1;
        }
        if (is_ok(tv) == 1 && big == 0) {
            var c: RyGlycolysisConfig;
            var f: RyGlycolysisFlux;
            ry_glycolysis_config_default(&c);
            var before: f64 = ry_glycolysis_state_total_carbon(&s);
            ry_glycolysis_state_tick(&s, &c, 6.0, 0.5, 700.0, 0.5, &f);
            ry_glycolysis_state_tick(&s, &c, 6.0, 0.5, 700.0, 50.0, &f);
            var after: f64 = ry_glycolysis_state_total_carbon(&s);
            var tw, vw = ry_glycolysis_state_validate(&s);
            var drift: f64 = f64_abs(after - before);
            var bound: f64 = 0.000000000001 * before;
            if (is_ok(tw) == 0 || fz_all_finite(&f, 15) == 0 || drift > bound) { _fz_bad = _fz_bad + 1; }
        }
    }
    var c2: RyGlycolysisConfig;
    var cb: RyGlycolysisConfig;
    var t4, v4 = ry_glycolysis_config_from_json_a(_fz_arena, data, len, &c2);
    if (is_ok(t4) == 1) {
        _fz_glycolysis = _fz_glycolysis + 1;
        store64(_fz_sb + 8, 0);
        var t5, v5 = ry_glycolysis_config_to_json(_fz_sb, &c2);
        var t6, v6 = ry_glycolysis_config_from_json_a(_fz_arena, load64(_fz_sb), load64(_fz_sb + 8), &cb);
        if (fz_all_finite(&c2, 38) == 0 || is_ok(t5) == 0 || is_ok(t6) == 0 || memeq(&cb, &c2, 304) == 0) {
            _fz_bad = _fz_bad + 1;
        }
    }
    var fx: RyGlycolysisFlux;
    var fb: RyGlycolysisFlux;
    var t7, v7 = ry_glycolysis_flux_from_json_a(_fz_arena, data, len, &fx);
    if (is_ok(t7) == 1) {
        _fz_glycolysis = _fz_glycolysis + 1;
        store64(_fz_sb + 8, 0);
        var t8, v8 = ry_glycolysis_flux_to_json(_fz_sb, &fx);
        var t9, v9 = ry_glycolysis_flux_from_json_a(_fz_arena, load64(_fz_sb), load64(_fz_sb + 8), &fb);
        if (fz_all_finite(&fx, 15) == 0 || is_ok(t8) == 0 || is_ok(t9) == 0 || memeq(&fb, &fx, 120) == 0) {
            _fz_bad = _fz_bad + 1;
        }
    }
    return 0;
}

# A NUL-terminated copy of the document builder `sb` holds (a seed).
fn fz_seed_of(sb): i64 {
    var n = load64(sb + 8);
    var s = alloc(n + 1);
    memcpy(s, load64(sb), n);
    store8(s + n, 0);
    return s;
}

# A word as a *RyPtmSite (the cast-helper idiom).
#must_use
fn _fz_as_sites(p): *RyPtmSite { return p; }

# ptm: the scan on every input: Ok(-1) for an empty one, else at most three sites per byte, sorted, each inside the
# sequence with a residue its pattern names and a motif range inside the input; the disulfide count is half the Cys
# sites.
fn fuzz_ptm(data, len) {
    reset_via(_fz_arena);
    var cap = RY_PTM_MAX_SITES_PER_RESIDUE * len;
    var sites: *RyPtmSite = _fz_as_sites(alloc_via(_fz_arena, 40 * cap + 40));
    var t, count = ry_scan_ptm_sites(data, len, sites, cap);
    if (is_ok(t) == 0) {
        _fz_bad = _fz_bad + 1;
        return 0;
    }
    if (len == 0 || count < 0 || count > cap) {
        if (len != 0 || count != 0 - 1) { _fz_bad = _fz_bad + 1; }
        return 0;
    }
    # The characters as src/ptm.cyr reads them: an ASCII byte, or any other byte and the continuation bytes after it.
    var chars = 0;
    var b = 0;
    while (b < len) {
        var lead = load8(data + b);
        b = b + 1;
        if (lead >= 128) {
            while (b < len && (load8(data + b) & 192) == 128) { b = b + 1; }
        }
        chars = chars + 1;
    }
    var cys = 0;
    var last = 0;
    var k = 0;
    while (k < count) {
        var s: *RyPtmSite = sites + k;
        var r = s.residue;
        var named = r == 78 || r == 89 || r == 83 || r == 84 || r == 67 || r == 71;
        if (s.position < last || s.position >= chars || named == 0) { _fz_bad = _fz_bad + 1; }
        if (s.ptm_type < 0 || s.ptm_type >= RY_PTM_TYPE_COUNT) { _fz_bad = _fz_bad + 1; }
        if (s.motif_start < 0 || s.motif_len < 1 || s.motif_len > 24 || s.motif_start + s.motif_len > len) {
            _fz_bad = _fz_bad + 1;
        }
        if (s.ptm_type == RY_PTM_TYPE_DISULFIDE_BOND) { cys = cys + 1; }
        last = s.position;
        k = k + 1;
    }
    if (ry_disulfide_bond_count(data, len) != cys / 2) { _fz_bad = _fz_bad + 1; }
    _fz_ptm = _fz_ptm + count;
    return 0;
}

# A word as a *RyDomainHit (the cast-helper idiom).
#must_use
fn _fz_as_hits(p): *RyDomainHit { return p; }

# domain: the scan on every input: Ok(-1) for an empty one, else at most nine hits per byte, sorted by start, each
# inside the sequence (start <= end), of a type the scan reports, with a fragment range inside the input.
fn fuzz_domain(data, len) {
    reset_via(_fz_arena);
    var cap = RY_DOMAIN_MAX_HITS_PER_RESIDUE * len;
    var hits: *RyDomainHit = _fz_as_hits(alloc_via(_fz_arena, 40 * cap + 40));
    var t, count = ry_scan_domains(data, len, hits, cap);
    if (is_ok(t) == 0) {
        _fz_bad = _fz_bad + 1;
        return 0;
    }
    if (len == 0 || count < 0 || count > cap) {
        if (len != 0 || count != 0 - 1) { _fz_bad = _fz_bad + 1; }
        return 0;
    }
    var chars = 0;
    var b = 0;
    while (b < len) {
        var lead = load8(data + b);
        b = b + 1;
        if (lead >= 128) {
            while (b < len && (load8(data + b) & 192) == 128) { b = b + 1; }
        }
        chars = chars + 1;
    }
    var last = 0;
    var k = 0;
    while (k < count) {
        var h: *RyDomainHit = hits + k;
        var ty = h.domain_type;
        if (h.start < last || h.start > h.end || h.end >= chars || h.end - h.start > 24) { _fz_bad = _fz_bad + 1; }
        if (ty < 0 || ty >= RY_DOMAIN_TYPE_COUNT || ty == RY_DOMAIN_TYPE_CATALYTIC_TRIAD) { _fz_bad = _fz_bad + 1; }
        var fs = h.fragment_start;
        var fl = h.fragment_len;
        if (fs < 0 || fl < h.end - h.start + 1 || fl > RY_DOMAIN_MAX_FRAGMENT_BYTES || fs + fl > len) {
            _fz_bad = _fz_bad + 1;
        }
        last = h.start;
        k = k + 1;
    }
    _fz_domain = _fz_domain + count;
    return 0;
}

# Copies seed `s` into buf and applies up to three random edits. Returns the new length.
fn fz_mutate(buf, cap, s): i64 {
    var n = strlen(s);
    if (n > cap) { n = cap; }
    memcpy(buf, s, n);
    var edits = fz_below(4);
    var k = 0;
    while (k < edits) {
        var op = fz_below(5);
        if (op == 0 && n > 0) { store8(buf + fz_below(n), fz_below(256)); }
        if (op == 1 && n < cap) {
            var at = fz_below(n + 1);
            var j = n;
            while (j > at) { store8(buf + j, load8(buf + j - 1)); j = j - 1; }
            store8(buf + at, fz_below(256));
            n = n + 1;
        }
        if (op == 2 && n > 0) {
            var at2 = fz_below(n);
            var j2 = at2;
            while (j2 + 1 < n) { store8(buf + j2, load8(buf + j2 + 1)); j2 = j2 + 1; }
            n = n - 1;
        }
        if (op == 3) { n = fz_below(n + 1); }
        if (op == 4 && n > 0) {
            var at3 = fz_below(n);
            var c = load8(buf + at3);
            if (c >= 97 && c <= 122) { store8(buf + at3, c - 32); }
        }
        k = k + 1;
    }
    return n;
}

# Runs the targets over 50,000 seeded inputs and reports.
fn main() {
    alloc_init();
    var cap = 2048;
    var buf = alloc(cap + 1);
    _fz_arena = arena_allocator_growable(65536);
    _fz_sb = str_builder_new();
    var seeds = alloc(8 * 42);
    store64(seeds, "trace");
    store64(seeds + 8, "DEBUG");
    store64(seeds + 16, "info,warn");
    store64(seeds + 24, "off");
    store64(seeds + 32, "rasayan=debug");
    store64(seeds + 40, "rasayan=+3,warn");
    store64(seeds + 48, "rasayan");
    store64(seeds + 56, "rasayan=");
    store64(seeds + 64, ",,,");
    store64(seeds + 72, "0000000000000000000000000000005");
    store64(seeds + 80, "rasayan::pathway=debug,rasayan=warn");
    store64(seeds + 88, "rasayan[{x=1}]=debug");
    store64(seeds + 96, "other=trace,rasayan=error");
    store64(seeds + 104, " debug ");
    store64(seeds + 112, "5,4,3,2,1,0");
    store64(seeds + 120, "rasayan=OFF,rasayan=Trace");
    store64(seeds + 128, "{\"p_na\":0.04,\"p_k\":1.0,\"p_cl\":0.45}");
    store64(seeds + 136, "[0.04,1.0,0.45]");
    store64(seeds + 144, "{\"p_cl\":1e400,\"x\":[1,{\"y\":null}],\"p_na\":-0,\"p_k\":2}");
    store64(seeds + 152, "[1.5,-0.0,0.04,1e-7,100]");
    store64(seeds + 160, "\"a\\u00e9\\ud83d\\ude00\\n\"");
    store64(seeds + 168, "4294967295");
    store64(seeds + 176, "{\"p_na\":96485.33212331001,\"p_k\":2.2250738585072011e-308,\"p_cl\":5e-324}");
    store64(seeds + 184, "[[[[[[1]]]]],{\"a\":\"\\u0000\"},true,false,null]");
    store64(seeds + 192, "{\"na_in\":12.0,\"na_out\":145,\"k_in\":155.0,\"k_out\":4,\"cl_in\":4.0,\"cl_out\":120}");
    store64(seeds + 200, "[12,145,155,4,4,1.2e2]");
    store64(seeds + 208, "{\"camp\":0.1,\"calcium\":0.05,\"ip3\":0.05}");
    store64(seeds + 216, "{\"atp\":6,\"adp\":0.5,\"nad_ratio\":700,\"glucose\":5,\"oxygen\":1,\"lactate\":1}");
    store64(seeds + 224, "{\"phosphocreatine\":0.9,\"glycogen\":0.8,\"met\":1,\"anaerobic_threshold\":6}");
    store64(seeds + 232, "MQIFVKTLTGKTITLEVEPSDTIENVKAKIQDKEGIPPDQQRLIFAGKQLEDGRTLSDYNIQKESTLHLVLRLRGG");
    store64(seeds + 240, "ACDEFGHIKLMNPQRSTVWY");
    store64(seeds + 248, "AAAAAELLLLVVVIIYNGPS");
    store64(seeds + 256, "acdkAAAAAAPAAANPDGvvvvv");
    store64(seeds + 264, "HEAGAWGHEEPAWHEAE");
    store64(seeds + 272, "MKTAYIAKQRQISFVKSHFSRQMKVLAAGIVGLLLAQPSHAEKR");
    store64(seeds + 280, "MGSNKSKPKDKRASNSTAYCSAAERRSSNASA");
    store64(seeds + 288, "MGÉ🧬ASANÉSARRÉSSÉÉEcCnasa");
    store64(seeds + 296, "RGDAADEADKKAKGAAAAGKSDKDGDGTITTKEAKDEL");
    store64(seeds + 304, "PYACPVESCDRRFSRSDELTRHIRIHTGQKLAAAAAALAAAAAALAAAAAALCAACCCALLLAAAAAAHHHAHHHHH");
    # The glycolysis documents: the default state in the sequence form, the default config and a step's flux as
    # written.
    store64(seeds + 312, "[5,0.083,0.014,0.031,0.14,0.019,0.001,0.12,0.03,0.023,0.051]");
    var gc: RyGlycolysisConfig;
    var gs: RyGlycolysisState;
    var gf: RyGlycolysisFlux;
    ry_glycolysis_config_default(&gc);
    ry_glycolysis_state_default(&gs);
    ry_glycolysis_state_tick(&gs, &gc, 6.0, 0.5, 700.0, 0.1, &gf);
    store64(_fz_sb + 8, 0);
    var tg1, vg1 = ry_glycolysis_config_to_json(_fz_sb, &gc);
    store64(seeds + 320, fz_seed_of(_fz_sb));
    store64(_fz_sb + 8, 0);
    var tg2, vg2 = ry_glycolysis_flux_to_json(_fz_sb, &gf);
    store64(seeds + 328, fz_seed_of(_fz_sb));
    var i = 0;
    while (i < 50000) {
        var n = 0;
        if (fz_below(4) == 0) {
            n = fz_below(41);
            var k = 0;
            while (k < n) { store8(buf + k, fz_below(256)); k = k + 1; }
        } else {
            n = fz_mutate(buf, cap, load64(seeds + 8 * fz_below(42)));
        }
        fuzz_main(buf, n);
        fuzz_json(buf, n);
        fuzz_membrane(buf, n);
        fuzz_protein(buf, n);
        fuzz_alignment(buf, n);
        fuzz_ptm(buf, n);
        fuzz_domain(buf, n);
        fuzz_glycolysis(buf, n);
        i = i + 1;
    }
    if (_fz_bad != 0) {
        print("fuzz: out-of-range results: ", 28);
        println_int(_fz_bad);
        return 1;
    }
    print("fuzz: ok (50000 inputs; RASAYAN_LOG values read: ", 50);
    fmt_int(_fz_read);
    print(", JSON documents read as a struct: ", 35);
    fmt_int(_fz_json_read);
    print(", as one of the five struct codecs, written and read back: ", 59);
    fmt_int(_fz_codec_read);
    print(", isoelectric points defined: ", 30);
    fmt_int(_fz_protein);
    print(", halves aligned: ", 18);
    fmt_int(_fz_aligned);
    print(", PTM sites: ", 13);
    fmt_int(_fz_ptm);
    print(", domain hits: ", 15);
    fmt_int(_fz_domain);
    print(", glycolysis documents read: ", 29);
    fmt_int(_fz_glycolysis);
    println(")");
    return 0;
}

var r = main();
sys_exit_group(r);
