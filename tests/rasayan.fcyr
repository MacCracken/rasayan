# rasayan fuzz harness

# Fuzz target stub: accepts any input (sequence and JSON readers get real targets).
fn fuzz_main(data, len) {
    if (len == 0) { return 0; }
    return 0;
}

# Runs the fuzz target once on a fixed input.
fn main() {
    alloc_init();
    fuzz_main("test", 4);
    println("fuzz: ok");
    return 0;
}

var r = main();
sys_exit_group(r);
