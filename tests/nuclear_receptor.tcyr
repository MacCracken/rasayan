# rasayan — src/nuclear_receptor.cyr: Rust 1.2.0's nuclear receptor tests, ported
# Stdlib auto-included via cyrius.cyml
#
# The 11 unit tests of `nuclear_receptor.rs` and the 2 integration tests (tests/integration.rs) that call only the
# nuclear receptor model, as they are written; tests/golden/nuclear_receptor.tsv checks every method, single tick and
# trajectory besides. Beyond them: the trace event and every codec's round trip.

include "src/constants.cyr"
include "src/constants_private.cyr"
include "src/mathx_data.cyr"
include "src/mathx.cyr"
include "src/fmtf.cyr"
include "src/error.cyr"
