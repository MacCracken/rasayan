# ── energy ──────────────────────────────────────────────────────────────────────────
# src/energy_data.cyr and src/energy.cyr (M2 part 5). A BioenergyState row takes the state's four fields
# (phosphocreatine, glycogen, met, anaerobic_threshold), then the method's argument. sharira's rows take the state,
# then power, mass, dt_seconds, amplification and fraction. A trajectory row (class T) is a script: the state, then
# `i:1 f:met` set_exertion, `i:2 f:dt i:k` k ticks, `i:3 i:field f:x` a field set, `i:4 f:power f:mass f:dt_s f:amp
# f:frac i:k` k sharira ticks.

# One tick of sharira 1.1.0's `MetabolicCoupling::tick` call shape on *b (sharira's composition of rasayan's
# functions, so it lives here, not in src/): met_from_power → set_exertion → tick(dt_seconds / 60) → energy_available
# → fatigue_rate_from_energy → recovery_rate_modifier(is_anaerobic). The three results go to out[0..3].
fn _par_sharira_tick(b: *RyBioenergyState, power: f64, mass: f64, dt_s: f64, amp: f64, frac: f64, out) {
    var met: f64 = ry_met_from_power(power, mass);
    ry_bioenergy_state_set_exertion(b, met);
    var dtm: f64 = dt_s / 60.0;
    ry_bioenergy_state_tick(b, dtm);
    var avail: f64 = ry_bioenergy_state_energy_available(b);
    var fatigue: f64 = ry_fatigue_rate_from_energy(avail, amp);
    var recovery: f64 = ry_recovery_rate_modifier(ry_bioenergy_state_is_anaerobic(b), frac);
    store64(out, load64(&avail));
    store64(out + 8, load64(&fatigue));
    store64(out + 16, load64(&recovery));
    return 0;
}

# Replays a trajectory script from input 4 on *b: 1, or -1 for a malformed script.
fn _par_be_script(b: *RyBioenergyState): i64 {
    var w = b;
    var three[24];
    var k = 4;
    while (k < _par_in_n) {
        if (load64(_par_in_k + k * 8) != 105) { return 0 - 1; }
        var op = _par_in(k);
        if (op == 1 && _par_is_f(k + 1) == 1) {
            ry_bioenergy_state_set_exertion(b, _par_f(k + 1));
            k = k + 2;
        } elif (op == 2 && _par_is_f(k + 1) == 1 && k + 2 < _par_in_n && load64(_par_in_k + (k + 2) * 8) == 105) {
            var dt: f64 = _par_f(k + 1);
            var n = _par_in(k + 2);
            var j = 0;
            while (j < n) {
                ry_bioenergy_state_tick(b, dt);
                j = j + 1;
            }
            k = k + 3;
        } elif (op == 3 && k + 2 < _par_in_n && load64(_par_in_k + (k + 1) * 8) == 105 && _par_is_f(k + 2) == 1) {
            var field = _par_in(k + 1);
            if (field < 0 || field > 3) { return 0 - 1; }
            store64(w + 8 * field, _par_in(k + 2));
            k = k + 3;
        } elif (op == 4 && k + 6 < _par_in_n && _par_all_f_from(k + 1, 5) == 1
          && load64(_par_in_k + (k + 6) * 8) == 105) {
            var pw: f64 = _par_f(k + 1);
            var ms: f64 = _par_f(k + 2);
            var ds: f64 = _par_f(k + 3);
            var am: f64 = _par_f(k + 4);
            var fr: f64 = _par_f(k + 5);
            var reps = _par_in(k + 6);
            var r = 0;
            while (r < reps) {
                _par_sharira_tick(b, pw, ms, ds, am, fr, &three);
                r = r + 1;
            }
            k = k + 7;
        } else {
            return 0 - 1;
        }
    }
    return 1;
}

