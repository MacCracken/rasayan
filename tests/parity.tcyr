    }
    return 0 - 1;
}

# ── table index constants ───────────────────────────────────────────────────────────
# The public tables' row constants by the Rust key they are named after, as a vec of (key, index) pairs:
# RY_AMINO_ACID_<ABBR> and RY_KNOWN_ENZYME_<NAME>. A table row is only answered when the key the data gives for that
# row is the key whose constant is the row's index, so every index constant is compared against the oracle too.
var _par_tab_amino = 0;
var _par_tab_enzyme = 0;

# Appends one (Rust key, index constant) pair.
fn _par_tab_add(t, key, idx) {
    vec_push(t, key);
    vec_push(t, idx);
    return 0;
}

# The key whose index constant is r in table t, or 0.
#must_use
fn _par_tab_key(t, r): i64 {
    var k = 0;
    while (k < vec_len(t)) {
        if (vec_get(t, k + 1) == r) { return vec_get(t, k); }
        k = k + 2;
    }
    return 0;
}

# 1 if row r's key in the data (the C string `key`) is the key of table t's constant r.
#must_use
fn _par_tab_agrees(t, r, key): i64 {
    var want = _par_tab_key(t, r);
    if (want == 0) { return 0; }
    return streq(want, key);
}

# Builds the two tables.
fn _par_tables_init(): i64 {
    var a = vec_new();
    _par_tab_add(a, "Ala", RY_AMINO_ACID_ALA);
    _par_tab_add(a, "Cys", RY_AMINO_ACID_CYS);
    _par_tab_add(a, "Asp", RY_AMINO_ACID_ASP);
    _par_tab_add(a, "Glu", RY_AMINO_ACID_GLU);
    _par_tab_add(a, "Phe", RY_AMINO_ACID_PHE);
    _par_tab_add(a, "Gly", RY_AMINO_ACID_GLY);
    _par_tab_add(a, "His", RY_AMINO_ACID_HIS);
    _par_tab_add(a, "Ile", RY_AMINO_ACID_ILE);
    _par_tab_add(a, "Lys", RY_AMINO_ACID_LYS);
    _par_tab_add(a, "Leu", RY_AMINO_ACID_LEU);
    _par_tab_add(a, "Met", RY_AMINO_ACID_MET);
    _par_tab_add(a, "Asn", RY_AMINO_ACID_ASN);
    _par_tab_add(a, "Pro", RY_AMINO_ACID_PRO);
    _par_tab_add(a, "Gln", RY_AMINO_ACID_GLN);
    _par_tab_add(a, "Arg", RY_AMINO_ACID_ARG);
    _par_tab_add(a, "Ser", RY_AMINO_ACID_SER);
    _par_tab_add(a, "Thr", RY_AMINO_ACID_THR);
    _par_tab_add(a, "Val", RY_AMINO_ACID_VAL);
    _par_tab_add(a, "Trp", RY_AMINO_ACID_TRP);
    _par_tab_add(a, "Tyr", RY_AMINO_ACID_TYR);
    _par_tab_amino = a;
    var e = vec_new();
    _par_tab_add(e, "Carbonic anhydrase", RY_KNOWN_ENZYME_CARBONIC_ANHYDRASE);
    _par_tab_add(e, "Acetylcholinesterase", RY_KNOWN_ENZYME_ACETYLCHOLINESTERASE);
    _par_tab_add(e, "Catalase", RY_KNOWN_ENZYME_CATALASE);
    _par_tab_add(e, "Hexokinase", RY_KNOWN_ENZYME_HEXOKINASE);
    _par_tab_add(e, "Lactate dehydrogenase", RY_KNOWN_ENZYME_LACTATE_DEHYDROGENASE);
    _par_tab_add(e, "Chymotrypsin", RY_KNOWN_ENZYME_CHYMOTRYPSIN);
    _par_tab_add(e, "Fumarase", RY_KNOWN_ENZYME_FUMARASE);
    _par_tab_add(e, "Triose phosphate isomerase", RY_KNOWN_ENZYME_TRIOSE_PHOSPHATE_ISOMERASE);
    _par_tab_add(e, "Lysozyme", RY_KNOWN_ENZYME_LYSOZYME);
    _par_tab_add(e, "Phosphofructokinase", RY_KNOWN_ENZYME_PHOSPHOFRUCTOKINASE);
    _par_tab_add(e, "Pyruvate kinase", RY_KNOWN_ENZYME_PYRUVATE_KINASE);
    _par_tab_add(e, "Aspartate transcarbamoylase", RY_KNOWN_ENZYME_ASPARTATE_TRANSCARBAMOYLASE);
    _par_tab_enzyme = e;
    return 0;
}

# ── protein ─────────────────────────────────────────────────────────────────────────
# src/protein_data.cyr. The module's functions (pI, charge, Chou-Fasman, ...) arrive at M3; their rows are pending.

# AMINO_ACIDS[r]'s fields in AminoAcid's declaration order: code, abbreviation, name, mw, hydrophobicity and the
# Option<f64> side-chain pKa. -1 when r's abbreviation is not the one its index constant is named after.
fn _par_fill_amino(r): i64 {
    var abbr = _par_blob(&_RY_AMINO_ACID_ABBR_BYTES, _RY_AMINO_ACID_ABBR_OFF[r]);
    if (_par_tab_agrees(_par_tab_amino, r, abbr) != 1) { return 0 - 1; }
    _par_got_char(RY_AMINO_ACID_CODE[r]);
    _par_got_cstr(abbr);
    _par_got_cstr(_par_blob(&_RY_AMINO_ACID_NAME_BYTES, _RY_AMINO_ACID_NAME_OFF[r]));
    var x: f64 = RY_AMINO_ACID_MW[r];
    _par_got_f(x);
    x = RY_AMINO_ACID_HYDROPHOBICITY[r];
    _par_got_f(x);
    if (RY_AMINO_ACID_HAS_SIDE_CHAIN_PKA[r] != 0) {
        x = RY_AMINO_ACID_SIDE_CHAIN_PKA[r];
        _par_got_f(x);
    } else {
        _par_got_none();
    }
    return 1;
}

# `protein::lookup(code)`: Rust's rule on the generated index — ASCII uppercase, then `'A'..='Z'` through
# LOOKUP_INDEX into AMINO_ACIDS, None off the alphabet or at NO_RESIDUE.
fn _par_protein_lookup(): i64 {
    if (_par_in_n != 1) { return 0 - 1; }
    var c = _par_in_char(0);
    if (c < 0) { return 0 - 1; }
    if (c >= 97 && c <= 122) { c = c - 32; }
    if (c < 65 || c > 90) {
        _par_got_none();
        return 1;
    }
    var slot = _RY_PROTEIN_LOOKUP_INDEX[c - 65];
    if (slot >= RY_AMINO_ACID_COUNT) {
        _par_got_none();
        return 1;
    }
    return _par_fill_amino(slot);
}

# One pKa set (PkaSet's row): n_term, c_term, then the side-chain pKa in SIDE_CHAINS order.
fn _par_fill_pka_set(set): i64 {
    var x: f64 = _RY_PROTEIN_PKA_SET_N_TERM[set];
    _par_got_f(x);
    x = _RY_PROTEIN_PKA_SET_C_TERM[set];
    _par_got_f(x);
    _par_got_seq(_RY_PROTEIN_SIDE_CHAIN_COUNT);
    var j = 0;
    while (j < _RY_PROTEIN_SIDE_CHAIN_COUNT) {
        x = _RY_PROTEIN_PKA_SET_SIDE[set * _RY_PROTEIN_SIDE_CHAIN_COUNT + j];
        _par_got_f(x);
        j = j + 1;
    }
    return 1;
}

# `bjellqvist_n_term(first)` (n_term = 1) or `bjellqvist_c_term(last)`: the first matching arm of the generated code
# and pKa columns, else (another residue, or None) BJELLQVIST_PKA's terminus.
fn _par_bjellqvist(n_term): i64 {
    if (_par_in_n != 1) { return 0 - 1; }
    var set = _RY_PROTEIN_PKA_SET_BJELLQVIST;
    var x: f64 = _RY_PROTEIN_PKA_SET_C_TERM[set];
    if (n_term == 1) { x = _RY_PROTEIN_PKA_SET_N_TERM[set]; }
    var kind = load64(_par_in_k);
    if (kind == 115) {
        var c = _par_in_char(0);
        if (c < 0) { return 0 - 1; }
        var j = 0;
        if (n_term == 1) {
            while (j < _RY_PROTEIN_BJELLQVIST_N_TERM_COUNT) {
                if (_RY_PROTEIN_BJELLQVIST_N_TERM_CODE[j] == c) {
                    x = _RY_PROTEIN_BJELLQVIST_N_TERM_PKA[j];
                    break;
                }
                j = j + 1;
            }
        } else {
            while (j < _RY_PROTEIN_BJELLQVIST_C_TERM_COUNT) {
                if (_RY_PROTEIN_BJELLQVIST_C_TERM_CODE[j] == c) {
                    x = _RY_PROTEIN_BJELLQVIST_C_TERM_PKA[j];
                    break;
                }
                j = j + 1;
            }
        }
    } elif (kind != 110) {
        return 0 - 1;
    }
    _par_got_f(x);
    return 1;
}

# CHOU_FASMAN[r]: code, P(alpha), P(beta), P(turn) (x100), then the four bend frequencies (x1000).
fn _par_fill_chou_fasman(r): i64 {
    _par_got_char(_RY_PROTEIN_CHOU_FASMAN_CODE[r]);
    _par_got_i(_RY_PROTEIN_CHOU_FASMAN_P_ALPHA[r]);
    _par_got_i(_RY_PROTEIN_CHOU_FASMAN_P_BETA[r]);
    _par_got_i(_RY_PROTEIN_CHOU_FASMAN_P_TURN[r]);
    _par_got_seq(4);
    var j = 0;
    while (j < 4) {
        _par_got_i(_RY_PROTEIN_CHOU_FASMAN_BEND[r * 4 + j]);
        j = j + 1;
    }
    return 1;
}

# The protein rows.
fn _par_protein(fp, fl): i64 {
    if (_par_eq(fp, fl, "protein::AMINO_ACIDS.len") == 1) {
        _par_got_i(RY_AMINO_ACID_COUNT);
        return 1;
    }
    if (_par_eq(fp, fl, "protein::AMINO_ACIDS") == 1) {
        var r = _par_in_index(0, RY_AMINO_ACID_COUNT);
        if (r < 0) { return 0 - 1; }
        return _par_fill_amino(r);
    }
    if (_par_eq(fp, fl, "protein::lookup") == 1) { return _par_protein_lookup(); }
    if (_par_eq(fp, fl, "protein::LOOKUP_INDEX") == 1) {
        var r = _par_in_index(0, 26);
        if (r < 0) { return 0 - 1; }
        _par_got_i(_RY_PROTEIN_LOOKUP_INDEX[r]);
        return 1;
    }
    if (_par_eq(fp, fl, "protein::SIDE_CHAINS") == 1) {
        var r = _par_in_index(0, _RY_PROTEIN_SIDE_CHAIN_COUNT);
        if (r < 0) { return 0 - 1; }
        _par_got_char(_RY_PROTEIN_SIDE_CHAIN_CODE[r]);
        var x: f64 = _RY_PROTEIN_SIDE_CHAIN_PKA[r];
        _par_got_f(x);
        x = _RY_PROTEIN_SIDE_CHAIN_SIGN[r];
        _par_got_f(x);
        return 1;
    }
    if (_par_eq(fp, fl, "protein::LEHNINGER_PKA") == 1) { return _par_fill_pka_set(_RY_PROTEIN_PKA_SET_LEHNINGER); }
    if (_par_eq(fp, fl, "protein::BJELLQVIST_PKA") == 1) { return _par_fill_pka_set(_RY_PROTEIN_PKA_SET_BJELLQVIST); }
    if (_par_eq(fp, fl, "protein::EMBOSS_PKA") == 1) { return _par_fill_pka_set(_RY_PROTEIN_PKA_SET_EMBOSS); }
    if (_par_eq(fp, fl, "protein::IPC_PROTEIN_PKA") == 1) {
        return _par_fill_pka_set(_RY_PROTEIN_PKA_SET_IPC_PROTEIN);
    }
    if (_par_eq(fp, fl, "protein::bjellqvist_n_term") == 1) { return _par_bjellqvist(1); }
    if (_par_eq(fp, fl, "protein::bjellqvist_c_term") == 1) { return _par_bjellqvist(0); }
    if (_par_eq(fp, fl, "protein::CHOU_FASMAN") == 1) {
        var r = _par_in_index(0, _RY_PROTEIN_CHOU_FASMAN_COUNT);
        if (r < 0) { return 0 - 1; }
        return _par_fill_chou_fasman(r);
    }
    return 0;
}

# ── alignment ───────────────────────────────────────────────────────────────────────
# src/alignment_data.cyr. Needleman-Wunsch and the alignment scores arrive at M3.

# Rust's `aa_index(code)`: ASCII uppercase, then the generated 26-entry index; -1 for None.
#must_use
fn _par_aa_index(c): i64 {
    var u = c;
    if (u >= 97 && u <= 122) { u = u - 32; }
    if (u < 65 || u > 90) { return 0 - 1; }
    var i = _RY_ALIGNMENT_AA_INDEX[u - 65];
    if (i >= _RY_ALIGNMENT_RESIDUE_COUNT) { return 0 - 1; }   # NO_RESIDUE
    return i;
}

# `alignment::substitution_score(a, b, matrix)`: both residues through aa_index (None if either is None), then the
# matrix's row-major cell (a signed i8).
fn _par_alignment(fp, fl): i64 {
    if (_par_eq(fp, fl, "alignment::substitution_score") != 1) { return 0; }
    if (_par_in_n != 3 || load64(_par_in_k + 16) != 101) { return 0 - 1; }
    var a = _par_in_char(0);
    var b = _par_in_char(1);
    if (a < 0 || b < 0) { return 0 - 1; }
    var mp = load64(_par_in_v + 16);
    var ml = load64(_par_in_l + 16);
    var blosum = 0;
    if (_par_eq(mp, ml, "Matrix.Blosum62") == 1) { blosum = 1; }
    elif (_par_eq(mp, ml, "Matrix.Pam250") != 1) { return 0 - 1; }
    var i = _par_aa_index(a);
    if (i < 0) {
        _par_got_none();
        return 1;
    }
    var j = _par_aa_index(b);
    if (j < 0) {
        _par_got_none();
        return 1;
    }
    var cell = i * _RY_ALIGNMENT_RESIDUE_COUNT + j;
    if (blosum == 1) { _par_got_i(_RY_ALIGNMENT_BLOSUM62[cell]); }
    else { _par_got_i(_RY_ALIGNMENT_PAM250[cell]); }
    return 1;
}

# ── enzyme ──────────────────────────────────────────────────────────────────────────
# src/enzyme_data.cyr. The kinetics arrive at M2.

# KNOWN_ENZYMES[r]'s fields in KnownEnzyme's order: name, EC number, substrate, km, kcat, hill_n. -1 when r's name is
# not the one its index constant is named after.
fn _par_fill_enzyme(r): i64 {
    var name = _par_blob(&_RY_KNOWN_ENZYME_NAME_BYTES, _RY_KNOWN_ENZYME_NAME_OFF[r]);
    if (_par_tab_agrees(_par_tab_enzyme, r, name) != 1) { return 0 - 1; }
    _par_got_cstr(name);
    _par_got_cstr(_par_blob(&_RY_KNOWN_ENZYME_EC_NUMBER_BYTES, _RY_KNOWN_ENZYME_EC_NUMBER_OFF[r]));
    _par_got_cstr(_par_blob(&_RY_KNOWN_ENZYME_SUBSTRATE_BYTES, _RY_KNOWN_ENZYME_SUBSTRATE_OFF[r]));
    var x: f64 = RY_KNOWN_ENZYME_KM[r];
    _par_got_f(x);
    x = RY_KNOWN_ENZYME_KCAT[r];
    _par_got_f(x);
    x = RY_KNOWN_ENZYME_HILL_N[r];
    _par_got_f(x);
    return 1;
}

# 1 if [a, a + al) and [b, b + bl) are equal ignoring ASCII case: Rust's `str::eq_ignore_ascii_case`, byte for byte,
# so a non-ASCII byte must match exactly.
#must_use
fn _par_eq_ascii_ci(a, al, b, bl): i64 {
    if (al != bl) { return 0; }
    var k = 0;
    while (k < al) {
        var x = load8(a + k);
        var y = load8(b + k);
        if (x >= 65 && x <= 90) { x = x + 32; }
        if (y >= 65 && y <= 90) { y = y + 32; }
        if (x != y) { return 0; }
        k = k + 1;
    }
    return 1;
}

# `enzyme::lookup_enzyme(name)`: the first KNOWN_ENZYMES entry whose name equals `name` ignoring ASCII case, or None.
fn _par_lookup_enzyme(): i64 {
    if (_par_in_n != 1) { return 0 - 1; }
    var lw[8];
    var p = _par_in_bytes(0, &lw);
    if (p == 0) { return 0 - 1; }
    var n = load64(&lw);
    var r = 0;
    while (r < RY_KNOWN_ENZYME_COUNT) {
        var e = _par_blob(&_RY_KNOWN_ENZYME_NAME_BYTES, _RY_KNOWN_ENZYME_NAME_OFF[r]);
        if (_par_eq_ascii_ci(e, strlen(e), p, n) == 1) { return _par_fill_enzyme(r); }
        r = r + 1;
    }
    _par_got_none();
    return 1;
}

# The enzyme rows.
fn _par_enzyme(fp, fl): i64 {
    if (_par_eq(fp, fl, "enzyme::KNOWN_ENZYMES.len") == 1) {
        _par_got_i(RY_KNOWN_ENZYME_COUNT);
        return 1;
    }
    if (_par_eq(fp, fl, "enzyme::KNOWN_ENZYMES") == 1) {
        var r = _par_in_index(0, RY_KNOWN_ENZYME_COUNT);
        if (r < 0) { return 0 - 1; }
        return _par_fill_enzyme(r);
    }
    if (_par_eq(fp, fl, "enzyme::lookup_enzyme") == 1) { return _par_lookup_enzyme(); }
    return 0;
}

# ── membrane ────────────────────────────────────────────────────────────────────────
# src/membrane_data.cyr. Nernst, Goldman and Fick arrive at M2.

# The membrane rows: DEFAULT_PERMEABILITY's fields (p_na, p_k, p_cl).
fn _par_membrane(fp, fl): i64 {
    if (_par_eq(fp, fl, "membrane::DEFAULT_PERMEABILITY") != 1) { return 0; }
    if (_par_in_n != 0) { return 0 - 1; }
    var x: f64 = RY_MEMBRANE_DEFAULT_PERMEABILITY_P_NA;
    _par_got_f(x);
    x = RY_MEMBRANE_DEFAULT_PERMEABILITY_P_K;
    _par_got_f(x);
    x = RY_MEMBRANE_DEFAULT_PERMEABILITY_P_CL;
    _par_got_f(x);
    return 1;
}

# ── guard ───────────────────────────────────────────────────────────────────────────
# src/guard.cyr (M1). A validator's row has no output for Ok(()) and the error's Rust variant for Err (ADR 0002 row 1:
# the code is compared, the payload is in the DEBUG event).

# Appends a validator's outcome: nothing for Ok, the error for Err.
fn _par_got_outcome(t, v) {
    if (is_err_result(t) == 1) { _par_got_err(v); }
    return 0;
}

# The guard rows: the validators (`s:<name> f:<value>`, at_least `… f:<min>`), valid_dt, conc, unit, take, shift.
fn _par_guard(fp, fl): i64 {
    if (_par_in_n >= 2 && load64(_par_in_k) == 115) {
        var name = _par_in_cstr(0);
        if (name == 0) { return 0 - 1; }
        var v: f64 = _par_in(1);
        if (_par_eq(fp, fl, "guard::finite") == 1) {
            var t1, v1 = _ry_guard_finite(name, v);
            _par_got_outcome(t1, v1);
            return 1;
        }
        if (_par_eq(fp, fl, "guard::non_negative") == 1) {
            var t2, v2 = _ry_guard_non_negative(name, v);
            _par_got_outcome(t2, v2);
            return 1;
        }
        if (_par_eq(fp, fl, "guard::positive") == 1) {
            var t3, v3 = _ry_guard_positive(name, v);
            _par_got_outcome(t3, v3);
            return 1;
        }
        if (_par_eq(fp, fl, "guard::fraction") == 1) {
            var t4, v4 = _ry_guard_fraction(name, v);
            _par_got_outcome(t4, v4);
            return 1;
        }
        if (_par_eq(fp, fl, "guard::at_least") == 1 && _par_in_n == 3) {
            var min: f64 = _par_in(2);
            var t5, v5 = _ry_guard_at_least(name, v, min);
            _par_got_outcome(t5, v5);
            return 1;
        }
        return 0;
    }
    var x: f64 = _par_in(0);
    if (_par_eq(fp, fl, "guard::valid_dt") == 1) { _par_got_i(_ry_guard_valid_dt(x)); return 1; }
    if (_par_eq(fp, fl, "guard::conc") == 1) { var c: f64 = _ry_guard_conc(x); _par_got_f(c); return 1; }
    if (_par_eq(fp, fl, "guard::unit") == 1) { var u: f64 = _ry_guard_unit(x); _par_got_f(u); return 1; }
    if (_par_in_n < 2) { return 0; }
    var y: f64 = _par_in(1);
    if (_par_eq(fp, fl, "guard::take") == 1) { var r: f64 = _ry_guard_take(x, y); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "guard::shift") == 1 && _par_in_n == 3) {
        var p: f64 = _par_in(2);
        var r2: f64 = _ry_guard_shift(x, y, p);
        _par_got_f(r2);
        return 1;
    }
    return 0;
}

# ── integrate ───────────────────────────────────────────────────────────────────────
# src/integrate.cyr (M1): step_factors(y) -> (f, g); relax, produce_decay, activate (x, a, b, dt) -> x'.

fn _par_integrate(fp, fl): i64 {
    var a: f64 = _par_in(0);
    if (_par_eq(fp, fl, "integrate::step_factors") == 1) {
        var f, g = _ry_integrate_step_factors(a);
        _par_got_f(f);
        _par_got_f(g);
        return 1;
    }
    if (_par_in_n != 4) { return 0; }
    var b: f64 = _par_in(1);
    var c: f64 = _par_in(2);
    var dt: f64 = _par_in(3);
    if (_par_eq(fp, fl, "integrate::relax") == 1) {
        var r1: f64 = _ry_integrate_relax(a, b, c, dt);
        _par_got_f(r1);
        return 1;
    }
    if (_par_eq(fp, fl, "integrate::produce_decay") == 1) {
        var r2: f64 = _ry_integrate_produce_decay(a, b, c, dt);
        _par_got_f(r2);
        return 1;
    }
    if (_par_eq(fp, fl, "integrate::activate") == 1) {
        var r3: f64 = _ry_integrate_activate(a, b, c, dt);
        _par_got_f(r3);
        return 1;
    }
    return 0;
}

# ── logging ─────────────────────────────────────────────────────────────────────────
# src/logging.cyr (M1 part 2). A row gives the level of each of the 20 targets rasayan's events carry; the port has one
# level for all of them.

# The number of event targets a logging row lists (scripts/oracle/src/m_logging.rs, TARGETS).
var _PAR_LOG_TARGETS = 20;

# The logging rows accepted under ADR 0002 row 8, for the module's summary line.
var _par_log_acc = 0;

# 1 when the current logging row's RASAYAN_LOG value (or, unset or refused, its default) is a form the port refuses.
var _par_log_refused = 0;

# The golden name of a level (`LevelFilter.<NAME>`).
#must_use
fn _par_level_name(level): i64 {
    if (level == LOG_TRACE) { return "LevelFilter.TRACE"; }
    if (level == LOG_DEBUG) { return "LevelFilter.DEBUG"; }
    if (level == LOG_INFO) { return "LevelFilter.INFO"; }
    if (level == LOG_WARN) { return "LevelFilter.WARN"; }
    if (level == LOG_ERROR) { return "LevelFilter.ERROR"; }
    return "LevelFilter.OFF";
}

# The logging rows: `logging::init` (the variable: `n:` unset, else `s:`) and `logging::init_with_level` (the variable,
# then `s:<default>`).
fn _par_logging(fp, fl): i64 {
    var dflt = "info";
    if (_par_eq(fp, fl, "logging::init_with_level") == 1) {
        if (_par_in_n != 2) { return 0 - 1; }
        dflt = _par_in_cstr(1);
        if (dflt == 0) { return 0 - 1; }
    } elif (_par_eq(fp, fl, "logging::init") != 1 || _par_in_n != 1) {
        return 0;
    }
    var env = 0;
    var lw[8];
    store64(&lw, 0);
    if (load64(_par_in_k) == 115) {
        env = _par_in_bytes(0, &lw);
        if (env == 0) { return 0 - 1; }
    } elif (load64(_par_in_k) != 110) {
        return 0 - 1;
    }
    var en = load64(&lw);
    var lv = ry_log_level_of(env, en, dflt);
    _par_log_refused = 0;
    if (env != 0 && ry_log_parse(env, en) >= 0) {
        _par_log_refused = 0;
    } elif (env != 0) {
        _par_log_refused = 1;
    } elif (_par_eq(fp, fl, "logging::init_with_level") == 1) {
        if (_ry_log_list(dflt, strlen(dflt), LOG_ERROR) < 0) { _par_log_refused = 1; }
    }
    var name = _par_level_name(lv);
    var k = 0;
    while (k < _PAR_LOG_TARGETS) {
        _par_got_e(name);
        k = k + 1;
    }
    return 1;
}

# ── math ────────────────────────────────────────────────────────────────────────────
# `f64::` rows: the port's counterpart of each Rust std method rasayan calls (port plan §7.1, port-parity.md §0, §2d).
# - Class A: abs and ceil (builtins); min, max, is_finite, is_nan (src/mathx.cyr), clamp and the `as u32` cast
#   (src/mathx.cyr since M1): Rust's semantics where the stdlib's differ.
# - Class B: sqrt (builtin, correctly rounded); powi (`_ry_powi`, src/mathx.cyr, `__powidf2`'s order).
# - Class C (ADR 0003): exp, exp_m1, ln and powf (the `10_f64.powf(x)` rows included: the oracle calls glibc's pow
#   there) on src/mathx.cyr's correctly rounded `_ry_cr_*`, compared at 0 ulp against the corrected oracle
#   (tests/golden/math.cr.tsv): a row glibc misrounds passes as "accepted (ADR 3)", and one that matches glibc's
#   misrounding instead fails.
fn _par_math(fp, fl): i64 {
    var x: f64 = _par_in(0);
    if (_par_eq(fp, fl, "f64::abs") == 1) { var r: f64 = f64_abs(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::ceil") == 1) { var r: f64 = f64_ceil(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::sqrt") == 1) { var r: f64 = f64_sqrt(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::is_finite") == 1) { _par_got_i(_ry_is_finite(x)); return 1; }
    if (_par_eq(fp, fl, "f64::is_nan") == 1) { _par_got_i(_ry_is_nan(x)); return 1; }
    if (_par_eq(fp, fl, "f64::as_u32") == 1) { _par_got_i(_ry_f64_to_u32(x)); return 1; }
    if (_par_eq(fp, fl, "f64::exp") == 1) { var r: f64 = _ry_cr_exp(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::ln") == 1) { var r: f64 = _ry_cr_ln(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::exp_m1") == 1) { var r: f64 = _ry_cr_expm1(x); _par_got_f(r); return 1; }
    if (_par_in_n < 2) { return 0; }
    if (_par_eq(fp, fl, "f64::powi") == 1) {
        if (load64(_par_in_k + 8) != 105) { return 0 - 1; }
        var r: f64 = _ry_powi(x, _par_in(1));
        _par_got_f(r);
        return 1;
    }
    var y: f64 = _par_in(1);
    if (_par_eq(fp, fl, "f64::max") == 1) { var r: f64 = _ry_max(x, y); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::min") == 1) { var r: f64 = _ry_min(x, y); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::powf") == 1) { var r: f64 = _ry_cr_pow(x, y); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::clamp") == 1 && _par_in_n == 3) {
        var hi: f64 = _par_in(2);
        var r: f64 = _ry_clamp(x, y, hi);
        _par_got_f(r);
        return 1;
    }
    return 0;
}

# ── routing and hooks ───────────────────────────────────────────────────────────────

# Routes a row to its module's dispatcher. 0 (pending) for a module or function with no Cyrius code yet: the module
# rows of every module arrive from M1 on, each with its dispatcher here.
fn _par_dispatch(mp, ml, fp, fl): i64 {
    _par_got_n = 0;
    if (_par_eq(fp, fl, "const") == 1) { return _par_const(); }
    if (_par_eq(mp, ml, "math") == 1) { return _par_math(fp, fl); }
    if (_par_eq(mp, ml, "protein") == 1) { return _par_protein(fp, fl); }
    if (_par_eq(mp, ml, "alignment") == 1) { return _par_alignment(fp, fl); }
    if (_par_eq(mp, ml, "enzyme") == 1) { return _par_enzyme(fp, fl); }
    if (_par_eq(mp, ml, "membrane") == 1) { return _par_membrane(fp, fl); }
    if (_par_eq(mp, ml, "guard") == 1) { return _par_guard(fp, fl); }
    if (_par_eq(mp, ml, "integrate") == 1) { return _par_integrate(fp, fl); }
    if (_par_eq(mp, ml, "logging") == 1) { return _par_logging(fp, fl); }
    return 0;
}

# Shadow comparisons, never gated: the same golden rows through the stdlib candidates the port's functions replace,
# against the same reference (the corrected oracle where it has the row). A shadow line's name is not its row's
# function, so it has no class-C bound and its class-C rows stay measured (they are not counted in the summary):
# - exp / ln: the builtins (x87 on x86_64, the polyfills on aarch64) and the polyfills (the same bits on every
#   target); powf as ganita's pow; exp_m1 as ganita's private `_gn_expm1` (the stdlib's only expm1; ganita is a
#   test-only stdlib dependency for these): the stdlib baseline of port-parity.md §2c, beside ADR 0003's primitives;
# - the stdlib's f64_max / f64_min / f64_clamp and f64_to that the port's helpers stand in for, to show where their
#   semantics differ from Rust's (port-parity.md §0.1, §0.6).
fn _par_shadows(mp, ml, fp, fl, cls) {
    if (_par_eq(mp, ml, "math") != 1) { return 0; }
    var x: f64 = _par_in(0);
    if (_par_eq(fp, fl, "f64::exp") == 1) {
        _par_got_n = 0;
        var rb: f64 = f64_exp(x);
        _par_got_f(rb);
        _par_shadow_record("f64::exp ~ f64_exp builtin", cls);
        _par_got_n = 0;
        var r: f64 = _f64_exp_polyfill(x);
        _par_got_f(r);
        _par_shadow_record("f64::exp ~ _f64_exp_polyfill", cls);
        return 0;
    }
    if (_par_eq(fp, fl, "f64::ln") == 1) {
        _par_got_n = 0;
        var rb: f64 = f64_ln(x);
        _par_got_f(rb);
        _par_shadow_record("f64::ln ~ f64_ln builtin", cls);
        _par_got_n = 0;
        var r: f64 = _f64_ln_polyfill(x);
        _par_got_f(r);
        _par_shadow_record("f64::ln ~ _f64_ln_polyfill", cls);
        return 0;
    }
    if (_par_eq(fp, fl, "f64::exp_m1") == 1) {
        _par_got_n = 0;
        var r: f64 = _gn_expm1(x);
        _par_got_f(r);
        _par_shadow_record("f64::exp_m1 ~ _gn_expm1", cls);
        return 0;
    }
    if (_par_eq(fp, fl, "f64::as_u32") == 1) {
        _par_got_n = 0;
        _par_got_i(f64_to(x));
        _par_shadow_record("f64::as_u32 ~ f64_to", cls);
        return 0;
    }
    if (_par_in_n < 2 || load64(_par_in_k + 8) != 102) { return 0; }
    var y: f64 = _par_in(1);
    if (_par_eq(fp, fl, "f64::powf") == 1) {
        _par_got_n = 0;
        var r: f64 = ganita_f64_pow(x, y);
        _par_got_f(r);
        _par_shadow_record("f64::powf ~ ganita_f64_pow", cls);
        return 0;
    }
    if (_par_eq(fp, fl, "f64::max") == 1) {
        _par_got_n = 0;
        var r: f64 = f64_max(x, y);
        _par_got_f(r);
        _par_shadow_record("f64::max ~ f64_max", cls);
        return 0;
    }
    if (_par_eq(fp, fl, "f64::min") == 1) {
        _par_got_n = 0;
        var r: f64 = f64_min(x, y);
        _par_got_f(r);
        _par_shadow_record("f64::min ~ f64_min", cls);
        return 0;
    }
    if (_par_eq(fp, fl, "f64::clamp") == 1 && _par_in_n == 3) {
        _par_got_n = 0;
        var hi: f64 = _par_in(2);
        var r: f64 = f64_clamp(x, y, hi);
        _par_got_f(r);
        _par_shadow_record("f64::clamp ~ f64_clamp", cls);
        return 0;
    }
    return 0;
}

# The class-C bound for a function, in ulps; -1 when none is set (the rows are measured). Under ADR 0003 every
# class-C function runs on its correctly rounded primitive (src/mathx.cyr) and is compared at 0 ulp against the
# corrected oracle. A shadow line (`fn ~ candidate`) is no function here, so it stays measured, never gated.
#must_use
fn _par_c_bound(fp, fl): i64 {
    if (_par_eq(fp, fl, "f64::exp") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::exp_m1") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::ln") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::powf") == 1) { return 0; }
    if (_par_eq(fp, fl, "integrate::step_factors") == 1) { return 0; }
    if (_par_eq(fp, fl, "integrate::relax") == 1) { return 0; }
    if (_par_eq(fp, fl, "integrate::produce_decay") == 1) { return 0; }
    if (_par_eq(fp, fl, "integrate::activate") == 1) { return 0; }
    return 0 - 1;
}

# The ADR accepting a divergent row (function and raw input field), or 0. The ADR 0002 rows arrive with their
# modules (port plan §3.3). Row 8: a RASAYAN_LOG form (or default) the port refuses takes the default, with a warning,
# where Rust reads it as a directive the port doesn't carry.
#must_use
fn _par_accepted(fp, fl, ip, il): i64 {
    if (_par_log_refused == 1 && fl > 9 && memeq(fp, "logging::", 9) == 1) {
        _par_log_acc = _par_log_acc + 1;
        return 2;
    }
    return 0;
}

# ADR 0002's accepted rows (the refused RASAYAN_LOG forms, each 20 tokens) are counted on their function's line and
# summed after the module, not printed one by one.
#must_use
fn _par_accepted_quiet(adr): i64 {
    if (adr == 2) { return 1; }
    return 0;
}

# Every printed accepted row gets its bit pair.
#must_use
fn _par_accepted_bits(adr): i64 {
    return 1;
}

# After the logging module: how many refused forms ADR 0002 row 8 accepts.
fn _par_module_done(mp, ml) {
    if (_par_eq(mp, ml, "logging") != 1) { return 0; }
    print("  ADR 0002 row 8: ", 18);
    fmt_int(_par_log_acc);
    println(" forms the port refuses (the default applies) where Rust reads a directive it doesn't carry");
    return 0;
}

# rasayan has one harness: no module is skipped.
#must_use
fn _par_skip(mp, ml): i64 {
    return 0;
}

_par_tables_init();
var exit_code = _par_main();
sys_exit_group(exit_code);
