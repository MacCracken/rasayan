        } elif (_par_eq(fp, fl, "metabolism::MetabolicState::amp") == 1) {
            r = ry_metabolic_state_amp(&m);
        } elif (_par_eq(fp, fl, "metabolism::MetabolicState::free_adp") == 1) {
