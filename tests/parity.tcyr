    }
    if (_par_in_n == 4) {
        if (_par_eq(fp, fl, "energy::BioenergyState::validate") == 1) {
            var t1, v1 = ry_bioenergy_state_validate(&b);
            _par_got_outcome(t1, v1);
            return 1;
