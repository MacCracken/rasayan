    if (_par_cf(np, nl, "constants::MAX_NAD_FACTOR", RY_MAX_NAD_FACTOR) == 1) { return 1; }
    if (_par_cf(np, nl, "constants::MAX_ATP_ADP_RATIO", RY_MAX_ATP_ADP_RATIO) == 1) { return 1; }
    if (_par_cf(np, nl, "energy::ATP_HYDROLYSIS_DG", RY_ENERGY_ATP_HYDROLYSIS_DG) == 1) { return 1; }
