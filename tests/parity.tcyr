# ── guard ───────────────────────────────────────────────────────────────────────────
# src/guard.cyr (M1). A validator's row has no output for Ok(()) and the error's Rust variant for Err (ADR 0002 row 1:
# the code is compared, the payload is in the DEBUG event).

# Appends a validator's outcome: nothing for Ok, the error for Err.
fn _par_got_outcome(t, v) {
    if (is_err_result(t) == 1) { _par_got_err(v); }
    return 0;
}

# The guard rows: the validators (`s:<name> f:<value>`, at_least `… f:<min>`), valid_dt, conc, unit, take, shift.
fn _par_guard(fp, fl): i64 {
    if (_par_in_n >= 2 && load64(_par_in_k) == 115) {
        var name = _par_in_cstr(0);
        if (name == 0) { return 0 - 1; }
        var v: f64 = _par_in(1);
        if (_par_eq(fp, fl, "guard::finite") == 1) {
            var t1, v1 = _ry_guard_finite(name, v);
            _par_got_outcome(t1, v1);
            return 1;
        }
        if (_par_eq(fp, fl, "guard::non_negative") == 1) {
            var t2, v2 = _ry_guard_non_negative(name, v);
            _par_got_outcome(t2, v2);
            return 1;
        }
        if (_par_eq(fp, fl, "guard::positive") == 1) {
            var t3, v3 = _ry_guard_positive(name, v);
            _par_got_outcome(t3, v3);
            return 1;
        }
        if (_par_eq(fp, fl, "guard::fraction") == 1) {
            var t4, v4 = _ry_guard_fraction(name, v);
            _par_got_outcome(t4, v4);
            return 1;
        }
        if (_par_eq(fp, fl, "guard::at_least") == 1 && _par_in_n == 3) {
            var min: f64 = _par_in(2);
            var t5, v5 = _ry_guard_at_least(name, v, min);
            _par_got_outcome(t5, v5);
            return 1;
        }
        return 0;
    }
    var x: f64 = _par_in(0);
    if (_par_eq(fp, fl, "guard::valid_dt") == 1) { _par_got_i(_ry_guard_valid_dt(x)); return 1; }
    if (_par_eq(fp, fl, "guard::conc") == 1) { var c: f64 = _ry_guard_conc(x); _par_got_f(c); return 1; }
    if (_par_eq(fp, fl, "guard::unit") == 1) { var u: f64 = _ry_guard_unit(x); _par_got_f(u); return 1; }
    if (_par_in_n < 2) { return 0; }
    var y: f64 = _par_in(1);
    if (_par_eq(fp, fl, "guard::take") == 1) { var r: f64 = _ry_guard_take(x, y); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "guard::shift") == 1 && _par_in_n == 3) {
        var p: f64 = _par_in(2);
        var r2: f64 = _ry_guard_shift(x, y, p);
        _par_got_f(r2);
        return 1;
    }
    return 0;
}

# ── integrate ───────────────────────────────────────────────────────────────────────
# src/integrate.cyr (M1): step_factors(y) -> (f, g); relax, produce_decay, activate (x, a, b, dt) -> x'.

fn _par_integrate(fp, fl): i64 {
    var a: f64 = _par_in(0);
    if (_par_eq(fp, fl, "integrate::step_factors") == 1) {
        var f, g = _ry_integrate_step_factors(a);
        _par_got_f(f);
        _par_got_f(g);
        return 1;
    }
    if (_par_in_n != 4) { return 0; }
    var b: f64 = _par_in(1);
    var c: f64 = _par_in(2);
    var dt: f64 = _par_in(3);
    if (_par_eq(fp, fl, "integrate::relax") == 1) {
        var r1: f64 = _ry_integrate_relax(a, b, c, dt);
        _par_got_f(r1);
        return 1;
    }
    if (_par_eq(fp, fl, "integrate::produce_decay") == 1) {
        var r2: f64 = _ry_integrate_produce_decay(a, b, c, dt);
        _par_got_f(r2);
        return 1;
    }
    if (_par_eq(fp, fl, "integrate::activate") == 1) {
        var r3: f64 = _ry_integrate_activate(a, b, c, dt);
        _par_got_f(r3);
        return 1;
    }
    return 0;
}

# ── logging ─────────────────────────────────────────────────────────────────────────
# src/logging.cyr (M1 part 2). A row gives the level of each of the 20 targets rasayan's events carry; the port has one
# level for all of them.

# The number of event targets a logging row lists (scripts/oracle/src/m_logging.rs, TARGETS).
var _PAR_LOG_TARGETS = 20;

# The logging rows accepted under ADR 0002 row 8, for the module's summary line.
var _par_log_acc = 0;

# 1 when the current logging row's RASAYAN_LOG value (or, unset or refused, its default) is a form the port refuses.
var _par_log_refused = 0;

# The golden name of a level (`LevelFilter.<NAME>`).
#must_use
fn _par_level_name(level): i64 {
    if (level == LOG_TRACE) { return "LevelFilter.TRACE"; }
    if (level == LOG_DEBUG) { return "LevelFilter.DEBUG"; }
    if (level == LOG_INFO) { return "LevelFilter.INFO"; }
    if (level == LOG_WARN) { return "LevelFilter.WARN"; }
    if (level == LOG_ERROR) { return "LevelFilter.ERROR"; }
    return "LevelFilter.OFF";
}

# The logging rows: `logging::init` (the variable: `n:` unset, else `s:`) and `logging::init_with_level` (the variable,
# then `s:<default>`).
fn _par_logging(fp, fl): i64 {
    var dflt = "info";
    if (_par_eq(fp, fl, "logging::init_with_level") == 1) {
        if (_par_in_n != 2) { return 0 - 1; }
        dflt = _par_in_cstr(1);
        if (dflt == 0) { return 0 - 1; }
    } elif (_par_eq(fp, fl, "logging::init") != 1 || _par_in_n != 1) {
        return 0;
    }
    var env = 0;
    var lw[8];
    store64(&lw, 0);
    if (load64(_par_in_k) == 115) {
        env = _par_in_bytes(0, &lw);
        if (env == 0) { return 0 - 1; }
    } elif (load64(_par_in_k) != 110) {
        return 0 - 1;
    }
    var en = load64(&lw);
    var lv = ry_log_level_of(env, en, dflt);
    _par_log_refused = 0;
    if (env != 0 && ry_log_parse(env, en) >= 0) {
        _par_log_refused = 0;
    } elif (env != 0) {
        _par_log_refused = 1;
    } elif (_par_eq(fp, fl, "logging::init_with_level") == 1) {
        if (_ry_log_list(dflt, strlen(dflt), LOG_ERROR) < 0) { _par_log_refused = 1; }
    }
    var name = _par_level_name(lv);
    var k = 0;
    while (k < _PAR_LOG_TARGETS) {
        _par_got_e(name);
        k = k + 1;
    }
    return 1;
}

# ── json ────────────────────────────────────────────────────────────────────────────
# src/json.cyr's writers (M1 part 3a), on the default allocator, into one builder reset per row.

# 1 for a `char` writer row.
#must_use
fn _par_json_char(fp, fl): i64 {
    return _par_eq(fp, fl, "serde_json::to_string<char>");
}

# ── json readers (part 3b) ──

# The reader rows accepted under ADR 0004, for the module's summary line.
var _par_json_acc = 0;

# 1 when the document [p, p + n) holds the integer token `-0` (bayan reads it as +0: its filed issue), else 0.
#must_use
fn _par_has_neg_zero_int(p, n): i64 {
    var i = 0;
    while (i + 1 < n) {
        if (load8(p + i) == 45 && load8(p + i + 1) == 48) {
            var prev = 32;
            if (i > 0) { prev = load8(p + i - 1); }
            var next = 32;
            if (i + 2 < n) { next = load8(p + i + 2); }
            var numeric_prev = (prev >= 48 && prev <= 57) || prev == 101 || prev == 69 || prev == 46;
            var continues = (next >= 48 && next <= 57) || next == 46 || next == 101 || next == 69;
            if (numeric_prev == 0 && continues == 0) { return 1; }
        }
        i = i + 1;
    }
    return 0;
}

# 1 when bayan's last parse error is one of its filed gaps against serde_json: a repeated key, an integer past i64,
# nesting past 128, a lone surrogate escape.
#must_use
fn _par_bayan_gap(): i64 {
    var m = bayan_json_last_error();
    if (strstr(m, "duplicate key") >= 0) { return 1; }
    if (strstr(m, "out of range for i64") >= 0) { return 1; }
    if (strstr(m, "nesting too deep") >= 0) { return 1; }
    if (strstr(m, "surrogate") >= 0) { return 1; }
    return 0;
}

# The reader rows: `serde_json::from_slice<T>` on the document (input 0's bytes): the value, or E:Deserialize.
fn _par_json_read(fp, fl): i64 {
    if (_par_jarena == 0) { _par_jarena = arena_allocator_growable(65536); }
    var a = _par_jarena;
    reset_via(a);
    var lw[8];
    var p = _par_in_bytes(0, &lw);
    if (p == 0) { return 0 - 1; }
    var n = load64(&lw);
    _par_json_gap = _par_has_neg_zero_int(p, n);
    var v = _ry_jr_parse(a, p, n);
    if (v == 0) {
        if (_par_bayan_gap() == 1) { _par_json_gap = 1; }
        _par_got_err(RY_ERR_DESERIALIZE);
        return 1;
    }
    var w[48];
    var w2[16];
    var ok = 0;
    if (_par_eq(fp, fl, "serde_json::from_slice<f64>") == 1) {
        ok = _ry_jr_f64(v, &w);
        if (ok == 1) { _par_got_f(load64(&w)); }
    } elif (_par_eq(fp, fl, "serde_json::from_slice<Option<f64>>") == 1) {
        ok = _ry_jr_opt_f64(v, &w2, &w);
        if (ok == 1 && load64(&w2) == 0) { _par_got_none(); }
        elif (ok == 1) { _par_got_f(load64(&w)); }
    } elif (_par_eq(fp, fl, "serde_json::from_slice<String>") == 1) {
        ok = _ry_jr_str(v, &w, &w2);
        if (ok == 1) { _par_got_text(load64(&w), load64(&w2)); }
    } elif (_par_eq(fp, fl, "serde_json::from_slice<char>") == 1) {
        ok = _ry_jr_char(v, &w, &w2);
        if (ok == 1) { _par_got_text(load64(&w), load64(&w2)); }
    } elif (_par_eq(fp, fl, "serde_json::from_slice<u32>") == 1) {
        ok = _ry_jr_int(v, 0, 4294967295, &w);
        if (ok == 1) { _par_got_i(load64(&w)); }
    } elif (_par_eq(fp, fl, "serde_json::from_slice<usize>") == 1) {
        ok = _ry_jr_int(v, 0, 0x7FFFFFFFFFFFFFFF, &w);
        if (ok == 1) { _par_got_i(load64(&w)); }
    } elif (_par_eq(fp, fl, "serde_json::from_slice<i32>") == 1) {
        ok = _ry_jr_int(v, 0 - 2147483648, 2147483647, &w);
        if (ok == 1) { _par_got_i(load64(&w)); }
    } elif (_par_eq(fp, fl, "serde_json::from_slice<[f64; 5]>") == 1) {
        ok = _ry_jr_f64_array(v, &w, 5);
        if (ok == 1) {
            var k = 0;
            while (k < 5) {
                _par_got_f(load64(&w + 8 * k));
                k = k + 1;
            }
        }
    } elif (_par_eq(fp, fl, "serde_json::from_slice<MembranePermeability>") == 1) {
        ok = _ry_jr_f64_fields(v, &w, 3, "p_na\0p_k\0p_cl\0");
        if (ok == 1) {
            _par_got_f(load64(&w));
            _par_got_f(load64(&w + 8));
            _par_got_f(load64(&w + 16));
        }
    } else {
        return 0;
    }
    if (ok != 1) { _par_got_err(RY_ERR_DESERIALIZE); }
    return 1;
}

# The writer rows: the serde_json text of one value, or Rust's Display of an f64 (`f64::fmt`).
fn _par_json(fp, fl): i64 {
    if (fl > 22 && memeq(fp, "serde_json::from_slice", 22) == 1) { return _par_json_read(fp, fl); }
    if (_par_jsb == 0) { _par_jsb = str_builder_new(); }
    var sb = _par_jsb;
    store64(sb + 8, 0);
    var a = default_alloc();
    var rc = 0 - 2;
    var k0 = load64(_par_in_k);
    if (_par_eq(fp, fl, "serde_json::to_string<f64>") == 1 && k0 == 102) {
        var x: f64 = _par_in(0);
        rc = _ry_jw_f64(a, sb, x);
    } elif (_par_eq(fp, fl, "f64::fmt") == 1 && k0 == 102) {
        var y: f64 = _par_in(0);
        _ry_fmt_f64_display(sb, y);
        rc = 0;
    } elif (_par_eq(fp, fl, "serde_json::to_string<String>") == 1 || _par_json_char(fp, fl) == 1) {
        var lw[8];
        var p = _par_in_bytes(0, &lw);
        if (p == 0) { return 0 - 1; }
        if (_par_json_char(fp, fl) == 1) {
            rc = _ry_jw_char(a, sb, p, load64(&lw));
        } else {
            rc = _ry_jw_str(a, sb, p, load64(&lw));
        }
    } elif (_par_eq(fp, fl, "serde_json::to_string<u32>") == 1 || _par_eq(fp, fl, "serde_json::to_string<usize>") == 1)
    {
        rc = _ry_jw_u64(a, sb, _par_in(0));
    } elif (_par_eq(fp, fl, "serde_json::to_string<i32>") == 1) {
        rc = _ry_jw_i64(a, sb, _par_in(0));
    } elif (_par_eq(fp, fl, "serde_json::to_string<Option<f64>>") == 1) {
        if (k0 == 110) {
            rc = _ry_jw_opt_f64(a, sb, 0, 0.0);
        } else {
            var z: f64 = _par_in(0);
            rc = _ry_jw_opt_f64(a, sb, 1, z);
        }
    } elif (_par_eq(fp, fl, "serde_json::to_string<[f64; 5]>") == 1 && _par_in_n == 5) {
        var arr[40];
        var j = 0;
        while (j < 5) {
            store64(&arr + 8 * j, _par_in(j));
            j = j + 1;
        }
        rc = _ry_jw_f64_array(a, sb, &arr, 5);
    }
    if (rc == 0 - 2) { return 0; }
    if (rc != 0) { return 0 - 1; }
    _par_got_text(load64(sb), load64(sb + 8));
    return 1;
}

# ── math ────────────────────────────────────────────────────────────────────────────
# `f64::` rows: the port's counterpart of each Rust std method rasayan calls (port plan §7.1, port-parity.md §0, §2d).
# - Class A: abs and ceil (builtins); min, max, is_finite, is_nan (src/mathx.cyr), clamp and the `as u32` cast
#   (src/mathx.cyr since M1): Rust's semantics where the stdlib's differ.
# - Class B: sqrt (builtin, correctly rounded); powi (`_ry_powi`, src/mathx.cyr, `__powidf2`'s order).
# - Class C (ADR 0003): exp, exp_m1, ln and powf (the `10_f64.powf(x)` rows included: the oracle calls glibc's pow
#   there) on src/mathx.cyr's correctly rounded `_ry_cr_*`, compared at 0 ulp against the corrected oracle
#   (tests/golden/math.cr.tsv): a row glibc misrounds passes as "accepted (ADR 3)", and one that matches glibc's
#   misrounding instead fails.
fn _par_math(fp, fl): i64 {
    var x: f64 = _par_in(0);
    if (_par_eq(fp, fl, "f64::abs") == 1) { var r: f64 = f64_abs(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::ceil") == 1) { var r: f64 = f64_ceil(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::sqrt") == 1) { var r: f64 = f64_sqrt(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::is_finite") == 1) { _par_got_i(_ry_is_finite(x)); return 1; }
    if (_par_eq(fp, fl, "f64::is_nan") == 1) { _par_got_i(_ry_is_nan(x)); return 1; }
    if (_par_eq(fp, fl, "f64::as_u32") == 1) { _par_got_i(_ry_f64_to_u32(x)); return 1; }
    if (_par_eq(fp, fl, "f64::exp") == 1) { var r: f64 = _ry_cr_exp(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::ln") == 1) { var r: f64 = _ry_cr_ln(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::exp_m1") == 1) { var r: f64 = _ry_cr_expm1(x); _par_got_f(r); return 1; }
    if (_par_in_n < 2) { return 0; }
    if (_par_eq(fp, fl, "f64::powi") == 1) {
        if (load64(_par_in_k + 8) != 105) { return 0 - 1; }
        var r: f64 = _ry_powi(x, _par_in(1));
        _par_got_f(r);
        return 1;
    }
    var y: f64 = _par_in(1);
    if (_par_eq(fp, fl, "f64::max") == 1) { var r: f64 = _ry_max(x, y); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::min") == 1) { var r: f64 = _ry_min(x, y); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::powf") == 1) { var r: f64 = _ry_cr_pow(x, y); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::clamp") == 1 && _par_in_n == 3) {
        var hi: f64 = _par_in(2);
        var r: f64 = _ry_clamp(x, y, hi);
        _par_got_f(r);
        return 1;
    }
    return 0;
}

# ── ptm ─────────────────────────────────────────────────────────────────────────────
# src/ptm.cyr (M3 part 3).

# Input token k as a PtmType (`e:PtmType.<Variant>`): its RyPtmType value, by the port's own names; -1 otherwise.
fn _par_ptm_type(k): i64 {
    if (k >= _par_in_n || load64(_par_in_k + 8 * k) != 101) { return 0 - 1; }
    var p = load64(_par_in_v + 8 * k);
    var l = load64(_par_in_l + 8 * k);
    if (l < 9 || memeq(p, "PtmType.", 8) != 1) { return 0 - 1; }
    var t = 0;
    while (t < RY_PTM_TYPE_COUNT) {
        if (_par_eq(p + 8, l - 8, ry_ptm_type_name(t)) == 1) { return t; }
        t = t + 1;
    }
    return 0 - 1;
}

# An allocation as a *RyPtmSite (the cast-helper idiom).
#must_use
fn _par_as_sites(p): *RyPtmSite { return p; }

# Appends PtmType t as its golden text (`PtmType.<Variant>`).
fn _par_got_ptm_type(t) {
    var name = ry_ptm_type_name(t);
    var nl = strlen(name);
    var buf = alloc(nl + 9);
    memcpy(buf, "PtmType.", 8);
    memcpy(buf + 8, name, nl);
    store8(buf + 8 + nl, 0);
    _par_got_e(buf);
    return 0;
}

# The ptm rows (src/ptm.cyr, M3 part 3): scan_ptm_sites (each site's position, residue, type and motif; a buffer one
# site short is refused and left as it was), disulfide_bond_count, and the serde rows.
fn _par_ptm(fp, fl): i64 {
    var lw[8];
    if (_par_eq(fp, fl, "ptm::scan_ptm_sites") == 1) {
        var seq = _par_in_bytes(0, &lw);
        var n = load64(&lw);
        if (_par_in_n != 1 || seq == 0) { return 0 - 1; }
        var cap = RY_PTM_MAX_SITES_PER_RESIDUE * n;
        var sites: *RyPtmSite = _par_as_sites(alloc(40 * cap + 40));
        var t, count = ry_scan_ptm_sites(seq, n, sites, cap);
        if (is_err_result(t) == 1) { return 0 - 1; }
        if (count < 0) {
            _par_got_none();
            return 1;
        }
        if (count > 0) {
            var small: *RyPtmSite = _par_as_sites(alloc(40 * count));
            store64(small, 0x5A5A5A5A);
            var ts, vs = ry_scan_ptm_sites(seq, n, small, count - 1);
            if (is_err_result(ts) == 0 || vs != RY_ERR_BUFFER_TOO_SMALL) { return 0 - 1; }
            if (load64(small) != 0x5A5A5A5A) { return 0 - 1; }
            var te, ve = ry_scan_ptm_sites(seq, n, small, count);
            if (is_err_result(te) == 1 || ve != count) { return 0 - 1; }
            if (memeq(small, sites, 40 * count) != 1) { return 0 - 1; }
        }
        _par_got_seq(count);
        var k = 0;
        while (k < count) {
            var s: *RyPtmSite = sites + k;
            _par_got_i(s.position);
            _par_got_char(s.residue);
            _par_got_ptm_type(s.ptm_type);
            var m = alloc(32);
            var tm, ml = ry_ptm_site_motif(seq, s, m, 24);
            if (is_err_result(tm) == 1) { return 0 - 1; }
            _par_got_text(m, ml);
            k = k + 1;
        }
        return 1;
    }
    if (_par_eq(fp, fl, "ptm::disulfide_bond_count") == 1) {
        var q = _par_in_bytes(0, &lw);
        if (_par_in_n != 1 || q == 0) { return 0 - 1; }
        _par_got_i(ry_disulfide_bond_count(q, load64(&lw)));
        return 1;
    }
    if (_par_jsb == 0) { _par_jsb = str_builder_new(); }
    var jb = _par_jsb;
    store64(jb + 8, 0);
    if (_par_eq(fp, fl, "serde_json::to_string<PtmType>") == 1) {
        var pt = _par_ptm_type(0);
        if (_par_in_n != 1 || pt < 0) { return 0 - 1; }
        var t1, v1 = ry_ptm_type_to_json(jb, pt);
        if (is_err_result(t1) == 1) { return 0 - 1; }
        _par_got_text(load64(jb), load64(jb + 8));
        return 1;
    }
    if (_par_eq(fp, fl, "serde_json::to_string<PtmSite>") == 1) {
        if (_par_in_n != 4 || load64(_par_in_k) != 105) { return 0 - 1; }
        var mot = _par_in_bytes(3, &lw);
        var res = _par_in_codepoint(1);
        var st = _par_ptm_type(2);
        if (mot == 0 || res < 0 || st < 0) { return 0 - 1; }
        var site: RyPtmSite;
        site.position = _par_in(0);
        site.residue = res;
        site.ptm_type = st;
        site.motif_start = 0;
        site.motif_len = load64(&lw);
        var t2, v2 = ry_ptm_site_to_json(jb, mot, &site);
        if (is_err_result(t2) == 1) { return 0 - 1; }
        _par_got_text(load64(jb), load64(jb + 8));
        return 1;
    }
    return 0;
}

# ── domain ──────────────────────────────────────────────────────────────────────────
# src/domain.cyr (M3 part 4).

# Input token k as a DomainType (`e:DomainType.<Variant>`): its RyDomainType value, by the port's own names; -1
# otherwise.
fn _par_domain_type(k): i64 {
    if (k >= _par_in_n || load64(_par_in_k + 8 * k) != 101) { return 0 - 1; }
    var p = load64(_par_in_v + 8 * k);
    var l = load64(_par_in_l + 8 * k);
    if (l < 12 || memeq(p, "DomainType.", 11) != 1) { return 0 - 1; }
    var t = 0;
    while (t < RY_DOMAIN_TYPE_COUNT) {
        if (_par_eq(p + 11, l - 11, ry_domain_type_name(t)) == 1) { return t; }
        t = t + 1;
    }
    return 0 - 1;
}

# An allocation as a *RyDomainHit (the cast-helper idiom).
#must_use
fn _par_as_hits(p): *RyDomainHit { return p; }

# Appends DomainType t as its golden text (`DomainType.<Variant>`).
fn _par_got_domain_type(t) {
    var name = ry_domain_type_name(t);
    var nl = strlen(name);
    var buf = alloc(nl + 12);
    memcpy(buf, "DomainType.", 11);
    memcpy(buf + 11, name, nl);
    store8(buf + 11 + nl, 0);
    _par_got_e(buf);
    return 0;
}

# The domain rows (src/domain.cyr, M3 part 4): scan_domains (each hit's start, end, type and fragment; a buffer one
# hit short is refused and left as it was) and the serde rows.
fn _par_domain(fp, fl): i64 {
    var lw[8];
    if (_par_eq(fp, fl, "domain::scan_domains") == 1) {
        var seq = _par_in_bytes(0, &lw);
        var n = load64(&lw);
        if (_par_in_n != 1 || seq == 0) { return 0 - 1; }
        var cap = RY_DOMAIN_MAX_HITS_PER_RESIDUE * n;
        var hits: *RyDomainHit = _par_as_hits(alloc(40 * cap + 40));
        var t, count = ry_scan_domains(seq, n, hits, cap);
        if (is_err_result(t) == 1) { return 0 - 1; }
        if (count < 0) {
            _par_got_none();
            return 1;
        }
        if (count > 0) {
            var small: *RyDomainHit = _par_as_hits(alloc(40 * count));
            store64(small, 0x5A5A5A5A);
            var ts, vs = ry_scan_domains(seq, n, small, count - 1);
            if (is_err_result(ts) == 0 || vs != RY_ERR_BUFFER_TOO_SMALL) { return 0 - 1; }
            if (load64(small) != 0x5A5A5A5A) { return 0 - 1; }
            var te, ve = ry_scan_domains(seq, n, small, count);
            if (is_err_result(te) == 1 || ve != count) { return 0 - 1; }
            if (memeq(small, hits, 40 * count) != 1) { return 0 - 1; }
        }
        _par_got_seq(count);
        var k = 0;
        while (k < count) {
            var h: *RyDomainHit = hits + k;
            _par_got_i(h.start);
            _par_got_i(h.end);
            _par_got_domain_type(h.domain_type);
            var f = alloc(RY_DOMAIN_MAX_FRAGMENT_BYTES + 8);
            var tf, fl2 = ry_domain_hit_fragment(seq, h, f, RY_DOMAIN_MAX_FRAGMENT_BYTES);
            if (is_err_result(tf) == 1) { return 0 - 1; }
            _par_got_text(f, fl2);
            k = k + 1;
        }
        return 1;
    }
    if (_par_jsb == 0) { _par_jsb = str_builder_new(); }
    var jb = _par_jsb;
    store64(jb + 8, 0);
    if (_par_eq(fp, fl, "serde_json::to_string<DomainType>") == 1) {
        var dt = _par_domain_type(0);
        if (_par_in_n != 1 || dt < 0) { return 0 - 1; }
        var t1, v1 = ry_domain_type_to_json(jb, dt);
        if (is_err_result(t1) == 1) { return 0 - 1; }
        _par_got_text(load64(jb), load64(jb + 8));
        return 1;
    }
    if (_par_eq(fp, fl, "serde_json::to_string<DomainHit>") == 1) {
        if (_par_in_n != 4 || load64(_par_in_k) != 105 || load64(_par_in_k + 8) != 105) { return 0 - 1; }
        var frag = _par_in_bytes(3, &lw);
        var ht = _par_domain_type(2);
        if (frag == 0 || ht < 0) { return 0 - 1; }
        var hit: RyDomainHit;
        hit.start = _par_in(0);
        hit.end = _par_in(1);
        hit.domain_type = ht;
        hit.fragment_start = 0;
        hit.fragment_len = load64(&lw);
        var t2, v2 = ry_domain_hit_to_json(jb, frag, &hit);
        if (is_err_result(t2) == 1) { return 0 - 1; }
        _par_got_text(load64(jb), load64(jb + 8));
        return 1;
    }
    return 0;
}

# ── routing and hooks ───────────────────────────────────────────────────────────────

# Routes a row to its module's dispatcher. 0 (pending) for a module or function with no Cyrius code yet: the module
# rows of every module arrive from M1 on, each with its dispatcher here.
# ── glycolysis ──────────────────────────────────────────────────────────────────────
# src/glycolysis_data.cyr and src/glycolysis.cyr (M4a part 1). A GlycolysisState row takes the state's eleven fields;
# a GlycolysisConfig is the default with overrides, `i:n` then n pairs `i:field f:x`. tick takes the state, the config
# and `f:atp f:adp f:nad_ratio f:dt` (tick_regulated `f:pfk_modifier` before dt) and gives the state after and the
# flux's fifteen values; accumulate takes the two fluxes and `f:weight`. A trajectory row (class T) is a script: the
# state, the config, then `i:1 f:atp f:adp f:nad f:dt i:k` k ticks, `i:2 f:atp f:adp f:nad f:pfk f:dt i:k` k regulated
# ticks, `i:3 i:field f:x` a state field set; it gives the state after and the last step's flux.

# Reads a config from input k into *c (the default, then the overrides): the index after it, or -1 when malformed.
fn _par_gc_in(k, c: *RyGlycolysisConfig): i64 {
    ry_glycolysis_config_default(c);
    if (k >= _par_in_n || load64(_par_in_k + k * 8) != 105) { return 0 - 1; }
    var n = _par_in(k);
    var w = c;
    var at = k + 1;
    var j = 0;
    while (j < n) {
        if (at + 1 >= _par_in_n || load64(_par_in_k + at * 8) != 105 || _par_is_f(at + 1) == 0) { return 0 - 1; }
        var field = _par_in(at);
        if (field < 0 || field >= 38) { return 0 - 1; }
        store64(w + 8 * field, _par_in(at + 1));
        at = at + 2;
        j = j + 1;
    }
    return at;
}

# 1 if input k is an integer token.
#must_use
fn _par_is_i(k): i64 {
    if (k >= _par_in_n) { return 0; }
    if (load64(_par_in_k + k * 8) == 105) { return 1; }
    return 0;
}

# Replays a trajectory script from input k on *s under *c: 1 with *f the last step's flux (the zero flux when no step
# ran), or -1 for a malformed script.
fn _par_gl_script(s: *RyGlycolysisState, c: *RyGlycolysisConfig, k, f: *RyGlycolysisFlux): i64 {
    ry_glycolysis_flux_default(f);
    var w = s;
    var at = k;
    while (at < _par_in_n) {
        if (_par_is_i(at) == 0) { return 0 - 1; }
        var op = _par_in(at);
        if (op == 1 && _par_all_f_from(at + 1, 4) == 1 && _par_is_i(at + 5) == 1) {
            var atp: f64 = _par_f(at + 1);
            var adp: f64 = _par_f(at + 2);
            var nad: f64 = _par_f(at + 3);
            var dt: f64 = _par_f(at + 4);
            var n = _par_in(at + 5);
            var j = 0;
            while (j < n) {
                ry_glycolysis_state_tick(s, c, atp, adp, nad, dt, f);
                j = j + 1;
            }
            at = at + 6;
        } elif (op == 2 && _par_all_f_from(at + 1, 5) == 1 && _par_is_i(at + 6) == 1) {
            var ratp: f64 = _par_f(at + 1);
            var radp: f64 = _par_f(at + 2);
            var rnad: f64 = _par_f(at + 3);
            var pfk: f64 = _par_f(at + 4);
            var rdt: f64 = _par_f(at + 5);
            var rn = _par_in(at + 6);
            var r = 0;
            while (r < rn) {
                _ry_glycolysis_state_tick_regulated(s, c, ratp, radp, rnad, pfk, rdt, f);
                r = r + 1;
            }
            at = at + 7;
        } elif (op == 3 && _par_is_i(at + 1) == 1 && _par_is_f(at + 2) == 1) {
            var field = _par_in(at + 1);
            if (field < 0 || field > 10) { return 0 - 1; }
            store64(w + 8 * field, _par_in(at + 2));
            at = at + 3;
        } else {
            return 0 - 1;
        }
    }
    return 1;
}

# The glycolysis rows: the defaults, the validators, the pools, gapdh_nad_factor, accumulate, the steps and
# trajectories, the serde rows.
fn _par_glycolysis(fp, fl): i64 {
    var s: RyGlycolysisState;
    var c: RyGlycolysisConfig;
    var fx: RyGlycolysisFlux;
    if (_par_eq(fp, fl, "glycolysis::GlycolysisState::default") == 1) {
        if (_par_in_n != 0) { return 0 - 1; }
        ry_glycolysis_state_default(&s);
        _par_got_fields(&s, 11);
        return 1;
    }
    if (_par_eq(fp, fl, "glycolysis::GlycolysisConfig::default") == 1) {
        if (_par_in_n != 0) { return 0 - 1; }
        ry_glycolysis_config_default(&c);
        _par_got_fields(&c, 38);
        return 1;
    }
    if (_par_eq(fp, fl, "glycolysis::GlycolysisConfig::validate") == 1) {
        if (_par_gc_in(0, &c) != _par_in_n) { return 0 - 1; }
        var tc, vc = ry_glycolysis_config_validate(&c);
        _par_got_outcome(tc, vc);
        return 1;
    }
    if (_par_eq(fp, fl, "glycolysis::gapdh_nad_factor") == 1) {
        if (_par_in_n != 1 || _par_is_f(0) == 0) { return 0 - 1; }
        var x: f64 = _par_f(0);
        var g: f64 = _ry_glycolysis_gapdh_nad_factor(x);
        _par_got_f(g);
        return 1;
    }
    if (_par_eq(fp, fl, "glycolysis::GlycolysisFlux::accumulate") == 1) {
        if (_par_in_n != 31 || _par_all_f(31) == 0) { return 0 - 1; }
        var o: RyGlycolysisFlux;
        _par_fields_in(0, &fx, 15);
        _par_fields_in(15, &o, 15);
        var weight: f64 = _par_f(30);
        _ry_glycolysis_flux_accumulate(&fx, &o, weight);
        _par_got_fields(&fx, 15);
        return 1;
    }
    if (_par_in_n < 11 || _par_all_f_from(0, 11) == 0) { return _par_glycolysis_json(fp, fl); }
    _par_fields_in(0, &s, 11);
    if (_par_in_n == 11) {
        var r: f64 = 0.0;
        if (_par_eq(fp, fl, "glycolysis::GlycolysisState::validate") == 1) {
            var ts, vs = ry_glycolysis_state_validate(&s);
            _par_got_outcome(ts, vs);
            return 1;
        } elif (_par_eq(fp, fl, "glycolysis::GlycolysisState::total_intermediates") == 1) {
            r = ry_glycolysis_state_total_intermediates(&s);
        } elif (_par_eq(fp, fl, "glycolysis::GlycolysisState::total_carbon") == 1) {
            r = ry_glycolysis_state_total_carbon(&s);
        } else {
            return _par_glycolysis_json(fp, fl);
        }
        _par_got_f(r);
        return 1;
    }
    var k = _par_gc_in(11, &c);
    if (k < 0) { return _par_glycolysis_json(fp, fl); }
    if (_par_eq(fp, fl, "glycolysis::GlycolysisState::trajectory") == 1) {
        if (_par_gl_script(&s, &c, k, &fx) != 1) { return 0 - 1; }
        _par_got_fields(&s, 11);
        _par_got_fields(&fx, 15);
        return 1;
    }
    if (_par_eq(fp, fl, "glycolysis::GlycolysisState::tick") == 1) {
        if (_par_in_n != k + 4 || _par_all_f_from(k, 4) == 0) { return 0 - 1; }
        var atp: f64 = _par_f(k);
        var adp: f64 = _par_f(k + 1);
        var nad: f64 = _par_f(k + 2);
        var dt: f64 = _par_f(k + 3);
        ry_glycolysis_state_tick(&s, &c, atp, adp, nad, dt, &fx);
        _par_got_fields(&s, 11);
        _par_got_fields(&fx, 15);
        return 1;
    }
    if (_par_eq(fp, fl, "glycolysis::GlycolysisState::tick_regulated") == 1) {
        if (_par_in_n != k + 5 || _par_all_f_from(k, 5) == 0) { return 0 - 1; }
        var ratp: f64 = _par_f(k);
        var radp: f64 = _par_f(k + 1);
        var rnad: f64 = _par_f(k + 2);
        var pfk: f64 = _par_f(k + 3);
        var rdt: f64 = _par_f(k + 4);
        _ry_glycolysis_state_tick_regulated(&s, &c, ratp, radp, rnad, pfk, rdt, &fx);
        _par_got_fields(&s, 11);
        _par_got_fields(&fx, 15);
        return 1;
    }
    return _par_glycolysis_json(fp, fl);
}

# The serde rows of GlycolysisState, GlycolysisConfig and GlycolysisFlux.
fn _par_glycolysis_json(fp, fl): i64 {
    var s: RyGlycolysisState;
    var c: RyGlycolysisConfig;
    var fx: RyGlycolysisFlux;
    if (_par_jsb == 0) { _par_jsb = str_builder_new(); }
    var sb = _par_jsb;
    store64(sb + 8, 0);
    if (_par_eq(fp, fl, "serde_json::to_string<GlycolysisState>") == 1 && _par_in_n == 11 && _par_all_f(11) == 1) {
        _par_fields_in(0, &s, 11);
        var t1, v1 = ry_glycolysis_state_to_json(sb, &s);
        if (is_err_result(t1) == 1) { return 0 - 1; }
        _par_got_text(load64(sb), load64(sb + 8));
        return 1;
    }
    if (_par_eq(fp, fl, "serde_json::to_string<GlycolysisConfig>") == 1 && _par_in_n == 38 && _par_all_f(38) == 1) {
        _par_fields_in(0, &c, 38);
        var t2, v2 = ry_glycolysis_config_to_json(sb, &c);
        if (is_err_result(t2) == 1) { return 0 - 1; }
        _par_got_text(load64(sb), load64(sb + 8));
        return 1;
    }
    if (_par_eq(fp, fl, "serde_json::to_string<GlycolysisFlux>") == 1 && _par_in_n == 15 && _par_all_f(15) == 1) {
        _par_fields_in(0, &fx, 15);
        var t3, v3 = ry_glycolysis_flux_to_json(sb, &fx);
        if (is_err_result(t3) == 1) { return 0 - 1; }
        _par_got_text(load64(sb), load64(sb + 8));
        return 1;
    }
    var kind = 0;
    if (_par_eq(fp, fl, "serde_json::from_slice<GlycolysisState>") == 1) { kind = 1; }
    if (_par_eq(fp, fl, "serde_json::from_slice<GlycolysisConfig>") == 1) { kind = 2; }
    if (_par_eq(fp, fl, "serde_json::from_slice<GlycolysisFlux>") == 1) { kind = 3; }
    if (kind == 0) { return 0; }
    var lw[8];
    var doc = _par_in_bytes(0, &lw);
    if (doc == 0) { return 0 - 1; }
    var n = load64(&lw);
    if (_par_jarena == 0) { _par_jarena = arena_allocator_growable(65536); }
    _par_json_gap = _par_has_neg_zero_int(doc, n);
    reset_via(_par_jarena);
    if (kind == 1) {
        var t4, v4 = ry_glycolysis_state_from_json_a(_par_jarena, doc, n, &s);
        if (is_err_result(t4) == 1) {
            _par_got_err(v4);
            return 1;
        }
        _par_got_fields(&s, 11);
        return 1;
    }
    if (kind == 2) {
        var t5, v5 = ry_glycolysis_config_from_json_a(_par_jarena, doc, n, &c);
        if (is_err_result(t5) == 1) {
            _par_got_err(v5);
            return 1;
        }
        _par_got_fields(&c, 38);
        return 1;
    }
    var t6, v6 = ry_glycolysis_flux_from_json_a(_par_jarena, doc, n, &fx);
    if (is_err_result(t6) == 1) {
        _par_got_err(v6);
        return 1;
    }
    _par_got_fields(&fx, 15);
    return 1;
}

# ── tca ─────────────────────────────────────────────────────────────────────────────
# src/tca_data.cyr and src/tca.cyr (M4a part 2). A TcaState row takes the state's nine fields; a TcaConfig is the
# default with overrides, `i:n` then n pairs `i:field f:x`. tick takes the state, the config and `f:pyruvate f:atp
# f:adp f:nad_ratio f:dt` and gives the state after and the flux's fourteen values; accumulate takes the two fluxes and
# `f:weight`. A trajectory row (class T) is a script: the state, the config, then `i:1 f:p f:atp f:adp f:nad f:dt i:k`
# k ticks, `i:2 i:field f:x f:p f:atp f:adp f:nad f:dt i:k` k times a field += x then a tick, `i:3 i:field f:x` a field
# set; it gives the state after and the last step's flux. A coupling row (`tca::glycolysis_feeds_tca`) is Rust's
# integration loop: the glycolysis state, the TCA state and `f:atp f:adp f:nad f:dt i:k`.

# Reads a TCA config from input k into *c (the default, then the overrides): the index after it, or -1 when
# malformed.
fn _par_tc_in(k, c: *RyTcaConfig): i64 {
    ry_tca_config_default(c);
    if (_par_is_i(k) == 0) { return 0 - 1; }
    var n = _par_in(k);
    var w = c;
    var at = k + 1;
    var j = 0;
    while (j < n) {
        if (_par_is_i(at) == 0 || _par_is_f(at + 1) == 0) { return 0 - 1; }
        var field = _par_in(at);
        if (field < 0 || field >= 32) { return 0 - 1; }
        store64(w + 8 * field, _par_in(at + 1));
        at = at + 2;
        j = j + 1;
    }
    return at;
}

# Replays a TCA trajectory script from input k on *s under *c: 1 with *f the last step's flux (the zero flux when no
# step ran), or -1 for a malformed script.
fn _par_tca_script(s: *RyTcaState, c: *RyTcaConfig, k, f: *RyTcaFlux): i64 {
    ry_tca_flux_default(f);
    var w = s;
    var at = k;
    while (at < _par_in_n) {
        if (_par_is_i(at) == 0) { return 0 - 1; }
        var op = _par_in(at);
        if (op == 1 && _par_all_f_from(at + 1, 5) == 1 && _par_is_i(at + 6) == 1) {
            var pyr: f64 = _par_f(at + 1);
            var atp: f64 = _par_f(at + 2);
            var adp: f64 = _par_f(at + 3);
            var nad: f64 = _par_f(at + 4);
            var dt: f64 = _par_f(at + 5);
            var n = _par_in(at + 6);
            var j = 0;
            while (j < n) {
                ry_tca_state_tick(s, c, pyr, atp, adp, nad, dt, f);
                j = j + 1;
            }
            at = at + 7;
        } elif (op == 2 && _par_is_i(at + 1) == 1 && _par_all_f_from(at + 2, 6) == 1 && _par_is_i(at + 8) == 1) {
            var field = _par_in(at + 1);
            if (field < 0 || field > 8) { return 0 - 1; }
            var x: f64 = _par_f(at + 2);
            var fpyr: f64 = _par_f(at + 3);
            var fatp: f64 = _par_f(at + 4);
            var fadp: f64 = _par_f(at + 5);
            var fnad: f64 = _par_f(at + 6);
            var fdt: f64 = _par_f(at + 7);
            var reps = _par_in(at + 8);
            var r = 0;
            while (r < reps) {
                var cur: f64 = load64(w + 8 * field);
                var fed: f64 = cur + x;
                store64(w + 8 * field, load64(&fed));
                ry_tca_state_tick(s, c, fpyr, fatp, fadp, fnad, fdt, f);
                r = r + 1;
            }
            at = at + 9;
        } elif (op == 3 && _par_is_i(at + 1) == 1 && _par_is_f(at + 2) == 1) {
            var sf = _par_in(at + 1);
            if (sf < 0 || sf > 8) { return 0 - 1; }
            store64(w + 8 * sf, _par_in(at + 2));
            at = at + 3;
        } else {
            return 0 - 1;
        }
    }
    return 1;
}

# Rust's test_glycolysis_feeds_tca loop (inputs: the two states, then `f:atp f:adp f:nad f:dt i:k`): 1 with the two
# states, the NADH sum and the ATP sum as the outputs, or -1 when malformed.
fn _par_tca_coupled(): i64 {
    if (_par_in_n != 25 || _par_all_f_from(0, 24) == 0 || _par_is_i(24) == 0) { return 0 - 1; }
    var g: RyGlycolysisState;
    var gc: RyGlycolysisConfig;
    var gf: RyGlycolysisFlux;
    var t: RyTcaState;
    var tc: RyTcaConfig;
    var tf: RyTcaFlux;
    _par_fields_in(0, &g, 11);
    _par_fields_in(11, &t, 9);
    ry_glycolysis_config_default(&gc);
    ry_tca_config_default(&tc);
    var atp: f64 = _par_f(20);
    var adp: f64 = _par_f(21);
    var nad: f64 = _par_f(22);
    var dt: f64 = _par_f(23);
    var n = _par_in(24);
    var nadh: f64 = 0.0;
    var made: f64 = 0.0;
    var k = 0;
    while (k < n) {
        ry_glycolysis_state_tick(&g, &gc, atp, adp, nad, dt, &gf);
        var pyr: f64 = g.pyruvate;
        ry_tca_state_tick(&t, &tc, pyr, atp, adp, nad, dt, &tf);
        var left: f64 = g.pyruvate - tf.pyruvate_consumed;
        var kept: f64 = _ry_max(left, 0.0);
        g.pyruvate = kept;
        nadh = nadh + (gf.nadh_produced + tf.nadh_produced);
        made = made + (gf.net_atp + tf.gtp_produced);
        k = k + 1;
    }
    _par_got_fields(&g, 11);
    _par_got_fields(&t, 9);
    _par_got_f(nadh);
    _par_got_f(made);
    return 1;
}

# The TCA rows: the defaults, the validators, the pool, accumulate, the steps, trajectories and the coupling, the serde
# rows.
fn _par_tca(fp, fl): i64 {
    var s: RyTcaState;
    var c: RyTcaConfig;
    var fx: RyTcaFlux;
    if (_par_eq(fp, fl, "tca::TcaState::default") == 1) {
        if (_par_in_n != 0) { return 0 - 1; }
        ry_tca_state_default(&s);
        _par_got_fields(&s, 9);
        return 1;
    }
    if (_par_eq(fp, fl, "tca::TcaConfig::default") == 1) {
        if (_par_in_n != 0) { return 0 - 1; }
        ry_tca_config_default(&c);
        _par_got_fields(&c, 32);
        return 1;
    }
    if (_par_eq(fp, fl, "tca::TcaConfig::validate") == 1) {
        if (_par_tc_in(0, &c) != _par_in_n) { return 0 - 1; }
        var tc, vc = ry_tca_config_validate(&c);
        _par_got_outcome(tc, vc);
        return 1;
    }
    if (_par_eq(fp, fl, "tca::glycolysis_feeds_tca") == 1) { return _par_tca_coupled(); }
    if (_par_eq(fp, fl, "tca::TcaFlux::accumulate") == 1) {
        if (_par_in_n != 29 || _par_all_f(29) == 0) { return 0 - 1; }
        var o: RyTcaFlux;
        _par_fields_in(0, &fx, 14);
        _par_fields_in(14, &o, 14);
        var weight: f64 = _par_f(28);
        _ry_tca_flux_accumulate(&fx, &o, weight);
        _par_got_fields(&fx, 14);
        return 1;
    }
    if (_par_in_n < 9 || _par_all_f_from(0, 9) == 0) { return _par_tca_json(fp, fl); }
    _par_fields_in(0, &s, 9);
    if (_par_in_n == 9) {
        if (_par_eq(fp, fl, "tca::TcaState::validate") == 1) {
            var ts, vs = ry_tca_state_validate(&s);
            _par_got_outcome(ts, vs);
            return 1;
        }
        if (_par_eq(fp, fl, "tca::TcaState::total_pool") == 1) {
            var r: f64 = ry_tca_state_total_pool(&s);
            _par_got_f(r);
            return 1;
        }
        return _par_tca_json(fp, fl);
    }
    var k = _par_tc_in(9, &c);
    if (k < 0) { return _par_tca_json(fp, fl); }
    if (_par_eq(fp, fl, "tca::TcaState::trajectory") == 1) {
        if (_par_tca_script(&s, &c, k, &fx) != 1) { return 0 - 1; }
        _par_got_fields(&s, 9);
        _par_got_fields(&fx, 14);
        return 1;
    }
    if (_par_eq(fp, fl, "tca::TcaState::tick") == 1) {
        if (_par_in_n != k + 5 || _par_all_f_from(k, 5) == 0) { return 0 - 1; }
        var pyr: f64 = _par_f(k);
        var atp: f64 = _par_f(k + 1);
        var adp: f64 = _par_f(k + 2);
        var nad: f64 = _par_f(k + 3);
        var dt: f64 = _par_f(k + 4);
        ry_tca_state_tick(&s, &c, pyr, atp, adp, nad, dt, &fx);
        _par_got_fields(&s, 9);
        _par_got_fields(&fx, 14);
        return 1;
    }
    return _par_tca_json(fp, fl);
}

# The serde rows of TcaState, TcaConfig and TcaFlux.
fn _par_tca_json(fp, fl): i64 {
    var s: RyTcaState;
    var c: RyTcaConfig;
    var fx: RyTcaFlux;
    if (_par_jsb == 0) { _par_jsb = str_builder_new(); }
    var sb = _par_jsb;
    store64(sb + 8, 0);
    if (_par_eq(fp, fl, "serde_json::to_string<TcaState>") == 1 && _par_in_n == 9 && _par_all_f(9) == 1) {
        _par_fields_in(0, &s, 9);
        var t1, v1 = ry_tca_state_to_json(sb, &s);
        if (is_err_result(t1) == 1) { return 0 - 1; }
        _par_got_text(load64(sb), load64(sb + 8));
        return 1;
    }
    if (_par_eq(fp, fl, "serde_json::to_string<TcaConfig>") == 1 && _par_in_n == 32 && _par_all_f(32) == 1) {
        _par_fields_in(0, &c, 32);
        var t2, v2 = ry_tca_config_to_json(sb, &c);
        if (is_err_result(t2) == 1) { return 0 - 1; }
        _par_got_text(load64(sb), load64(sb + 8));
        return 1;
    }
    if (_par_eq(fp, fl, "serde_json::to_string<TcaFlux>") == 1 && _par_in_n == 14 && _par_all_f(14) == 1) {
        _par_fields_in(0, &fx, 14);
        var t3, v3 = ry_tca_flux_to_json(sb, &fx);
        if (is_err_result(t3) == 1) { return 0 - 1; }
        _par_got_text(load64(sb), load64(sb + 8));
        return 1;
    }
    var kind = 0;
    if (_par_eq(fp, fl, "serde_json::from_slice<TcaState>") == 1) { kind = 1; }
    if (_par_eq(fp, fl, "serde_json::from_slice<TcaConfig>") == 1) { kind = 2; }
    if (_par_eq(fp, fl, "serde_json::from_slice<TcaFlux>") == 1) { kind = 3; }
    if (kind == 0) { return 0; }
    var lw[8];
    var doc = _par_in_bytes(0, &lw);
    if (doc == 0) { return 0 - 1; }
    var n = load64(&lw);
    if (_par_jarena == 0) { _par_jarena = arena_allocator_growable(65536); }
    _par_json_gap = _par_has_neg_zero_int(doc, n);
    reset_via(_par_jarena);
    if (kind == 1) {
        var t4, v4 = ry_tca_state_from_json_a(_par_jarena, doc, n, &s);
        if (is_err_result(t4) == 1) {
            _par_got_err(v4);
            return 1;
        }
        _par_got_fields(&s, 9);
        return 1;
    }
    if (kind == 2) {
        var t5, v5 = ry_tca_config_from_json_a(_par_jarena, doc, n, &c);
        if (is_err_result(t5) == 1) {
            _par_got_err(v5);
            return 1;
        }
        _par_got_fields(&c, 32);
        return 1;
    }
    var t6, v6 = ry_tca_flux_from_json_a(_par_jarena, doc, n, &fx);
    if (is_err_result(t6) == 1) {
        _par_got_err(v6);
        return 1;
    }
    _par_got_fields(&fx, 14);
    return 1;
}

# ── etc ─────────────────────────────────────────────────────────────────────────────
# src/etc_data.cyr and src/etc.cyr (M4b part 1). An EtcState row takes the state's three fields; an EtcConfig is the
# default with overrides, `i:n` then n pairs `i:field f:x`. tick takes the state, the config and `f:nadh f:fadh2
# f:oxygen f:adp f:dt`; step `f:nadh_conc f:nadh_avail f:fadh2 f:oxygen f:adp f:dt` (the EtcDrive, then dt); both give
# the state after and the flux's ten values. complex_i_capacity takes the state and the config, pump_stoichiometry the
# config. A trajectory row (class T) is a script: the state, the config, then `i:1 …tick… i:k`, `i:2 …step… i:k`,
# `i:3 i:field f:x`. A pipeline row (`etc::full_respiration`) is Rust's full respiration loop: the glycolysis, TCA and
# ETC states, then `f:atp f:adp f:nad f:oxygen f:dt i:k`.

# Reads an ETC config from input k into *c (the default, then the overrides): the index after it, or -1 when
# malformed.
fn _par_ec_in(k, c: *RyEtcConfig): i64 {
    ry_etc_config_default(c);
    if (_par_is_i(k) == 0) { return 0 - 1; }
    var n = _par_in(k);
    var w = c;
    var at = k + 1;
    var j = 0;
    while (j < n) {
        if (_par_is_i(at) == 0 || _par_is_f(at + 1) == 0) { return 0 - 1; }
        var field = _par_in(at);
        if (field < 0 || field >= 14) { return 0 - 1; }
        store64(w + 8 * field, _par_in(at + 1));
        at = at + 2;
        j = j + 1;
    }
    return at;
}

# The drive from the six f64 inputs from k (nadh_conc, nadh_avail, fadh2, oxygen, adp; dt is the sixth, not read here).
fn _par_drive_in(k, d: *_RyEtcDrive) {
    var w = d;
    var j = 0;
    while (j < 5) {
        store64(w + 8 * j, _par_in(k + j));
        j = j + 1;
    }
    return 0;
}

# Replays an ETC trajectory script from input k on *s under *c: 1 with *f the last step's flux, or -1 when malformed.
fn _par_etc_script(s: *RyEtcState, c: *RyEtcConfig, k, f: *RyEtcFlux): i64 {
    ry_etc_flux_default(f);
    var w = s;
    var d: _RyEtcDrive;
    var at = k;
    while (at < _par_in_n) {
        if (_par_is_i(at) == 0) { return 0 - 1; }
        var op = _par_in(at);
        if (op == 1 && _par_all_f_from(at + 1, 5) == 1 && _par_is_i(at + 6) == 1) {
            var nadh: f64 = _par_f(at + 1);
            var fadh2: f64 = _par_f(at + 2);
            var o2: f64 = _par_f(at + 3);
            var adp: f64 = _par_f(at + 4);
            var dt: f64 = _par_f(at + 5);
            var n = _par_in(at + 6);
            var j = 0;
            while (j < n) {
                ry_etc_state_tick(s, c, nadh, fadh2, o2, adp, dt, f);
                j = j + 1;
            }
            at = at + 7;
        } elif (op == 2 && _par_all_f_from(at + 1, 6) == 1 && _par_is_i(at + 7) == 1) {
            _par_drive_in(at + 1, &d);
            var sdt: f64 = _par_f(at + 6);
            var reps = _par_in(at + 7);
            var r = 0;
            while (r < reps) {
                _ry_etc_state_step(s, c, &d, sdt, f);
                r = r + 1;
            }
            at = at + 8;
        } elif (op == 3 && _par_is_i(at + 1) == 1 && _par_is_f(at + 2) == 1) {
            var field = _par_in(at + 1);
            if (field < 0 || field > 2) { return 0 - 1; }
            store64(w + 8 * field, _par_in(at + 2));
            at = at + 3;
        } else {
            return 0 - 1;
        }
    }
    return 1;
}

# Rust's test_full_respiration_pipeline loop (inputs: the three states, then `f:atp f:adp f:nad f:oxygen f:dt i:k`): 1
# with the three states, the ATP sum and the O2 sum as the outputs, or -1 when malformed.
fn _par_etc_pipeline(): i64 {
    if (_par_in_n != 29 || _par_all_f_from(0, 28) == 0 || _par_is_i(28) == 0) { return 0 - 1; }
    var g: RyGlycolysisState;
    var gc: RyGlycolysisConfig;
    var gf: RyGlycolysisFlux;
    var t: RyTcaState;
    var tc: RyTcaConfig;
    var tf: RyTcaFlux;
    var e: RyEtcState;
    var ec: RyEtcConfig;
    var ef: RyEtcFlux;
    _par_fields_in(0, &g, 11);
    _par_fields_in(11, &t, 9);
    _par_fields_in(20, &e, 3);
    ry_glycolysis_config_default(&gc);
    ry_tca_config_default(&tc);
    ry_etc_config_default(&ec);
    var atp: f64 = _par_f(23);
    var adp: f64 = _par_f(24);
    var nad: f64 = _par_f(25);
    var oxygen: f64 = _par_f(26);
    var dt: f64 = _par_f(27);
    var n = _par_in(28);
    var made: f64 = 0.0;
    var o2: f64 = 0.0;
    var k = 0;
    while (k < n) {
        ry_glycolysis_state_tick(&g, &gc, atp, adp, nad, dt, &gf);
        var pyr: f64 = g.pyruvate;
        ry_tca_state_tick(&t, &tc, pyr, atp, adp, nad, dt, &tf);
        var left: f64 = g.pyruvate - tf.pyruvate_consumed;
        var kept: f64 = _ry_max(left, 0.0);
        g.pyruvate = kept;
        var nadh_pool: f64 = gf.nadh_produced + tf.nadh_produced;
        var fadh2: f64 = tf.fadh2_produced;
        ry_etc_state_tick(&e, &ec, nadh_pool, fadh2, oxygen, adp, dt, &ef);
        made = made + (gf.net_atp + tf.gtp_produced + ef.atp_produced);
        o2 = o2 + ef.o2_consumed;
        k = k + 1;
    }
    _par_got_fields(&g, 11);
    _par_got_fields(&t, 9);
    _par_got_fields(&e, 3);
    _par_got_f(made);
    _par_got_f(o2);
    return 1;
}

# The ETC rows: the defaults, the validators, the pump split and Complex I's capacity, accumulate, the steps,
# trajectories and the pipeline, the serde rows.
fn _par_etc(fp, fl): i64 {
    var s: RyEtcState;
    var c: RyEtcConfig;
    var fx: RyEtcFlux;
    if (_par_eq(fp, fl, "etc::EtcState::default") == 1) {
        if (_par_in_n != 0) { return 0 - 1; }
        ry_etc_state_default(&s);
        _par_got_fields(&s, 3);
        return 1;
    }
    if (_par_eq(fp, fl, "etc::EtcConfig::default") == 1) {
        if (_par_in_n != 0) { return 0 - 1; }
        ry_etc_config_default(&c);
        _par_got_fields(&c, 14);
        return 1;
    }
    if (_par_eq(fp, fl, "etc::EtcConfig::validate") == 1) {
        if (_par_ec_in(0, &c) != _par_in_n) { return 0 - 1; }
        var tc, vc = ry_etc_config_validate(&c);
        _par_got_outcome(tc, vc);
        return 1;
    }
    if (_par_eq(fp, fl, "etc::EtcConfig::pump_stoichiometry") == 1) {
        if (_par_ec_in(0, &c) != _par_in_n) { return 0 - 1; }
        var ci, ciii, civ = _ry_etc_config_pump_stoichiometry(&c);
        var a: f64 = ci;
        var b: f64 = ciii;
        var d: f64 = civ;
        _par_got_f(a);
        _par_got_f(b);
        _par_got_f(d);
        return 1;
    }
    if (_par_eq(fp, fl, "etc::full_respiration") == 1) { return _par_etc_pipeline(); }
    if (_par_eq(fp, fl, "etc::EtcFlux::accumulate") == 1) {
        if (_par_in_n != 21 || _par_all_f(21) == 0) { return 0 - 1; }
        var o: RyEtcFlux;
        _par_fields_in(0, &fx, 10);
        _par_fields_in(10, &o, 10);
        var weight: f64 = _par_f(20);
        _ry_etc_flux_accumulate(&fx, &o, weight);
        _par_got_fields(&fx, 10);
        return 1;
    }
    if (_par_in_n < 3 || _par_all_f_from(0, 3) == 0) { return _par_etc_json(fp, fl); }
    _par_fields_in(0, &s, 3);
    if (_par_in_n == 3) {
        if (_par_eq(fp, fl, "etc::EtcState::validate") == 1) {
            var ts, vs = ry_etc_state_validate(&s);
            _par_got_outcome(ts, vs);
            return 1;
        }
        return _par_etc_json(fp, fl);
    }
    var k = _par_ec_in(3, &c);
    if (k < 0) { return _par_etc_json(fp, fl); }
    if (_par_eq(fp, fl, "etc::EtcState::complex_i_capacity") == 1) {
        if (_par_in_n != k) { return 0 - 1; }
        var cap: f64 = _ry_etc_state_complex_i_capacity(&s, &c);
        _par_got_f(cap);
        return 1;
    }
    if (_par_eq(fp, fl, "etc::EtcState::trajectory") == 1) {
        if (_par_etc_script(&s, &c, k, &fx) != 1) { return 0 - 1; }
        _par_got_fields(&s, 3);
        _par_got_fields(&fx, 10);
        return 1;
    }
    if (_par_eq(fp, fl, "etc::EtcState::tick") == 1) {
        if (_par_in_n != k + 5 || _par_all_f_from(k, 5) == 0) { return 0 - 1; }
        var nadh: f64 = _par_f(k);
        var fadh2: f64 = _par_f(k + 1);
        var o2: f64 = _par_f(k + 2);
        var adp: f64 = _par_f(k + 3);
        var dt: f64 = _par_f(k + 4);
        ry_etc_state_tick(&s, &c, nadh, fadh2, o2, adp, dt, &fx);
        _par_got_fields(&s, 3);
        _par_got_fields(&fx, 10);
        return 1;
    }
    if (_par_eq(fp, fl, "etc::EtcState::step") == 1) {
        if (_par_in_n != k + 6 || _par_all_f_from(k, 6) == 0) { return 0 - 1; }
        var d: _RyEtcDrive;
        _par_drive_in(k, &d);
        var sdt: f64 = _par_f(k + 5);
        _ry_etc_state_step(&s, &c, &d, sdt, &fx);
        _par_got_fields(&s, 3);
        _par_got_fields(&fx, 10);
        return 1;
    }
    return _par_etc_json(fp, fl);
}

# The serde rows of EtcState, EtcConfig and EtcFlux.
fn _par_etc_json(fp, fl): i64 {
    var s: RyEtcState;
    var c: RyEtcConfig;
    var fx: RyEtcFlux;
    if (_par_jsb == 0) { _par_jsb = str_builder_new(); }
    var sb = _par_jsb;
    store64(sb + 8, 0);
    if (_par_eq(fp, fl, "serde_json::to_string<EtcState>") == 1 && _par_in_n == 3 && _par_all_f(3) == 1) {
        _par_fields_in(0, &s, 3);
        var t1, v1 = ry_etc_state_to_json(sb, &s);
        if (is_err_result(t1) == 1) { return 0 - 1; }
        _par_got_text(load64(sb), load64(sb + 8));
        return 1;
    }
    if (_par_eq(fp, fl, "serde_json::to_string<EtcConfig>") == 1 && _par_in_n == 14 && _par_all_f(14) == 1) {
        _par_fields_in(0, &c, 14);
        var t2, v2 = ry_etc_config_to_json(sb, &c);
        if (is_err_result(t2) == 1) { return 0 - 1; }
        _par_got_text(load64(sb), load64(sb + 8));
        return 1;
    }
    if (_par_eq(fp, fl, "serde_json::to_string<EtcFlux>") == 1 && _par_in_n == 10 && _par_all_f(10) == 1) {
        _par_fields_in(0, &fx, 10);
        var t3, v3 = ry_etc_flux_to_json(sb, &fx);
        if (is_err_result(t3) == 1) { return 0 - 1; }
        _par_got_text(load64(sb), load64(sb + 8));
        return 1;
    }
    var kind = 0;
    if (_par_eq(fp, fl, "serde_json::from_slice<EtcState>") == 1) { kind = 1; }
    if (_par_eq(fp, fl, "serde_json::from_slice<EtcConfig>") == 1) { kind = 2; }
    if (_par_eq(fp, fl, "serde_json::from_slice<EtcFlux>") == 1) { kind = 3; }
    if (kind == 0) { return 0; }
    var lw[8];
    var doc = _par_in_bytes(0, &lw);
    if (doc == 0) { return 0 - 1; }
    var n = load64(&lw);
    if (_par_jarena == 0) { _par_jarena = arena_allocator_growable(65536); }
    _par_json_gap = _par_has_neg_zero_int(doc, n);
    reset_via(_par_jarena);
    if (kind == 1) {
        var t4, v4 = ry_etc_state_from_json_a(_par_jarena, doc, n, &s);
        if (is_err_result(t4) == 1) {
            _par_got_err(v4);
            return 1;
        }
        _par_got_fields(&s, 3);
        return 1;
    }
    if (kind == 2) {
        var t5, v5 = ry_etc_config_from_json_a(_par_jarena, doc, n, &c);
        if (is_err_result(t5) == 1) {
            _par_got_err(v5);
            return 1;
        }
        _par_got_fields(&c, 14);
        return 1;
    }
    var t6, v6 = ry_etc_flux_from_json_a(_par_jarena, doc, n, &fx);
    if (is_err_result(t6) == 1) {
        _par_got_err(v6);
        return 1;
    }
    _par_got_fields(&fx, 10);
    return 1;
}

# ── beta_oxidation ──────────────────────────────────────────────────────────────────
# src/beta_oxidation_data.cyr and src/beta_oxidation.cyr (M4b part 2). A BetaOxState row takes its two pools; a
# BetaOxConfig is the default with overrides, `i:n` then n pairs `i:field <value>` (`i:` for field 0, the u32
# chain_length; `f:` for the five f64). tick takes the state, the config and `f:malonyl_coa f:nad_ratio f:dt` and gives
# the state after and the flux's eight values. A trajectory row (class T) is a script: the state, the config, then
# `i:1 f:malonyl f:nad f:dt i:k` k ticks, `i:3 i:field f:x` a field set. A coupling row (`beta_oxidation::feeds_tca`)
# is Rust's integration loop: the β-oxidation and TCA states, then `f:malonyl f:nad f:atp f:adp f:dt i:k`.

# Reads a β-oxidation config from input k into *c (the default, then the overrides): the index after it, or -1 when
# malformed.
fn _par_bc_in(k, c: *RyBetaOxConfig): i64 {
    ry_beta_ox_config_default(c);
    if (_par_is_i(k) == 0) { return 0 - 1; }
    var n = _par_in(k);
    var w = c;
    var at = k + 1;
    var j = 0;
    while (j < n) {
        if (_par_is_i(at) == 0) { return 0 - 1; }
        var field = _par_in(at);
        if (field == 0) {
            if (_par_is_i(at + 1) == 0) { return 0 - 1; }
        } elif (field < 0 || field >= 6 || _par_is_f(at + 1) == 0) {
            return 0 - 1;
        }
        store64(w + 8 * field, _par_in(at + 1));
        at = at + 2;
        j = j + 1;
    }
    return at;
}

# Replays a β-oxidation trajectory script from input k on *s under *c: 1 with *f the last step's flux, or -1 when
# malformed.
fn _par_box_script(s: *RyBetaOxState, c: *RyBetaOxConfig, k, f: *RyBetaOxFlux): i64 {
    ry_beta_ox_flux_default(f);
    var w = s;
    var at = k;
    while (at < _par_in_n) {
        if (_par_is_i(at) == 0) { return 0 - 1; }
        var op = _par_in(at);
        if (op == 1 && _par_all_f_from(at + 1, 3) == 1 && _par_is_i(at + 4) == 1) {
            var malonyl: f64 = _par_f(at + 1);
            var nad: f64 = _par_f(at + 2);
            var dt: f64 = _par_f(at + 3);
            var n = _par_in(at + 4);
            var j = 0;
            while (j < n) {
                ry_beta_ox_state_tick(s, c, malonyl, nad, dt, f);
                j = j + 1;
            }
            at = at + 5;
        } elif (op == 3 && _par_is_i(at + 1) == 1 && _par_is_f(at + 2) == 1) {
            var field = _par_in(at + 1);
            if (field < 0 || field > 1) { return 0 - 1; }
            store64(w + 8 * field, _par_in(at + 2));
            at = at + 3;
        } else {
            return 0 - 1;
        }
    }
    return 1;
}

# Rust's test_beta_ox_feeds_tca loop (inputs: the two states, then `f:malonyl f:nad f:atp f:adp f:dt i:k`): 1 with the
# two states, the acetyl-CoA sum and the NADH sum as the outputs, or -1 when malformed.
fn _par_box_feeds_tca(): i64 {
    if (_par_in_n != 17 || _par_all_f_from(0, 16) == 0 || _par_is_i(16) == 0) { return 0 - 1; }
    var b: RyBetaOxState;
    var bc: RyBetaOxConfig;
    var bf: RyBetaOxFlux;
    var t: RyTcaState;
    var tc: RyTcaConfig;
    var tf: RyTcaFlux;
    _par_fields_in(0, &b, 2);
    _par_fields_in(2, &t, 9);
    ry_beta_ox_config_default(&bc);
    ry_tca_config_default(&tc);
    var malonyl: f64 = _par_f(11);
    var nad: f64 = _par_f(12);
    var atp: f64 = _par_f(13);
    var adp: f64 = _par_f(14);
    var dt: f64 = _par_f(15);
    var n = _par_in(16);
    var accoa: f64 = 0.0;
    var nadh: f64 = 0.0;
    var k = 0;
    while (k < n) {
        ry_beta_ox_state_tick(&b, &bc, malonyl, nad, dt, &bf);
        var fed: f64 = t.acetyl_coa + bf.acetyl_coa_produced;
        t.acetyl_coa = fed;
        ry_tca_state_tick(&t, &tc, 0.0, atp, adp, nad, dt, &tf);
        accoa = accoa + bf.acetyl_coa_produced;
        nadh = nadh + (bf.nadh_produced + tf.nadh_produced);
        k = k + 1;
    }
    _par_got_fields(&b, 2);
    _par_got_fields(&t, 9);
    _par_got_f(accoa);
    _par_got_f(nadh);
    return 1;
}

# The β-oxidation rows: the defaults, the validators, the chain's counts, accumulate, the steps, trajectories and the
# coupling, the serde rows.
fn _par_beta_oxidation(fp, fl): i64 {
    var s: RyBetaOxState;
    var c: RyBetaOxConfig;
    var fx: RyBetaOxFlux;
    if (_par_eq(fp, fl, "beta_oxidation::BetaOxState::default") == 1) {
        if (_par_in_n != 0) { return 0 - 1; }
        ry_beta_ox_state_default(&s);
        _par_got_fields(&s, 2);
        return 1;
    }
    if (_par_eq(fp, fl, "beta_oxidation::BetaOxConfig::default") == 1) {
        if (_par_in_n != 0) { return 0 - 1; }
        ry_beta_ox_config_default(&c);
        _par_got_i(c.chain_length);
        _par_got_fields(&c + 8, 5);
        return 1;
    }
    if (_par_eq(fp, fl, "beta_oxidation::feeds_tca") == 1) { return _par_box_feeds_tca(); }
    if (_par_eq(fp, fl, "beta_oxidation::BetaOxFlux::accumulate") == 1) {
        if (_par_in_n != 17 || _par_all_f(17) == 0) { return 0 - 1; }
        var o: RyBetaOxFlux;
        _par_fields_in(0, &fx, 8);
        _par_fields_in(8, &o, 8);
        var weight: f64 = _par_f(16);
        _ry_beta_ox_flux_accumulate(&fx, &o, weight);
        _par_got_fields(&fx, 8);
        return 1;
    }
    var k0 = _par_bc_in(0, &c);
    if (k0 == _par_in_n && k0 > 0) {
        if (_par_eq(fp, fl, "beta_oxidation::BetaOxConfig::validate") == 1) {
            var tc, vc = ry_beta_ox_config_validate(&c);
            _par_got_outcome(tc, vc);
            return 1;
        }
        if (_par_eq(fp, fl, "beta_oxidation::BetaOxConfig::cycles") == 1) {
            _par_got_i(ry_beta_ox_config_cycles(&c));
            return 1;
        }
        if (_par_eq(fp, fl, "beta_oxidation::BetaOxConfig::acetyl_coa_per_fa") == 1) {
            _par_got_i(ry_beta_ox_config_acetyl_coa_per_fa(&c));
            return 1;
        }
        if (_par_eq(fp, fl, "beta_oxidation::BetaOxConfig::acetyl_carbon_equivalents") == 1) {
            var eq: f64 = _ry_beta_ox_config_acetyl_carbon_equivalents(&c);
            _par_got_f(eq);
            return 1;
        }
    }
    if (_par_in_n < 2 || _par_all_f_from(0, 2) == 0) { return _par_box_json(fp, fl); }
    _par_fields_in(0, &s, 2);
    if (_par_in_n == 2) {
        if (_par_eq(fp, fl, "beta_oxidation::BetaOxState::validate") == 1) {
            var ts, vs = ry_beta_ox_state_validate(&s);
            _par_got_outcome(ts, vs);
            return 1;
        }
        return _par_box_json(fp, fl);
    }
    var k = _par_bc_in(2, &c);
    if (k < 0) { return _par_box_json(fp, fl); }
    if (_par_eq(fp, fl, "beta_oxidation::BetaOxState::trajectory") == 1) {
        if (_par_box_script(&s, &c, k, &fx) != 1) { return 0 - 1; }
        _par_got_fields(&s, 2);
        _par_got_fields(&fx, 8);
        return 1;
    }
    if (_par_eq(fp, fl, "beta_oxidation::BetaOxState::tick") == 1) {
        if (_par_in_n != k + 3 || _par_all_f_from(k, 3) == 0) { return 0 - 1; }
        var malonyl: f64 = _par_f(k);
        var nad: f64 = _par_f(k + 1);
        var dt: f64 = _par_f(k + 2);
        ry_beta_ox_state_tick(&s, &c, malonyl, nad, dt, &fx);
        _par_got_fields(&s, 2);
        _par_got_fields(&fx, 8);
        return 1;
    }
    return _par_box_json(fp, fl);
}

# The serde rows of BetaOxState, BetaOxConfig and BetaOxFlux.
fn _par_box_json(fp, fl): i64 {
    var s: RyBetaOxState;
    var c: RyBetaOxConfig;
    var fx: RyBetaOxFlux;
    if (_par_jsb == 0) { _par_jsb = str_builder_new(); }
    var sb = _par_jsb;
    store64(sb + 8, 0);
    if (_par_eq(fp, fl, "serde_json::to_string<BetaOxState>") == 1 && _par_in_n == 2 && _par_all_f(2) == 1) {
        _par_fields_in(0, &s, 2);
        var t1, v1 = ry_beta_ox_state_to_json(sb, &s);
        if (is_err_result(t1) == 1) { return 0 - 1; }
        _par_got_text(load64(sb), load64(sb + 8));
        return 1;
    }
    if (_par_eq(fp, fl, "serde_json::to_string<BetaOxConfig>") == 1 && _par_in_n == 6 && _par_is_i(0) == 1
      && _par_all_f_from(1, 5) == 1) {
        c.chain_length = _par_in(0);
        _par_fields_in(1, &c + 8, 5);
        var t2, v2 = ry_beta_ox_config_to_json(sb, &c);
        if (is_err_result(t2) == 1) { return 0 - 1; }
        _par_got_text(load64(sb), load64(sb + 8));
        return 1;
    }
    if (_par_eq(fp, fl, "serde_json::to_string<BetaOxFlux>") == 1 && _par_in_n == 8 && _par_all_f(8) == 1) {
        _par_fields_in(0, &fx, 8);
        var t3, v3 = ry_beta_ox_flux_to_json(sb, &fx);
        if (is_err_result(t3) == 1) { return 0 - 1; }
        _par_got_text(load64(sb), load64(sb + 8));
        return 1;
    }
    var kind = 0;
    if (_par_eq(fp, fl, "serde_json::from_slice<BetaOxState>") == 1) { kind = 1; }
    if (_par_eq(fp, fl, "serde_json::from_slice<BetaOxConfig>") == 1) { kind = 2; }
    if (_par_eq(fp, fl, "serde_json::from_slice<BetaOxFlux>") == 1) { kind = 3; }
    if (kind == 0) { return 0; }
    var lw[8];
    var doc = _par_in_bytes(0, &lw);
    if (doc == 0) { return 0 - 1; }
    var n = load64(&lw);
    if (_par_jarena == 0) { _par_jarena = arena_allocator_growable(65536); }
    _par_json_gap = _par_has_neg_zero_int(doc, n);
    reset_via(_par_jarena);
    if (kind == 1) {
        var t4, v4 = ry_beta_ox_state_from_json_a(_par_jarena, doc, n, &s);
        if (is_err_result(t4) == 1) {
            _par_got_err(v4);
            return 1;
        }
        _par_got_fields(&s, 2);
        return 1;
    }
    if (kind == 2) {
        var t5, v5 = ry_beta_ox_config_from_json_a(_par_jarena, doc, n, &c);
        if (is_err_result(t5) == 1) {
            _par_got_err(v5);
            return 1;
        }
        _par_got_i(c.chain_length);
        _par_got_fields(&c + 8, 5);
        return 1;
    }
    var t6, v6 = ry_beta_ox_flux_from_json_a(_par_jarena, doc, n, &fx);
    if (is_err_result(t6) == 1) {
        _par_got_err(v6);
        return 1;
    }
    _par_got_fields(&fx, 8);
    return 1;
}

# ── amino_catabolism ────────────────────────────────────────────────────────────────
# src/amino_catabolism_data.cyr and src/amino_catabolism.cyr (M4b part 3). A CarbonSkeletonOutput row takes its six
# fractions; an AminoCatabState row its three pools; an AminoCatabConfig is the default with overrides, `i:n` then n
# pairs `i:field f:x` over the config flattened in declaration order (0–3, the routing's six at 4–9, 10–12: the
# struct's own memory order). tick takes the state, the config and `f:alpha_kg f:nad_ratio f:dt` and gives the state
# after and the flux's twelve values. A trajectory row (class T) is a script: the state, the config, then `i:1 f:akg
# f:nad f:dt i:k` k ticks, `i:3 i:field f:x` a field set. A coupling row (`amino_catabolism::feeds_tca`) is Rust's
# integration loop: the amino-acid and TCA states, then `f:nad f:atp f:adp f:dt i:k`.

# Reads an amino-acid config from input k into *c (the default, then the overrides): the index after it, or -1 when
# malformed.
fn _par_ac_in(k, c: *RyAminoCatabConfig): i64 {
    ry_amino_catab_config_default(c);
    if (_par_is_i(k) == 0) { return 0 - 1; }
    var n = _par_in(k);
    var w = c;
    var at = k + 1;
    var j = 0;
    while (j < n) {
        if (_par_is_i(at) == 0 || _par_is_f(at + 1) == 0) { return 0 - 1; }
        var field = _par_in(at);
        if (field < 0 || field >= 13) { return 0 - 1; }
        store64(w + 8 * field, _par_in(at + 1));
        at = at + 2;
        j = j + 1;
    }
    return at;
}

# Replays an amino-acid trajectory script from input k on *s under *c: 1 with *f the last step's flux, or -1 when
# malformed.
fn _par_amino_script(s: *RyAminoCatabState, c: *RyAminoCatabConfig, k, f: *RyAminoCatabFlux): i64 {
    ry_amino_catab_flux_default(f);
    var w = s;
    var at = k;
    while (at < _par_in_n) {
        if (_par_is_i(at) == 0) { return 0 - 1; }
        var op = _par_in(at);
        if (op == 1 && _par_all_f_from(at + 1, 3) == 1 && _par_is_i(at + 4) == 1) {
            var akg: f64 = _par_f(at + 1);
            var nad: f64 = _par_f(at + 2);
            var dt: f64 = _par_f(at + 3);
            var n = _par_in(at + 4);
            var j = 0;
            while (j < n) {
                ry_amino_catab_state_tick(s, c, akg, nad, dt, f);
                j = j + 1;
            }
            at = at + 5;
        } elif (op == 3 && _par_is_i(at + 1) == 1 && _par_is_f(at + 2) == 1) {
            var field = _par_in(at + 1);
            if (field < 0 || field > 2) { return 0 - 1; }
            store64(w + 8 * field, _par_in(at + 2));
            at = at + 3;
        } else {
            return 0 - 1;
        }
    }
    return 1;
}

# Rust's test_amino_catab_feeds_tca loop (inputs: the two states, then `f:nad f:atp f:adp f:dt i:k`): 1 with the two
# states as the outputs, or -1 when malformed.
fn _par_amino_feeds_tca(): i64 {
    if (_par_in_n != 17 || _par_all_f_from(0, 16) == 0 || _par_is_i(16) == 0) { return 0 - 1; }
    var a: RyAminoCatabState;
    var ac: RyAminoCatabConfig;
    var af: RyAminoCatabFlux;
    var t: RyTcaState;
    var tc: RyTcaConfig;
    var tf: RyTcaFlux;
    _par_fields_in(0, &a, 3);
    _par_fields_in(3, &t, 9);
    ry_amino_catab_config_default(&ac);
    ry_tca_config_default(&tc);
    var nad: f64 = _par_f(12);
    var atp: f64 = _par_f(13);
    var adp: f64 = _par_f(14);
    var dt: f64 = _par_f(15);
    var n = _par_in(16);
    var k = 0;
    while (k < n) {
        var akg: f64 = t.alpha_kg;
        ry_amino_catab_state_tick(&a, &ac, akg, nad, dt, &af);
        var accoa: f64 = t.acetyl_coa + af.to_acetyl_coa;
        var oaa: f64 = t.oxaloacetate + af.to_oxaloacetate;
        var ak: f64 = t.alpha_kg + af.to_alpha_kg;
        var sc: f64 = t.succinyl_coa + af.to_succinyl_coa;
        var fu: f64 = t.fumarate + af.to_fumarate;
        t.acetyl_coa = accoa;
        t.oxaloacetate = oaa;
        t.alpha_kg = ak;
        t.succinyl_coa = sc;
        t.fumarate = fu;
        var pyr: f64 = af.to_pyruvate;
        ry_tca_state_tick(&t, &tc, pyr, atp, adp, nad, dt, &tf);
        k = k + 1;
    }
    _par_got_fields(&a, 3);
    _par_got_fields(&t, 9);
    return 1;
}

# The amino-acid rows: the defaults, the routing, the validators, accumulate, the steps, trajectories and the
# coupling, the serde rows.
fn _par_amino_catabolism(fp, fl): i64 {
    var r: RyCarbonSkeletonOutput;
    var s: RyAminoCatabState;
    var c: RyAminoCatabConfig;
    var fx: RyAminoCatabFlux;
    if (_par_eq(fp, fl, "amino_catabolism::CarbonSkeletonOutput::default") == 1) {
        if (_par_in_n != 0) { return 0 - 1; }
        ry_carbon_skeleton_output_default(&r);
        _par_got_fields(&r, 6);
        return 1;
    }
    if (_par_eq(fp, fl, "amino_catabolism::AminoCatabState::default") == 1) {
        if (_par_in_n != 0) { return 0 - 1; }
        ry_amino_catab_state_default(&s);
        _par_got_fields(&s, 3);
        return 1;
    }
    if (_par_eq(fp, fl, "amino_catabolism::AminoCatabConfig::default") == 1) {
        if (_par_in_n != 0) { return 0 - 1; }
        ry_amino_catab_config_default(&c);
        _par_got_fields(&c, 13);
        return 1;
    }
    if (_par_eq(fp, fl, "amino_catabolism::AminoCatabConfig::validate") == 1) {
        if (_par_ac_in(0, &c) != _par_in_n) { return 0 - 1; }
        var tc, vc = ry_amino_catab_config_validate(&c);
        _par_got_outcome(tc, vc);
        return 1;
    }
    if (_par_eq(fp, fl, "amino_catabolism::feeds_tca") == 1) { return _par_amino_feeds_tca(); }
    if (_par_eq(fp, fl, "amino_catabolism::AminoCatabFlux::accumulate") == 1) {
        if (_par_in_n != 25 || _par_all_f(25) == 0) { return 0 - 1; }
        var o: RyAminoCatabFlux;
        _par_fields_in(0, &fx, 12);
        _par_fields_in(12, &o, 12);
        var weight: f64 = _par_f(24);
        _ry_amino_catab_flux_accumulate(&fx, &o, weight);
        _par_got_fields(&fx, 12);
        return 1;
    }
    if (_par_in_n == 6 && _par_all_f(6) == 1) {
        _par_fields_in(0, &r, 6);
        if (_par_eq(fp, fl, "amino_catabolism::CarbonSkeletonOutput::total") == 1) {
            var tot: f64 = ry_carbon_skeleton_output_total(&r);
            _par_got_f(tot);
            return 1;
        }
        if (_par_eq(fp, fl, "amino_catabolism::CarbonSkeletonOutput::validate") == 1) {
            var tr, vr = ry_carbon_skeleton_output_validate(&r);
            _par_got_outcome(tr, vr);
            return 1;
        }
    }
    if (_par_in_n < 3 || _par_all_f_from(0, 3) == 0) { return _par_amino_json(fp, fl); }
    _par_fields_in(0, &s, 3);
    if (_par_in_n == 3) {
        if (_par_eq(fp, fl, "amino_catabolism::AminoCatabState::validate") == 1) {
            var ts, vs = ry_amino_catab_state_validate(&s);
            _par_got_outcome(ts, vs);
            return 1;
        }
        return _par_amino_json(fp, fl);
    }
    var k = _par_ac_in(3, &c);
    if (k < 0) { return _par_amino_json(fp, fl); }
    if (_par_eq(fp, fl, "amino_catabolism::AminoCatabState::trajectory") == 1) {
        if (_par_amino_script(&s, &c, k, &fx) != 1) { return 0 - 1; }
        _par_got_fields(&s, 3);
        _par_got_fields(&fx, 12);
        return 1;
    }
    if (_par_eq(fp, fl, "amino_catabolism::AminoCatabState::tick") == 1) {
        if (_par_in_n != k + 3 || _par_all_f_from(k, 3) == 0) { return 0 - 1; }
        var akg: f64 = _par_f(k);
        var nad: f64 = _par_f(k + 1);
        var dt: f64 = _par_f(k + 2);
        ry_amino_catab_state_tick(&s, &c, akg, nad, dt, &fx);
        _par_got_fields(&s, 3);
        _par_got_fields(&fx, 12);
        return 1;
    }
    return _par_amino_json(fp, fl);
}

# The serde rows of CarbonSkeletonOutput, AminoCatabState, AminoCatabConfig and AminoCatabFlux.
fn _par_amino_json(fp, fl): i64 {
    var r: RyCarbonSkeletonOutput;
    var s: RyAminoCatabState;
    var c: RyAminoCatabConfig;
    var fx: RyAminoCatabFlux;
    if (_par_jsb == 0) { _par_jsb = str_builder_new(); }
    var sb = _par_jsb;
    store64(sb + 8, 0);
    var wrote = 0;
    if (_par_eq(fp, fl, "serde_json::to_string<CarbonSkeletonOutput>") == 1 && _par_in_n == 6 && _par_all_f(6) == 1) {
        _par_fields_in(0, &r, 6);
        var t1, v1 = ry_carbon_skeleton_output_to_json(sb, &r);
        if (is_err_result(t1) == 1) { return 0 - 1; }
        wrote = 1;
    }
    if (_par_eq(fp, fl, "serde_json::to_string<AminoCatabState>") == 1 && _par_in_n == 3 && _par_all_f(3) == 1) {
        _par_fields_in(0, &s, 3);
        var t2, v2 = ry_amino_catab_state_to_json(sb, &s);
        if (is_err_result(t2) == 1) { return 0 - 1; }
        wrote = 1;
    }
    if (_par_eq(fp, fl, "serde_json::to_string<AminoCatabConfig>") == 1 && _par_in_n == 13 && _par_all_f(13) == 1) {
        _par_fields_in(0, &c, 13);
        var t3, v3 = ry_amino_catab_config_to_json(sb, &c);
        if (is_err_result(t3) == 1) { return 0 - 1; }
        wrote = 1;
    }
    if (_par_eq(fp, fl, "serde_json::to_string<AminoCatabFlux>") == 1 && _par_in_n == 12 && _par_all_f(12) == 1) {
        _par_fields_in(0, &fx, 12);
        var t4, v4 = ry_amino_catab_flux_to_json(sb, &fx);
        if (is_err_result(t4) == 1) { return 0 - 1; }
        wrote = 1;
    }
    if (wrote == 1) {
        _par_got_text(load64(sb), load64(sb + 8));
        return 1;
    }
    var kind = 0;
    if (_par_eq(fp, fl, "serde_json::from_slice<CarbonSkeletonOutput>") == 1) { kind = 1; }
    if (_par_eq(fp, fl, "serde_json::from_slice<AminoCatabState>") == 1) { kind = 2; }
    if (_par_eq(fp, fl, "serde_json::from_slice<AminoCatabConfig>") == 1) { kind = 3; }
    if (_par_eq(fp, fl, "serde_json::from_slice<AminoCatabFlux>") == 1) { kind = 4; }
    if (kind == 0) { return 0; }
    var lw[8];
    var doc = _par_in_bytes(0, &lw);
    if (doc == 0) { return 0 - 1; }
    var n = load64(&lw);
    if (_par_jarena == 0) { _par_jarena = arena_allocator_growable(65536); }
    _par_json_gap = _par_has_neg_zero_int(doc, n);
    reset_via(_par_jarena);
    if (kind == 1) {
        var t5, v5 = ry_carbon_skeleton_output_from_json_a(_par_jarena, doc, n, &r);
        if (is_err_result(t5) == 1) {
            _par_got_err(v5);
            return 1;
        }
        _par_got_fields(&r, 6);
        return 1;
    }
    if (kind == 2) {
        var t6, v6 = ry_amino_catab_state_from_json_a(_par_jarena, doc, n, &s);
        if (is_err_result(t6) == 1) {
            _par_got_err(v6);
            return 1;
        }
        _par_got_fields(&s, 3);
        return 1;
    }
    if (kind == 3) {
        var t7, v7 = ry_amino_catab_config_from_json_a(_par_jarena, doc, n, &c);
        if (is_err_result(t7) == 1) {
            _par_got_err(v7);
            return 1;
        }
        _par_got_fields(&c, 13);
        return 1;
    }
    var t8, v8 = ry_amino_catab_flux_from_json_a(_par_jarena, doc, n, &fx);
    if (is_err_result(t8) == 1) {
        _par_got_err(v8);
        return 1;
    }
    _par_got_fields(&fx, 12);
    return 1;
}

fn _par_dispatch(mp, ml, fp, fl): i64 {
    _par_got_n = 0;
    if (_par_eq(fp, fl, "const") == 1) { return _par_const(); }
    if (_par_eq(mp, ml, "math") == 1) { return _par_math(fp, fl); }
    if (_par_eq(mp, ml, "protein") == 1) { return _par_protein(fp, fl); }
    if (_par_eq(mp, ml, "alignment") == 1) { return _par_alignment(fp, fl); }
    if (_par_eq(mp, ml, "ptm") == 1) { return _par_ptm(fp, fl); }
    if (_par_eq(mp, ml, "domain") == 1) { return _par_domain(fp, fl); }
    if (_par_eq(mp, ml, "glycolysis") == 1) { return _par_glycolysis(fp, fl); }
    if (_par_eq(mp, ml, "tca") == 1) { return _par_tca(fp, fl); }
    if (_par_eq(mp, ml, "etc") == 1) { return _par_etc(fp, fl); }
    if (_par_eq(mp, ml, "beta_oxidation") == 1) { return _par_beta_oxidation(fp, fl); }
    if (_par_eq(mp, ml, "amino_catabolism") == 1) { return _par_amino_catabolism(fp, fl); }
    if (_par_eq(mp, ml, "enzyme") == 1) { return _par_enzyme(fp, fl); }
    if (_par_eq(mp, ml, "membrane") == 1) { return _par_membrane(fp, fl); }
    if (_par_eq(mp, ml, "signal") == 1) { return _par_signal(fp, fl); }
    if (_par_eq(mp, ml, "metabolism") == 1) { return _par_metabolism(fp, fl); }
    if (_par_eq(mp, ml, "energy") == 1) { return _par_energy(fp, fl); }
    if (_par_eq(mp, ml, "guard") == 1) { return _par_guard(fp, fl); }
    if (_par_eq(mp, ml, "integrate") == 1) { return _par_integrate(fp, fl); }
    if (_par_eq(mp, ml, "logging") == 1) { return _par_logging(fp, fl); }
    if (_par_eq(mp, ml, "json") == 1) { return _par_json(fp, fl); }
    return 0;
}

# Shadow comparisons, never gated: the same golden rows through the stdlib candidates the port's functions replace,
# against the same reference (the corrected oracle where it has the row). A shadow line's name is not its row's
# function, so it has no class-C bound and its class-C rows stay measured (they are not counted in the summary):
# - exp / ln: the builtins (x87 on x86_64, the polyfills on aarch64) and the polyfills (the same bits on every
#   target); powf as ganita's pow; exp_m1 as ganita's private `_gn_expm1` (the stdlib's only expm1; ganita is a
#   test-only stdlib dependency for these): the stdlib baseline of port-parity.md §2c, beside ADR 0003's primitives;
# - the stdlib's f64_max / f64_min / f64_clamp and f64_to that the port's helpers stand in for, to show where their
#   semantics differ from Rust's (port-parity.md §0.1, §0.6).
fn _par_shadows(mp, ml, fp, fl, cls) {
    if (_par_eq(mp, ml, "math") != 1) { return 0; }
    var x: f64 = _par_in(0);
    if (_par_eq(fp, fl, "f64::exp") == 1) {
        _par_got_n = 0;
        var rb: f64 = f64_exp(x);
        _par_got_f(rb);
        _par_shadow_record("f64::exp ~ f64_exp builtin", cls);
        _par_got_n = 0;
        var r: f64 = _f64_exp_polyfill(x);
        _par_got_f(r);
        _par_shadow_record("f64::exp ~ _f64_exp_polyfill", cls);
        return 0;
    }
    if (_par_eq(fp, fl, "f64::ln") == 1) {
        _par_got_n = 0;
        var rb: f64 = f64_ln(x);
        _par_got_f(rb);
        _par_shadow_record("f64::ln ~ f64_ln builtin", cls);
        _par_got_n = 0;
        var r: f64 = _f64_ln_polyfill(x);
        _par_got_f(r);
        _par_shadow_record("f64::ln ~ _f64_ln_polyfill", cls);
        return 0;
    }
    if (_par_eq(fp, fl, "f64::exp_m1") == 1) {
        _par_got_n = 0;
        var r: f64 = _gn_expm1(x);
        _par_got_f(r);
        _par_shadow_record("f64::exp_m1 ~ _gn_expm1", cls);
        return 0;
    }
    if (_par_eq(fp, fl, "f64::as_u32") == 1) {
        _par_got_n = 0;
        _par_got_i(f64_to(x));
        _par_shadow_record("f64::as_u32 ~ f64_to", cls);
        return 0;
    }
    if (_par_in_n < 2 || load64(_par_in_k + 8) != 102) { return 0; }
    var y: f64 = _par_in(1);
    if (_par_eq(fp, fl, "f64::powf") == 1) {
        _par_got_n = 0;
        var r: f64 = ganita_f64_pow(x, y);
        _par_got_f(r);
        _par_shadow_record("f64::powf ~ ganita_f64_pow", cls);
        return 0;
    }
    if (_par_eq(fp, fl, "f64::max") == 1) {
        _par_got_n = 0;
        var r: f64 = f64_max(x, y);
        _par_got_f(r);
        _par_shadow_record("f64::max ~ f64_max", cls);
        return 0;
    }
    if (_par_eq(fp, fl, "f64::min") == 1) {
        _par_got_n = 0;
        var r: f64 = f64_min(x, y);
        _par_got_f(r);
        _par_shadow_record("f64::min ~ f64_min", cls);
        return 0;
    }
    if (_par_eq(fp, fl, "f64::clamp") == 1 && _par_in_n == 3) {
        _par_got_n = 0;
        var hi: f64 = _par_in(2);
        var r: f64 = f64_clamp(x, y, hi);
        _par_got_f(r);
        _par_shadow_record("f64::clamp ~ f64_clamp", cls);
        return 0;
    }
    return 0;
}

# The class-C bound for a function, in ulps; -1 when none is set (the rows are measured). Under ADR 0003 every
# class-C function runs on its correctly rounded primitive (src/mathx.cyr) and is compared at 0 ulp against the
# corrected oracle. A shadow line (`fn ~ candidate`) is no function here, so it stays measured, never gated.
#must_use
fn _par_c_bound(fp, fl): i64 {
    if (_par_eq(fp, fl, "f64::exp") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::exp_m1") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::ln") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::powf") == 1) { return 0; }
    if (_par_eq(fp, fl, "integrate::step_factors") == 1) { return 0; }
    if (_par_eq(fp, fl, "integrate::relax") == 1) { return 0; }
    if (_par_eq(fp, fl, "integrate::produce_decay") == 1) { return 0; }
    if (_par_eq(fp, fl, "integrate::activate") == 1) { return 0; }
    if (_par_eq(fp, fl, "enzyme::hill_equation") == 1) { return 0; }
    if (_par_eq(fp, fl, "enzyme::q10_rate") == 1) { return 0; }
    if (_par_eq(fp, fl, "enzyme::arrhenius") == 1) { return 0; }
    if (_par_eq(fp, fl, "enzyme::arrhenius_relative") == 1) { return 0; }
    if (_par_eq(fp, fl, "enzyme::EnzymeParams::rate") == 1) { return 0; }
    if (_par_eq(fp, fl, "membrane::nernst") == 1) { return 0; }
    if (_par_eq(fp, fl, "membrane::goldman") == 1) { return 0; }
    if (_par_eq(fp, fl, "membrane::IonicState::resting_potential") == 1) { return 0; }
    if (_par_eq(fp, fl, "signal::dose_response") == 1) { return 0; }
    if (_par_eq(fp, fl, "signal::SecondMessenger::tick") == 1) { return 0; }
    if (_par_eq(fp, fl, "metabolism::MetabolicState::regenerate_atp") == 1) { return 0; }
    if (_par_eq(fp, fl, "energy::BioenergyState::tick") == 1) { return 0; }
    if (_par_eq(fp, fl, "sharira::MetabolicCoupling::tick") == 1) { return 0; }
    if (_par_eq(fp, fl, "protein::net_charge") == 1) { return 0; }
    if (_par_eq(fp, fl, "protein::net_charge_with") == 1) { return 0; }
    if (_par_eq(fp, fl, "protein::isoelectric_point") == 1) { return 0; }
    if (_par_eq(fp, fl, "protein::isoelectric_point_with") == 1) { return 0; }
    if (_par_eq(fp, fl, "glycolysis::GlycolysisState::tick") == 1) { return 0; }
    if (_par_eq(fp, fl, "glycolysis::GlycolysisState::tick_regulated") == 1) { return 0; }
    if (_par_eq(fp, fl, "tca::TcaState::tick") == 1) { return 0; }
    return 0 - 1;
}

# The ADR accepting a divergent row (function and raw input field), or 0. The ADR 0002 rows arrive with their
# modules (port plan §3.3). Row 8: a RASAYAN_LOG form (or default) the port refuses takes the default, with a warning,
# where Rust reads it as a directive the port doesn't carry.
#must_use
fn _par_accepted(fp, fl, ip, il): i64 {
    if (_par_json_gap == 1 && fl > 22 && memeq(fp, "serde_json::from_slice", 22) == 1) {
        _par_json_acc = _par_json_acc + 1;
        return 4;
    }
    if (_par_log_refused == 1 && fl > 9 && memeq(fp, "logging::", 9) == 1) {
        _par_log_acc = _par_log_acc + 1;
        return 2;
    }
    return 0;
}

# ADR 0002's accepted rows (the refused RASAYAN_LOG forms, each 20 tokens) are counted on their function's line and
# summed after the module, not printed one by one.
#must_use
fn _par_accepted_quiet(adr): i64 {
    if (adr == 2) { return 1; }
    return 0;
}

# Every printed accepted row gets its bit pair.
#must_use
fn _par_accepted_bits(adr): i64 {
    return 1;
}

# After the logging module: how many refused forms ADR 0002 row 8 accepts.
fn _par_module_done(mp, ml) {
    if (_par_eq(mp, ml, "json") == 1) {
        print("  ADR 0004 (bayan's filed gaps): ", 33);
        fmt_int(_par_json_acc);
        println(" reader rows: a repeated or deep unread member, an integer past i64, a lone surrogate, an integer -0");
        return 0;
    }
    if (_par_eq(mp, ml, "logging") != 1) { return 0; }
    print("  ADR 0002 row 8: ", 18);
    fmt_int(_par_log_acc);
    println(" forms the port refuses (the default applies) where Rust reads a directive it doesn't carry");
    return 0;
}

# rasayan has one harness: no module is skipped.
#must_use
fn _par_skip(mp, ml): i64 {
    return 0;
}

_par_tables_init();
var exit_code = _par_main();
sys_exit_group(exit_code);
