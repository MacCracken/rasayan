        } elif (_par_eq(fp, fl, "metabolism::MetabolicState::energy_charge") == 1) {
            r = ry_metabolic_state_energy_charge(&m);
        } elif (_par_eq(fp, fl, "metabolism::MetabolicState::aerobic_atp_yield") == 1) {
            r = ry_metabolic_state_aerobic_atp_yield(&m);
        } elif (_par_eq(fp, fl, "metabolism::MetabolicState::metabolic_rate") == 1) {
