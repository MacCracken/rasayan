# parity.tcyr — replays the golden corpus (tests/golden/*.tsv) against the port.
#
# Port plan §4 step 7, adapted from ushma's tests/parity.tcyr (kimiya's, itself tanmatra's). Format and comparison
# rules: scripts/oracle/README.md. The module list is tests/golden/modules.txt, which the generator writes. The replay
# machinery is tests/parity_core.cyr and tests/ulp.cyr; this file holds the dispatchers. The math rows run on
# src/mathx.cyr (the correctly rounded primitives and the Rust-semantics helpers).
#
# Every row of every module is one of:
# - ok: every output matched within its class (A bit-identical, NaN matching any NaN; B <= 2 ulp; C 0 ulp against
#   the corrected oracle once a bound is set; D relative <= 1e-12; a zero carries the oracle's sign in every class);
# - FAILED: an output differs; the first 10 per module are printed with the row's note and both bit patterns;
# - measured: class C, with no bound set yet for its function. The ulp distance from the corrected oracle
#   (tests/golden/math.cr.tsv where it has the row, else the golden row) is recorded but not gated. None since M0
#   part 2c-2: every class-C function has its bound (docs/development/port-parity.md §2d);
# - accepted: a divergence an ADR accepts (_par_accepted), or a pass against the ADR 0003 corrected oracle (a row
#   glibc misrounds, where the port gives the correctly rounded value); a port value equal to glibc's misrounded one
#   on such a row FAILS, and is also counted as glibc-matching;
# - pending: its module or function has no Cyrius code yet (no dispatcher entry).
#
# Per function it prints the row counts and the ulp histogram. Shadow lines (`fn ~ candidate`) compare the same rows
# against another Cyrius candidate and are never gated. The exit code is the number of modules with a failure (at
# most a handful, so the 8-bit exit status can't wrap).
#
# What is wired up at M1 part 1:
# - `const` rows of every module: src/constants.cyr, src/constants_private.cyr and the scalar consts of the
#   generated data files, by Rust name;
# - the table rows (protein, alignment, enzyme, membrane): answered from the generated src/*_data.cyr columns. A row
#   of a lookup over a table (`protein::lookup`, `enzyme::lookup_enzyme`, `alignment::substitution_score`) applies
#   the Rust function's rule to the generated data here, so every cell is compared through the oracle's API; at M2
#   and M3 those rows move to the ported `ry_*` functions;
# - `math` rows: classes A and B on the builtins (abs, ceil, sqrt), src/mathx.cyr's Rust-semantics helpers and
#   _ry_clamp and _ry_f64_to_u32 (in src/mathx.cyr since M1); class C (powf, exp, ln, exp_m1) on src/mathx.cyr's
#   correctly rounded primitives, at 0 ulp against the corrected oracle (ADR 0003). The stdlib's counterparts stay as
#   ungated shadow lines;
# - `guard` rows (M1): src/guard.cyr's validators (the error code, by Rust variant name, through src/error.cyr) and
#   sanitizers, class A;
# - `integrate` rows (M1): src/integrate.cyr, class B on the series branch and class C on the exp_m1 branch, at 0 ulp
#   against the corrected oracle (tests/golden/integrate.cr.tsv);
# - `logging` rows (M1 part 2): the level each rasayan event target gets from RASAYAN_LOG and the default
#   (src/logging.cyr's ry_log_level_of), class A; a form the port refuses takes the default, and where Rust's level
#   differs the row is accepted under ADR 0002 row 8.

include "tests/ulp.cyr"
include "src/constants.cyr"
include "src/constants_private.cyr"
include "src/mathx_data.cyr"
include "src/mathx.cyr"
include "src/protein_data.cyr"
include "src/alignment_data.cyr"
include "src/enzyme_data.cyr"
include "src/membrane_data.cyr"
include "src/ai_data.cyr"
include "src/fmtf.cyr"
include "src/error.cyr"
include "src/guard.cyr"
include "src/integrate.cyr"
include "src/logging.cyr"

alloc_init();

include "tests/parity_core.cyr"

# The Rust variant name of an error code (src/error.cyr).
#must_use
fn _par_error_name(code): i64 {
    return ry_error_name(code);
}

# ── inputs ──────────────────────────────────────────────────────────────────────────

# Input token k, an `s:` token, decoded into a fresh buffer (a NUL byte allowed, unlike _par_in_cstr); its length goes
# to *lenp. 0 if the token is no `s:` token or an escape is malformed.
fn _par_in_bytes(k, lenp): i64 {
    var at = k * 8;
    if (k >= _par_in_n || load64(_par_in_k + at) != 115) { return 0; }
    var p = load64(_par_in_v + at);
    var len = load64(_par_in_l + at);
    var out = alloc(len + 1);
    if (out == 0) { return 0; }
    var n = 0;
    var j = 0;
    while (j < len) {
        var c = load8(p + j);
        if (c == 37) {
            if (j + 2 >= len) { return 0; }
            var hi = _par_hex_upper(load8(p + j + 1));
            var lo = _par_hex_upper(load8(p + j + 2));
            if (hi < 0 || lo < 0) { return 0; }
            c = hi * 16 + lo;
            j = j + 3;
        } else {
            j = j + 1;
        }
        store8(out + n, c);
        n = n + 1;
    }
    store64(lenp, n);
    return out;
}

# Input token k as a Rust `char`: its byte when it is one ASCII character, 256 for any other character (a non-ASCII
# char is two to four UTF-8 bytes, and no rasayan table holds one), -1 for no `s:` token or an empty one.
fn _par_in_char(k): i64 {
    var lw[8];
    var p = _par_in_bytes(k, &lw);
    if (p == 0) { return 0 - 1; }
    var n = load64(&lw);
    if (n == 0) { return 0 - 1; }
    if (n == 1 && load8(p) < 128) { return load8(p); }
    return 256;
}

# Input token k as a row index into a table of `count` rows, or -1 when it is no `i:` token or out of range.
#must_use
fn _par_in_index(k, count): i64 {
    if (k >= _par_in_n || load64(_par_in_k + k * 8) != 105) { return 0 - 1; }
    var r = _par_in(k);
    if (r < 0 || r >= count) { return 0 - 1; }
    return r;
}

# ── outputs ─────────────────────────────────────────────────────────────────────────

# Appends a `char` result (`s:` with its one byte).
fn _par_got_char(c) {
    var b[8];
    store8(&b, c);
    _par_got_text(&b, 1);
    return 0;
}

# Row i's C string in a NUL-terminated blob: the blob plus the row's offset.
#must_use
fn _par_blob(bytes, off): i64 {
    return bytes + off;
}

# Appends a NUL-terminated string result.
fn _par_got_cstr(p) {
    _par_got_text(p, strlen(p));
    return 0;
}

# ── const rows ──────────────────────────────────────────────────────────────────────
# `const` rows of any module (input `s:<module>::<NAME>`, fn-local consts `<module>::<fn>::<NAME>`), by the naming
# rule of scripts/oracle/README.md: a constants.tsv row is a public `RY_` const of src/constants.cyr; the others are
# the private `_RY_<MODULE>_<NAME>` consts of src/constants_private.cyr and the data files. An unknown name is a defect
# (-1, so the row fails).

# 1, appending the f64 x, when [np, np + nl) is `name`.
fn _par_cf(np, nl, name, x: f64): i64 {
    if (_par_eq(np, nl, name) != 1) { return 0; }
    _par_got_f(x);
    return 1;
}

# 1, appending the integer v, when [np, np + nl) is `name`.
fn _par_ci(np, nl, name, v): i64 {
    if (_par_eq(np, nl, name) != 1) { return 0; }
    _par_got_i(v);
    return 1;
}

# One `const` row.
fn _par_const(): i64 {
    if (_par_in_n != 1 || load64(_par_in_k) != 115) { return 0 - 1; }
    var np = load64(_par_in_v);
    var nl = load64(_par_in_l);
    # constants.tsv (67)
    if (_par_cf(np, nl, "calcium::SUBSTEP_MAX_DT", RY_CALCIUM_SUBSTEP_MAX_DT) == 1) { return 1; }
    if (_par_ci(np, nl, "calcium::MAX_SUBSTEPS", RY_CALCIUM_MAX_SUBSTEPS) == 1) { return 1; }
    if (_par_cf(np, nl, "calcium::ER_CA_REFERENCE", RY_CALCIUM_ER_CA_REFERENCE) == 1) { return 1; }
    if (_par_cf(np, nl, "calcium::ER_CYTOSOL_VOLUME_RATIO", RY_CALCIUM_ER_CYTOSOL_VOLUME_RATIO) == 1) { return 1; }
    if (_par_cf(np, nl, "calcium::SOCE_MAX", RY_CALCIUM_SOCE_MAX) == 1) { return 1; }
