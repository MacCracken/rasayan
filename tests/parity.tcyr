# ── metabolism ──────────────────────────────────────────────────────────────────────
# src/metabolism_data.cyr and src/metabolism.cyr (M2 part 4). A MetabolicState row takes the state's six fields (atp,
# adp, nad_ratio, glucose, oxygen, lactate), then the method's argument. A trajectory row (class T) is a script: the
# state, then `i:1 f:x` consume_atp, `i:2 f:dt i:k` k regenerations, `i:3 i:field f:x` a field set.

# Replays a trajectory script from input 6 on *m: 1, or -1 for a malformed script.
fn _par_mt_script(m: *RyMetabolicState): i64 {
    var w = m;
    var k = 6;
    while (k < _par_in_n) {
        if (load64(_par_in_k + k * 8) != 105) { return 0 - 1; }
        var op = _par_in(k);
        if (op == 1 && _par_is_f(k + 1) == 1) {
            var x: f64 = _par_f(k + 1);
            var c: f64 = ry_metabolic_state_consume_atp(m, x);
            k = k + 2;
        } elif (op == 2 && _par_is_f(k + 1) == 1 && k + 2 < _par_in_n && load64(_par_in_k + (k + 2) * 8) == 105) {
            var dt: f64 = _par_f(k + 1);
            var n = _par_in(k + 2);
            var j = 0;
            while (j < n) {
                ry_metabolic_state_regenerate_atp(m, dt);
                j = j + 1;
            }
            k = k + 3;
        } elif (op == 3 && k + 2 < _par_in_n && load64(_par_in_k + (k + 1) * 8) == 105 && _par_is_f(k + 2) == 1) {
            var field = _par_in(k + 1);
            if (field < 0 || field > 5) { return 0 - 1; }
            store64(w + 8 * field, _par_in(k + 2));
            k = k + 3;
        } else {
            return 0 - 1;
        }
    }
    return 1;
}

