# parity_math.cyr — the two Rust-semantics helpers ushma's mathx has no counterpart of, for the harness's math rows.
#
# Test-side until M1 (docs/development/port-parity.md §0.8, in the form probe 0 found: scripts/probes/p0_math.cyr).
# The other §0.8 helpers — _ry_is_nan, _ry_is_finite, _ry_max, _ry_min, _ry_powi — are in src/mathx.cyr since M0
# part 2c-2, beside the vendored correctly rounded primitives (ushma's mathx has equivalents of those five).
# tests/parity.tcyr checks both of these against every class A row of tests/golden/math.tsv; M1 moves them into src/
# (mathx.cyr / guard.cyr), where the library calls them. f64_clamp already has Rust's semantics for valid bounds (the
# shadow line shows it), and f64_to truncates to i64 where Rust's `as u32` saturates (§0.1, §0.6).

# Rust's `x.clamp(lo, hi)`: the same two comparisons in the same order, so a NaN x passes through and a zero keeps
# its sign (port-parity.md §0.1). Rust panics when lo > hi or a bound is NaN; no rasayan call site can reach that, so
# there is no such branch. Mirrors `f64::clamp`.
#must_use
#pure
fn _ry_clamp(x: f64, lo: f64, hi: f64): f64 {
    var r: f64 = x;
    if (r < lo) { r = lo; }
    if (r > hi) { r = hi; }
    return r;
}

# Rust's saturating `x as u32`: NaN is 0, a value at or past 2^32 is u32::MAX, a negative one (-inf included) is 0,
# and anything else truncates toward zero (port-parity.md §0.6). Mirrors `f64 as u32`.
#must_use
#pure
fn _ry_f64_to_u32(x: f64): i64 {
    if (x != x) { return 0; }
    if (x >= 4294967296.0) { return 4294967295; }
    var t = f64_to(x);
    if (t < 0) { return 0; }
    return t;
}
