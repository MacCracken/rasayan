[package]
name = "rasayan"
version = "${file:VERSION}"
description = "Rasayan — biochemistry engine: enzyme kinetics, metabolic pathways, signal transduction, protein structure, membrane transport, bioenergetics"
license = "GPL-3.0-only"
language = "cyrius"
cyrius = "6.7.18"

[build]
entry = "src/main.cyr"
output = "build/rasayan"

# sakshi and log are rasayan's logging (port plan §3.2: `src/logging.cyr` in [lib] from M1; probe 8). They are listed
# here since M0 part 3b: part 3a's probe 8 found they resolved silently from the pinned toolchain's lib/ without being
# vendored or locked (port-parity.md §3, probe 10). sakshi first: log.cyr includes it.
[deps]
stdlib = ["string", "fmt", "alloc", "vec", "str", "syscalls", "io", "args", "math", "result", "sakshi", "log", "bayan"]

# bote for [lib.mcp] (port plan P5, §3.2; selah's optional pattern). Only `cyrius deps --features mcp` resolves it, so a
# [lib] build never compiles it. bote-core, not the full bundle (probe 6, port-parity.md §3): rasayan registers its
# tools on a Dispatcher and answers tools/list and tools/call, as Rust's `register_tools` / `create_dispatcher` did; it
# runs no transport. The core profile holds the registry, the dispatcher, the codec, the schema checks and content
# blocks, and none of the transports, auth or sessions, so src/mcp.cyr (M8) calls only that surface and works under
# either bundle: a consumer that serves the tools over stdio or HTTP declares the full bundle itself (never both: the
# two define the same functions). Its own deps (libro, majra, patra, sigil) resolve and lock with it.
[deps.bote]
git = "https://github.com/MacCracken/bote.git"
tag = "3.8.15"
modules = ["dist/bote-core.cyr"]
optional = true

[features]
default = []
mcp = ["bote"]

# The science bundle, dist/rasayan.cyr (`cyrius distlib`), in dependency order; no src/ file includes another (port
# plan §4 step 3, P5). Since M0 part 2c-2 it holds the generated and vendored sources that exist so far: the
# constants, the correctly rounded primitives (src/mathx_data.cyr before src/mathx.cyr, which reads its tables), the
# shortest-digit f64 printer (src/fmtf.cyr, vendored at part 3b for probe 11; P7), the M1 foundation (error codes, the
# guard layer, which writes its refusal events with fmtf's Display form, the integrators, and logging: RASAYAN_LOG and
# the event helpers; json: the serde_json writers, readers at part 3b) and the table data. Each module joins at its
# milestone, its data file ahead of it. src/ai_data.cyr is not here: it belongs to [lib.ai] (with src/ai.cyr, M8), as src/mcp.cyr to [lib.mcp].
[lib]
modules = [
    "src/constants.cyr",
    "src/constants_private.cyr",
    "src/mathx_data.cyr",
    "src/mathx.cyr",
    "src/fmtf.cyr",
    "src/error.cyr",
    "src/guard.cyr",
    "src/integrate.cyr",
    "src/logging.cyr",
    "src/json.cyr",
    "src/protein_data.cyr",
    "src/alignment_data.cyr",
    "src/enzyme_data.cyr",
    "src/enzyme.cyr",
    "src/membrane_data.cyr",
    "src/membrane.cyr",
    "src/signal_data.cyr",
    "src/signal.cyr",
    "src/metabolism_data.cyr",
    "src/metabolism.cyr",
    "src/energy_data.cyr",
    "src/energy.cyr",
    "src/protein.cyr",
    "src/alignment.cyr",
    "src/ptm.cyr",
    "src/domain.cyr",
    "src/glycolysis_data.cyr",
    "src/glycolysis.cyr",
    "src/tca_data.cyr",
    "src/tca.cyr",
    "src/etc_data.cyr",
    "src/etc.cyr",
    "src/beta_oxidation_data.cyr",
    "src/beta_oxidation.cyr",
    "src/amino_catabolism_data.cyr",
    "src/amino_catabolism.cyr",
    "src/pathway_data.cyr",
    "src/pathway.cyr",
    "src/mapk_data.cyr",
    "src/mapk.cyr",
]

# [lib.mcp] (dist/rasayan-mcp.cyr): [lib] plus src/mcp.cyr, the eight bote tools, at M8. Its consumer declares bote
# itself (`[deps.bote]`, as rasayan does behind `[features] mcp`). Until M8 it is [lib]'s list.
[lib.mcp]
modules = [
    "src/constants.cyr",
    "src/constants_private.cyr",
    "src/mathx_data.cyr",
    "src/mathx.cyr",
    "src/fmtf.cyr",
    "src/error.cyr",
    "src/guard.cyr",
    "src/integrate.cyr",
    "src/logging.cyr",
    "src/json.cyr",
    "src/protein_data.cyr",
    "src/alignment_data.cyr",
    "src/enzyme_data.cyr",
    "src/enzyme.cyr",
    "src/membrane_data.cyr",
    "src/membrane.cyr",
    "src/signal_data.cyr",
    "src/signal.cyr",
    "src/metabolism_data.cyr",
    "src/metabolism.cyr",
    "src/energy_data.cyr",
    "src/energy.cyr",
    "src/protein.cyr",
    "src/alignment.cyr",
    "src/ptm.cyr",
    "src/domain.cyr",
    "src/glycolysis_data.cyr",
    "src/glycolysis.cyr",
    "src/tca_data.cyr",
    "src/tca.cyr",
    "src/etc_data.cyr",
    "src/etc.cyr",
    "src/beta_oxidation_data.cyr",
    "src/beta_oxidation.cyr",
    "src/amino_catabolism_data.cyr",
    "src/amino_catabolism.cyr",
    "src/pathway_data.cyr",
    "src/pathway.cyr",
    "src/mapk_data.cyr",
    "src/mapk.cyr",
]

# [lib.ai] (dist/rasayan-ai.cyr): [lib] plus the hoosh client's data (src/ai_data.cyr, the system prompt) and, at M8,
# src/ai.cyr on sandhi (P5, P8; prakash's pattern). sandhi is not in [deps] stdlib: listed there it would be prepended
# to every rasayan compile (pramana measured +0.8 s each); M8 decides how the client's tests get it (probe 10).
[lib.ai]
modules = [
    "src/constants.cyr",
    "src/constants_private.cyr",
    "src/mathx_data.cyr",
    "src/mathx.cyr",
    "src/fmtf.cyr",
    "src/error.cyr",
    "src/guard.cyr",
    "src/integrate.cyr",
    "src/logging.cyr",
    "src/json.cyr",
    "src/protein_data.cyr",
    "src/alignment_data.cyr",
    "src/enzyme_data.cyr",
    "src/enzyme.cyr",
    "src/membrane_data.cyr",
    "src/membrane.cyr",
    "src/signal_data.cyr",
    "src/signal.cyr",
    "src/metabolism_data.cyr",
    "src/metabolism.cyr",
    "src/energy_data.cyr",
    "src/energy.cyr",
    "src/protein.cyr",
    "src/alignment.cyr",
    "src/ptm.cyr",
    "src/domain.cyr",
    "src/glycolysis_data.cyr",
    "src/glycolysis.cyr",
    "src/tca_data.cyr",
    "src/tca.cyr",
    "src/etc_data.cyr",
    "src/etc.cyr",
    "src/beta_oxidation_data.cyr",
    "src/beta_oxidation.cyr",
    "src/amino_catabolism_data.cyr",
    "src/amino_catabolism.cyr",
    "src/pathway_data.cyr",
    "src/pathway.cyr",
    "src/mapk_data.cyr",
    "src/mapk.cyr",
    "src/ai_data.cyr",
]

[test]
stdlib = ["assert", "bench", "ganita", "overflow"]
