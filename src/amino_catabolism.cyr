# amino_catabolism.cyr — amino acid catabolism: transamination onto α-ketoglutarate, glutamate dehydrogenase's
# oxidative deamination to NH4+, the NH4+ sink, and the carbon skeletons routed to the TCA cycle's entry points
# (Rust 1.2.0's `amino_catabolism.rs`, transcribed).
#
#     Amino acid + α-KG  →[aminotransferase]→  Keto acid + Glutamate
#                                                           ↓
#                                 α-KG + NAD+ + NH4+  ←[GDH]←
#     Carbon skeletons → pyruvate, acetyl-CoA, or TCA intermediates; NH4+ → urea cycle or glutamine synthesis
#
# The routing is a weighted average over a typical mixed protein (glucogenic: Ala, Arg, Asn, Asp, Cys, Gln, Glu, Gly,
# His, Met, Pro, Ser, Val; ketogenic: Leu, Lys; both: Ile, Phe, Trp, Tyr, Thr). Rust's simplifications are kept: GDH
# is driven by glutamate and NAD+ only (no ADP / leucine activation, no GTP / ATP inhibition); the NH4+ sink stands in
# for the urea cycle and glutamine synthetase with no ATP cost; the α-KG co-substrate is read, not debited or
# credited. Concentrations in mM, time in seconds.
#
# Every operation is in Rust's order (P9): tests/golden/amino_catabolism.tsv compares each method with the oracle's at
# ≤ 2 ulp (class B, expected 0: nothing here calls a transcendental) and bit for bit over the trajectory scripts and
# Rust's amino-acid-to-TCA coupling (class T).
#
# The Cyrius forms (ADR 0002 rows 7, 10), as the other pathways':
# - CarbonSkeletonOutput, AminoCatabState, AminoCatabConfig and AminoCatabFlux are structs of f64
#   (RyCarbonSkeletonOutput, RyAminoCatabState, RyAminoCatabConfig, RyAminoCatabFlux); the config holds its routing
#   by value, nested in place (13 consecutive f64 in declaration order); the tick updates the state in place and fills
#   the caller's flux: `ry_amino_catab_state_tick(&s, &c, alpha_kg, nad_ratio, dt, &flux)`;
# - `impl Default` is `ry_<type>_default(&out)` from the generated consts (src/amino_catabolism_data.cyr), the config's
#   routing filled by ry_carbon_skeleton_output_default as Rust's literal calls `CarbonSkeletonOutput::default()`, and
#   the derived `AminoCatabFlux::default()` is ry_amino_catab_flux_default(&out);
# - the crate-private `AminoCatabFlux::accumulate` the metabolic network calls (M5) is _ry_amino_catab_flux_accumulate;
# - Rust's `tracing::trace!` event (`amino_catabolism_tick`) is a level-gated sakshi event under the target
#   `rasayan::amino_catabolism`, its fields in Rust's order;
# - each serde type's codec is `ry_<type>_to_json` / `_from_json` (and `_a`, on an allocator); the config's routing is
#   a nested JSON object (or array).

# The fraction of each unit of amino acid catabolized whose carbon skeleton goes to each TCA entry point: pyruvate,
# acetyl-CoA, α-ketoglutarate, succinyl-CoA, fumarate and oxaloacetate (summing to ~1). Rust's `CarbonSkeletonOutput`.
struct RyCarbonSkeletonOutput {
    pyruvate: f64;
    acetyl_coa: f64;
    alpha_kg: f64;
    succinyl_coa: f64;
    fumarate: f64;
    oxaloacetate: f64;
}

# The pathway's pools (mM): free amino acids (mixed), glutamate (the transamination intermediate), and ammonium (NH4+,
# toxic, cleared by the urea cycle). Rust's `AminoCatabState`.
struct RyAminoCatabState {
    amino_acid_pool: f64;
    glutamate: f64;
    ammonium: f64;
}

# The kinetic parameters: the aminotransferase's Vmax and Km for amino acids, GDH's Vmax and Km for glutamate, the
# carbon routing, the aminotransferase's Km for α-KG, and the NH4+ sink's rate and Km. Rust's `AminoCatabConfig`.
struct RyAminoCatabConfig {
    transaminase_vmax: f64;
    transaminase_km: f64;
    gdh_vmax: f64;
    gdh_km_glutamate: f64;
    carbon_routing: RyCarbonSkeletonOutput;
    transaminase_km_alpha_kg: f64;
    nh4_clearance_rate: f64;
    nh4_clearance_km: f64;
}

# One tick's flux (mM), for the caller to route to the TCA cycle: amino acids consumed by transamination, NADH and NH4+
# produced by GDH, NH4+ cleared (no ATP charged), the carbon skeletons to each entry point, then the effective
# transamination and deamination rates (mM/s). Rust's `AminoCatabFlux`.
struct RyAminoCatabFlux {
    amino_acids_consumed: f64;
    nadh_produced: f64;
    nh4_produced: f64;
    nh4_cleared: f64;
    to_pyruvate: f64;
    to_acetyl_coa: f64;
    to_alpha_kg: f64;
    to_succinyl_coa: f64;
    to_fumarate: f64;
    to_oxaloacetate: f64;
    transamination_rate: f64;
    deamination_rate: f64;
}

# ── defaults ──

# Fills *out with the mixed-protein routing: pyruvate 0.30, acetyl-CoA 0.15, α-KG 0.25, succinyl-CoA, fumarate and OAA
# 0.10 each (RY_AMINO_CATABOLISM_CARBON_SKELETON_OUTPUT_DEFAULT_*). Mirrors `CarbonSkeletonOutput::default()`.
fn ry_carbon_skeleton_output_default(out: *RyCarbonSkeletonOutput) {
    out.pyruvate = RY_AMINO_CATABOLISM_CARBON_SKELETON_OUTPUT_DEFAULT_PYRUVATE;
    out.acetyl_coa = RY_AMINO_CATABOLISM_CARBON_SKELETON_OUTPUT_DEFAULT_ACETYL_COA;
    out.alpha_kg = RY_AMINO_CATABOLISM_CARBON_SKELETON_OUTPUT_DEFAULT_ALPHA_KG;
    out.succinyl_coa = RY_AMINO_CATABOLISM_CARBON_SKELETON_OUTPUT_DEFAULT_SUCCINYL_COA;
    out.fumarate = RY_AMINO_CATABOLISM_CARBON_SKELETON_OUTPUT_DEFAULT_FUMARATE;
    out.oxaloacetate = RY_AMINO_CATABOLISM_CARBON_SKELETON_OUTPUT_DEFAULT_OXALOACETATE;
    return 0;
}

# Fills *out with the resting pools: amino acids 2, glutamate 0.5, ammonium 0.05 mM
# (RY_AMINO_CATABOLISM_AMINO_CATAB_STATE_DEFAULT_*). Mirrors `AminoCatabState::default()`.
fn ry_amino_catab_state_default(out: *RyAminoCatabState) {
    out.amino_acid_pool = RY_AMINO_CATABOLISM_AMINO_CATAB_STATE_DEFAULT_AMINO_ACID_POOL;
    out.glutamate = RY_AMINO_CATABOLISM_AMINO_CATAB_STATE_DEFAULT_GLUTAMATE;
    out.ammonium = RY_AMINO_CATABOLISM_AMINO_CATAB_STATE_DEFAULT_AMMONIUM;
    return 0;
}

# Fills *out with the default parameters (RY_AMINO_CATABOLISM_AMINO_CATAB_CONFIG_DEFAULT_*) and the default routing.
# Mirrors `AminoCatabConfig::default()`.
fn ry_amino_catab_config_default(out: *RyAminoCatabConfig) {
    out.transaminase_vmax = RY_AMINO_CATABOLISM_AMINO_CATAB_CONFIG_DEFAULT_TRANSAMINASE_VMAX;
    out.transaminase_km = RY_AMINO_CATABOLISM_AMINO_CATAB_CONFIG_DEFAULT_TRANSAMINASE_KM;
    out.transaminase_km_alpha_kg = RY_AMINO_CATABOLISM_AMINO_CATAB_CONFIG_DEFAULT_TRANSAMINASE_KM_ALPHA_KG;
    out.gdh_vmax = RY_AMINO_CATABOLISM_AMINO_CATAB_CONFIG_DEFAULT_GDH_VMAX;
    out.gdh_km_glutamate = RY_AMINO_CATABOLISM_AMINO_CATAB_CONFIG_DEFAULT_GDH_KM_GLUTAMATE;
    var w = out;
    ry_carbon_skeleton_output_default(w + 32);
    out.nh4_clearance_rate = RY_AMINO_CATABOLISM_AMINO_CATAB_CONFIG_DEFAULT_NH4_CLEARANCE_RATE;
    out.nh4_clearance_km = RY_AMINO_CATABOLISM_AMINO_CATAB_CONFIG_DEFAULT_NH4_CLEARANCE_KM;
    return 0;
}

# Fills *out with the zero flux (every field +0). Mirrors the derived `AminoCatabFlux::default()`.
fn ry_amino_catab_flux_default(out: *RyAminoCatabFlux) {
    memset(out, 0, 96);
    return 0;
}

# ── the routing ──

# The sum of the six routing fractions (~1.0), in declaration order. Mirrors `CarbonSkeletonOutput::total`.
#must_use
#pure
fn ry_carbon_skeleton_output_total(p: *RyCarbonSkeletonOutput): f64 {
    var r: f64 = p.pyruvate + p.acetyl_coa + p.alpha_kg + p.succinyl_coa + p.fumarate + p.oxaloacetate;
    return r;
}

# Ok(0) when every fraction is finite and >= 0 (else RY_ERR_NON_FINITE or RY_ERR_NEGATIVE_CONCENTRATION, the first in
# declaration order, named `carbon_routing.<field>`) and they sum to 1.0 ± 0.01 (else RY_ERR_INVALID_PARAMETER, with
# the sum). Mirrors `CarbonSkeletonOutput::validate`.
#must_use
fn ry_carbon_skeleton_output_validate(p: *RyCarbonSkeletonOutput): Result {
    var pyr: f64 = p.pyruvate;
    var acc: f64 = p.acetyl_coa;
    var akg: f64 = p.alpha_kg;
    var suc: f64 = p.succinyl_coa;
    var fum: f64 = p.fumarate;
    var oaa: f64 = p.oxaloacetate;
    var t1, v1 = _ry_guard_non_negative("carbon_routing.pyruvate", pyr);
    if (is_err_result(t1) == 1) { return Err(v1); }
    var t2, v2 = _ry_guard_non_negative("carbon_routing.acetyl_coa", acc);
    if (is_err_result(t2) == 1) { return Err(v2); }
    var t3, v3 = _ry_guard_non_negative("carbon_routing.alpha_kg", akg);
    if (is_err_result(t3) == 1) { return Err(v3); }
    var t4, v4 = _ry_guard_non_negative("carbon_routing.succinyl_coa", suc);
    if (is_err_result(t4) == 1) { return Err(v4); }
    var t5, v5 = _ry_guard_non_negative("carbon_routing.fumarate", fum);
    if (is_err_result(t5) == 1) { return Err(v5); }
    var t6, v6 = _ry_guard_non_negative("carbon_routing.oxaloacetate", oaa);
    if (is_err_result(t6) == 1) { return Err(v6); }
    var sum: f64 = ry_carbon_skeleton_output_total(p);
    var off: f64 = f64_abs(sum - 1.0);
    if (_ry_is_finite(sum) == 0 || off > 0.01) {
        var code = _ry_fail_f(RY_ERR_INVALID_PARAMETER, "carbon_routing", sum, "fractions must sum to 1.0", 0, 0.0);
        return Err(code);
    }
    return Ok(0);
}

# ── validation ──

# Ok(0) when every pool is finite and >= 0; else the first failing one's `_ry_guard_non_negative` Err, in declaration
# order. Mirrors `AminoCatabState::validate`.
#must_use
fn ry_amino_catab_state_validate(p: *RyAminoCatabState): Result {
    var w = p;                                   # a plain address: `p + n` would step n · 24 bytes
    var name = &_RY_AMINO_CATAB_STATE_FIELDS;
    var k = 0;
    while (k < 3) {
        var value: f64 = load64(w + 8 * k);
        var t, v = _ry_guard_non_negative(name, value);
        if (is_err_result(t) == 1) { return Err(v); }
        name = name + strlen(name) + 1;
        k = k + 1;
    }
    return Ok(0);
}

# Ok(0) when every parameter is physically meaningful: the two Vmax and the clearance rate finite and >= 0 (else
# RY_ERR_NON_FINITE or RY_ERR_NEGATIVE_CONCENTRATION); every Km, a divisor, finite and > 0 (RY_ERR_INVALID_PARAMETER);
# the routing as ry_carbon_skeleton_output_validate requires. Checked in that order. Mirrors
# `AminoCatabConfig::validate`.
#must_use
fn ry_amino_catab_config_validate(p: *RyAminoCatabConfig): Result {
    var tv: f64 = p.transaminase_vmax;
    var gv: f64 = p.gdh_vmax;
    var nr: f64 = p.nh4_clearance_rate;
    var tk: f64 = p.transaminase_km;
    var gk: f64 = p.gdh_km_glutamate;
    var tka: f64 = p.transaminase_km_alpha_kg;
    var nk: f64 = p.nh4_clearance_km;
    var t1, v1 = _ry_guard_non_negative("transaminase_vmax", tv);
    if (is_err_result(t1) == 1) { return Err(v1); }
    var t2, v2 = _ry_guard_non_negative("gdh_vmax", gv);
    if (is_err_result(t2) == 1) { return Err(v2); }
    var t3, v3 = _ry_guard_non_negative("nh4_clearance_rate", nr);
    if (is_err_result(t3) == 1) { return Err(v3); }
    var t4, v4 = _ry_guard_positive("transaminase_km", tk);
    if (is_err_result(t4) == 1) { return Err(v4); }
    var t5, v5 = _ry_guard_positive("gdh_km_glutamate", gk);
    if (is_err_result(t5) == 1) { return Err(v5); }
    var t6, v6 = _ry_guard_positive("transaminase_km_alpha_kg", tka);
    if (is_err_result(t6) == 1) { return Err(v6); }
    var t7, v7 = _ry_guard_positive("nh4_clearance_km", nk);
    if (is_err_result(t7) == 1) { return Err(v7); }
    var w = p;
    var t8, v8 = ry_carbon_skeleton_output_validate(w + 32);
    if (is_err_result(t8) == 1) { return Err(v8); }
    return Ok(0);
}

# ── the tick ──

# Advances amino acid catabolism by `dt` seconds and fills *out with the flux: transamination (amino acids + α-KG →
# keto acids + glutamate, ping-pong in both) and oxidative deamination (glutamate → α-KG + NH4+ + NADH, scaled by the
# NAD+/NADH factor), the carbon skeletons routed by the config's fractions and NH4+ cleared by the sink.
# Transamination is capped at both the amino acid pool and the `alpha_kg` passed in, deamination at the glutamate and
# clearance at the ammonium (each including what earlier steps added this tick), so no pool goes negative and
# nitrogen is conserved for any dt. A non-finite or non-positive dt is "no time passed" (the state untouched, a zero
# flux); a NaN, infinite or negative `alpha_kg` or `nad_ratio` counts as 0. Mirrors `AminoCatabState::tick`.
fn ry_amino_catab_state_tick(p: *RyAminoCatabState, c: *RyAminoCatabConfig, alpha_kg_in: f64, nad_in: f64, dt: f64,
  out: *RyAminoCatabFlux) {
    if (_ry_guard_valid_dt(dt) == 0) {
        memset(out, 0, 96);
        return 0;
    }
    var alpha_kg: f64 = _ry_guard_conc(alpha_kg_in);
    var nad_ratio: f64 = _ry_guard_conc(nad_in);
    var aa: f64 = p.amino_acid_pool;
    var glu: f64 = p.glutamate;
    if (_ry_trace_on() == 1) {
        var h[24];
        var b[256];
        var e = _ry_ev(&h, &b, 256, "rasayan::amino_catabolism", "amino_catabolism_tick");
        _ry_ev_f(e, "dt", dt);
        _ry_ev_f(e, "aa_pool", aa);
        _ry_ev_f(e, "glutamate", glu);
        _ry_trace(e);
    }
    var nh4: f64 = p.ammonium;
    var nad_scaled: f64 = nad_ratio / RY_RESTING_NAD_RATIO;
    var nad_factor: f64 = _ry_min(nad_scaled, RY_MAX_NAD_FACTOR);
    # Transamination: AA + α-KG → keto acid + glutamate (ping-pong).
    var v_transam: f64 = ry_ping_pong(aa, alpha_kg, c.transaminase_vmax, c.transaminase_km, c.transaminase_km_alpha_kg);
    # Oxidative deamination: glutamate → α-KG + NH4+ + NADH, GDH driven by NAD+.
    var gdh_vmax: f64 = c.gdh_vmax * nad_factor;
    var v_gdh: f64 = ry_michaelis_menten(glu, gdh_vmax, c.gdh_km_glutamate);
    # The NH4+ sink (urea cycle / glutamine synthetase), with no ATP charged.
    var v_clearance: f64 = ry_michaelis_menten(nh4, c.nh4_clearance_rate, c.nh4_clearance_km);
    # The pools, each transfer capped at the pool it drains.
    var transam_pool: f64 = _ry_min(aa, alpha_kg);
    var transaminated: f64 = _ry_guard_take(v_transam * dt, transam_pool);
    aa = aa - transaminated;
    glu = glu + transaminated;
    var deaminated: f64 = _ry_guard_take(v_gdh * dt, glu);
    glu = glu - deaminated;
    nh4 = nh4 + deaminated;
    var cleared: f64 = _ry_guard_take(v_clearance * dt, nh4);
    nh4 = nh4 - cleared;
    p.amino_acid_pool = aa;
    p.glutamate = glu;
    p.ammonium = nh4;
    # The flux: the amounts moved, the skeletons by the routing.
    out.amino_acids_consumed = transaminated;
    out.nadh_produced = deaminated;
    out.nh4_produced = deaminated;
    out.nh4_cleared = cleared;
    out.to_pyruvate = transaminated * c.carbon_routing.pyruvate;
    out.to_acetyl_coa = transaminated * c.carbon_routing.acetyl_coa;
    out.to_alpha_kg = transaminated * c.carbon_routing.alpha_kg;
    out.to_succinyl_coa = transaminated * c.carbon_routing.succinyl_coa;
    out.to_fumarate = transaminated * c.carbon_routing.fumarate;
    out.to_oxaloacetate = transaminated * c.carbon_routing.oxaloacetate;
    out.transamination_rate = transaminated / dt;
    out.deamination_rate = deaminated / dt;
    return 0;
}

# Adds a sub-step's flux `o` into the tick total `t`: the ten amounts summed, the two per-second rates weighted by
# `weight` (the sub-step over the tick's length). Mirrors the crate-private `AminoCatabFlux::accumulate`.
fn _ry_amino_catab_flux_accumulate(t: *RyAminoCatabFlux, o: *RyAminoCatabFlux, weight: f64) {
    var wt = t;
    var wo = o;
    var k = 0;
    while (k < 10) {
        var x: f64 = load64(wt + 8 * k);
        var y: f64 = load64(wo + 8 * k);
        var s: f64 = x + y;
        store64(wt + 8 * k, load64(&s));
        k = k + 1;
    }
    while (k < 12) {
        var r: f64 = load64(wt + 8 * k);
        var q: f64 = load64(wo + 8 * k);
        var u: f64 = r + q * weight;
        store64(wt + 8 * k, load64(&u));
        k = k + 1;
    }
    return 0;
}

# ── JSON (P7: serde_json's documents) ──

# Appends CarbonSkeletonOutput `p` as serde_json writes it, its six fractions in declaration order, on allocator `a`:
# Ok(0), or Err(RY_ERR_OUT_OF_MEMORY) when the builder could not grow.
#must_use
fn ry_carbon_skeleton_output_to_json_a(a, sb, p: *RyCarbonSkeletonOutput): Result {
    if (_ry_jw_f64_fields(a, sb, p, 6, &_RY_CARBON_SKELETON_OUTPUT_FIELDS) != 0) { return Err(RY_ERR_OUT_OF_MEMORY); }
    return Ok(0);
}

# ry_carbon_skeleton_output_to_json_a on the default allocator (a builder from str_builder_new).
#must_use
fn ry_carbon_skeleton_output_to_json(sb, p: *RyCarbonSkeletonOutput): Result {
    return ry_carbon_skeleton_output_to_json_a(default_alloc(), sb, p);
}

# Reads a CarbonSkeletonOutput from the `n`-byte document at `buf` by serde's rules (its tree on allocator `a`): Ok(0)
# with *out filled, or Err(RY_ERR_DESERIALIZE).
#must_use
fn ry_carbon_skeleton_output_from_json_a(a, buf, n, out: *RyCarbonSkeletonOutput): Result {
    var w[48];
    var v = _ry_jr_parse(a, buf, n);
    if (_ry_jr_f64_fields(v, &w, 6, &_RY_CARBON_SKELETON_OUTPUT_FIELDS) == 0) {
        return Err(_ry_fail_text(RY_ERR_DESERIALIZE, "CarbonSkeletonOutput", 20));
    }
    memcpy(out, &w, 48);
    return Ok(0);
}

# ry_carbon_skeleton_output_from_json_a on the default allocator (the tree is never freed: for a one-off read).
#must_use
fn ry_carbon_skeleton_output_from_json(buf, n, out: *RyCarbonSkeletonOutput): Result {
    return ry_carbon_skeleton_output_from_json_a(default_alloc(), buf, n, out);
}

# Appends AminoCatabState `p` as serde_json writes it, `{"amino_acid_pool":…,"glutamate":…,"ammonium":…}`, on
# allocator `a`: Ok(0), or Err(RY_ERR_OUT_OF_MEMORY).
#must_use
fn ry_amino_catab_state_to_json_a(a, sb, p: *RyAminoCatabState): Result {
    if (_ry_jw_f64_fields(a, sb, p, 3, &_RY_AMINO_CATAB_STATE_FIELDS) != 0) { return Err(RY_ERR_OUT_OF_MEMORY); }
    return Ok(0);
}

# ry_amino_catab_state_to_json_a on the default allocator.
#must_use
fn ry_amino_catab_state_to_json(sb, p: *RyAminoCatabState): Result {
    return ry_amino_catab_state_to_json_a(default_alloc(), sb, p);
}

# Reads an AminoCatabState from the `n`-byte document at `buf` by serde's rules (its tree on allocator `a`): Ok(0) with
# *out filled, or Err(RY_ERR_DESERIALIZE).
#must_use
fn ry_amino_catab_state_from_json_a(a, buf, n, out: *RyAminoCatabState): Result {
    var w[24];
    var v = _ry_jr_parse(a, buf, n);
    if (_ry_jr_f64_fields(v, &w, 3, &_RY_AMINO_CATAB_STATE_FIELDS) == 0) {
        return Err(_ry_fail_text(RY_ERR_DESERIALIZE, "AminoCatabState", 15));
    }
    memcpy(out, &w, 24);
    return Ok(0);
}

# ry_amino_catab_state_from_json_a on the default allocator (the tree is never freed: for a one-off read).
#must_use
fn ry_amino_catab_state_from_json(buf, n, out: *RyAminoCatabState): Result {
    return ry_amino_catab_state_from_json_a(default_alloc(), buf, n, out);
}

# The byte offset of AminoCatabConfig's field k (declaration order: 0–3 the first four, 4 the nested routing, 5–7
# the last three, after the routing's six words).
#must_use
#pure
fn _ry_amino_catab_config_offset(k): i64 {
    if (k < 5) { return 8 * k; }
    return 8 * (k + 5);
}

# Appends AminoCatabConfig `p` as serde_json writes it, its eight fields in declaration order with `carbon_routing` a
# nested object, on allocator `a`: Ok(0), or Err(RY_ERR_OUT_OF_MEMORY).
#must_use
fn ry_amino_catab_config_to_json_a(a, sb, p: *RyAminoCatabConfig): Result {
    var w = p;
    var name = &_RY_AMINO_CATAB_CONFIG_FIELDS;
    var e = _ry_jw_byte(a, sb, 123);
    var k = 0;
    while (k < 8) {
        var first = 0;
        if (k == 0) { first = 1; }
        e = e | _ry_jw_key(a, sb, name, first);
        if (k == 4) {
            e = e | _ry_jw_f64_fields(a, sb, w + 32, 6, &_RY_CARBON_SKELETON_OUTPUT_FIELDS);
        } else {
            var x: f64 = load64(w + _ry_amino_catab_config_offset(k));
            e = e | _ry_jw_f64(a, sb, x);
        }
        name = name + strlen(name) + 1;
        k = k + 1;
    }
    e = e | _ry_jw_byte(a, sb, 125);
    if (e != 0) { return Err(RY_ERR_OUT_OF_MEMORY); }
    return Ok(0);
}

# ry_amino_catab_config_to_json_a on the default allocator.
#must_use
fn ry_amino_catab_config_to_json(sb, p: *RyAminoCatabConfig): Result {
    return ry_amino_catab_config_to_json_a(default_alloc(), sb, p);
}

# Reads an AminoCatabConfig from the `n`-byte document at `buf` by serde's rules (an object by field name, or an array
# of its eight fields; `carbon_routing` itself an object or an array of six), its tree on allocator `a`: Ok(0) with
# *out filled, or Err(RY_ERR_DESERIALIZE).
#must_use
fn ry_amino_catab_config_from_json_a(a, buf, n, out: *RyAminoCatabConfig): Result {
    var w[104];
    var v = _ry_jr_parse(a, buf, n);
    var form = _ry_jr_form(v, 8);
    var ok = 0;
    if (form != 0) {
        ok = 1;
        var name = &_RY_AMINO_CATAB_CONFIG_FIELDS;
        var k = 0;
        while (k < 8 && ok == 1) {
            var node = _ry_jr_at(v, form, k, name);
            if (k == 4) {
                ok = _ry_jr_f64_fields(node, &w + 32, 6, &_RY_CARBON_SKELETON_OUTPUT_FIELDS);
            } elif (_ry_jr_f64(node, &w + _ry_amino_catab_config_offset(k)) == 0) {
                ok = 0;
            }
            name = name + strlen(name) + 1;
            k = k + 1;
        }
    }
    if (ok == 0) { return Err(_ry_fail_text(RY_ERR_DESERIALIZE, "AminoCatabConfig", 16)); }
    memcpy(out, &w, 104);
    return Ok(0);
}

# ry_amino_catab_config_from_json_a on the default allocator (the tree is never freed: for a one-off read).
#must_use
fn ry_amino_catab_config_from_json(buf, n, out: *RyAminoCatabConfig): Result {
    return ry_amino_catab_config_from_json_a(default_alloc(), buf, n, out);
}

# Appends AminoCatabFlux `f` as serde_json writes it, its twelve fields in declaration order, on allocator `a`: Ok(0),
# or Err(RY_ERR_OUT_OF_MEMORY).
#must_use
fn ry_amino_catab_flux_to_json_a(a, sb, f: *RyAminoCatabFlux): Result {
    if (_ry_jw_f64_fields(a, sb, f, 12, &_RY_AMINO_CATAB_FLUX_FIELDS) != 0) { return Err(RY_ERR_OUT_OF_MEMORY); }
    return Ok(0);
}

# ry_amino_catab_flux_to_json_a on the default allocator.
#must_use
fn ry_amino_catab_flux_to_json(sb, f: *RyAminoCatabFlux): Result {
    return ry_amino_catab_flux_to_json_a(default_alloc(), sb, f);
}

# Reads an AminoCatabFlux from the `n`-byte document at `buf` by serde's rules (its tree on allocator `a`): Ok(0) with
# *out filled, or Err(RY_ERR_DESERIALIZE).
#must_use
fn ry_amino_catab_flux_from_json_a(a, buf, n, out: *RyAminoCatabFlux): Result {
    var w[96];
    var v = _ry_jr_parse(a, buf, n);
    if (_ry_jr_f64_fields(v, &w, 12, &_RY_AMINO_CATAB_FLUX_FIELDS) == 0) {
        return Err(_ry_fail_text(RY_ERR_DESERIALIZE, "AminoCatabFlux", 14));
    }
    memcpy(out, &w, 96);
    return Ok(0);
}

# ry_amino_catab_flux_from_json_a on the default allocator (the tree is never freed: for a one-off read).
#must_use
fn ry_amino_catab_flux_from_json(buf, n, out: *RyAminoCatabFlux): Result {
    return ry_amino_catab_flux_from_json_a(default_alloc(), buf, n, out);
}
