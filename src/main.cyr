# rasayan — Cyrius port
# Ported from 20541 lines of Rust

# Stdlib auto-included via cyrius.cyml

# Entry point of the scaffold binary: initializes the allocator and reports readiness.
fn main() {
    alloc_init();
    println("rasayan ready");
    return 0;
}

var r = main();
# sys_exit_group, not syscall(SYS_EXIT, ...): SYS_EXIT ends only the calling
# thread, so the bare syscall hangs once this program spawns its first worker.
sys_exit_group(r);
