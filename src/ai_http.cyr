# Whether the hoosh server answers `/v1/health` with a 2xx, on allocator a: 1, or 0 (an error answer or none). Mirrors
# `BiochemClient::health` (whose Result is always Ok).
#must_use
fn ry_biochem_client_health_a(a, c: *RyBiochemClient): i64 {
    var url = _ry_ai_url(a, c, "/v1/health");
    var h = _ry_ai_headers(a, c, 0);
    var o = _ry_ai_options(a, c);
    if (url == 0 || h == 0 || o == 0) { return 0; }
    var r = sandhi_http_get_opts_a(a, url, h, o);
    if (r == 0 || sandhi_http_err_kind(r) != SANDHI_OK) { return _ry_ai_health_of(0 - 1); }
    return _ry_ai_health_of(sandhi_http_status(r));
}

# ry_biochem_client_health_a on the default allocator.
#must_use
fn ry_biochem_client_health(c: *RyBiochemClient): i64 {
    return ry_biochem_client_health_a(default_alloc(), c);
}

# The models the hoosh server lists into the `cap` RyModelInfo records at out (strings on allocator a): Ok(count), or
# Err(RY_ERR_HTTP), Err(RY_ERR_PROVIDER), Err(RY_ERR_BUFFER_TOO_SMALL) or Err(RY_ERR_OUT_OF_MEMORY). Mirrors
# `BiochemClient::list_models`.
#must_use
fn ry_biochem_client_list_models_a(a, c: *RyBiochemClient, out: *RyModelInfo, cap): Result {
    var url = _ry_ai_url(a, c, "/v1/models");
    var h = _ry_ai_headers(a, c, 0);
    var o = _ry_ai_options(a, c);
    if (url == 0 || h == 0 || o == 0) { return Err(RY_ERR_OUT_OF_MEMORY); }
    var r = sandhi_http_get_opts_a(a, url, h, o);
    if (r == 0) { return Err(RY_ERR_OUT_OF_MEMORY); }
    if (sandhi_http_err_kind(r) != SANDHI_OK) { return Err(_ry_ai_fail(RY_ERR_HTTP, r)); }
    var t, v = _ry_ai_models_parse_a(a, sandhi_http_status(r), sandhi_http_body(r), sandhi_http_body_len(r), out, cap);
    if (is_err_result(t) == 1) {
        if (v == RY_ERR_PROVIDER) { return Err(_ry_ai_fail(RY_ERR_PROVIDER, r)); }
        return Err(v);
    }
    return Ok(v);
}

# ry_biochem_client_list_models_a on the default allocator.
#must_use
fn ry_biochem_client_list_models(c: *RyBiochemClient, out: *RyModelInfo, cap): Result {
    return ry_biochem_client_list_models_a(default_alloc(), c, out, cap);
}
