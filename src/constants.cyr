# rasayan — public constants
#
# GENERATED by scripts/oracle from rasayan 1.2.0 (rust-old/). Do not edit.
# Regenerate: cargo run --release --locked --manifest-path scripts/oracle/Cargo.toml
#
# Each f64 is the shortest decimal that round-trips to the oracle's value, written out
# positionally: the Cyrius lexer has no exponent notation, and decimal literals are
# correctly rounded (6.6.10+). tests/golden/constants.tsv pins every bit.
#
# Names: a const of constants.rs is RY_<NAME>; a const of any other module is
# RY_<MODULE>_<NAME>, because names repeat across modules (calcium and mapk both
# have SUBSTEP_MAX_DT and MAX_SUBSTEPS).
#
# Each comment is the first paragraph of the Rust doc comment; the derivations and
# citations that follow it stay in rust-old/src.
#
# Table-valued and private constants are table data, generated with their module's
# data file (port plan §4 step 6).

# Largest internal sub-step (s) used by [`CalciumState::tick`] while the
# sub-step budget [`MAX_SUBSTEPS`] allows.
# Rust: rasayan::calcium::SUBSTEP_MAX_DT
const RY_CALCIUM_SUBSTEP_MAX_DT = 0.01;

# Maximum number of internal sub-steps per [`CalciumState::tick`]. Larger
# `dt` values are split into this many equal sub-steps of
# `dt / MAX_SUBSTEPS` each.
# Rust: rasayan::calcium::MAX_SUBSTEPS
const RY_CALCIUM_MAX_SUBSTEPS = 1000;

# Reference (resting, full-store) ER Ca2+ level (uM).
# Rust: rasayan::calcium::ER_CA_REFERENCE
const RY_CALCIUM_ER_CA_REFERENCE = 500.0;

# ER volume as a fraction of the cytosolic volume (dimensionless).
# Rust: rasayan::calcium::ER_CYTOSOL_VOLUME_RATIO
const RY_CALCIUM_ER_CYTOSOL_VOLUME_RATIO = 0.185;

# Maximal store-operated Ca2+ entry (uM/s, cytosolic units), reached when
# the ER is empty.
# Rust: rasayan::calcium::SOCE_MAX
const RY_CALCIUM_SOCE_MAX = 0.5;

# ER Ca2+ level (uM) at which SOCE is half-active; activation is
# `1 / (1 + (er_ca / SOCE_K_ER)⁴)`.
# Rust: rasayan::calcium::SOCE_K_ER
const RY_CALCIUM_SOCE_K_ER = 180.0;

# Constitutive (store-independent) plasma-membrane Ca2+ leak (uM/s,
# cytosolic units).
# Rust: rasayan::calcium::PM_CA_LEAK
const RY_CALCIUM_PM_CA_LEAK = 0.041740645440675156;

# Molar gas constant R (J/(mol*K)).
# Rust: rasayan::constants::R_GAS
const RY_R_GAS = 8.31446261815324;

# Faraday constant F (C/mol).
# Rust: rasayan::constants::FARADAY
const RY_FARADAY = 96485.33212331001;

# Normal human core body temperature, 37 °C, in kelvin.
# Rust: rasayan::constants::BODY_TEMP_K
const RY_BODY_TEMP_K = 310.15;

# Resting NAD+/NADH ratio for a typical mammalian cell.
# Used as the reference point for NAD-dependent rate scaling in pathway modules.
# Rust: rasayan::constants::RESTING_NAD_RATIO
const RY_RESTING_NAD_RATIO = 700.0;

# Maximum fold-increase in NAD-dependent reaction rates.
# Caps the `nad_ratio / RESTING_NAD_RATIO` scaling factor to prevent
# unrealistic rates when NAD+/NADH ratio is very high.
# Rust: rasayan::constants::MAX_NAD_FACTOR
const RY_MAX_NAD_FACTOR = 2.0;

# Fallback ATP/ADP ratio used when ADP approaches zero.
# Represents a fully charged cell where glycolysis/TCA are strongly inhibited.
# Rust: rasayan::constants::MAX_ATP_ADP_RATIO
const RY_MAX_ATP_ADP_RATIO = 100.0;

# Standard transformed free energy of ATP hydrolysis, ΔG°′ (kJ/mol).
# Rust: rasayan::energy::ATP_HYDROLYSIS_DG
const RY_ENERGY_ATP_HYDROLYSIS_DG = -30.5;

# Metabolic equivalent (MET) — 1 MET = 3.5 mL O2/kg/min (resting).
# Rust: rasayan::energy::MET_O2_RATE
const RY_ENERGY_MET_O2_RATE = 3.5;

# Half-time of phosphocreatine resynthesis at rest (minutes): 30 s.
# Rust: rasayan::energy::PCR_RECOVERY_HALF_TIME
const RY_ENERGY_PCR_RECOVERY_HALF_TIME = 0.5;

# First-order PCr resynthesis rate constant (1/min): ln 2 /
# [`PCR_RECOVERY_HALF_TIME`] ≈ 1.386 /min.
# Rust: rasayan::energy::PCR_RECOVERY_RATE
const RY_ENERGY_PCR_RECOVERY_RATE = 1.3862943611198906;

# First-order PCr use rate constant (1/min) per MET above the anaerobic
# threshold.
# Rust: rasayan::energy::PCR_DEPLETION_RATE
const RY_ENERGY_PCR_DEPLETION_RATE = 0.25;

# Default PCr-use threshold as exertion above rest (MET − 1): 5.0, i.e.
# the default [`BioenergyState::anaerobic_threshold`] of 6 MET.
# Rust: rasayan::energy::PCR_DEMAND_THRESHOLD
const RY_ENERGY_PCR_DEMAND_THRESHOLD = 5.0;

# Aerobic glycogen use (fraction of the store per minute per MET above
# rest).
# Rust: rasayan::energy::GLYCOGEN_DEPLETION_RATE
const RY_ENERGY_GLYCOGEN_DEPLETION_RATE = 0.0006;

# Anaerobic glycogen use (fraction of the store per minute per MET² above
# the anaerobic threshold).
# Rust: rasayan::energy::GLYCOGEN_ANAEROBIC_RATE
const RY_ENERGY_GLYCOGEN_ANAEROBIC_RATE = 0.00025;

# Glycogen resynthesis at rest (fraction of the store per minute): 0.001,
# i.e. 6 % per hour.
# Rust: rasayan::energy::GLYCOGEN_RECOVERY_RATE
const RY_ENERGY_GLYCOGEN_RECOVERY_RATE = 0.001;

# MET threshold at or below which glycogen is resynthesized.
# Rust: rasayan::energy::GLYCOGEN_RECOVERY_THRESHOLD
const RY_ENERGY_GLYCOGEN_RECOVERY_THRESHOLD = 1.5;

# Complex I Michaelis constant for NADH (mM).
# Rust: rasayan::etc::COMPLEX_I_KM_NADH
const RY_ETC_COMPLEX_I_KM_NADH = 0.002;

# Hexokinase Michaelis constant for MgATP (mM). Hexokinases I/II:
# Km(ATP) ≈ 0.4–1 mM (Wilson, *J. Exp. Biol.* 206:2049, 2003).
# Rust: rasayan::glycolysis::HK_KM_ATP
const RY_GLYCOLYSIS_HK_KM_ATP = 0.4;

# PFK-1 Michaelis constant for MgATP at the catalytic site (mM); the
# inhibitory ATP site is modeled separately by `pfk_atp_half_inhibition`.
# Rust: rasayan::glycolysis::PFK_KM_ATP
const RY_GLYCOLYSIS_PFK_KM_ATP = 0.05;

# Phosphoglycerate kinase Michaelis constant for MgADP (mM) (≈ 0.2–0.35).
# Rust: rasayan::glycolysis::PGK_KM_ADP
const RY_GLYCOLYSIS_PGK_KM_ADP = 0.3;

# Pyruvate kinase Michaelis constant for MgADP (mM) (muscle PK ≈ 0.3).
# Rust: rasayan::glycolysis::PK_KM_ADP
const RY_GLYCOLYSIS_PK_KM_ADP = 0.3;

# GAPDH Michaelis constant for NAD+, as a fraction of the total NAD(H)
# pool (≈ 0.1 mM of a ≈ 1 mM cytosolic pool; GAPDH Km(NAD+) ≈ 0.05–0.1 mM).
# Rust: rasayan::glycolysis::GAPDH_KM_NAD_FRACTION
const RY_GLYCOLYSIS_GAPDH_KM_NAD_FRACTION = 0.1;

# Cortisol level giving half-maximal negative feedback on pituitary ACTH
# secretion, in the same model units as
# [`HormonalConfig::cortisol_feedback_ki`]: ACTH production in
# [`HormonalState::tick`] is scaled by `1 / (1 + cortisol / ACTH_FEEDBACK_KI)`.
# Rust: rasayan::hormonal::ACTH_FEEDBACK_KI
const RY_HORMONAL_ACTH_FEEDBACK_KI = 4.0;

# Half-inhibition constant of the ERK → Ras/Raf negative feedback, in units
# of the ERK-PP fraction.
# Rust: rasayan::mapk::ERK_FEEDBACK_KI
const RY_MAPK_ERK_FEEDBACK_KI = 0.1;

# Largest internal sub-step (s) used by [`MapkState::tick`] while the
# sub-step budget [`MAX_SUBSTEPS`] allows.
# Rust: rasayan::mapk::SUBSTEP_MAX_DT
const RY_MAPK_SUBSTEP_MAX_DT = 0.5;

# Maximum number of internal sub-steps per [`MapkState::tick`]. Larger
# `dt` values are split into this many equal sub-steps of
# `dt / MAX_SUBSTEPS` each.
# Rust: rasayan::mapk::MAX_SUBSTEPS
const RY_MAPK_MAX_SUBSTEPS = 1000;

# Longest sequence (in bytes, i.e. residues for valid input) any tool accepts.
# Rust: rasayan::mcp::MAX_SEQUENCE_LEN
const RY_MCP_MAX_SEQUENCE_LEN = 100000;

# Largest Needleman-Wunsch DP problem (`len(seq_a) × len(seq_b)`) accepted.
# Rust: rasayan::mcp::MAX_ALIGNMENT_CELLS
const RY_MCP_MAX_ALIGNMENT_CELLS = 25000000;

# First-order lactate clearance rate at full oxygenation (1/s).
# Rust: rasayan::metabolism::LACTATE_CLEARANCE_RATE
const RY_METABOLISM_LACTATE_CLEARANCE_RATE = 0.001;

# Apparent equilibrium constant of adenylate kinase,
# `K′ = [ATP]·[AMP] / [ADP]²` for 2 ADP ⇌ ATP + AMP (dimensionless).
# Rust: rasayan::metabolism::ADENYLATE_KINASE_KEQ
const RY_METABOLISM_ADENYLATE_KINASE_KEQ = 0.44;

# Plasma-equilibrated brain tryptophan level (normalized units) that the
# tryptophan pool relaxes toward via LAT1 transport. Equal to the default
# resting [`NeurotransmitterState::tryptophan`].
# Rust: rasayan::neurotransmitter::PLASMA_TRYPTOPHAN
const RY_NEUROTRANSMITTER_PLASMA_TRYPTOPHAN = 5.0;

# Plasma-equilibrated brain tyrosine level (normalized units) that the
# tyrosine pool relaxes toward via LAT1 transport. Equal to the default
# resting [`NeurotransmitterState::tyrosine`].
# Rust: rasayan::neurotransmitter::PLASMA_TYROSINE
const RY_NEUROTRANSMITTER_PLASMA_TYROSINE = 5.0;

# First-order rate (s⁻¹) at which tryptophan and tyrosine relax toward
# [`PLASMA_TRYPTOPHAN`] / [`PLASMA_TYROSINE`] (LAT1 large neutral amino acid
# transport across the blood–brain barrier; relaxation t½ ≈ 5.8 s in this
# model's compressed simulation time).
# Rust: rasayan::neurotransmitter::PRECURSOR_TRANSPORT_RATE
const RY_NEUROTRANSMITTER_PRECURSOR_TRANSPORT_RATE = 0.12;

# Floor applied to the clearance/degradation rate in the steady-state bridge
# functions ([`dopamine_level`], [`norepinephrine_level`],
# [`acetylcholine_level`], [`endorphin_level`]).
# Rust: rasayan::neurotransmitter::MIN_CLEARANCE_RATE
const RY_NEUROTRANSMITTER_MIN_CLEARANCE_RATE = 0.01;

# Total NAD(H) pool (mM): NAD+ + NADH, lumped across compartments.
# Rust: rasayan::pathway::NAD_POOL_TOTAL
const RY_PATHWAY_NAD_POOL_TOTAL = 1.0;

# Lower bound kept on the NAD+/NADH ratio (fully reduced pool).
# Rust: rasayan::pathway::NAD_RATIO_MIN
const RY_PATHWAY_NAD_RATIO_MIN = 1.0;

# Upper bound kept on the NAD+/NADH ratio (fully oxidized pool).
# Rust: rasayan::pathway::NAD_RATIO_MAX
const RY_PATHWAY_NAD_RATIO_MAX = 2000.0;

# Longest internal step the network takes (s).
# Rust: rasayan::pathway::NETWORK_MAX_SUBSTEP
const RY_PATHWAY_NETWORK_MAX_SUBSTEP = 0.02;

# Most sub-steps per tick (a `dt` beyond `NETWORK_MAX_SUBSTEP ×` this is
# split into this many longer, still-bounded sub-steps).
# Rust: rasayan::pathway::NETWORK_MAX_SUBSTEPS
const RY_PATHWAY_NETWORK_MAX_SUBSTEPS = 5000;

# Plasma-membrane glucose transport rate constant (1/s): cell glucose
# relaxes toward [`NetworkEnvironment::plasma_glucose`] (GLUT carriers).
# Rust: rasayan::pathway::GLUCOSE_TRANSPORT_RATE
const RY_PATHWAY_GLUCOSE_TRANSPORT_RATE = 0.1;

# Fatty acid uptake rate constant (1/s): cell free fatty acid relaxes
# toward [`NetworkEnvironment::plasma_fatty_acids`] (CD36/FATP).
# Rust: rasayan::pathway::FATTY_ACID_TRANSPORT_RATE
const RY_PATHWAY_FATTY_ACID_TRANSPORT_RATE = 0.2;

# Amino acid uptake rate constant (1/s): the cell amino acid pool relaxes
# toward [`NetworkEnvironment::plasma_amino_acids`] (SLC carriers).
# Rust: rasayan::pathway::AMINO_ACID_TRANSPORT_RATE
const RY_PATHWAY_AMINO_ACID_TRANSPORT_RATE = 0.05;

# TCA intermediate total (mM) above which cataplerosis drains the cycle.
# Rust: rasayan::pathway::TCA_POOL_REFERENCE
const RY_PATHWAY_TCA_POOL_REFERENCE = 1.63;

# Cataplerosis rate constant (1/s): malic enzyme / PEPCK return malate
# carbon above [`TCA_POOL_REFERENCE`] to pyruvate (malate → pyruvate +
# CO2), so amino-acid carbon can be fully oxidized.
# Rust: rasayan::pathway::CATAPLEROSIS_RATE
const RY_PATHWAY_CATAPLEROSIS_RATE = 0.5;

# Basal ATP turnover of the default [`NetworkEnvironment`] (mM/s).
# Rust: rasayan::pathway::RESTING_ATP_DEMAND
const RY_PATHWAY_RESTING_ATP_DEMAND = 1.2;

# Michaelis constant of the cell's ATP-consuming work for ATP (mM).
# Rust: rasayan::pathway::ATP_DEMAND_KM
const RY_PATHWAY_ATP_DEMAND_KM = 0.5;

# Malonyl-CoA formed per mM of acetyl-CoA by acetyl-CoA carboxylase
# (dimensionless steady-state gain).
# Rust: rasayan::pathway::MALONYL_PER_ACETYL_COA
const RY_PATHWAY_MALONYL_PER_ACETYL_COA = 0.1;

# Lactate dehydrogenase Vmax (mM/s): pyruvate + NADH → lactate + NAD+.
# Rust: rasayan::pathway::LDH_VMAX
const RY_PATHWAY_LDH_VMAX = 2.0;

# PFK-1 inhibition constant for citrate (mM): citrate exported from
# mitochondria when fat oxidation fills the TCA cycle potentiates ATP
# inhibition of PFK-1 (Randle et al., *Lancet* 281:785, 1963).
# Rust: rasayan::pathway::PFK_KI_CITRATE
const RY_PATHWAY_PFK_KI_CITRATE = 0.3;

# LDH Michaelis constant for pyruvate (mM) (LDH-A ≈ 0.1–0.3).
# Rust: rasayan::pathway::LDH_KM_PYRUVATE
const RY_PATHWAY_LDH_KM_PYRUVATE = 0.2;

# LDH Michaelis constant for NADH (mM) (≈ 10 µM).
# Rust: rasayan::pathway::LDH_KM_NADH
const RY_PATHWAY_LDH_KM_NADH = 0.01;

# Fractional increase in messenger per unit activation intensity.
# Rust: rasayan::signal::ACTIVATION_GAIN
const RY_SIGNAL_ACTIVATION_GAIN = 0.3;

# IP3 → Ca2+ coupling factor: Ca2+ rise per unit of IP3 *increase*
# produced by a Gq activation.
# Rust: rasayan::signal::IP3_CA_COUPLING
const RY_SIGNAL_IP3_CA_COUPLING = 0.5;

# First-order cAMP relaxation rate toward [`CAMP_FLOOR`] (1/s).
# Rust: rasayan::signal::CAMP_DECAY_RATE
const RY_SIGNAL_CAMP_DECAY_RATE = 0.1;

# First-order IP3 relaxation rate toward [`IP3_FLOOR`] (1/s).
# Rust: rasayan::signal::IP3_DECAY_RATE
const RY_SIGNAL_IP3_DECAY_RATE = 0.15;

# First-order Ca2+ relaxation rate toward [`CA_FLOOR`] (1/s); fastest —
# active re-sequestration by SERCA.
# Rust: rasayan::signal::CA_DECAY_RATE
const RY_SIGNAL_CA_DECAY_RATE = 0.2;

# Resting cAMP floor (basal adenylyl cyclase activity).
# Rust: rasayan::signal::CAMP_FLOOR
const RY_SIGNAL_CAMP_FLOOR = 0.05;

# Resting IP3 floor.
# Rust: rasayan::signal::IP3_FLOOR
const RY_SIGNAL_IP3_FLOOR = 0.02;

# Resting Ca2+ floor.
# Rust: rasayan::signal::CA_FLOOR
const RY_SIGNAL_CA_FLOOR = 0.02;

# Pyruvate dehydrogenase inhibition constant for acetyl-CoA (mM).
# Rust: rasayan::tca::PDH_KI_ACETYL_COA
const RY_TCA_PDH_KI_ACETYL_COA = 0.2;
