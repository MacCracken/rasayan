# rasayan — src/hormonal.cyr: the HPA axis, melatonin, oxytocin and BDNF (rust-old/src/hormonal.rs)
#
# The hormonal systems of the bhava bridge:
# - the HPA axis: CRH → ACTH → cortisol with two cortisol negative-feedback arms (Keller-Wood & Dallman, Endocr. Rev.
#   5:1–24, 1984): the hypothalamic arm scales CRH secretion by 1 / (1 + cortisol / Ki), Ki the config's
#   `cortisol_feedback_ki`; the pituitary arm scales corticotroph ACTH secretion by 1 / (1 + cortisol /
#   RY_HORMONAL_ACTH_FEEDBACK_KI). Both read cortisol at the start of the step; there is no circadian input. With the
#   default config and input the axis settles at CRH ≈ 0.280, ACTH ≈ 0.323, cortisol ≈ 1.568 (the default state, all 1,
#   is a starting point, not that set point);
# - melatonin: serotonin → N-acetylserotonin → melatonin (NAT), suppressed by light;
# - oxytocin: hypothalamic synthesis, stimulus-dependent release; BDNF: activity-dependent transcription.
# Rates are in compressed simulation time (the axes answer in seconds to minutes; cortisol's half-life ≈ 35 s against
# 60–90 min). Each production / first-order degradation term is integrated exactly over dt (integrate's
# `produce_decay`: stable for any step, never negative); a non-finite or non-positive dt is no time passed.
#
# The Cyrius forms (ADR 0002 row 7): the state advances in place, the input is borrowed and the flux fills the
# caller's record. Every operation is in the source's order (P9).

# ── the types ──

# The endocrine levels: the HPA axis's CRH (hypothalamus), ACTH (anterior pituitary) and cortisol (adrenal cortex);
# melatonin; the neuropeptides oxytocin and BDNF.
struct RyHormonalState {
    crh: f64;
    acth: f64;
    cortisol: f64;
    melatonin: f64;
    oxytocin: f64;
    bdnf: f64;
}

# Kinetic parameters, in compressed simulation time: the HPA axis's CRH basal rate, stress gain and degradation
# rate, ACTH's Vmax, Km for CRH and degradation rate, cortisol's Vmax, Km for ACTH, degradation rate and the
# hypothalamic feedback Ki; NAT's Vmax and Km for serotonin, melatonin's degradation rate and light sensitivity;
# oxytocin's basal rate, stimulus gain and degradation rate; BDNF's basal rate, activity gain and degradation rate.
# The Kms and the Ki are divisors (> 0); every other parameter is >= 0.
struct RyHormonalConfig {
    crh_basal_rate: f64;
    crh_stress_gain: f64;
    crh_degradation_rate: f64;
    acth_vmax: f64;
    acth_km_crh: f64;
    acth_degradation_rate: f64;
    cortisol_vmax: f64;
    cortisol_km_acth: f64;
    cortisol_degradation_rate: f64;
    cortisol_feedback_ki: f64;
    nat_vmax: f64;
    nat_km_serotonin: f64;
    melatonin_degradation_rate: f64;
    melatonin_light_sensitivity: f64;
    oxytocin_basal_rate: f64;
    oxytocin_stimulus_gain: f64;
    oxytocin_degradation_rate: f64;
    bdnf_basal_rate: f64;
    bdnf_activity_gain: f64;
    bdnf_degradation_rate: f64;
}

# The external stimuli: stress (0 none, 1+ stressed; drives CRH), serotonin (melatonin's precursor), light (0 dark, 1
# bright; clamped into [0, 1] by the tick, suppresses melatonin), social contact (drives oxytocin) and neural or
# physical activity (1 at rest; drives BDNF).
struct RyHormonalInput {
    stress: f64;
    serotonin: f64;
    light: f64;
    social_stimulus: f64;
    neural_activity: f64;
}

# One tick's rates: cortisol's net change (synthesis − degradation) at the start of the step, melatonin synthesis,
# oxytocin release, BDNF production; zero for an invalid dt.
struct RyHormonalFlux {
    cortisol_net: f64;
    melatonin_synthesis: f64;
    oxytocin_release: f64;
    bdnf_production: f64;
}

# ── defaults ──

# Fills *out with Rust's HormonalState::default() (src/hormonal_data.cyr).
fn ry_hormonal_state_default(out: *RyHormonalState) {
    out.crh = RY_HORMONAL_HORMONAL_STATE_DEFAULT_CRH;
    out.acth = RY_HORMONAL_HORMONAL_STATE_DEFAULT_ACTH;
    out.cortisol = RY_HORMONAL_HORMONAL_STATE_DEFAULT_CORTISOL;
    out.melatonin = RY_HORMONAL_HORMONAL_STATE_DEFAULT_MELATONIN;
    out.oxytocin = RY_HORMONAL_HORMONAL_STATE_DEFAULT_OXYTOCIN;
    out.bdnf = RY_HORMONAL_HORMONAL_STATE_DEFAULT_BDNF;
    return 0;
}

# Fills *out with Rust's HormonalConfig::default() (src/hormonal_data.cyr): the 20 defaults in declaration order.
fn ry_hormonal_config_default(out: *RyHormonalConfig) {
    out.crh_basal_rate = RY_HORMONAL_HORMONAL_CONFIG_DEFAULT_CRH_BASAL_RATE;
    out.crh_stress_gain = RY_HORMONAL_HORMONAL_CONFIG_DEFAULT_CRH_STRESS_GAIN;
    out.crh_degradation_rate = RY_HORMONAL_HORMONAL_CONFIG_DEFAULT_CRH_DEGRADATION_RATE;
    out.acth_vmax = RY_HORMONAL_HORMONAL_CONFIG_DEFAULT_ACTH_VMAX;
    out.acth_km_crh = RY_HORMONAL_HORMONAL_CONFIG_DEFAULT_ACTH_KM_CRH;
    out.acth_degradation_rate = RY_HORMONAL_HORMONAL_CONFIG_DEFAULT_ACTH_DEGRADATION_RATE;
    out.cortisol_vmax = RY_HORMONAL_HORMONAL_CONFIG_DEFAULT_CORTISOL_VMAX;
    out.cortisol_km_acth = RY_HORMONAL_HORMONAL_CONFIG_DEFAULT_CORTISOL_KM_ACTH;
    out.cortisol_degradation_rate = RY_HORMONAL_HORMONAL_CONFIG_DEFAULT_CORTISOL_DEGRADATION_RATE;
    out.cortisol_feedback_ki = RY_HORMONAL_HORMONAL_CONFIG_DEFAULT_CORTISOL_FEEDBACK_KI;
    out.nat_vmax = RY_HORMONAL_HORMONAL_CONFIG_DEFAULT_NAT_VMAX;
    out.nat_km_serotonin = RY_HORMONAL_HORMONAL_CONFIG_DEFAULT_NAT_KM_SEROTONIN;
    out.melatonin_degradation_rate = RY_HORMONAL_HORMONAL_CONFIG_DEFAULT_MELATONIN_DEGRADATION_RATE;
    out.melatonin_light_sensitivity = RY_HORMONAL_HORMONAL_CONFIG_DEFAULT_MELATONIN_LIGHT_SENSITIVITY;
    out.oxytocin_basal_rate = RY_HORMONAL_HORMONAL_CONFIG_DEFAULT_OXYTOCIN_BASAL_RATE;
    out.oxytocin_stimulus_gain = RY_HORMONAL_HORMONAL_CONFIG_DEFAULT_OXYTOCIN_STIMULUS_GAIN;
    out.oxytocin_degradation_rate = RY_HORMONAL_HORMONAL_CONFIG_DEFAULT_OXYTOCIN_DEGRADATION_RATE;
    out.bdnf_basal_rate = RY_HORMONAL_HORMONAL_CONFIG_DEFAULT_BDNF_BASAL_RATE;
    out.bdnf_activity_gain = RY_HORMONAL_HORMONAL_CONFIG_DEFAULT_BDNF_ACTIVITY_GAIN;
    out.bdnf_degradation_rate = RY_HORMONAL_HORMONAL_CONFIG_DEFAULT_BDNF_DEGRADATION_RATE;
    return 0;
}

# Fills *out with Rust's HormonalInput::default() (src/hormonal_data.cyr): no stress, serotonin 1, dark, alone, at
# rest.
fn ry_hormonal_input_default(out: *RyHormonalInput) {
    out.stress = RY_HORMONAL_HORMONAL_INPUT_DEFAULT_STRESS;
    out.serotonin = RY_HORMONAL_HORMONAL_INPUT_DEFAULT_SEROTONIN;
    out.light = RY_HORMONAL_HORMONAL_INPUT_DEFAULT_LIGHT;
    out.social_stimulus = RY_HORMONAL_HORMONAL_INPUT_DEFAULT_SOCIAL_STIMULUS;
    out.neural_activity = RY_HORMONAL_HORMONAL_INPUT_DEFAULT_NEURAL_ACTIVITY;
    return 0;
}

# Fills *out with Rust's HormonalFlux::default(): every rate 0.
fn ry_hormonal_flux_default(out: *RyHormonalFlux) {
    out.cortisol_net = 0.0;
    out.melatonin_synthesis = 0.0;
    out.oxytocin_release = 0.0;
    out.bdnf_production = 0.0;
    return 0;
}

# ── validation ──

# Ok(0) when every level is finite and >= 0; else the first failing one's Err, in declaration order. Mirrors
# `HormonalState::validate`.
#must_use
fn ry_hormonal_state_validate(p: *RyHormonalState): Result {
    var w = p;                                   # a plain address: `p + n` would step n states
    var name = &_RY_HORMONAL_STATE_FIELDS;
    var k = 0;
    while (k < 6) {
        var value: f64 = load64(w + 8 * k);
        var t, v = _ry_guard_non_negative(name, value);
        if (is_err_result(t) == 1) { return Err(v); }
        name = name + strlen(name) + 1;
        k = k + 1;
    }
    return Ok(0);
}

# 1 when config field `k` is a divisor (a Km or the feedback Ki, must be > 0), else 0 (>= 0).
#must_use
#pure
fn _ry_hormonal_is_divisor(k): i64 {
    if (k == 4 || k == 7 || k == 9 || k == 11) { return 1; }
    return 0;
}

# Ok(0) when every rate, gain, Vmax and the light sensitivity are finite and >= 0 and the three Kms and the feedback
# Ki finite and > 0; else the first failure's Err, in Rust's check order: the 16 others in declaration order first,
# then the four divisors. Mirrors `HormonalConfig::validate`.
#must_use
fn ry_hormonal_config_validate(p: *RyHormonalConfig): Result {
    var w = p;
    var pass = 0;
    while (pass < 2) {
        var name = &_RY_HORMONAL_CONFIG_FIELDS;
        var k = 0;
        while (k < 20) {
            if (_ry_hormonal_is_divisor(k) == pass) {
                var value: f64 = load64(w + 8 * k);
                var t = 0;
                var v = 0;
                if (pass == 1) {
                    t, v = _ry_guard_positive(name, value);
                } else {
                    t, v = _ry_guard_non_negative(name, value);
                }
                if (is_err_result(t) == 1) { return Err(v); }
            }
            name = name + strlen(name) + 1;
            k = k + 1;
        }
        pass = pass + 1;
    }
    return Ok(0);
}

# ── the dynamics ──

# Advances every hormone by `dt` seconds under the stimuli *input and fills *out with the flux, the pituitary arm at
# feedback Ki `acth_feedback_ki` (an infinite Ki makes its factor exactly 1: the hypothalamic-only model, bit for
# bit). The inputs are sanitized (`conc`; light by `unit`); the HPA stages run CRH → ACTH → cortisol, each driven by
# the freshly updated upstream level, both feedback arms reading the start-of-step cortisol; then melatonin, oxytocin
# and BDNF, every level by `produce_decay`. A non-finite or non-positive dt leaves the state untouched with a zero
# flux (and a trace event saying so). Mirrors the private `HormonalState::tick_with_acth_feedback`.
fn _ry_hormonal_state_tick_with_acth_feedback(p: *RyHormonalState, c: *RyHormonalConfig, input: *RyHormonalInput,
  dt: f64, acth_feedback_ki: f64, out: *RyHormonalFlux) {
    if (_ry_guard_valid_dt(dt) == 0) {
        if (_ry_trace_on() == 1) {
            _ry_trace_f1("rasayan::hormonal", "hormonal_tick skipped: invalid dt", "dt", dt);
        }
        ry_hormonal_flux_default(out);
        return 0;
    }
    var stress: f64 = _ry_guard_conc(input.stress);
    var serotonin: f64 = _ry_guard_conc(input.serotonin);
    var light: f64 = _ry_guard_unit(input.light);
    var social_stimulus: f64 = _ry_guard_conc(input.social_stimulus);
    var neural_activity: f64 = _ry_guard_conc(input.neural_activity);
    var cort0: f64 = p.cortisol;
    if (_ry_trace_on() == 1) {
        _ry_trace_f3("rasayan::hormonal", "hormonal_tick", "dt", dt, "stress", stress, "cortisol", cort0);
    }
    # The HPA axis: CRH → ACTH → cortisol with negative feedback. CRH: basal + stress-driven, inhibited by cortisol
    # (the hypothalamic arm).
    var hypo_q: f64 = cort0 / c.cortisol_feedback_ki;
    var cortisol_inhibition: f64 = 1.0 / (1.0 + hypo_q);
    var crh_drive: f64 = c.crh_basal_rate + c.crh_stress_gain * stress;
    var v_crh: f64 = crh_drive * cortisol_inhibition;
    var crh: f64 = _ry_integrate_produce_decay(p.crh, v_crh, c.crh_degradation_rate, dt);
    p.crh = crh;
    # ACTH: driven by CRH, inhibited by cortisol (the pituitary arm).
    var pit_q: f64 = cort0 / acth_feedback_ki;
    var pituitary_inhibition: f64 = 1.0 / (1.0 + pit_q);
    var acth_mm: f64 = ry_michaelis_menten(crh, c.acth_vmax, c.acth_km_crh);
    var v_acth: f64 = acth_mm * pituitary_inhibition;
    var acth: f64 = _ry_integrate_produce_decay(p.acth, v_acth, c.acth_degradation_rate, dt);
    p.acth = acth;
    # Cortisol: driven by ACTH.
    var v_cortisol: f64 = ry_michaelis_menten(acth, c.cortisol_vmax, c.cortisol_km_acth);
    var cortisol_net: f64 = v_cortisol - c.cortisol_degradation_rate * cort0;
    var cort: f64 = _ry_integrate_produce_decay(cort0, v_cortisol, c.cortisol_degradation_rate, dt);
    p.cortisol = cort;
    # Melatonin: serotonin → melatonin, suppressed by light.
    var light_suppression: f64 = 1.0 / (1.0 + light * c.melatonin_light_sensitivity);
    var nat: f64 = c.nat_vmax * light_suppression;
    var v_melatonin: f64 = ry_michaelis_menten(serotonin, nat, c.nat_km_serotonin);
    var mel: f64 = _ry_integrate_produce_decay(p.melatonin, v_melatonin, c.melatonin_degradation_rate, dt);
    p.melatonin = mel;
    # Oxytocin: basal + social stimulus.
    var v_oxytocin: f64 = c.oxytocin_basal_rate + c.oxytocin_stimulus_gain * social_stimulus;
    var oxy: f64 = _ry_integrate_produce_decay(p.oxytocin, v_oxytocin, c.oxytocin_degradation_rate, dt);
    p.oxytocin = oxy;
    # BDNF: basal + activity-dependent.
    var above_rest: f64 = _ry_max(neural_activity - 1.0, 0.0);
    var v_bdnf: f64 = c.bdnf_basal_rate + c.bdnf_activity_gain * above_rest;
    var bdnf: f64 = _ry_integrate_produce_decay(p.bdnf, v_bdnf, c.bdnf_degradation_rate, dt);
    p.bdnf = bdnf;
    out.cortisol_net = cortisol_net;
    out.melatonin_synthesis = v_melatonin;
    out.oxytocin_release = v_oxytocin;
    out.bdnf_production = v_bdnf;
    return 0;
}

# Advances every hormone by `dt` seconds under the stimuli *input and fills *out with the flux: the HPA axis with
# both feedback arms (the pituitary arm at RY_HORMONAL_ACTH_FEEDBACK_KI), then melatonin, oxytocin and BDNF. A
# non-finite or non-positive dt leaves the state untouched with a zero flux; NaN, infinite or negative inputs are 0,
# light is clamped into [0, 1]. Mirrors `HormonalState::tick`.
fn ry_hormonal_state_tick(p: *RyHormonalState, c: *RyHormonalConfig, input: *RyHormonalInput, dt: f64,
  out: *RyHormonalFlux) {
    _ry_hormonal_state_tick_with_acth_feedback(p, c, input, dt, RY_HORMONAL_ACTH_FEEDBACK_KI, out);
    return 0;
}

# ── the bridge functions (plain f64 outputs for mastishk and bhava) ──

# Cortisol's production rate from the HPA inputs with one lumped negative feedback, on the default kinetics: a
# CRH-driven ACTH drive (MM(crh; Vmax 0.1, Km 0.5)) added to `acth` drives adrenal synthesis (MM(·; Vmax 0.08, Km
# 0.5)), divided by 1 + feedback / 2. A rate in [0, 0.08), not a level, independent of the tick (no pituitary arm);
# NaN, infinite or negative inputs are 0. Mirrors `cortisol_from_hpa`.
#must_use
#pure
fn ry_cortisol_from_hpa(crh: f64, acth: f64, feedback: f64): f64 {
    var crh_c: f64 = _ry_guard_conc(crh);
    var acth_drive: f64 = ry_michaelis_menten(crh_c, 0.1, 0.5);
    var acth_c: f64 = _ry_guard_conc(acth);
    var effective_acth: f64 = acth_drive + acth_c;
    var cortisol_drive: f64 = ry_michaelis_menten(effective_acth, 0.08, 0.5);
    var fb: f64 = _ry_guard_conc(feedback);
    var r: f64 = cortisol_drive / (1.0 + fb / 2.0);
    return r;
}

# Melatonin's synthesis rate from serotonin under light, on the default kinetics (NAT Vmax 0.05, Km 0.5, light
# sensitivity 5): 0.05 · nat_activity · serotonin / (0.5 + serotonin) / (1 + 5 · light). `light_suppression` is the
# light intensity in [0, 1] (clamped, NaN 0); NaN, infinite or negative serotonin and NAT activity are 0. Mirrors
# `melatonin_from_serotonin`.
#must_use
#pure
fn ry_melatonin_from_serotonin(serotonin: f64, nat_activity: f64, light_suppression: f64): f64 {
    var light: f64 = _ry_guard_unit(light_suppression);
    var light_factor: f64 = 1.0 / (1.0 + light * 5.0);
    var sero: f64 = _ry_guard_conc(serotonin);
    var act: f64 = _ry_guard_conc(nat_activity);
    var vmax: f64 = 0.05 * act * light_factor;
    var r: f64 = ry_michaelis_menten(sero, vmax, 0.5);
    return r;
}

# ── JSON (P7: serde_json's documents) ──

# Appends HormonalState `p` as serde_json writes it, its six levels in declaration order, on allocator `a`: Ok(0), or
# Err(RY_ERR_OUT_OF_MEMORY) when the builder could not grow.
#must_use
fn ry_hormonal_state_to_json_a(a, sb, p: *RyHormonalState): Result {
    if (_ry_jw_f64_fields(a, sb, p, 6, &_RY_HORMONAL_STATE_FIELDS) != 0) { return Err(RY_ERR_OUT_OF_MEMORY); }
    return Ok(0);
}

# ry_hormonal_state_to_json_a on the default allocator (a builder from str_builder_new).
#must_use
fn ry_hormonal_state_to_json(sb, p: *RyHormonalState): Result {
    return ry_hormonal_state_to_json_a(default_alloc(), sb, p);
}

# The HormonalState at node `v` of a parsed document, by serde's rules, into the 48 bytes at `w`: 1, or 0 for a
# refusal.
#must_use
fn _ry_hormonal_state_from_node(v, w): i64 {
    return _ry_jr_f64_fields(v, w, 6, &_RY_HORMONAL_STATE_FIELDS);
}

# Reads a HormonalState from the `n`-byte document at `buf` by serde's rules (its tree on allocator `a`): Ok(0) with
# *out filled, or Err(RY_ERR_DESERIALIZE) with *out untouched.
#must_use
fn ry_hormonal_state_from_json_a(a, buf, n, out: *RyHormonalState): Result {
    var w[48];
    var v = _ry_jr_parse(a, buf, n);
    if (_ry_hormonal_state_from_node(v, &w) == 0) {
        return Err(_ry_fail_text(RY_ERR_DESERIALIZE, "HormonalState", 13));
    }
    memcpy(out, &w, 48);
    return Ok(0);
}

# ry_hormonal_state_from_json_a on the default allocator (the tree is never freed: for a one-off read).
#must_use
fn ry_hormonal_state_from_json(buf, n, out: *RyHormonalState): Result {
    return ry_hormonal_state_from_json_a(default_alloc(), buf, n, out);
}

# Appends HormonalConfig `p` as serde_json writes it, its 20 parameters in declaration order, on allocator `a`: Ok(0),
# or Err(RY_ERR_OUT_OF_MEMORY).
#must_use
fn ry_hormonal_config_to_json_a(a, sb, p: *RyHormonalConfig): Result {
    if (_ry_jw_f64_fields(a, sb, p, 20, &_RY_HORMONAL_CONFIG_FIELDS) != 0) { return Err(RY_ERR_OUT_OF_MEMORY); }
    return Ok(0);
}

# ry_hormonal_config_to_json_a on the default allocator.
#must_use
fn ry_hormonal_config_to_json(sb, p: *RyHormonalConfig): Result {
    return ry_hormonal_config_to_json_a(default_alloc(), sb, p);
}

# The HormonalConfig at node `v` of a parsed document, by serde's rules, into the 160 bytes at `w`: 1, or 0 for a
# refusal.
#must_use
fn _ry_hormonal_config_from_node(v, w): i64 {
    return _ry_jr_f64_fields(v, w, 20, &_RY_HORMONAL_CONFIG_FIELDS);
}

# Reads a HormonalConfig from the `n`-byte document at `buf` by serde's rules (its tree on allocator `a`): Ok(0) with
# *out filled, or Err(RY_ERR_DESERIALIZE) with *out untouched.
#must_use
fn ry_hormonal_config_from_json_a(a, buf, n, out: *RyHormonalConfig): Result {
    var w[160];
    var v = _ry_jr_parse(a, buf, n);
    if (_ry_hormonal_config_from_node(v, &w) == 0) {
