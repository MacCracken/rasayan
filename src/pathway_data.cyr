# ADP concentration (mM).
# Rust: rasayan::pathway::MetabolicNetwork::default().adp
const RY_PATHWAY_METABOLIC_NETWORK_DEFAULT_ADP = 0.5;

# NAD+/NADH ratio.
# Rust: rasayan::pathway::MetabolicNetwork::default().nad_ratio
const RY_PATHWAY_METABOLIC_NETWORK_DEFAULT_NAD_RATIO = 700.0;

# Oxygen availability (normalized 0.0-1.0).
# Rust: rasayan::pathway::MetabolicNetwork::default().oxygen
const RY_PATHWAY_METABOLIC_NETWORK_DEFAULT_OXYGEN = 1.0;

# Malonyl-CoA (mM). Fed-state signal, inhibits beta-oxidation.
# Rust: rasayan::pathway::MetabolicNetwork::default().malonyl_coa
const RY_PATHWAY_METABOLIC_NETWORK_DEFAULT_MALONYL_COA = 0.01;

# Configuration for all pathways in the metabolic network.
# Rust: rasayan::pathway::NetworkConfig::default()

# Unused since 1.2.0, kept for compatibility: the NAD+/NADH ratio now
# follows an explicit NADH pool ([`NAD_POOL_TOTAL`]) instead of a
# sensitivity heuristic. Still validated as finite and `>= 0`.
# Rust: rasayan::pathway::NetworkConfig::default().nad_ratio_sensitivity
const RY_PATHWAY_NETWORK_CONFIG_DEFAULT_NAD_RATIO_SENSITIVITY = 50.0;

# What the cell's surroundings supply and demand, held constant over a
# tick.
#
# [`MetabolicNetwork::tick`] uses [`NetworkEnvironment::default`] (a
# resting cell); [`MetabolicNetwork::tick_in`] takes any environment, e.g.
# exercise (`atp_demand` from [`crate::energy::atp_demand_from_power`]) or
# fasting (lower `plasma_glucose`).
# Rust: rasayan::pathway::NetworkEnvironment::default()

# ATP hydrolysed by cellular work — ion pumps, synthesis, contraction
# (mM/s). ATP → ADP before the pools are updated.
# Rust: rasayan::pathway::NetworkEnvironment::default().atp_demand
const RY_PATHWAY_NETWORK_ENVIRONMENT_DEFAULT_ATP_DEMAND = 1.2;

# Plasma glucose (mM) the cell's glucose pool relaxes toward.
# Rust: rasayan::pathway::NetworkEnvironment::default().plasma_glucose
const RY_PATHWAY_NETWORK_ENVIRONMENT_DEFAULT_PLASMA_GLUCOSE = 5.0;

# Plasma free fatty acid (mM) the cell's FFA pool relaxes toward.
# Rust: rasayan::pathway::NetworkEnvironment::default().plasma_fatty_acids
const RY_PATHWAY_NETWORK_ENVIRONMENT_DEFAULT_PLASMA_FATTY_ACIDS = 0.3;

# Plasma amino acids (mM) the cell's amino acid pool relaxes toward.
# Rust: rasayan::pathway::NetworkEnvironment::default().plasma_amino_acids
const RY_PATHWAY_NETWORK_ENVIRONMENT_DEFAULT_PLASMA_AMINO_ACIDS = 2.0;

