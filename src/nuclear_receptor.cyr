# rasayan — src/nuclear_receptor.cyr: nuclear receptor signaling (rust-old/src/nuclear_receptor.rs)
#
# Steroid and thyroid hormone receptors: a hormone binds a cytoplasmic receptor, the receptor-ligand complex
# translocates to the nucleus, binds DNA and drives gene expression with a characteristic delay.
#
# Total receptor is 1. The free (unbound) pool is implicit, 1 − bound_cytoplasmic − nuclear_active
# (ry_nuclear_receptor_state_free_receptor): binding draws from it, dissociation and nuclear export return to it, so
# bound_cytoplasmic + nuclear_active <= 1 is preserved. Within a tick each pool's outflow is capped at the pool.
#
# The Cyrius forms (ADR 0002 row 7): the state advances in place and the flux fills the caller's record. Every
# operation is in the source's order (P9).

# ── the types ──

# Nuclear receptor signaling state: the cytoplasmic receptor-ligand complex and the nuclear (active transcription
# factor) complex, both fractions of total receptor; gene expression (normalized, the delayed output).
struct RyNuclearReceptorState {
    bound_cytoplasmic: f64;
    nuclear_active: f64;
    gene_expression: f64;
}

# Kinetic parameters for nuclear receptor signaling: binding Vmax (s^-1 per unit free receptor) and its Km for the
# hormone (> 0), dissociation, nuclear translocation and export rates (s^-1), the transcription rate driven by the
# nuclear complex, the expression decay rate (s^-1).
struct RyNuclearReceptorConfig {
    binding_vmax: f64;
    binding_km: f64;
    dissociation_rate: f64;
    translocation_rate: f64;
    export_rate: f64;
    transcription_rate: f64;
    expression_decay_rate: f64;
}

# Nuclear receptor flux: binding and translocation as the mean over the tick (amount moved / dt), transcription as
# the rate at the start of the tick; zero for an invalid dt.
struct RyNuclearReceptorFlux {
    binding: f64;
    translocation: f64;
    transcription: f64;
}

# ── defaults ──

# Fills *out with Rust's NuclearReceptorState::default() (src/nuclear_receptor_data.cyr).
fn ry_nuclear_receptor_state_default(out: *RyNuclearReceptorState) {
    out.bound_cytoplasmic = RY_NUCLEAR_RECEPTOR_NUCLEAR_RECEPTOR_STATE_DEFAULT_BOUND_CYTOPLASMIC;
    out.nuclear_active = RY_NUCLEAR_RECEPTOR_NUCLEAR_RECEPTOR_STATE_DEFAULT_NUCLEAR_ACTIVE;
    out.gene_expression = RY_NUCLEAR_RECEPTOR_NUCLEAR_RECEPTOR_STATE_DEFAULT_GENE_EXPRESSION;
    return 0;
}

# Fills *out with Rust's NuclearReceptorConfig::default() (src/nuclear_receptor_data.cyr).
fn ry_nuclear_receptor_config_default(out: *RyNuclearReceptorConfig) {
    out.binding_vmax = RY_NUCLEAR_RECEPTOR_NUCLEAR_RECEPTOR_CONFIG_DEFAULT_BINDING_VMAX;
    out.binding_km = RY_NUCLEAR_RECEPTOR_NUCLEAR_RECEPTOR_CONFIG_DEFAULT_BINDING_KM;
    out.dissociation_rate = RY_NUCLEAR_RECEPTOR_NUCLEAR_RECEPTOR_CONFIG_DEFAULT_DISSOCIATION_RATE;
    out.translocation_rate = RY_NUCLEAR_RECEPTOR_NUCLEAR_RECEPTOR_CONFIG_DEFAULT_TRANSLOCATION_RATE;
    out.export_rate = RY_NUCLEAR_RECEPTOR_NUCLEAR_RECEPTOR_CONFIG_DEFAULT_EXPORT_RATE;
    out.transcription_rate = RY_NUCLEAR_RECEPTOR_NUCLEAR_RECEPTOR_CONFIG_DEFAULT_TRANSCRIPTION_RATE;
    out.expression_decay_rate = RY_NUCLEAR_RECEPTOR_NUCLEAR_RECEPTOR_CONFIG_DEFAULT_EXPRESSION_DECAY_RATE;
    return 0;
}

# Fills *out with Rust's NuclearReceptorFlux::default(): every value 0.
fn ry_nuclear_receptor_flux_default(out: *RyNuclearReceptorFlux) {
    out.binding = 0.0;
    out.translocation = 0.0;
    out.transcription = 0.0;
    return 0;
}

# ── the state ──

# Ok(0) when both receptor fractions are finite and in [0, 1] and gene expression is finite and >= 0; else the first
# failing field's Err, in declaration order. Mirrors `NuclearReceptorState::validate`.
#must_use
fn ry_nuclear_receptor_state_validate(p: *RyNuclearReceptorState): Result {
    var w = p;                                   # a plain address: `p + n` would step n states
    var name = &_RY_NUCLEAR_RECEPTOR_STATE_FIELDS;
    var k = 0;
    while (k < 3) {
        var value: f64 = load64(w + 8 * k);
        var t = 0;
        var v = 0;
        if (k == 2) {
            t, v = _ry_guard_non_negative(name, value);
        } else {
            t, v = _ry_guard_fraction(name, value);
        }
        if (is_err_result(t) == 1) { return Err(v); }
        name = name + strlen(name) + 1;
        k = k + 1;
    }
    return Ok(0);
}

# The free (unbound, cytoplasmic) receptor fraction, 1 − bound_cytoplasmic − nuclear_active, floored at 0. Mirrors
# `NuclearReceptorState::free_receptor`.
#must_use
#pure
fn ry_nuclear_receptor_state_free_receptor(p: *RyNuclearReceptorState): f64 {
    var rest: f64 = 1.0 - p.bound_cytoplasmic - p.nuclear_active;
    var r: f64 = _ry_max(rest, 0.0);
    return r;
}

# Ok(0) when every parameter is finite, the rates >= 0 and binding_km > 0; else the first failure's Err, in
# declaration order. Mirrors `NuclearReceptorConfig::validate`.
#must_use
fn ry_nuclear_receptor_config_validate(p: *RyNuclearReceptorConfig): Result {
    var w = p;
    var name = &_RY_NUCLEAR_RECEPTOR_CONFIG_FIELDS;
    var k = 0;
    while (k < 7) {
        var value: f64 = load64(w + 8 * k);
        var t = 0;
        var v = 0;
        if (k == 1) {
            t, v = _ry_guard_positive(name, value);
        } else {
            t, v = _ry_guard_non_negative(name, value);
        }
        if (is_err_result(t) == 1) { return Err(v); }
        name = name + strlen(name) + 1;
        k = k + 1;
    }
    return Ok(0);
}

# ── the dynamics ──

# Advances nuclear receptor signaling by `dt` seconds at hormone level `hormone_in` (sanitized by `conc`: NaN and
# negatives are 0) and fills *out with the flux: binding from the free pool (capped at it), dissociation and
# translocation from the bound complex (capped together at it), export from the nucleus (capped), then the pools; gene
# expression by `produce_decay` from the start-of-step nuclear level. A non-finite or non-positive dt leaves the state
# untouched with a zero flux. Mirrors `NuclearReceptorState::tick`.
fn ry_nuclear_receptor_state_tick(p: *RyNuclearReceptorState, c: *RyNuclearReceptorConfig, hormone_in: f64, dt: f64,
  out: *RyNuclearReceptorFlux) {
    if (_ry_guard_valid_dt(dt) == 0) {
        ry_nuclear_receptor_flux_default(out);
        return 0;
    }
    var hormone: f64 = _ry_guard_conc(hormone_in);
    if (_ry_trace_on() == 1) {
        var hd[24];
        var b[256];
        var e = _ry_ev(&hd, &b, 256, "rasayan::nuclear_receptor", "nuclear_receptor_tick");
        _ry_ev_f(e, "dt", dt);
        _ry_ev_f(e, "hormone", hormone);
        _ry_ev_f(e, "nuclear", p.nuclear_active);
        _ry_trace(e);
    }
    # Ligand binding in the cytoplasm: free → bound, capped at the free pool.
    var k_bind: f64 = ry_michaelis_menten(hormone, c.binding_vmax, c.binding_km);
    var free: f64 = ry_nuclear_receptor_state_free_receptor(p);
    var y: f64 = k_bind * dt;
    var share: f64 = _ry_min(y, 1.0);
    var bind: f64 = free * share;
    # The bound complex: dissociation (→ free) and translocation (→ nucleus), together capped at the bound pool.
    var bound: f64 = p.bound_cytoplasmic;
    var dissoc: f64 = c.dissociation_rate * bound * dt;
    var translocate: f64 = c.translocation_rate * bound * dt;
    var leaving: f64 = dissoc + translocate;
    if (leaving > bound && leaving > 0.0) {
        var room: f64 = _ry_max(bound, 0.0);
        var s: f64 = room / leaving;
        dissoc = dissoc * s;
        translocate = translocate * s;
    }
    # Nuclear export: nucleus → free pool, capped at the nuclear pool.
    var ye: f64 = c.export_rate * dt;
    var we: f64 = _ry_min(ye, 1.0);
    var export: f64 = p.nuclear_active * we;
    # Gene expression (the delayed output), driven by the start-of-step nuclear level.
    var v_transcribe: f64 = c.transcription_rate * p.nuclear_active;
    var d_bound: f64 = bind - dissoc - translocate;
    var d_nuclear: f64 = translocate - export;
    var nb: f64 = p.bound_cytoplasmic + d_bound;
    var nn: f64 = p.nuclear_active + d_nuclear;
    p.bound_cytoplasmic = nb;
    p.nuclear_active = nn;
    var expr: f64 = _ry_integrate_produce_decay(p.gene_expression, v_transcribe, c.expression_decay_rate, dt);
    p.gene_expression = expr;
    out.binding = bind / dt;
    out.translocation = translocate / dt;
    out.transcription = v_transcribe;
    return 0;
}

# ── JSON (P7: serde_json's documents) ──

# Appends NuclearReceptorState `p` as serde_json writes it, its three fields in declaration order, on allocator `a`:
# Ok(0), or Err(RY_ERR_OUT_OF_MEMORY) when the builder could not grow.
#must_use
fn ry_nuclear_receptor_state_to_json_a(a, sb, p: *RyNuclearReceptorState): Result {
    if (_ry_jw_f64_fields(a, sb, p, 3, &_RY_NUCLEAR_RECEPTOR_STATE_FIELDS) != 0) { return Err(RY_ERR_OUT_OF_MEMORY); }
    return Ok(0);
}

# ry_nuclear_receptor_state_to_json_a on the default allocator (a builder from str_builder_new).
#must_use
fn ry_nuclear_receptor_state_to_json(sb, p: *RyNuclearReceptorState): Result {
    return ry_nuclear_receptor_state_to_json_a(default_alloc(), sb, p);
}

# The NuclearReceptorState at node `v` of a parsed document, by serde's rules, into the 24 bytes at `w`: 1, or 0 for a
# refusal. The signaling network's readers call it for its nested value.
#must_use
fn _ry_nuclear_receptor_state_from_node(v, w): i64 {
    return _ry_jr_f64_fields(v, w, 3, &_RY_NUCLEAR_RECEPTOR_STATE_FIELDS);
}

# Reads a NuclearReceptorState from the `n`-byte document at `buf` by serde's rules (its tree on allocator `a`): Ok(0)
# with *out filled, or Err(RY_ERR_DESERIALIZE) with *out untouched.
#must_use
fn ry_nuclear_receptor_state_from_json_a(a, buf, n, out: *RyNuclearReceptorState): Result {
    var w[24];
    var v = _ry_jr_parse(a, buf, n);
    if (_ry_nuclear_receptor_state_from_node(v, &w) == 0) {
        return Err(_ry_fail_text(RY_ERR_DESERIALIZE, "NuclearReceptorState", 20));
    }
    memcpy(out, &w, 24);
    return Ok(0);
}

# ry_nuclear_receptor_state_from_json_a on the default allocator (the tree is never freed: for a one-off read).
#must_use
fn ry_nuclear_receptor_state_from_json(buf, n, out: *RyNuclearReceptorState): Result {
    return ry_nuclear_receptor_state_from_json_a(default_alloc(), buf, n, out);
}

# Appends NuclearReceptorConfig `p` as serde_json writes it, its seven parameters in declaration order, on allocator
# `a`: Ok(0), or Err(RY_ERR_OUT_OF_MEMORY).
#must_use
fn ry_nuclear_receptor_config_to_json_a(a, sb, p: *RyNuclearReceptorConfig): Result {
    if (_ry_jw_f64_fields(a, sb, p, 7, &_RY_NUCLEAR_RECEPTOR_CONFIG_FIELDS) != 0) { return Err(RY_ERR_OUT_OF_MEMORY); }
    return Ok(0);
}

# ry_nuclear_receptor_config_to_json_a on the default allocator.
#must_use
fn ry_nuclear_receptor_config_to_json(sb, p: *RyNuclearReceptorConfig): Result {
