}

# The NuclearReceptorConfig at node `v` of a parsed document, by serde's rules, into the 56 bytes at `w`: 1, or 0 for
# a refusal.
#must_use
fn _ry_nuclear_receptor_config_from_node(v, w): i64 {
    return _ry_jr_f64_fields(v, w, 7, &_RY_NUCLEAR_RECEPTOR_CONFIG_FIELDS);
}

# Reads a NuclearReceptorConfig from the `n`-byte document at `buf` by serde's rules (its tree on allocator `a`):
# Ok(0) with *out filled, or Err(RY_ERR_DESERIALIZE) with *out untouched.
#must_use
fn ry_nuclear_receptor_config_from_json_a(a, buf, n, out: *RyNuclearReceptorConfig): Result {
