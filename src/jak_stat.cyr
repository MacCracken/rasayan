# rasayan — src/jak_stat.cyr: the JAK-STAT pathway (rust-old/src/jak_stat.rs)
#
# Cytokine → receptor → JAK phosphorylation → STAT phosphorylation → STAT dimerization → nuclear translocation, with
# SOCS (suppressors of cytokine signaling) induced by the dimers and inhibiting JAK: a delayed negative feedback.
#
# STAT is conserved: total STAT is 1, split into the unphosphorylated pool (1 − stat_phosphorylated − 2·stat_dimer),
# monomeric STAT-P and dimers of two STAT-P each, so stat_dimer never exceeds 0.5. JAK and STAT phosphorylation take
# the exact solution of their two-state ODEs over dt (integrate's `activate` and `relax`), dimerization a positivity-
# and mass-preserving (modified Patankar–Euler) step, SOCS exact production and decay, so a tick is stable for any dt.
#
# The Cyrius forms (ADR 0002 row 7): the state advances in place and the flux fills the caller's record. Every
# operation is in Rust's order (P9).

# ── the types ──

# JAK-STAT pathway activation state: active JAK as a fraction of total JAK; monomeric STAT-P and STAT-P dimers as
# fractions of total STAT monomer (stat_phosphorylated + 2·stat_dimer <= 1); SOCS (normalized, >= 0).
struct RyJakStatState {
    jak_active: f64;
    stat_phosphorylated: f64;
    stat_dimer: f64;
    socs: f64;
}

# Kinetic parameters for JAK-STAT: rates in s^-1 (JAK's and STAT's Vmax per unit of their inactive pools, the
# dimerization second-order in STAT-P, the dimer dissociation returning two STAT-P), the Km values and SOCS's Ki as
# levels (> 0).
struct RyJakStatConfig {
    jak_vmax: f64;
    jak_km: f64;
    jak_phosphatase_rate: f64;
    stat_vmax: f64;
    stat_km: f64;
    stat_phosphatase_rate: f64;
    dimer_rate: f64;
    dimer_decay_rate: f64;
    socs_induction_rate: f64;
    socs_degradation_rate: f64;
    socs_ki: f64;
}

# JAK-STAT pathway flux for a tick, per second: JAK and STAT phosphorylation at the start of the step, the gross dimer
# formation used for the step, SOCS induction by the dimers; zero for an invalid dt.
struct RyJakStatFlux {
    jak_phosphorylation: f64;
    stat_phosphorylation: f64;
    dimer_formation: f64;
    socs_induction: f64;
}

# ── defaults ──

# Fills *out with Rust's JakStatState::default() (src/jak_stat_data.cyr).
fn ry_jak_stat_state_default(out: *RyJakStatState) {
    out.jak_active = RY_JAK_STAT_JAK_STAT_STATE_DEFAULT_JAK_ACTIVE;
    out.stat_phosphorylated = RY_JAK_STAT_JAK_STAT_STATE_DEFAULT_STAT_PHOSPHORYLATED;
    out.stat_dimer = RY_JAK_STAT_JAK_STAT_STATE_DEFAULT_STAT_DIMER;
    out.socs = RY_JAK_STAT_JAK_STAT_STATE_DEFAULT_SOCS;
    return 0;
}

# Fills *out with Rust's JakStatConfig::default() (src/jak_stat_data.cyr).
fn ry_jak_stat_config_default(out: *RyJakStatConfig) {
    out.jak_vmax = RY_JAK_STAT_JAK_STAT_CONFIG_DEFAULT_JAK_VMAX;
    out.jak_km = RY_JAK_STAT_JAK_STAT_CONFIG_DEFAULT_JAK_KM;
    out.jak_phosphatase_rate = RY_JAK_STAT_JAK_STAT_CONFIG_DEFAULT_JAK_PHOSPHATASE_RATE;
    out.stat_vmax = RY_JAK_STAT_JAK_STAT_CONFIG_DEFAULT_STAT_VMAX;
    out.stat_km = RY_JAK_STAT_JAK_STAT_CONFIG_DEFAULT_STAT_KM;
    out.stat_phosphatase_rate = RY_JAK_STAT_JAK_STAT_CONFIG_DEFAULT_STAT_PHOSPHATASE_RATE;
    out.dimer_rate = RY_JAK_STAT_JAK_STAT_CONFIG_DEFAULT_DIMER_RATE;
    out.dimer_decay_rate = RY_JAK_STAT_JAK_STAT_CONFIG_DEFAULT_DIMER_DECAY_RATE;
    out.socs_induction_rate = RY_JAK_STAT_JAK_STAT_CONFIG_DEFAULT_SOCS_INDUCTION_RATE;
    out.socs_degradation_rate = RY_JAK_STAT_JAK_STAT_CONFIG_DEFAULT_SOCS_DEGRADATION_RATE;
    out.socs_ki = RY_JAK_STAT_JAK_STAT_CONFIG_DEFAULT_SOCS_KI;
    return 0;
}

# Fills *out with Rust's JakStatFlux::default(): every rate 0.
fn ry_jak_stat_flux_default(out: *RyJakStatFlux) {
    out.jak_phosphorylation = 0.0;
    out.stat_phosphorylation = 0.0;
    out.dimer_formation = 0.0;
    out.socs_induction = 0.0;
    return 0;
}

# ── validation ──

# Ok(0) when the JAK and STAT fractions are finite and in [0, 1] (each pool alone: the conservation law is not
# checked) and SOCS is finite and >= 0; else the first failing field's Err, in declaration order. Mirrors
# `JakStatState::validate`.
#must_use
fn ry_jak_stat_state_validate(p: *RyJakStatState): Result {
    var w = p;                                   # a plain address: `p + n` would step n states
    var name = &_RY_JAK_STAT_STATE_FIELDS;
    var k = 0;
    while (k < 4) {
        var value: f64 = load64(w + 8 * k);
        var t = 0;
        var v = 0;
        if (k == 3) {
            t, v = _ry_guard_non_negative(name, value);
        } else {
            t, v = _ry_guard_fraction(name, value);
        }
        if (is_err_result(t) == 1) { return Err(v); }
        name = name + strlen(name) + 1;
        k = k + 1;
    }
    return Ok(0);
}

# Ok(0) when every parameter is finite, the rates >= 0 and jak_km, stat_km and socs_ki > 0; else the first failure's
# Err, in declaration order. Mirrors `JakStatConfig::validate`.
#must_use
fn ry_jak_stat_config_validate(p: *RyJakStatConfig): Result {
    var w = p;
    var name = &_RY_JAK_STAT_CONFIG_FIELDS;
    var k = 0;
    while (k < 11) {
        var value: f64 = load64(w + 8 * k);
        var t = 0;
        var v = 0;
        if (k == 1 || k == 4 || k == 10) {
            t, v = _ry_guard_positive(name, value);
        } else {
            t, v = _ry_guard_non_negative(name, value);
        }
        if (is_err_result(t) == 1) { return Err(v); }
        name = name + strlen(name) + 1;
        k = k + 1;
    }
    return Ok(0);
}

# ── the pathway ──

# Advances JAK-STAT by `dt` seconds under cytokine receptor activation `cytokine` (clamped into [0, 1], NaN as 0) and
# fills *out with the tick's flux: JAK by the cytokine against its phosphatases, inhibited by SOCS; STAT-P from the
# unphosphorylated pool by the updated JAK, the dimers held; the dimerization 2 STAT-P ⇌ dimer by a modified
# Patankar–Euler step (STAT-P + 2·dimer conserved, both pools >= 0); SOCS induced by the new dimers. A non-finite or
# non-positive dt leaves the state untouched with a zero flux. Mirrors `JakStatState::tick`.
fn ry_jak_stat_state_tick(p: *RyJakStatState, c: *RyJakStatConfig, cytokine: f64, dt: f64, out: *RyJakStatFlux) {
    if (_ry_guard_valid_dt(dt) == 0) {
        ry_jak_stat_flux_default(out);
        return 0;
    }
    var cyt: f64 = _ry_guard_unit(cytokine);
    if (_ry_trace_on() == 1) {
        _ry_trace_f3("rasayan::jak_stat", "jak_stat_tick", "dt", dt, "cytokine", cyt, "stat_dimer", p.stat_dimer);
    }
    # SOCS inhibition of JAK.
    var socs_inhibition: f64 = 1.0 / (1.0 + p.socs / c.socs_ki);
    # JAK: activated by the cytokine receptor, inhibited by SOCS.
    var jak_mm: f64 = ry_michaelis_menten(cyt, c.jak_vmax, c.jak_km);
    var k_jak_on: f64 = jak_mm * socs_inhibition;
    var v_jak_on: f64 = k_jak_on * (1.0 - p.jak_active);
    var jak: f64 = _ry_integrate_activate(p.jak_active, k_jak_on, c.jak_phosphatase_rate, dt);
    p.jak_active = jak;
    # STAT: phosphorylated by JAK from the unphosphorylated pool (1 − 2·dimer − STAT-P), dephosphorylated back into it.
    # With the dimers held, STAT-P relaxes toward capacity · on / (on + off) at rate on + off.
    var free: f64 = 1.0 - 2.0 * p.stat_dimer;
    var capacity: f64 = _ry_max(free, 0.0);
    var k_stat_on: f64 = ry_michaelis_menten(jak, c.stat_vmax, c.stat_km);
    var k_stat_off: f64 = c.stat_phosphatase_rate;
    var room: f64 = capacity - p.stat_phosphorylated;
    var headroom: f64 = _ry_max(room, 0.0);
    var v_stat_on: f64 = k_stat_on * headroom;
    var k_stat: f64 = k_stat_on + k_stat_off;
    if (k_stat > 0.0) {
        var target: f64 = capacity * k_stat_on / k_stat;
        var sp: f64 = _ry_integrate_relax(p.stat_phosphorylated, target, k_stat, dt);
        p.stat_phosphorylated = sp;
    }
    # Dimerization 2 STAT-P ⇌ dimer (forward second-order in STAT-P): linear in the new state, so STAT-P + 2·dimer is
    # conserved exactly and both pools stay >= 0 for any dt.
    var sp0: f64 = p.stat_phosphorylated;
    var d: f64 = p.stat_dimer;
    var kf_dt: f64 = c.dimer_rate * sp0 * dt;
    var kd_dt: f64 = c.dimer_decay_rate * dt;
    var phospho_total: f64 = sp0 + 2.0 * d;
    var d_new: f64 = (d + kf_dt * phospho_total) / (1.0 + kd_dt + 2.0 * kf_dt);
    var rest: f64 = phospho_total - 2.0 * d_new;
    var p_new: f64 = _ry_max(rest, 0.0);
    var v_dimer: f64 = c.dimer_rate * sp0 * p_new;
    p.stat_dimer = d_new;
    p.stat_phosphorylated = p_new;
    # SOCS: induced by the STAT dimers (the delayed negative feedback).
    var v_socs_on: f64 = c.socs_induction_rate * d_new;
    var socs: f64 = _ry_integrate_produce_decay(p.socs, v_socs_on, c.socs_degradation_rate, dt);
    p.socs = socs;
    out.jak_phosphorylation = v_jak_on;
    out.stat_phosphorylation = v_stat_on;
    out.dimer_formation = v_dimer;
    out.socs_induction = v_socs_on;
    return 0;
}

# ── JSON (P7: serde_json's documents) ──

# Appends JakStatState `p` as serde_json writes it, its four fields in declaration order, on allocator `a`: Ok(0), or
# Err(RY_ERR_OUT_OF_MEMORY) when the builder could not grow.
#must_use
fn ry_jak_stat_state_to_json_a(a, sb, p: *RyJakStatState): Result {
    if (_ry_jw_f64_fields(a, sb, p, 4, &_RY_JAK_STAT_STATE_FIELDS) != 0) { return Err(RY_ERR_OUT_OF_MEMORY); }
    return Ok(0);
}

# ry_jak_stat_state_to_json_a on the default allocator (a builder from str_builder_new).
#must_use
fn ry_jak_stat_state_to_json(sb, p: *RyJakStatState): Result {
    return ry_jak_stat_state_to_json_a(default_alloc(), sb, p);
}

# The JakStatState at node `v` of a parsed document, by serde's rules, into the 32 bytes at `w`: 1, or 0 for a
# refusal. The signaling network's readers call it for its nested value.
#must_use
fn _ry_jak_stat_state_from_node(v, w): i64 {
    return _ry_jr_f64_fields(v, w, 4, &_RY_JAK_STAT_STATE_FIELDS);
}

# Reads a JakStatState from the `n`-byte document at `buf` by serde's rules (its tree on allocator `a`): Ok(0) with
# *out filled, or Err(RY_ERR_DESERIALIZE) with *out untouched.
#must_use
fn ry_jak_stat_state_from_json_a(a, buf, n, out: *RyJakStatState): Result {
    var w[32];
    var v = _ry_jr_parse(a, buf, n);
    if (_ry_jak_stat_state_from_node(v, &w) == 0) {
        return Err(_ry_fail_text(RY_ERR_DESERIALIZE, "JakStatState", 12));
    }
    memcpy(out, &w, 32);
    return Ok(0);
}

# ry_jak_stat_state_from_json_a on the default allocator (the tree is never freed: for a one-off read).
#must_use
fn ry_jak_stat_state_from_json(buf, n, out: *RyJakStatState): Result {
    return ry_jak_stat_state_from_json_a(default_alloc(), buf, n, out);
}

# Appends JakStatConfig `p` as serde_json writes it, its eleven fields in declaration order, on allocator `a`: Ok(0),
# or Err(RY_ERR_OUT_OF_MEMORY).
#must_use
fn ry_jak_stat_config_to_json_a(a, sb, p: *RyJakStatConfig): Result {
    if (_ry_jw_f64_fields(a, sb, p, 11, &_RY_JAK_STAT_CONFIG_FIELDS) != 0) { return Err(RY_ERR_OUT_OF_MEMORY); }
    return Ok(0);
}

