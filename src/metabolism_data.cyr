# Metabolic state tracking ATP/ADP balance and pathway activity.
# Rust: rasayan::metabolism::MetabolicState::default()

# ATP concentration (mM, typical resting: 5-8 mM).
# Rust: rasayan::metabolism::MetabolicState::default().atp
const RY_METABOLISM_METABOLIC_STATE_DEFAULT_ATP = 6.0;

# Low-energy adenylate, ADP + AMP (mM).
#
# ATP hydrolysis adds to this pool and regeneration draws on it, so
# `atp + adp` is the total adenylate. Adenylate kinase splits it into
# free ADP and AMP ([`free_adp`](Self::free_adp),
# [`amp`](Self::amp)); at the usual ATP/ADP ratios nearly all of it is
# ADP (≈ 97 % in the default state).
# Rust: rasayan::metabolism::MetabolicState::default().adp
const RY_METABOLISM_METABOLIC_STATE_DEFAULT_ADP = 0.5;

# NAD+/NADH ratio (higher = more oxidized, typical: 700).
# Rust: rasayan::metabolism::MetabolicState::default().nad_ratio
const RY_METABOLISM_METABOLIC_STATE_DEFAULT_NAD_RATIO = 700.0;

# Glucose available (mM, typical blood: 4-6 mM).
# Rust: rasayan::metabolism::MetabolicState::default().glucose
const RY_METABOLISM_METABOLIC_STATE_DEFAULT_GLUCOSE = 5.0;

# Oxygen available (normalized, 1.0 = normoxia).
# Rust: rasayan::metabolism::MetabolicState::default().oxygen
const RY_METABOLISM_METABOLIC_STATE_DEFAULT_OXYGEN = 1.0;

# Lactate concentration (mM, typical resting: 0.5-2.0).
# Rust: rasayan::metabolism::MetabolicState::default().lactate
const RY_METABOLISM_METABOLIC_STATE_DEFAULT_LACTATE = 1.0;
