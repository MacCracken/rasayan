# Appends SignalingInput `p` as serde_json writes it, its three fields in declaration order, on allocator `a`: Ok(0),
# or Err(RY_ERR_OUT_OF_MEMORY).
#must_use
fn ry_signaling_input_to_json_a(a, sb, p: *RySignalingInput): Result {
    if (_ry_jw_f64_fields(a, sb, p, 3, &_RY_SIGNALING_INPUT_FIELDS) != 0) { return Err(RY_ERR_OUT_OF_MEMORY); }
    return Ok(0);
}

# ry_signaling_input_to_json_a on the default allocator.
#must_use
fn ry_signaling_input_to_json(sb, p: *RySignalingInput): Result {
    return ry_signaling_input_to_json_a(default_alloc(), sb, p);
}

# The SignalingInput at node `v` of a parsed document, by serde's rules, into the 24 bytes at `w`: 1, or 0 for a
# refusal.
#must_use
fn _ry_signaling_input_from_node(v, w): i64 {
    return _ry_jr_f64_fields(v, w, 3, &_RY_SIGNALING_INPUT_FIELDS);
}

# Reads a SignalingInput from the `n`-byte document at `buf` by serde's rules (its tree on allocator `a`): Ok(0) with
# *out filled, or Err(RY_ERR_DESERIALIZE) with *out untouched.
#must_use
fn ry_signaling_input_from_json_a(a, buf, n, out: *RySignalingInput): Result {
    var w[24];
    var v = _ry_jr_parse(a, buf, n);
    if (_ry_signaling_input_from_node(v, &w) == 0) {
        return Err(_ry_fail_text(RY_ERR_DESERIALIZE, "SignalingInput", 14));
    }
    memcpy(out, &w, 24);
    return Ok(0);
}

# ry_signaling_input_from_json_a on the default allocator (the tree is never freed: for a one-off read).
#must_use
fn ry_signaling_input_from_json(buf, n, out: *RySignalingInput): Result {
    return ry_signaling_input_from_json_a(default_alloc(), buf, n, out);
}
