}

# ry_signaling_flux_from_json_a on the default allocator (the tree is never freed: for a one-off read).
#must_use
fn ry_signaling_flux_from_json(buf, n, out: *RySignalingFlux): Result {
    return ry_signaling_flux_from_json_a(default_alloc(), buf, n, out);
