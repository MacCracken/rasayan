# rasayan — src/mcp.cyr: the MCP tools for rasayan's biochemistry functions (rust-old/src/mcp.rs), on bote
#
# Eight tools, each a JSON-in, JSON-out bote handler over the library ([lib.mcp] only; its consumer declares bote):
#
# | tool                 | what it computes                                                    |
# |----------------------|---------------------------------------------------------------------|
# | `rasayan_kinetics`   | Michaelis-Menten, Hill, inhibition, Arrhenius, Q10, bi-substrate    |
# | `rasayan_metabolism` | the default metabolic state: ATP/ADP, energy charge, regeneration   |
# | `rasayan_signal`     | dose-response, receptor occupancy                                   |
# | `rasayan_protein`    | weight, composition, pI, extinction, Chou-Fasman, charge, lookup    |
# | `rasayan_membrane`   | Nernst, Goldman (the default neuron), Fick                          |
# | `rasayan_alignment`  | BLOSUM62 / PAM250 substitution, scoring, Needleman-Wunsch           |
# | `rasayan_ptm`        | post-translational modification sites                               |
# | `rasayan_domain`     | protein domain motifs                                               |
#
# The definitions (name, description, inputSchema) are mcp.rs's, generated into src/mcp_data.cyr; each is annotated
# read-only (bote's `ann_read_only()`, Rust's `ToolAnnotations::read_only()`). A handler reads its arguments as
# serde_json's `Value` accessors read them (`as_f64` takes a float or an integer, `as_i64` an integer, `as_str` a
# string; a missing key or another JSON type is absent) and answers the record Rust's `json!` builds, written as
# serde_json writes a `Value` (object keys sorted, f64s in serde_json's form): bote 3.8.15 sends it as one text block
# (ADR 0002 rows 11–13). Errors are `{"error": "…"}` records, as Rust's. Every handler builds on the request's
# allocator (`bote_req_alloc()`: an arena the transport resets), its `_a` form on the caller's.
#
# The Cyrius forms: `ry_register_tools(d)` registers the eight tools on a bote Dispatcher and returns how many
# registered; `ry_create_dispatcher()` gives a new Dispatcher holding them; `ry_tool_names(out, cap)` fills a
# caller buffer with the eight names (Ok(8)).

# The number of tools.
const RY_MCP_TOOL_COUNT = 8;

# A reply when the allocator refused the reply's room (Rust cannot run out; never reached on an arena that grows).
var _RY_MCP_OOM = "{\"error\":\"out of memory\"}";

# ── the tool table ──

# Tool k (0–7, Rust's `tools()` order): its name, description and inputSchema (C strings, src/mcp_data.cyr) into
# out[0..3] and its handler into out[3]. 1, or 0 for a k outside 0–7.
fn _ry_mcp_tool(k, out): i64 {
    var name = 0;
    var desc = 0;
    var schema = 0;
    var h = 0;
    if (k == 0) {
        name = &_RY_MCP_KINETICS_NAME;
        desc = &_RY_MCP_KINETICS_DESCRIPTION;
        schema = &_RY_MCP_KINETICS_SCHEMA;
        h = &_ry_mcp_kinetics;
    } elif (k == 1) {
        name = &_RY_MCP_METABOLISM_NAME;
        desc = &_RY_MCP_METABOLISM_DESCRIPTION;
        schema = &_RY_MCP_METABOLISM_SCHEMA;
        h = &_ry_mcp_metabolism;
    } elif (k == 2) {
        name = &_RY_MCP_SIGNAL_NAME;
        desc = &_RY_MCP_SIGNAL_DESCRIPTION;
        schema = &_RY_MCP_SIGNAL_SCHEMA;
        h = &_ry_mcp_signal;
    } elif (k == 3) {
        name = &_RY_MCP_PROTEIN_NAME;
        desc = &_RY_MCP_PROTEIN_DESCRIPTION;
        schema = &_RY_MCP_PROTEIN_SCHEMA;
        h = &_ry_mcp_protein;
    } elif (k == 4) {
        name = &_RY_MCP_MEMBRANE_NAME;
        desc = &_RY_MCP_MEMBRANE_DESCRIPTION;
        schema = &_RY_MCP_MEMBRANE_SCHEMA;
        h = &_ry_mcp_membrane;
    } elif (k == 5) {
        name = &_RY_MCP_ALIGNMENT_NAME;
        desc = &_RY_MCP_ALIGNMENT_DESCRIPTION;
        schema = &_RY_MCP_ALIGNMENT_SCHEMA;
        h = &_ry_mcp_alignment;
    } elif (k == 6) {
        name = &_RY_MCP_PTM_NAME;
        desc = &_RY_MCP_PTM_DESCRIPTION;
        schema = &_RY_MCP_PTM_SCHEMA;
        h = &_ry_mcp_ptm;
    } elif (k == 7) {
        name = &_RY_MCP_DOMAIN_NAME;
        desc = &_RY_MCP_DOMAIN_DESCRIPTION;
        schema = &_RY_MCP_DOMAIN_SCHEMA;
        h = &_ry_mcp_domain;
    } else {
        return 0;
    }
    store64(out, name);
    store64(out + 8, desc);
    store64(out + 16, schema);
    store64(out + 24, h);
    return 1;
}

# ── the public API ──

# Registers the eight tools on bote Dispatcher `d`, each read-only and idempotent (`ann_read_only()`), in Rust's
# order; returns how many registered (8), each registration a DEBUG event and each refusal a WARN event under
# `rasayan::mcp`. Mirrors `mcp::register_tools`.
fn ry_register_tools(d): i64 {
    var registered = 0;
    var t[32];
    var k = 0;
    while (k < RY_MCP_TOOL_COUNT) {
        _ry_mcp_tool(k, &t);
        var name = load64(&t);
        var def = tool_def_new(name, load64(&t + 8), tool_schema_from_json(load64(&t + 16)));
        tool_def_with_annotations(def, ann_read_only());
        var e = dispatcher_register_tool(d, def, load64(&t + 24));
        if (e == 0) {
            registered = registered + 1;
            if (_ry_debug_on() == 1) {
                var hd[24];
                var b[_RY_EV_CAP];
                var ev = _ry_ev(&hd, &b, _RY_EV_CAP, "rasayan::mcp", "registered MCP tool");
                _ry_ev_s(ev, "tool", name, strlen(name));
                _ry_debug(ev);
            }
        } elif (_ry_warn_on() == 1) {
            var hw[24];
            var bw[_RY_EV_CAP];
            var ew = _ry_ev(&hw, &bw, _RY_EV_CAP, "rasayan::mcp", "failed to register MCP tool");
            _ry_ev_s(ew, "tool", name, strlen(name));
            var why = bote_err_reason(e);
            if (why != 0) { _ry_ev_s(ew, "error", why, _ry_mcp_min(strlen(why), 200)); }
            _ry_warn(ew);
        }
        k = k + 1;
    }
    return registered;
}

# A new bote Dispatcher on a new registry with the eight tools registered. Mirrors `mcp::create_dispatcher`.
#must_use
fn ry_create_dispatcher(): i64 {
    var d = dispatcher_new(tool_registry_new());
    ry_register_tools(d);
    return d;
}

# The eight tool names (C strings, Rust's order) into the `cap` words at out: Ok(8), or Err(RY_ERR_BUFFER_TOO_SMALL)
# when cap < 8 (nothing written). Mirrors `mcp::tool_names`.
#must_use
fn ry_tool_names(out, cap): Result {
    if (cap < RY_MCP_TOOL_COUNT) { return Err(RY_ERR_BUFFER_TOO_SMALL); }
    var t[32];
    var k = 0;
    while (k < RY_MCP_TOOL_COUNT) {
        _ry_mcp_tool(k, &t);
        store64(out + 8 * k, load64(&t));
        k = k + 1;
    }
    return Ok(RY_MCP_TOOL_COUNT);
}

# ── arguments (serde_json's `Value::get` and `as_*`) ──

# The smaller of two words.
#must_use
#pure
fn _ry_mcp_min(a, b): i64 {
    if (a < b) { return a; }
    return b;
}

# The argument tree of the `n`-byte document at `args` on allocator `a` (0 when absent or not one JSON value: every
# argument then reads as absent).
#must_use
fn _ry_mcp_parse(a, args, n): i64 {
    if (args == 0 || n <= 0) { return 0; }
    return _ry_jr_parse(a, args, n);
}

# Argument `key` (a C string) as serde_json's `as_f64` reads it: (1, the value) for a float or an integer (converted
# to the nearest f64), (0, 0) for anything else or none.
fn _ry_mcp_f64(v, key): (i64, f64) {
    var x = bayan_json_v_obj_get_by_cstr(v, key);
    if (x == 0) { return (0, 0.0); }
    var t = bayan_json_v_tag(x);
    if (t == JTAG_FLOAT) {
        var f: f64 = bayan_json_v_float(x);
        return (1, f);
    }
    if (t == JTAG_INT) {
        var g: f64 = f64_from(bayan_json_v_int(x));
        return (1, g);
    }
    return (0, 0.0);
}

# Argument `key` as serde_json's `as_str` reads it: the Str, or 0 for anything else or none. A string whose bytes are
# not UTF-8 is none too: serde_json refuses such a document before a Rust handler sees it, and bote passes the bytes
# through (2.0.1; a 2.0.0 handler read them, and the ptm and domain replies could then carry bytes the scan never
# wrote).
#must_use
fn _ry_mcp_str(v, key): i64 {
    var x = bayan_json_v_obj_get_by_cstr(v, key);
    if (x == 0 || bayan_json_v_tag(x) != JTAG_STR) { return 0; }
    var s = bayan_json_v_str(x);
    if (_ry_utf8_valid(str_data(s), str_len(s)) == 0) { return 0; }
    return s;
}

# Argument `key` as serde_json's `as_i64` reads it: (1, n) for an integer, (0, 0) for anything else or none.
fn _ry_mcp_i64(v, key): (i64, i64) {
    var x = bayan_json_v_obj_get_by_cstr(v, key);
    if (x == 0 || bayan_json_v_tag(x) != JTAG_INT) { return (0, 0); }
    return (1, bayan_json_v_int(x));
}

# 1 when Str `s` is the C string `lit`, byte for byte.
#must_use
fn _ry_mcp_is(s, lit): i64 {
    var n = strlen(lit);
    if (s == 0 || str_len(s) != n) { return 0; }
    return memeq(str_data(s), lit, n);
}

# The number of UTF-8 characters in the `n` bytes at `p` (Rust's `chars().count()` on a valid &str: the bytes that do
# not continue a character).
#must_use
fn _ry_mcp_chars(p, n): i64 {
    var c = 0;
    var k = 0;
    while (k < n) {
        if ((load8(p + k) & 192) != 128) { c = c + 1; }
        k = k + 1;
    }
    return c;
}

# The byte length of the UTF-8 character starting with byte `b`.
#must_use
#pure
fn _ry_mcp_char_len(b): i64 {
    if (b < 128) { return 1; }
    if (b >= 240) { return 4; }
    if (b >= 224) { return 3; }
    return 2;
}

# The Unicode scalar value of the UTF-8 character at `p` (`len` bytes, valid).
#must_use
fn _ry_mcp_scalar(p, len): i64 {
    var b = load8(p);
    if (len == 1) { return b; }
    var cp = 0;
    if (len == 2) { cp = b & 31; }
    if (len == 3) { cp = b & 15; }
    if (len == 4) { cp = b & 7; }
    var k = 1;
    while (k < len) {
        cp = (cp << 6) | (load8(p + k) & 63);
        k = k + 1;
    }
    return cp;
}

# ── the reply ──

# Appends the `n` bytes at `p` to builder `sb` on allocator `a` as they are (a message under construction): 0, or -1.
fn _ry_mcp_raw(a, sb, p, n): i64 {
    if (n <= 0) { return 0; }
    if (_sb_grow_a(a, sb, n) != 0) { return 0 - 1; }
    memcpy(load64(sb) + load64(sb + 8), p, n);
    store64(sb + 8, load64(sb + 8) + n);
    return 0;
}

# Appends the C string `s` as it is: 0, or -1.
fn _ry_mcp_rawc(a, sb, s): i64 {
    return _ry_mcp_raw(a, sb, s, strlen(s));
}

# Appends the integer `n` in decimal: 0, or -1.
fn _ry_mcp_rawi(a, sb, n): i64 {
    if (_sb_grow_a(a, sb, 24) != 0) { return 0 - 1; }
    str_builder_add_int(sb, n);
    return 0;
}

# Appends x in Rust's Display form (`inf`, `NaN`, `1e300` as its 301 digits): 0, or -1. The reserve is the longest
# Display form, −5e-324's 327 bytes, so the write never grows the builder past it (2.0.0 reserved 40).
fn _ry_mcp_rawf(a, sb, x: f64): i64 {
    if (_sb_grow_a(a, sb, 336) != 0) { return 0 - 1; }
    _ry_fmt_f64_display(sb, x);
    return 0;
}

# Finishes reply `sb` (the `e` of its writes): the NUL-terminated text, or the out-of-memory reply.
#must_use
fn _ry_mcp_done(a, sb, e): i64 {
    if (sb == 0 || e != 0) { return _RY_MCP_OOM; }
    if (_ry_jw_byte(a, sb, 0) != 0) { return _RY_MCP_OOM; }
    return load64(sb);
}

# The reply `{"error":"<message>"}`, the message the bytes builder `msg` holds, escaped as serde_json escapes (Rust's
# `err(msg)`).
#must_use
fn _ry_mcp_err_sb(a, msg, e): i64 {
    var sb = str_builder_new_a(a);
    if (sb == 0 || msg == 0 || e != 0) { return _RY_MCP_OOM; }
    var w = _ry_jw_byte(a, sb, 123);
    w = w | _ry_jw_key(a, sb, "error", 1);
    w = w | _ry_jw_str(a, sb, load64(msg), load64(msg + 8));
    w = w | _ry_jw_byte(a, sb, 125);
    return _ry_mcp_done(a, sb, w);
}

# The reply `{"error":"<s>"}` for the C string `s`.
#must_use
fn _ry_mcp_err(a, s): i64 {
    var m = str_builder_new_a(a);
    if (m == 0) { return _RY_MCP_OOM; }
    return _ry_mcp_err_sb(a, m, _ry_mcp_rawc(a, m, s));
}

# The reply `{"error":"<prefix><the n bytes at p>"}` (Rust's `format!("unknown kinetics function: {func}")`).
#must_use
fn _ry_mcp_err_with(a, prefix, p, n): i64 {
    var m = str_builder_new_a(a);
    if (m == 0) { return _RY_MCP_OOM; }
    var e = _ry_mcp_rawc(a, m, prefix);
    e = e | _ry_mcp_raw(a, m, p, n);
    return _ry_mcp_err_sb(a, m, e);
}

# Rust's `finite(name, value)` refusal: `{"error":"<name> is not finite (<value>) — check inputs for zero/negative
# constants"}`, the value in Display form.
#must_use
fn _ry_mcp_not_finite(a, name, x: f64): i64 {
    var m = str_builder_new_a(a);
    if (m == 0) { return _RY_MCP_OOM; }
    var e = _ry_mcp_rawc(a, m, name);
    e = e | _ry_mcp_rawc(a, m, " is not finite (");
    e = e | _ry_mcp_rawf(a, m, x);
    e = e | _ry_mcp_rawc(a, m, ") — check inputs for zero/negative constants");
    return _ry_mcp_err_sb(a, m, e);
}

# A new reply builder with its `{` written (0 when the allocator refused it).
#must_use
fn _ry_mcp_open(a): i64 {
    var sb = str_builder_new_a(a);
    if (sb == 0) { return 0; }
    if (_ry_jw_byte(a, sb, 123) != 0) { return 0; }
    return sb;
}

# Appends `"key":<x>` (an f64; a comma first unless `first`): 0, or -1.
fn _ry_mcp_kf(a, sb, key, first, x: f64): i64 {
    var e = _ry_jw_key(a, sb, key, first);
    return e | _ry_jw_f64(a, sb, x);
}

# Appends `"key":<n>` (an integer): 0, or -1.
fn _ry_mcp_ki(a, sb, key, first, n): i64 {
    var e = _ry_jw_key(a, sb, key, first);
    return e | _ry_jw_i64(a, sb, n);
}

# Appends `"key":"<s>"` (the C string s): 0, or -1.
fn _ry_mcp_ks(a, sb, key, first, s): i64 {
    var e = _ry_jw_key(a, sb, key, first);
    return e | _ry_jw_str(a, sb, s, strlen(s));
}

# The reply `{"function":"<fname>","<key>":<x>}` for a finite x, else Rust's `finite(key, x)` refusal (`rate`,
# `response`, `occupancy`).
#must_use
fn _ry_mcp_fn_value(a, fname, key, x: f64): i64 {
    if (_ry_is_finite(x) == 0) { return _ry_mcp_not_finite(a, key, x); }
    var sb = _ry_mcp_open(a);
    if (sb == 0) { return _RY_MCP_OOM; }
    var e = _ry_mcp_ks(a, sb, "function", 1, fname);
    e = e | _ry_mcp_kf(a, sb, key, 0, x);
    e = e | _ry_jw_byte(a, sb, 125);
    return _ry_mcp_done(a, sb, e);
}

# The `n` bytes of an argument's length (0 for none).
#must_use
fn _ry_mcp_len(args): i64 {
    if (args == 0) { return 0; }
    return strlen(args);
}

# ── kinetics ──

# Reads the `n` arguments named by the C strings in `keys` (n words) as f64s into `vals`: 1 when every one is a number,
# else 0.
fn _ry_mcp_need(v, keys, n, vals): i64 {
    var k = 0;
    while (k < n) {
        var h, x = _ry_mcp_f64(v, load64(keys + 8 * k));
        if (h == 0) { return 0; }
        store64(vals + 8 * k, x);
        k = k + 1;
    }
    return 1;
}

# The kinetics handler on allocator `a`, for the `n`-byte arguments document at `args`: the reply text. Mirrors the
# private `kinetics_handler`.
fn _ry_mcp_kinetics_a(a, args, n): i64 {
    var v = _ry_mcp_parse(a, args, n);
    var fs = _ry_mcp_str(v, "function");
    if (fs == 0) { return _ry_mcp_err(a, "missing 'function' parameter"); }
    var keys[48];
    var x[48];
    if (_ry_mcp_is(fs, "michaelis_menten") == 1) {
        store64(&keys, "substrate");
        store64(&keys + 8, "vmax");
        store64(&keys + 16, "km");
        if (_ry_mcp_need(v, &keys, 3, &x) == 0) {
            return _ry_mcp_err(a, "michaelis_menten requires: substrate, vmax, km");
        }
        var r0: f64 = ry_michaelis_menten(load64(&x), load64(&x + 8), load64(&x + 16));
        return _ry_mcp_fn_value(a, "michaelis_menten", "rate", r0);
    }
    if (_ry_mcp_is(fs, "hill") == 1) {
        store64(&keys, "substrate");
        store64(&keys + 8, "vmax");
        store64(&keys + 16, "km");
        store64(&keys + 24, "n");
        if (_ry_mcp_need(v, &keys, 4, &x) == 0) { return _ry_mcp_err(a, "hill requires: substrate, vmax, km, n"); }
        var r1: f64 = ry_hill_equation(load64(&x), load64(&x + 8), load64(&x + 16), load64(&x + 24));
        return _ry_mcp_fn_value(a, "hill", "rate", r1);
    }
    if (_ry_mcp_is(fs, "competitive_inhibition") == 1) {
        store64(&keys, "substrate");
        store64(&keys + 8, "inhibitor");
        store64(&keys + 16, "vmax");
        store64(&keys + 24, "km");
        store64(&keys + 32, "ki");
        if (_ry_mcp_need(v, &keys, 5, &x) == 0) {
            return _ry_mcp_err(a, "competitive_inhibition requires: substrate, inhibitor, vmax, km, ki");
        }
        var r2: f64 = ry_competitive_inhibition(load64(&x), load64(&x + 8), load64(&x + 16), load64(&x + 24),
          load64(&x + 32));
        return _ry_mcp_fn_value(a, "competitive_inhibition", "rate", r2);
    }
    if (_ry_mcp_is(fs, "mixed_inhibition") == 1) {
        store64(&keys, "substrate");
        store64(&keys + 8, "inhibitor");
        store64(&keys + 16, "vmax");
        store64(&keys + 24, "km");
        store64(&keys + 32, "ki");
        store64(&keys + 40, "ki_prime");
        if (_ry_mcp_need(v, &keys, 6, &x) == 0) {
            return _ry_mcp_err(a, "mixed_inhibition requires: substrate, inhibitor, vmax, km, ki, ki_prime");
        }
        var r3: f64 = ry_mixed_inhibition(load64(&x), load64(&x + 8), load64(&x + 16), load64(&x + 24),
          load64(&x + 32), load64(&x + 40));
        return _ry_mcp_fn_value(a, "mixed_inhibition", "rate", r3);
    }
    if (_ry_mcp_is(fs, "substrate_inhibition") == 1) {
        store64(&keys, "substrate");
        store64(&keys + 8, "vmax");
        store64(&keys + 16, "km");
        store64(&keys + 24, "ksi");
        if (_ry_mcp_need(v, &keys, 4, &x) == 0) {
            return _ry_mcp_err(a, "substrate_inhibition requires: substrate, vmax, km, ksi");
        }
        var r4: f64 = ry_substrate_inhibition(load64(&x), load64(&x + 8), load64(&x + 16), load64(&x + 24));
        return _ry_mcp_fn_value(a, "substrate_inhibition", "rate", r4);
    }
    if (_ry_mcp_is(fs, "arrhenius") == 1) {
        store64(&keys, "a");
        store64(&keys + 8, "ea");
        store64(&keys + 16, "temp");
        if (_ry_mcp_need(v, &keys, 3, &x) == 0) { return _ry_mcp_err(a, "arrhenius requires: a, ea, temp"); }
        var r5: f64 = ry_arrhenius(load64(&x), load64(&x + 8), load64(&x + 16));
        return _ry_mcp_fn_value(a, "arrhenius", "rate", r5);
    }
    if (_ry_mcp_is(fs, "q10") == 1) { return _ry_mcp_q10(a, v); }
    if (_ry_mcp_is(fs, "ping_pong") == 1) {
        store64(&keys, "substrate");
        store64(&keys + 8, "substrate_b");
        store64(&keys + 16, "vmax");
        store64(&keys + 24, "km");
        store64(&keys + 32, "km_b");
        if (_ry_mcp_need(v, &keys, 5, &x) == 0) {
            return _ry_mcp_err(a, "ping_pong requires: substrate, substrate_b, vmax, km, km_b");
        }
        var r6: f64 = ry_ping_pong(load64(&x), load64(&x + 8), load64(&x + 16), load64(&x + 24), load64(&x + 32));
        return _ry_mcp_fn_value(a, "ping_pong", "rate", r6);
    }
    if (_ry_mcp_is(fs, "sequential") == 1) {
        store64(&keys, "substrate");
        store64(&keys + 8, "substrate_b");
        store64(&keys + 16, "vmax");
        store64(&keys + 24, "km");
        store64(&keys + 32, "km_b");
        store64(&keys + 40, "ki");
        if (_ry_mcp_need(v, &keys, 6, &x) == 0) {
            return _ry_mcp_err(a, "sequential requires: substrate, substrate_b, vmax, km, km_b, ki");
        }
        var r7: f64 = ry_sequential_bisubstrate(load64(&x), load64(&x + 8), load64(&x + 16), load64(&x + 24),
          load64(&x + 32), load64(&x + 40));
        return _ry_mcp_fn_value(a, "sequential", "rate", r7);
    }
    return _ry_mcp_err_with(a, "unknown kinetics function: ", str_data(fs), str_len(fs));
}

# The kinetics handler's q10 arm: the base rate in `substrate`, the reference temperature from `temp_ref`, else the
# legacy carrier `km`, else 310 K; the reply carries the reference it used.
fn _ry_mcp_q10(a, v): i64 {
    var hr, rate = _ry_mcp_f64(v, "substrate");
    var hq, q10 = _ry_mcp_f64(v, "q10_value");
    var ht, temp = _ry_mcp_f64(v, "temp");
    if (hr == 0 || hq == 0 || ht == 0) {
        return _ry_mcp_err(a, "q10 requires: substrate (base rate), q10_value, temp (target temp K)");
    }
    var hf, tref = _ry_mcp_f64(v, "temp_ref");
    if (hf == 0) {
        var hk, km = _ry_mcp_f64(v, "km");
        tref = 310.0;
        if (hk == 1) { tref = km; }
    }
    var r: f64 = ry_q10_rate(rate, q10, temp, tref);
    if (_ry_is_finite(r) == 0) { return _ry_mcp_not_finite(a, "rate", r); }
    var sb = _ry_mcp_open(a);
    if (sb == 0) { return _RY_MCP_OOM; }
    var e = _ry_mcp_ks(a, sb, "function", 1, "q10");
    e = e | _ry_mcp_kf(a, sb, "rate", 0, r);
    e = e | _ry_mcp_kf(a, sb, "temp_ref", 0, tref);
    e = e | _ry_jw_byte(a, sb, 125);
    return _ry_mcp_done(a, sb, e);
}

# The kinetics tool's bote handler (the arguments as JSON text; the claims unused). Mirrors `kinetics_handler`.
fn _ry_mcp_kinetics(args, claims): i64 {
    return _ry_mcp_kinetics_a(bote_req_alloc(), args, _ry_mcp_len(args));
}

# ── metabolism ──

# The reply `{"adp":…,"atp":…,"energy_charge":…[,"is_anaerobic":…]}` of state *s.
#must_use
fn _ry_mcp_adenylates(a, s: *RyMetabolicState, with_anaerobic): i64 {
    var sb = _ry_mcp_open(a);
    if (sb == 0) { return _RY_MCP_OOM; }
    var ec: f64 = ry_metabolic_state_energy_charge(s);
    var e = _ry_mcp_kf(a, sb, "adp", 1, s.adp);
    e = e | _ry_mcp_kf(a, sb, "atp", 0, s.atp);
    e = e | _ry_mcp_kf(a, sb, "energy_charge", 0, ec);
    if (with_anaerobic == 1) {
        e = e | _ry_jw_key(a, sb, "is_anaerobic", 0);
        if (ry_metabolic_state_is_anaerobic(s) == 1) {
            e = e | _ry_mcp_rawc(a, sb, "true");
        } else {
            e = e | _ry_mcp_rawc(a, sb, "false");
        }
    }
    e = e | _ry_jw_byte(a, sb, 125);
    return _ry_mcp_done(a, sb, e);
}

# The metabolism handler on allocator `a`, on a default MetabolicState: `status`, `energy_charge`, `consume_atp`
# (`amount`, default 1, finite and >= 0), `regenerate_atp` (`dt`, else the legacy `amount`, default 1, finite and >= 0;
# `oxygen` in [0, 1] when given). Mirrors the private `metabolism_handler`.
fn _ry_mcp_metabolism_a(a, args, n): i64 {
    var v = _ry_mcp_parse(a, args, n);
    var act = _ry_mcp_str(v, "action");
    if (act == 0) { return _ry_mcp_err(a, "missing 'action' parameter"); }
    var s: RyMetabolicState;
    ry_metabolic_state_default(&s);
    if (_ry_mcp_is(act, "status") == 1) { return _ry_mcp_adenylates(a, &s, 0); }
    if (_ry_mcp_is(act, "energy_charge") == 1) {
        var sb = _ry_mcp_open(a);
        if (sb == 0) { return _RY_MCP_OOM; }
        var ec: f64 = ry_metabolic_state_energy_charge(&s);
        var e = _ry_mcp_kf(a, sb, "energy_charge", 1, ec);
        e = e | _ry_jw_byte(a, sb, 125);
        return _ry_mcp_done(a, sb, e);
    }
    if (_ry_mcp_is(act, "consume_atp") == 1) {
        var ha, amount = _ry_mcp_f64(v, "amount");
        if (ha == 0) { amount = 1.0; }
        if (_ry_is_finite(amount) == 0 || amount < 0.0) {
            return _ry_mcp_err(a, "consume_atp: 'amount' must be a finite number >= 0");
        }
        var used: f64 = ry_metabolic_state_consume_atp(&s, amount);
        return _ry_mcp_adenylates(a, &s, 0);
    }
    if (_ry_mcp_is(act, "regenerate_atp") == 1) {
        var hd, dt = _ry_mcp_f64(v, "dt");
        if (hd == 0) {
            var hm, am = _ry_mcp_f64(v, "amount");
            dt = 1.0;
            if (hm == 1) { dt = am; }
        }
        if (_ry_is_finite(dt) == 0 || dt < 0.0) {
            return _ry_mcp_err(a, "regenerate_atp: 'dt' must be a finite number >= 0");
        }
        var ho, o2 = _ry_mcp_f64(v, "oxygen");
        if (ho == 1) {
            if (o2 < 0.0 || o2 > 1.0) { return _ry_mcp_err(a, "regenerate_atp: 'oxygen' must be in [0, 1]"); }
            s.oxygen = o2;
        }
        ry_metabolic_state_regenerate_atp(&s, dt);
        return _ry_mcp_adenylates(a, &s, 1);
    }
    return _ry_mcp_err_with(a, "unknown metabolism action: ", str_data(act), str_len(act));
}

# The metabolism tool's bote handler. Mirrors `metabolism_handler`.
fn _ry_mcp_metabolism(args, claims): i64 {
    return _ry_mcp_metabolism_a(bote_req_alloc(), args, _ry_mcp_len(args));
}

# ── signal ──

# The signal handler on allocator `a`: `dose_response` (ligand, ec50, emax, n; dose_response(ligand, emax, ec50, n),
# Rust's argument order) and `receptor_occupancy` (ligand, ec50 as Kd). Mirrors the private `signal_handler`.
fn _ry_mcp_signal_a(a, args, n): i64 {
    var v = _ry_mcp_parse(a, args, n);
    var fs = _ry_mcp_str(v, "function");
    if (fs == 0) { return _ry_mcp_err(a, "missing 'function' parameter"); }
    var keys[32];
    var x[32];
    if (_ry_mcp_is(fs, "dose_response") == 1) {
        store64(&keys, "ligand");
        store64(&keys + 8, "ec50");
        store64(&keys + 16, "emax");
        store64(&keys + 24, "n");
        if (_ry_mcp_need(v, &keys, 4, &x) == 0) {
            return _ry_mcp_err(a, "dose_response requires: ligand, ec50, emax, n");
        }
        var r: f64 = ry_dose_response(load64(&x), load64(&x + 16), load64(&x + 8), load64(&x + 24));
        return _ry_mcp_fn_value(a, "dose_response", "response", r);
    }
    if (_ry_mcp_is(fs, "receptor_occupancy") == 1) {
        store64(&keys, "ligand");
        store64(&keys + 8, "ec50");
        if (_ry_mcp_need(v, &keys, 2, &x) == 0) {
            return _ry_mcp_err(a, "receptor_occupancy requires: ligand, ec50 (as Kd)");
        }
        var o: f64 = ry_receptor_occupancy(load64(&x), load64(&x + 8));
        return _ry_mcp_fn_value(a, "receptor_occupancy", "occupancy", o);
    }
    return _ry_mcp_err_with(a, "unknown signal function: ", str_data(fs), str_len(fs));
}

# The signal tool's bote handler. Mirrors `signal_handler`.
fn _ry_mcp_signal(args, claims): i64 {
    return _ry_mcp_signal_a(bote_req_alloc(), args, _ry_mcp_len(args));
}

# ── protein ──

# Reads sequence argument `key` as Rust's `get_seq` does into out[0..2] (its bytes and length): 0 with them set, or
# the error reply (`usage` when absent or not a string; `'<key>' too long: <n> bytes (max 100000)` past
# RY_MCP_MAX_SEQUENCE_LEN).
fn _ry_mcp_seq(a, v, key, usage, out): i64 {
    var s = _ry_mcp_str(v, key);
    if (s == 0) { return _ry_mcp_err(a, usage); }
    var n = str_len(s);
    if (n > RY_MCP_MAX_SEQUENCE_LEN) {
        var m = str_builder_new_a(a);
        if (m == 0) { return _RY_MCP_OOM; }
        var e = _ry_mcp_rawc(a, m, "'");
        e = e | _ry_mcp_rawc(a, m, key);
        e = e | _ry_mcp_rawc(a, m, "' too long: ");
        e = e | _ry_mcp_rawi(a, m, n);
        e = e | _ry_mcp_rawc(a, m, " bytes (max ");
        e = e | _ry_mcp_rawi(a, m, RY_MCP_MAX_SEQUENCE_LEN);
        e = e | _ry_mcp_rawc(a, m, ")");
        return _ry_mcp_err_sb(a, m, e);
    }
    store64(out, str_data(s));
    store64(out + 8, n);
    return 0;
}

# The optional `pka_set` argument (default lehninger, the 1.x behaviour) into *out: 0, or the error reply. Mirrors the
# private `get_pka_set`.
fn _ry_mcp_pka_set(a, v, out): i64 {
    var s = _ry_mcp_str(v, "pka_set");
    var set = RY_PKA_SET_LEHNINGER;
    if (s != 0) {
        if (_ry_mcp_is(s, "lehninger") == 1) {
            set = RY_PKA_SET_LEHNINGER;
        } elif (_ry_mcp_is(s, "bjellqvist") == 1) {
            set = RY_PKA_SET_BJELLQVIST;
        } elif (_ry_mcp_is(s, "emboss") == 1) {
            set = RY_PKA_SET_EMBOSS;
        } elif (_ry_mcp_is(s, "ipc") == 1) {
            set = RY_PKA_SET_IPC;
        } else {
            var m = str_builder_new_a(a);
            if (m == 0) { return _RY_MCP_OOM; }
            var e = _ry_mcp_rawc(a, m, "unknown pka_set: ");
            e = e | _ry_mcp_raw(a, m, str_data(s), str_len(s));
            e = e | _ry_mcp_rawc(a, m, " (expected lehninger, bjellqvist, emboss or ipc)");
            return _ry_mcp_err_sb(a, m, e);
        }
    }
    store64(out, set);
    return 0;
}

# The protein handler's `lookup` arm: exactly one character in `code`, its amino acid's record.
fn _ry_mcp_lookup(a, v): i64 {
    var s = _ry_mcp_str(v, "code");
    var n = 0;
    var p = 0;
    if (s != 0) {
        n = str_len(s);
        p = str_data(s);
    }
    if (n == 0 || _ry_mcp_chars(p, n) != 1) { return _ry_mcp_err(a, "lookup requires: code (exactly one letter)"); }
    var idx = ry_lookup(_ry_mcp_scalar(p, n));
    var aa: RyAminoAcid;
    if (ry_amino_acid(idx, &aa) == 0) { return _ry_mcp_err_with(a, "unknown amino acid: ", p, n); }
    var sb = _ry_mcp_open(a);
    if (sb == 0) { return _RY_MCP_OOM; }
    var code[8];
    store8(&code, aa.code);
    store8(&code + 1, 0);
    var e = _ry_mcp_ks(a, sb, "abbr", 1, aa.abbr);
    e = e | _ry_mcp_ks(a, sb, "code", 0, &code);
    e = e | _ry_mcp_kf(a, sb, "hydrophobicity", 0, aa.hydrophobicity);
    e = e | _ry_mcp_kf(a, sb, "mw", 0, aa.mw);
    e = e | _ry_mcp_ks(a, sb, "name", 0, aa.name);
    e = e | _ry_jw_key(a, sb, "side_chain_pka", 0);
    e = e | _ry_jw_opt_f64(a, sb, aa.has_side_chain_pka, aa.side_chain_pka);
    e = e | _ry_jw_byte(a, sb, 125);
    return _ry_mcp_done(a, sb, e);
}

# The protein handler on allocator `a`: `molecular_weight`, `composition`, `isoelectric_point` (`pka_set`),
# `extinction_coefficient`, `chou_fasman`, `net_charge` (`ph` in [0, 14], default 7; `pka_set`) and `lookup`. Mirrors
# the private `protein_handler`.
fn _ry_mcp_protein_a(a, args, n): i64 {
    var v = _ry_mcp_parse(a, args, n);
    var fs = _ry_mcp_str(v, "function");
    if (fs == 0) { return _ry_mcp_err(a, "missing 'function' parameter"); }
    if (_ry_mcp_is(fs, "lookup") == 1) { return _ry_mcp_lookup(a, v); }
    var which = 0;
    if (_ry_mcp_is(fs, "molecular_weight") == 1) { which = 1; }
    if (_ry_mcp_is(fs, "composition") == 1) { which = 2; }
    if (_ry_mcp_is(fs, "isoelectric_point") == 1) { which = 3; }
    if (_ry_mcp_is(fs, "extinction_coefficient") == 1) { which = 4; }
    if (_ry_mcp_is(fs, "chou_fasman") == 1) { which = 5; }
    if (_ry_mcp_is(fs, "net_charge") == 1) { which = 6; }
    if (which == 0) { return _ry_mcp_err_with(a, "unknown protein function: ", str_data(fs), str_len(fs)); }
    var usage = str_builder_new_a(a);
    if (usage == 0) { return _RY_MCP_OOM; }
    var ue = _ry_mcp_raw(a, usage, str_data(fs), str_len(fs));
    ue = ue | _ry_mcp_rawc(a, usage, " requires: sequence");
    ue = ue | _ry_jw_byte(a, usage, 0);
    if (ue != 0) { return _RY_MCP_OOM; }
    var q[16];
    var r = _ry_mcp_seq(a, v, "sequence", load64(usage), &q);
    if (r != 0) { return r; }
    var seq = load64(&q);
    var len = load64(&q + 8);
    if (which == 1) { return _ry_mcp_weight(a, seq, len); }
    if (which == 2) { return _ry_mcp_composition(a, seq, len); }
    if (which == 3) {
        var ps[8];
        var pr = _ry_mcp_pka_set(a, v, &ps);
        if (pr != 0) { return pr; }
        var pi: f64 = 0.0;
        if (ry_isoelectric_point_with(seq, len, load64(&ps), &pi) == 0) { return _ry_mcp_err(a, "invalid sequence"); }
        var sb = _ry_mcp_open(a);
        if (sb == 0) { return _RY_MCP_OOM; }
        var e = _ry_mcp_kf(a, sb, "pI", 1, pi);
        e = e | _ry_jw_byte(a, sb, 125);
        return _ry_mcp_done(a, sb, e);
    }
    if (which == 4) {
        var ec: RyExtinctionCoefficient;
        if (ry_extinction_coefficient(seq, len, &ec) == 0) { return _ry_mcp_err(a, "invalid sequence"); }
        var sb2 = _ry_mcp_open(a);
        if (sb2 == 0) { return _RY_MCP_OOM; }
        var e2 = _ry_mcp_kf(a, sb2, "oxidized", 1, ec.oxidized);
        e2 = e2 | _ry_mcp_kf(a, sb2, "reduced", 0, ec.reduced);
        e2 = e2 | _ry_jw_byte(a, sb2, 125);
        return _ry_mcp_done(a, sb2, e2);
    }
    if (which == 5) { return _ry_mcp_chou_fasman(a, seq, len); }
    var hp, ph = _ry_mcp_f64(v, "ph");
    if (hp == 0) { ph = 7.0; }
    if (ph < 0.0 || ph > 14.0) { return _ry_mcp_err(a, "net_charge: 'ph' must be in [0, 14]"); }
    var ns[8];
    var nr = _ry_mcp_pka_set(a, v, &ns);
    if (nr != 0) { return nr; }
    var z: f64 = ry_net_charge_with(seq, len, ph, load64(&ns));
    var sb3 = _ry_mcp_open(a);
    if (sb3 == 0) { return _RY_MCP_OOM; }
    var e3 = _ry_mcp_kf(a, sb3, "net_charge", 1, z);
    e3 = e3 | _ry_mcp_kf(a, sb3, "ph", 0, ph);
    e3 = e3 | _ry_jw_byte(a, sb3, 125);
    return _ry_mcp_done(a, sb3, e3);
}

# The protein handler's `molecular_weight` arm: `{"molecular_weight_da":…,"sequence_length":<chars>}`.
fn _ry_mcp_weight(a, seq, len): i64 {
    if (len == 0) { return _ry_mcp_err(a, "molecular_weight: empty sequence"); }
    var mw: f64 = 0.0;
    if (ry_molecular_weight(seq, len, &mw) == 0) {
        return _ry_mcp_err(a, "invalid sequence — contains unknown residues");
    }
    var sb = _ry_mcp_open(a);
    if (sb == 0) { return _RY_MCP_OOM; }
    var e = _ry_mcp_kf(a, sb, "molecular_weight_da", 1, mw);
    e = e | _ry_mcp_ki(a, sb, "sequence_length", 0, _ry_mcp_chars(seq, len));
    e = e | _ry_jw_byte(a, sb, 125);
    return _ry_mcp_done(a, sb, e);
}

# The protein handler's `composition` arm: `{"composition":{"<letter>":<count>,…},"sequence_length":<chars>}`, the
# letters in alphabetical order (the keys of a serde_json object).
fn _ry_mcp_composition(a, seq, len): i64 {
    var pairs[416];
    var tc, count = ry_composition(seq, len, &pairs, 26);
    if (is_err_result(tc) == 1) { return _RY_MCP_OOM; }
    var sb = _ry_mcp_open(a);
    if (sb == 0) { return _RY_MCP_OOM; }
    var e = _ry_jw_key(a, sb, "composition", 1);
    e = e | _ry_jw_byte(a, sb, 123);
    var k = 0;
    while (k < count) {
        var letter[8];
        store8(&letter, load64(&pairs + 16 * k));
        store8(&letter + 1, 0);
        var first = 0;
        if (k == 0) { first = 1; }
        e = e | _ry_mcp_ki(a, sb, &letter, first, load64(&pairs + 16 * k + 8));
        k = k + 1;
    }
    e = e | _ry_jw_byte(a, sb, 125);
    e = e | _ry_mcp_ki(a, sb, "sequence_length", 0, _ry_mcp_chars(seq, len));
    e = e | _ry_jw_byte(a, sb, 125);
    return _ry_mcp_done(a, sb, e);
}

# The one-letter label of a RySecondaryStructure value (H, E, T, C), as the handler writes it.
#must_use
#pure
fn _ry_mcp_ss_label(x): i64 {
    if (x == RY_SECONDARY_STRUCTURE_HELIX) { return 72; }
    if (x == RY_SECONDARY_STRUCTURE_SHEET) { return 69; }
    if (x == RY_SECONDARY_STRUCTURE_TURN) { return 84; }
    return 67;
}

# The protein handler's `chou_fasman` arm: `{"per_residue":["H",…],"prediction":"HH…"}`.
fn _ry_mcp_chou_fasman(a, seq, len): i64 {
    var buf = alloc_via(a, len + 1);
    if (buf == 0) { return _RY_MCP_OOM; }
    var tc, count = ry_chou_fasman_a(a, seq, len, buf, len + 1);
    if (is_err_result(tc) == 1) { return _RY_MCP_OOM; }
    if (count == 0) { return _ry_mcp_err(a, "invalid sequence"); }
    var k = 0;
    while (k < count) {
        store8(buf + k, _ry_mcp_ss_label(load8(buf + k)));
        k = k + 1;
    }
    var sb = _ry_mcp_open(a);
    if (sb == 0) { return _RY_MCP_OOM; }
    var e = _ry_jw_key(a, sb, "per_residue", 1);
    e = e | _ry_jw_reserve(a, sb, 4 * count + 2);
    if (e == 0) {
        str_builder_putc(sb, 91);
        k = 0;
        while (k < count) {
            if (k > 0) { str_builder_putc(sb, 44); }
            str_builder_putc(sb, 34);
            str_builder_putc(sb, load8(buf + k));
            str_builder_putc(sb, 34);
            k = k + 1;
        }
        str_builder_putc(sb, 93);
    }
    e = e | _ry_jw_key(a, sb, "prediction", 0);
    e = e | _ry_jw_str(a, sb, buf, count);
    e = e | _ry_jw_byte(a, sb, 125);
    return _ry_mcp_done(a, sb, e);
}

# The protein tool's bote handler. Mirrors `protein_handler`.
fn _ry_mcp_protein(args, claims): i64 {
    return _ry_mcp_protein_a(bote_req_alloc(), args, _ry_mcp_len(args));
}

# ── membrane ──

# Reads integer argument `key` as Rust's `get_i32` does: (0, has, n) with has 0 when absent or not an integer, or
# (the error reply `'<key>' out of range: <n>`, 0, 0) for an integer outside i32.
fn _ry_mcp_i32(a, v, key): (i64, i64, i64) {
    var h, n = _ry_mcp_i64(v, key);
    if (h == 0) { return (0, 0, 0); }
    if (n >= 0 - 2147483648 && n <= 2147483647) { return (0, 1, n); }
    var m = str_builder_new_a(a);
    if (m == 0) { return (_RY_MCP_OOM, 0, 0); }
    var e = _ry_mcp_rawc(a, m, "'");
    e = e | _ry_mcp_rawc(a, m, key);
    e = e | _ry_mcp_rawc(a, m, "' out of range: ");
    e = e | _ry_mcp_rawi(a, m, n);
    return (_ry_mcp_err_sb(a, m, e), 0, 0);
}

# The reply `{["note":…,]"potential_mv":<mv>,"potential_v":<mv / 1000>}` (the library returns millivolts).
#must_use
fn _ry_mcp_potential(a, mv: f64, note): i64 {
    if (_ry_is_finite(mv) == 0) { return _ry_mcp_not_finite(a, "potential", mv); }
    var sb = _ry_mcp_open(a);
    if (sb == 0) { return _RY_MCP_OOM; }
    var first = 1;
    var e = 0;
    if (note != 0) {
        e = _ry_mcp_ks(a, sb, "note", 1, note);
        first = 0;
    }
    var volts: f64 = mv / 1000.0;
    e = e | _ry_mcp_kf(a, sb, "potential_mv", first, mv);
    e = e | _ry_mcp_kf(a, sb, "potential_v", 0, volts);
    e = e | _ry_jw_byte(a, sb, 125);
    return _ry_mcp_done(a, sb, e);
}

# The membrane handler on allocator `a`: `nernst` (temp, z an i32, c_out, c_in; z != 0, the rest > 0), `goldman` (the
# default neuron at `temp`, default 310 K) and `fick` (d, dc, dx). Mirrors the private `membrane_handler`.
fn _ry_mcp_membrane_a(a, args, n): i64 {
    var v = _ry_mcp_parse(a, args, n);
    var fs = _ry_mcp_str(v, "function");
    if (fs == 0) { return _ry_mcp_err(a, "missing 'function' parameter"); }
    if (_ry_mcp_is(fs, "nernst") == 1) {
        var bad, hz, z = _ry_mcp_i32(a, v, "z");
        if (bad != 0) { return bad; }
        var ht, temp = _ry_mcp_f64(v, "temp");
        var ho, c_out = _ry_mcp_f64(v, "c_out");
        var hi, c_in = _ry_mcp_f64(v, "c_in");
        if (ht == 0 || hz == 0 || ho == 0 || hi == 0) {
            return _ry_mcp_err(a, "nernst requires: temp, z, c_out, c_in");
        }
        if (z == 0 || temp <= 0.0 || c_out <= 0.0 || c_in <= 0.0) {
            return _ry_mcp_err(a, "nernst requires z != 0, temp > 0, c_out > 0, c_in > 0");
        }
        var mv: f64 = ry_nernst(temp, z, c_out, c_in);
        return _ry_mcp_potential(a, mv, 0);
    }
    if (_ry_mcp_is(fs, "goldman") == 1) {
        var hg, tg = _ry_mcp_f64(v, "temp");
        if (hg == 0) { tg = 310.0; }
        var ions: RyIonicState;
        var perm: RyMembranePermeability;
        ry_ionic_state_default(&ions);
        ry_membrane_permeability_default(&perm);
        if (tg <= 0.0) { return _ry_mcp_err(a, "goldman requires temp > 0"); }
        var gm: f64 = ry_goldman(tg, &ions, &perm);
        return _ry_mcp_potential(a, gm, "using default neuron ionic state");
    }
    if (_ry_mcp_is(fs, "fick") == 1) {
        var hd, d = _ry_mcp_f64(v, "d");
        var hc, dc = _ry_mcp_f64(v, "dc");
        var hx, dx = _ry_mcp_f64(v, "dx");
        if (hd == 0 || hc == 0 || hx == 0) {
            return _ry_mcp_err(a,
              "fick requires: d (diffusion coefficient), dc (concentration gradient), dx (thickness)");
        }
        var flux: f64 = ry_fick_flux(d, dc, dx);
        if (_ry_is_finite(flux) == 0) { return _ry_mcp_not_finite(a, "flux", flux); }
        var sb = _ry_mcp_open(a);
        if (sb == 0) { return _RY_MCP_OOM; }
        var e = _ry_mcp_kf(a, sb, "flux", 1, flux);
        e = e | _ry_jw_byte(a, sb, 125);
        return _ry_mcp_done(a, sb, e);
    }
    return _ry_mcp_err_with(a, "unknown membrane function: ", str_data(fs), str_len(fs));
}

# The membrane tool's bote handler. Mirrors `membrane_handler`.
fn _ry_mcp_membrane(args, claims): i64 {
    return _ry_mcp_membrane_a(bote_req_alloc(), args, _ry_mcp_len(args));
}

# ── alignment ──

# The first character of string argument `key`: (1, its bytes, its byte length) or (0, 0, 0) when absent, not a
# string or empty (Rust's `get_str(…).and_then(|s| s.chars().next())`).
fn _ry_mcp_first_char(v, key): (i64, i64, i64) {
    var s = _ry_mcp_str(v, key);
    if (s == 0 || str_len(s) == 0) { return (0, 0, 0); }
    var p = str_data(s);
    return (1, p, _ry_mcp_char_len(load8(p)));
}

# The alignment handler's `substitution` arm: `{"residue_a":…,"residue_b":…,"score":…}`.
fn _ry_mcp_substitution(a, v, matrix): i64 {
    var ha, pa, na = _ry_mcp_first_char(v, "residue_a");
    var hb, pb, nb = _ry_mcp_first_char(v, "residue_b");
    if (ha == 0 || hb == 0) { return _ry_mcp_err(a, "substitution requires: residue_a, residue_b"); }
    var score = 0;
    if (ry_substitution_score(_ry_mcp_scalar(pa, na), _ry_mcp_scalar(pb, nb), matrix, &score) == 0) {
        return _ry_mcp_err(a, "unknown residue");
    }
    var sb = _ry_mcp_open(a);
    if (sb == 0) { return _RY_MCP_OOM; }
    var e = _ry_jw_key(a, sb, "residue_a", 1);
    e = e | _ry_jw_str(a, sb, pa, na);
    e = e | _ry_jw_key(a, sb, "residue_b", 0);
    e = e | _ry_jw_str(a, sb, pb, nb);
    e = e | _ry_mcp_ki(a, sb, "score", 0, score);
    e = e | _ry_jw_byte(a, sb, 125);
    return _ry_mcp_done(a, sb, e);
}

# The alignment handler on allocator `a`: `substitution`, `score` (equal byte lengths) and `needleman_wunsch`
# (`gap_penalty` an i32, default -4; at most RY_MCP_MAX_ALIGNMENT_CELLS cells), the `matrix` blosum62 (default) or
# pam250, checked before the function. Mirrors the private `alignment_handler`.
fn _ry_mcp_alignment_a(a, args, n): i64 {
    var v = _ry_mcp_parse(a, args, n);
    var fs = _ry_mcp_str(v, "function");
    if (fs == 0) { return _ry_mcp_err(a, "missing 'function' parameter"); }
    var ms = _ry_mcp_str(v, "matrix");
    var matrix = RY_MATRIX_BLOSUM62;
    if (ms != 0) {
        if (_ry_mcp_is(ms, "pam250") == 1) {
            matrix = RY_MATRIX_PAM250;
        } elif (_ry_mcp_is(ms, "blosum62") == 0) {
            var m = str_builder_new_a(a);
            if (m == 0) { return _RY_MCP_OOM; }
            var me = _ry_mcp_rawc(a, m, "unknown matrix: ");
            me = me | _ry_mcp_raw(a, m, str_data(ms), str_len(ms));
            me = me | _ry_mcp_rawc(a, m, " (expected blosum62 or pam250)");
            return _ry_mcp_err_sb(a, m, me);
        }
    }
    if (_ry_mcp_is(fs, "substitution") == 1) { return _ry_mcp_substitution(a, v, matrix); }
    var is_score = _ry_mcp_is(fs, "score");
    if (is_score == 0 && _ry_mcp_is(fs, "needleman_wunsch") == 0) {
        return _ry_mcp_err_with(a, "unknown alignment function: ", str_data(fs), str_len(fs));
    }
    var usage = "needleman_wunsch requires: seq_a, seq_b";
    if (is_score == 1) { usage = "score requires: seq_a, seq_b (equal length)"; }
    var qa[16];
    var qb[16];
    var ra = _ry_mcp_seq(a, v, "seq_a", usage, &qa);
    if (ra != 0) { return ra; }
    var rb = _ry_mcp_seq(a, v, "seq_b", usage, &qb);
    if (rb != 0) { return rb; }
    var sa = load64(&qa);
    var la = load64(&qa + 8);
    var sq = load64(&qb);
    var lb = load64(&qb + 8);
    if (is_score == 1) {
        var r: RyAlignmentScore;
        if (ry_score_alignment(sa, la, sq, lb, matrix, &r) == 0) {
            return _ry_mcp_err(a, "alignment failed — check sequences are equal length with valid residues");
        }
        var sb = _ry_mcp_open(a);
        if (sb == 0) { return _RY_MCP_OOM; }
        var e = _ry_mcp_ki(a, sb, "identities", 1, r.identities);
        e = e | _ry_mcp_kf(a, sb, "identity", 0, r.identity);
        e = e | _ry_mcp_ki(a, sb, "length", 0, r.length);
        e = e | _ry_mcp_ki(a, sb, "score", 0, r.score);
        e = e | _ry_jw_byte(a, sb, 125);
        return _ry_mcp_done(a, sb, e);
    }
    return _ry_mcp_nw(a, v, sa, la, sq, lb, matrix);
}

# The alignment handler's `needleman_wunsch` arm: `{"gap_penalty":…,"score":…}`.
fn _ry_mcp_nw(a, v, sa, la, sq, lb, matrix): i64 {
    if (la > 0 && lb > RY_MCP_MAX_ALIGNMENT_CELLS / la) {
        var m = str_builder_new_a(a);
        if (m == 0) { return _RY_MCP_OOM; }
        var e = _ry_mcp_rawc(a, m, "needleman_wunsch: ");
        e = e | _ry_mcp_rawi(a, m, la);
        e = e | _ry_mcp_rawc(a, m, " x ");
        e = e | _ry_mcp_rawi(a, m, lb);
        e = e | _ry_mcp_rawc(a, m, " exceeds ");
        e = e | _ry_mcp_rawi(a, m, RY_MCP_MAX_ALIGNMENT_CELLS);
        e = e | _ry_mcp_rawc(a, m, " DP cells");
        return _ry_mcp_err_sb(a, m, e);
    }
    var bad, hg, gap = _ry_mcp_i32(a, v, "gap_penalty");
    if (bad != 0) { return bad; }
    if (hg == 0) { gap = 0 - 4; }
    var score = 0;
    var t, found = ry_needleman_wunsch_a(a, sa, la, sq, lb, matrix, gap, &score);
    if (is_err_result(t) == 1) { return _RY_MCP_OOM; }
    if (found == 0) { return _ry_mcp_err(a, "alignment failed — check sequences contain valid residues"); }
    var sb = _ry_mcp_open(a);
    if (sb == 0) { return _RY_MCP_OOM; }
    var e2 = _ry_mcp_ki(a, sb, "gap_penalty", 1, gap);
    e2 = e2 | _ry_mcp_ki(a, sb, "score", 0, score);
    e2 = e2 | _ry_jw_byte(a, sb, 125);
    return _ry_mcp_done(a, sb, e2);
}

# The alignment tool's bote handler. Mirrors `alignment_handler`.
fn _ry_mcp_alignment(args, claims): i64 {
    return _ry_mcp_alignment_a(bote_req_alloc(), args, _ry_mcp_len(args));
}

# ── ptm and domain ──

# A word as a *RyPtmSite (the cast-helper idiom).
#must_use
#pure
fn _ry_mcp_as_sites(p): *RyPtmSite { return p; }

# A word as a *RyDomainHit.
#must_use
#pure
fn _ry_mcp_as_hits(p): *RyDomainHit { return p; }

# The ptm handler on allocator `a`: the sites of `sequence`, `{"count":n,"sites":[{"motif","position","residue",
# "type"},…]}` (Rust's `{:?}` of the type is its variant name). Mirrors the private `ptm_handler`.
fn _ry_mcp_ptm_a(a, args, n): i64 {
    var v = _ry_mcp_parse(a, args, n);
    var q[16];
    var r = _ry_mcp_seq(a, v, "sequence", "missing 'sequence' parameter", &q);
    if (r != 0) { return r; }
    var seq = load64(&q);
    var len = load64(&q + 8);
    if (len <= 0) { return _ry_mcp_err(a, "empty sequence"); }
    # The sites are counted first and their records allocated exactly, as Rust's Vec holds them: the request's arena
    # keeps its chunks, and RY_PTM_MAX_SITES_PER_RESIDUE · len records would be 12 MB at the length limit.
    var count = _ry_ptm_scan(seq, len, 0, 0);
    var sites: *RyPtmSite = _ry_mcp_as_sites(alloc_via(a, count * 40 + 40));   # a RyPtmSite is five words
    if (sites == 0) { return _RY_MCP_OOM; }
    if (_ry_ptm_scan(seq, len, sites, count) != count) { return _RY_MCP_OOM; }
    var sb = _ry_mcp_open(a);
    if (sb == 0) { return _RY_MCP_OOM; }
    var e = _ry_mcp_ki(a, sb, "count", 1, count);
    e = e | _ry_jw_key(a, sb, "sites", 0);
    e = e | _ry_jw_byte(a, sb, 91);
    var k = 0;
    while (k < count) {
        var s: *RyPtmSite = sites + k;           # a typed pointer: k records on
        var m[24];
        var tm, ml = ry_ptm_site_motif(seq, s, &m, 24);
        if (is_err_result(tm) == 1) { return _ry_mcp_err(a, "motif over 24 bytes"); }   # never, for a scan's site
        var res[8];
        store8(&res, s.residue);
        if (k > 0) { e = e | _ry_jw_byte(a, sb, 44); }
        e = e | _ry_jw_byte(a, sb, 123);
        e = e | _ry_jw_key(a, sb, "motif", 1);
        e = e | _ry_jw_str(a, sb, &m, ml);
        e = e | _ry_mcp_ki(a, sb, "position", 0, s.position);
        e = e | _ry_jw_key(a, sb, "residue", 0);
        e = e | _ry_jw_str(a, sb, &res, 1);
        e = e | _ry_mcp_ks(a, sb, "type", 0, ry_ptm_type_name(s.ptm_type));
        e = e | _ry_jw_byte(a, sb, 125);
        k = k + 1;
    }
    e = e | _ry_jw_byte(a, sb, 93);
    e = e | _ry_jw_byte(a, sb, 125);
    return _ry_mcp_done(a, sb, e);
}

# The ptm tool's bote handler. Mirrors `ptm_handler`.
fn _ry_mcp_ptm(args, claims): i64 {
    return _ry_mcp_ptm_a(bote_req_alloc(), args, _ry_mcp_len(args));
}

# The domain handler on allocator `a`: the motifs of `sequence`, `{"count":n,"domains":[{"end","fragment","start",
# "type"},…]}`. Mirrors the private `domain_handler`.
fn _ry_mcp_domain_a(a, args, n): i64 {
    var v = _ry_mcp_parse(a, args, n);
    var q[16];
    var r = _ry_mcp_seq(a, v, "sequence", "missing 'sequence' parameter", &q);
    if (r != 0) { return r; }
    var seq = load64(&q);
    var len = load64(&q + 8);
    if (len <= 0) { return _ry_mcp_err(a, "empty sequence"); }
    # Counted first and allocated exactly, as the ptm handler's sites (RY_DOMAIN_MAX_HITS_PER_RESIDUE · len records
    # would be 36 MB at the length limit).
    var count = _ry_domain_scan(seq, len, 0, 0);
    var hits: *RyDomainHit = _ry_mcp_as_hits(alloc_via(a, count * 40 + 40));   # a RyDomainHit is five words
    if (hits == 0) { return _RY_MCP_OOM; }
    if (_ry_domain_scan(seq, len, hits, count) != count) { return _RY_MCP_OOM; }
    var frag = alloc_via(a, RY_DOMAIN_MAX_FRAGMENT_BYTES);
    var sb = _ry_mcp_open(a);
    if (sb == 0 || frag == 0) { return _RY_MCP_OOM; }
    var e = _ry_mcp_ki(a, sb, "count", 1, count);
    e = e | _ry_jw_key(a, sb, "domains", 0);
    e = e | _ry_jw_byte(a, sb, 91);
    var k = 0;
    while (k < count) {
        var h: *RyDomainHit = hits + k;          # a typed pointer: k records on
        var tf, fl = ry_domain_hit_fragment(seq, h, frag, RY_DOMAIN_MAX_FRAGMENT_BYTES);
        if (is_err_result(tf) == 1) { return _ry_mcp_err(a, "fragment over 100 bytes"); }   # never, for a scan's hit
        if (k > 0) { e = e | _ry_jw_byte(a, sb, 44); }
        e = e | _ry_jw_byte(a, sb, 123);
        e = e | _ry_mcp_ki(a, sb, "end", 1, h.end);
        e = e | _ry_jw_key(a, sb, "fragment", 0);
        e = e | _ry_jw_str(a, sb, frag, fl);
        e = e | _ry_mcp_ki(a, sb, "start", 0, h.start);
        e = e | _ry_mcp_ks(a, sb, "type", 0, ry_domain_type_name(h.domain_type));
        e = e | _ry_jw_byte(a, sb, 125);
        k = k + 1;
    }
    e = e | _ry_jw_byte(a, sb, 93);
    e = e | _ry_jw_byte(a, sb, 125);
    return _ry_mcp_done(a, sb, e);
}

# The domain tool's bote handler. Mirrors `domain_handler`.
fn _ry_mcp_domain(args, claims): i64 {
    return _ry_mcp_domain_a(bote_req_alloc(), args, _ry_mcp_len(args));
}
