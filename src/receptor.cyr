}

# Appends ReceptorFlux `f` as serde_json writes it, its three values in declaration order, on allocator `a`: Ok(0),
# or Err(RY_ERR_OUT_OF_MEMORY).
#must_use
fn ry_receptor_flux_to_json_a(a, sb, f: *RyReceptorFlux): Result {
    if (_ry_jw_f64_fields(a, sb, f, 3, &_RY_RECEPTOR_FLUX_FIELDS) != 0) { return Err(RY_ERR_OUT_OF_MEMORY); }
    return Ok(0);
