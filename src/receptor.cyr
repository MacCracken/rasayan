# The ReceptorFlux at node `v` of a parsed document, by serde's rules, into the 24 bytes at `w`: 1, or 0 for a
# refusal.
#must_use
fn _ry_receptor_flux_from_node(v, w): i64 {
    return _ry_jr_f64_fields(v, w, 3, &_RY_RECEPTOR_FLUX_FIELDS);
