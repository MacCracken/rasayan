    var w[24];
    var v = _ry_jr_parse(a, buf, n);
    if (_ry_receptor_flux_from_node(v, &w) == 0) {
        return Err(_ry_fail_text(RY_ERR_DESERIALIZE, "ReceptorFlux", 12));
    }
    memcpy(out, &w, 24);
    return Ok(0);
}

# ry_receptor_flux_from_json_a on the default allocator (the tree is never freed: for a one-off read).
#must_use
fn ry_receptor_flux_from_json(buf, n, out: *RyReceptorFlux): Result {
    return ry_receptor_flux_from_json_a(default_alloc(), buf, n, out);
}
