# Na+ extracellular (mM).
# Rust: rasayan::membrane::IonicState::default().na_out
const RY_MEMBRANE_IONIC_STATE_DEFAULT_NA_OUT = 145.0;

# K+ intracellular (mM).
# Rust: rasayan::membrane::IonicState::default().k_in
const RY_MEMBRANE_IONIC_STATE_DEFAULT_K_IN = 155.0;

# K+ extracellular (mM).
