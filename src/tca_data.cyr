# Enzyme kinetic parameters for PDH and all 8 TCA cycle steps.
#
# Default values are physiological consensus. Vmax in mM/s.
# Sources: Stryer Biochemistry, Lehninger, Cortassa et al. (2003).
# Rust: rasayan::tca::TcaConfig::default()

# PDH Vmax (mM/s).
# Rust: rasayan::tca::TcaConfig::default().pdh_vmax
const RY_TCA_TCA_CONFIG_DEFAULT_PDH_VMAX = 0.3;

# PDH Km for pyruvate (mM).
# Rust: rasayan::tca::TcaConfig::default().pdh_km_pyruvate
const RY_TCA_TCA_CONFIG_DEFAULT_PDH_KM_PYRUVATE = 0.025;

# CS Vmax (mM/s).
# Rust: rasayan::tca::TcaConfig::default().cs_vmax
const RY_TCA_TCA_CONFIG_DEFAULT_CS_VMAX = 0.15;

# CS Km for oxaloacetate (mM).
# Rust: rasayan::tca::TcaConfig::default().cs_km_oaa
const RY_TCA_TCA_CONFIG_DEFAULT_CS_KM_OAA = 0.005;

# CS Km for acetyl-CoA (mM).
# Rust: rasayan::tca::TcaConfig::default().cs_km_accoa
const RY_TCA_TCA_CONFIG_DEFAULT_CS_KM_ACCOA = 0.01;

# CS dissociation constant for OAA from free enzyme (mM).
# Rust: rasayan::tca::TcaConfig::default().cs_ki_oaa
const RY_TCA_TCA_CONFIG_DEFAULT_CS_KI_OAA = 0.002;

# CS Ki for citrate product inhibition (mM).
# Rust: rasayan::tca::TcaConfig::default().cs_ki_citrate
const RY_TCA_TCA_CONFIG_DEFAULT_CS_KI_CITRATE = 2.0;

# Aconitase forward Vmax (mM/s).
