# Concentrations of TCA cycle intermediates and acetyl-CoA (mM).
#
# Default values represent a typical resting mammalian cell.
# Rust: rasayan::tca::TcaState::default()

# Acetyl-CoA (mM). Entry substrate from PDH or beta-oxidation.
# Rust: rasayan::tca::TcaState::default().acetyl_coa
const RY_TCA_TCA_STATE_DEFAULT_ACETYL_COA = 0.05;

# Citrate (mM).
# Rust: rasayan::tca::TcaState::default().citrate
const RY_TCA_TCA_STATE_DEFAULT_CITRATE = 0.3;

# Isocitrate (mM).
# Rust: rasayan::tca::TcaState::default().isocitrate
const RY_TCA_TCA_STATE_DEFAULT_ISOCITRATE = 0.02;

# α-Ketoglutarate (mM).
# Rust: rasayan::tca::TcaState::default().alpha_kg
const RY_TCA_TCA_STATE_DEFAULT_ALPHA_KG = 0.3;

# Succinyl-CoA (mM).
# Rust: rasayan::tca::TcaState::default().succinyl_coa
const RY_TCA_TCA_STATE_DEFAULT_SUCCINYL_COA = 0.1;

# Succinate (mM).
# Rust: rasayan::tca::TcaState::default().succinate
const RY_TCA_TCA_STATE_DEFAULT_SUCCINATE = 0.5;

# Fumarate (mM).
# Rust: rasayan::tca::TcaState::default().fumarate
const RY_TCA_TCA_STATE_DEFAULT_FUMARATE = 0.05;

# Malate (mM).
# Rust: rasayan::tca::TcaState::default().malate
const RY_TCA_TCA_STATE_DEFAULT_MALATE = 0.3;

# Oxaloacetate (mM). Catalytic — regenerated each turn.
# Rust: rasayan::tca::TcaState::default().oxaloacetate
const RY_TCA_TCA_STATE_DEFAULT_OXALOACETATE = 0.01;

