# energy.cyr — bioenergetics: phosphocreatine and glycogen reserves under exertion, ATP demand, and the bridge
# functions sharira and kiran call (Rust 1.2.0's `energy.rs`, transcribed).
#
# Reserves are fractions of the resting, well-fed muscle store; exertion in MET; BioenergyState's time step in
# minutes. Every operation is in Rust's order: tests/golden/energy.tsv compares each function with the oracle's at
# ≤ 2 ulp where only + − × ÷ run (class B, expected 0), at 0 ulp against the corrected oracle where a tick's
# phosphocreatine activation calls `exp_m1` (class C, ADR 0003: `_ry_cr_expm1`), bit for bit over the trajectory
# scripts (class T), and sharira 1.1.0's per-tick call shape on its own rows (`sharira::MetabolicCoupling::tick`).
#
# The Cyrius forms (ADR 0002 rows 7, 10):
# - BioenergyState is a struct (RyBioenergyState); its methods take a pointer, and the two mutators update it in
#   place: `ry_bioenergy_state_tick(&b, dt_minutes)`;
# - `BioenergyState::default()`'s values are generated consts (src/energy_data.cyr,
#   `RY_ENERGY_BIOENERGY_STATE_DEFAULT_*`), which ry_bioenergy_state_default(&out) fills a struct from;
# - `recovery_rate_modifier`'s `is_anaerobic: bool` is an i64, nonzero for true;
# - Rust's two `tracing::trace!` events (`set_exertion`, `bioenergy_tick`) are level-gated sakshi events under the
#   target `rasayan::energy`, their fields in Rust's order;
# - BioenergyState's serde codec is `ry_bioenergy_state_to_json` / `_from_json` (and `_a`, on an allocator).

# The bioenergetic state of an entity: the phosphocreatine and glycogen reserves (0–1, fractions of the resting
# muscle store), the current exertion (MET, 1.0 = resting) and the anaerobic threshold (MET). Rust's
# `BioenergyState`.
struct RyBioenergyState {
    phosphocreatine: f64;
    glycogen: f64;
    met: f64;
    anaerobic_threshold: f64;
}

# The NUL-separated field names, in Rust's declaration order (JSON).
var _RY_BIOENERGY_STATE_FIELDS = "phosphocreatine\0glycogen\0met\0anaerobic_threshold\0";

# Fills *out with the default state (RY_ENERGY_BIOENERGY_STATE_DEFAULT_*: phosphocreatine 0.9, glycogen 0.8, MET 1,
# anaerobic threshold 6). Mirrors `BioenergyState::default()`.
fn ry_bioenergy_state_default(out: *RyBioenergyState) {
    var pcr: f64 = RY_ENERGY_BIOENERGY_STATE_DEFAULT_PHOSPHOCREATINE;
    var gly: f64 = RY_ENERGY_BIOENERGY_STATE_DEFAULT_GLYCOGEN;
    var met: f64 = RY_ENERGY_BIOENERGY_STATE_DEFAULT_MET;
    var thr: f64 = RY_ENERGY_BIOENERGY_STATE_DEFAULT_ANAEROBIC_THRESHOLD;
    out.phosphocreatine = pcr;
    out.glycogen = gly;
    out.met = met;
    out.anaerobic_threshold = thr;
    return 0;
}

# Ok(0) when the reserves are finite and in [0, 1] and met and anaerobic_threshold are finite and >= 1; else, in that
# order, the first refusal (`_ry_guard_fraction`, `_ry_guard_at_least`). Mirrors `BioenergyState::validate`.
#must_use
fn ry_bioenergy_state_validate(p: *RyBioenergyState): Result {
    var pcr: f64 = p.phosphocreatine;
    var gly: f64 = p.glycogen;
    var met: f64 = p.met;
    var thr: f64 = p.anaerobic_threshold;
    var t1, v1 = _ry_guard_fraction("phosphocreatine", pcr);
    if (is_err_result(t1) == 1) { return Err(v1); }
    var t2, v2 = _ry_guard_fraction("glycogen", gly);
    if (is_err_result(t2) == 1) { return Err(v2); }
    var t3, v3 = _ry_guard_at_least("met", met, 1.0);
    if (is_err_result(t3) == 1) { return Err(v3); }
    var t4, v4 = _ry_guard_at_least("anaerobic_threshold", thr, 1.0);
    if (is_err_result(t4) == 1) { return Err(v4); }
    return Ok(0);
}

# 1 when exercising above the anaerobic threshold, else 0. Mirrors `BioenergyState::is_anaerobic`.
#must_use
#pure
fn ry_bioenergy_state_is_anaerobic(p: *RyBioenergyState): i64 {
    var met: f64 = p.met;
    var thr: f64 = p.anaerobic_threshold;
    if (met > thr) { return 1; }
    return 0;
}

# The O2 consumption rate (mL/kg/min), MET · RY_ENERGY_MET_O2_RATE. Mirrors `BioenergyState::o2_consumption`.
#must_use
#pure
fn ry_bioenergy_state_o2_consumption(p: *RyBioenergyState): f64 {
    var met: f64 = p.met;
    var r: f64 = met * RY_ENERGY_MET_O2_RATE;
    return r;
}

# Sets the exertion level (MET): below 1.0 (resting) it is raised to 1.0; NaN or infinite is resting. Mirrors
# `BioenergyState::set_exertion`.
fn ry_bioenergy_state_set_exertion(p: *RyBioenergyState, met: f64) {
    if (_ry_trace_on() == 1) {
        _ry_trace_f1("rasayan::energy", "set_exertion", "met", met);
    }
    var c: f64 = _ry_guard_conc(met);
    var r: f64 = _ry_max(c, 1.0);
    p.met = r;
    return 0;
}

# Ticks the reserves at the current exertion over `dt_minutes`. With x = MET − 1 (NaN or infinite MET counts as
# resting) and e = max(0, MET − threshold) (0 for a NaN or +inf threshold): phosphocreatine relaxes,
# `dP/dt = k_rec·(1 − P) − k_use·P` with k_rec = RY_ENERGY_PCR_RECOVERY_RATE and k_use = RY_ENERGY_PCR_DEPLETION_RATE·e
# (`_ry_integrate_activate`, exact); glycogen is used at GLYCOGEN_DEPLETION_RATE·x + GLYCOGEN_ANAEROBIC_RATE·e² per
# minute and resynthesized at GLYCOGEN_RECOVERY_RATE when MET <= GLYCOGEN_RECOVERY_THRESHOLD, capped to [0, 1]
# (`_ry_guard_shift`). Reserves outside [0, 1] or NaN are mapped into it first. A non-finite or non-positive dt does
# nothing. Mirrors `BioenergyState::tick`.
fn ry_bioenergy_state_tick(p: *RyBioenergyState, dt_minutes: f64) {
    if (_ry_guard_valid_dt(dt_minutes) == 0) { return 0; }
    var met_in: f64 = p.met;
    var thr: f64 = p.anaerobic_threshold;
    if (_ry_trace_on() == 1) {
        _ry_trace_f3("rasayan::energy", "bioenergy_tick", "dt_minutes", dt_minutes, "met", met_in,
          "anaerobic_threshold", thr);
    }
    var above_rest: f64 = _ry_guard_conc(met_in - 1.0);
    var met: f64 = 1.0 + above_rest;
    var above: f64 = _ry_guard_conc(met - thr);
    var pcr_in: f64 = p.phosphocreatine;
    var pcr: f64 = _ry_guard_unit(pcr_in);
    var k_use: f64 = RY_ENERGY_PCR_DEPLETION_RATE * above;
    var p2: f64 = _ry_integrate_activate(pcr, RY_ENERGY_PCR_RECOVERY_RATE, k_use, dt_minutes);
    p.phosphocreatine = p2;
    var aerobic: f64 = RY_ENERGY_GLYCOGEN_DEPLETION_RATE * above_rest;
    var anaerobic: f64 = RY_ENERGY_GLYCOGEN_ANAEROBIC_RATE * above * above;
    var net: f64 = aerobic + anaerobic;
    if (met <= RY_ENERGY_GLYCOGEN_RECOVERY_THRESHOLD) { net = net - RY_ENERGY_GLYCOGEN_RECOVERY_RATE; }
    var gly_in: f64 = p.glycogen;
    var gly: f64 = _ry_guard_unit(gly_in);
    var room: f64 = 1.0 - gly;
    var moved: f64 = _ry_guard_shift(net * dt_minutes, gly, room);
    var g2: f64 = gly - moved;
    p.glycogen = g2;
    return 0;
}

# The overall energy availability, `0.3 · phosphocreatine + 0.7 · glycogen` clamped to [0, 1] (a NaN passes through,
# as Rust's `clamp`). Mirrors `BioenergyState::energy_available`.
#must_use
#pure
fn ry_bioenergy_state_energy_available(p: *RyBioenergyState): f64 {
    var pcr: f64 = p.phosphocreatine;
    var gly: f64 = p.glycogen;
    var x: f64 = pcr * 0.3 + gly * 0.7;
    var r: f64 = _ry_clamp(x, 0.0, 1.0);
    return r;
}

# ── bridge functions (sharira, kiran) ──

# The ATP turnover (mmol/s) of a mechanical power output (W): ~40 % efficiency and |ΔG°′| of ATP hydrolysis
# (RY_ENERGY_ATP_HYDROLYSIS_DG, 30.5 kJ/mol). An amount per second for the whole working muscle; negative, NaN or
# infinite power is 0. Mirrors `energy::atp_demand_from_power`.
#must_use
#pure
fn ry_atp_demand_from_power(mechanical_power_w: f64): f64 {
    var power: f64 = _ry_guard_conc(mechanical_power_w);
    var metabolic: f64 = power / 0.40;
    var dg: f64 = f64_abs(RY_ENERGY_ATP_HYDROLYSIS_DG);
    var per_mol: f64 = dg * 1000.0;
    var r: f64 = (metabolic / per_mol) * 1000.0;
    return r;
}

# The fatigue rate multiplier at an energy availability: 1 at full energy, max_multiplier at none. Always finite and
# >= 1: a max_multiplier below 1, NaN or infinite counts as 1; the availability is clamped to [0, 1], NaN as 0.
# Mirrors `energy::fatigue_rate_from_energy`.
#must_use
#pure
fn ry_fatigue_rate_from_energy(energy_available: f64, max_multiplier: f64): f64 {
    var e: f64 = _ry_guard_unit(energy_available);
    var extra: f64 = _ry_guard_conc(max_multiplier - 1.0);
    var r: f64 = 1.0 + extra * (1.0 - e);
    return r;
}

# The recovery rate multiplier: 1 when aerobic (is_anaerobic 0), else anaerobic_fraction clamped to [0, 1] (NaN as
# 0). Mirrors `energy::recovery_rate_modifier`.
#must_use
#pure
fn ry_recovery_rate_modifier(is_anaerobic, anaerobic_fraction: f64): f64 {
    if (is_anaerobic != 0) {
        var r: f64 = _ry_guard_unit(anaerobic_fraction);
        return r;
    }
    return 1.0;
}

# The MET of a mechanical power output (W) at a body mass (kg), by the ACSM leg-ergometry equation:
# `VO2 = 3.5 + 3.5 + 1.8 · WR / mass` (mL/kg/min, WR in kg·m/min, 1 W = 6.12 kg·m/min; the unloaded-cycling 3.5 only
# for power > 0), MET = VO2 / 3.5, at least 1. 1 for a mass that is not finite and > 0; negative, NaN or infinite
# power is 0 W. Mirrors `energy::met_from_power`.
#must_use
#pure
fn ry_met_from_power(mechanical_power_w: f64, body_mass_kg: f64): f64 {
    if (_ry_is_finite(body_mass_kg) == 0 || body_mass_kg <= 0.0) { return 1.0; }
    var power: f64 = _ry_guard_conc(mechanical_power_w);
    var vo2: f64 = RY_ENERGY_MET_O2_RATE;
    if (power > 0.0) {
        var k: f64 = 1.8 * _RY_ENERGY_KGM_PER_MIN_PER_WATT;
        var work: f64 = k * power / body_mass_kg;
        var add: f64 = RY_ENERGY_MET_O2_RATE + work;
        vo2 = vo2 + add;
    }
    var m: f64 = vo2 / RY_ENERGY_MET_O2_RATE;
    var r: f64 = _ry_max(m, 1.0);
    return r;
}

# ── JSON (P7: serde_json's documents) ──

# Appends BioenergyState `p` as serde_json writes it,
# `{"phosphocreatine":…,"glycogen":…,"met":…,"anaerobic_threshold":…}`, on allocator `a`: Ok(0), or
# Err(RY_ERR_OUT_OF_MEMORY) when the builder could not grow.
#must_use
fn ry_bioenergy_state_to_json_a(a, sb, p: *RyBioenergyState): Result {
    if (_ry_jw_f64_fields(a, sb, p, 4, _RY_BIOENERGY_STATE_FIELDS) != 0) { return Err(RY_ERR_OUT_OF_MEMORY); }
    return Ok(0);
}

# ry_bioenergy_state_to_json_a on the default allocator (a builder from str_builder_new).
#must_use
fn ry_bioenergy_state_to_json(sb, p: *RyBioenergyState): Result {
    return ry_bioenergy_state_to_json_a(default_alloc(), sb, p);
}

# Reads a BioenergyState from the `n`-byte document at `buf` by serde's rules (its tree on allocator `a`, which the
# caller resets): Ok(0) with *out filled, or Err(RY_ERR_DESERIALIZE).
#must_use
fn ry_bioenergy_state_from_json_a(a, buf, n, out: *RyBioenergyState): Result {
    var w[32];
    var v = _ry_jr_parse(a, buf, n);
    if (_ry_jr_f64_fields(v, &w, 4, _RY_BIOENERGY_STATE_FIELDS) == 0) {
        return Err(_ry_fail_text(RY_ERR_DESERIALIZE, "BioenergyState", 14));
    }
    memcpy(out, &w, 32);
    return Ok(0);
}

# ry_bioenergy_state_from_json_a on the default allocator (the tree is never freed: for a one-off read).
#must_use
fn ry_bioenergy_state_from_json(buf, n, out: *RyBioenergyState): Result {
    return ry_bioenergy_state_from_json_a(default_alloc(), buf, n, out);
}
