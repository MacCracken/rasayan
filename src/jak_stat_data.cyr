const RY_JAK_STAT_JAK_STAT_CONFIG_DEFAULT_DIMER_DECAY_RATE = 0.1;

# SOCS induction rate by STAT dimers (s^-1 per unit dimer).
# Rust: rasayan::jak_stat::JakStatConfig::default().socs_induction_rate
const RY_JAK_STAT_JAK_STAT_CONFIG_DEFAULT_SOCS_INDUCTION_RATE = 0.3;

# SOCS degradation rate (s^-1).
