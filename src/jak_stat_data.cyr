# JAK active (phosphorylated) fraction.
# Rust: rasayan::jak_stat::JakStatState::default().jak_active
const RY_JAK_STAT_JAK_STAT_STATE_DEFAULT_JAK_ACTIVE = 0.02;

# Monomeric phosphorylated STAT, as a fraction of total STAT.
# Rust: rasayan::jak_stat::JakStatState::default().stat_phosphorylated
const RY_JAK_STAT_JAK_STAT_STATE_DEFAULT_STAT_PHOSPHORYLATED = 0.01;

# STAT-P dimers (nuclear, active transcription factor), as a fraction of
# total STAT monomer. Each dimer holds two STAT, so
# `stat_phosphorylated + 2·stat_dimer <= 1`.
# Rust: rasayan::jak_stat::JakStatState::default().stat_dimer
const RY_JAK_STAT_JAK_STAT_STATE_DEFAULT_STAT_DIMER = 0.01;

# SOCS level (normalized, `>= 0`). Negative feedback inhibitor.
# Rust: rasayan::jak_stat::JakStatState::default().socs
const RY_JAK_STAT_JAK_STAT_STATE_DEFAULT_SOCS = 0.1;

