# Kinetic parameters for JAK-STAT.
# Rust: rasayan::jak_stat::JakStatConfig::default()

# JAK phosphorylation Vmax (s^-1 per unit inactive JAK).
# Rust: rasayan::jak_stat::JakStatConfig::default().jak_vmax
const RY_JAK_STAT_JAK_STAT_CONFIG_DEFAULT_JAK_VMAX = 0.5;

# Cytokine level giving half-maximal JAK activation (must be > 0).
# Rust: rasayan::jak_stat::JakStatConfig::default().jak_km
const RY_JAK_STAT_JAK_STAT_CONFIG_DEFAULT_JAK_KM = 0.1;

# JAK dephosphorylation rate (SHP phosphatases, s^-1).
# Rust: rasayan::jak_stat::JakStatConfig::default().jak_phosphatase_rate
const RY_JAK_STAT_JAK_STAT_CONFIG_DEFAULT_JAK_PHOSPHATASE_RATE = 0.3;

# STAT phosphorylation Vmax (s^-1 per unit unphosphorylated STAT).
# Rust: rasayan::jak_stat::JakStatConfig::default().stat_vmax
const RY_JAK_STAT_JAK_STAT_CONFIG_DEFAULT_STAT_VMAX = 0.8;

# Active-JAK fraction giving half-maximal STAT phosphorylation
# (must be > 0).
# Rust: rasayan::jak_stat::JakStatConfig::default().stat_km
const RY_JAK_STAT_JAK_STAT_CONFIG_DEFAULT_STAT_KM = 0.1;

# STAT-P dephosphorylation rate (s^-1).
# Rust: rasayan::jak_stat::JakStatConfig::default().stat_phosphatase_rate
const RY_JAK_STAT_JAK_STAT_CONFIG_DEFAULT_STAT_PHOSPHATASE_RATE = 0.2;

# STAT dimerization rate constant (s^-1, second-order in STAT-P:
# dimers form at `dimer_rate · stat_phosphorylated²`).
# Rust: rasayan::jak_stat::JakStatConfig::default().dimer_rate
const RY_JAK_STAT_JAK_STAT_CONFIG_DEFAULT_DIMER_RATE = 1.0;

# STAT dimer dissociation rate (s^-1); returns two STAT-P per dimer.
