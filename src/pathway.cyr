# Appends NetworkFlux `f` as serde_json writes it, each pathway flux a nested object (its rates one array) and then
# `net_atp`, `o2_consumed` and `co2_produced`, on allocator `a`: Ok(0), or Err(RY_ERR_OUT_OF_MEMORY).
#must_use
fn ry_network_flux_to_json_a(a, sb, f: *RyNetworkFlux): Result {
    var w = f;
    var name = &_RY_NETWORK_FLUX_FIELDS;
    var e = _ry_jw_byte(a, sb, 123);
    e = e | _ry_jw_key(a, sb, name, 1);
    var t1, v1 = ry_glycolysis_flux_to_json_a(a, sb, w);
    if (is_err_result(t1) == 1) { e = 1; }
    name = name + strlen(name) + 1;
    e = e | _ry_jw_key(a, sb, name, 0);
    var t2, v2 = ry_tca_flux_to_json_a(a, sb, w + _RY_NETFLUX_TCA);
    if (is_err_result(t2) == 1) { e = 1; }
    name = name + strlen(name) + 1;
    e = e | _ry_jw_key(a, sb, name, 0);
    var t3, v3 = ry_etc_flux_to_json_a(a, sb, w + _RY_NETFLUX_ETC);
    if (is_err_result(t3) == 1) { e = 1; }
    name = name + strlen(name) + 1;
    e = e | _ry_jw_key(a, sb, name, 0);
    var t4, v4 = ry_beta_ox_flux_to_json_a(a, sb, w + _RY_NETFLUX_BETA_OX);
    if (is_err_result(t4) == 1) { e = 1; }
    name = name + strlen(name) + 1;
    e = e | _ry_jw_key(a, sb, name, 0);
    var t5, v5 = ry_amino_catab_flux_to_json_a(a, sb, w + _RY_NETFLUX_AMINO);
    if (is_err_result(t5) == 1) { e = 1; }
    var k = 0;
    while (k < 3) {
        name = name + strlen(name) + 1;
        e = e | _ry_jw_key(a, sb, name, 0);
        var x: f64 = load64(w + _RY_NETFLUX_TOTALS + 8 * k);
        e = e | _ry_jw_f64(a, sb, x);
        k = k + 1;
    }
    e = e | _ry_jw_byte(a, sb, 125);
    if (e != 0) { return Err(RY_ERR_OUT_OF_MEMORY); }
    return Ok(0);
}

# ry_network_flux_to_json_a on the default allocator.
#must_use
fn ry_network_flux_to_json(sb, f: *RyNetworkFlux): Result {
    return ry_network_flux_to_json_a(default_alloc(), sb, f);
}

# The NetworkFlux at node `v`, by serde's rules (an object by field name, or an array of its eight fields; each pathway
# flux itself an object or an array), into the 496 bytes at `w`: 1, or 0 for a refusal.
#must_use
fn _ry_network_flux_from_node(v, w): i64 {
    var form = _ry_jr_form(v, 8);
    if (form == 0) { return 0; }
    var name = &_RY_NETWORK_FLUX_FIELDS;
    var ok = _ry_glycolysis_flux_from_node(_ry_jr_at(v, form, 0, name), w);
    name = name + strlen(name) + 1;
    if (ok == 1) { ok = _ry_tca_flux_from_node(_ry_jr_at(v, form, 1, name), w + _RY_NETFLUX_TCA); }
    name = name + strlen(name) + 1;
    if (ok == 1) { ok = _ry_etc_flux_from_node(_ry_jr_at(v, form, 2, name), w + _RY_NETFLUX_ETC); }
    name = name + strlen(name) + 1;
    if (ok == 1) { ok = _ry_beta_ox_flux_from_node(_ry_jr_at(v, form, 3, name), w + _RY_NETFLUX_BETA_OX); }
    name = name + strlen(name) + 1;
    if (ok == 1) { ok = _ry_amino_catab_flux_from_node(_ry_jr_at(v, form, 4, name), w + _RY_NETFLUX_AMINO); }
    var k = 5;
    while (k < 8 && ok == 1) {
        name = name + strlen(name) + 1;
        if (_ry_jr_f64(_ry_jr_at(v, form, k, name), w + _RY_NETFLUX_TOTALS + 8 * (k - 5)) == 0) { ok = 0; }
        k = k + 1;
    }
    return ok;
}

# Reads a NetworkFlux from the `n`-byte document at `buf` by serde's rules (its tree on allocator `a`): Ok(0) with *out
# filled, or Err(RY_ERR_DESERIALIZE) with *out untouched.
#must_use
fn ry_network_flux_from_json_a(a, buf, n, out: *RyNetworkFlux): Result {
