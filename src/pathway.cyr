    var v = _ry_jr_parse(a, buf, n);
    if (_ry_network_flux_from_node(v, &w) == 0) {
        return Err(_ry_fail_text(RY_ERR_DESERIALIZE, "NetworkFlux", 11));
    }
    memcpy(out, &w, _RY_NETFLUX_SIZE);
