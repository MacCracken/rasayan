# rasayan — src/pathway.cyr: the metabolic network (rust-old/src/pathway.rs)
#
# M5 part 1: the six types, their defaults and validators, `respiratory_quotient`, the private NAD+/NADH solve layer
# and the crate-private sub-step sums, and the serde codecs. Part 2: the step (`produce`, `step`, `tick_in`, `tick`;
# the producer probe a frame copy of the network, probe 2). The steady-state run joins at part 3.
#
# The Cyrius forms (ADR 0002 rows 7, 10, 14):
# - Each network type holds its pathways' values by value, nested in place, as Rust's does: RyMetabolicNetwork is
#   264 bytes (glycolysis's 11 words, TCA's 9, the ETC's 3, β-oxidation's 2, amino-acid catabolism's 3, then the
#   five shared pools), RyNetworkConfig 832 (the five configs, then `nad_ratio_sensitivity`), RyNetworkFlux 496,
#   RyNetworkTick 536. A nested value's address is the struct's plus its offset (`_RY_NET_*`): `&n.tca` is not taken
#   at the pin.
# - `solve_decreasing`'s closure (`impl Fn(f64) -> f64`, capturing the balance's inputs) is a fn pointer called through
#   callptr with a context struct: `excess(ctx, n)` (port plan §7.3, probe 4). Its loop is transcribed statement for
#   statement (P9); `st`, when not 0, gets the iterations entered (st[0]) and how the solve ended (st[1]), which the
#   golden rows pin and the network's step does not ask for.
# - The validators chain the pathways' own and then the shared pools' guards, in Rust's order; the codecs write the
#   nested values with the pathways' own writers and read them with their node readers (`_ry_<t>_from_node`).

# ── the types ──

# Unified metabolic network state: every pathway's state plus the shared cofactor pools that connect them.
struct RyMetabolicNetwork {
    glycolysis: RyGlycolysisState;
    tca: RyTcaState;
    etc: RyEtcState;
    beta_ox: RyBetaOxState;
    amino_catab: RyAminoCatabState;
    atp: f64;
    adp: f64;
    nad_ratio: f64;
    oxygen: f64;
    malonyl_coa: f64;
}

# Configuration for all pathways in the network. `nad_ratio_sensitivity` is unused since 1.2.0 (the NAD+/NADH ratio
# follows an explicit NADH pool) and kept for compatibility: still validated as finite and >= 0.
struct RyNetworkConfig {
    glycolysis: RyGlycolysisConfig;
    tca: RyTcaConfig;
    etc: RyEtcConfig;
    beta_ox: RyBetaOxConfig;
    amino_catab: RyAminoCatabConfig;
    nad_ratio_sensitivity: f64;
}

# Combined flux from all pathways for a tick: the pathway fluxes, the net ATP change applied to the shared pool
# (limited to [−atp, adp], so ATP + ADP is conserved), the O2 consumed and the CO2 produced (mM).
struct RyNetworkFlux {
    glycolysis: RyGlycolysisFlux;
    tca: RyTcaFlux;
    etc: RyEtcFlux;
    beta_ox: RyBetaOxFlux;
    amino_catab: RyAminoCatabFlux;
    net_atp: f64;
    o2_consumed: f64;
    co2_produced: f64;
}

# What the cell's surroundings supply and demand over a tick: ATP hydrolysed by cellular work (mM/s) and the plasma
# glucose, free fatty acid and amino acid levels the cell's pools relax toward (mM).
struct RyNetworkEnvironment {
    atp_demand: f64;
    plasma_glucose: f64;
    plasma_fatty_acids: f64;
    plasma_amino_acids: f64;
}

# Exchange between the cell and plasma over a tick (mM of cell volume): substrate uptake (negative: released), the
# lactate exported, and the ATP the environment's demand actually hydrolysed.
struct RyNetworkExchange {
    glucose_uptake: f64;
    fatty_acid_uptake: f64;
    amino_acid_uptake: f64;
    lactate_export: f64;
    atp_demand_met: f64;
}

# Result of a network tick in an environment: the pathway fluxes plus what crossed the plasma membrane.
struct RyNetworkTick {
    flux: RyNetworkFlux;
    exchange: RyNetworkExchange;
}

# The nested values' byte offsets.
const _RY_NET_TCA = 88;
const _RY_NET_ETC = 160;
const _RY_NET_BETA_OX = 184;
const _RY_NET_AMINO = 200;
const _RY_NET_POOLS = 224;
const _RY_NET_SIZE = 264;
const _RY_NETCFG_TCA = 304;
const _RY_NETCFG_ETC = 560;
const _RY_NETCFG_BETA_OX = 672;
const _RY_NETCFG_AMINO = 720;
const _RY_NETCFG_SIZE = 832;
const _RY_NETFLUX_TCA = 120;
const _RY_NETFLUX_ETC = 232;
const _RY_NETFLUX_BETA_OX = 312;
const _RY_NETFLUX_AMINO = 376;
const _RY_NETFLUX_TOTALS = 472;
const _RY_NETFLUX_SIZE = 496;
const _RY_NETTICK_SIZE = 536;

# ── defaults ──

# Zeroes the `words` 8-byte words at `w`: the stdlib's memset stores a byte at a time (a 536-byte tick 2 µs, this
# 67-word loop about 70 ns), and every zeroed network value is a whole number of words.
fn _ry_pathway_zero(w, words) {
    var k = 0;
    while (k < words) {
        store64(w + 8 * k, 0);
        k = k + 1;
    }
    return 0;
}

# Fills *out with Rust's MetabolicNetwork::default(): every pathway at its default, ATP 6, ADP 0.5, NAD+/NADH 700,
# full oxygen and malonyl-CoA 0.01 mM (src/pathway_data.cyr).
fn ry_metabolic_network_default(out: *RyMetabolicNetwork) {
    var w = out;
    ry_glycolysis_state_default(w);
    ry_tca_state_default(w + _RY_NET_TCA);
    ry_etc_state_default(w + _RY_NET_ETC);
    ry_beta_ox_state_default(w + _RY_NET_BETA_OX);
    ry_amino_catab_state_default(w + _RY_NET_AMINO);
    out.atp = RY_PATHWAY_METABOLIC_NETWORK_DEFAULT_ATP;
    out.adp = RY_PATHWAY_METABOLIC_NETWORK_DEFAULT_ADP;
    out.nad_ratio = RY_PATHWAY_METABOLIC_NETWORK_DEFAULT_NAD_RATIO;
    out.oxygen = RY_PATHWAY_METABOLIC_NETWORK_DEFAULT_OXYGEN;
    out.malonyl_coa = RY_PATHWAY_METABOLIC_NETWORK_DEFAULT_MALONYL_COA;
    return 0;
}

# Fills *out with Rust's NetworkConfig::default(): every pathway's default config, `nad_ratio_sensitivity` 50.
fn ry_network_config_default(out: *RyNetworkConfig) {
    var w = out;
    ry_glycolysis_config_default(w);
    ry_tca_config_default(w + _RY_NETCFG_TCA);
    ry_etc_config_default(w + _RY_NETCFG_ETC);
    ry_beta_ox_config_default(w + _RY_NETCFG_BETA_OX);
    ry_amino_catab_config_default(w + _RY_NETCFG_AMINO);
    out.nad_ratio_sensitivity = RY_PATHWAY_NETWORK_CONFIG_DEFAULT_NAD_RATIO_SENSITIVITY;
    return 0;
}

# Fills *out with Rust's NetworkEnvironment::default(), a resting, fed cell: RESTING_ATP_DEMAND, plasma glucose 5,
# free fatty acids 0.3 and amino acids 2 mM.
fn ry_network_environment_default(out: *RyNetworkEnvironment) {
    out.atp_demand = RY_PATHWAY_NETWORK_ENVIRONMENT_DEFAULT_ATP_DEMAND;
    out.plasma_glucose = RY_PATHWAY_NETWORK_ENVIRONMENT_DEFAULT_PLASMA_GLUCOSE;
    out.plasma_fatty_acids = RY_PATHWAY_NETWORK_ENVIRONMENT_DEFAULT_PLASMA_FATTY_ACIDS;
    out.plasma_amino_acids = RY_PATHWAY_NETWORK_ENVIRONMENT_DEFAULT_PLASMA_AMINO_ACIDS;
    return 0;
}

# Fills *out with Rust's NetworkFlux::default(): every field 0.
fn ry_network_flux_default(out: *RyNetworkFlux) {
    _ry_pathway_zero(out, 62);
    return 0;
}

# Fills *out with Rust's NetworkExchange::default(): every field 0.
fn ry_network_exchange_default(out: *RyNetworkExchange) {
    _ry_pathway_zero(out, 5);
    return 0;
}

# Fills *out with Rust's NetworkTick::default(): every field 0.
fn ry_network_tick_default(out: *RyNetworkTick) {
    _ry_pathway_zero(out, 67);
    return 0;
}

# ── validation ──

# Ok(0) when every pathway state validates (glycolysis, TCA, the ETC, β-oxidation, amino-acid catabolism, in that
# order), ATP and ADP are finite and >= 0, the NAD+/NADH ratio finite and > 0, oxygen in [0, 1] and malonyl-CoA finite
# and >= 0; else the first failure's Err. Mirrors `MetabolicNetwork::validate`.
#must_use
fn ry_metabolic_network_validate(p: *RyMetabolicNetwork): Result {
    var w = p;
    var t1, v1 = ry_glycolysis_state_validate(w);
    if (is_err_result(t1) == 1) { return Err(v1); }
    var t2, v2 = ry_tca_state_validate(w + _RY_NET_TCA);
    if (is_err_result(t2) == 1) { return Err(v2); }
    var t3, v3 = ry_etc_state_validate(w + _RY_NET_ETC);
    if (is_err_result(t3) == 1) { return Err(v3); }
    var t4, v4 = ry_beta_ox_state_validate(w + _RY_NET_BETA_OX);
    if (is_err_result(t4) == 1) { return Err(v4); }
    var t5, v5 = ry_amino_catab_state_validate(w + _RY_NET_AMINO);
    if (is_err_result(t5) == 1) { return Err(v5); }
    var atp: f64 = p.atp;
    var adp: f64 = p.adp;
    var ratio: f64 = p.nad_ratio;
    var oxygen: f64 = p.oxygen;
    var malonyl: f64 = p.malonyl_coa;
    var t6, v6 = _ry_guard_non_negative("atp", atp);
    if (is_err_result(t6) == 1) { return Err(v6); }
    var t7, v7 = _ry_guard_non_negative("adp", adp);
    if (is_err_result(t7) == 1) { return Err(v7); }
    var t8, v8 = _ry_guard_positive("nad_ratio", ratio);
    if (is_err_result(t8) == 1) { return Err(v8); }
    var t9, v9 = _ry_guard_fraction("oxygen", oxygen);
    if (is_err_result(t9) == 1) { return Err(v9); }
    var ta, va = _ry_guard_non_negative("malonyl_coa", malonyl);
    if (is_err_result(ta) == 1) { return Err(va); }
    return Ok(0);
}

# Ok(0) when every pathway config validates (in declaration order) and `nad_ratio_sensitivity` is finite and >= 0;
# else the first failure's Err. Mirrors `NetworkConfig::validate`.
#must_use
fn ry_network_config_validate(p: *RyNetworkConfig): Result {
    var w = p;
    var t1, v1 = ry_glycolysis_config_validate(w);
    if (is_err_result(t1) == 1) { return Err(v1); }
    var t2, v2 = ry_tca_config_validate(w + _RY_NETCFG_TCA);
    if (is_err_result(t2) == 1) { return Err(v2); }
    var t3, v3 = ry_etc_config_validate(w + _RY_NETCFG_ETC);
    if (is_err_result(t3) == 1) { return Err(v3); }
    var t4, v4 = ry_beta_ox_config_validate(w + _RY_NETCFG_BETA_OX);
    if (is_err_result(t4) == 1) { return Err(v4); }
    var t5, v5 = ry_amino_catab_config_validate(w + _RY_NETCFG_AMINO);
    if (is_err_result(t5) == 1) { return Err(v5); }
    var s: f64 = p.nad_ratio_sensitivity;
    var t6, v6 = _ry_guard_non_negative("nad_ratio_sensitivity", s);
    if (is_err_result(t6) == 1) { return Err(v6); }
    return Ok(0);
}

# Ok(0) when every field is finite and >= 0; else the first failing one's Err, in declaration order. Mirrors
# `NetworkEnvironment::validate`.
#must_use
fn ry_network_environment_validate(p: *RyNetworkEnvironment): Result {
    var w = p;
    var name = &_RY_NETWORK_ENVIRONMENT_FIELDS;
    var k = 0;
    while (k < 4) {
        var value: f64 = load64(w + 8 * k);
        var t, v = _ry_guard_non_negative(name, value);
        if (is_err_result(t) == 1) { return Err(v); }
        name = name + strlen(name) + 1;
        k = k + 1;
    }
    return Ok(0);
}

# Respiratory quotient, CO2 produced / O2 consumed (≈ 1.0 for glucose, 0.7 for fat, 0.8 for protein), of flux *fl.
# 0.0 when no O2 was consumed (o2_consumed <= f64::EPSILON): the RQ is undefined then, and 0.0 is a sentinel. The
# network itself is not read. Mirrors `MetabolicNetwork::respiratory_quotient`.
#must_use
fn ry_metabolic_network_respiratory_quotient(p: *RyMetabolicNetwork, fl: *RyNetworkFlux): f64 {
    var eps: f64 = 0x3CB0000000000000;           # f64::EPSILON
    var o2: f64 = fl.o2_consumed;
    if (o2 > eps) {
        var co2: f64 = fl.co2_produced;
        var rq: f64 = co2 / o2;
        return rq;
    }
    return 0.0;
}

# ── the NAD+/NADH solve layer ──

# The NAD factor the mitochondrial producers apply: min(r / RESTING_NAD_RATIO, MAX_NAD_FACTOR). Mirrors the private
# `nad_factor`.
#must_use
#pure
fn _ry_pathway_nad_factor(ratio: f64): f64 {
    var scaled: f64 = ratio / RY_RESTING_NAD_RATIO;
    var f: f64 = _ry_min(scaled, RY_MAX_NAD_FACTOR);
    return f;
}

# The NAD+/NADH ratio of an NADH concentration `n`, within the ratio bounds: clamp((T − n) / n, MIN, MAX), NaN
# propagating as Rust's clamp does. Mirrors the private `ratio_of`.
#must_use
#pure
fn _ry_pathway_ratio_of(n: f64): f64 {
    var r: f64 = (RY_PATHWAY_NAD_POOL_TOTAL - n) / n;
    var c: f64 = _ry_clamp(r, RY_PATHWAY_NAD_RATIO_MIN, RY_PATHWAY_NAD_RATIO_MAX);
    return c;
}

# NADH oxidized over one step at end-of-step NADH `n`: Complex I (capacity `c_ci`, Km COMPLEX_I_KM_NADH) plus LDH
# (capacity `c_ldh`, Km LDH_KM_NADH), both capacities already multiplied by the step length. Mirrors the private
# `nadh_oxidized`.
#must_use
#pure
fn _ry_pathway_nadh_oxidized(n: f64, c_ci: f64, c_ldh: f64): f64 {
    var ci: f64 = (c_ci * n) / (RY_ETC_COMPLEX_I_KM_NADH + n);
    var ldh: f64 = (c_ldh * n) / (RY_PATHWAY_LDH_KM_NADH + n);
    var s: f64 = ci + ldh;
    return s;
}

# The inputs `balanced_nad_ratio`'s closure captures (the producers' outputs already sanitized).
struct _RyPathwayBalance {
    pool: f64;
    glycolytic: f64;
    mitochondrial: f64;
    c_ci: f64;
    c_ldh: f64;
}

# The inputs `end_of_step_nadh`'s closure captures.
struct _RyPathwayAvail {
    avail: f64;
    c_ci: f64;
    c_ldh: f64;
}

# `balanced_nad_ratio`'s closure at NADH `n`: pool + glycolytic·g(r(n)) + mitochondrial·f(r(n)) − oxidized(n) − n.
#must_use
fn _ry_pathway_balance_excess(c: *_RyPathwayBalance, n: f64): f64 {
    var r: f64 = _ry_pathway_ratio_of(n);
    var g: f64 = _ry_glycolysis_gapdh_nad_factor(r);
    var f: f64 = _ry_pathway_nad_factor(r);
    var ox: f64 = _ry_pathway_nadh_oxidized(n, c.c_ci, c.c_ldh);
    var e: f64 = (((c.pool + (c.glycolytic * g)) + (c.mitochondrial * f)) - ox) - n;
    return e;
}

# `end_of_step_nadh`'s closure at NADH `n`: avail − oxidized(n) − n.
#must_use
fn _ry_pathway_avail_excess(c: *_RyPathwayAvail, n: f64): f64 {
    var ox: f64 = _ry_pathway_nadh_oxidized(n, c.c_ci, c.c_ldh);
    var e: f64 = (c.avail - ox) - n;
    return e;
}

# The root of a decreasing `excess` on [lo, hi], by Illinois-modified regula falsi, statement for statement as
# Rust's private `solve_decreasing` (P9): lo when excess(lo) <= 0, hi when excess(hi) >= 0, else at most
# SOLVE_MAX_ITERATIONS secant steps, each one's repeat on the same side halving the other end's value, stopping on an
# exact root, a secant point outside the bracket, or a bracket within SOLVE_RELATIVE_TOLERANCE of hi (the midpoint
# then). `excess` is called as callptr(excess, ctx, x). When `st` is not 0, st[0] gets the iterations entered and
# st[1] how the solve ended: 0 lo, 1 hi, 2 an exact root, 3 the bracket or tolerance test, 4 the iteration cap.
fn _ry_pathway_solve_decreasing(lo0: f64, hi0: f64, excess, ctx, st: *i64): f64 {
    var lo: f64 = lo0;
    var hi: f64 = hi0;
    var it = 0;
    var exit = 4;
    var f_lo: f64 = callptr(excess, ctx, lo);
    if (f_lo <= 0.0) {
        if (st != 0) {
            st[0] = 0;
            st[1] = 0;
        }
        return lo;
    }
    var f_hi: f64 = callptr(excess, ctx, hi);
    if (f_hi >= 0.0) {
        if (st != 0) {
            st[0] = 0;
            st[1] = 1;
        }
        return hi;
    }
    # Which end moved last (−1 low, +1 high): a repeat halves the other end's value.
    var last = 0;
    var result: f64 = 0.0;
    var done = 0;
    while (it < _RY_PATHWAY_SOLVE_MAX_ITERATIONS && done == 0) {
        it = it + 1;
        var x: f64 = ((lo * f_hi) - (hi * f_lo)) / (f_hi - f_lo);
        var inside = 0;
        if (x > lo) {
            if (x < hi) { inside = 1; }
        }
        var width: f64 = hi - lo;
        var tol: f64 = _RY_PATHWAY_SOLVE_RELATIVE_TOLERANCE * hi;
        if (inside == 0 || width <= tol) {
            exit = 3;
            done = 1;
        } else {
            var f_x: f64 = callptr(excess, ctx, x);
            if (f_x > 0.0) {
                lo = x;
                f_lo = f_x;
                if (last == 0 - 1) { f_hi = f_hi * 0.5; }
                last = 0 - 1;
            } elif (f_x < 0.0) {
                hi = x;
                f_hi = f_x;
                if (last == 1) { f_lo = f_lo * 0.5; }
                last = 1;
            } else {
                result = x;
                exit = 2;
                done = 2;
            }
        }
    }
    if (st != 0) {
        st[0] = it;
        st[1] = exit;
    }
    if (done == 2) { return result; }
    var mid: f64 = 0.5 * (lo + hi);
    return mid;
}

# The self-consistent NAD+/NADH ratio for one step: the end-of-step NADH N solving (backward Euler)
# pool + glycolytic·gapdh_nad_factor(r(N)) + mitochondrial·nad_factor(r(N)) − oxidized(N) = N over
# [T / (1 + MAX), T / (1 + MIN)], with `glycolytic` and `mitochondrial` the producers' NADH output this step at the
# resting ratio (each sanitized by `conc`), returned as r(N). The solved NADH goes to *nout and the solve's count to
# `st` (either may be 0). Mirrors the private `balanced_nad_ratio`.
fn _ry_pathway_balanced_nad_ratio(pool: f64, glycolytic: f64, mitochondrial: f64, c_ci: f64, c_ldh: f64, st: *i64,
  nout: *f64): f64 {
    var ctx: _RyPathwayBalance;
    var g: f64 = _ry_guard_conc(glycolytic);
    var m: f64 = _ry_guard_conc(mitochondrial);
    ctx.pool = pool;
    ctx.glycolytic = g;
    ctx.mitochondrial = m;
    ctx.c_ci = c_ci;
    ctx.c_ldh = c_ldh;
    var lo: f64 = RY_PATHWAY_NAD_POOL_TOTAL / (1.0 + RY_PATHWAY_NAD_RATIO_MAX);
    var hi: f64 = RY_PATHWAY_NAD_POOL_TOTAL / (1.0 + RY_PATHWAY_NAD_RATIO_MIN);
    var n: f64 = _ry_pathway_solve_decreasing(lo, hi, &_ry_pathway_balance_excess, &ctx, st);
    if (nout != 0) { nout[0] = n; }
    var r: f64 = _ry_pathway_ratio_of(n);
    return r;
}

# The end-of-step NADH when `avail` (the pool plus this step's production) is oxidized by Complex I and LDH, solved
# implicitly: N + oxidized(N) = avail on [0, avail]; 0 for avail <= 0 (st[1] = 5 then: no solve). Mirrors the private
# `end_of_step_nadh`.
fn _ry_pathway_end_of_step_nadh(avail: f64, c_ci: f64, c_ldh: f64, st: *i64): f64 {
    if (avail <= 0.0) {
        if (st != 0) {
            st[0] = 0;
            st[1] = 5;
        }
        return 0.0;
    }
    var ctx: _RyPathwayAvail;
    ctx.avail = avail;
    ctx.c_ci = c_ci;
    ctx.c_ldh = c_ldh;
    var n: f64 = _ry_pathway_solve_decreasing(0.0, avail, &_ry_pathway_avail_excess, &ctx, st);
    return n;
}

# LDH's capacity over a step of length `h` at pyruvate `pyruvate` (mM): LDH_VMAX·p / (LDH_KM_PYRUVATE + p)·h, p the
# pyruvate sanitized by `conc`. Mirrors the private `ldh_capacity`.
#must_use
#pure
fn _ry_pathway_ldh_capacity(pyruvate: f64, h: f64): f64 {
    var p: f64 = _ry_guard_conc(pyruvate);
    var c: f64 = ((RY_PATHWAY_LDH_VMAX * p) / (RY_PATHWAY_LDH_KM_PYRUVATE + p)) * h;
    return c;
}

# ── the sub-step sums ──

# Adds a sub-step's flux `o` into the tick total `t`: each pathway flux by its own accumulate (amounts summed, rates
# weighted by `weight`), then the net ATP, O2 and CO2 summed. Mirrors the crate-private `NetworkFlux::accumulate`.
fn _ry_network_flux_accumulate(t: *RyNetworkFlux, o: *RyNetworkFlux, weight: f64) {
    var wt = t;
    var wo = o;
    _ry_glycolysis_flux_accumulate(wt, wo, weight);
    _ry_tca_flux_accumulate(wt + _RY_NETFLUX_TCA, wo + _RY_NETFLUX_TCA, weight);
    _ry_etc_flux_accumulate(wt + _RY_NETFLUX_ETC, wo + _RY_NETFLUX_ETC, weight);
    _ry_beta_ox_flux_accumulate(wt + _RY_NETFLUX_BETA_OX, wo + _RY_NETFLUX_BETA_OX, weight);
    _ry_amino_catab_flux_accumulate(wt + _RY_NETFLUX_AMINO, wo + _RY_NETFLUX_AMINO, weight);
    var net: f64 = t.net_atp + o.net_atp;
    var o2: f64 = t.o2_consumed + o.o2_consumed;
    var co2: f64 = t.co2_produced + o.co2_produced;
    t.net_atp = net;
    t.o2_consumed = o2;
    t.co2_produced = co2;
    return 0;
}

# Adds a sub-step's exchange `o` into the tick total `t`, field by field. Mirrors the crate-private
# `NetworkExchange::accumulate`.
fn _ry_network_exchange_accumulate(t: *RyNetworkExchange, o: *RyNetworkExchange) {
    var wt = t;
    var wo = o;
    var k = 0;
    while (k < 5) {
        var x: f64 = load64(wt + 8 * k);
        var y: f64 = load64(wo + 8 * k);
        var s: f64 = x + y;
        store64(wt + 8 * k, load64(&s));
        k = k + 1;
    }
    return 0;
}

# ── the step ──

# The fluxes of the producing half of a network step, and the malate carbon cataplerosis returned to pyruvate (mM;
# also CO2). Mirrors the private `Production`.
struct _RyPathwayProduction {
    glycolysis: RyGlycolysisFlux;
    beta_ox: RyBetaOxFlux;
    amino_catab: RyAminoCatabFlux;
    tca: RyTcaFlux;
    cataplerosis: f64;
}

# The production's nested fluxes' offsets.
const _RY_PROD_BETA_OX = 120;
const _RY_PROD_AMINO = 184;
const _RY_PROD_TCA = 280;

# The producing half of a network step of length `h` at NAD+/NADH ratio `ratio`, into *out: glycolysis with PFK-1
# inhibited by citrate (the Randle cycle), β-oxidation with CPT-I seeing the caller's malonyl-CoA plus the ACC-derived
# part, amino-acid catabolism on TCA's α-KG (transamination takes it, GDH returns it), the carbon skeletons into the
# cycle, the cycle on the shared pyruvate, then cataplerosis of malate carbon above TCA_POOL_REFERENCE. Mirrors the
# private `MetabolicNetwork::produce`.
fn _ry_metabolic_network_produce(p: *RyMetabolicNetwork, c: *RyNetworkConfig, atp: f64, adp: f64, ratio: f64, h: f64,
  out: *_RyPathwayProduction) {
    var w = p;
    var wc = c;
    var wo = out;
    var citrate: f64 = _ry_guard_conc(p.tca.citrate);
    var pfk_citrate: f64 = 1.0 / (1.0 + citrate / RY_PATHWAY_PFK_KI_CITRATE);
    _ry_glycolysis_state_tick_regulated(w, wc, atp, adp, ratio, pfk_citrate, h, wo);
    var hormonal: f64 = _ry_guard_conc(p.malonyl_coa);
    var accoa: f64 = _ry_guard_conc(p.tca.acetyl_coa);
    var malonyl: f64 = hormonal + RY_PATHWAY_MALONYL_PER_ACETYL_COA * accoa;
    ry_beta_ox_state_tick(w + _RY_NET_BETA_OX, wc + _RY_NETCFG_BETA_OX, malonyl, ratio, h, wo + _RY_PROD_BETA_OX);
    var akg_in: f64 = p.tca.alpha_kg;
    ry_amino_catab_state_tick(w + _RY_NET_AMINO, wc + _RY_NETCFG_AMINO, akg_in, ratio, h, wo + _RY_PROD_AMINO);
    # Transamination took α-KG (capped at the pool); GDH regenerates it.
    var took: f64 = (p.tca.alpha_kg - out.amino_catab.amino_acids_consumed) + out.amino_catab.nh4_produced;
    var akg: f64 = _ry_guard_conc(took);
    p.tca.alpha_kg = akg;
    # Carbon skeletons into the TCA cycle, then the cycle itself.
    var into_accoa: f64 = out.beta_ox.acetyl_coa_produced + out.amino_catab.to_acetyl_coa;
    var accoa2: f64 = p.tca.acetyl_coa + into_accoa;
    var akg2: f64 = p.tca.alpha_kg + out.amino_catab.to_alpha_kg;
    var succ: f64 = p.tca.succinyl_coa + out.amino_catab.to_succinyl_coa;
    var fum: f64 = p.tca.fumarate + out.amino_catab.to_fumarate;
    var oaa: f64 = p.tca.oxaloacetate + out.amino_catab.to_oxaloacetate;
    var pyr: f64 = p.glycolysis.pyruvate + out.amino_catab.to_pyruvate;
    p.tca.acetyl_coa = accoa2;
    p.tca.alpha_kg = akg2;
    p.tca.succinyl_coa = succ;
    p.tca.fumarate = fum;
    p.tca.oxaloacetate = oaa;
    p.glycolysis.pyruvate = pyr;
    ry_tca_state_tick(w + _RY_NET_TCA, wc + _RY_NETCFG_TCA, pyr, atp, adp, ratio, h, wo + _RY_PROD_TCA);
    # PDH is capped at the pyruvate it was given; `conc` only recovers NaN.
    var left: f64 = p.glycolysis.pyruvate - out.tca.pyruvate_consumed;
    var pyr2: f64 = _ry_guard_conc(left);
    p.glycolysis.pyruvate = pyr2;
    # Cataplerosis: malate carbon above the reference pool → pyruvate + CO2.
    var pool: f64 = ry_tca_state_total_pool(w + _RY_NET_TCA);
    var excess: f64 = pool - RY_PATHWAY_TCA_POOL_REFERENCE;
    var amount: f64 = (RY_PATHWAY_CATAPLEROSIS_RATE * excess) * h;
    var drained: f64 = _ry_guard_take(amount, p.tca.malate);
    var malate: f64 = p.tca.malate - drained;
    var pyr3: f64 = p.glycolysis.pyruvate + drained;
    p.tca.malate = malate;
    p.glycolysis.pyruvate = pyr3;
    out.cataplerosis = drained;
    return 0;
}

# One network step of length `h` (already validated) in `env`, into *out: (1) cell glucose, free fatty acid and amino
# acids relax toward the plasma levels; (2) the producers run at the self-consistent NAD+/NADH ratio, solved against
# Complex I and LDH from a probe of the producers on a frame copy of the network at the resting ratio; (3) the NADH pool
# plus the step's production is oxidized implicitly by Complex I and LDH, the lactate formed exported and the ratio
# recomputed from the NADH left; (4) the ATP/ADP pool takes production − consumption − the saturable demand, limited to
# [−atp, adp] so ATP + ADP is conserved exactly. When `st` is not 0, st[0..1] get the ratio solve's iterations and
# exit and st[2..3] the end-of-step solve's. Mirrors the private `MetabolicNetwork::step`.
fn _ry_metabolic_network_step(p: *RyMetabolicNetwork, c: *RyNetworkConfig, env: *RyNetworkEnvironment, h: f64,
  out: *RyNetworkTick, st: *i64) {
    var w = p;
    var wc = c;
    var wo = out;
    # Shared pools, sanitized once; sub-ticks sanitize their own inputs.
    var atp: f64 = _ry_guard_conc(p.atp);
    var adp: f64 = _ry_guard_conc(p.adp);
    var r0: f64 = _ry_guard_conc(p.nad_ratio);
    var nad_ratio: f64 = _ry_clamp(r0, RY_PATHWAY_NAD_RATIO_MIN, RY_PATHWAY_NAD_RATIO_MAX);
    # 1. Substrate supply from plasma.
    var glucose: f64 = _ry_guard_conc(p.glycolysis.glucose);
    var pg: f64 = _ry_guard_conc(env.plasma_glucose);
    var g2: f64 = _ry_integrate_relax(glucose, pg, RY_PATHWAY_GLUCOSE_TRANSPORT_RATE, h);
    p.glycolysis.glucose = g2;
    out.exchange.glucose_uptake = g2 - glucose;
    var ffa: f64 = _ry_guard_conc(p.beta_ox.free_fatty_acid);
    var pf: f64 = _ry_guard_conc(env.plasma_fatty_acids);
    var f2: f64 = _ry_integrate_relax(ffa, pf, RY_PATHWAY_FATTY_ACID_TRANSPORT_RATE, h);
    p.beta_ox.free_fatty_acid = f2;
    out.exchange.fatty_acid_uptake = f2 - ffa;
    var amino: f64 = _ry_guard_conc(p.amino_catab.amino_acid_pool);
    var pa: f64 = _ry_guard_conc(env.plasma_amino_acids);
    var a2: f64 = _ry_integrate_relax(amino, pa, RY_PATHWAY_AMINO_ACID_TRANSPORT_RATE, h);
    p.amino_catab.amino_acid_pool = a2;
    out.exchange.amino_acid_uptake = a2 - amino;
    # 2. Producers at the self-consistent ratio: probe a frame copy at the reference ratio (factor 1) for this step's
    # NAD-dependent NADH output, solve for the ratio that balances it, then run the producers for real.
    var nadh_pool: f64 = RY_PATHWAY_NAD_POOL_TOTAL / (1.0 + nad_ratio);
    var cap: f64 = _ry_etc_state_complex_i_capacity(w + _RY_NET_ETC, wc + _RY_NETCFG_ETC);
    var c_ci: f64 = cap * h;
    var probe: RyMetabolicNetwork = *p;
    var pr: _RyPathwayProduction;
    _ry_metabolic_network_produce(&probe, c, atp, adp, RY_RESTING_NAD_RATIO, h, &pr);
    var glycolytic_ref: f64 = pr.glycolysis.nadh_produced;
    var mitochondrial_ref: f64 = (pr.tca.nadh_produced + pr.beta_ox.nadh_produced) + pr.amino_catab.nadh_produced;
    var c_ldh_probe: f64 = _ry_pathway_ldh_capacity(p.glycolysis.pyruvate, h);
    var st_end = 0;
    if (st != 0) { st_end = st + 2; }               # st is an *i64: + 2 is two words on
    var ratio: f64 = _ry_pathway_balanced_nad_ratio(nadh_pool, glycolytic_ref, mitochondrial_ref, c_ci, c_ldh_probe, st,
      0);
    var prod: _RyPathwayProduction;
    _ry_metabolic_network_produce(p, c, atp, adp, ratio, h, &prod);
    # 3. The NADH pool, oxidized implicitly by Complex I and LDH.
    var made: f64 = ((prod.glycolysis.nadh_produced + prod.tca.nadh_produced) + prod.beta_ox.nadh_produced)
    + prod.amino_catab.nadh_produced;
    var avail_raw: f64 = nadh_pool + made;
    var nadh_avail: f64 = _ry_clamp(avail_raw, 0.0, RY_PATHWAY_NAD_POOL_TOTAL);
    var c_ldh: f64 = _ry_pathway_ldh_capacity(p.glycolysis.pyruvate, h);
    var nadh_end: f64 = _ry_pathway_end_of_step_nadh(nadh_avail, c_ci, c_ldh, st_end);
    var ldh_rate: f64 = (c_ldh * nadh_end) / (RY_PATHWAY_LDH_KM_NADH + nadh_end);
    var pyr_cap: f64 = _ry_min(p.glycolysis.pyruvate, nadh_avail);
    var lactate: f64 = _ry_guard_take(ldh_rate, pyr_cap);
    var pyr: f64 = p.glycolysis.pyruvate - lactate;
    p.glycolysis.pyruvate = pyr;
    out.exchange.lactate_export = lactate;
    var drive: _RyEtcDrive;
    drive.nadh_conc = nadh_end;
    drive.nadh_avail = nadh_avail - lactate;
    var fadh2: f64 = prod.tca.fadh2_produced + prod.beta_ox.fadh2_produced;
    drive.fadh2 = fadh2;
    drive.oxygen = p.oxygen;
    drive.adp = adp;
    _ry_etc_state_step(w + _RY_NET_ETC, wc + _RY_NETCFG_ETC, &drive, h, wo + _RY_NETFLUX_ETC);
    var nadh_left: f64 = (nadh_avail - lactate) - out.flux.etc.nadh_consumed;
    if (nadh_left > 0.0) {
        var r: f64 = _ry_pathway_ratio_of(nadh_left);
        p.nad_ratio = r;
    } else {
        p.nad_ratio = RY_PATHWAY_NAD_RATIO_MAX;
    }
    # 4. The shared ATP/ADP pool, conserving ATP + ADP exactly.
    var atp_produced: f64 = (prod.glycolysis.atp_produced + prod.tca.gtp_produced) + out.flux.etc.atp_produced;
    var demand_in: f64 = _ry_guard_conc(env.atp_demand);
    var demand: f64 = ((demand_in * atp) / (RY_PATHWAY_ATP_DEMAND_KM + atp)) * h;
    var atp_consumed: f64 = (prod.glycolysis.atp_consumed + prod.beta_ox.atp_consumed) + demand;
    var raw_net: f64 = atp_produced - atp_consumed;
    var low: f64 = -atp;
    var net: f64 = 0.0;
    if (_ry_is_finite(raw_net) == 1) { net = _ry_clamp(raw_net, low, adp); }
    var adenylate_total: f64 = atp + adp;
    var atp2: f64 = atp + net;
    p.atp = atp2;
    var adp_left: f64 = adenylate_total - atp2;
    var adp2: f64 = _ry_max(adp_left, 0.0);
    p.adp = adp2;
    # Demand is met in full unless the pool limit cut the net change.
    if (raw_net < low) {
        var shortfall: f64 = low - raw_net;
        var met: f64 = _ry_max(demand - shortfall, 0.0);
        out.exchange.atp_demand_met = met;
    } else {
        out.exchange.atp_demand_met = demand;
    }
    var o2: f64 = out.flux.etc.o2_consumed;
    var co2: f64 = prod.tca.co2_produced + prod.cataplerosis;
    out.flux.net_atp = net;
    out.flux.o2_consumed = o2;
    out.flux.co2_produced = co2;
    # Struct assignments, the compiler's word copies: the stdlib's memcpy moves a byte at a time (390 bytes ≈ 1.5 µs).
    out.flux.glycolysis = prod.glycolysis;
    out.flux.tca = prod.tca;
    out.flux.beta_ox = prod.beta_ox;
    out.flux.amino_catab = prod.amino_catab;
    return 0;
}

# The sub-steps a tick of `dt` takes: ceil(dt / NETWORK_MAX_SUBSTEP), at least 1, or NETWORK_MAX_SUBSTEPS when that
# is not below the cap; Rust's division and saturating `as u32`, not `dt * 50` (probe 1).
#must_use
fn _ry_pathway_substeps(dt: f64): i64 {
    var q: f64 = dt / RY_PATHWAY_NETWORK_MAX_SUBSTEP;
    var wanted: f64 = f64_ceil(q);
    var cap: f64 = f64_from(RY_PATHWAY_NETWORK_MAX_SUBSTEPS);
    if (wanted < cap) {
        var n = _ry_f64_to_u32(wanted);
        if (n < 1) { n = 1; }
        return n;
    }
    return RY_PATHWAY_NETWORK_MAX_SUBSTEPS;
}

# Advances every pathway by `dt` seconds in environment `env`, wiring outputs to inputs through the shared ATP/ADP
# and NAD+/NADH pools, and fills *out with the tick's fluxes and exchange (each step as _ry_metabolic_network_step
# describes). A dt longer than NETWORK_MAX_SUBSTEP is split into equal sub-steps (at most NETWORK_MAX_SUBSTEPS),
# *out the tick total: amounts summed, rates weighted by the sub-step's share. A non-finite or non-positive dt is "no
# time passed" (the network untouched, a zero tick); non-finite or negative environment values count as 0. Mirrors
# `MetabolicNetwork::tick_in`.
fn ry_metabolic_network_tick_in(p: *RyMetabolicNetwork, c: *RyNetworkConfig, env: *RyNetworkEnvironment, dt: f64,
  out: *RyNetworkTick) {
    if (_ry_guard_valid_dt(dt) == 0) {
        _ry_pathway_zero(out, 67);
        return 0;
    }
    if (_ry_trace_on() == 1) {
        var hd[24];
        var b[256];
        var e = _ry_ev(&hd, &b, 256, "rasayan::pathway", "network_tick");
        _ry_ev_f(e, "dt", dt);
        _ry_ev_f(e, "atp", p.atp);
        _ry_ev_f(e, "adp", p.adp);
        _ry_ev_f(e, "nad_ratio", p.nad_ratio);
        _ry_trace(e);
    }
    var steps = _ry_pathway_substeps(dt);
    if (steps == 1) {
        _ry_metabolic_network_step(p, c, env, dt, out, 0);
        return 0;
    }
    var n: f64 = f64_from(steps);
    var h: f64 = dt / n;
    var weight: f64 = h / dt;
    _ry_pathway_zero(out, 67);
    var wo = out;
    var sub: RyNetworkTick;
    var ws = &sub;                               # a plain address: the flux and exchange inside it
    var k = 0;
    while (k < steps) {
        _ry_metabolic_network_step(p, c, env, h, &sub, 0);
        _ry_network_flux_accumulate(wo, ws, weight);
        _ry_network_exchange_accumulate(wo + _RY_NETFLUX_SIZE, ws + _RY_NETFLUX_SIZE);
        k = k + 1;
    }
    return 0;
}

# Advances every pathway by `dt` seconds in a resting environment (ry_network_environment_default: basal ATP demand
# and plasma supply) and fills *out with the tick's fluxes: ry_metabolic_network_tick_in's flux. Mirrors
# `MetabolicNetwork::tick`.
fn ry_metabolic_network_tick(p: *RyMetabolicNetwork, c: *RyNetworkConfig, dt: f64, out: *RyNetworkFlux) {
    var env: RyNetworkEnvironment;
    var t: RyNetworkTick;
    ry_network_environment_default(&env);
    ry_metabolic_network_tick_in(p, c, &env, dt, &t);
    out.glycolysis = t.flux.glycolysis;
    out.tca = t.flux.tca;
    out.etc = t.flux.etc;
    out.beta_ox = t.flux.beta_ox;
    out.amino_catab = t.flux.amino_catab;
    var net: f64 = t.flux.net_atp;
    var o2: f64 = t.flux.o2_consumed;
    var co2: f64 = t.flux.co2_produced;
    out.net_atp = net;
    out.o2_consumed = o2;
    out.co2_produced = co2;
    return 0;
}

# ── JSON (P7: serde_json's documents) ──

# Appends MetabolicNetwork `p` as serde_json writes it, each pathway state a nested object and then the five pools, on
# allocator `a`: Ok(0), or Err(RY_ERR_OUT_OF_MEMORY) when the builder could not grow.
#must_use
fn ry_metabolic_network_to_json_a(a, sb, p: *RyMetabolicNetwork): Result {
    var w = p;
    var name = &_RY_METABOLIC_NETWORK_FIELDS;
    var e = _ry_jw_byte(a, sb, 123);
    e = e | _ry_jw_key(a, sb, name, 1);
    var t1, v1 = ry_glycolysis_state_to_json_a(a, sb, w);
    if (is_err_result(t1) == 1) { e = 1; }
    name = name + strlen(name) + 1;
    e = e | _ry_jw_key(a, sb, name, 0);
    var t2, v2 = ry_tca_state_to_json_a(a, sb, w + _RY_NET_TCA);
    if (is_err_result(t2) == 1) { e = 1; }
    name = name + strlen(name) + 1;
    e = e | _ry_jw_key(a, sb, name, 0);
    var t3, v3 = ry_etc_state_to_json_a(a, sb, w + _RY_NET_ETC);
    if (is_err_result(t3) == 1) { e = 1; }
    name = name + strlen(name) + 1;
    e = e | _ry_jw_key(a, sb, name, 0);
    var t4, v4 = ry_beta_ox_state_to_json_a(a, sb, w + _RY_NET_BETA_OX);
    if (is_err_result(t4) == 1) { e = 1; }
    name = name + strlen(name) + 1;
    e = e | _ry_jw_key(a, sb, name, 0);
    var t5, v5 = ry_amino_catab_state_to_json_a(a, sb, w + _RY_NET_AMINO);
    if (is_err_result(t5) == 1) { e = 1; }
    var k = 0;
    while (k < 5) {
        name = name + strlen(name) + 1;
        e = e | _ry_jw_key(a, sb, name, 0);
        var x: f64 = load64(w + _RY_NET_POOLS + 8 * k);
        e = e | _ry_jw_f64(a, sb, x);
        k = k + 1;
    }
    e = e | _ry_jw_byte(a, sb, 125);
    if (e != 0) { return Err(RY_ERR_OUT_OF_MEMORY); }
    return Ok(0);
}

# ry_metabolic_network_to_json_a on the default allocator (a builder from str_builder_new).
#must_use
fn ry_metabolic_network_to_json(sb, p: *RyMetabolicNetwork): Result {
    return ry_metabolic_network_to_json_a(default_alloc(), sb, p);
}

# The MetabolicNetwork at node `v`, by serde's rules (an object by field name, or an array of its ten fields; each
# pathway state itself an object or an array), into the 264 bytes at `w`: 1, or 0 for a refusal.
#must_use
fn _ry_metabolic_network_from_node(v, w): i64 {
    var form = _ry_jr_form(v, 10);
    if (form == 0) { return 0; }
    var name = &_RY_METABOLIC_NETWORK_FIELDS;
    var ok = _ry_glycolysis_state_from_node(_ry_jr_at(v, form, 0, name), w);
    name = name + strlen(name) + 1;
    if (ok == 1) { ok = _ry_tca_state_from_node(_ry_jr_at(v, form, 1, name), w + _RY_NET_TCA); }
    name = name + strlen(name) + 1;
    if (ok == 1) { ok = _ry_etc_state_from_node(_ry_jr_at(v, form, 2, name), w + _RY_NET_ETC); }
    name = name + strlen(name) + 1;
    if (ok == 1) { ok = _ry_beta_ox_state_from_node(_ry_jr_at(v, form, 3, name), w + _RY_NET_BETA_OX); }
    name = name + strlen(name) + 1;
    if (ok == 1) { ok = _ry_amino_catab_state_from_node(_ry_jr_at(v, form, 4, name), w + _RY_NET_AMINO); }
    var k = 5;
    while (k < 10 && ok == 1) {
        name = name + strlen(name) + 1;
        if (_ry_jr_f64(_ry_jr_at(v, form, k, name), w + _RY_NET_POOLS + 8 * (k - 5)) == 0) { ok = 0; }
        k = k + 1;
    }
    return ok;
}

# Reads a MetabolicNetwork from the `n`-byte document at `buf` by serde's rules (its tree on allocator `a`): Ok(0)
# with *out filled, or Err(RY_ERR_DESERIALIZE) with *out untouched.
#must_use
fn ry_metabolic_network_from_json_a(a, buf, n, out: *RyMetabolicNetwork): Result {
    var w[264];
    var v = _ry_jr_parse(a, buf, n);
    if (_ry_metabolic_network_from_node(v, &w) == 0) {
        return Err(_ry_fail_text(RY_ERR_DESERIALIZE, "MetabolicNetwork", 16));
    }
    memcpy(out, &w, _RY_NET_SIZE);
    return Ok(0);
}

# ry_metabolic_network_from_json_a on the default allocator (the tree is never freed: for a one-off read).
#must_use
fn ry_metabolic_network_from_json(buf, n, out: *RyMetabolicNetwork): Result {
    return ry_metabolic_network_from_json_a(default_alloc(), buf, n, out);
}

# Appends NetworkConfig `p` as serde_json writes it, each pathway config a nested object (β-oxidation's chain length an
# integer, amino-acid catabolism's routing nested again) and then `nad_ratio_sensitivity`, on allocator `a`: Ok(0), or
# Err(RY_ERR_OUT_OF_MEMORY).
#must_use
fn ry_network_config_to_json_a(a, sb, p: *RyNetworkConfig): Result {
    var w = p;
    var name = &_RY_NETWORK_CONFIG_FIELDS;
    var e = _ry_jw_byte(a, sb, 123);
    e = e | _ry_jw_key(a, sb, name, 1);
    var t1, v1 = ry_glycolysis_config_to_json_a(a, sb, w);
    if (is_err_result(t1) == 1) { e = 1; }
    name = name + strlen(name) + 1;
    e = e | _ry_jw_key(a, sb, name, 0);
    var t2, v2 = ry_tca_config_to_json_a(a, sb, w + _RY_NETCFG_TCA);
    if (is_err_result(t2) == 1) { e = 1; }
    name = name + strlen(name) + 1;
    e = e | _ry_jw_key(a, sb, name, 0);
    var t3, v3 = ry_etc_config_to_json_a(a, sb, w + _RY_NETCFG_ETC);
    if (is_err_result(t3) == 1) { e = 1; }
    name = name + strlen(name) + 1;
    e = e | _ry_jw_key(a, sb, name, 0);
    var t4, v4 = ry_beta_ox_config_to_json_a(a, sb, w + _RY_NETCFG_BETA_OX);
    if (is_err_result(t4) == 1) { e = 1; }
    name = name + strlen(name) + 1;
    e = e | _ry_jw_key(a, sb, name, 0);
    var t5, v5 = ry_amino_catab_config_to_json_a(a, sb, w + _RY_NETCFG_AMINO);
    if (is_err_result(t5) == 1) { e = 1; }
    name = name + strlen(name) + 1;
    e = e | _ry_jw_key(a, sb, name, 0);
    var s: f64 = p.nad_ratio_sensitivity;
    e = e | _ry_jw_f64(a, sb, s);
    e = e | _ry_jw_byte(a, sb, 125);
    if (e != 0) { return Err(RY_ERR_OUT_OF_MEMORY); }
    return Ok(0);
}

# ry_network_config_to_json_a on the default allocator.
#must_use
fn ry_network_config_to_json(sb, p: *RyNetworkConfig): Result {
    return ry_network_config_to_json_a(default_alloc(), sb, p);
}

# The NetworkConfig at node `v`, by serde's rules (an object by field name, or an array of its six fields; each
# pathway config itself an object or an array), into the 832 bytes at `w`: 1, or 0 for a refusal.
#must_use
fn _ry_network_config_from_node(v, w): i64 {
    var form = _ry_jr_form(v, 6);
    if (form == 0) { return 0; }
    var name = &_RY_NETWORK_CONFIG_FIELDS;
    var ok = _ry_glycolysis_config_from_node(_ry_jr_at(v, form, 0, name), w);
    name = name + strlen(name) + 1;
    if (ok == 1) { ok = _ry_tca_config_from_node(_ry_jr_at(v, form, 1, name), w + _RY_NETCFG_TCA); }
    name = name + strlen(name) + 1;
    if (ok == 1) { ok = _ry_etc_config_from_node(_ry_jr_at(v, form, 2, name), w + _RY_NETCFG_ETC); }
    name = name + strlen(name) + 1;
    if (ok == 1) { ok = _ry_beta_ox_config_from_node(_ry_jr_at(v, form, 3, name), w + _RY_NETCFG_BETA_OX); }
    name = name + strlen(name) + 1;
    if (ok == 1) { ok = _ry_amino_catab_config_from_node(_ry_jr_at(v, form, 4, name), w + _RY_NETCFG_AMINO); }
    name = name + strlen(name) + 1;
    if (ok == 1) { ok = _ry_jr_f64(_ry_jr_at(v, form, 5, name), w + _RY_NETCFG_SIZE - 8); }
    return ok;
}

# Reads a NetworkConfig from the `n`-byte document at `buf` by serde's rules (its tree on allocator `a`): Ok(0) with
# *out filled, or Err(RY_ERR_DESERIALIZE) with *out untouched. Serde reads any value: validate refuses the bad ones.
#must_use
fn ry_network_config_from_json_a(a, buf, n, out: *RyNetworkConfig): Result {
