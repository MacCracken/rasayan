# ACTH Km for CRH.
# Rust: rasayan::hormonal::HormonalConfig::default().acth_km_crh
const RY_HORMONAL_HORMONAL_CONFIG_DEFAULT_ACTH_KM_CRH = 0.5;

# ACTH degradation rate (s^-1).
# Rust: rasayan::hormonal::HormonalConfig::default().acth_degradation_rate
const RY_HORMONAL_HORMONAL_CONFIG_DEFAULT_ACTH_DEGRADATION_RATE = 0.08;

# Cortisol synthesis Vmax (driven by ACTH).
# Rust: rasayan::hormonal::HormonalConfig::default().cortisol_vmax
const RY_HORMONAL_HORMONAL_CONFIG_DEFAULT_CORTISOL_VMAX = 0.08;

# Cortisol Km for ACTH.
# Rust: rasayan::hormonal::HormonalConfig::default().cortisol_km_acth
const RY_HORMONAL_HORMONAL_CONFIG_DEFAULT_CORTISOL_KM_ACTH = 0.5;

# Cortisol degradation rate (s^-1).
# Rust: rasayan::hormonal::HormonalConfig::default().cortisol_degradation_rate
const RY_HORMONAL_HORMONAL_CONFIG_DEFAULT_CORTISOL_DEGRADATION_RATE = 0.02;

# Cortisol level giving half-maximal negative feedback on CRH secretion
# (Ki): CRH secretion is scaled by `1 / (1 + cortisol / Ki)`. This is
# the hypothalamic arm; the pituitary arm uses [`ACTH_FEEDBACK_KI`].
# Rust: rasayan::hormonal::HormonalConfig::default().cortisol_feedback_ki
const RY_HORMONAL_HORMONAL_CONFIG_DEFAULT_CORTISOL_FEEDBACK_KI = 2.0;

# NAT (N-acetyltransferase) Vmax for melatonin synthesis from serotonin.
# Rust: rasayan::hormonal::HormonalConfig::default().nat_vmax
const RY_HORMONAL_HORMONAL_CONFIG_DEFAULT_NAT_VMAX = 0.05;

# NAT Km for serotonin.
# Rust: rasayan::hormonal::HormonalConfig::default().nat_km_serotonin
const RY_HORMONAL_HORMONAL_CONFIG_DEFAULT_NAT_KM_SEROTONIN = 0.5;

# Melatonin degradation rate (s^-1).
