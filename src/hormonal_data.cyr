# External stimuli driving hormonal dynamics.
# Rust: rasayan::hormonal::HormonalInput::default()

# Stress level (0.0 = no stress, 1.0+ = stressed). Drives CRH.
# Rust: rasayan::hormonal::HormonalInput::default().stress
const RY_HORMONAL_HORMONAL_INPUT_DEFAULT_STRESS = 0.0;

# Serotonin level (melatonin precursor).
# Rust: rasayan::hormonal::HormonalInput::default().serotonin
const RY_HORMONAL_HORMONAL_INPUT_DEFAULT_SEROTONIN = 1.0;

# Light exposure (0.0 = dark, 1.0 = bright). Suppresses melatonin.
# Clamped into `[0, 1]` by [`HormonalState::tick`].
# Rust: rasayan::hormonal::HormonalInput::default().light
const RY_HORMONAL_HORMONAL_INPUT_DEFAULT_LIGHT = 0.0;

# Social contact intensity (0.0 = alone, 1.0 = bonding). Drives oxytocin.
# Rust: rasayan::hormonal::HormonalInput::default().social_stimulus
const RY_HORMONAL_HORMONAL_INPUT_DEFAULT_SOCIAL_STIMULUS = 0.0;

# Neural/physical activity level (1.0 = resting). Drives BDNF.
# Rust: rasayan::hormonal::HormonalInput::default().neural_activity
const RY_HORMONAL_HORMONAL_INPUT_DEFAULT_NEURAL_ACTIVITY = 1.0;

