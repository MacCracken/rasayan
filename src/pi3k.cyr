# rasayan — src/pi3k.cyr: the PI3K/Akt/mTOR pathway (rust-old/src/pi3k.rs)
#
# Growth factor → receptor → PI3K → PIP3 → Akt → mTOR, with PTEN dephosphorylating PIP3. Each level is a two-state
# switch: the inactive fraction activated at a Michaelis-Menten rate in the upstream level, the active fraction removed
# first-order (PTEN for PIP3, phosphatases for Akt and mTOR), advanced by the exact solution of its ODE over dt with the
# upstream level held (integrate's `activate`), so levels stay in [0, 1] for any dt. The mTORC1 → S6K → IRS-1 feedback
# is not modelled: mTOR is a pure output.
#
# The Cyrius forms (ADR 0002 row 7): the state advances in place and the flux fills the caller's record. Every
# operation is in Rust's order (P9).

# ── the types ──

# PI3K/Akt/mTOR pathway activation state (fractions 0.0-1.0): PIP3 (normalized), active Akt, active mTOR.
struct RyPi3kState {
    pip3: f64;
    akt_active: f64;
    mtor_active: f64;
}

# Kinetic parameters for PI3K/Akt/mTOR: rates in s^-1 (Vmax per unit of inactive level, PI3K's per unit of PIP2
# headroom 1 − pip3), Km values as levels (> 0).
struct RyPi3kConfig {
    pi3k_vmax: f64;
    pi3k_km: f64;
    pten_rate: f64;
    akt_vmax: f64;
    akt_km: f64;
    akt_phosphatase_rate: f64;
    mtor_vmax: f64;
    mtor_km: f64;
    mtor_phosphatase_rate: f64;
}

# PI3K pathway flux for a tick: each level's activation rate (level/s) at the start of its update; zero for an
# invalid dt.
struct RyPi3kFlux {
    pip3_production: f64;
    akt_phosphorylation: f64;
    mtor_activation: f64;
}

# ── defaults ──

# Fills *out with Rust's Pi3kState::default() (src/pi3k_data.cyr).
fn ry_pi3k_state_default(out: *RyPi3kState) {
    out.pip3 = RY_PI3K_PI3K_STATE_DEFAULT_PIP3;
    out.akt_active = RY_PI3K_PI3K_STATE_DEFAULT_AKT_ACTIVE;
    out.mtor_active = RY_PI3K_PI3K_STATE_DEFAULT_MTOR_ACTIVE;
    return 0;
}

# Fills *out with Rust's Pi3kConfig::default() (src/pi3k_data.cyr).
fn ry_pi3k_config_default(out: *RyPi3kConfig) {
    out.pi3k_vmax = RY_PI3K_PI3K_CONFIG_DEFAULT_PI3K_VMAX;
    out.pi3k_km = RY_PI3K_PI3K_CONFIG_DEFAULT_PI3K_KM;
    out.pten_rate = RY_PI3K_PI3K_CONFIG_DEFAULT_PTEN_RATE;
    out.akt_vmax = RY_PI3K_PI3K_CONFIG_DEFAULT_AKT_VMAX;
    out.akt_km = RY_PI3K_PI3K_CONFIG_DEFAULT_AKT_KM;
    out.akt_phosphatase_rate = RY_PI3K_PI3K_CONFIG_DEFAULT_AKT_PHOSPHATASE_RATE;
    out.mtor_vmax = RY_PI3K_PI3K_CONFIG_DEFAULT_MTOR_VMAX;
    out.mtor_km = RY_PI3K_PI3K_CONFIG_DEFAULT_MTOR_KM;
    out.mtor_phosphatase_rate = RY_PI3K_PI3K_CONFIG_DEFAULT_MTOR_PHOSPHATASE_RATE;
    return 0;
}

# Fills *out with Rust's Pi3kFlux::default(): every rate 0.
fn ry_pi3k_flux_default(out: *RyPi3kFlux) {
    out.pip3_production = 0.0;
    out.akt_phosphorylation = 0.0;
    out.mtor_activation = 0.0;
    return 0;
}

# ── validation ──

# Ok(0) when every level is finite and in [0, 1]; else the first failing one's `_ry_guard_fraction` Err, in
# declaration order. Mirrors `Pi3kState::validate`.
#must_use
fn ry_pi3k_state_validate(p: *RyPi3kState): Result {
    var w = p;                                   # a plain address: `p + n` would step n states
    var name = &_RY_PI3K_STATE_FIELDS;
    var k = 0;
    while (k < 3) {
        var value: f64 = load64(w + 8 * k);
        var t, v = _ry_guard_fraction(name, value);
        if (is_err_result(t) == 1) { return Err(v); }
        name = name + strlen(name) + 1;
        k = k + 1;
    }
    return Ok(0);
}

# Ok(0) when every parameter is finite, the rates >= 0 and the three Km values (every third field from pi3k_km) > 0;
# else the first failure's Err, in declaration order. Mirrors `Pi3kConfig::validate`.
#must_use
fn ry_pi3k_config_validate(p: *RyPi3kConfig): Result {
    var w = p;
    var name = &_RY_PI3K_CONFIG_FIELDS;
    var k = 0;
    while (k < 9) {
        var value: f64 = load64(w + 8 * k);
        var t = 0;
        var v = 0;
        if (k == 1 || k == 4 || k == 7) {
            t, v = _ry_guard_positive(name, value);
        } else {
            t, v = _ry_guard_non_negative(name, value);
        }
        if (is_err_result(t) == 1) { return Err(v); }
        name = name + strlen(name) + 1;
        k = k + 1;
    }
    return Ok(0);
}

# ── the pathway ──

# Advances PI3K/Akt/mTOR by `dt` seconds under upstream receptor activity `receptor_activity` (clamped into [0, 1],
# NaN as 0) and fills *out with the tick's flux: PIP3 by PI3K against PTEN, then Akt from the updated PIP3, then mTOR
# from the updated Akt. A non-finite or non-positive dt leaves the state untouched with a zero flux. Mirrors
# `Pi3kState::tick`.
fn ry_pi3k_state_tick(p: *RyPi3kState, c: *RyPi3kConfig, receptor_activity: f64, dt: f64, out: *RyPi3kFlux) {
    if (_ry_guard_valid_dt(dt) == 0) {
        ry_pi3k_flux_default(out);
        return 0;
    }
    var ra: f64 = _ry_guard_unit(receptor_activity);
    if (_ry_trace_on() == 1) {
        var hd[24];
        var b[256];
        var e = _ry_ev(&hd, &b, 256, "rasayan::pi3k", "pi3k_tick");
        _ry_ev_f(e, "dt", dt);
        _ry_ev_f(e, "receptor_activity", ra);
        _ry_ev_f(e, "akt", p.akt_active);
        _ry_trace(e);
    }
    # PI3K produces PIP3, PTEN degrades it.
    var k_pi3k: f64 = ry_michaelis_menten(ra, c.pi3k_vmax, c.pi3k_km);
    var v_pi3k: f64 = k_pi3k * (1.0 - p.pip3);
    var pip3: f64 = _ry_integrate_activate(p.pip3, k_pi3k, c.pten_rate, dt);
    p.pip3 = pip3;
    # Akt: activated by PIP3.
    var k_akt_on: f64 = ry_michaelis_menten(pip3, c.akt_vmax, c.akt_km);
    var v_akt_on: f64 = k_akt_on * (1.0 - p.akt_active);
    var akt: f64 = _ry_integrate_activate(p.akt_active, k_akt_on, c.akt_phosphatase_rate, dt);
    p.akt_active = akt;
    # mTOR: activated by Akt.
    var k_mtor_on: f64 = ry_michaelis_menten(akt, c.mtor_vmax, c.mtor_km);
    var v_mtor_on: f64 = k_mtor_on * (1.0 - p.mtor_active);
    var mtor: f64 = _ry_integrate_activate(p.mtor_active, k_mtor_on, c.mtor_phosphatase_rate, dt);
    p.mtor_active = mtor;
    out.pip3_production = v_pi3k;
    out.akt_phosphorylation = v_akt_on;
    out.mtor_activation = v_mtor_on;
    return 0;
}

# ── JSON (P7: serde_json's documents) ──

# Appends Pi3kState `p` as serde_json writes it, its three levels in declaration order, on allocator `a`: Ok(0), or
# Err(RY_ERR_OUT_OF_MEMORY) when the builder could not grow.
#must_use
fn ry_pi3k_state_to_json_a(a, sb, p: *RyPi3kState): Result {
    if (_ry_jw_f64_fields(a, sb, p, 3, &_RY_PI3K_STATE_FIELDS) != 0) { return Err(RY_ERR_OUT_OF_MEMORY); }
    return Ok(0);
}

# ry_pi3k_state_to_json_a on the default allocator (a builder from str_builder_new).
#must_use
fn ry_pi3k_state_to_json(sb, p: *RyPi3kState): Result {
    return ry_pi3k_state_to_json_a(default_alloc(), sb, p);
}

# The Pi3kState at node `v` of a parsed document, by serde's rules, into the 24 bytes at `w`: 1, or 0 for a refusal.
# The signaling network's readers call it for its nested value.
#must_use
fn _ry_pi3k_state_from_node(v, w): i64 {
    return _ry_jr_f64_fields(v, w, 3, &_RY_PI3K_STATE_FIELDS);
}

# Reads a Pi3kState from the `n`-byte document at `buf` by serde's rules (its tree on allocator `a`): Ok(0) with *out
# filled, or Err(RY_ERR_DESERIALIZE) with *out untouched.
#must_use
fn ry_pi3k_state_from_json_a(a, buf, n, out: *RyPi3kState): Result {
    var w[24];
    var v = _ry_jr_parse(a, buf, n);
    if (_ry_pi3k_state_from_node(v, &w) == 0) {
        return Err(_ry_fail_text(RY_ERR_DESERIALIZE, "Pi3kState", 9));
    }
    memcpy(out, &w, 24);
    return Ok(0);
}

# ry_pi3k_state_from_json_a on the default allocator (the tree is never freed: for a one-off read).
#must_use
fn ry_pi3k_state_from_json(buf, n, out: *RyPi3kState): Result {
    return ry_pi3k_state_from_json_a(default_alloc(), buf, n, out);
}

# Appends Pi3kConfig `p` as serde_json writes it, its nine fields in declaration order, on allocator `a`: Ok(0), or
# Err(RY_ERR_OUT_OF_MEMORY).
#must_use
fn ry_pi3k_config_to_json_a(a, sb, p: *RyPi3kConfig): Result {
    if (_ry_jw_f64_fields(a, sb, p, 9, &_RY_PI3K_CONFIG_FIELDS) != 0) { return Err(RY_ERR_OUT_OF_MEMORY); }
    return Ok(0);
}

# ry_pi3k_config_to_json_a on the default allocator.
#must_use
fn ry_pi3k_config_to_json(sb, p: *RyPi3kConfig): Result {
    return ry_pi3k_config_to_json_a(default_alloc(), sb, p);
}

# The Pi3kConfig at node `v` of a parsed document, by serde's rules, into the 72 bytes at `w`: 1, or 0 for a refusal.
#must_use
fn _ry_pi3k_config_from_node(v, w): i64 {
    return _ry_jr_f64_fields(v, w, 9, &_RY_PI3K_CONFIG_FIELDS);
}

# Reads a Pi3kConfig from the `n`-byte document at `buf` by serde's rules (its tree on allocator `a`): Ok(0) with *out
# filled, or Err(RY_ERR_DESERIALIZE) with *out untouched.
#must_use
fn ry_pi3k_config_from_json_a(a, buf, n, out: *RyPi3kConfig): Result {
