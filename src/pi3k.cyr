# Appends Pi3kFlux `f` as serde_json writes it, its three rates in declaration order, on allocator `a`: Ok(0), or
# Err(RY_ERR_OUT_OF_MEMORY).
#must_use
fn ry_pi3k_flux_to_json_a(a, sb, f: *RyPi3kFlux): Result {
