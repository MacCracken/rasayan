    if (_ry_nuclear_receptor_config_from_node(v, &w) == 0) {
        return Err(_ry_fail_text(RY_ERR_DESERIALIZE, "NuclearReceptorConfig", 21));
    }
    memcpy(out, &w, 56);
    return Ok(0);
}

# ry_nuclear_receptor_config_from_json_a on the default allocator (the tree is never freed: for a one-off read).
#must_use
fn ry_nuclear_receptor_config_from_json(buf, n, out: *RyNuclearReceptorConfig): Result {
    return ry_nuclear_receptor_config_from_json_a(default_alloc(), buf, n, out);
}

# Appends NuclearReceptorFlux `f` as serde_json writes it, its three rates in declaration order, on allocator `a`:
# Ok(0), or Err(RY_ERR_OUT_OF_MEMORY).
#must_use
fn ry_nuclear_receptor_flux_to_json_a(a, sb, f: *RyNuclearReceptorFlux): Result {
    if (_ry_jw_f64_fields(a, sb, f, 3, &_RY_NUCLEAR_RECEPTOR_FLUX_FIELDS) != 0) { return Err(RY_ERR_OUT_OF_MEMORY); }
    return Ok(0);
}

# ry_nuclear_receptor_flux_to_json_a on the default allocator.
#must_use
fn ry_nuclear_receptor_flux_to_json(sb, f: *RyNuclearReceptorFlux): Result {
    return ry_nuclear_receptor_flux_to_json_a(default_alloc(), sb, f);
}

# The NuclearReceptorFlux at node `v` of a parsed document, by serde's rules, into the 24 bytes at `w`: 1, or 0 for a
# refusal.
#must_use
fn _ry_nuclear_receptor_flux_from_node(v, w): i64 {
    return _ry_jr_f64_fields(v, w, 3, &_RY_NUCLEAR_RECEPTOR_FLUX_FIELDS);
}

# Reads a NuclearReceptorFlux from the `n`-byte document at `buf` by serde's rules (its tree on allocator `a`): Ok(0)
# with *out filled, or Err(RY_ERR_DESERIALIZE) with *out untouched.
#must_use
fn ry_nuclear_receptor_flux_from_json_a(a, buf, n, out: *RyNuclearReceptorFlux): Result {
    var w[24];
