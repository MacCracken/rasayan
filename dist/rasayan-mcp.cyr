    out.neural_activity = RY_HORMONAL_HORMONAL_INPUT_DEFAULT_NEURAL_ACTIVITY;
    return 0;
}

# Fills *out with Rust's HormonalFlux::default(): every rate 0.
fn ry_hormonal_flux_default(out: *RyHormonalFlux) {
    out.cortisol_net = 0.0;
    out.melatonin_synthesis = 0.0;
    out.oxytocin_release = 0.0;
    out.bdnf_production = 0.0;
    return 0;
}

# ── validation ──

# Ok(0) when every level is finite and >= 0; else the first failing one's Err, in declaration order. Mirrors
# `HormonalState::validate`.
#must_use
fn ry_hormonal_state_validate(p: *RyHormonalState): Result {
    var w = p;                                   # a plain address: `p + n` would step n states
    var name = &_RY_HORMONAL_STATE_FIELDS;
    var k = 0;
    while (k < 6) {
        var value: f64 = load64(w + 8 * k);
        var t, v = _ry_guard_non_negative(name, value);
        if (is_err_result(t) == 1) { return Err(v); }
        name = name + strlen(name) + 1;
        k = k + 1;
    }
    return Ok(0);
}

# 1 when config field `k` is a divisor (a Km or the feedback Ki, must be > 0), else 0 (>= 0).
#must_use
#pure
fn _ry_hormonal_is_divisor(k): i64 {
    if (k == 4 || k == 7 || k == 9 || k == 11) { return 1; }
    return 0;
}

# Ok(0) when every rate, gain, Vmax and the light sensitivity are finite and >= 0 and the three Kms and the feedback
# Ki finite and > 0; else the first failure's Err, in Rust's check order: the 16 others in declaration order first,
# then the four divisors. Mirrors `HormonalConfig::validate`.
#must_use
fn ry_hormonal_config_validate(p: *RyHormonalConfig): Result {
    var w = p;
    var pass = 0;
    while (pass < 2) {
        var name = &_RY_HORMONAL_CONFIG_FIELDS;
        var k = 0;
        while (k < 20) {
            if (_ry_hormonal_is_divisor(k) == pass) {
                var value: f64 = load64(w + 8 * k);
                var t = 0;
                var v = 0;
                if (pass == 1) {
                    t, v = _ry_guard_positive(name, value);
                } else {
                    t, v = _ry_guard_non_negative(name, value);
                }
                if (is_err_result(t) == 1) { return Err(v); }
            }
            name = name + strlen(name) + 1;
            k = k + 1;
        }
        pass = pass + 1;
    }
    return Ok(0);
}

# ── the dynamics ──

# Advances every hormone by `dt` seconds under the stimuli *input and fills *out with the flux, the pituitary arm at
# feedback Ki `acth_feedback_ki` (an infinite Ki makes its factor exactly 1: the hypothalamic-only model, bit for
# bit). The inputs are sanitized (`conc`; light by `unit`); the HPA stages run CRH → ACTH → cortisol, each driven by
# the freshly updated upstream level, both feedback arms reading the start-of-step cortisol; then melatonin, oxytocin
# and BDNF, every level by `produce_decay`. A non-finite or non-positive dt leaves the state untouched with a zero
# flux (and a trace event saying so). Mirrors the private `HormonalState::tick_with_acth_feedback`.
fn _ry_hormonal_state_tick_with_acth_feedback(p: *RyHormonalState, c: *RyHormonalConfig, input: *RyHormonalInput,
  dt: f64, acth_feedback_ki: f64, out: *RyHormonalFlux) {
    if (_ry_guard_valid_dt(dt) == 0) {
        if (_ry_trace_on() == 1) {
            var hd0[24];
            var b0[256];
            var e0 = _ry_ev(&hd0, &b0, 256, "rasayan::hormonal", "hormonal_tick skipped: invalid dt");
            _ry_ev_f(e0, "dt", dt);
            _ry_trace(e0);
        }
        ry_hormonal_flux_default(out);
        return 0;
    }
    var stress: f64 = _ry_guard_conc(input.stress);
    var serotonin: f64 = _ry_guard_conc(input.serotonin);
    var light: f64 = _ry_guard_unit(input.light);
    var social_stimulus: f64 = _ry_guard_conc(input.social_stimulus);
    var neural_activity: f64 = _ry_guard_conc(input.neural_activity);
    var cort0: f64 = p.cortisol;
    if (_ry_trace_on() == 1) {
        var hd[24];
        var b[256];
        var e = _ry_ev(&hd, &b, 256, "rasayan::hormonal", "hormonal_tick");
        _ry_ev_f(e, "dt", dt);
        _ry_ev_f(e, "stress", stress);
        _ry_ev_f(e, "cortisol", cort0);
        _ry_trace(e);
    }
    # The HPA axis: CRH → ACTH → cortisol with negative feedback. CRH: basal + stress-driven, inhibited by cortisol
    # (the hypothalamic arm).
    var hypo_q: f64 = cort0 / c.cortisol_feedback_ki;
    var cortisol_inhibition: f64 = 1.0 / (1.0 + hypo_q);
    var crh_drive: f64 = c.crh_basal_rate + c.crh_stress_gain * stress;
    var v_crh: f64 = crh_drive * cortisol_inhibition;
    var crh: f64 = _ry_integrate_produce_decay(p.crh, v_crh, c.crh_degradation_rate, dt);
    p.crh = crh;
    # ACTH: driven by CRH, inhibited by cortisol (the pituitary arm).
    var pit_q: f64 = cort0 / acth_feedback_ki;
    var pituitary_inhibition: f64 = 1.0 / (1.0 + pit_q);
    var acth_mm: f64 = ry_michaelis_menten(crh, c.acth_vmax, c.acth_km_crh);
    var v_acth: f64 = acth_mm * pituitary_inhibition;
    var acth: f64 = _ry_integrate_produce_decay(p.acth, v_acth, c.acth_degradation_rate, dt);
    p.acth = acth;
    # Cortisol: driven by ACTH.
    var v_cortisol: f64 = ry_michaelis_menten(acth, c.cortisol_vmax, c.cortisol_km_acth);
    var cortisol_net: f64 = v_cortisol - c.cortisol_degradation_rate * cort0;
    var cort: f64 = _ry_integrate_produce_decay(cort0, v_cortisol, c.cortisol_degradation_rate, dt);
    p.cortisol = cort;
    # Melatonin: serotonin → melatonin, suppressed by light.
    var light_suppression: f64 = 1.0 / (1.0 + light * c.melatonin_light_sensitivity);
    var nat: f64 = c.nat_vmax * light_suppression;
    var v_melatonin: f64 = ry_michaelis_menten(serotonin, nat, c.nat_km_serotonin);
    var mel: f64 = _ry_integrate_produce_decay(p.melatonin, v_melatonin, c.melatonin_degradation_rate, dt);
    p.melatonin = mel;
    # Oxytocin: basal + social stimulus.
    var v_oxytocin: f64 = c.oxytocin_basal_rate + c.oxytocin_stimulus_gain * social_stimulus;
    var oxy: f64 = _ry_integrate_produce_decay(p.oxytocin, v_oxytocin, c.oxytocin_degradation_rate, dt);
    p.oxytocin = oxy;
    # BDNF: basal + activity-dependent.
    var above_rest: f64 = _ry_max(neural_activity - 1.0, 0.0);
    var v_bdnf: f64 = c.bdnf_basal_rate + c.bdnf_activity_gain * above_rest;
    var bdnf: f64 = _ry_integrate_produce_decay(p.bdnf, v_bdnf, c.bdnf_degradation_rate, dt);
    p.bdnf = bdnf;
    out.cortisol_net = cortisol_net;
    out.melatonin_synthesis = v_melatonin;
    out.oxytocin_release = v_oxytocin;
    out.bdnf_production = v_bdnf;
    return 0;
}

# Advances every hormone by `dt` seconds under the stimuli *input and fills *out with the flux: the HPA axis with
# both feedback arms (the pituitary arm at RY_HORMONAL_ACTH_FEEDBACK_KI), then melatonin, oxytocin and BDNF. A
# non-finite or non-positive dt leaves the state untouched with a zero flux; NaN, infinite or negative inputs are 0,
# light is clamped into [0, 1]. Mirrors `HormonalState::tick`.
fn ry_hormonal_state_tick(p: *RyHormonalState, c: *RyHormonalConfig, input: *RyHormonalInput, dt: f64,
  out: *RyHormonalFlux) {
    _ry_hormonal_state_tick_with_acth_feedback(p, c, input, dt, RY_HORMONAL_ACTH_FEEDBACK_KI, out);
    return 0;
}

# ── the bridge functions (plain f64 outputs for mastishk and bhava) ──

# Cortisol's production rate from the HPA inputs with one lumped negative feedback, on the default kinetics: a
# CRH-driven ACTH drive (MM(crh; Vmax 0.1, Km 0.5)) added to `acth` drives adrenal synthesis (MM(·; Vmax 0.08, Km
# 0.5)), divided by 1 + feedback / 2. A rate in [0, 0.08), not a level, independent of the tick (no pituitary arm);
# NaN, infinite or negative inputs are 0. Mirrors `cortisol_from_hpa`.
#must_use
#pure
fn ry_cortisol_from_hpa(crh: f64, acth: f64, feedback: f64): f64 {
    var crh_c: f64 = _ry_guard_conc(crh);
    var acth_drive: f64 = ry_michaelis_menten(crh_c, 0.1, 0.5);
    var acth_c: f64 = _ry_guard_conc(acth);
    var effective_acth: f64 = acth_drive + acth_c;
    var cortisol_drive: f64 = ry_michaelis_menten(effective_acth, 0.08, 0.5);
    var fb: f64 = _ry_guard_conc(feedback);
    var r: f64 = cortisol_drive / (1.0 + fb / 2.0);
    return r;
}

# Melatonin's synthesis rate from serotonin under light, on the default kinetics (NAT Vmax 0.05, Km 0.5, light
# sensitivity 5): 0.05 · nat_activity · serotonin / (0.5 + serotonin) / (1 + 5 · light). `light_suppression` is the
# light intensity in [0, 1] (clamped, NaN 0); NaN, infinite or negative serotonin and NAT activity are 0. Mirrors
# `melatonin_from_serotonin`.
#must_use
#pure
fn ry_melatonin_from_serotonin(serotonin: f64, nat_activity: f64, light_suppression: f64): f64 {
    var light: f64 = _ry_guard_unit(light_suppression);
    var light_factor: f64 = 1.0 / (1.0 + light * 5.0);
    var sero: f64 = _ry_guard_conc(serotonin);
    var act: f64 = _ry_guard_conc(nat_activity);
    var vmax: f64 = 0.05 * act * light_factor;
    var r: f64 = ry_michaelis_menten(sero, vmax, 0.5);
    return r;
}

