# --- enzyme.cyr ---

# enzyme.cyr — enzyme kinetics: Michaelis-Menten, inhibition, allosteric regulation, multi-substrate kinetics,
# linearization fits, and the enzyme database (Rust 1.2.0's `enzyme.rs`, transcribed).
#
# Rates for enzyme-catalyzed reactions. Concentrations in molar (M), rates in M/s, temperatures in kelvin, energies in
# J/mol. Rate functions treat a NaN, infinite or negative substrate, product or inhibitor concentration as 0
# (`_ry_guard_conc`), so a bad input yields a finite rate instead of propagating NaN into a simulation.
#
# Every operation is in Rust's order: tests/golden/enzyme.tsv compares each function with the oracle's at ≤ 2 ulp
# where only + − × ÷ run (class B, expected 0) and at 0 ulp against the corrected oracle where Hill and Q10 call `powf`
# and Arrhenius `exp` (class C, ADR 0003: `_ry_cr_pow`, `_ry_cr_exp`).
#
# The Cyrius forms (ADR 0002 rows 2, 3, 10):
# - KineticFit, EnzymeParams and KnownEnzyme are structs (RyKineticFit, RyEnzymeParams, RyKnownEnzyme), methods take
#   a pointer: `ry_enzyme_params_rate(&p, s)`;
# - the fits' Option<KineticFit> is a 1 (Some: *out filled) or 0 (None: *out untouched), and their `&[(f64, f64)]` a
#   pointer to n (s, v) pairs of f64 (16 bytes each);
# - `lookup_enzyme`'s Option<&KnownEnzyme> is the entry's index into the generated table (src/enzyme_data.cyr), or
#   -1; `ry_known_enzyme(i, &e)` fills a RyKnownEnzyme from it;
# - each serde type has `ry_<type>_to_json` (and `_a`, on an allocator) and, for KineticFit and EnzymeParams,
#   `ry_<type>_from_json` (and `_a`), src/json.cyr's writers and readers.

# ── single-substrate rate equations ──

# Michaelis-Menten reaction rate, `v = Vmax * [S] / (Km + [S])`: substrate (M), vmax (M/s), km (M). Mirrors
# `enzyme::michaelis_menten`.
#must_use
#pure
fn ry_michaelis_menten(substrate: f64, vmax: f64, km: f64): f64 {
    var s: f64 = _ry_guard_conc(substrate);
    var denom: f64 = km + s;
    if (denom > 0.0) {
        var r: f64 = vmax * s / denom;
        return r;
    }
    return 0.0;
}

# The Hill equation's fractional saturation, `s^n / (k^n + s^n)`, in [0, 1], evaluated as `1 / (1 + (k/s)^n)` (one
# `powf`, no inf/inf for a large s, no 0/0 when both powers underflow). s NaN, <= 0 or infinite → 0; k == 0 → 1; k
# negative, NaN or +inf → 0; n NaN → 0. Shared by ry_hill_equation and signal's dose-response functions. Mirrors the
# crate-private `enzyme::hill_fraction`.
#must_use
#pure
fn _ry_enzyme_hill_fraction(substrate: f64, k: f64, n: f64): f64 {
    var s: f64 = _ry_guard_conc(substrate);
    if (s <= 0.0 || _ry_is_nan(n) == 1) { return 0.0; }
    if (k == 0.0) { return 1.0; }
    if (k > 0.0 && k < _RY_INF) {
        var q: f64 = k / s;
        var p: f64 = _ry_cr_pow(q, n);
        var r: f64 = 1.0 / (1.0 + p);
        return r;
    }
    return 0.0;
}

# Hill equation for cooperative / allosteric binding, `v = Vmax * [S]^n / (K_half^n + [S]^n)`, as `Vmax / (1 +
# (K_half/[S])^n)`: a NaN, negative or infinite [S] gives 0; K_half == 0 gives Vmax for any positive [S]; a negative or
# non-finite K_half gives 0. Mirrors `enzyme::hill_equation`.
#must_use
#pure
fn ry_hill_equation(substrate: f64, vmax: f64, k_half: f64, n: f64): f64 {
    var frac: f64 = _ry_enzyme_hill_fraction(substrate, k_half, n);
    var r: f64 = vmax * frac;
    return r;
}

# ── inhibition models ──
# With [I] == 0 there is no inhibition whatever Ki is; Ki = +inf means that mode of inhibition is absent; with
# [I] > 0, a Ki that is <= 0 or NaN is the limit Ki → 0 (infinitely tight binding) and the rate is 0.

# The inhibition factor `1 + [I]/Ki` as (1, factor), or (0, 0) when the inhibitor is present and Ki is <= 0 or NaN
# (fully inhibited). Mirrors the private `inhibition_factor`'s Option<f64>.
#must_use
#pure
fn _ry_enzyme_inhibition_factor(inhibitor: f64, ki: f64): (i64, f64) {
    var i: f64 = _ry_guard_conc(inhibitor);
    if (i <= 0.0) { return (1, 1.0); }
    if (ki > 0.0) {
        var f: f64 = 1.0 + i / ki;
        return (1, f);
    }
    return (0, 0.0);
}

# Competitive inhibition, `v = Vmax * [S] / (Km * (1 + [I]/Ki) + [S])`: the apparent Km rises, Vmax is unchanged.
# Mirrors `enzyme::competitive_inhibition`.
#must_use
#pure
fn ry_competitive_inhibition(substrate: f64, inhibitor: f64, vmax: f64, km: f64, ki: f64): f64 {
    var has, factor = _ry_enzyme_inhibition_factor(inhibitor, ki);
    if (has == 0) { return 0.0; }
    var km_app: f64 = km * factor;
    var r: f64 = ry_michaelis_menten(substrate, vmax, km_app);
    return r;
}

# Uncompetitive inhibition, `v = Vmax / (1 + [I]/Ki) * [S] / (Km / (1 + [I]/Ki) + [S])`: Vmax and Km fall together.
# Mirrors `enzyme::uncompetitive_inhibition`.
#must_use
#pure
fn ry_uncompetitive_inhibition(substrate: f64, inhibitor: f64, vmax: f64, km: f64, ki: f64): f64 {
    var has, factor = _ry_enzyme_inhibition_factor(inhibitor, ki);
    if (has == 0) { return 0.0; }
    var vmax_app: f64 = vmax / factor;
    var km_app: f64 = km / factor;
    var r: f64 = ry_michaelis_menten(substrate, vmax_app, km_app);
    return r;
}

# Mixed (noncompetitive) inhibition, `v = Vmax * [S] / (Km * (1 + [I]/Ki) + [S] * (1 + [I]/Ki'))`: the inhibitor
# binds the free enzyme (Ki) and the enzyme-substrate complex (Ki'); Ki == Ki' is pure noncompetitive inhibition.
# Mirrors `enzyme::mixed_inhibition`.
#must_use
#pure
fn ry_mixed_inhibition(substrate: f64, inhibitor: f64, vmax: f64, km: f64, ki: f64, ki_prime: f64): f64 {
    var ha, alpha = _ry_enzyme_inhibition_factor(inhibitor, ki);
    var hp, alpha_prime = _ry_enzyme_inhibition_factor(inhibitor, ki_prime);
    if (ha == 0 || hp == 0) { return 0.0; }
    var s: f64 = _ry_guard_conc(substrate);
    var denom: f64 = km * alpha + s * alpha_prime;
    if (denom > 0.0) {
        var r: f64 = vmax * s / denom;
        return r;
    }
    return 0.0;
}

# Substrate inhibition, `v = Vmax * [S] / (Km + [S] + [S]^2 / Ks)`: Michaelis-Menten at low [S], falling at high [S].
# Ks NaN or <= 0 gives 0; Ks = +inf is plain Michaelis-Menten. Mirrors `enzyme::substrate_inhibition`.
#must_use
#pure
fn ry_substrate_inhibition(substrate: f64, vmax: f64, km: f64, ks: f64): f64 {
    if (_ry_is_nan(ks) == 1 || ks <= 0.0) { return 0.0; }
    var s: f64 = _ry_guard_conc(substrate);
    var denom: f64 = km + s + s * s / ks;
    if (denom > 0.0) {
        var r: f64 = vmax * s / denom;
        return r;
    }
    return 0.0;
}

# ── reversible kinetics ──

# Reversible Michaelis-Menten (Haldane-simplified, no dead-end cross term), `v = (Vf * [S]/Km_f - Vr * [P]/Km_r) /
# (1 + [S]/Km_f + [P]/Km_r)`: positive is net forward. Both Km must be > 0, else 0. Mirrors
# `enzyme::reversible_michaelis_menten`.
#must_use
#pure
fn ry_reversible_michaelis_menten(substrate: f64, product: f64, vmax_f: f64, km_f: f64, vmax_r: f64, km_r: f64): f64 {
    if ((km_f > 0.0 && km_r > 0.0) == 0) { return 0.0; }
    var s: f64 = _ry_guard_conc(substrate);
    var p: f64 = _ry_guard_conc(product);
    var num: f64 = vmax_f * s / km_f - vmax_r * p / km_r;
    var den: f64 = 1.0 + s / km_f + p / km_r;
    if (den > 0.0) {
        var r: f64 = num / den;
        return r;
    }
    return 0.0;
}

# The Haldane relationship, `Keq = (Vmax_f * Km_r) / (Vmax_r * Km_f)`; 0 when `Vmax_r * Km_f <= 0`. Mirrors
# `enzyme::haldane_keq`.
#must_use
#pure
fn ry_haldane_keq(vmax_f: f64, km_f: f64, vmax_r: f64, km_r: f64): f64 {
    var den: f64 = vmax_r * km_f;
    if (den <= 0.0) { return 0.0; }
    var num: f64 = vmax_f * km_r;
    var r: f64 = num / den;
    return r;
}

# ── multi-substrate kinetics ──

# Ping-pong (double-displacement) bi-substrate rate, `v = Vmax * [A] * [B] / (Km_A * [B] + Km_B * [A] + [A] * [B])`.
# Mirrors `enzyme::ping_pong`.
#must_use
#pure
fn ry_ping_pong(a0: f64, b0: f64, vmax: f64, km_a: f64, km_b: f64): f64 {
    var a: f64 = _ry_guard_conc(a0);
    var b: f64 = _ry_guard_conc(b0);
    var denom: f64 = km_a * b + km_b * a + a * b;
    if (denom > 0.0) {
        var r: f64 = vmax * a * b / denom;
        return r;
    }
    return 0.0;
}

# Sequential (ordered or random) bi-substrate rate, `v = Vmax * [A] * [B] / (Ki_A * Km_B + Km_B * [A] + Km_A * [B] +
# [A] * [B])`: both substrates bind before catalysis. Mirrors `enzyme::sequential_bisubstrate`.
#must_use
#pure
fn ry_sequential_bisubstrate(a0: f64, b0: f64, vmax: f64, km_a: f64, km_b: f64, ki_a: f64): f64 {
    var a: f64 = _ry_guard_conc(a0);
    var b: f64 = _ry_guard_conc(b0);
    var denom: f64 = ki_a * km_b + km_b * a + km_a * b + a * b;
    if (denom > 0.0) {
        var r: f64 = vmax * a * b / denom;
        return r;
    }
    return 0.0;
}

# ── temperature dependence ──

# The Q10 model, `rate_new = rate_ref * Q10^((T - T_ref) / 10)`; a Q10 that is <= 0 or non-finite gives 0. Mirrors
# `enzyme::q10_rate`.
#must_use
#pure
fn ry_q10_rate(rate_ref: f64, q10: f64, temp: f64, temp_ref: f64): f64 {
    if (_ry_is_finite(q10) == 1 && q10 > 0.0) {
        var e: f64 = (temp - temp_ref) / 10.0;
        var p: f64 = _ry_cr_pow(q10, e);
        var r: f64 = rate_ref * p;
        return r;
    }
    return 0.0;
}

# The Arrhenius equation, `k = A * exp(-Ea / (R * T))`: pre-exponential A, activation energy Ea (J/mol), T (K); 0 for
# T <= 0. Mirrors `enzyme::arrhenius`.
#must_use
#pure
fn ry_arrhenius(pre_exponential: f64, activation_energy: f64, temp_kelvin: f64): f64 {
    if (temp_kelvin <= 0.0) { return 0.0; }
    var nea: f64 = -activation_energy;
    var rt: f64 = RY_R_GAS * temp_kelvin;
    var x: f64 = nea / rt;
    var e: f64 = _ry_cr_exp(x);
    var r: f64 = pre_exponential * e;
    return r;
}

# The two-temperature Arrhenius form, `k2 = k1 * exp((Ea / R) * (1/T1 - 1/T2))`; 0 when T1 or T2 is <= 0. Mirrors
# `enzyme::arrhenius_relative`.
#must_use
#pure
fn ry_arrhenius_relative(rate_at_t1: f64, activation_energy: f64, t1: f64, t2: f64): f64 {
    if (t1 <= 0.0 || t2 <= 0.0) { return 0.0; }
    var ear: f64 = activation_energy / RY_R_GAS;
    var i1: f64 = 1.0 / t1;
    var i2: f64 = 1.0 / t2;
    var d: f64 = i1 - i2;
    var x: f64 = ear * d;
    var e: f64 = _ry_cr_exp(x);
    var r: f64 = rate_at_t1 * e;
    return r;
}

# ── linearization fits ──

# A kinetic fit: estimated Km (M), Vmax (M/s) and the linear fit's R². Rust's `KineticFit`.
struct RyKineticFit {
    km: f64;
    vmax: f64;
    r_squared: f64;
}

# Point `k` of the n (s, v) pairs at `data`, as the regression of `kind` sees it, into the two words at `xy`: kind 0
# the pair itself; 1 Lineweaver-Burk's (1/s, 1/v) and 2 Eadie-Hofstee's (v/s, v), for a usable point only (finite s
# and v, both > 0: Rust's `valid_point` filter). 1 when the point is in, else 0.
fn _ry_enzyme_point(data, k, kind, xy): i64 {
    var s: f64 = load64(data + 16 * k);
    var v: f64 = load64(data + 16 * k + 8);
    if (kind == 0) {
        store64(xy, load64(&s));
        store64(xy + 8, load64(&v));
        return 1;
    }
    if ((_ry_is_finite(s) == 1 && _ry_is_finite(v) == 1 && s > 0.0 && v > 0.0) == 0) { return 0; }
    if (kind == 1) {
        var x1: f64 = 1.0 / s;
        var y1: f64 = 1.0 / v;
        store64(xy, load64(&x1));
        store64(xy + 8, load64(&y1));
        return 1;
    }
    var x2: f64 = v / s;
    store64(xy, load64(&x2));
    store64(xy + 8, load64(&v));
    return 1;
}

# Ordinary least squares on the points `_ry_enzyme_point(data, k, kind)` gives, with centred two-pass sums (Sxx =
# Σ(x − x̄)², Sxy = Σ(x − x̄)(y − ȳ)) and a relative degeneracy test (Sxx <= 1e-12·Σx²), in Rust's summation order.
# (slope, intercept, R²) into the three words at `out` and 1, or 0 (Rust's None) when fewer than 2 points are in,
# any is non-finite, all x are numerically equal, or the fit overflows. The transform is applied in each pass, so no
# transformed copy of the data is made. Mirrors the private `linear_regression` (over the fits' transformed points).
fn _ry_enzyme_linear_regression(data, n, kind, out): i64 {
    var xy[16];
    var count = 0;
    var sum_x: f64 = 0.0;
    var sum_y: f64 = 0.0;
    var k = 0;
    while (k < n) {
        if (_ry_enzyme_point(data, k, kind, &xy) == 1) {
            var x: f64 = load64(&xy);
            var y: f64 = load64(&xy + 8);
            if (_ry_is_finite(x) == 0 || _ry_is_finite(y) == 0) { return 0; }
            sum_x = sum_x + x;
            sum_y = sum_y + y;
            count = count + 1;
        }
        k = k + 1;
    }
    if (count < 2) { return 0; }
    var nf: f64 = f64_from(count);
    var mean_x: f64 = sum_x / nf;
    var mean_y: f64 = sum_y / nf;
    var sxx: f64 = 0.0;
    var sxy: f64 = 0.0;
    var syy: f64 = 0.0;
    var sum_x2: f64 = 0.0;
    k = 0;
    while (k < n) {
        if (_ry_enzyme_point(data, k, kind, &xy) == 1) {
            var px: f64 = load64(&xy);
            var py: f64 = load64(&xy + 8);
            var dx: f64 = px - mean_x;
            var dy: f64 = py - mean_y;
            sxx = sxx + dx * dx;
            sxy = sxy + dx * dy;
            syy = syy + dy * dy;
            sum_x2 = sum_x2 + px * px;
        }
        k = k + 1;
    }
    var tol: f64 = _RY_ENZYME_REGRESSION_REL_TOL * sum_x2;
    if (_ry_is_finite(sxx) == 0 || sxx <= tol) { return 0; }
    var slope: f64 = sxy / sxx;
    var intercept: f64 = mean_y - slope * mean_x;
    if ((_ry_is_finite(slope) == 1 && _ry_is_finite(intercept) == 1) == 0) { return 0; }
    var r2: f64 = 0.0;
    if (syy > 0.0) {
        var q: f64 = sxy / syy;
        var raw: f64 = slope * q;
        r2 = _ry_clamp(raw, 0.0, 1.0);
    }
    store64(out, load64(&slope));
    store64(out + 8, load64(&intercept));
    store64(out + 16, load64(&r2));
    return 1;
}

# 1 when a fitted Km / Vmax pair is physically meaningful (both finite and > 0), else 0. Mirrors `valid_fit`.
#must_use
#pure
fn _ry_enzyme_valid_fit(km: f64, vmax: f64): i64 {
    if (_ry_is_finite(km) == 1 && _ry_is_finite(vmax) == 1 && km > 0.0 && vmax > 0.0) { return 1; }
    return 0;
}

# Fits Km and Vmax to the n (s, v) pairs at `data` by Lineweaver-Burk (double-reciprocal) linearization, `1/v =
# (Km/Vmax)·(1/[S]) + 1/Vmax`, skipping zero, negative and non-finite points. 1 with *out filled, or 0 (None) when
# fewer than 2 usable points remain, the regression is degenerate, or the fitted Km or Vmax is not finite and > 0.
# Mirrors `enzyme::lineweaver_burk_fit`.
fn ry_lineweaver_burk_fit(data, n, out: *RyKineticFit): i64 {
    var r[24];
    if (_ry_enzyme_linear_regression(data, n, 1, &r) == 0) { return 0; }
    var slope: f64 = load64(&r);
    var intercept: f64 = load64(&r + 8);
    var r2: f64 = load64(&r + 16);
    var vmax: f64 = 1.0 / intercept;
    var km: f64 = slope * vmax;
    if (_ry_enzyme_valid_fit(km, vmax) == 0) { return 0; }
    out.km = km;
    out.vmax = vmax;
    out.r_squared = r2;
    return 1;
}

# Fits Km and Vmax by Eadie-Hofstee linearization, `v = Vmax − Km·(v/[S])` (slope −Km, intercept Vmax): less
# sensitive than Lineweaver-Burk to outliers at extreme concentrations. Same filtering and None cases. Mirrors
# `enzyme::eadie_hofstee_fit`.
fn ry_eadie_hofstee_fit(data, n, out: *RyKineticFit): i64 {
    var r[24];
    if (_ry_enzyme_linear_regression(data, n, 2, &r) == 0) { return 0; }
    var slope: f64 = load64(&r);
    var vmax: f64 = load64(&r + 8);
    var r2: f64 = load64(&r + 16);
    var km: f64 = -slope;
    if (_ry_enzyme_valid_fit(km, vmax) == 0) { return 0; }
    out.km = km;
    out.vmax = vmax;
    out.r_squared = r2;
    return 1;
}

# ── EnzymeParams ──

# Enzyme parameters for one reaction: Vmax (M/s), Km (M), the Hill coefficient (1.0 for Michaelis-Menten), kcat (1/s).
# Rust's `EnzymeParams`.
struct RyEnzymeParams {
    vmax: f64;
    km: f64;
    hill_n: f64;
    kcat: f64;
}

# Ok(0) when every field is finite, vmax and kcat >= 0 and km and hill_n > 0; else the first failing guard's Err (in
# Rust's order: vmax, km, kcat, hill_n). Mirrors `EnzymeParams::validate`.
#must_use
fn ry_enzyme_params_validate(p: *RyEnzymeParams): Result {
    var vmax: f64 = p.vmax;
    var km: f64 = p.km;
    var kcat: f64 = p.kcat;
    var hill_n: f64 = p.hill_n;
    var t1, v1 = _ry_guard_non_negative("vmax", vmax);
    if (is_err_result(t1) == 1) { return Err(v1); }
    var t2, v2 = _ry_guard_positive("km", km);
    if (is_err_result(t2) == 1) { return Err(v2); }
    var t3, v3 = _ry_guard_non_negative("kcat", kcat);
    if (is_err_result(t3) == 1) { return Err(v3); }
    var t4, v4 = _ry_guard_positive("hill_n", hill_n);
    if (is_err_result(t4) == 1) { return Err(v4); }
    return Ok(0);
}

# Catalytic efficiency kcat / Km (0 unless Km > 0). Mirrors `EnzymeParams::catalytic_efficiency`.
#must_use
#pure
fn ry_enzyme_params_catalytic_efficiency(p: *RyEnzymeParams): f64 {
    var km: f64 = p.km;
    var kcat: f64 = p.kcat;
    if (km > 0.0) {
        var r: f64 = kcat / km;
        return r;
    }
    return 0.0;
}

# The reaction rate at `substrate`: Michaelis-Menten when |hill_n − 1| < f64::EPSILON, else the Hill equation with
# K_half = km. Mirrors `EnzymeParams::rate`.
#must_use
#pure
fn ry_enzyme_params_rate(p: *RyEnzymeParams, substrate: f64): f64 {
    var vmax: f64 = p.vmax;
    var km: f64 = p.km;
    var hill_n: f64 = p.hill_n;
    var eps: f64 = 0x3CB0000000000000;
    var d: f64 = hill_n - 1.0;
    var ad: f64 = f64_abs(d);
    if (ad < eps) {
        var mm: f64 = ry_michaelis_menten(substrate, vmax, km);
        return mm;
    }
    var h: f64 = ry_hill_equation(substrate, vmax, km, hill_n);
    return h;
}

# ── the enzyme database ──

# A well-characterized enzyme with published kinetic constants: its name, EC number and primary substrate (C strings
# into the generated table), Km (M), kcat (1/s), the Hill coefficient. Rust's `KnownEnzyme`; the entries are
# src/enzyme_data.cyr's columns (`RY_KNOWN_ENZYME_*`, Rust's KNOWN_ENZYMES).
struct RyKnownEnzyme {
    name;
    ec_number;
    substrate;
    km: f64;
    kcat: f64;
    hill_n: f64;
}

# Fills *out with database entry `i` (0 … RY_KNOWN_ENZYME_COUNT − 1, Rust's `KNOWN_ENZYMES[i]`): 1, or 0 when `i` is no
# entry.
fn ry_known_enzyme(i, out: *RyKnownEnzyme): i64 {
    if (i < 0 || i >= RY_KNOWN_ENZYME_COUNT) { return 0; }
    out.name = &_RY_KNOWN_ENZYME_NAME_BYTES + _RY_KNOWN_ENZYME_NAME_OFF[i];
    out.ec_number = &_RY_KNOWN_ENZYME_EC_NUMBER_BYTES + _RY_KNOWN_ENZYME_EC_NUMBER_OFF[i];
    out.substrate = &_RY_KNOWN_ENZYME_SUBSTRATE_BYTES + _RY_KNOWN_ENZYME_SUBSTRATE_OFF[i];
    var km: f64 = RY_KNOWN_ENZYME_KM[i];
    var kcat: f64 = RY_KNOWN_ENZYME_KCAT[i];
    var hill_n: f64 = RY_KNOWN_ENZYME_HILL_N[i];
    out.km = km;
    out.kcat = kcat;
    out.hill_n = hill_n;
    return 1;
}

# The index of the database entry named [name, name + len), compared ignoring ASCII case (Rust's
# `eq_ignore_ascii_case`), the first that matches; -1 when none does. Mirrors `enzyme::lookup_enzyme`'s
# Option<&KnownEnzyme> (ry_known_enzyme fills the entry).
#must_use
fn ry_lookup_enzyme(name, len): i64 {
    if (len <= 0) { return 0 - 1; }
    var c0 = load8(name);
    if (c0 >= 65 && c0 <= 90) { c0 = c0 + 32; }
    var r = 0;
    while (r < RY_KNOWN_ENZYME_COUNT) {
        var e = &_RY_KNOWN_ENZYME_NAME_BYTES + _RY_KNOWN_ENZYME_NAME_OFF[r];
        # The first byte, case-folded, before the length: most entries differ there.
        var e0 = load8(e);
        if (e0 >= 65 && e0 <= 90) { e0 = e0 + 32; }
        var el = 0;
        if (e0 == c0) { el = strlen(e); }
        if (el == len) {
            var same = 1;
            var k = 0;
            while (k < len) {
                var x = load8(e + k);
                var y = load8(name + k);
                if (x >= 65 && x <= 90) { x = x + 32; }
                if (y >= 65 && y <= 90) { y = y + 32; }
                if (x != y) {
                    same = 0;
                    break;
                }
                k = k + 1;
            }
            if (same == 1) { return r; }
        }
        r = r + 1;
    }
    return 0 - 1;
}

# Fills *out with the EnzymeParams of entry `e` at total enzyme concentration `enzyme_conc` (M): Vmax = kcat·[E], Km,
# hill_n and kcat as the entry's. Mirrors `KnownEnzyme::params`.
fn ry_known_enzyme_params(e: *RyKnownEnzyme, enzyme_conc: f64, out: *RyEnzymeParams) {
    var kcat: f64 = e.kcat;
    var km: f64 = e.km;
    var hill_n: f64 = e.hill_n;
    var vmax: f64 = kcat * enzyme_conc;
    out.vmax = vmax;
    out.km = km;
    out.hill_n = hill_n;
    out.kcat = kcat;
    return 0;
}

# Catalytic efficiency kcat / Km (1/(M·s)) of entry `e` (0 unless Km > 0). Mirrors `KnownEnzyme::catalytic_efficiency`.
#must_use
#pure
fn ry_known_enzyme_catalytic_efficiency(e: *RyKnownEnzyme): f64 {
    var km: f64 = e.km;
    var kcat: f64 = e.kcat;
    if (km > 0.0) {
        var r: f64 = kcat / km;
        return r;
    }
    return 0.0;
}

# ── JSON (P7: serde_json's documents) ──

# The NUL-separated field names of the two all-f64 serde types, in Rust's declaration order.
var _RY_KINETIC_FIT_FIELDS = "km\0vmax\0r_squared\0";
var _RY_ENZYME_PARAMS_FIELDS = "vmax\0km\0hill_n\0kcat\0";

# Appends KineticFit `p` as serde_json writes it, `{"km":…,"vmax":…,"r_squared":…}`, on allocator `a`: Ok(0), or
# Err(RY_ERR_OUT_OF_MEMORY) when the builder could not grow.
#must_use
fn ry_kinetic_fit_to_json_a(a, sb, p: *RyKineticFit): Result {
    if (_ry_jw_f64_fields(a, sb, p, 3, _RY_KINETIC_FIT_FIELDS) != 0) { return Err(RY_ERR_OUT_OF_MEMORY); }
    return Ok(0);
}

# ry_kinetic_fit_to_json_a on the default allocator (a builder from str_builder_new).
#must_use
fn ry_kinetic_fit_to_json(sb, p: *RyKineticFit): Result {
    return ry_kinetic_fit_to_json_a(default_alloc(), sb, p);
}

# Reads a KineticFit from the `n`-byte document at `buf` by serde's rules (its tree on allocator `a`, which the caller
# resets): Ok(0) with *out filled, or Err(RY_ERR_DESERIALIZE).
#must_use
fn ry_kinetic_fit_from_json_a(a, buf, n, out: *RyKineticFit): Result {
    var w[24];
    var v = _ry_jr_parse(a, buf, n);
    if (_ry_jr_f64_fields(v, &w, 3, _RY_KINETIC_FIT_FIELDS) == 0) {
        return Err(_ry_fail_text(RY_ERR_DESERIALIZE, "KineticFit", 10));
    }
    memcpy(out, &w, 24);
    return Ok(0);
}

# ry_kinetic_fit_from_json_a on the default allocator (the tree is never freed: for a one-off read).
#must_use
fn ry_kinetic_fit_from_json(buf, n, out: *RyKineticFit): Result {
    return ry_kinetic_fit_from_json_a(default_alloc(), buf, n, out);
}

# Appends EnzymeParams `p` as serde_json writes it, `{"vmax":…,"km":…,"hill_n":…,"kcat":…}`: Ok(0), or
# Err(RY_ERR_OUT_OF_MEMORY).
#must_use
fn ry_enzyme_params_to_json_a(a, sb, p: *RyEnzymeParams): Result {
    if (_ry_jw_f64_fields(a, sb, p, 4, _RY_ENZYME_PARAMS_FIELDS) != 0) { return Err(RY_ERR_OUT_OF_MEMORY); }
    return Ok(0);
}

# ry_enzyme_params_to_json_a on the default allocator.
#must_use
fn ry_enzyme_params_to_json(sb, p: *RyEnzymeParams): Result {
    return ry_enzyme_params_to_json_a(default_alloc(), sb, p);
}

# Reads an EnzymeParams by serde's rules: Ok(0) with *out filled, or Err(RY_ERR_DESERIALIZE).
#must_use
fn ry_enzyme_params_from_json_a(a, buf, n, out: *RyEnzymeParams): Result {
    var w[32];
    var v = _ry_jr_parse(a, buf, n);
    if (_ry_jr_f64_fields(v, &w, 4, _RY_ENZYME_PARAMS_FIELDS) == 0) {
        return Err(_ry_fail_text(RY_ERR_DESERIALIZE, "EnzymeParams", 12));
    }
    memcpy(out, &w, 32);
    return Ok(0);
}

# ry_enzyme_params_from_json_a on the default allocator.
#must_use
fn ry_enzyme_params_from_json(buf, n, out: *RyEnzymeParams): Result {
    return ry_enzyme_params_from_json_a(default_alloc(), buf, n, out);
}

# Appends KnownEnzyme `e` as serde_json writes it (Serialize only in Rust: `&'static str` fields), `{"name":…,
# "ec_number":…,"substrate":…,"km":…,"kcat":…,"hill_n":…}`: Ok(0), or Err(RY_ERR_OUT_OF_MEMORY).
#must_use
fn ry_known_enzyme_to_json_a(a, sb, e: *RyKnownEnzyme): Result {
    var km: f64 = e.km;
    var kcat: f64 = e.kcat;
    var hill_n: f64 = e.hill_n;
    var r = _ry_jw_byte(a, sb, 123);
    r = r | _ry_jw_key(a, sb, "name", 1);
    r = r | _ry_jw_str(a, sb, e.name, strlen(e.name));
    r = r | _ry_jw_key(a, sb, "ec_number", 0);
    r = r | _ry_jw_str(a, sb, e.ec_number, strlen(e.ec_number));
    r = r | _ry_jw_key(a, sb, "substrate", 0);
    r = r | _ry_jw_str(a, sb, e.substrate, strlen(e.substrate));
    r = r | _ry_jw_key(a, sb, "km", 0);
    r = r | _ry_jw_f64(a, sb, km);
    r = r | _ry_jw_key(a, sb, "kcat", 0);
    r = r | _ry_jw_f64(a, sb, kcat);
    r = r | _ry_jw_key(a, sb, "hill_n", 0);
    r = r | _ry_jw_f64(a, sb, hill_n);
    r = r | _ry_jw_byte(a, sb, 125);
    if (r != 0) { return Err(RY_ERR_OUT_OF_MEMORY); }
    return Ok(0);
}

# ry_known_enzyme_to_json_a on the default allocator.
#must_use
fn ry_known_enzyme_to_json(sb, e: *RyKnownEnzyme): Result {
    return ry_known_enzyme_to_json_a(default_alloc(), sb, e);
}

# --- membrane_data.cyr ---

# rasayan — membrane data: the default membrane permeability ratios and ion concentrations
#
# GENERATED by scripts/oracle from rasayan 1.2.0 (rust-old/). Do not edit.
# Regenerate: cargo run --release --locked --manifest-path scripts/oracle/Cargo.toml
#
# DEFAULT_PERMEABILITY and IonicState::default(), from the oracle's API: one f64 const per
# field of each value, as a round-trip decimal. tests/golden/membrane.tsv pins them.

# Ion permeability ratios for the Goldman equation.
#
# Default resting permeability ratios, P_K : P_Na : P_Cl = 1 : 0.04 : 0.45.
#
# These are the classic squid giant axon ratios (Hodgkin & Katz 1949,
# *J. Physiol.* 108:37), widely used as a generic resting-membrane default;
# mammalian neurons vary (P_Na/P_K is often quoted at 0.01-0.05).
# Rust: rasayan::membrane::DEFAULT_PERMEABILITY

# Na+ relative permeability.
# Rust: rasayan::membrane::DEFAULT_PERMEABILITY.p_na
const RY_MEMBRANE_DEFAULT_PERMEABILITY_P_NA = 0.04;

# K+ relative permeability.
# Rust: rasayan::membrane::DEFAULT_PERMEABILITY.p_k
const RY_MEMBRANE_DEFAULT_PERMEABILITY_P_K = 1.0;

# Cl- relative permeability.
# Rust: rasayan::membrane::DEFAULT_PERMEABILITY.p_cl
const RY_MEMBRANE_DEFAULT_PERMEABILITY_P_CL = 0.45;

# Ion concentrations for a typical mammalian neuron.
# Typical mammalian neuron values (the `impl Default for IonicState` literal).
# Rust: rasayan::membrane::IonicState::default()

# Na+ intracellular (mM).
# Rust: rasayan::membrane::IonicState::default().na_in
const RY_MEMBRANE_IONIC_STATE_DEFAULT_NA_IN = 12.0;

# Na+ extracellular (mM).
# Rust: rasayan::membrane::IonicState::default().na_out
const RY_MEMBRANE_IONIC_STATE_DEFAULT_NA_OUT = 145.0;

# K+ intracellular (mM).
# Rust: rasayan::membrane::IonicState::default().k_in
const RY_MEMBRANE_IONIC_STATE_DEFAULT_K_IN = 155.0;

# K+ extracellular (mM).
# Rust: rasayan::membrane::IonicState::default().k_out
const RY_MEMBRANE_IONIC_STATE_DEFAULT_K_OUT = 4.0;

# Cl- intracellular (mM).
# Rust: rasayan::membrane::IonicState::default().cl_in
const RY_MEMBRANE_IONIC_STATE_DEFAULT_CL_IN = 4.0;

# Cl- extracellular (mM).
# Rust: rasayan::membrane::IonicState::default().cl_out
const RY_MEMBRANE_IONIC_STATE_DEFAULT_CL_OUT = 120.0;

# --- membrane.cyr ---

# membrane.cyr — membrane transport: Fick diffusion, the Nernst potential, the Goldman-Hodgkin-Katz equation (Rust
# 1.2.0's `membrane.rs`, transcribed).
#
# Potentials in mV, temperatures in kelvin, concentrations in mM, Fick's flux in SI units (m²/s, mol/m³, m). An
# input where the potential or flux is undefined (a temperature, concentration, weighted sum or ratio that is not a
# finite value > 0; a zero charge; an overflowing flux) gives 0.0, so a bad input never poisons a simulation with NaN.
#
# Every operation is in Rust's order: tests/golden/membrane.tsv compares each function with the oracle's at ≤ 2 ulp
# where only + − × ÷ run (class B, expected 0) and at 0 ulp against the corrected oracle where Nernst and Goldman call
# `ln` (class C, ADR 0003: `_ry_cr_ln`).
#
# The Cyrius forms (ADR 0002 row 10):
# - MembranePermeability and IonicState are structs (RyMembranePermeability, RyIonicState); methods and `goldman`
#   take pointers: `ry_goldman(t, &ions, &perm)`, `ry_ionic_state_resting_potential(&ions)`;
# - `nernst`'s `z: i32` is an i64 charge (`z as f64` is `f64_from(z)`, exact for every i32);
# - DEFAULT_PERMEABILITY and `IonicState::default()`'s values are generated consts (src/membrane_data.cyr,
#   `RY_MEMBRANE_DEFAULT_PERMEABILITY_*`, `RY_MEMBRANE_IONIC_STATE_DEFAULT_*`); `impl Default` is
#   `ry_<type>_default(&out)`, which fills a struct from them;
# - each serde type has `ry_<type>_to_json` / `ry_<type>_from_json` (and `_a`, on an allocator), src/json.cyr's
#   writers and readers.

# `1` for a finite value `> 0` (temperatures, concentrations, ratios that feed a logarithm), else 0. Mirrors
# membrane.rs's private `finite_positive`.
#must_use
#pure
#inline
fn _ry_membrane_finite_positive(x: f64): i64 {
    return _ry_is_finite(x) == 1 && x > 0.0;
}

# ── potentials ──

# The Nernst potential of one ion (mV), `E = (RT/zF) · ln([out]/[in])`: temperature (K), the ion's charge z, the
# extracellular and intracellular concentrations. 0.0 when z == 0, when the temperature or either concentration is
# not a finite value > 0, or when their ratio overflows or underflows (the potential is undefined there). Mirrors
# `membrane::nernst`.
#must_use
#pure
fn ry_nernst(temp_kelvin: f64, z, conc_out: f64, conc_in: f64): f64 {
    if (z == 0) { return 0.0; }
    if (_ry_membrane_finite_positive(temp_kelvin) == 0) { return 0.0; }
    if (_ry_membrane_finite_positive(conc_out) == 0 || _ry_membrane_finite_positive(conc_in) == 0) { return 0.0; }
    var ratio: f64 = conc_out / conc_in;
    if (_ry_membrane_finite_positive(ratio) == 0) { return 0.0; }
    var zf: f64 = f64_from(z);
    var rt: f64 = RY_R_GAS * temp_kelvin;
    var zfar: f64 = zf * RY_FARADAY;
    var k: f64 = rt / zfar;
    var l: f64 = _ry_cr_ln(ratio);
    var r: f64 = k * l * 1000.0;
    return r;
}

# Ion permeability ratios for the Goldman equation: Na+, K+ and Cl- relative permeabilities. Rust's
# `MembranePermeability`.
struct RyMembranePermeability {
    p_na: f64;
    p_k: f64;
    p_cl: f64;
}

# Ion concentrations (mM), intracellular and extracellular, of Na+, K+ and Cl-. Rust's `IonicState`.
struct RyIonicState {
    na_in: f64;
    na_out: f64;
    k_in: f64;
    k_out: f64;
    cl_in: f64;
    cl_out: f64;
}

# The Goldman-Hodgkin-Katz voltage equation for Na+, K+ and Cl- (mV), `(RT/F) · ln(num/den)` with
# `num = P_Na·[Na]out + P_K·[K]out + P_Cl·[Cl]in` and `den = P_Na·[Na]in + P_K·[K]in + P_Cl·[Cl]out`. 0.0 when the
# temperature is not a finite value > 0, or when either weighted sum or their ratio is not (a NaN or ±inf anywhere
# fails those tests, so no input needs sanitizing). Negative concentrations or permeabilities are invalid:
# ry_ionic_state_validate and ry_membrane_permeability_validate refuse them. Mirrors `membrane::goldman`.
#must_use
#pure
fn ry_goldman(temp_kelvin: f64, ions: *RyIonicState, perm: *RyMembranePermeability): f64 {
    if (_ry_membrane_finite_positive(temp_kelvin) == 0) { return 0.0; }
    var p_na: f64 = perm.p_na;
    var p_k: f64 = perm.p_k;
    var p_cl: f64 = perm.p_cl;
    var na_in: f64 = ions.na_in;
    var na_out: f64 = ions.na_out;
    var k_in: f64 = ions.k_in;
    var k_out: f64 = ions.k_out;
    var cl_in: f64 = ions.cl_in;
    var cl_out: f64 = ions.cl_out;
    var num: f64 = p_na * na_out + p_k * k_out + p_cl * cl_in;
    var den: f64 = p_na * na_in + p_k * k_in + p_cl * cl_out;
    if (_ry_membrane_finite_positive(num) == 0 || _ry_membrane_finite_positive(den) == 0) { return 0.0; }
    var ratio: f64 = num / den;
    if (_ry_membrane_finite_positive(ratio) == 0) { return 0.0; }
    var rt: f64 = RY_R_GAS * temp_kelvin;
    var k: f64 = rt / RY_FARADAY;
    var l: f64 = _ry_cr_ln(ratio);
    var r: f64 = k * l * 1000.0;
    return r;
}

# ── diffusion ──

# Fick's first law across a membrane, `J = -D · ΔC / Δx`: D (m²/s), ΔC = C(x + Δx) − C(x) (mol/m³, numerically mM),
# Δx (m); J in mol/(m²·s), positive along +x, so a positive ΔC gives a negative flux. 0.0 when the thickness is not a
# finite value > 0, when ΔC is non-finite or when the flux would overflow; a NaN, infinite or negative D is 0
# (`_ry_guard_conc`), and the zero keeps Rust's sign (−0 · ΔC). Mirrors `membrane::fick_flux`.
#must_use
#pure
fn ry_fick_flux(diffusion_coeff: f64, conc_diff: f64, thickness: f64): f64 {
    if (_ry_membrane_finite_positive(thickness) == 0 || _ry_is_finite(conc_diff) == 0) { return 0.0; }
    var d: f64 = _ry_guard_conc(diffusion_coeff);
    var nd: f64 = -d;
    var flux: f64 = nd * conc_diff / thickness;
    if (_ry_is_finite(flux) == 1) { return flux; }
    return 0.0;
}

# ── MembranePermeability ──

# The NUL-separated field names of the two serde types, in Rust's declaration order (validation, JSON).
var _RY_MEMBRANE_PERMEABILITY_FIELDS = "p_na\0p_k\0p_cl\0";
var _RY_IONIC_STATE_FIELDS = "na_in\0na_out\0k_in\0k_out\0cl_in\0cl_out\0";

# Fills *out with the default resting permeability ratios, P_K : P_Na : P_Cl = 1 : 0.04 : 0.45 (the squid giant axon
# ratios of Hodgkin & Katz 1949, J. Physiol. 108:37; RY_MEMBRANE_DEFAULT_PERMEABILITY_*). Mirrors
# `MembranePermeability::default()` (`DEFAULT_PERMEABILITY`).
fn ry_membrane_permeability_default(out: *RyMembranePermeability) {
    var p_na: f64 = RY_MEMBRANE_DEFAULT_PERMEABILITY_P_NA;
    var p_k: f64 = RY_MEMBRANE_DEFAULT_PERMEABILITY_P_K;
    var p_cl: f64 = RY_MEMBRANE_DEFAULT_PERMEABILITY_P_CL;
    out.p_na = p_na;
    out.p_k = p_k;
    out.p_cl = p_cl;
    return 0;
}

# Ok(0) when every permeability is finite and >= 0 (−0 passes); else, at the first field in declaration order that
# fails, Err(RY_ERR_NON_FINITE) for NaN or ±inf or Err(RY_ERR_INVALID_PARAMETER) below 0 ("permeability must be
# non-negative"). Mirrors `MembranePermeability::validate`.
#must_use
fn ry_membrane_permeability_validate(p: *RyMembranePermeability): Result {
    var w = p;                                   # a plain address: `p + n` would step n · 24 bytes
    var name = _RY_MEMBRANE_PERMEABILITY_FIELDS;
    var k = 0;
    while (k < 3) {
        var value: f64 = load64(w + 8 * k);
        var t, v = _ry_guard_finite(name, value);
        if (is_err_result(t) == 1) { return Err(v); }
        if (value < 0.0) {
            return Err(_ry_fail_f(RY_ERR_INVALID_PARAMETER, name, value, "permeability must be non-negative", 0, 0.0));
        }
        name = name + strlen(name) + 1;
        k = k + 1;
    }
    return Ok(0);
}

# ── IonicState ──

# Fills *out with typical mammalian neuron concentrations (RY_MEMBRANE_IONIC_STATE_DEFAULT_*: Na+ 12 / 145, K+ 155 /
# 4, Cl- 4 / 120 mM, in / out). Mirrors `IonicState::default()`.
fn ry_ionic_state_default(out: *RyIonicState) {
    var na_in: f64 = RY_MEMBRANE_IONIC_STATE_DEFAULT_NA_IN;
    var na_out: f64 = RY_MEMBRANE_IONIC_STATE_DEFAULT_NA_OUT;
    var k_in: f64 = RY_MEMBRANE_IONIC_STATE_DEFAULT_K_IN;
    var k_out: f64 = RY_MEMBRANE_IONIC_STATE_DEFAULT_K_OUT;
    var cl_in: f64 = RY_MEMBRANE_IONIC_STATE_DEFAULT_CL_IN;
    var cl_out: f64 = RY_MEMBRANE_IONIC_STATE_DEFAULT_CL_OUT;
    out.na_in = na_in;
    out.na_out = na_out;
    out.k_in = k_in;
    out.k_out = k_out;
    out.cl_in = cl_in;
    out.cl_out = cl_out;
    return 0;
}

# Ok(0) when every concentration is finite and >= 0; else the first failing field's `_ry_guard_non_negative` Err
# (RY_ERR_NON_FINITE or RY_ERR_NEGATIVE_CONCENTRATION), in declaration order. Mirrors `IonicState::validate`.
#must_use
fn ry_ionic_state_validate(p: *RyIonicState): Result {
    var w = p;                                   # a plain address: `p + n` would step n · 48 bytes
    var name = _RY_IONIC_STATE_FIELDS;
    var k = 0;
    while (k < 6) {
        var value: f64 = load64(w + 8 * k);
        var t, v = _ry_guard_non_negative(name, value);
        if (is_err_result(t) == 1) { return Err(v); }
        name = name + strlen(name) + 1;
        k = k + 1;
    }
    return Ok(0);
}

# The resting membrane potential (mV): ry_goldman at 37 °C (RY_BODY_TEMP_K = 310.15 K) with the default
# permeabilities (P_K : P_Na : P_Cl = 1 : 0.04 : 0.45). Mirrors `IonicState::resting_potential`.
#must_use
#pure
fn ry_ionic_state_resting_potential(p: *RyIonicState): f64 {
    var perm: RyMembranePermeability;
    ry_membrane_permeability_default(&perm);
    var r: f64 = ry_goldman(RY_BODY_TEMP_K, p, &perm);
    return r;
}

# ── JSON (P7: serde_json's documents) ──

# Appends MembranePermeability `p` as serde_json writes it, `{"p_na":…,"p_k":…,"p_cl":…}`, on allocator `a`: Ok(0), or
# Err(RY_ERR_OUT_OF_MEMORY) when the builder could not grow.
#must_use
fn ry_membrane_permeability_to_json_a(a, sb, p: *RyMembranePermeability): Result {
    if (_ry_jw_f64_fields(a, sb, p, 3, _RY_MEMBRANE_PERMEABILITY_FIELDS) != 0) { return Err(RY_ERR_OUT_OF_MEMORY); }
    return Ok(0);
}

# ry_membrane_permeability_to_json_a on the default allocator (a builder from str_builder_new).
#must_use
fn ry_membrane_permeability_to_json(sb, p: *RyMembranePermeability): Result {
    return ry_membrane_permeability_to_json_a(default_alloc(), sb, p);
}

# Reads a MembranePermeability from the `n`-byte document at `buf` by serde's rules (its tree on allocator `a`, which
# the caller resets): Ok(0) with *out filled, or Err(RY_ERR_DESERIALIZE).
#must_use
fn ry_membrane_permeability_from_json_a(a, buf, n, out: *RyMembranePermeability): Result {
    var w[24];
    var v = _ry_jr_parse(a, buf, n);
    if (_ry_jr_f64_fields(v, &w, 3, _RY_MEMBRANE_PERMEABILITY_FIELDS) == 0) {
        return Err(_ry_fail_text(RY_ERR_DESERIALIZE, "MembranePermeability", 20));
    }
    memcpy(out, &w, 24);
    return Ok(0);
}

# ry_membrane_permeability_from_json_a on the default allocator (the tree is never freed: for a one-off read).
#must_use
fn ry_membrane_permeability_from_json(buf, n, out: *RyMembranePermeability): Result {
    return ry_membrane_permeability_from_json_a(default_alloc(), buf, n, out);
}

# Appends IonicState `p` as serde_json writes it, `{"na_in":…,"na_out":…,"k_in":…,"k_out":…,"cl_in":…,"cl_out":…}`:
# Ok(0), or Err(RY_ERR_OUT_OF_MEMORY).
#must_use
fn ry_ionic_state_to_json_a(a, sb, p: *RyIonicState): Result {
    if (_ry_jw_f64_fields(a, sb, p, 6, _RY_IONIC_STATE_FIELDS) != 0) { return Err(RY_ERR_OUT_OF_MEMORY); }
    return Ok(0);
}

# ry_ionic_state_to_json_a on the default allocator.
#must_use
fn ry_ionic_state_to_json(sb, p: *RyIonicState): Result {
    return ry_ionic_state_to_json_a(default_alloc(), sb, p);
}

# Reads an IonicState by serde's rules: Ok(0) with *out filled, or Err(RY_ERR_DESERIALIZE).
#must_use
fn ry_ionic_state_from_json_a(a, buf, n, out: *RyIonicState): Result {
    var w[48];
    var v = _ry_jr_parse(a, buf, n);
    if (_ry_jr_f64_fields(v, &w, 6, _RY_IONIC_STATE_FIELDS) == 0) {
        return Err(_ry_fail_text(RY_ERR_DESERIALIZE, "IonicState", 10));
    }
    memcpy(out, &w, 48);
    return Ok(0);
}

# ry_ionic_state_from_json_a on the default allocator.
#must_use
fn ry_ionic_state_from_json(buf, n, out: *RyIonicState): Result {
    return ry_ionic_state_from_json_a(default_alloc(), buf, n, out);
}

# --- signal_data.cyr ---

# rasayan — signal data: the second messengers' default levels
#
# GENERATED by scripts/oracle from rasayan 1.2.0 (rust-old/). Do not edit.
# Regenerate: cargo run --release --locked --manifest-path scripts/oracle/Cargo.toml
#
# SecondMessenger::default(), from the oracle's API: one f64 const per field, as a
# round-trip decimal, checked against the `Self { … }` literal of
# `impl Default for SecondMessenger`. tests/golden/signal.tsv pins them.

# Second messenger state.
#
# All levels are normalized to 0.0-1.0 range. Resting levels are
# maintained by basal activity and decay in [`SecondMessenger::tick`].
# Rust: rasayan::signal::SecondMessenger::default()

# cAMP level (normalized 0.0-1.0).
# Rust: rasayan::signal::SecondMessenger::default().camp
const RY_SIGNAL_SECOND_MESSENGER_DEFAULT_CAMP = 0.1;

# Intracellular Ca2+ (normalized 0.0-1.0).
# Rust: rasayan::signal::SecondMessenger::default().calcium
const RY_SIGNAL_SECOND_MESSENGER_DEFAULT_CALCIUM = 0.05;

# IP3 (inositol trisphosphate, normalized 0.0-1.0).
# Rust: rasayan::signal::SecondMessenger::default().ip3
const RY_SIGNAL_SECOND_MESSENGER_DEFAULT_IP3 = 0.05;

# --- signal.cyr ---

# signal.cyr — signal transduction: receptor binding, dose-response, second messengers (Rust 1.2.0's `signal.rs`,
# transcribed).
#
# Every operation is in Rust's order: tests/golden/signal.tsv compares each function with the oracle's at ≤ 2 ulp
# where only + − × ÷ run (class B, expected 0), at 0 ulp against the corrected oracle where dose_response calls `powf`
# and a tick's relaxation `exp_m1` (class C, ADR 0003: `_ry_cr_pow`, `_ry_cr_expm1`), and bit for bit over the
# trajectory scripts (class T: runs of up to 10⁴ steps at dt 0.001 … 5 s).
#
# The Cyrius forms (ADR 0002 rows 7, 10):
# - SecondMessenger is a struct (RySecondMessenger); its methods take a pointer and update it in place:
#   `ry_second_messenger_tick(&sm, dt)`;
# - `SecondMessenger::default()`'s values are generated consts (src/signal_data.cyr,
#   `RY_SIGNAL_SECOND_MESSENGER_DEFAULT_*`), which ry_second_messenger_default(&out) fills a struct from;
# - Rust's four `tracing::trace!` events (`activate_gs`, `activate_gi`, `activate_gq`, `second_messenger_tick`) are
#   level-gated sakshi events under the target `rasayan::signal`, their fields in Rust's order;
# - SecondMessenger's serde codec is `ry_second_messenger_to_json` / `_from_json` (and `_a`, on an allocator).

# Dose-response by the Hill function (the enzyme Hill equation's math, a different context),
# `response = Emax · [L]^n / (EC50^n + [L]^n)`, computed as `Emax / (1 + (EC50/[L])^n)` (stable for very large and very
# small concentrations). A NaN, negative or infinite ligand gives 0; ec50 == 0 gives emax for any positive ligand; a
# negative or non-finite ec50 gives 0. Mirrors `signal::dose_response`.
#must_use
#pure
fn ry_dose_response(ligand: f64, emax: f64, ec50: f64, hill_n: f64): f64 {
    var frac: f64 = _ry_enzyme_hill_fraction(ligand, ec50, hill_n);
    var r: f64 = emax * frac;
    return r;
}

# Receptor occupancy (the fraction bound), `[L] / (Kd + [L])`, in [0, 1]. A NaN, negative or infinite ligand gives 0;
# kd == 0 gives 1 for any positive ligand; a negative or non-finite kd gives 0. The n = 1 case of the Hill fraction,
# written out (no `powf`). Mirrors `signal::receptor_occupancy`.
#must_use
#pure
fn ry_receptor_occupancy(ligand: f64, kd: f64): f64 {
    var l: f64 = _ry_guard_conc(ligand);
    var denom: f64 = kd + l;
    if (l > 0.0 && kd >= 0.0 && _ry_is_finite(denom) == 1) {
        var r: f64 = l / denom;
        return r;
    }
    return 0.0;
}

# ── second messengers ──

# Second-messenger levels, each normalized to [0, 1]: cAMP, intracellular Ca2+ and IP3 (inositol trisphosphate).
# Resting levels are kept by basal activity and decay in ry_second_messenger_tick. Rust's `SecondMessenger`.
struct RySecondMessenger {
    camp: f64;
    calcium: f64;
    ip3: f64;
}

# The NUL-separated field names, in Rust's declaration order (validation, JSON).
var _RY_SECOND_MESSENGER_FIELDS = "camp\0calcium\0ip3\0";

# Fills *out with the resting levels (RY_SIGNAL_SECOND_MESSENGER_DEFAULT_*: cAMP 0.1, Ca2+ 0.05, IP3 0.05). Mirrors
# `SecondMessenger::default()`.
fn ry_second_messenger_default(out: *RySecondMessenger) {
    var camp: f64 = RY_SIGNAL_SECOND_MESSENGER_DEFAULT_CAMP;
    var calcium: f64 = RY_SIGNAL_SECOND_MESSENGER_DEFAULT_CALCIUM;
    var ip3: f64 = RY_SIGNAL_SECOND_MESSENGER_DEFAULT_IP3;
    out.camp = camp;
    out.calcium = calcium;
    out.ip3 = ip3;
    return 0;
}

# Ok(0) when every level is finite and in [0, 1] (−0 included); else the first failing field's `_ry_guard_fraction`
# Err (RY_ERR_NON_FINITE or RY_ERR_INVALID_PARAMETER), in declaration order. Mirrors `SecondMessenger::validate`.
#must_use
fn ry_second_messenger_validate(p: *RySecondMessenger): Result {
    var w = p;                                   # a plain address: `p + n` would step n · 24 bytes
    var name = _RY_SECOND_MESSENGER_FIELDS;
    var k = 0;
    while (k < 3) {
        var value: f64 = load64(w + 8 * k);
        var t, v = _ry_guard_fraction(name, value);
        if (is_err_result(t) == 1) { return Err(v); }
        name = name + strlen(name) + 1;
        k = k + 1;
    }
    return Ok(0);
}

# Activates the Gs-coupled pathway (stimulatory: cAMP rises by intensity · RY_SIGNAL_ACTIVATION_GAIN). A negative,
# NaN or infinite intensity is 0; cAMP stays in [0, 1]. Mirrors `SecondMessenger::activate_gs`.
fn ry_second_messenger_activate_gs(p: *RySecondMessenger, intensity: f64) {
    var camp: f64 = p.camp;
    if (_ry_trace_on() == 1) {
        var h[24];
        var b[256];
        var e = _ry_ev(&h, &b, 256, "rasayan::signal", "activate_gs");
        _ry_ev_f(e, "intensity", intensity);
        _ry_ev_f(e, "camp_before", camp);
        _ry_trace(e);
    }
    var i: f64 = _ry_guard_conc(intensity);
    var u: f64 = _ry_guard_unit(camp);
    var x: f64 = u + i * RY_SIGNAL_ACTIVATION_GAIN;
    var r: f64 = _ry_guard_unit(x);
    p.camp = r;
    return 0;
}

# Activates the Gi-coupled pathway (inhibitory: cAMP falls by intensity · RY_SIGNAL_ACTIVATION_GAIN). A negative, NaN
# or infinite intensity is 0. cAMP does not fall below RY_SIGNAL_CAMP_FLOOR, or below its current level if that is
# already lower: inhibition never raises cAMP. Mirrors `SecondMessenger::activate_gi`.
fn ry_second_messenger_activate_gi(p: *RySecondMessenger, intensity: f64) {
    var before: f64 = p.camp;
    if (_ry_trace_on() == 1) {
        var h[24];
        var b[256];
        var e = _ry_ev(&h, &b, 256, "rasayan::signal", "activate_gi");
        _ry_ev_f(e, "intensity", intensity);
        _ry_ev_f(e, "camp_before", before);
        _ry_trace(e);
    }
    var i: f64 = _ry_guard_conc(intensity);
    var camp: f64 = _ry_guard_unit(before);
    var lowered: f64 = camp - i * RY_SIGNAL_ACTIVATION_GAIN;
    var floor: f64 = _ry_min(RY_SIGNAL_CAMP_FLOOR, camp);
    var r: f64 = _ry_max(lowered, floor);
    p.camp = r;
    return 0;
}

# Activates the Gq-coupled pathway: IP3 rises by intensity · RY_SIGNAL_ACTIVATION_GAIN (capped at 1), and Ca2+ by
# RY_SIGNAL_IP3_CA_COUPLING times that IP3 increase, so an intensity of 0 changes nothing. A negative, NaN or infinite
# intensity is 0; both levels stay in [0, 1]. Mirrors `SecondMessenger::activate_gq`.
fn ry_second_messenger_activate_gq(p: *RySecondMessenger, intensity: f64) {
    var ip3_in: f64 = p.ip3;
    var ca_in: f64 = p.calcium;
    if (_ry_trace_on() == 1) {
        var h[24];
        var b[256];
        var e = _ry_ev(&h, &b, 256, "rasayan::signal", "activate_gq");
        _ry_ev_f(e, "intensity", intensity);
        _ry_ev_f(e, "ip3_before", ip3_in);
        _ry_ev_f(e, "ca_before", ca_in);
        _ry_trace(e);
    }
    var i: f64 = _ry_guard_conc(intensity);
    var ip3_before: f64 = _ry_guard_unit(ip3_in);
    var raised: f64 = ip3_before + i * RY_SIGNAL_ACTIVATION_GAIN;
    var ip3: f64 = _ry_guard_unit(raised);
    p.ip3 = ip3;
    var ca: f64 = _ry_guard_unit(ca_in);
    var rise: f64 = ip3 - ip3_before;
    var x: f64 = ca + rise * RY_SIGNAL_IP3_CA_COUPLING;
    var r: f64 = _ry_guard_unit(x);
    p.calcium = r;
    return 0;
}

# Relaxes each level exponentially toward its resting floor over `dt` seconds, `dx/dt = -k·(x − floor)`, with the
# RY_SIGNAL_*_DECAY_RATE constants (1/s): cAMP, then IP3, then Ca2+, as Rust writes them. Exact for any dt; the levels
# stay in [0, 1]. A non-finite or non-positive dt does nothing. Mirrors `SecondMessenger::tick`.
fn ry_second_messenger_tick(p: *RySecondMessenger, dt: f64) {
    if (_ry_guard_valid_dt(dt) == 0) { return 0; }
    if (_ry_trace_on() == 1) {
        var h[24];
        var b[256];
        var e = _ry_ev(&h, &b, 256, "rasayan::signal", "second_messenger_tick");
        _ry_ev_f(e, "dt", dt);
        _ry_trace(e);
    }
    var camp: f64 = p.camp;
    var cu: f64 = _ry_guard_unit(camp);
    var c2: f64 = _ry_integrate_relax(cu, RY_SIGNAL_CAMP_FLOOR, RY_SIGNAL_CAMP_DECAY_RATE, dt);
    p.camp = c2;
    var ip3: f64 = p.ip3;
    var iu: f64 = _ry_guard_unit(ip3);
    var i2: f64 = _ry_integrate_relax(iu, RY_SIGNAL_IP3_FLOOR, RY_SIGNAL_IP3_DECAY_RATE, dt);
    p.ip3 = i2;
    var ca: f64 = p.calcium;
    var au: f64 = _ry_guard_unit(ca);
    var a2: f64 = _ry_integrate_relax(au, RY_SIGNAL_CA_FLOOR, RY_SIGNAL_CA_DECAY_RATE, dt);
    p.calcium = a2;
    return 0;
}

# The overall signaling intensity, the mean of the three levels. Mirrors `SecondMessenger::intensity`.
#must_use
#pure
fn ry_second_messenger_intensity(p: *RySecondMessenger): f64 {
    var camp: f64 = p.camp;
    var calcium: f64 = p.calcium;
    var ip3: f64 = p.ip3;
    var r: f64 = (camp + calcium + ip3) / 3.0;
    return r;
}

# ── JSON (P7: serde_json's documents) ──

# Appends SecondMessenger `p` as serde_json writes it, `{"camp":…,"calcium":…,"ip3":…}`, on allocator `a`: Ok(0), or
# Err(RY_ERR_OUT_OF_MEMORY) when the builder could not grow.
#must_use
fn ry_second_messenger_to_json_a(a, sb, p: *RySecondMessenger): Result {
    if (_ry_jw_f64_fields(a, sb, p, 3, _RY_SECOND_MESSENGER_FIELDS) != 0) { return Err(RY_ERR_OUT_OF_MEMORY); }
    return Ok(0);
}

# ry_second_messenger_to_json_a on the default allocator (a builder from str_builder_new).
#must_use
fn ry_second_messenger_to_json(sb, p: *RySecondMessenger): Result {
    return ry_second_messenger_to_json_a(default_alloc(), sb, p);
}

