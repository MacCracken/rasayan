var _RY_CR_LN_C3 = 0x3FD5555555555555;   # 0.3333333333333333
var _RY_CR_LN_C4 = 0xBFD0000000000000;   # -0.25
var _RY_CR_LN_C5 = 0x3FC999999999999A;   # 0.2
var _RY_CR_LN_C6 = 0xBFC5555555555555;   # -0.16666666666666666
var _RY_CR_LN_C7 = 0x3FC2492492492492;   # 0.14285714285714285
var _RY_CR_LN_C8 = 0xBFC0000000000000;   # -0.125

