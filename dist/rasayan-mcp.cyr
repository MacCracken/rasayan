# Fills *out with Rust's HormonalInput::default() (src/hormonal_data.cyr): no stress, serotonin 1, dark, alone, at
# rest.
fn ry_hormonal_input_default(out: *RyHormonalInput) {
    out.stress = RY_HORMONAL_HORMONAL_INPUT_DEFAULT_STRESS;
    out.serotonin = RY_HORMONAL_HORMONAL_INPUT_DEFAULT_SEROTONIN;
