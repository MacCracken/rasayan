fn ry_amino_catab_state_from_json(buf, n, out: *RyAminoCatabState): Result {
    return ry_amino_catab_state_from_json_a(default_alloc(), buf, n, out);
}

# The byte offset of AminoCatabConfig's field k (declaration order: 0–3 the first four, 4 the nested routing, 5–7
# the last three, after the routing's six words).
#must_use
#pure
fn _ry_amino_catab_config_offset(k): i64 {
    if (k < 5) { return 8 * k; }
    return 8 * (k + 5);
}

# Appends AminoCatabConfig `p` as serde_json writes it, its eight fields in declaration order with `carbon_routing` a
# nested object, on allocator `a`: Ok(0), or Err(RY_ERR_OUT_OF_MEMORY).
#must_use
fn ry_amino_catab_config_to_json_a(a, sb, p: *RyAminoCatabConfig): Result {
    var w = p;
    var name = &_RY_AMINO_CATAB_CONFIG_FIELDS;
    var e = _ry_jw_byte(a, sb, 123);
    var k = 0;
    while (k < 8) {
        var first = 0;
        if (k == 0) { first = 1; }
        e = e | _ry_jw_key(a, sb, name, first);
        if (k == 4) {
            e = e | _ry_jw_f64_fields(a, sb, w + 32, 6, &_RY_CARBON_SKELETON_OUTPUT_FIELDS);
        } else {
            var x: f64 = load64(w + _ry_amino_catab_config_offset(k));
            e = e | _ry_jw_f64(a, sb, x);
        }
        name = name + strlen(name) + 1;
        k = k + 1;
    }
    e = e | _ry_jw_byte(a, sb, 125);
    if (e != 0) { return Err(RY_ERR_OUT_OF_MEMORY); }
    return Ok(0);
}

# ry_amino_catab_config_to_json_a on the default allocator.
#must_use
fn ry_amino_catab_config_to_json(sb, p: *RyAminoCatabConfig): Result {
    return ry_amino_catab_config_to_json_a(default_alloc(), sb, p);
}

# The AminoCatabConfig at node `v` of a parsed document, by serde's rules (as ry_amino_catab_config_from_json_a reads
# it), into the 104 bytes at `w`: 1, or 0 for a refusal (what `w` holds then is unspecified). The metabolic network's
# readers call it for their nested values.
#must_use
fn _ry_amino_catab_config_from_node(v, w): i64 {
    var form = _ry_jr_form(v, 8);
    var ok = 0;
    if (form != 0) {
        ok = 1;
        var name = &_RY_AMINO_CATAB_CONFIG_FIELDS;
        var k = 0;
        while (k < 8 && ok == 1) {
            var node = _ry_jr_at(v, form, k, name);
            if (k == 4) {
                ok = _ry_jr_f64_fields(node, w + 32, 6, &_RY_CARBON_SKELETON_OUTPUT_FIELDS);
            } elif (_ry_jr_f64(node, w + _ry_amino_catab_config_offset(k)) == 0) {
                ok = 0;
            }
            name = name + strlen(name) + 1;
            k = k + 1;
        }
    }
    return ok;
}

# Reads an AminoCatabConfig from the `n`-byte document at `buf` by serde's rules (an object by field name, or an array
# of its eight fields; `carbon_routing` itself an object or an array of six), its tree on allocator `a`: Ok(0) with
# *out filled, or Err(RY_ERR_DESERIALIZE).
#must_use
fn ry_amino_catab_config_from_json_a(a, buf, n, out: *RyAminoCatabConfig): Result {
    var w[104];
    var v = _ry_jr_parse(a, buf, n);
    if (_ry_amino_catab_config_from_node(v, &w) == 0) {
        return Err(_ry_fail_text(RY_ERR_DESERIALIZE, "AminoCatabConfig", 16));
    }
    memcpy(out, &w, 104);
    return Ok(0);
}

# ry_amino_catab_config_from_json_a on the default allocator (the tree is never freed: for a one-off read).
#must_use
fn ry_amino_catab_config_from_json(buf, n, out: *RyAminoCatabConfig): Result {
    return ry_amino_catab_config_from_json_a(default_alloc(), buf, n, out);
}

