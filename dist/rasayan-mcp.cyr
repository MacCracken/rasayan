# --- mapk.cyr ---

# rasayan — src/mapk.cyr: the MAPK cascade, Ras/Raf/MEK/ERK (rust-old/src/mapk.rs)
#
# Ras and Raf are two-state switches (the inactive fraction activated at a rate `on`, deactivated first-order at
# `off`); MEK and ERK each follow the quasi-steady state of distributive dual phosphorylation (Huang & Ferrell, PNAS
# 93:10078, 1996), PP* = a² / (1 − a + a²) with a = on / (on + off), relaxed toward at rate on + off; ERK feeds back
# negatively on Ras and Raf as 1 / (1 + erk_pp · erk_feedback_strength / ERK_FEEDBACK_KI). Each tier advances by the
# exact solution of its linear ODE over the step (upstream levels held, tiers in order), so fractions stay in [0, 1]
# for any step; a tick longer than SUBSTEP_MAX_DT splits into equal sub-steps (at most MAX_SUBSTEPS).
#
# The Cyrius forms (ADR 0002 row 7): the state advances in place and the flux fills the caller's record; the
# crate-private `tick_with_raf_inhibition` (the signaling network's Akt → Raf crosstalk) is `_ry_mapk_state_tick_with
# _raf_inhibition`. Every operation is in Rust's order (P9).

# ── the types ──

# MAPK cascade activation state: each kinase level's active (phosphorylated) fraction (0.0-1.0). MEK and ERK follow
# the quasi-steady state of distributive dual phosphorylation; the mono-phosphorylated intermediates are not tracked.
struct RyMapkState {
    ras_gtp: f64;
    raf_active: f64;
    mek_pp: f64;
    erk_pp: f64;
}

# Kinetic parameters for the MAPK cascade: rates in s^-1 (Vmax per phosphorylation site), Km values as fractions
# (> 0), and the dimensionless ERK → Ras/Raf feedback strength.
struct RyMapkConfig {
    ras_activation_rate: f64;
    ras_gap_rate: f64;
    raf_vmax: f64;
    raf_km: f64;
    raf_phosphatase_rate: f64;
    mek_vmax: f64;
    mek_km: f64;
    mek_phosphatase_rate: f64;
    erk_vmax: f64;
    erk_km: f64;
    erk_phosphatase_rate: f64;
    erk_feedback_strength: f64;
}

# MAPK cascade flux for a tick: each tier's kinase-driven activation rate on · (1 − active) (fraction/s) at the start
# of its update in the tick's first sub-step; zero for an invalid dt.
struct RyMapkFlux {
    ras_activation: f64;
    raf_phosphorylation: f64;
    mek_phosphorylation: f64;
    erk_phosphorylation: f64;
}

# ── defaults ──

# Fills *out with Rust's MapkState::default() (src/mapk_data.cyr).
fn ry_mapk_state_default(out: *RyMapkState) {
    out.ras_gtp = RY_MAPK_MAPK_STATE_DEFAULT_RAS_GTP;
    out.raf_active = RY_MAPK_MAPK_STATE_DEFAULT_RAF_ACTIVE;
    out.mek_pp = RY_MAPK_MAPK_STATE_DEFAULT_MEK_PP;
    out.erk_pp = RY_MAPK_MAPK_STATE_DEFAULT_ERK_PP;
    return 0;
}

# Fills *out with Rust's MapkConfig::default() (src/mapk_data.cyr).
fn ry_mapk_config_default(out: *RyMapkConfig) {
    out.ras_activation_rate = RY_MAPK_MAPK_CONFIG_DEFAULT_RAS_ACTIVATION_RATE;
    out.ras_gap_rate = RY_MAPK_MAPK_CONFIG_DEFAULT_RAS_GAP_RATE;
    out.raf_vmax = RY_MAPK_MAPK_CONFIG_DEFAULT_RAF_VMAX;
    out.raf_km = RY_MAPK_MAPK_CONFIG_DEFAULT_RAF_KM;
    out.raf_phosphatase_rate = RY_MAPK_MAPK_CONFIG_DEFAULT_RAF_PHOSPHATASE_RATE;
    out.mek_vmax = RY_MAPK_MAPK_CONFIG_DEFAULT_MEK_VMAX;
    out.mek_km = RY_MAPK_MAPK_CONFIG_DEFAULT_MEK_KM;
    out.mek_phosphatase_rate = RY_MAPK_MAPK_CONFIG_DEFAULT_MEK_PHOSPHATASE_RATE;
    out.erk_vmax = RY_MAPK_MAPK_CONFIG_DEFAULT_ERK_VMAX;
    out.erk_km = RY_MAPK_MAPK_CONFIG_DEFAULT_ERK_KM;
    out.erk_phosphatase_rate = RY_MAPK_MAPK_CONFIG_DEFAULT_ERK_PHOSPHATASE_RATE;
    out.erk_feedback_strength = RY_MAPK_MAPK_CONFIG_DEFAULT_ERK_FEEDBACK_STRENGTH;
    return 0;
}

# Fills *out with Rust's MapkFlux::default(): every rate 0.
fn ry_mapk_flux_default(out: *RyMapkFlux) {
    out.ras_activation = 0.0;
    out.raf_phosphorylation = 0.0;
    out.mek_phosphorylation = 0.0;
    out.erk_phosphorylation = 0.0;
    return 0;
}

# ── validation ──

# Ok(0) when every fraction is finite and in [0, 1]; else the first failing one's `_ry_guard_fraction` Err, in
# declaration order. Mirrors `MapkState::validate`.
#must_use
fn ry_mapk_state_validate(p: *RyMapkState): Result {
    var w = p;                                   # a plain address: `p + n` would step n states
    var name = &_RY_MAPK_STATE_FIELDS;
    var k = 0;
    while (k < 4) {
        var value: f64 = load64(w + 8 * k);
        var t, v = _ry_guard_fraction(name, value);
        if (is_err_result(t) == 1) { return Err(v); }
        name = name + strlen(name) + 1;
        k = k + 1;
    }
    return Ok(0);
}

# Ok(0) when every parameter is finite, the rates and the feedback strength >= 0 and the three Km values > 0; else the
# first failure's Err, in declaration order (each field's own rule). Mirrors `MapkConfig::validate`.
#must_use
fn ry_mapk_config_validate(p: *RyMapkConfig): Result {
    var w = p;
    var name = &_RY_MAPK_CONFIG_FIELDS;
    var k = 0;
    while (k < 12) {
        var value: f64 = load64(w + 8 * k);
        var t = 0;
        var v = 0;
        if (k == 3 || k == 6 || k == 9) {
            t, v = _ry_guard_positive(name, value);
        } else {
            t, v = _ry_guard_non_negative(name, value);
        }
        if (is_err_result(t) == 1) { return Err(v); }
        name = name + strlen(name) + 1;
        k = k + 1;
    }
    return Ok(0);
}

# ── the cascade ──

# The doubly phosphorylated fraction at the quasi-steady state of a distributive two-site cycle with equal site
# constants: ρ² / (1 + ρ + ρ²), ρ = on / off, written a² / ((1 − a) + a²), a = on / (on + off), so off = 0 needs no
# special case. Mirrors the private `dual_phospho_steady_state`.
#must_use
#pure
fn _ry_mapk_dual_phospho_steady_state(on: f64, off: f64): f64 {
    var a: f64 = on / (on + off);
    var a2: f64 = a * a;
    var r: f64 = a2 / ((1.0 - a) + a2);
    return r;
}

# A doubly phosphorylated fraction `x` relaxed toward the steady state at rate on + off over `dt` (exact, stable for
# any dt), `x` unchanged when on + off <= 0; `unit` absorbs a 1-ulp excursion and maps an overflowed rate's NaN to 0.
# Mirrors the private `dual_phosphorylation`.
#must_use
fn _ry_mapk_dual_phosphorylation(x: f64, on: f64, off: f64, dt: f64): f64 {
    var rate: f64 = on + off;
    if (rate <= 0.0) { return x; }
    var target: f64 = _ry_mapk_dual_phospho_steady_state(on, off);
    var y: f64 = _ry_integrate_relax(x, target, rate, dt);
    var r: f64 = _ry_guard_unit(y);
    return r;
}

# One integration step of length `h` with sanitized inputs, into *out: the ERK feedback from the step's start, then
# Ras, Raf (deactivated by its phosphatase plus `raf_inhibition`), MEK and ERK in order, each from the tier above's
# value after its own update. Mirrors the private `MapkState::step`.
fn _ry_mapk_state_step(p: *RyMapkState, c: *RyMapkConfig, gf: f64, raf_inhibition: f64, h: f64, out: *RyMapkFlux) {
    var fb: f64 = (p.erk_pp * c.erk_feedback_strength) / RY_MAPK_ERK_FEEDBACK_KI;
    var feedback: f64 = 1.0 / (1.0 + fb);
    # Ras: activated by the receptor, inactivated by GAP.
    var k_ras_on: f64 = (c.ras_activation_rate * gf) * feedback;
    var v_ras_on: f64 = k_ras_on * (1.0 - p.ras_gtp);
    var ras: f64 = _ry_integrate_activate(p.ras_gtp, k_ras_on, c.ras_gap_rate, h);
    p.ras_gtp = ras;
    # Raf: phosphorylated by Ras-GTP, dephosphorylated by its phosphatase plus any external inhibition (Akt).
    var raf_mm: f64 = ry_michaelis_menten(ras, c.raf_vmax, c.raf_km);
    var k_raf_on: f64 = raf_mm * feedback;
    var v_raf_on: f64 = k_raf_on * (1.0 - p.raf_active);
    var raf_off: f64 = c.raf_phosphatase_rate + raf_inhibition;
    var raf: f64 = _ry_integrate_activate(p.raf_active, k_raf_on, raf_off, h);
    p.raf_active = raf;
    # MEK: dual phosphorylation by Raf (distributive QSS).
    var k_mek_on: f64 = ry_michaelis_menten(raf, c.mek_vmax, c.mek_km);
    var v_mek_on: f64 = k_mek_on * (1.0 - p.mek_pp);
    var mek: f64 = _ry_mapk_dual_phosphorylation(p.mek_pp, k_mek_on, c.mek_phosphatase_rate, h);
    p.mek_pp = mek;
    # ERK: dual phosphorylation by MEK-PP (distributive QSS).
    var k_erk_on: f64 = ry_michaelis_menten(mek, c.erk_vmax, c.erk_km);
    var v_erk_on: f64 = k_erk_on * (1.0 - p.erk_pp);
    var erk: f64 = _ry_mapk_dual_phosphorylation(p.erk_pp, k_erk_on, c.erk_phosphatase_rate, h);
    p.erk_pp = erk;
    out.ras_activation = v_ras_on;
    out.raf_phosphorylation = v_raf_on;
    out.mek_phosphorylation = v_mek_on;
    out.erk_phosphorylation = v_erk_on;
    return 0;
}

# ry_mapk_state_tick with an extra first-order Raf deactivation rate `raf_inhibition` (s^-1) for the tick (Akt's
# phosphorylation of Raf's inhibitory site, for the signaling network's crosstalk); a NaN, infinite or negative
# inhibition counts as 0. Mirrors the crate-private `MapkState::tick_with_raf_inhibition`.
fn _ry_mapk_state_tick_with_raf_inhibition(p: *RyMapkState, c: *RyMapkConfig, growth_factor: f64,
  raf_inhibition_in: f64, dt: f64, out: *RyMapkFlux) {
    if (_ry_guard_valid_dt(dt) == 0) {
        ry_mapk_flux_default(out);
        return 0;
    }
    var gf: f64 = _ry_guard_unit(growth_factor);
    var raf_inhibition: f64 = _ry_guard_conc(raf_inhibition_in);
    if (_ry_trace_on() == 1) {
        var hd[24];
        var b[256];
        var e = _ry_ev(&hd, &b, 256, "rasayan::mapk", "mapk_tick");
        _ry_ev_f(e, "dt", dt);
        _ry_ev_f(e, "growth_factor", gf);
        _ry_ev_f(e, "erk", p.erk_pp);
        _ry_trace(e);
    }
    if (dt <= RY_MAPK_SUBSTEP_MAX_DT) {
        _ry_mapk_state_step(p, c, gf, raf_inhibition, dt, out);
        return 0;
    }
    # ceil() of a finite ratio > 1, clamped to [1, MAX_SUBSTEPS], so the conversion is exact.
    var q: f64 = dt / RY_MAPK_SUBSTEP_MAX_DT;
    var up: f64 = f64_ceil(q);
    var top: f64 = f64_from(RY_MAPK_MAX_SUBSTEPS);
    var nc: f64 = _ry_clamp(up, 1.0, top);
    var n = _ry_f64_to_u32(nc);
    var h: f64 = dt / f64_from(n);
    _ry_mapk_state_step(p, c, gf, raf_inhibition, h, out);
    var scratch: RyMapkFlux;
    var k = 1;
    while (k < n) {
        _ry_mapk_state_step(p, c, gf, raf_inhibition, h, &scratch);
        k = k + 1;
    }
    return 0;
}

# Advances the cascade by `dt` seconds under receptor activation `growth_factor` (clamped into [0, 1], NaN as 0) and
# fills *out with the tick's flux. A non-finite or non-positive dt leaves the state untouched with a zero flux.
# Mirrors `MapkState::tick`.
fn ry_mapk_state_tick(p: *RyMapkState, c: *RyMapkConfig, growth_factor: f64, dt: f64, out: *RyMapkFlux) {
    _ry_mapk_state_tick_with_raf_inhibition(p, c, growth_factor, 0.0, dt, out);
    return 0;
}

# ── JSON (P7: serde_json's documents) ──

# Appends MapkState `p` as serde_json writes it, its four fractions in declaration order, on allocator `a`: Ok(0), or
# Err(RY_ERR_OUT_OF_MEMORY) when the builder could not grow.
#must_use
fn ry_mapk_state_to_json_a(a, sb, p: *RyMapkState): Result {
    if (_ry_jw_f64_fields(a, sb, p, 4, &_RY_MAPK_STATE_FIELDS) != 0) { return Err(RY_ERR_OUT_OF_MEMORY); }
    return Ok(0);
}

# ry_mapk_state_to_json_a on the default allocator (a builder from str_builder_new).
#must_use
fn ry_mapk_state_to_json(sb, p: *RyMapkState): Result {
    return ry_mapk_state_to_json_a(default_alloc(), sb, p);
}

# The MapkState at node `v` of a parsed document, by serde's rules, into the 32 bytes at `w`: 1, or 0 for a refusal.
# The signaling network's readers call it for its nested value.
#must_use
fn _ry_mapk_state_from_node(v, w): i64 {
    return _ry_jr_f64_fields(v, w, 4, &_RY_MAPK_STATE_FIELDS);
}

# Reads a MapkState from the `n`-byte document at `buf` by serde's rules (its tree on allocator `a`): Ok(0) with *out
# filled, or Err(RY_ERR_DESERIALIZE) with *out untouched.
#must_use
fn ry_mapk_state_from_json_a(a, buf, n, out: *RyMapkState): Result {
    var w[32];
    var v = _ry_jr_parse(a, buf, n);
    if (_ry_mapk_state_from_node(v, &w) == 0) {
        return Err(_ry_fail_text(RY_ERR_DESERIALIZE, "MapkState", 9));
    }
    memcpy(out, &w, 32);
    return Ok(0);
}

# ry_mapk_state_from_json_a on the default allocator (the tree is never freed: for a one-off read).
#must_use
fn ry_mapk_state_from_json(buf, n, out: *RyMapkState): Result {
    return ry_mapk_state_from_json_a(default_alloc(), buf, n, out);
}

# Appends MapkConfig `p` as serde_json writes it, its twelve fields in declaration order, on allocator `a`: Ok(0), or
# Err(RY_ERR_OUT_OF_MEMORY).
#must_use
fn ry_mapk_config_to_json_a(a, sb, p: *RyMapkConfig): Result {
    if (_ry_jw_f64_fields(a, sb, p, 12, &_RY_MAPK_CONFIG_FIELDS) != 0) { return Err(RY_ERR_OUT_OF_MEMORY); }
    return Ok(0);
}

# ry_mapk_config_to_json_a on the default allocator.
#must_use
fn ry_mapk_config_to_json(sb, p: *RyMapkConfig): Result {
    return ry_mapk_config_to_json_a(default_alloc(), sb, p);
}

# The MapkConfig at node `v` of a parsed document, by serde's rules, into the 96 bytes at `w`: 1, or 0 for a refusal.
#must_use
fn _ry_mapk_config_from_node(v, w): i64 {
    return _ry_jr_f64_fields(v, w, 12, &_RY_MAPK_CONFIG_FIELDS);
}

# Reads a MapkConfig from the `n`-byte document at `buf` by serde's rules (its tree on allocator `a`): Ok(0) with *out
# filled, or Err(RY_ERR_DESERIALIZE) with *out untouched.
#must_use
fn ry_mapk_config_from_json_a(a, buf, n, out: *RyMapkConfig): Result {
