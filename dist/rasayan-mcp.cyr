#must_use
fn ry_network_tick_from_json_a(a, buf, n, out: *RyNetworkTick): Result {
    var w[536];
    var v = _ry_jr_parse(a, buf, n);
    var form = _ry_jr_form(v, 2);
    var ok = 0;
    if (form != 0) {
        var name = &_RY_NETWORK_TICK_FIELDS;
        ok = _ry_network_flux_from_node(_ry_jr_at(v, form, 0, name), &w);
        name = name + strlen(name) + 1;
        if (ok == 1) {
            ok = _ry_jr_f64_fields(_ry_jr_at(v, form, 1, name), &w + _RY_NETFLUX_SIZE, 5, &_RY_NETWORK_EXCHANGE_FIELDS);
        }
    }
    if (ok == 0) { return Err(_ry_fail_text(RY_ERR_DESERIALIZE, "NetworkTick", 11)); }
    memcpy(out, &w, _RY_NETTICK_SIZE);
    return Ok(0);
}

# ry_network_tick_from_json_a on the default allocator (the tree is never freed: for a one-off read).
#must_use
fn ry_network_tick_from_json(buf, n, out: *RyNetworkTick): Result {
    return ry_network_tick_from_json_a(default_alloc(), buf, n, out);
}

