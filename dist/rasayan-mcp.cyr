# Appends NetworkTick `p` as serde_json writes it, `{"flux":{…},"exchange":{…}}`, on allocator `a`: Ok(0), or
# Err(RY_ERR_OUT_OF_MEMORY).
#must_use
fn ry_network_tick_to_json_a(a, sb, p: *RyNetworkTick): Result {
    var w = p;
    var name = &_RY_NETWORK_TICK_FIELDS;
    var e = _ry_jw_byte(a, sb, 123);
    e = e | _ry_jw_key(a, sb, name, 1);
    var t1, v1 = ry_network_flux_to_json_a(a, sb, w);
    if (is_err_result(t1) == 1) { e = 1; }
    name = name + strlen(name) + 1;
    e = e | _ry_jw_key(a, sb, name, 0);
    var t2, v2 = ry_network_exchange_to_json_a(a, sb, w + _RY_NETFLUX_SIZE);
    if (is_err_result(t2) == 1) { e = 1; }
    e = e | _ry_jw_byte(a, sb, 125);
    if (e != 0) { return Err(RY_ERR_OUT_OF_MEMORY); }
    return Ok(0);
}

