}

# The AminoCatabState at node `v` of a parsed document, by serde's rules (as ry_amino_catab_state_from_json_a reads it),
# into the 24 bytes at `w`: 1, or 0 for a refusal (what `w` holds then is unspecified). The metabolic network's readers
# call it for their nested values.
#must_use
fn _ry_amino_catab_state_from_node(v, w): i64 {
    return _ry_jr_f64_fields(v, w, 3, &_RY_AMINO_CATAB_STATE_FIELDS);
}

# Reads an AminoCatabState from the `n`-byte document at `buf` by serde's rules (its tree on allocator `a`): Ok(0) with
# *out filled, or Err(RY_ERR_DESERIALIZE).
#must_use
fn ry_amino_catab_state_from_json_a(a, buf, n, out: *RyAminoCatabState): Result {
