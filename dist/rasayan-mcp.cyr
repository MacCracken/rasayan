# Thresholds, each the last double before the result changes (bisection over bit patterns with
# MPFR's correctly rounded function): EXP_OVF the largest x with exp(x) finite, EXP_UNF the
# most negative x with exp(x) > 0 (below it exp(x) < 2^-1075 rounds to +0), EXPM1_OVF the
# largest x with expm1(x) finite, EXPM1_M1 the most negative x with expm1(x) > −1.
var _RY_CR_EXP_OVF = 0x40862E42FEFA39EF;   # 709.782712893384
var _RY_CR_EXP_UNF = 0xC0874910D52D3051;   # -745.1332191019411
var _RY_CR_EXPM1_OVF = 0x40862E42FEFA39EF;   # 709.782712893384
var _RY_CR_EXPM1_M1 = 0xC042B708872320E1;   # -37.42994775023704

# --- mathx.cyr ---

# mathx.cyr — rasayan's private correctly rounded primitives and Rust-semantics helpers (ADR 0003, port plan P4, §7.1).
#
# VENDORED from ushma's src/mathx.cyr (ushma commit 24893c9, the file's last change; the same at ushma HEAD bdbcc02),
# itself the subset of kimiya's src/mathx.cyr that ushma calls (kimiya commit 5b14c85). Provenance: kimiya -> ushma
# -> rasayan. The vendored items are the closure of rasayan's 12 roots: the correctly rounded _ry_cr_exp,
# _ry_cr_expm1, _ry_cr_ln and _ry_cr_pow and their fast and accurate entry points (_ry_cr_<f>_fast, _ry_cr_<f>_acc,
# which the dense MPFR sweep forces; scripts/oracle/cr_verify.py, M0 part 2c-3). That is 37 functions and _RY_INF,
# mechanically extracted in ushma's (kimiya's) source order with each item's own comments, proofs and error bounds,
# and byte-identical to ushma's at commit 486ee51 (ushma M0 part 2c-2b) but for the identifiers, renamed _us_ -> _ry_
# and _US_ -> _RY_. ushma's atan2 and tanh are not vendored, nor anything only they call (_us_atan_*, _us_atan2_*,
# _us_td_norm, _us_td_div, _us_frexp, _us_expm1_dd, _us_expm1_td); the exp10 named in _ry_exp_core's comment is
# kimiya's and not vendored either. The tables are src/mathx_data.cyr, generated by scripts/oracle/mathx_tables.py
# and bit-identical to ushma's (`--check-ushma`). rasayan's ADR 0003 adopts ushma's ADR 0004 (kimiya's ADR 0006).
#
# - Correctly rounded and target-independent (+ - * /, f64_sqrt and integer bit operations only, so the same bits on
#   every target): _ry_cr_exp, _ry_cr_expm1, _ry_cr_ln, _ry_cr_pow (Rust's `exp`, `exp_m1`, `ln`, `powf`; the four
#   `10_f64.powf(x)` sites are _ry_cr_pow(10.0, x), as the oracle calls glibc's pow there). Each is two-phase (Ziv: a
#   fast path with a proven error bound and a rounding test, then a triple-double accurate path). The parity harness
#   compares them at 0 ulp against the corrected oracle (tests/golden/math.cr.tsv; docs/development/port-parity.md
#   §2d).
# - Rust semantics where no Cyrius builtin has them: _ry_is_nan, _ry_is_finite, _ry_max, _ry_min, _ry_powi, rasayan's
#   own, at the end of this file (port-parity.md §0.8). ushma's mathx has equivalents (_us_is_nan, _us_is_finite,
#   _us_max, _us_min, _us_powi) with the same results; rasayan keeps the forms §0.8 specifies, one definition each.
#   _ry_clamp and _ry_f64_to_u32, which ushma's mathx has no counterpart of, follow them (test-side until M1).
# The coefficients and constants are bit patterns in typed f64 locals (never a hex `const`).

# +∞ (0x7FF0000000000000), a compile-time constant.
const _RY_INF = 1.0 / 0.0;

# The quiet NaN Rust's f64::NAN is (0x7FF8000000000000). The parity rules match any NaN.
#must_use
fn _ry_nan(): f64 {
    var n: f64 = 0x7FF8000000000000;
    return n;
}

# a + b = s + e exactly (Knuth's TwoSum).
#must_use
fn _ry_two_sum(a: f64, b: f64): (f64, f64) {
    var s: f64 = a + b;
    var bb: f64 = s - a;
    var e: f64 = (a - (s - bb)) + (b - bb);
    return (s, e);
}

# a + b = s + e exactly, for |a| ≥ |b| or a = 0 (Dekker's FastTwoSum): s = RN(a + b).
#must_use
fn _ry_fast_two_sum(a: f64, b: f64): (f64, f64) {
    var s: f64 = a + b;
    var e: f64 = b - (s - a);
    return (s, e);
}

# a·b = p + e exactly (Dekker's TwoProduct with Veltkamp's 2²⁷ + 1 split), for |a|, |b| < 2⁹⁹⁶
# and no underflow in e.
#must_use
fn _ry_two_prod(a: f64, b: f64): (f64, f64) {
    var p: f64 = a * b;
    var split: f64 = 134217729.0;
    var ca: f64 = split * a;
    var ah: f64 = ca - (ca - a);
    var al: f64 = a - ah;
    var cb: f64 = split * b;
    var bh: f64 = cb - (cb - b);
    var bl: f64 = b - bh;
    var e: f64 = (al * bl) - (((p - (ah * bh)) - (al * bh)) - (ah * bl));
    return (p, e);
}

# RO(a + b): a + b rounded to odd (of the two doubles around an inexact sum, the one with an odd last
# bit; exact sums are returned as they are). TwoSum's error e gives the side of the exact sum; an inexact
# sum is never 0, so the bit step stays in range.
#must_use
fn _ry_ro_sum(a: f64, b: f64): f64 {
    var s, e = _ry_two_sum(a, b);
    if (e == 0.0) { return s; }
    var sb = load64(&s);
    if ((sb & 1) != 0) { return s; }
    var up = 0;
    if (e > 0.0) { up = 1; }
    var pos = 0;
    if (s > 0.0) { pos = 1; }
    if (up == pos) { sb = sb + 1; } else { sb = sb - 1; }   # away from zero is the larger magnitude word
    var r: f64 = sb;
    return r;
}

# RN(a + b + c) exactly, for any three doubles without underflow in the TwoSums: Boldo and Melquiond's
# rounding-to-odd algorithm ("Emulation of FMA and correctly rounded sums", IEEE TC 2008): b + c = uh + ul
# and a + uh = th + tl exactly, then RN(th + RO(tl + ul)). (300,000 adversarial triples — ties, near-ties,
# binade edges, cancellation — agree with exact rational rounding.)
#must_use
fn _ry_rn3(a: f64, b: f64, c: f64): f64 {
    var uh, ul = _ry_two_sum(b, c);
    var th, tl = _ry_two_sum(a, uh);
    var v: f64 = _ry_ro_sum(tl, ul);
    var z: f64 = th + v;
    return z;
}

# Triple-doubles (h, m, l), normalised (|m| ≲ ulp(h), |l| ≲ ulp(m)). Every step is TwoSum or TwoProduct
# (exact) except the rounded sums of the third-order terms and the dropped products below 2^-158 of the
# result, so each operation's error is below 2^-155·max(|a|, |b|) for a sum and 2^-153·|a·b| for a
# product. The renormalising TwoSums keep the sum exact whatever the magnitudes, so a cancellation costs
# only its relative factor.
#must_use
fn _ry_td_add(a0: f64, a1: f64, a2: f64, b0: f64, b1: f64, b2: f64): (f64, f64, f64) {
    var s0, e0 = _ry_two_sum(a0, b0);
    var s1, e1 = _ry_two_sum(a1, b1);
    var s2: f64 = a2 + b2;
    var t1, f1 = _ry_two_sum(e0, s1);
    var t2: f64 = (f1 + e1) + s2;
    var h, u = _ry_two_sum(s0, t1);
    var m, l = _ry_two_sum(u, t2);
    return (h, m, l);
}

# (a0, a1, a2) + d.
#must_use
fn _ry_td_add_d(a0: f64, a1: f64, a2: f64, d: f64): (f64, f64, f64) {
    var s0, e0 = _ry_two_sum(a0, d);
    var t1, f1 = _ry_two_sum(e0, a1);
    var t2: f64 = f1 + a2;
    var h, u = _ry_two_sum(s0, t1);
    var m, l = _ry_two_sum(u, t2);
    return (h, m, l);
}

# (a0, a1, a2)·(b0, b1, b2): a0b0, a0b1, a1b0 exact (TwoProduct), the 2^-106 terms rounded, the 2^-159 ones
# (a1b2, a2b1, a2b2) dropped.
#must_use
fn _ry_td_mul(a0: f64, a1: f64, a2: f64, b0: f64, b1: f64, b2: f64): (f64, f64, f64) {
    var p0, q0 = _ry_two_prod(a0, b0);
    var p1, q1 = _ry_two_prod(a0, b1);
    var p2, q2 = _ry_two_prod(a1, b0);
    var r: f64 = ((a0 * b2) + (a1 * b1)) + (a2 * b0);
    var s1, e1 = _ry_two_sum(p1, p2);
    var s2, e2 = _ry_two_sum(q0, s1);
    var t: f64 = (((e1 + e2) + q1) + q2) + r;
    var h, u = _ry_two_sum(p0, s2);
    var m, l = _ry_two_sum(u, t);
    return (h, m, l);
}

# (a0, a1, a2)·d for a double d.
#must_use
fn _ry_td_mul_d(a0: f64, a1: f64, a2: f64, d: f64): (f64, f64, f64) {
    var p0, q0 = _ry_two_prod(a0, d);
    var p1, q1 = _ry_two_prod(a1, d);
    var r: f64 = a2 * d;
    var s, e = _ry_two_sum(q0, p1);
    var t: f64 = (e + q1) + r;
    var h, u = _ry_two_sum(p0, s);
    var m, l = _ry_two_sum(u, t);
    return (h, m, l);
}

# 2^e as a double, for −1022 ≤ e ≤ 1023.
#must_use
fn _ry_cr_pow2(e): f64 {
    var b = (e + 1023) << 52;
    var r: f64 = b;
    return r;
}

# RN(2^e·(h + m + l)) for a normalised triple-double h + m + l in [0.99, 2.01], every result range: a normal
# result is RN3 then an exact scale (2^1024 in two steps; a significand that rounds up past DBL_MAX gives
# +∞, as IEEE overflow does). A result below 2^-1022 is rounded ONCE, at the subnormal grid: with
# y = 2^(e + 1022)·(h + m + l) < 1 (each part scaled exactly), RN(1 + y) has its ulp at 2^-52, which is
# 2^-1074 after the final scale, and (RN(1 + y) − 1)·2^-1022 is exact (glibc's specialcase technique). The
# sum 1 + yh + ym + yl is rounded exactly: 1 + yh = a + b (Fast2Sum), and RN(a + b + RO(ym + yl)) =
# RN(a + b + ym + yl) because every breakpoint minus a − b is a multiple of ulp(yh), an even multiple of
# ulp(RO(ym + yl)), and rounding to odd keeps the order against those.
#must_use
fn _ry_cr_finish(e, h: f64, m: f64, l: f64): f64 {
    if (e >= 0 - 1021) {
        var z: f64 = _ry_rn3(h, m, l);
        if (e > 1023) {
            var s1: f64 = _ry_cr_pow2(e - 1);
            var o: f64 = (z * s1) * 2.0;
            return o;
        }
        var s2: f64 = _ry_cr_pow2(e);
        var y: f64 = z * s2;
        return y;
    }
    var h1, m1a = _ry_fast_two_sum(h, m);    # renormalised, so the sign tests below decide y < 1
    var m1, l1 = _ry_two_sum(m1a, l);
    var s: f64 = _ry_cr_pow2(e + 1022);
    var yh: f64 = h1 * s;
    var ym: f64 = m1 * s;
    var yl: f64 = l1 * s;
    var normal = 0;
    if (yh > 1.0) { normal = 1; }
    if (yh == 1.0) {
        if (ym > 0.0) { normal = 1; }
        if (ym == 0.0 && yl >= 0.0) { normal = 1; }
    }
    if (normal == 1) {                       # y ≥ 1: the result is at least 2^-1022
        var z2: f64 = _ry_rn3(h, m, l);
        var s3: f64 = _ry_cr_pow2(e);
        var y2: f64 = z2 * s3;
        return y2;
    }
    var a, b = _ry_fast_two_sum(1.0, yh);
    var v: f64 = _ry_ro_sum(ym, yl);
    var w: f64 = _ry_rn3(a, b, v);
    var dmin: f64 = _ry_cr_pow2(0 - 1022);
    var r: f64 = (w - 1.0) * dmin;
    return r;
}

# The fast core for e^(xh + xl), |xh| ≤ 745.2 and |xl| ≤ 2^-42: (hi, lo, E) with hi + lo = e^x/2^E within
# 2^-70. exp passes xl = 0; exp10 passes x·ln 10 as xh + xl (xl folds into the K·L2 term).
#must_use
fn _ry_exp_core(xh: f64, xl: f64): (f64, f64, i64) {
    var inv: f64 = _RY_CR_EXP_INVLN2N;
    var l1: f64 = _RY_CR_EXP_L1;
    var l2: f64 = _RY_CR_EXP_L2;
    var tt: f64 = (xh * inv) + 6755399441055744.0;   # 1.5·2^52: rounds x·512/ln 2 to an integer
    var kd: f64 = tt - 6755399441055744.0;
    var k = load64(&tt) - 0x4338000000000000;
    var ti = (k & 511) * 32;
    var e = k >>> 9;
    var rh: f64 = xh - (kd * l1);
    var s: f64 = (kd * l2) - xl;
    var r: f64 = rh - s;
    var rl: f64 = (rh - r) - s;
    var c: f64 = r + 49152.0;                         # 1.5·2^15: rounds r to a multiple of 2^-37
    var r1: f64 = c - 49152.0;
    var r2: f64 = r - r1;
    var p3: f64 = _RY_CR_EXP_P3;
    var p4: f64 = _RY_CR_EXP_P4;
    var p5: f64 = _RY_CR_EXP_P5;
    var z: f64 = r * r;                       # Estrin: the code is latency-bound, so keep chains short
    var q: f64 = (z * (0.5 + (r * p3))) + ((z * z) * (p4 + (r * p5)));
    var a: f64 = load64(&_RY_CR_EXP_T + ti);
    var b: f64 = load64(&_RY_CR_EXP_T + ti + 8);
    var p1: f64 = a * r1;
    var hi: f64 = a + p1;
    var e1: f64 = p1 - (hi - a);
    var rlq: f64 = rl + q;
    var lo: f64 = (e1 + b) + ((a * (r2 + rlq)) + (b * (r + rlq)));
    return (hi, lo, e);
}

# The fast test with bound err (absolute, on hi + lo) and the scale for any E: (1, RN(2^E·(hi + lo))) or (0, 0)
# when the test fails. Normal results scale
# exactly (2^1024 in two steps). A result that may be subnormal (E ≤ −1022 and 2^(E+1022)·(hi + lo) < 1, decided
# on hi + lo renormalised: the core's lo is not, when r1 = 0) is tested on the subnormal grid, rounding once:
# y = 2^(E+1022)·(hi + lo) (exact), 1 + y = a + b + yl with a + b = 1 + yh exactly, and the ends
# a + ((b + yl) ∓ ε') with ε' = err·2^(E+1022) + 2^-104 (|b + yl| ≤ 2^-52, so the two inner roundings are below
# 2^-104.4 at this scale, where the grid is 2^-52).
#must_use
fn _ry_exp_fin(hi: f64, lo: f64, e, err: f64): (i64, f64) {
    if (e >= 0 - 1021) {
        var u: f64 = hi + (lo - err);
        var v: f64 = hi + (lo + err);
        if (u != v) { return (0, 0.0); }
        if (e > 1023) {
            var s1: f64 = _ry_cr_pow2(e - 1);
            var o: f64 = (u * s1) * 2.0;
            return (1, o);
        }
        var s2: f64 = _ry_cr_pow2(e);
        var y: f64 = u * s2;
        return (1, y);
    }
    var s: f64 = _ry_cr_pow2(e + 1022);
    var hn: f64 = hi + lo;                   # hi + lo renormalised: lo can be up to 2^-38 when r1 = 0
    var ln: f64 = lo - (hn - hi);
    var yh: f64 = hn * s;
    if (yh > 1.0 || (yh == 1.0 && ln >= 0.0)) {   # 2^E·(hi + lo) ≥ 2^-1022: a normal result
        var u2: f64 = hi + (lo - err);
        var v2: f64 = hi + (lo + err);
        if (u2 != v2) { return (0, 0.0); }
        var s3: f64 = _ry_cr_pow2(e);
        var y2: f64 = u2 * s3;
        return (1, y2);
    }
    var yl: f64 = ln * s;
    var a, b = _ry_fast_two_sum(1.0, yh);
    var w: f64 = b + yl;
    var tiny: f64 = 0x3970000000000000;     # 2^-104
    var err2: f64 = (err * s) + tiny;
    var u3: f64 = a + (w - err2);
    var v3: f64 = a + (w + err2);
    if (u3 != v3) { return (0, 0.0); }
    var dmin: f64 = _ry_cr_pow2(0 - 1022);
    var r: f64 = (u3 - 1.0) * dmin;
    return (1, r);
}

# e^x, correctly rounded. exp(±0) = 1 (as every |x| < 2^-54: e^x is then within 2^-54 of 1, inside 1's
# rounding interval), exp(+∞) = +∞, exp(−∞) = +0, NaN for NaN; x above 709.782712893384 overflows to +∞, and
# below −745.1332191019411 (e^x < 2^-1075) rounds to +0. e^x is exact only at x = 0 (Lindemann–Weierstrass: e^x
# is transcendental for algebraic x ≠ 0), so no other argument is exact or a tie. The fast path covers
# 2^-54 ≤ |x| ≤ 708 (normal results, one scale), inline; the rest goes through _ry_cr_exp_fast.
#must_use
fn _ry_cr_exp(x: f64): f64 {
    var ax = load64(&x) & 0x7FFFFFFFFFFFFFFF;
    # |x| < 2^-54, |x| > 708 or NaN, in one compare: ax − bits(2^-54) is above bits(708) − bits(2^-54) as an
    # unsigned word (the sign flip makes the signed compare an unsigned one) exactly then.
    if (((ax - 0x3C90000000000000) ^ 0x8000000000000000) > 0x83F6200000000000) {
        var w, okw = _ry_cr_exp_fast(x);
        if (okw == 1) { return w; }
        var zw: f64 = _ry_cr_exp_acc(x);
        return zw;
    }
    var inv: f64 = _RY_CR_EXP_INVLN2N;
    var l1: f64 = _RY_CR_EXP_L1;
    var l2: f64 = _RY_CR_EXP_L2;
    var tt: f64 = (x * inv) + 6755399441055744.0;
    var kd: f64 = tt - 6755399441055744.0;
    var k = load64(&tt) - 0x4338000000000000;
    var ti = (k & 511) * 32;
    var e = k >>> 9;
    var rh: f64 = x - (kd * l1);
    var s: f64 = kd * l2;
    var r: f64 = rh - s;
    var rl: f64 = (rh - r) - s;
    var c: f64 = r + 49152.0;
    var r1: f64 = c - 49152.0;
    var r2: f64 = r - r1;
    var p3: f64 = _RY_CR_EXP_P3;
    var p4: f64 = _RY_CR_EXP_P4;
    var p5: f64 = _RY_CR_EXP_P5;
    var z: f64 = r * r;                       # Estrin: the code is latency-bound, so keep chains short
    var q: f64 = (z * (0.5 + (r * p3))) + ((z * z) * (p4 + (r * p5)));
    var a: f64 = load64(&_RY_CR_EXP_T + ti);
    var b: f64 = load64(&_RY_CR_EXP_T + ti + 8);
    var p1: f64 = a * r1;
    var hi: f64 = a + p1;
    var e1: f64 = p1 - (hi - a);
    var rlq: f64 = rl + q;
    var lo: f64 = (e1 + b) + ((a * (r2 + rlq)) + (b * (r + rlq)));
    var err: f64 = 0x3BA0000000000000;      # 2^-69
    var u: f64 = hi + (lo - err);
    var v: f64 = hi + (lo + err);
    if (u == v) {
        var sb = (e + 1023) << 52;
        var sc: f64 = sb;
        var y: f64 = u * sc;
        return y;
    }
    var za: f64 = _ry_cr_exp_acc(x);
    return za;
}

# The fast path alone, for every x: (RN(e^x), 1), or (0, 0) when the rounding test fails and the accurate path
# must decide. NaN, the tiny end, overflow and underflow first, then the fast core with the general finish
# (708 < x: E up to 1024; x < −708: subnormal results). For 2^-54 ≤ |x| ≤ 708 _ry_exp_core and _ry_exp_fin
# perform exactly the operations of _ry_cr_exp's inline path (E ≥ −1022 there, with hi > 1 at E = −1022), so
# this gives its result and its test.
#must_use
fn _ry_cr_exp_fast(x: f64): (f64, i64) {
    if (x != x) { return (x, 1); }
    var ax = load64(&x) & 0x7FFFFFFFFFFFFFFF;
    if (ax < 0x3C90000000000000) { return (1.0, 1); }
    var ovf: f64 = _RY_CR_EXP_OVF;
    var unf: f64 = _RY_CR_EXP_UNF;
    if (x > ovf) {
        var inf: f64 = _RY_INF;
        return (inf, 1);
    }
    if (x < unf) { return (0.0, 1); }
    var hi, lo, e = _ry_exp_core(x, 0.0);
    var err: f64 = 0x3BA0000000000000;      # 2^-69
    var ok, y = _ry_exp_fin(hi, lo, e, err);
    return (y, ok);
}

# The accurate core: e^(y0 + y1 + y2) = 2^E·(h + m + l), (h, m, l) stored at out[0..2], E returned. The same
# K as the fast path; r = y − K·(L1 + L2 + L3 + L4) as a triple-double (K·L1 exact, K·L2 and K·L3
# TwoProducts, K·L4 rounded: below 2^-186 of error); e^r − 1 by Horner in triple-double to r^11/11!
# (truncation 2^-152); T_j = A + B + C + D renormalised (2^-159); h + m + l = T_j + T_j·(e^r − 1). Measured
# relative error 2^-155 against 400-bit MPFR.
#must_use
fn _ry_exp_acc_core(y0: f64, y1: f64, y2: f64, out): i64 {
    var inv: f64 = _RY_CR_EXP_INVLN2N;
    var l1: f64 = _RY_CR_EXP_L1;
    var l2: f64 = _RY_CR_EXP_L2;
    var l3: f64 = _RY_CR_EXP_L3;
    var l4: f64 = _RY_CR_EXP_L4;
    var tt: f64 = (y0 * inv) + 6755399441055744.0;
    var kd: f64 = tt - 6755399441055744.0;
    var k = load64(&tt) - 0x4338000000000000;
    var ti = (k & 511) * 32;
    var e = k >>> 9;
    var rh: f64 = y0 - (kd * l1);
    var a2, a2e = _ry_two_prod(kd, l2);
    var a3, a3e = _ry_two_prod(kd, l3);
    var a4: f64 = kd * l4;
    var ra0, ra1, ra2 = _ry_td_add_d(rh, 0.0, 0.0, -a2);
    var rb0, rb1, rb2 = _ry_td_add_d(ra0, ra1, ra2, y1);
    var rc0, rc1, rc2 = _ry_td_add_d(rb0, rb1, rb2, -a2e);
    var rd0, rd1, rd2 = _ry_td_add_d(rc0, rc1, rc2, -a3);
    var re0, re1, re2 = _ry_td_add_d(rd0, rd1, rd2, y2);
    var a34: f64 = a3e + a4;
    var r0, r1, r2 = _ry_td_add_d(re0, re1, re2, -a34);
    var sh: f64 = load64(&_RY_CR_EXP_ACC + 216);    # 1/11! (index 3·(11 − 2))
    var sm: f64 = load64(&_RY_CR_EXP_ACC + 224);
    var sl: f64 = load64(&_RY_CR_EXP_ACC + 232);
    var n = 10;
    while (n >= 2) {
        var th, tm, tl = _ry_td_mul(r0, r1, r2, sh, sm, sl);
        var off = (n - 2) * 24;
        var ch: f64 = load64(&_RY_CR_EXP_ACC + off);
        var cm: f64 = load64(&_RY_CR_EXP_ACC + off + 8);
        var cl: f64 = load64(&_RY_CR_EXP_ACC + off + 16);
        var uh, um, ul = _ry_td_add(ch, cm, cl, th, tm, tl);
        sh = uh;
        sm = um;
        sl = ul;
        n = n - 1;
    }
    var vh, vm, vl = _ry_td_mul(r0, r1, r2, sh, sm, sl);
    var wh, wm, wl = _ry_td_add_d(vh, vm, vl, 1.0);
    var ph, pm, pl = _ry_td_mul(r0, r1, r2, wh, wm, wl);     # e^r − 1
    var ta: f64 = load64(&_RY_CR_EXP_T + ti);
    var tb: f64 = load64(&_RY_CR_EXP_T + ti + 8);
    var tc: f64 = load64(&_RY_CR_EXP_T + ti + 16);
    var td: f64 = load64(&_RY_CR_EXP_T + ti + 24);
    var t0, t1a = _ry_fast_two_sum(ta, tb);
    var t1, t2a = _ry_fast_two_sum(t1a, tc);
    var t2: f64 = t2a + td;
    var qh, qm, ql = _ry_td_mul(t0, t1, t2, ph, pm, pl);
    var zh, zm, zl = _ry_td_add(t0, t1, t2, qh, qm, ql);
    store64(out, zh);
    store64(out + 8, zm);
    store64(out + 16, zl);
    return e;
}

# e^x for 2^-54 ≤ |x| < 2^-30, where Lefèvre–Muller's bound is 2^-158 (e^x is then 1 + x + x²/2 + …, and
# 1 + x is a short exact number): 1 + x = a + b exactly, q = x²/2 + x³/6 + x⁴/24 + x⁵/120 as a double-double
# to 2^-165 absolute (x² and x³ by TwoProduct, x³/6 by a corrected division; x⁶/720 < 2^-189 dropped), and
# RN(a + b + RO(qh + ql)) by _ry_rn3 (the rounding-to-odd argument of _ry_cr_finish: ulp(x) is an even
# multiple of ulp(q)).
#must_use
fn _ry_exp_tiny_acc(x: f64): f64 {
    var p, pe = _ry_two_prod(x, x);
    var a, ae = _ry_two_prod(x, p);
    var x3l: f64 = ae + (x * pe);
    var d3h: f64 = a / 6.0;
    var pp, pe2 = _ry_two_prod(d3h, 6.0);
    var d3l: f64 = (((a - pp) - pe2) + x3l) / 6.0;
    var ax: f64 = a * x;
    var x4: f64 = ax / 24.0;
    var x5: f64 = (ax * x) / 120.0;
    var hp: f64 = p * 0.5;
    var t, te = _ry_two_sum(hp, d3h);
    var lo: f64 = ((((pe * 0.5) + te) + d3l) + x4) + x5;
    var qh, ql = _ry_fast_two_sum(t, lo);
    var a1, b1 = _ry_fast_two_sum(1.0, x);
    var v: f64 = _ry_ro_sum(qh, ql);
    var r: f64 = _ry_rn3(a1, b1, v);
    return r;
}

# e^x by the accurate path alone, for every x (the fast path's fallback, and a test hook).
#must_use
fn _ry_cr_exp_acc(x: f64): f64 {
    if (x != x) { return x; }
    var ax = load64(&x) & 0x7FFFFFFFFFFFFFFF;
    if (ax < 0x3C90000000000000) { return 1.0; }
    var ovf: f64 = _RY_CR_EXP_OVF;
    var unf: f64 = _RY_CR_EXP_UNF;
    if (x > ovf) { return _RY_INF; }
    if (x < unf) { return 0.0; }
    if (ax < 0x3E10000000000000) {              # |x| < 2^-30
        var t: f64 = _ry_exp_tiny_acc(x);
        return t;
    }
    var buf: f64[3];
    var e = _ry_exp_acc_core(x, 0.0, 0.0, &buf);
    var r: f64 = _ry_cr_finish(e, buf[0], buf[1], buf[2]);
    return r;
}

# expm1(x) = e^x − 1, correctly rounded. ±0 → ±0 and |x| < 2^-53 → x (x²/2 is then below half an ulp of x,
# on the side that keeps x), +∞ → +∞, −∞ → −1, NaN for NaN; x above 709.782712893384 overflows, below
# −37.42994775023704 (e^x < 2^-54) rounds to −1.
#must_use
fn _ry_cr_expm1(x: f64): f64 {
    var y, ok = _ry_cr_expm1_fast(x);
    if (ok == 1) { return y; }
    var z: f64 = _ry_cr_expm1_acc(x);
    return z;
}

# The fast path alone: (its result, 1), or (0, 0) when its test fails or x > 708 (left to the accurate path).
#must_use
fn _ry_cr_expm1_fast(x: f64): (f64, i64) {
    var ax = load64(&x) & 0x7FFFFFFFFFFFFFFF;
    if (ax < 0x3F90000000000000) {               # |x| < 2^-6
        if (ax < 0x3CA0000000000000) { return (x, 1); }   # |x| < 2^-53, ±0, subnormals
        var p: f64 = x * x;                      # x² = p + pe exactly (Dekker, inline)
        var cx: f64 = 134217729.0 * x;
        var x1: f64 = cx - (cx - x);
        var x2: f64 = x - x1;
        var pe: f64 = (((x1 * x1) - p) + (2.0 * (x1 * x2))) + (x2 * x2);
        var k3: f64 = _RY_CR_EXPM1_Q3;
        var k4: f64 = _RY_CR_EXPM1_Q4;
        var k5: f64 = _RY_CR_EXPM1_Q5;
        var k6: f64 = _RY_CR_EXPM1_Q6;
        var k7: f64 = _RY_CR_EXPM1_Q7;
        var k8: f64 = _RY_CR_EXPM1_Q8;
        var k9: f64 = _RY_CR_EXPM1_Q9;
        var s: f64 = ((k3 + (x * k4)) + (p * (k5 + (x * k6)))) + ((p * p) * ((k7 + (x * k8)) + (p * k9)));
        var x3: f64 = (x * p) * s;
        var hp: f64 = p * 0.5;
        var hs: f64 = x + hp;
        var ht: f64 = hp - (hs - x);
        var lo: f64 = (ht + (pe * 0.5)) + x3;
        var ex3: f64 = f64_abs(x3);
        var exa: f64 = f64_abs(x);
        var c49: f64 = 0x3CE0000000000000;      # 2^-49
        var c100: f64 = 0x39B0000000000000;     # 2^-100
        var err: f64 = (ex3 * c49) + (exa * c100);
        var u: f64 = hs + (lo - err);
        var v: f64 = hs + (lo + err);
        if (u == v) { return (u, 1); }
        return (0.0, 0);
    }
    var m1b = _RY_CR_EXPM1_M1 & 0x7FFFFFFFFFFFFFFF;
    if (ax > m1b) {                              # |x| > 37.42994775023704
        if (x < 0.0) { return (-1.0, 1); }       # x < EXPM1_M1 (−∞ included): e^x < 2^-54
        if (ax > 0x4086200000000000) {           # x > 708, +∞, NaN: left to the accurate path (which returns
            return (0.0, 0);                     # the specials at once)
        }
    }
    var hi, lo2, e = _ry_exp_core(x, 0.0);
    var hh: f64 = 0.0;
    var ll: f64 = lo2;
    var sc: f64 = 1.0;
    if (e == 0) {
        hh = hi - 1.0;                           # exact: hi in [0.9993, 1.9987]
    } else {
        sc = _ry_cr_pow2(e);
        var hsc: f64 = hi * sc;
        if (e > 0) {
            hh = hsc - 1.0;
            var t1: f64 = -1.0 - (hh - hsc);
            ll = t1 + (lo2 * sc);
        } else {
            hh = -1.0 + hsc;
            var t2: f64 = hsc - (hh + 1.0);
            ll = t2 + (lo2 * sc);
        }
    }
    var err2: f64 = 0x3BA0000000000000;      # 2^-69
    var errs: f64 = err2 * sc;
    var u2: f64 = hh + (ll - errs);
    var v2: f64 = hh + (ll + errs);
    if (u2 == v2) { return (u2, 1); }
    return (0.0, 0);
}

# expm1 by the accurate path alone. |x| < 2^-6: x + x²/2 + … + x^17/17! by Horner in triple-double on the
# exact x (truncation below 2^-154 of x; measured 2^-155). Otherwise e^x from exp's accurate core, scaled,
# minus 1 in triple-double (|expm1(x)| ≥ 0.0155: at most 6.1 bits of cancellation; measured 2^-152); for
# E ≥ 120 the −1 is below 2^-114 of e^x, inside exp's own worst-case distance (Lefèvre–Muller: 2^-113 for
# |x| ≥ 2^-30), so it cannot move the rounding and expm1 rounds as exp does.
#must_use
fn _ry_cr_expm1_acc(x: f64): f64 {
    if (x != x) { return x; }
    var ax = load64(&x) & 0x7FFFFFFFFFFFFFFF;
    if (ax < 0x3CA0000000000000) { return x; }
    var ovf: f64 = _RY_CR_EXPM1_OVF;
    var m1: f64 = _RY_CR_EXPM1_M1;
    if (x > ovf) { return _RY_INF; }
    if (x < m1) { return -1.0; }
    if (ax < 0x3F90000000000000) {
        var sh: f64 = load64(&_RY_CR_EXP_ACC + 360);   # 1/17! (index 3·(17 − 2))
        var sm: f64 = load64(&_RY_CR_EXP_ACC + 368);
        var sl: f64 = load64(&_RY_CR_EXP_ACC + 376);
        var n = 16;
        while (n >= 2) {
            var th, tm, tl = _ry_td_mul_d(sh, sm, sl, x);
            var off = (n - 2) * 24;
            var ch: f64 = load64(&_RY_CR_EXP_ACC + off);
            var cm: f64 = load64(&_RY_CR_EXP_ACC + off + 8);
            var cl: f64 = load64(&_RY_CR_EXP_ACC + off + 16);
            var uh, um, ul = _ry_td_add(ch, cm, cl, th, tm, tl);
            sh = uh;
            sm = um;
            sl = ul;
            n = n - 1;
        }
        var vh, vm, vl = _ry_td_mul_d(sh, sm, sl, x);
        var wh, wm, wl = _ry_td_add_d(vh, vm, vl, 1.0);
        var ph, pm, pl = _ry_td_mul_d(wh, wm, wl, x);
        var r: f64 = _ry_rn3(ph, pm, pl);
        return r;
    }
    var buf: f64[3];
    var e = _ry_exp_acc_core(x, 0.0, 0.0, &buf);
    if (e >= 120) {
        var big: f64 = _ry_cr_finish(e, buf[0], buf[1], buf[2]);
        return big;
    }
    var sc: f64 = _ry_cr_pow2(e);
    var bh: f64 = buf[0] * sc;
    var bm: f64 = buf[1] * sc;
    var bl: f64 = buf[2] * sc;
    var dh, dm, dl = _ry_td_add_d(bh, bm, bl, -1.0);
    var r2: f64 = _ry_rn3(dh, dm, dl);
    return r2;
}

# The ln fast core for the bits ui of a positive normal x (ebias −54 for a subnormal pre-scaled by 2^54):
# (hi, lo, err) with |hi + lo − ln x| < err minus the test's own rounding (the bound above).
#must_use
fn _ry_ln_core(ui, ebias): (f64, f64, f64) {
    var t = ui - 0x3FE7FC0000000000;
    var e0 = t >>> 52;
    var ti = ((t >> 43) & 511) * 32;
    var mb = ui - (e0 << 52);
    var m: f64 = mb;
    var mhb = mb & 0xFFFFFFFFF0000000;
    var mh: f64 = mhb;
    var ml: f64 = m - mh;
    var c: f64 = load64(&_RY_CR_LN_T + ti);
    var lh: f64 = load64(&_RY_CR_LN_T + ti + 8);
    var lm: f64 = load64(&_RY_CR_LN_T + ti + 16);
    var r: f64 = ((mh * c) - 1.0) + (ml * c);
    var cc: f64 = r * 134217729.0;
    var ra: f64 = cc - (cc - r);
    var rb: f64 = r - ra;
    var t1: f64 = -0.5 * (ra * ra);             # −ra²/2, exact
    var nrb: f64 = -rb;
    var t2: f64 = nrb * (ra + (0.5 * rb));
    var c3: f64 = _RY_CR_LN_C3;
    var c4: f64 = _RY_CR_LN_C4;
    var c5: f64 = _RY_CR_LN_C5;
    var c6: f64 = _RY_CR_LN_C6;
    var c7: f64 = _RY_CR_LN_C7;
    var c8: f64 = _RY_CR_LN_C8;
    var z: f64 = r * r;
    var pz: f64 = ((c3 + (r * c4)) + (z * (c5 + (r * c6)))) + ((z * z) * (c7 + (r * c8)));   # Estrin
    var p: f64 = (z * r) * pz;
    var e = e0 + ebias;
    var ef: f64 = f64_from(e);
    var ln2h: f64 = _RY_CR_LN_LN2H;
    var ln2m: f64 = _RY_CR_LN_LN2M;
    var a: f64 = ef * ln2h;                      # exact: LN2H has 42 bits, |E| < 2^11
    var s0: f64 = a + lh;
    var d0: f64 = lh - (s0 - a);
    var s1: f64 = s0 + r;
    var d1: f64 = r - (s1 - s0);
    var s2: f64 = s1 + t1;
    var d2: f64 = t1 - (s2 - s1);
    var lo: f64 = (((ef * ln2m) + lm) + (t2 + p)) + ((d0 + d1) + d2);   # short chains (latency)
    var ap: f64 = f64_abs(p);
    var ah: f64 = f64_abs(s2);
    var ae: f64 = f64_abs(ef);
    var k49: f64 = 0x3CE0000000000000;          # 2^-49
    var k83: f64 = 0x3AC0000000000000;          # 2^-83
    var k93: f64 = 0x3A20000000000000;          # 2^-93
    var err: f64 = ((ap * k49) + (ah * k83)) + (ae * k93);
    return (s2, lo, err);
}

# ln(x), correctly rounded. ln(1) = +0, ln(±0) = −∞, ln(+∞) = +∞, NaN for NaN and x < 0 (−∞ included).
#must_use
fn _ry_cr_ln(x: f64): f64 {
    var ui = load64(&x);
    # x ≤ 0 (the sign bit), subnormal, ∞ or NaN: ui − bits(DBL_MIN) is at least bits(∞) − bits(DBL_MIN) as an
    # unsigned word (the unsigned range test of _ry_cr_exp).
    if (((ui - 0x0010000000000000) ^ 0x8000000000000000) >= 0xFFE0000000000000) {
        var w, okw = _ry_cr_ln_fast(x);
        if (okw == 1) { return w; }
        var zw: f64 = _ry_cr_ln_acc(x);
        return zw;
    }
    # _ry_ln_core's body, inline (a call and its three-value return cost about 4 ns here).
    var t = ui - 0x3FE7FC0000000000;
    var e0 = t >>> 52;
    var ti = ((t >> 43) & 511) * 32;
    var mb = ui - (e0 << 52);
    var m: f64 = mb;
    var mhb = mb & 0xFFFFFFFFF0000000;
    var mh: f64 = mhb;
    var ml: f64 = m - mh;
    var c: f64 = load64(&_RY_CR_LN_T + ti);
    var lh: f64 = load64(&_RY_CR_LN_T + ti + 8);
    var lm: f64 = load64(&_RY_CR_LN_T + ti + 16);
    var r: f64 = ((mh * c) - 1.0) + (ml * c);
    var cc: f64 = r * 134217729.0;
    var ra: f64 = cc - (cc - r);
    var rb: f64 = r - ra;
    var t1: f64 = -0.5 * (ra * ra);             # −ra²/2, exact
    var nrb: f64 = -rb;
    var t2: f64 = nrb * (ra + (0.5 * rb));
    var c3: f64 = _RY_CR_LN_C3;
    var c4: f64 = _RY_CR_LN_C4;
    var c5: f64 = _RY_CR_LN_C5;
    var c6: f64 = _RY_CR_LN_C6;
    var c7: f64 = _RY_CR_LN_C7;
    var c8: f64 = _RY_CR_LN_C8;
    var z: f64 = r * r;
    var pz: f64 = ((c3 + (r * c4)) + (z * (c5 + (r * c6)))) + ((z * z) * (c7 + (r * c8)));   # Estrin
    var p: f64 = (z * r) * pz;
    var e = e0;
    var ef: f64 = f64_from(e);
    var ln2h: f64 = _RY_CR_LN_LN2H;
    var ln2m: f64 = _RY_CR_LN_LN2M;
    var a: f64 = ef * ln2h;                      # exact: LN2H has 42 bits, |E| < 2^11
    var s0: f64 = a + lh;
    var d0: f64 = lh - (s0 - a);
    var s1: f64 = s0 + r;
    var d1: f64 = r - (s1 - s0);
    var s2: f64 = s1 + t1;
    var d2: f64 = t1 - (s2 - s1);
    var lo: f64 = (((ef * ln2m) + lm) + (t2 + p)) + ((d0 + d1) + d2);   # short chains (latency)
    var ap: f64 = f64_abs(p);
    var ah: f64 = f64_abs(s2);
    var ae: f64 = f64_abs(ef);
    var k49: f64 = 0x3CE0000000000000;          # 2^-49
    var k83: f64 = 0x3AC0000000000000;          # 2^-83
    var k93: f64 = 0x3A20000000000000;          # 2^-93
    var err: f64 = ((ap * k49) + (ah * k83)) + (ae * k93);
    var u: f64 = s2 + (lo - err);
    var v: f64 = s2 + (lo + err);
    if (u == v) { return u; }
    var za: f64 = _ry_cr_ln_acc(x);
    return za;
}

# The fast path alone, for every x (as _ry_cr_exp_fast): the specials, a subnormal x scaled exactly by 2^54,
# then the core and its test, the operations of _ry_cr_ln's inline path.
#must_use
fn _ry_cr_ln_fast(x: f64): (f64, i64) {
    var ui = load64(&x);
    var eb = 0;
    if (((ui - 0x0010000000000000) ^ 0x8000000000000000) >= 0xFFE0000000000000) {
        if (x != x) { return (x, 1); }
        if (x == 0.0) {
            var m1: f64 = -1.0;
            var ninf: f64 = m1 / 0.0;
            return (ninf, 1);
        }
        if (x < 0.0) {
            var nan: f64 = _ry_nan();           # the same quiet NaN on every target
            return (nan, 1);
        }
        if (x == _RY_INF) { return (x, 1); }
        var p54: f64 = 0x4350000000000000;      # 2^54
        var xs: f64 = x * p54;
        ui = load64(&xs);
        eb = 0 - 54;
    }
    var hi, lo, err = _ry_ln_core(ui, eb);
    var u: f64 = hi + (lo - err);
    var v: f64 = hi + (lo + err);
    if (u == v) { return (u, 1); }
    return (0.0, 0);
}

# The accurate ln of a positive finite x ≠ 1 as a triple-double at out[0..2]: the fast path's E, j and the
# exact r; log1p(r) by Horner in triple-double on the exact r to r^16/16 (truncation 2^-144·|r|);
# E·ln 2 = E·LN2H (exact) + E·LN2M (TwoProduct) + E·LN2L (rounded, 2^-138); then E·ln2 + L_j + log1p(r)
# with at most 1.3 bits of cancellation. Measured relative error 2^-150.
fn _ry_ln_acc_td(x: f64, out) {
    var ui = load64(&x);
    var eb = 0;
    if (ui < 0x0010000000000000) {
        var p54: f64 = 0x4350000000000000;
        var xs: f64 = x * p54;
        ui = load64(&xs);
        eb = 0 - 54;
    }
    var t = ui - 0x3FE7FC0000000000;
    var e0 = t >>> 52;
    var ti = ((t >> 43) & 511) * 32;
    var mb = ui - (e0 << 52);
    var m: f64 = mb;
    var mhb = mb & 0xFFFFFFFFF0000000;
    var mh: f64 = mhb;
    var ml: f64 = m - mh;
    var c: f64 = load64(&_RY_CR_LN_T + ti);
    var r: f64 = ((mh * c) - 1.0) + (ml * c);
    var sh: f64 = load64(&_RY_CR_LN_ACC + 336);     # −1/16 (index 3·(16 − 2))
    var sm: f64 = load64(&_RY_CR_LN_ACC + 344);
    var sl: f64 = load64(&_RY_CR_LN_ACC + 352);
    var n = 15;
    while (n >= 2) {
        var th, tm, tl = _ry_td_mul_d(sh, sm, sl, r);
        var off = (n - 2) * 24;
        var ch: f64 = load64(&_RY_CR_LN_ACC + off);
        var cm: f64 = load64(&_RY_CR_LN_ACC + off + 8);
        var cl: f64 = load64(&_RY_CR_LN_ACC + off + 16);
        var uh, um, ul = _ry_td_add(ch, cm, cl, th, tm, tl);
        sh = uh;
        sm = um;
        sl = ul;
        n = n - 1;
    }
    var vh, vm, vl = _ry_td_mul_d(sh, sm, sl, r);
    var wh, wm, wl = _ry_td_add_d(vh, vm, vl, 1.0);
    var ph, pm, pl = _ry_td_mul_d(wh, wm, wl, r);       # log1p(r)
    var lh: f64 = load64(&_RY_CR_LN_T + ti + 8);
    var lm: f64 = load64(&_RY_CR_LN_T + ti + 16);
    var ll: f64 = load64(&_RY_CR_LN_T + ti + 24);
    var ef: f64 = f64_from(e0 + eb);
    var ln2h: f64 = _RY_CR_LN_LN2H;
    var ln2m: f64 = _RY_CR_LN_LN2M;
    var ln2l: f64 = _RY_CR_LN_LN2L;
    var a0: f64 = ef * ln2h;
    var a1, a1e = _ry_two_prod(ef, ln2m);
    var a2: f64 = ef * ln2l;
    var h0, u0 = _ry_fast_two_sum(a0, a1);
    var a12: f64 = a1e + a2;
    var m0, l0 = _ry_two_sum(u0, a12);
    var bh, bm, bl = _ry_td_add(h0, m0, l0, lh, lm, ll);
    var zh, zm, zl = _ry_td_add(bh, bm, bl, ph, pm, pl);
    store64(out, zh);
    store64(out + 8, zm);
    store64(out + 16, zl);
}

# ln by the accurate path alone, for every x.
#must_use
fn _ry_cr_ln_acc(x: f64): f64 {
    if (x != x) { return x; }
    if (x == 0.0) {
        var m1: f64 = -1.0;
        var ninf: f64 = m1 / 0.0;
        return ninf;
    }
    if (x < 0.0) {
        var nan: f64 = _ry_nan();               # the same quiet NaN on every target
        return nan;
    }
    if (x == _RY_INF) { return x; }
    if (x == 1.0) { return 0.0; }
    var buf: f64[3];
    _ry_ln_acc_td(x, &buf);
    var r: f64 = _ry_rn3(buf[0], buf[1], buf[2]);
    return r;
}

# (1 if y is an integer, 1 if y is an odd integer) for a finite y ≠ 0: y = M·2^(f − 1075) with the 53-bit
# significand M; integer when no set bit of M lies below 2^(1075 − f).
#must_use
fn _ry_pow_yclass(y: f64): (i64, i64) {
    var uy = load64(&y) & 0x7FFFFFFFFFFFFFFF;
    var f = uy >> 52;
    var m = (uy & 0x000FFFFFFFFFFFFF) | 0x0010000000000000;
    if (f >= 1075) {
        if (f == 1075) { return (1, m & 1); }
        return (1, 0);                           # |y| ≥ 2^53: even
    }
    if (f < 1023) { return (0, 0); }             # 0 < |y| < 1
    var sh = 1075 - f;
    if ((m & ((1 << sh) - 1)) != 0) { return (0, 0); }
    return (1, (m >> sh) & 1);
}

# RN(mm·2^s) for an integer 1 ≤ mm < 2^62 and an integer |s| < 2^40, by integer rounding: ties to even,
# subnormal results on the 2^-1074 grid, +∞ past DBL_MAX, +0 below half of 2^-1074. Exact, so it rounds exact
# results and exact midpoints right.
#must_use
fn _ry_cr_from_int(mm, s): f64 {
    var b = 0;
    var t = mm;
    while (t != 0) {
        t = t >> 1;
        b = b + 1;
    }
    var top = s + b - 1;                         # the exponent of mm·2^s's leading bit
    if (top > 1023) {
        var inf: f64 = _RY_INF;
        return inf;
    }
    var lsb = top - 52;                          # the result's last bit, at most 53 bits and not below 2^-1074
    if (lsb < 0 - 1074) { lsb = 0 - 1074; }
    var sh = lsb - s;
    var q = mm;
    if (sh > 0) {
        if (sh > 62) { return 0.0; }
        q = mm >> sh;
        var rem = mm - (q << sh);
        var half = 1 << (sh - 1);
        if (rem > half || (rem == half && (q & 1) == 1)) { q = q + 1; }
    } else {
        lsb = s;
    }
    var qf: f64 = f64_from(q);                   # q ≤ 2^53: exact
    if (lsb >= 0 - 1022) {
        var sc: f64 = _ry_cr_pow2(lsb);
        var r: f64 = qf * sc;                    # exact, or +∞ when q·2^lsb = 2^1024
        return r;
    }
    var s1: f64 = _ry_cr_pow2(lsb + 1074);       # q·2^lsb = ((q·2^(lsb + 1074))·2^-52)·2^-1022: each step exact
    var s2: f64 = _ry_cr_pow2(0 - 52);
    var s3: f64 = _ry_cr_pow2(0 - 1022);
    var w: f64 = ((qf * s1) * s2) * s3;
    return w;
}

# M^n for odd integers M ≥ 3 and n ≥ 1, or 0 when it reaches 2^54.
#must_use
fn _ry_pow_int54(mm, n): i64 {
    var acc = 1;
    var i = 0;
    while (i < n) {
        if (acc > (0x0040000000000000 / mm)) { return 0; }
        acc = acc * mm;
        i = i + 1;
    }
    if (acc >= 0x0040000000000000) { return 0; }
    return acc;
}

# (1, RN(x^y)) when x^y is an exact double or an exact midpoint (or another value known exactly), else (0, 0);
# x > 0 finite, y finite with 0 < |y| < 2^64. After Lauter and Lefèvre ("An efficient rounding boundary test for
# pow(x, y) in double precision", IEEE TC 2009) and CORE-MATH's pow. Write x = mx·2^ex and y = ±my·2^fy with mx,
# my odd. y is a double, so in lowest terms y = p/2^k (k = max(0, −fy)). If x^y = R is rational then
# R^(2^k) = x^p: when p > 0, unique factorisation makes mx a perfect 2^k-th power, mx = a^(2^k), with 2^k | ex,
# and R = a^p·2^(ex·p/2^k); when p < 0, R's odd part 1/a^|p| is dyadic only for a = 1, mx = 1. A double or a
# midpoint has an odd part below 2^54, so beyond these cases x^y is neither: mx = 1 gives a power of two
# 2^(ex·y) (exact, the tie 2^-1075, or out of range); mx ≥ 3 needs p > 0, a^p < 2^54 (so p ≤ 34) and
# a^(2^k) = mx < 2^53 (so k ≤ 5). In particular y = RN(1/3) has k = 54: x^y is never exact unless x = 1.
#must_use
fn _ry_pow_exact(ax: f64, y: f64): (i64, f64) {
    var ux = load64(&ax);
    var mx = ux & 0x000FFFFFFFFFFFFF;
    var ex = 0 - 1074;
    if ((ux >> 52) != 0) {
        mx = mx | 0x0010000000000000;
        ex = (ux >> 52) - 1075;
    }
    while ((mx & 1) == 0) {
        mx = mx >> 1;
        ex = ex + 1;
    }
    var uy = load64(&y);
    var sy = 1;
    if (uy < 0) { sy = 0 - 1; }
    var ay = uy & 0x7FFFFFFFFFFFFFFF;
    var my = ay & 0x000FFFFFFFFFFFFF;
    var fy = 0 - 1074;
    if ((ay >> 52) != 0) {
        my = my | 0x0010000000000000;
        fy = (ay >> 52) - 1075;
    }
    while ((my & 1) == 0) {
        my = my >> 1;
        fy = fy + 1;
    }
    if (fy >= 0) {                               # y an integer: |y| = my·2^fy
        if (fy >= 12 || my >= 4096) { return (0, 0.0); }   # |y| ≥ 4096: 2^(ex·y) and mx^y are out of reach
        var yi = my << fy;
        if (yi >= 4096) { return (0, 0.0); }
        if (mx == 1) {
            var r1: f64 = _ry_cr_from_int(1, ex * yi * sy);
            return (1, r1);
        }
        if (sy < 0) { return (0, 0.0); }
        if (yi > 34) { return (0, 0.0); }
        var mm = _ry_pow_int54(mx, yi);
        if (mm == 0) { return (0, 0.0); }
        var r2: f64 = _ry_cr_from_int(mm, ex * yi);
        return (1, r2);
    }
    var k = 0 - fy;                              # y = ±my/2^k, k ≥ 1
    var q = 0;
    if (k >= 11) {
        if (ex != 0) { return (0, 0.0); }        # |ex| < 2^11: 2^k ∤ ex
    } else {
        if ((ex & ((1 << k) - 1)) != 0) { return (0, 0.0); }
        q = ex >>> k;
    }
    if (mx == 1) {
        if (q == 0) { return (1, 1.0); }         # x = 1
        if (my >= 4096) { return (0, 0.0); }     # |ex·y| ≥ my: out of range
        var r3: f64 = _ry_cr_from_int(1, q * my * sy);
        return (1, r3);
    }
    if (k > 5 || sy < 0 || my > 34) { return (0, 0.0); }
    var a = mx;
    var i = 0;
    while (i < k) {                              # a = mx^(1/2^k), each root exact or none
        var af: f64 = f64_from(a);
        var sf: f64 = f64_sqrt(af);
        var si = f64_to(sf);
        if (si * si != a) { return (0, 0.0); }
        a = si;
        i = i + 1;
    }
    var m2 = _ry_pow_int54(a, my);
    if (m2 == 0) { return (0, 0.0); }
    var r4: f64 = _ry_cr_from_int(m2, q * my);
    return (1, r4);
}

# The fast kernel for x > 0 finite (bits ux, a subnormal included) and finite y with 0 < |y| < 2^64:
# (RN(x^y), 1), or (0, 0) when the rounding test fails.
#must_use
fn _ry_pow_pos_fast(ux, y: f64): (f64, i64) {
    var ui = ux;
    var eb = 0;
    if (ui < 0x0010000000000000) {               # a subnormal x, scaled exactly by 2^54
        var xf: f64 = ui;
        var p54: f64 = 0x4350000000000000;
        var xs: f64 = xf * p54;
        ui = load64(&xs);
        eb = 0 - 54;
    }
    var lh, ll, eln = _ry_ln_core(ui, eb);
    var zh0: f64 = y * lh;                       # z = y·(lh + ll): Dekker's product, both factors split
    var cy: f64 = 134217729.0 * y;
    var y1: f64 = cy - (cy - y);
    var y2: f64 = y - y1;
    var cl: f64 = 134217729.0 * lh;
    var l1: f64 = cl - (cl - lh);
    var l2: f64 = lh - l1;
    var ze: f64 = ((((y1 * l1) - zh0) + (y1 * l2)) + (y2 * l1)) + (y2 * l2);
    var zl0: f64 = ze + (y * ll);
    var zh: f64 = zh0 + zl0;                     # renormalised (Fast2Sum): |zl| ≤ 2^-44
    var zl: f64 = zl0 - (zh - zh0);
    var azh: f64 = f64_abs(zh);
    if (azh > 708.0) {
        if (zh > 710.0) {
            var inf: f64 = _RY_INF;
            return (inf, 1);
        }
        if (zh < -746.0) { return (0.0, 1); }
    }
    var ay: f64 = f64_abs(y);
    var k100: f64 = 0x39B0000000000000;          # 2^-100
    var k69: f64 = 0x3BA0000000000000;           # 2^-69
    var errz: f64 = (ay * eln) + (azh * k100);
    var err: f64 = (errz * 2.0625) + k69;
    var hi, lo, e = _ry_exp_core(zh, zl);
    if (e > 0 - 1022 && e < 1024) {             # a normal result: _ry_exp_fin's first case, inline
        var u: f64 = hi + (lo - err);
        var v: f64 = hi + (lo + err);
        if (u != v) { return (0.0, 0); }
        var sb = (e + 1023) << 52;
        var sc: f64 = sb;
        var rn: f64 = u * sc;
        return (rn, 1);
    }
    var ok, r = _ry_exp_fin(hi, lo, e, err);
    return (r, ok);
}

# The accurate kernel for the same arguments: an exact or midpoint result exactly, else the triple-double path.
#must_use
fn _ry_pow_pos_acc(ax: f64, y: f64): f64 {
    var found, rx = _ry_pow_exact(ax, y);
    if (found == 1) { return rx; }
    var lb: f64[3];
    _ry_ln_acc_td(ax, &lb);
    var z0, z1, z2 = _ry_td_mul_d(lb[0], lb[1], lb[2], y);
    if (z0 > 710.0) {
        var inf: f64 = _RY_INF;
        return inf;
    }
    if (z0 < -746.0) { return 0.0; }
    var eb: f64[3];
    var e = _ry_exp_acc_core(z0, z1, z2, &eb);
    var r: f64 = _ry_cr_finish(e, eb[0], eb[1], eb[2]);
    return r;
}

# Every argument outside the fast path's common case (x positive normal, 0 < |y| < 2^64): the special values,
# a negative x (the sign from y's parity), a subnormal x, |y| ≥ 2^64. acc = 0 runs the fast kernel, 1 the
# accurate one; (result, 1), or (0, 0) when the fast kernel's test fails.
#must_use
fn _ry_pow_cases(x: f64, y: f64, acc): (f64, i64) {
    if (y == 0.0) { return (1.0, 1); }           # pow(x, ±0) = 1, x NaN included
    if (x == 1.0) { return (1.0, 1); }           # pow(+1, y) = 1, y NaN included
    if (x != x) { return (x, 1); }
    if (y != y) { return (y, 1); }
    var ax: f64 = f64_abs(x);
    var ay: f64 = f64_abs(y);
    var inf: f64 = _RY_INF;
    if (ay == inf) {
        if (ax == 1.0) { return (1.0, 1); }      # pow(−1, ±∞) = 1
        if (ax < 1.0) {
            if (y > 0.0) { return (0.0, 1); }
            return (inf, 1);
        }
        if (y > 0.0) { return (inf, 1); }
        return (0.0, 1);
    }
    var yint, yodd = _ry_pow_yclass(y);
    if (ax == 0.0) {
        if (y < 0.0) {
            if (yodd == 1) {
                var pz: f64 = 1.0 / x;           # ±∞ with x's sign
                return (pz, 1);
            }
            return (inf, 1);
        }
        if (yodd == 1) { return (x, 1); }        # ±0
        return (0.0, 1);
    }
    if (ax == inf) {
        var res: f64 = inf;
        if (y < 0.0) { res = 0.0; }
        if (x < 0.0 && yodd == 1) { res = -res; }
        return (res, 1);
    }
    var neg = 0;
    if (x < 0.0) {
        if (yint == 0) {
            var nan: f64 = _ry_nan();
            return (nan, 1);
        }
        neg = yodd;
    }
    var r: f64 = 0.0;
    var ok = 1;
    var big: f64 = 0x43F0000000000000;           # 2^64: |y·ln|x|| ≥ 2^64·2^-53 > 746 unless |x| = 1
    if (ay >= big) {
        if (ax == 1.0) {
            r = 1.0;
        } else {
            r = 0.0;
            if ((ax > 1.0) == (y > 0.0)) { r = inf; }
        }
    } else {
        if (acc == 1) {
            r = _ry_pow_pos_acc(ax, y);
        } else {
            var rf, okf = _ry_pow_pos_fast(load64(&ax), y);
            r = rf;
            ok = okf;
        }
    }
    if (neg == 1) { r = -r; }
    return (r, ok);
}

# pow(x, y) = x^y, correctly rounded, with the special values above. Mirrors `f64::powf`.
#must_use
fn _ry_cr_pow(x: f64, y: f64): f64 {
    var ux = load64(&x);
    var ay = load64(&y) & 0x7FFFFFFFFFFFFFFF;
    # The common case of _ry_cr_pow_fast, dispatched here to save a call: x in [DBL_MIN, DBL_MAX] and
    # 0 < |y| < 2^64.
    if (((ux - 0x0010000000000000) ^ 0x8000000000000000) < 0xFFE0000000000000) {
        if (((ay - 1) ^ 0x8000000000000000) < 0xC3EFFFFFFFFFFFFF) {
            var r, ok = _ry_pow_pos_fast(ux, y);
            if (ok == 1) { return r; }
            var a: f64 = _ry_pow_pos_acc(x, y);
            return a;
        }
    }
    var r2, ok2 = _ry_pow_cases(x, y, 0);
    if (ok2 == 1) { return r2; }
    var a2: f64 = _ry_cr_pow_acc(x, y);
    return a2;
}

# The fast path alone: (its result, 1), or (0, 0) when its rounding test fails.
#must_use
fn _ry_cr_pow_fast(x: f64, y: f64): (f64, i64) {
    var ux = load64(&x);
    var ay = load64(&y) & 0x7FFFFFFFFFFFFFFF;
    # x in [DBL_MIN, DBL_MAX] and 0 < |y| < 2^64, as unsigned range tests (the trick of _ry_cr_exp).
    if (((ux - 0x0010000000000000) ^ 0x8000000000000000) < 0xFFE0000000000000) {
        if (((ay - 1) ^ 0x8000000000000000) < 0xC3EFFFFFFFFFFFFF) {
            var r, ok = _ry_pow_pos_fast(ux, y);
            return (r, ok);
        }
    }
    var r2, ok2 = _ry_pow_cases(x, y, 0);
    return (r2, ok2);
}

# pow by the accurate path alone, for every (x, y).
#must_use
fn _ry_cr_pow_acc(x: f64, y: f64): f64 {
    var r, ok = _ry_pow_cases(x, y, 1);
    return r;
}

# ══ rasayan's own (not vendored): the Rust-semantics helpers (port-parity.md §0.8) ══════════════════════════════
#
# The forms probe 0 found (scripts/probes/p0_math.cyr), checked by the parity harness against every class A and B
# `math` row of tests/golden/math.tsv. The stdlib's f64_min / f64_max differ from Rust when the second operand is
# NaN, and the stdlib has no is_nan, is_finite or powi (port-parity.md §0.1, §0.3, §0.4).

# 1 if x is a NaN, else 0: `x != x`, which is 1 exactly for every NaN pattern (signalling and negative ones
# included: an IEEE compare, ucomisd's unordered flag) — the same answers as the bit test of port-parity.md §0.3.
# One branch-free expression, so #inline takes it. Mirrors `f64::is_nan`.
#must_use
#pure
#inline
fn _ry_is_nan(x: f64): i64 {
    return x != x;
}

# 1 if x is finite, else 0: `(x - x) == 0.0`. For every finite x, x − x is +0 (round to nearest: an exact zero
# difference is +0); for ±inf and NaN it is NaN, which compares unequal. The same answers as the exponent bit test of
# port-parity.md §0.3 on every bit pattern, with no memory round trip; one expression, so #inline takes it. Mirrors
# `f64::is_finite`.
#must_use
#pure
#inline
fn _ry_is_finite(x: f64): i64 {
    return (x - x) == 0.0;
}

# The larger of a and b, as rustc 1.100.0 lowers `a.max(b)`: a NaN operand is ignored (NaN only when both are), and
# equal operands, +0 and -0 included, give b (port-parity.md §0.1). A NaN b gives a; otherwise the stdlib's form,
# which already returns b for a NaN a and for equal operands. Mirrors `f64::max`.
#must_use
#pure
fn _ry_max(a: f64, b: f64): f64 {
    if (b != b) { return a; }
    if (a > b) { return a; }
    return b;
}

# The smaller of a and b, with the same NaN and equal-operand rules as _ry_max. Mirrors `f64::min`.
#must_use
#pure
fn _ry_min(a: f64, b: f64): f64 {
    if (b != b) { return a; }
    if (a < b) { return a; }
    return b;
}

# x^n as compiler-builtins' `__powidf2` computes it (the loop a run-time `f64::powi` exponent calls): square and
# multiply over the bits of |n|, low bit first, then 1 / r for a negative n (port-parity.md §0.4). For n = 2, what
# both of rasayan's `.powi(2)` sites are, it is `x * x`, one rounding, as rustc's inline expansion. n is Rust's i32,
# so |n| fits and the shift loop ends. Mirrors `f64::powi`.
#must_use
#pure
fn _ry_powi(x: f64, n): f64 {
    var base: f64 = x;
    var p = n;
    if (n < 0) { p = 0 - n; }
    var mul: f64 = 1.0;
    while (1) {
        if ((p & 1) != 0) { mul = mul * base; }
        p = p >> 1;
        if (p == 0) { break; }
        base = base * base;
    }
    if (n < 0) {
        var r: f64 = 1.0 / mul;
        return r;
    }
    return mul;
}

# Rust's `x.clamp(lo, hi)`: the same two comparisons in the same order, so a NaN x passes through and a zero keeps its
# sign (port-parity.md §0.1). Rust panics when lo > hi or a bound is NaN; no rasayan call site can reach that, so there
# is no such branch. Mirrors `f64::clamp`.
#must_use
#pure
fn _ry_clamp(x: f64, lo: f64, hi: f64): f64 {
    var r: f64 = x;
    if (r < lo) { r = lo; }
    if (r > hi) { r = hi; }
    return r;
}

# Rust's saturating `x as u32`: NaN is 0, a value at or past 2^32 is u32::MAX, a negative one (-inf included) is 0, and
# anything else truncates toward zero (port-parity.md §0.6). Mirrors `f64 as u32`.
#must_use
#pure
fn _ry_f64_to_u32(x: f64): i64 {
    if (x != x) { return 0; }
    if (x >= 4294967296.0) { return 4294967295; }
    var t = f64_to(x);
    if (t < 0) { return 0; }
    return t;
}

# --- fmtf.cyr ---

# fmtf.cyr — f64 to text: the shortest round-trip digits, in Rust's Display and serde_json's forms (ADR 0004, P7).
#
# VENDORED mechanically from impetus's src/fmtf.cyr (impetus commit 809ea0f, sha256 1d925be3b48c274e…) by
# scripts/vendor_fmtf.py; regenerate it there, never edit it here. ushma vendors the same file the same way (its
# src/fmtf.cyr, ADR 0005), and `vendor_fmtf.py --check-ushma` proves this copy is ushma's with `_us_` read as `_ry_`.
# The only changes from impetus: this header, the `_ry_` names, and `_ry_bits` (impetus takes it from its mathx.cyr).
#
# Both printers give the SHORTEST digits that parse back to the same double, choosing the closest to the exact value
# among them: Rust's `Display` (core's Grisu with a Dragon fallback) and serde_json 1.0.154's zmij (Schubfach). They
# differ only on an exact tie between two closest candidates: core rounds it up, zmij to the even digit. The digits
# come from Burger & Dybvig's free-format algorithm ("Printing Floating-Point Numbers Quickly and Accurately", 1996)
# on a small bignum: exact, with no tables. rasayan's M0 probe 11 (docs/development/port-parity.md §3) checks the JSON
# form against serde_json 1.0.154 on rasayan's types and a float sweep, and both forms against Rust 1.100.0.
#
# Forms:
# - `_ry_fmt_f64_display`: Rust's `{}` — always positional, no ".0" (`100`, `0.1`, `-0`), `NaN`, `inf`, `-inf`.
# - `_ry_fmt_f64_json`: serde_json — positional while the decimal exponent is in −5..=15, with ".0" on an integer
#   (`100.0`, `0.00001`); otherwise `d.ddde±x` (`1e+16`, `1.5e-7`); `null` for NaN and ±∞.

# The bits of an f64 as an integer word: an untyped parameter, an i64 return.
#must_use
fn _ry_bits(x): i64 {
    return x;
}

include "lib/str.cyr"

# ── bignum ──────────────────────────────────────────────────────────────────────────
# A non-negative integer in 32-bit limbs, little-endian: word 0 the limb count, words 1..40 the limbs.
# 40 limbs hold 2^1280; the algorithm's values stay below 2^1140. No leading zero limbs.
var _RY_BN_WORDS = 41;

# a := v, for 0 <= v < 2^63.
fn _ry_bn_set(a, v) {
    var n = 0;
    var x = v;
    while (x != 0) {
        store64(a + 8 + n * 8, x & 0xFFFFFFFF);
        x = x >> 32;
        n = n + 1;
    }
    store64(a, n);
    return 0;
}

# dst := src.
fn _ry_bn_copy(dst, src) {
    var n = load64(src);
    for (var i = 0; i <= n; i = i + 1) { store64(dst + i * 8, load64(src + i * 8)); }
    return 0;
}

# a := a × m, for 0 < m < 2^31.
fn _ry_bn_mul_small(a, m) {
    var n = load64(a);
    var carry = 0;
    for (var i = 0; i < n; i = i + 1) {
        var t = load64(a + 8 + i * 8) * m + carry;
        store64(a + 8 + i * 8, t & 0xFFFFFFFF);
        carry = t >> 32;
    }
    while (carry != 0) {
        store64(a + 8 + n * 8, carry & 0xFFFFFFFF);
        carry = carry >> 32;
        n = n + 1;
    }
    store64(a, n);
    return 0;
}

# a := a × 10^k, for k >= 0 (in steps of 10^9).
fn _ry_bn_mul_pow10(a, k) {
    var left = k;
    while (left >= 9) {
        _ry_bn_mul_small(a, 1000000000);
        left = left - 9;
    }
    var m = 1;
    for (var i = 0; i < left; i = i + 1) { m = m * 10; }
    if (m > 1) { _ry_bn_mul_small(a, m); }
    return 0;
}

# a := a × 2^k, for k >= 0.
fn _ry_bn_shl(a, k) {
    var n = load64(a);
    if (n == 0) { return 0; }
    var q = k / 32;
    var b = k % 32;
    if (b != 0) {
        var carry = 0;
        for (var i = 0; i < n; i = i + 1) {
            var t = (load64(a + 8 + i * 8) << b) | carry;
            store64(a + 8 + i * 8, t & 0xFFFFFFFF);
            carry = t >> 32;
        }
        if (carry != 0) {
            store64(a + 8 + n * 8, carry);
            n = n + 1;
        }
    }
    if (q > 0) {
        var i = n - 1;
        while (i >= 0) {
            store64(a + 8 + (i + q) * 8, load64(a + 8 + i * 8));
            i = i - 1;
        }
        for (var j = 0; j < q; j = j + 1) { store64(a + 8 + j * 8, 0); }
        n = n + q;
    }
    store64(a, n);
    return 0;
}

# dst := a + b (dst distinct from both).
fn _ry_bn_sum(dst, a, b) {
    var na = load64(a);
    var nb = load64(b);
    var n = na;
    if (nb > n) { n = nb; }
    var carry = 0;
    for (var i = 0; i < n; i = i + 1) {
        var x = 0;
        var y = 0;
        if (i < na) { x = load64(a + 8 + i * 8); }
        if (i < nb) { y = load64(b + 8 + i * 8); }
        var t = x + y + carry;
        store64(dst + 8 + i * 8, t & 0xFFFFFFFF);
        carry = t >> 32;
    }
    if (carry != 0) {
        store64(dst + 8 + n * 8, carry);
        n = n + 1;
    }
    store64(dst, n);
    return 0;
}

# -1, 0 or 1 as a < b, a = b, a > b.
#must_use
fn _ry_bn_cmp(a, b): i64 {
    var na = load64(a);
    var nb = load64(b);
    if (na != nb) {
        if (na < nb) { return 0 - 1; }
        return 1;
    }
    var i = na - 1;
    while (i >= 0) {
        var x = load64(a + 8 + i * 8);
        var y = load64(b + 8 + i * 8);
        if (x != y) {
            if (x < y) { return 0 - 1; }
            return 1;
        }
        i = i - 1;
    }
    return 0;
}

# a := a − b, for a >= b.
fn _ry_bn_sub(a, b) {
    var na = load64(a);
    var nb = load64(b);
    var borrow = 0;
    for (var i = 0; i < na; i = i + 1) {
        var y = 0;
        if (i < nb) { y = load64(b + 8 + i * 8); }
        var t = load64(a + 8 + i * 8) - y - borrow;
        borrow = 0;
        if (t < 0) {
            t = t + 0x100000000;
            borrow = 1;
        }
        store64(a + 8 + i * 8, t);
    }
    while (na > 0 && load64(a + na * 8) == 0) { na = na - 1; }
    store64(a, na);
    return 0;
}

# The number of bits in x > 0.
#must_use
fn _ry_bitlen(x): i64 {
    var n = 0;
    var v = x;
    while (v != 0) {
        v = v >> 1;
        n = n + 1;
    }
    return n;
}

# ── shortest digits (Burger & Dybvig, free format) ──────────────────────────────────

# The shortest decimal digits of the positive finite double with bits `bits` that read back to it,
# the closest to its exact value among them: writes the ASCII digits to `digits` (17 bytes is
# enough) and returns (n, k) with value = 0.d1d2…dn × 10^k. When the exact value lies exactly
# halfway between the two closest candidates, `tie_even` 0 takes the upper one (Rust's core
# printer: 2^-25 is 2.9802322387695313e-8) and 1 the even one (serde_json's zmij: …5312e-8).
fn _ry_shortest(bits, digits, tie_even) {
    var be = (bits >> 52) & 0x7FF;
    var f = bits & 0xFFFFFFFFFFFFF;
    var e = 0 - 1074;
    if (be != 0) {
        f = f | 0x10000000000000;
        e = be - 1075;
    }
    # IEEE round-half-even on reading: the interval's ends belong to it when f is even.
    var even = 1 - (f & 1);
    var r[328];
    var s[328];
    var mp[328];
    var mm[328];
    var t[328];
    if (e >= 0) {
        if (f != 0x10000000000000) {
            _ry_bn_set(&r, f);
            _ry_bn_shl(&r, e + 1);
            _ry_bn_set(&s, 2);
            _ry_bn_set(&mp, 1);
            _ry_bn_shl(&mp, e);
            _ry_bn_copy(&mm, &mp);
        } else {
            _ry_bn_set(&r, f);
            _ry_bn_shl(&r, e + 2);
            _ry_bn_set(&s, 4);
            _ry_bn_set(&mp, 1);
            _ry_bn_shl(&mp, e + 1);
            _ry_bn_set(&mm, 1);
            _ry_bn_shl(&mm, e);
        }
    } else {
        if (e == 0 - 1074 || f != 0x10000000000000) {
            _ry_bn_set(&r, f);
            _ry_bn_shl(&r, 1);
            _ry_bn_set(&s, 1);
            _ry_bn_shl(&s, 1 - e);
            _ry_bn_set(&mp, 1);
            _ry_bn_set(&mm, 1);
        } else {
            _ry_bn_set(&r, f);
            _ry_bn_shl(&r, 2);
            _ry_bn_set(&s, 1);
            _ry_bn_shl(&s, 2 - e);
            _ry_bn_set(&mp, 2);
            _ry_bn_set(&mm, 1);
        }
    }
    # k = ⌈log10(v) − 1e-10⌉ from the binary exponent: never too large, at most one too small
    # (the fixup below adds the one).
    var lg: f64 = f64_from(e + _ry_bitlen(f) - 1);
    var est: f64 = lg * 0.30102999566398114 - 0.0000000001;
    var k = f64_to(f64_ceil(est));
    if (k >= 0) {
        _ry_bn_mul_pow10(&s, k);
    } else {
        _ry_bn_mul_pow10(&r, 0 - k);
        _ry_bn_mul_pow10(&mp, 0 - k);
        _ry_bn_mul_pow10(&mm, 0 - k);
    }
    _ry_bn_sum(&t, &r, &mp);
    var c = _ry_bn_cmp(&t, &s);
    if ((even == 1 && c >= 0) || (even == 0 && c > 0)) {
        _ry_bn_mul_small(&s, 10);
        k = k + 1;
    }
    var n = 0;
    while (1) {
        _ry_bn_mul_small(&r, 10);
        _ry_bn_mul_small(&mp, 10);
        _ry_bn_mul_small(&mm, 10);
        var d = 0;
        while (_ry_bn_cmp(&r, &s) >= 0) {
            _ry_bn_sub(&r, &s);
            d = d + 1;
        }
        var lo = _ry_bn_cmp(&r, &mm);
        var tc1 = 0;
        if (lo < 0 || (even == 1 && lo == 0)) { tc1 = 1; }
        _ry_bn_sum(&t, &r, &mp);
        var hi = _ry_bn_cmp(&t, &s);
        var tc2 = 0;
        if (hi > 0 || (even == 1 && hi == 0)) { tc2 = 1; }
        if (tc1 == 0 && tc2 == 0) {
            store8(digits + n, 48 + d);
            n = n + 1;
        } else {
            if (tc1 == 1 && tc2 == 1) {
                # Both neighbours read back: the closer one, 2r against s; a tie per `tie_even`.
                _ry_bn_copy(&t, &r);
                _ry_bn_shl(&t, 1);
                var half = _ry_bn_cmp(&t, &s);
                if (half > 0) { d = d + 1; }
                if (half == 0 && (tie_even == 0 || (d & 1) == 1)) { d = d + 1; }
            } elif (tc2 == 1) {
                d = d + 1;
            }
            store8(digits + n, 48 + d);
            n = n + 1;
            return (n, k);
        }
    }
    return (n, k);
}

# ── formatting ──────────────────────────────────────────────────────────────────────

# Appends `count` copies of byte c.
fn _ry_sb_repeat(sb, c, count) {
    for (var i = 0; i < count; i = i + 1) { str_builder_putc(sb, c); }
    return 0;
}

# Appends digits [from, to) of `digits`.
fn _ry_sb_digits(sb, digits, from, to) {
    for (var i = from; i < to; i = i + 1) { str_builder_putc(sb, load8(digits + i)); }
    return 0;
}

# Appends 0.d1…dn × 10^k positionally: "123.45", "0.00012", "12300". With `int_suffix` 1, an integer
# gets ".0" (serde_json's form).
fn _ry_sb_positional(sb, digits, n, k, int_suffix) {
    if (k <= 0) {
        str_builder_putc(sb, 48);
        str_builder_putc(sb, 46);
        _ry_sb_repeat(sb, 48, 0 - k);
        _ry_sb_digits(sb, digits, 0, n);
        return 0;
    }
    if (k >= n) {
        _ry_sb_digits(sb, digits, 0, n);
        _ry_sb_repeat(sb, 48, k - n);
        if (int_suffix == 1) {
            str_builder_putc(sb, 46);
            str_builder_putc(sb, 48);
        }
        return 0;
    }
    _ry_sb_digits(sb, digits, 0, k);
    str_builder_putc(sb, 46);
    _ry_sb_digits(sb, digits, k, n);
    return 0;
}

# Appends x as Rust's `Display` (`{}`) writes an f64. Mirrors `<f64 as Display>::fmt`.
fn _ry_fmt_f64_display(sb, x: f64) {
    var bits = _ry_bits(x);
    if (x != x) {
        str_builder_add_cstr(sb, "NaN");
        return 0;
    }
    if (bits < 0) { str_builder_putc(sb, 45); }
    var mag = bits & 0x7FFFFFFFFFFFFFFF;
    if (mag == 0x7FF0000000000000) {
        str_builder_add_cstr(sb, "inf");
        return 0;
    }
    if (mag == 0) {
        str_builder_putc(sb, 48);
        return 0;
    }
    var digits[24];
    var n, k = _ry_shortest(mag, &digits, 0);
    _ry_sb_positional(sb, &digits, n, k, 0);
    return 0;
}

# The number of non-finite values _ry_fmt_f64_json has written as `null`, as serde_json does. A caller that must not
# lose one (a JSON writer) zeroes it, writes, and checks it.
var _ry_json_nonfinite = 0;

# Appends x as serde_json 1.0.154 writes an f64 (zmij's format). Mirrors `serde_json::to_string(&x)`.
fn _ry_fmt_f64_json(sb, x: f64) {
    var bits = _ry_bits(x);
    var mag = bits & 0x7FFFFFFFFFFFFFFF;
    if (mag >= 0x7FF0000000000000) {
        _ry_json_nonfinite = _ry_json_nonfinite + 1;
        str_builder_add_cstr(sb, "null");
        return 0;
    }
    if (bits < 0) { str_builder_putc(sb, 45); }
    if (mag == 0) {
        str_builder_add_cstr(sb, "0.0");
        return 0;
    }
    var digits[24];
    var n, k = _ry_shortest(mag, &digits, 1);
    var ex = k - 1;
    if (ex >= 0 - 5 && ex <= 15) {
        _ry_sb_positional(sb, &digits, n, k, 1);
        return 0;
    }
    str_builder_putc(sb, load8(&digits));
    if (n > 1) {
        str_builder_putc(sb, 46);
        _ry_sb_digits(sb, &digits, 1, n);
    }
    str_builder_putc(sb, 101);
    if (ex >= 0) {
        str_builder_putc(sb, 43);
        str_builder_add_int(sb, ex);
    } else {
        str_builder_putc(sb, 45);
        str_builder_add_int(sb, 0 - ex);
    }
    return 0;
}

# --- error.cyr ---

# error.cyr — rasayan's error codes (ADR 0002 row 1).
#
# A fallible rasayan function returns a value-form Result whose Err payload is one of these codes:
# `var t, v = ry_f(..); if (is_err_result(t) == 1) { .. v is the code .. }`. The values follow the order of Rust
# 1.2.0's `RasayanError` variants and are append-only (the Cyrius form of #[non_exhaustive]); codes Cyrius needs that
# Rust has no variant for are appended after them, each with the milestone that first returns it. Each code has a
# fixed message. The values that made a call fail (the parameter's name and value, the reason, the unknown code) are
# not carried in the error: the failure site reports them as Rust's Display text of the error in a level-gated sakshi
# event at DEBUG (`_ry_fail_f`, `_ry_fail_text`, below), so they cost nothing unless asked for.
#
# The golden corpus names an error by its Rust variant (`E:NonFinite`), so ry_error_name gives that name and the
# parity is on the code.

enum RyError {
    RY_ERR_NONE = 0;
    RY_ERR_NEGATIVE_CONCENTRATION = 1;
    RY_ERR_INVALID_PARAMETER = 2;
    RY_ERR_UNKNOWN_AMINO_ACID = 3;
    RY_ERR_UNKNOWN_PATHWAY = 4;
    RY_ERR_NON_FINITE = 5;
    # Cyrius only, from here (M1 part 3).
    RY_ERR_DESERIALIZE = 6;
    RY_ERR_OUT_OF_MEMORY = 7;
    # M3 part 1: a caller buffer too small for a `Vec` result (ADR 0002 row 3).
    RY_ERR_BUFFER_TOO_SMALL = 8;
    # M8 part 2: the hoosh client's two failures (Rust's `HooshError::Provider` and `HooshError::Http`).
    RY_ERR_PROVIDER = 9;
    RY_ERR_HTTP = 10;
}

# The number of codes, RY_ERR_NONE included: every code is in 0 .. RY_ERR_COUNT - 1.
const RY_ERR_COUNT = 11;

# The name of an error code: Rust 1.2.0's variant name (`"NonFinite"`) for the codes that mirror one, `"Deserialize"`
# for the JSON readers' code (Rust's serde_json::Error), `"OutOfMemory"` for a refused allocation (where Rust aborts
# the process), `"BufferTooSmall"` for a caller buffer too small for a result Rust returns as a `Vec`, `"Provider"`
# and `"Http"` for the hoosh client's failures (hoosh's variants), `"None"` for RY_ERR_NONE, and `"Unknown"` for a
# value that is no code.
#must_use
#pure
fn ry_error_name(code): cstring {
    match code {
        RY_ERR_NONE => { return "None"; }
        RY_ERR_NEGATIVE_CONCENTRATION => { return "NegativeConcentration"; }
        RY_ERR_INVALID_PARAMETER => { return "InvalidParameter"; }
        RY_ERR_UNKNOWN_AMINO_ACID => { return "UnknownAminoAcid"; }
        RY_ERR_UNKNOWN_PATHWAY => { return "UnknownPathway"; }
        RY_ERR_NON_FINITE => { return "NonFinite"; }
        RY_ERR_DESERIALIZE => { return "Deserialize"; }
        RY_ERR_OUT_OF_MEMORY => { return "OutOfMemory"; }
        RY_ERR_BUFFER_TOO_SMALL => { return "BufferTooSmall"; }
        RY_ERR_PROVIDER => { return "Provider"; }
        RY_ERR_HTTP => { return "Http"; }
        _ => { return "Unknown"; }
    }
    return "Unknown";
}

# The fixed message of an error code: Rust's Display text up to its first payload (`"non-finite value"`), `"no error"`
# for RY_ERR_NONE and `"unknown error"` for a value that is no code. The payload, which Rust formats into the text
# (`non-finite value: km = NaN`), is in the failing guard's DEBUG event.
#must_use
#pure
fn ry_error_message(code): cstring {
    match code {
        RY_ERR_NONE => { return "no error"; }
        RY_ERR_NEGATIVE_CONCENTRATION => { return "concentration out of range (must be >= 0)"; }
        RY_ERR_INVALID_PARAMETER => { return "invalid parameter"; }
        RY_ERR_UNKNOWN_AMINO_ACID => { return "unknown amino acid"; }
        RY_ERR_UNKNOWN_PATHWAY => { return "unknown metabolic pathway"; }
        RY_ERR_NON_FINITE => { return "non-finite value"; }
        RY_ERR_DESERIALIZE => { return "malformed JSON document"; }
        RY_ERR_OUT_OF_MEMORY => { return "an allocation was refused"; }
        RY_ERR_BUFFER_TOO_SMALL => { return "the result buffer is too small"; }
        RY_ERR_PROVIDER => { return "provider error"; }
        RY_ERR_HTTP => { return "the HTTP request got no answer"; }
        _ => { return "unknown error"; }
    }
    return "unknown error";
}

# ── the failure events (Rust's Display, ADR 0002 row 1) ──

# A str_builder over a caller's stack buffer: header `hdr` (24 bytes: buf, len, cap) on `buf` of `cap` bytes. It grows
# onto the heap only past `cap`, as any str_builder does.
fn _ry_sb_on(hdr, buf, cap): i64 {
    store64(hdr, buf);
    store64(hdr + 8, 0);
    store64(hdr + 16, cap);
    return hdr;
}

# Writes Rust's Display text of an error with a name and an f64 payload into `sb`: `non-finite value: <name> = <value>`
# (RY_ERR_NON_FINITE), `concentration out of range: <name> = <value> (must be >= 0)` (RY_ERR_NEGATIVE_CONCENTRATION),
# or `invalid parameter: <name> = <value> (<reason><min>)` (RY_ERR_INVALID_PARAMETER), where `<min>` is the bound in
# Display form when `has_min` is 1 (guard's `must be >= {min}`) and nothing otherwise. `name` and `reason` are C
# strings; a value is written as Rust's `{}` writes it (`_ry_fmt_f64_display`).
fn _ry_error_display_f(sb, code, name, value: f64, reason, has_min, min: f64) {
    if (code == RY_ERR_NEGATIVE_CONCENTRATION) {
        str_builder_add_cstr(sb, "concentration out of range: ");
    } elif (code == RY_ERR_INVALID_PARAMETER) {
        str_builder_add_cstr(sb, "invalid parameter: ");
    } else {
        str_builder_add_cstr(sb, "non-finite value: ");
    }
    str_builder_add_cstr(sb, name);
    str_builder_add_cstr(sb, " = ");
    _ry_fmt_f64_display(sb, value);
    if (code == RY_ERR_NEGATIVE_CONCENTRATION) {
        str_builder_add_cstr(sb, " (must be >= 0)");
    } elif (code == RY_ERR_INVALID_PARAMETER) {
        str_builder_add_cstr(sb, " (");
        str_builder_add_cstr(sb, reason);
        if (has_min == 1) { _ry_fmt_f64_display(sb, min); }
        str_builder_putc(sb, 41);
    }
    return 0;
}

# The refusal `code` of the value `value` named `name`, for `return Err(..)`: with DEBUG on it first emits the error's
# Display text (_ry_error_display_f) as one DEBUG event, built in a 512-byte stack buffer (a value's Display text is
# at most 327 bytes, −5e-324's), so it never allocates. Rust's `Err(RasayanError::InvalidParameter { name, value,
# reason })` at a validate() is `return Err(_ry_fail_f(RY_ERR_INVALID_PARAMETER, name, value, reason, 0, 0.0));`.
#must_use
fn _ry_fail_f(code, name, value: f64, reason, has_min, min: f64): i64 {
    if (sakshi_get_level() >= SK_DEBUG) {
        var hdr[24];
        var buf[512];
        var sb = _ry_sb_on(&hdr, &buf, 512);
        _ry_error_display_f(sb, code, name, value, reason, has_min, min);
        sakshi_debug(load64(sb), load64(sb + 8));
    }
    return code;
}

# The refusal `code` of the text [p, p + n): with DEBUG on it first emits Rust's Display text, `unknown amino acid:
# <the code's UTF-8 bytes>` (RY_ERR_UNKNOWN_AMINO_ACID) or `unknown metabolic pathway: <the name>`
# (RY_ERR_UNKNOWN_PATHWAY), as one DEBUG event in a stack buffer (a longer text grows it onto the heap). Returns
# `code`.
#must_use
fn _ry_fail_text(code, p, n): i64 {
    if (sakshi_get_level() >= SK_DEBUG) {
        var hdr[24];
        var buf[256];
        var sb = _ry_sb_on(&hdr, &buf, 256);
        str_builder_add_cstr(sb, ry_error_message(code));
        str_builder_add_cstr(sb, ": ");
        var i = 0;
        while (i < n) {
            str_builder_putc(sb, load8(p + i));
            i = i + 1;
        }
        sakshi_debug(load64(sb), load64(sb + 8));
    }
    return code;
}

# --- guard.cyr ---

# guard.cyr — shared numeric guards: parameter validation and input sanitization (Rust 1.2.0's crate-private
# `guard.rs`, transcribed).
#
# Rust's `f64::max` / `f64::min` return the non-NaN operand and `f64::clamp` propagates NaN, so ad-hoc `.max(0.0)`
# clamps either silently zero a NaN input or let it poison state. Every module routes validation and tick inputs
# through these helpers instead, so that:
# - a validator rejects NaN and ±inf, not only negatives, and rejects zero for constants used as divisors (Km, Ki,
#   half-saturation constants);
# - a tick treats a non-finite or non-positive `dt` as "no time passed";
# - concentrations and fractions fed into a tick are mapped into their valid range, with NaN mapped to zero.
#
# Names: Rust's crate-private `guard::<fn>` is `_ry_guard_<fn>`, as a private constant `<module>::<NAME>` is
# `_RY_<MODULE>_<NAME>` (ADR 0001, P6).
#
# The validators return a value-form Result, Ok(0) or Err(code) (src/error.cyr). Rust's `guard::finite(name, value)?;`
# is written out (`var t, v = ..; if (is_err_result(t) == 1) { return Err(v); }`): at 6.7.18 `f()?` on a #must_use
# function warns that the result is discarded, and `cyrius test` must be warning-free. A refusal costs one level test
# unless DEBUG is on; then it first reports Rust's Display text of the error it stands for (`invalid parameter: km = 0
# (must be > 0)`) as one sakshi event (ADR 0002 row 1; `_ry_fail_f`, src/error.cyr). The text is built in a stack
# buffer, so a refusal never allocates.

# Rejects NaN and ±inf: Ok(0), or Err(RY_ERR_NON_FINITE). Mirrors `guard::finite`.
#must_use
fn _ry_guard_finite(name, value: f64): Result {
    if (_ry_is_finite(value) == 1) { return Ok(0); }
    return Err(_ry_fail_f(RY_ERR_NON_FINITE, name, value, 0, 0, 0.0));
}

# Requires a finite value `>= 0` (concentrations, rates, Vmax): Ok(0), Err(RY_ERR_NON_FINITE) for NaN or ±inf, or
# Err(RY_ERR_NEGATIVE_CONCENTRATION) below 0 (−0 passes, as `-0.0 < 0.0` is false). Mirrors `guard::non_negative`.
#must_use
fn _ry_guard_non_negative(name, value: f64): Result {
    var ft, fv = _ry_guard_finite(name, value);
    if (is_err_result(ft) == 1) { return Err(fv); }
    if (value < 0.0) {
        return Err(_ry_fail_f(RY_ERR_NEGATIVE_CONCENTRATION, name, value, 0, 0, 0.0));
    }
    return Ok(0);
}

# Requires a finite value `> 0` (constants used as divisors: Km, Ki, K½, capacities): Ok(0), Err(RY_ERR_NON_FINITE),
# or Err(RY_ERR_INVALID_PARAMETER) at or below 0 (±0 included). Mirrors `guard::positive`.
#must_use
fn _ry_guard_positive(name, value: f64): Result {
    var ft, fv = _ry_guard_finite(name, value);
    if (is_err_result(ft) == 1) { return Err(fv); }
    if (value <= 0.0) {
        return Err(_ry_fail_f(RY_ERR_INVALID_PARAMETER, name, value, "must be > 0", 0, 0.0));
    }
    return Ok(0);
}

# Requires a finite value in `[0, 1]` (fractions, normalized levels): Ok(0), Err(RY_ERR_NON_FINITE), or
# Err(RY_ERR_INVALID_PARAMETER) outside the closed interval (−0 is inside). Mirrors `guard::fraction`, whose
# `!(0.0..=1.0).contains(&value)` is `!(0.0 <= value && value <= 1.0)`.
#must_use
fn _ry_guard_fraction(name, value: f64): Result {
    var ft, fv = _ry_guard_finite(name, value);
    if (is_err_result(ft) == 1) { return Err(fv); }
    if (value < 0.0 || value > 1.0) {
        return Err(_ry_fail_f(RY_ERR_INVALID_PARAMETER, name, value, "must be in [0, 1]", 0, 0.0));
    }
    return Ok(0);
}

# Requires a finite value `>= min` (activation multipliers `>= 1`): Ok(0), Err(RY_ERR_NON_FINITE), or
# Err(RY_ERR_INVALID_PARAMETER) below `min`. Mirrors `guard::at_least`.
#must_use
fn _ry_guard_at_least(name, value: f64, min: f64): Result {
    var ft, fv = _ry_guard_finite(name, value);
    if (is_err_result(ft) == 1) { return Err(fv); }
    if (value < min) {
        return Err(_ry_fail_f(RY_ERR_INVALID_PARAMETER, name, value, "must be >= ", 1, min));
    }
    return Ok(0);
}

# 1 when `dt` is a usable time step, finite and `> 0`, else 0. Ticks return a zero flux and leave state untouched
# otherwise, so a bad frame time (NaN, negative, inf) cannot wipe or reverse a simulation. Mirrors `guard::valid_dt`.
#must_use
#pure
fn _ry_guard_valid_dt(dt: f64): i64 {
    if (_ry_is_finite(dt) == 1 && dt > 0.0) { return 1; }
    return 0;
}

# Sanitizes a concentration-like input: NaN, ±inf and negatives (and ±0) become +0. Mirrors `guard::conc`.
#must_use
#pure
fn _ry_guard_conc(x: f64): f64 {
    if (_ry_is_finite(x) == 1 && x > 0.0) { return x; }
    return 0.0;
}

# Sanitizes a fraction-like input into `[0, 1]`: NaN becomes +0, +inf 1, −inf 0; a zero keeps its sign. Rust's
# `x.clamp(0.0, 1.0)` is written out, its two comparisons in its order (_ry_clamp's), so there is one call per guard on
# the tick paths. Mirrors `guard::unit`.
#must_use
#pure
fn _ry_guard_unit(x: f64): f64 {
    if (x != x) { return 0.0; }
    if (x < 0.0) { return 0.0; }
    if (x > 1.0) { return 1.0; }
    return x;
}

# The amount a one-directional transfer moves this step: `amount` capped at the `pool` it drains. NaN, negative
# amounts and empty or invalid pools move nothing (+0), so a large `dt` can never overdraw a pool and create mass.
# Rust's `amount.min(pool)` is taken with both operands > 0, so neither is NaN or a zero and the plain comparison is
# exact (equal operands have equal bits). Mirrors `guard::take`.
#must_use
#pure
fn _ry_guard_take(amount: f64, pool: f64): f64 {
    if (amount > 0.0 && pool > 0.0) {
        if (pool < amount) { return pool; }
        return amount;
    }
    return 0.0;
}

# The net amount a reversible step moves this step (positive = forward), capped at the substrate pool going forward
# or the product pool going backward. Backward it is Rust's `-take(-amount, product)`: both negations are sign flips,
# so an empty product pool gives −0 (port-parity.md §0.7). Both `take`s are written out (one call per transfer on the
# pathways' tick paths): backward, `-amount` is > 0, so only the product pool is tested. Mirrors `guard::shift`.
#must_use
#pure
fn _ry_guard_shift(amount: f64, substrate: f64, product: f64): f64 {
    if (amount < 0.0) {
        var back: f64 = -amount;
        if (product > 0.0) {
            if (product < back) { back = product; }
        } else {
            back = 0.0;
        }
        var r: f64 = -back;
        return r;
    }
    if (amount > 0.0 && substrate > 0.0) {
        if (substrate < amount) { return substrate; }
        return amount;
    }
    return 0.0;
}

# --- integrate.cyr ---

# integrate.cyr — exact one-step updates for the linear ODEs that recur across modules (Rust 1.2.0's crate-private
# `integrate.rs`, transcribed).
#
# Explicit Euler (`x += (p - k·x)·dt`) overshoots and oscillates once `k·dt > 1` and goes unstable past `k·dt > 2`,
# which game-engine frame times or coarse simulation steps hit easily. Each helper here solves its ODE in closed form
# over `dt` with the inputs held constant for the step (to ~1e-9 relative for small steps, where a short series
# replaces `exp`), so the result is stable for any `dt`, never overshoots its target, and keeps a fraction inside
# `[0, 1]`. Callers pass a valid `dt` (`_ry_guard_valid_dt`) and sanitized, finite inputs.
#
# Names: Rust's crate-private `integrate::<fn>` is `_ry_integrate_<fn>` (src/guard.cyr's rule). The constants are
# generated (src/constants_private.cyr): `_RY_INTEGRATE_SERIES_MAX` and step_factors' fn-local C1..C4. Every operation
# is in Rust's order (P9): the parity rows compare the series branch at ≤ 2 ulp (class B, expected 0) and the
# `exp_m1` branch at 0 ulp against the corrected oracle (class C, ADR 0003; `_ry_cr_expm1`).

# Step factors for `y = k·dt >= 0`: `(e^(−y), (1 − e^(−y)) / y)`.
#
# For `y < SERIES_MAX` the second factor `g` is its Maclaurin series through `y⁴` (relative truncation
# `< y⁵/720 ≈ 1.3e-9`), evaluated with Estrin's scheme in Rust's grouping; the first factor is `1 − y·g`, so
# `f + y·g == 1` holds to rounding, which keeps _ry_integrate_activate inside `[0, 1]`. Larger steps (and a NaN y)
# use `exp_m1`, accurate for all y. Mirrors `integrate::step_factors`.
#must_use
#pure
fn _ry_integrate_step_factors(y: f64): (f64, f64) {
    if (y < _RY_INTEGRATE_SERIES_MAX) {
        var y2: f64 = y * y;
        # Rust's `(1.0 + C1 * y) + y2 * ((C2 + C3 * y) + y2 * C4)`, its two groups named; each rounds to f64 either way.
        var lo: f64 = 1.0 + _RY_INTEGRATE_C1 * y;
        var hi: f64 = (_RY_INTEGRATE_C2 + _RY_INTEGRATE_C3 * y) + y2 * _RY_INTEGRATE_C4;
        var g: f64 = lo + y2 * hi;
        var f: f64 = 1.0 - y * g;
        return (f, g);
    }
    var ny: f64 = -y;
    var em1: f64 = _ry_cr_expm1(ny);
    var fe: f64 = 1.0 + em1;
    var nem1: f64 = -em1;
    var ge: f64 = nem1 / y;
    return (fe, ge);
}

# Relaxes `x` toward `target` at first-order `rate` (1/s), `dx/dt = rate·(target − x)`, over `dt`. A non-positive
# `rate` leaves `x` unchanged. Mirrors `integrate::relax`.
#must_use
#pure
fn _ry_integrate_relax(x: f64, target: f64, rate: f64, dt: f64): f64 {
    if (rate <= 0.0) { return x; }
    var y: f64 = rate * dt;
    var decay, _g = _ry_integrate_step_factors(y);
    var r: f64 = target + (x - target) * decay;
    return r;
}

# Zero-order production with first-order decay, `dx/dt = production − decay·x`, over `dt`: `x·e^(−k·dt) +
# p·(1 − e^(−k·dt))/k`, without dividing by k. With `decay <= 0` it degenerates to `x + production·dt`. For `x >= 0`
# and `production >= 0` the result is `>= 0`. Mirrors `integrate::produce_decay`.
#must_use
#pure
fn _ry_integrate_produce_decay(x: f64, production: f64, decay: f64, dt: f64): f64 {
    if (decay <= 0.0) {
        var lin: f64 = x + production * dt;
        return lin;
    }
    var y: f64 = decay * dt;
    var f, g = _ry_integrate_step_factors(y);
    var r: f64 = x * f + production * dt * g;
    return r;
}

# Two-state activation, `dx/dt = on·(1 − x) − off·x`, where `x` is the active fraction and `on` / `off` are the
# (non-negative) forward and reverse rate constants for this step: the steady state on/total approached at rate total,
# written without a division as `x·e^(−T·dt) + on·dt·g(T·dt)`. For `x` in `[0, 1]` the result stays in `[0, 1]`: the
# exact result is <= 1, and `min(.., 1.0)` absorbs a possible 1-ulp rounding excess. A non-positive `on + off` leaves
# `x` unchanged. Mirrors `integrate::activate`.
#must_use
#pure
fn _ry_integrate_activate(x: f64, on: f64, off: f64, dt: f64): f64 {
    var total: f64 = on + off;
    if (total <= 0.0) { return x; }
    var y: f64 = total * dt;
    var f, g = _ry_integrate_step_factors(y);
    var a: f64 = x * f + on * dt * g;
    var r: f64 = _ry_min(a, 1.0);
    return r;
}

# --- logging.cyr ---

# logging.cyr — rasayan's logging setup (Rust 1.2.0's `logging.rs`) and the helpers its 31 `tracing` events port
# through (ADR 0002 rows 7–8), on lib/log.cyr and sakshi.
#
# ── RASAYAN_LOG ──
# ry_log_init / ry_log_init_with_level set the level from the RASAYAN_LOG environment variable, as Rust's
# `EnvFilter::try_from_env("RASAYAN_LOG").unwrap_or_else(|_| EnvFilter::new(default_level))` does, for the directives
# whose effect is one level for every rasayan target (ADR 0002 row 8). A value is a comma-separated list of items, each
# empty, a level word, or `rasayan` / `rasayan=` / `rasayan=<level word>`. A level word is a level name in any case
# (`trace` `debug` `info` `warn` `error` `off`) or a decimal 0–5 (`0` off … `5` trace, leading zeros allowed; after
# `rasayan=` a leading `+` too, as Rust's `usize` parse takes it). `rasayan` and `rasayan=` enable every level, as Rust
# reads a target with no level. The level is the last `rasayan` item's when there is one, else the last level word's;
# a list with no item at all (`""`, `","`) is OFF, as Rust's filter with no directive enables nothing.
#
# Anything else — blanks, another or a per-module target (`rasayan::pathway=debug`), span and field directives,
# misspelled levels — is refused with one warning, and the default applies. Rust reads some of those as directives the
# port doesn't carry (a misspelled level is a target there, so rasayan goes silent), and refuses the rest itself; the
# parity rows (tests/golden/logging.tsv) compare every form, and the refused ones whose Rust level differs are ADR 0002
# row 8's.
#
# The default (`"info"` for ry_log_init) is read by the same rules, except that a list with no item is ERROR, as Rust's
# `EnvFilter::new` uses its ERROR default directive then; a default the rules refuse is ERROR, with a warning.
#
# Levels are lib/log.cyr's LOG_TRACE … LOG_ERROR, and RY_LOG_OFF for off. Rust's filter is the process's; so is
# sakshi's level, which every library on sakshi shares.
#
# ── events ──
# Rust emits 31 events (25 `trace!`, 5 `debug!`, 1 `warn!`) and opens no span. Each ports as a block that tests the
# level first and builds the event only when it passes (M0 probe 8: ~11 ns filtered out), in a stack buffer:
#
#     if (_ry_trace_on() == 1) {
#         var h[24];
#         var b[256];
#         var e = _ry_ev(&h, &b, 256, "rasayan::calcium", "calcium_tick");
#         _ry_ev_f(e, "dt", dt);
#         _ry_ev_f(e, "ca", ca);
#         _ry_trace(e);
#     }
#
# The text is what Rust's fmt layer prints after the level: `<target>: <message> <key>=<value> …`, an f64 in Display
# form (`src/fmtf.cyr`; Rust's layer writes Debug, `1.0` for `1`: the log format is sakshi's and is not compared). No
# sakshi span is used: sakshi's span calls never test the level (probe 8: 204 ns filtered out).

# The level that lets no event through: lib/log.cyr's LOG_FATAL + 1 (Rust's LevelFilter::OFF).
const RY_LOG_OFF = 6;

# ── RASAYAN_LOG ──

# Rust's `LevelFilter::from_str` on the non-empty text [p, p + n): a level name in any case or a decimal 0–5, with a
# leading `+` only when `plus` is 1. The LOG_* level (RY_LOG_OFF for `off` and 0), or -1.
#must_use
fn _ry_log_word(p, n, plus): i64 {
    if (n <= 0) { return 0 - 1; }
    var k = 0;
    if (plus == 1 && load8(p) == 43) { k = 1; }
    if (k < n) {
        var digits = 1;
        var v = 0;
        var j = k;
        while (j < n) {
            var c = load8(p + j);
            if (c < 48 || c > 57) { digits = 0; break; }
            if (v <= 5) { v = v * 10 + (c - 48); }
            j = j + 1;
        }
        if (digits == 1) {
            if (v == 0) { return RY_LOG_OFF; }
            if (v == 1) { return LOG_ERROR; }
            if (v == 2) { return LOG_WARN; }
            if (v == 3) { return LOG_INFO; }
            if (v == 4) { return LOG_DEBUG; }
            if (v == 5) { return LOG_TRACE; }
            return 0 - 1;
        }
    }
    if (n < 3 || n > 5) { return 0 - 1; }
    var buf[8];
    var i = 0;
    while (i < n) {
        var ch = load8(p + i);
        if (ch >= 65 && ch <= 90) { ch = ch + 32; }
        store8(&buf + i, ch);
        i = i + 1;
    }
    if (n == 5 && memeq(&buf, "trace", 5) == 1) { return LOG_TRACE; }
    if (n == 5 && memeq(&buf, "debug", 5) == 1) { return LOG_DEBUG; }
    if (n == 4 && memeq(&buf, "info", 4) == 1) { return LOG_INFO; }
    if (n == 4 && memeq(&buf, "warn", 4) == 1) { return LOG_WARN; }
    if (n == 5 && memeq(&buf, "error", 5) == 1) { return LOG_ERROR; }
    if (n == 3 && memeq(&buf, "off", 3) == 1) { return RY_LOG_OFF; }
    return 0 - 1;
}

# The level a RASAYAN_LOG-style list [p, p + n) names (the header's rules), `empty` for a list with no item, or -1
# when an item is refused.
#must_use
fn _ry_log_list(p, n, empty): i64 {
    var global = 0 - 1;
    var target = 0 - 1;
    var at = 0;
    while (at <= n) {
        var end = at;
        while (end < n && load8(p + end) != 44) { end = end + 1; }
        var len = end - at;
        if (len > 0) {
            var q = p + at;
            if (len >= 7 && memeq(q, "rasayan", 7) == 1) {
                # `rasayan` and `rasayan=` enable every level; `rasayan=<level word>` sets one; any other text after
                # `rasayan` is another target (`rasayanx`, `rasayan::pathway`, `rasayan[span]`), refused.
                if (len == 7) {
                    target = LOG_TRACE;
                } elif (load8(q + 7) != 61) {
                    return 0 - 1;
                } elif (len == 8) {
                    target = LOG_TRACE;
                } else {
                    var lv = _ry_log_word(q + 8, len - 8, 1);
                    if (lv < 0) { return 0 - 1; }
                    target = lv;
                }
            } else {
                var gl = _ry_log_word(q, len, 0);
                if (gl < 0) { return 0 - 1; }
                global = gl;
            }
        }
        at = end + 1;
    }
    if (target >= 0) { return target; }
    if (global >= 0) { return global; }
    return empty;
}

# The level a RASAYAN_LOG value [p, p + n) names: LOG_TRACE … LOG_ERROR or RY_LOG_OFF (also for a value with no
# item, `""` or `","`), or -1 when the port refuses it (the header's rules).
#must_use
fn ry_log_parse(p, n): i64 {
    return _ry_log_list(p, n, RY_LOG_OFF);
}

# The level logging gets from a RASAYAN_LOG value [env, env + env_len) (env 0: the variable is unset) and the default
# `default_level` (a C string): the value's when the port reads it, else the default's (ERROR for a default with no
# item, or one the port refuses). Mirrors the filter `logging::init_with_level` builds; changes nothing.
#must_use
fn ry_log_level_of(env, env_len, default_level): i64 {
    if (env != 0) {
        var lv = _ry_log_list(env, env_len, RY_LOG_OFF);
        if (lv >= 0) { return lv; }
    }
    var dl = _ry_log_list(default_level, strlen(default_level), LOG_ERROR);
    if (dl >= 0) { return dl; }
    return LOG_ERROR;
}

# Applies a level to lib/log.cyr and sakshi. RY_LOG_OFF sets sakshi below its FATAL level, so no event passes.
fn _ry_log_apply(level): i64 {
    if (level >= RY_LOG_OFF) {
        log_set_level(RY_LOG_OFF);
        sakshi_set_level(SK_FATAL - 1);
        return level;
    }
    log_init(level);
    return level;
}

# Sets rasayan's log level from RASAYAN_LOG, or from `default_level` (a C string) when the variable is unset or names
# what the port refuses; a default the port refuses is ERROR. Each refusal warns once (after the level is applied, so
# a level above WARN hides it). Returns the level applied: LOG_TRACE … LOG_ERROR or RY_LOG_OFF. Safe to call again: the
# later call's level replaces the earlier one (Rust keeps the first subscriber; its level never changes). Mirrors
# `logging::init_with_level`.
fn ry_log_init_with_level(default_level): i64 {
    var env = getenv("RASAYAN_LOG");
    var en = 0;
    if (env != 0) { en = strlen(env); }
    var lv = ry_log_level_of(env, en, default_level);
    _ry_log_apply(lv);
    var env_refused = 0;
    if (env != 0 && ry_log_parse(env, en) < 0) {
        env_refused = 1;
        log_warn("rasayan: RASAYAN_LOG refused (not a list of levels or rasayan=<level>): default used");
    }
    if ((env == 0 || env_refused == 1) && _ry_log_list(default_level, strlen(default_level), LOG_ERROR) < 0) {
        log_warn("rasayan: default log level refused: error used");
    }
    return lv;
}

# Sets rasayan's log level from RASAYAN_LOG, defaulting to `info`. Returns the level applied. Mirrors `logging::init`.
fn ry_log_init(): i64 {
    return ry_log_init_with_level("info");
}

# ── events ──

# 1 when TRACE events pass: the gate a `trace!` block tests before it builds anything.
#must_use
#inline
fn _ry_trace_on(): i64 {
    return sakshi_get_level() >= SK_TRACE;
}

# 1 when DEBUG events pass.
#must_use
#inline
fn _ry_debug_on(): i64 {
    return sakshi_get_level() >= SK_DEBUG;
}

# 1 when WARN events pass.
#must_use
#inline
fn _ry_warn_on(): i64 {
    return sakshi_get_level() >= SK_WARN;
}

# Starts an event's text, `<target>: <message>` (C strings), in a str_builder over the caller's buffer: header `hdr`
# (24 bytes) on `buf` of `cap` bytes. Returns the builder.
fn _ry_ev(hdr, buf, cap, target, msg): i64 {
    var sb = _ry_sb_on(hdr, buf, cap);
    str_builder_add_cstr(sb, target);
    str_builder_add_cstr(sb, ": ");
    str_builder_add_cstr(sb, msg);
    return sb;
}

# Appends the field ` <key>=<x>`, x in Display form (Rust's `dt`, `atp = self.atp`).
fn _ry_ev_f(sb, key, x: f64) {
    str_builder_putc(sb, 32);
    str_builder_add_cstr(sb, key);
    str_builder_putc(sb, 61);
    _ry_fmt_f64_display(sb, x);
    return 0;
}

# Appends the field ` <key>=<n>`, an integer (Rust's `prompt_len = question.len()`, `max_steps`).
fn _ry_ev_i(sb, key, n) {
    str_builder_putc(sb, 32);
    str_builder_add_cstr(sb, key);
    str_builder_putc(sb, 61);
    str_builder_add_int(sb, n);
    return 0;
}

# Appends the field ` <key>=true` or ` <key>=false` (Rust's `installed`).
fn _ry_ev_b(sb, key, b) {
    str_builder_putc(sb, 32);
    str_builder_add_cstr(sb, key);
    if (b != 0) {
        str_builder_add_cstr(sb, "=true");
    } else {
        str_builder_add_cstr(sb, "=false");
    }
    return 0;
}

# Appends the field ` <key>=<text>`, the `n` bytes at `p` (Rust's `%` Display of a string: `model = %self.model`).
fn _ry_ev_s(sb, key, p, n) {
    str_builder_putc(sb, 32);
    str_builder_add_cstr(sb, key);
    str_builder_putc(sb, 61);
    var i = 0;
    while (i < n) {
        str_builder_putc(sb, load8(p + i));
        i = i + 1;
    }
    return 0;
}

# Emits the event built in `sb` at TRACE (Rust's `tracing::trace!`).
fn _ry_trace(sb) {
    sakshi_trace(load64(sb), load64(sb + 8));
    return 0;
}

# Emits the event built in `sb` at DEBUG (Rust's `tracing::debug!`).
fn _ry_debug(sb) {
    sakshi_debug(load64(sb), load64(sb + 8));
    return 0;
}

# Emits the event built in `sb` at WARN (Rust's `tracing::warn!`).
fn _ry_warn(sb) {
    sakshi_warn(load64(sb), load64(sb + 8));
    return 0;
}

# --- json.cyr ---

# json.cyr — the shared JSON helpers behind every rasayan type's codec (P7, ADR 0004 and its amendment).
#
# rasayan writes the documents serde_json 1.0.154 writes for the Rust crate's 69 serializable types, so a Rust
# program's JSON (saved states and configs, MCP tool results) passes through unchanged. tests/golden/json.tsv pins
# each helper against serde_json itself; each type's codec (from M2) writes its fields in Rust's declaration order
# with these, and its documents join its module's rows.
#
# ── writers ──
# Each appends to a str_builder `sb` and takes the allocator `a` the builder grows on (lib/alloc.cyr; `default_alloc()`
# for a builder from str_builder_new), as lib/str.cyr's `_a` forms do. It first reserves room for the most it can
# write through the non-aborting grow (`_sb_grow_a`), then writes: once the room is there, the puts underneath (the
# vendored printer's, lib/str.cyr's escaper's) never grow the builder, so they never reach lib/str.cyr's `_sb_die`,
# which exits the process when a grow is refused (ADR 0004's amendment; rasayan's addendum to the open vec issue).
# Each returns 0, or -1 when the room was refused, having written nothing; a codec ORs the results and returns
# Err(RY_ERR_OUT_OF_MEMORY) for a nonzero total:
#
#     var e = _ry_jw_byte(a, sb, 123);
#     e = e | _ry_jw_key(a, sb, "atp", 1);
#     e = e | _ry_jw_f64(a, sb, s.atp);
#     e = e | _ry_jw_byte(a, sb, 125);
#     if (e != 0) { return Err(RY_ERR_OUT_OF_MEMORY); }
#
# The forms are serde_json's: an f64 by fmtf's serde_json form (`null` for NaN and ±inf: serde_json writes them so and
# refuses them on read); a string with serde_json's escapes (`\"` `\\` `\b` `\t` `\n` `\f` `\r`, `\u00xx` in lowercase
# hex for the other bytes below 0x20, everything else, DEL and UTF-8 included, as is); a char as a one-character
# string; integers in decimal, a usize as unsigned; None as `null`; a fixed array as a JSON array; a unit enum variant
# as its name in quotes.

# The most bytes fmtf's serde_json form writes for one f64 (24: `-2.2250738585072014e-308`), rounded up.
const _RY_JW_F64_MAX = 32;

# Reserves room for `n` more bytes in `sb` on allocator `a`: 0, or -1 when the allocator refused it.
#must_use
fn _ry_jw_reserve(a, sb, n): i64 {
    if (n < 0) { return 0 - 1; }
    return _sb_grow_a(a, sb, n);
}

# Appends the byte `c` (`{`, `}`, `[`, `]`, `,`). 0, or -1.
fn _ry_jw_byte(a, sb, c): i64 {
    if (_ry_jw_reserve(a, sb, 1) != 0) { return 0 - 1; }
    str_builder_putc(sb, c);
    return 0;
}

# Appends `"name":` (C string `name`, a Rust field name: no escapes needed), preceded by a comma unless `first` is 1.
# 0, or -1.
fn _ry_jw_key(a, sb, name, first): i64 {
    var n = strlen(name);
    if (_ry_jw_reserve(a, sb, n + 4) != 0) { return 0 - 1; }
    if (first != 1) { str_builder_putc(sb, 44); }
    str_builder_putc(sb, 34);
    str_builder_add_cstr(sb, name);
    str_builder_putc(sb, 34);
    str_builder_putc(sb, 58);
    return 0;
}

# Appends x as serde_json writes an f64 (`null` for NaN and ±inf). 0, or -1.
fn _ry_jw_f64(a, sb, x: f64): i64 {
    if (_ry_jw_reserve(a, sb, _RY_JW_F64_MAX) != 0) { return 0 - 1; }
    _ry_fmt_f64_json(sb, x);
    return 0;
}

# Appends the `n` bytes at `p` (UTF-8: a Rust String or &str) as a JSON string, escaped as serde_json escapes it.
# At most 6 bytes per byte plus the quotes. 0, or -1.
fn _ry_jw_str(a, sb, p, n): i64 {
    if (n < 0 || _ry_jw_reserve(a, sb, 6 * n + 2) != 0) { return 0 - 1; }
    var t[16];
    store64(&t, p);
    store64(&t + 8, n);
    str_builder_add_json_str(sb, &t);
    return 0;
}

# Appends a Rust char, the `n` UTF-8 bytes at `p` (1–4), as serde_json writes it: a one-character string. 0, or -1.
fn _ry_jw_char(a, sb, p, n): i64 {
    if (n < 1 || n > 4) { return 0 - 1; }
    return _ry_jw_str(a, sb, p, n);
}

# Appends the word `n` as an unsigned decimal (a Rust usize or u32: a usize at or past 2^63 is a negative i64 here).
# 0, or -1.
fn _ry_jw_u64(a, sb, n): i64 {
    if (_ry_jw_reserve(a, sb, 20) != 0) { return 0 - 1; }
    if (n >= 0) {
        str_builder_add_int(sb, n);
        return 0;
    }
    # n read unsigned is v = 2^64 + n: write v / 10, then its last digit. (v >> 1) / 5 = v / 10, with the shift made
    # logical by the mask; v - 10 * (v / 10) wraps to the digit.
    var q = ((n >> 1) & 0x7FFFFFFFFFFFFFFF) / 5;
    var d = n - q * 10;
    str_builder_add_int(sb, q);
    str_builder_putc(sb, 48 + d);
    return 0;
}

# Appends the signed integer `n` in decimal (a Rust i32). 0, or -1.
fn _ry_jw_i64(a, sb, n): i64 {
    if (_ry_jw_reserve(a, sb, 20) != 0) { return 0 - 1; }
    str_builder_add_int(sb, n);
    return 0;
}

# Appends `null` (Rust's None). 0, or -1.
fn _ry_jw_null(a, sb): i64 {
    if (_ry_jw_reserve(a, sb, 4) != 0) { return 0 - 1; }
    str_builder_add_cstr(sb, "null");
    return 0;
}

# Appends an Option<f64>: `null` when `has` is 0, else x as an f64. 0, or -1.
fn _ry_jw_opt_f64(a, sb, has, x: f64): i64 {
    if (has == 0) { return _ry_jw_null(a, sb); }
    return _ry_jw_f64(a, sb, x);
}

# Appends the `n` f64s at `p` as a JSON array (a Rust `[f64; n]`). 0, or -1.
fn _ry_jw_f64_array(a, sb, p, n): i64 {
    if (n < 0 || _ry_jw_reserve(a, sb, n * (_RY_JW_F64_MAX + 1) + 2) != 0) { return 0 - 1; }
    str_builder_putc(sb, 91);
    var k = 0;
    while (k < n) {
        if (k > 0) { str_builder_putc(sb, 44); }
        var x: f64 = load64(p + 8 * k);
        _ry_fmt_f64_json(sb, x);
        k = k + 1;
    }
    str_builder_putc(sb, 93);
    return 0;
}

# Appends a struct of `n` f64 fields at `w`, named by the NUL-separated list `names` (Rust's declaration order), as
# serde_json writes it, one JSON object: 0, or -1 when the builder could not grow (nothing past the refused write is
# written). The writer counterpart of _ry_jr_f64_fields.
fn _ry_jw_f64_fields(a, sb, w, n, names): i64 {
    var e = _ry_jw_byte(a, sb, 123);
    var name = names;
    var k = 0;
    while (k < n) {
        var first = 0;
        if (k == 0) { first = 1; }
        e = e | _ry_jw_key(a, sb, name, first);
        var x: f64 = load64(w + 8 * k);
        e = e | _ry_jw_f64(a, sb, x);
        name = name + strlen(name) + 1;
        k = k + 1;
    }
    e = e | _ry_jw_byte(a, sb, 125);
    return e;
}

# Appends a unit enum variant as serde writes it: its name (C string, a Rust identifier) in quotes. 0, or -1.
fn _ry_jw_unit(a, sb, name): i64 {
    var n = strlen(name);
    if (_ry_jw_reserve(a, sb, n + 2) != 0) { return 0 - 1; }
    str_builder_putc(sb, 34);
    str_builder_add_cstr(sb, name);
    str_builder_putc(sb, 34);
    return 0;
}

# ── readers ──
# Readers parse with bayan's value tree on the caller's allocator (`bayan_json_v_parse_buf_a`; an arena reset per
# document keeps nothing past what the caller resets) and apply serde's derive rules, as serde_json 1.0.154 applies
# them (tests/golden/json.tsv pins each against serde_json's decisions):
# - a struct reads from an object, by field name (any order; unknown fields ignored, however deep) or from an array of
#   exactly its field count (by position, serde's sequence form); a missing field, a field of the wrong JSON type, a
#   repeated field, or a key that is not valid UTF-8 refuses the document;
# - an f64 takes a JSON float or integer, never `null`, and never a number that parsed to ±inf (`1e400`; bayan reads
#   it as ±inf, serde_json refuses it); bayan's parse is correctly rounded, where serde_json's (no `float_roundtrip`)
#   misrounds some, so the value is the correctly rounded one (ADR 0004's amendment);
# - an integer field takes a JSON integer in its type's range, never a float (`1.0`, `1e2`);
# - a string must be valid UTF-8 once decoded (a lone surrogate escape refuses); a char is one Unicode scalar;
# - Option<f64>: `null` is None, anything else an f64;
# - a raw control byte (U+0000–U+001F unescaped) in any string, read or not, refuses the document (serde_json scans
#   every string; bayan accepts them: its filed issue). An unread string's UTF-8 is not checked, as serde_json skips
#   it unread.
# A refusal is a 0 from each helper; a codec returns Err(RY_ERR_DESERIALIZE). Where bayan refuses what serde_json reads
# — a repeated key in an unread member, an integer at or past 2^63, nesting past 128 levels in an unread member, a
# lone surrogate escape in an unread string — the document is refused, and an integer `-0` reads as +0 (serde_json:
# −0.0 for an f64, a refusal for an integer). Each is a filed bayan issue and an ADR 0004 mapped row.

# 1 when the `n` bytes at `p` are well-formed UTF-8 (RFC 3629: no overlong forms, no surrogates, nothing past
# U+10FFFF), else 0.
#must_use
fn _ry_utf8_valid(p, n): i64 {
    var i = 0;
    while (i < n) {
        var c = load8(p + i);
        if (c < 128) {
            i = i + 1;
            continue;
        }
        var need = 0;
        var lo = 128;
        var hi = 191;
        if (c >= 194 && c <= 223) { need = 1; }
        elif (c == 224) { need = 2; lo = 160; }
        elif (c >= 225 && c <= 236) { need = 2; }
        elif (c == 237) { need = 2; hi = 159; }
        elif (c >= 238 && c <= 239) { need = 2; }
        elif (c == 240) { need = 3; lo = 144; }
        elif (c >= 241 && c <= 243) { need = 3; }
        elif (c == 244) { need = 3; hi = 143; }
        else { return 0; }
        if (i + need >= n) { return 0; }
        var c1 = load8(p + i + 1);
        if (c1 < lo || c1 > hi) { return 0; }
        var k = 2;
        while (k <= need) {
            var ck = load8(p + i + k);
            if (ck < 128 || ck > 191) { return 0; }
            k = k + 1;
        }
        i = i + need + 1;
    }
    return 1;
}

# 1 when no string in the `n`-byte document at `buf` holds a raw control byte (RFC 8259 §7; serde_json refuses one,
# read or not; bayan 1.11.1 does not, and once decoded it can't be told from its escape), else 0.
#must_use
fn _ry_jr_raw_ok(buf, n): i64 {
    var inside = 0;
    var i = 0;
    while (i < n) {
        var c = load8(buf + i);
        if (inside == 1) {
            if (c < 32) { return 0; }
            if (c == 92) { i = i + 1; }
            elif (c == 34) { inside = 0; }
        } elif (c == 34) {
            inside = 1;
        }
        i = i + 1;
    }
    return 1;
}

# The value tree of the `n`-byte document at `buf`, built on allocator `a`, or 0 when it is not one JSON value (or
# holds a raw control byte in a string).
#must_use
fn _ry_jr_parse(a, buf, n): i64 {
    if (buf == 0 || n < 0) { return 0; }
    if (_ry_jr_raw_ok(buf, n) == 0) { return 0; }
    return bayan_json_v_parse_buf_a(a, buf, n);
}

# The form of struct node `v` with `nfields` fields: 1 an object whose keys are valid UTF-8, 2 an array of exactly
# `nfields` elements (serde's sequence form), 0 anything else.
#must_use
fn _ry_jr_form(v, nfields): i64 {
    if (v == 0) { return 0; }
    var t = bayan_json_v_tag(v);
    if (t == JTAG_OBJ) {
        var k = 0;
        var nk = bayan_json_v_obj_len(v);
        while (k < nk) {
            var key = bayan_json_v_obj_key(v, k);
            if (_ry_utf8_valid(str_data(key), str_len(key)) == 0) { return 0; }
            k = k + 1;
        }
        return 1;
    }
    if (t == JTAG_ARR && bayan_json_v_arr_len(v) == nfields) { return 2; }
    return 0;
}

# Field `i`, named `name` (a C string), of struct node `v` in `form`: its value node, or 0 when absent.
#must_use
fn _ry_jr_at(v, form, i, name): i64 {
    if (form == 1) { return bayan_json_v_obj_get_by_cstr(v, name); }
    if (form == 2) { return bayan_json_v_arr_get(v, i); }
    return 0;
}

# A JSON number as an f64 into *out: 1, or 0 for any other value (`null` included) and for a number that parsed to
# ±inf (serde_json: "number out of range"). An integer converts to the nearest f64, ties to even, as serde converts.
#must_use
fn _ry_jr_f64(v, out): i64 {
    if (v == 0) { return 0; }
    var t = bayan_json_v_tag(v);
    if (t == JTAG_FLOAT) {
        var w = bayan_json_v_float(v);
        if ((w & 0x7FF0000000000000) == 0x7FF0000000000000) { return 0; }
        store64(out, w);
        return 1;
    }
    if (t == JTAG_INT) {
        store64(out, bayan_json_v_float(v));
        return 1;
    }
    return 0;
}

# An Option<f64> into *has and *out: `null` is None (*has 0), any other value an f64 (*has 1). 1, or 0 when serde
# would refuse it.
#must_use
fn _ry_jr_opt_f64(v, has, out): i64 {
    if (v == 0) { return 0; }
    if (bayan_json_v_tag(v) == JTAG_NULL) {
        store64(has, 0);
        store64(out, 0);
        return 1;
    }
    if (_ry_jr_f64(v, out) == 0) { return 0; }
    store64(has, 1);
    return 1;
}

# A JSON integer in [min, max] into *out (a Rust u32, i32 or usize: serde takes no float, not even `1.0`). 1, or 0.
#must_use
fn _ry_jr_int(v, min, max, out): i64 {
    if (v == 0 || bayan_json_v_tag(v) != JTAG_INT) { return 0; }
    var n = bayan_json_v_int(v);
    if (n < min || n > max) { return 0; }
    store64(out, n);
    return 1;
}

# A JSON string's bytes, UTF-8-checked, without a copy: its pointer into *out_p and its byte length (which may hold a
# decoded U+0000) into *out_n, both into the tree. 1, or 0 for any other value or invalid UTF-8.
#must_use
fn _ry_jr_str(v, out_p, out_n): i64 {
    if (v == 0 || bayan_json_v_tag(v) != JTAG_STR) { return 0; }
    var s = bayan_json_v_str(v);
    var p = str_data(s);
    var n = str_len(s);
    if (_ry_utf8_valid(p, n) == 0) { return 0; }
    store64(out_p, p);
    store64(out_n, n);
    return 1;
}

# A Rust char: a JSON string of exactly one Unicode scalar, its UTF-8 bytes (1–4) into *out_p / *out_n. 1, or 0.
#must_use
fn _ry_jr_char(v, out_p, out_n): i64 {
    if (_ry_jr_str(v, out_p, out_n) == 0) { return 0; }
    var p = load64(out_p);
    var n = load64(out_n);
    if (n < 1 || n > 4) { return 0; }
    var c = load8(p);
    var want = 1;
    if (c >= 240) { want = 4; }
    elif (c >= 224) { want = 3; }
    elif (c >= 192) { want = 2; }
    if (n != want) { return 0; }
    return 1;
}

# A JSON array of exactly `n` f64s into the `n` words at `w` (a Rust `[f64; n]`). 1, or 0.
#must_use
fn _ry_jr_f64_array(v, w, n): i64 {
    if (v == 0 || bayan_json_v_tag(v) != JTAG_ARR || bayan_json_v_arr_len(v) != n) { return 0; }
    var k = 0;
    while (k < n) {
        if (_ry_jr_f64(bayan_json_v_arr_get(v, k), w + 8 * k) == 0) { return 0; }
        k = k + 1;
    }
    return 1;
}

# A struct of `n` f64 fields, named by the NUL-separated list `names` (`"p_na\0p_k\0p_cl\0"`, Rust's declaration
# order), read from node `v` by serde's rules into the `n` words at `w`. 1, or 0 when serde would refuse it.
#must_use
fn _ry_jr_f64_fields(v, w, n, names): i64 {
    var form = _ry_jr_form(v, n);
    if (form == 0) { return 0; }
    var name = names;
    var k = 0;
    while (k < n) {
        if (_ry_jr_f64(_ry_jr_at(v, form, k, name), w + 8 * k) == 0) { return 0; }
        name = name + strlen(name) + 1;
        k = k + 1;
    }
    return 1;
}

# --- protein_data.cyr ---

# rasayan — protein data: the 20 amino acids, the lookup index, the pKa sets and the Chou-Fasman tables
#
# GENERATED from rasayan 1.2.0's source (rust-old/, the functional spec, read as text). Do not edit.
# Checked: python3 -I -B scripts/oracle/validate.py . (every value against that source)
#
# Public (RY_): AMINO_ACIDS, from rasayan 1.2.0, as one column per field indexed by
# AMINO_ACIDS row; RY_AMINO_ACID_<ABBR> is each row. A char is its ASCII byte (u8), a
# string a NUL-terminated byte blob with u16 offsets (&BYTES + OFF[i] is row i's C string),
# an Option<f64> a HAS_ bool column beside its value (0.0 for None).
#
# Private (_RY_PROTEIN_): each item is read from rust-old/src/protein.rs, never re-typed:
# literals by Rust's f64::from_str, references and the const fn rows evaluated as Rust's
# const evaluation does. A table of structs or tuples is one column per field; a 2-D table
# is row-major (row k, column j at k * cols + j).
#
# f64 cells are round-trip decimals, written out positionally. tests/golden/protein.tsv
# pins every cell: the public ones through the API (AMINO_ACIDS[i], lookup), the private
# ones as read from the source.

# Sentinel in [`LOOKUP_INDEX`] for letters that are not a standard residue.
# Rust: rasayan::protein::NO_RESIDUE (private) = u8::MAX
const _RY_PROTEIN_NO_RESIDUE = 255;

# `'A'..='Z'` → index into [`AMINO_ACIDS`] ([`NO_RESIDUE`] if none).
# Built at compile time from the table itself so the two cannot drift.
# Rust: rasayan::protein::LOOKUP_INDEX (private; build_lookup_index())
# Indexed by letter - 'A' (uppercase).
var _RY_PROTEIN_LOOKUP_INDEX: u8[26] = {
    0,  # A -> Ala
    255,  # B (NO_RESIDUE)
    1,  # C -> Cys
    2,  # D -> Asp
    3,  # E -> Glu
    4,  # F -> Phe
    5,  # G -> Gly
