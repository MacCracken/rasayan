const RY_PI3K_PI3K_CONFIG_DEFAULT_PTEN_RATE = 0.3;

# Akt phosphorylation Vmax (s^-1 per unit inactive Akt).
# Rust: rasayan::pi3k::Pi3kConfig::default().akt_vmax
const RY_PI3K_PI3K_CONFIG_DEFAULT_AKT_VMAX = 0.6;

# PIP3 level giving half-maximal Akt activation (must be > 0).
