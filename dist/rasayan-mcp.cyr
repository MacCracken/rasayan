# --- signaling.cyr ---

# rasayan — src/signaling.cyr: the signaling network (rust-old/src/signaling.rs)
#
# MAPK, PI3K/Akt/mTOR, JAK-STAT and calcium oscillations together, with cross-pathway interactions, each from the
# network state at the start of the tick:
# - Ras → PI3K: PI3K's input is unit(growth_factor + ras_gtp · ras_pi3k_crosstalk);
# - Akt → Raf: unit(akt_active) · akt_raf_inhibition (s^-1) joins Raf's first-order deactivation for the tick
#   (MAPK's crate-private tick_with_raf_inhibition), so the effect reaches MEK and ERK within the tick;
# - Ca2+ → Ras: MAPK's input is unit(growth_factor + unit(cytoplasmic_ca) · ca_ras_crosstalk) (RasGRP).
# JAK-STAT runs uncoupled. Every crosstalk gain defaults to 0: four decoupled pathways.
#
# The Cyrius forms (ADR 0002 row 7): the network is one record of the four pathway states at fixed offsets (as
# src/pathway.cyr's network), advanced in place; the flux fills the caller's record. Every operation is in the
# source's order (P9).

# ── the types ──

# The unified signaling network state: the four pathway states, in declaration order.
struct RySignalingNetwork {
    mapk: RyMapkState;
    pi3k: RyPi3kState;
    jak_stat: RyJakStatState;
    calcium: RyCalciumState;
}

# Configuration for the signaling network: the four pathways' parameters and the three crosstalk gains (each >= 0,
# default 0).
struct RySignalingConfig {
    mapk: RyMapkConfig;
    pi3k: RyPi3kConfig;
    jak_stat: RyJakStatConfig;
    calcium: RyCalciumConfig;
    ras_pi3k_crosstalk: f64;
    akt_raf_inhibition: f64;
    ca_ras_crosstalk: f64;
}

# The combined signaling flux: the four pathways' fluxes; all zero for an invalid dt.
struct RySignalingFlux {
    mapk: RyMapkFlux;
    pi3k: RyPi3kFlux;
    jak_stat: RyJakStatFlux;
    calcium: RyCalciumFlux;
}

# The external inputs: growth factor receptor activation (0–1, drives MAPK and PI3K), cytokine receptor activation
# (0–1, drives JAK-STAT), IP3 (>= 0, drives calcium). The tick sanitizes them.
struct RySignalingInput {
    growth_factor: f64;
    cytokine: f64;
    ip3: f64;
}

# The pathway states' and configs' byte offsets in the network and the config records.
const _RY_SIG_PI3K = 32;                 # after MapkState's 4 f64
const _RY_SIG_JAK_STAT = 56;             # after Pi3kState's 3
const _RY_SIG_CALCIUM = 88;              # after JakStatState's 4
const _RY_SIG_SIZE = 112;                # CalciumState's 3: also the flux's layout and size
const _RY_SIGCFG_PI3K = 96;              # after MapkConfig's 12 f64
const _RY_SIGCFG_JAK_STAT = 168;         # after Pi3kConfig's 9
const _RY_SIGCFG_CALCIUM = 256;          # after JakStatConfig's 11
const _RY_SIGCFG_GAINS = 344;            # after CalciumConfig's 11: the three gains
const _RY_SIGCFG_SIZE = 368;

# ── defaults ──

# Fills *out with Rust's SignalingNetwork::default(): every pathway state's default.
fn ry_signaling_network_default(out: *RySignalingNetwork) {
    var w = out;
    ry_mapk_state_default(w);
    ry_pi3k_state_default(w + _RY_SIG_PI3K);
    ry_jak_stat_state_default(w + _RY_SIG_JAK_STAT);
    ry_calcium_state_default(w + _RY_SIG_CALCIUM);
    return 0;
}

# Fills *out with Rust's SignalingConfig::default(): every pathway config's default, the three gains 0.
fn ry_signaling_config_default(out: *RySignalingConfig) {
    var w = out;
    ry_mapk_config_default(w);
    ry_pi3k_config_default(w + _RY_SIGCFG_PI3K);
    ry_jak_stat_config_default(w + _RY_SIGCFG_JAK_STAT);
    ry_calcium_config_default(w + _RY_SIGCFG_CALCIUM);
    out.ras_pi3k_crosstalk = 0.0;
    out.akt_raf_inhibition = 0.0;
    out.ca_ras_crosstalk = 0.0;
    return 0;
}

# Fills *out with Rust's SignalingFlux::default(): every pathway flux zero.
fn ry_signaling_flux_default(out: *RySignalingFlux) {
    var w = out;
    ry_mapk_flux_default(w);
    ry_pi3k_flux_default(w + _RY_SIG_PI3K);
    ry_jak_stat_flux_default(w + _RY_SIG_JAK_STAT);
    ry_calcium_flux_default(w + _RY_SIG_CALCIUM);
    return 0;
}

# Fills *out with Rust's SignalingInput::default() (src/signaling_data.cyr): no stimulus.
fn ry_signaling_input_default(out: *RySignalingInput) {
    out.growth_factor = RY_SIGNALING_SIGNALING_INPUT_DEFAULT_GROWTH_FACTOR;
    out.cytokine = RY_SIGNALING_SIGNALING_INPUT_DEFAULT_CYTOKINE;
    out.ip3 = RY_SIGNALING_SIGNALING_INPUT_DEFAULT_IP3;
    return 0;
}

# ── validation ──

# Ok(0) when every pathway state validates; else the first failure's Err (MAPK, PI3K, JAK-STAT, calcium). Mirrors
# `SignalingNetwork::validate`.
#must_use
fn ry_signaling_network_validate(p: *RySignalingNetwork): Result {
    var w = p;
    var t1, v1 = ry_mapk_state_validate(w);
    if (is_err_result(t1) == 1) { return Err(v1); }
    var t2, v2 = ry_pi3k_state_validate(w + _RY_SIG_PI3K);
    if (is_err_result(t2) == 1) { return Err(v2); }
    var t3, v3 = ry_jak_stat_state_validate(w + _RY_SIG_JAK_STAT);
    if (is_err_result(t3) == 1) { return Err(v3); }
    var t4, v4 = ry_calcium_state_validate(w + _RY_SIG_CALCIUM);
    if (is_err_result(t4) == 1) { return Err(v4); }
    return Ok(0);
}

# Ok(0) when every pathway config validates and the three crosstalk gains are finite and >= 0; else the first
# failure's Err, in that order. Mirrors `SignalingConfig::validate`.
#must_use
fn ry_signaling_config_validate(p: *RySignalingConfig): Result {
    var w = p;
    var t1, v1 = ry_mapk_config_validate(w);
    if (is_err_result(t1) == 1) { return Err(v1); }
    var t2, v2 = ry_pi3k_config_validate(w + _RY_SIGCFG_PI3K);
    if (is_err_result(t2) == 1) { return Err(v2); }
    var t3, v3 = ry_jak_stat_config_validate(w + _RY_SIGCFG_JAK_STAT);
    if (is_err_result(t3) == 1) { return Err(v3); }
    var t4, v4 = ry_calcium_config_validate(w + _RY_SIGCFG_CALCIUM);
    if (is_err_result(t4) == 1) { return Err(v4); }
    var name = &_RY_SIGNALING_CONFIG_FIELDS;
    var k = 0;
    while (k < 4) {
        name = name + strlen(name) + 1;
        k = k + 1;
    }
    k = 0;
    while (k < 3) {
        var value: f64 = load64(w + _RY_SIGCFG_GAINS + 8 * k);
        var t, v = _ry_guard_non_negative(name, value);
        if (is_err_result(t) == 1) { return Err(v); }
        name = name + strlen(name) + 1;
        k = k + 1;
    }
    return Ok(0);
}

# ── the network ──

# Advances every signaling pathway by `dt` seconds with crosstalk and fills *out with their fluxes. The inputs are
# sanitized (growth factor and cytokine by `unit`, IP3 by `conc`); the crosstalk terms come from the start-of-tick
# state; then MAPK (with Akt's Raf inhibition), PI3K, JAK-STAT and calcium tick in that order. A non-finite or
# non-positive dt leaves the state untouched with a zero flux. Mirrors `SignalingNetwork::tick`.
fn ry_signaling_network_tick(p: *RySignalingNetwork, c: *RySignalingConfig, input: *RySignalingInput, dt: f64,
  out: *RySignalingFlux) {
    if (_ry_guard_valid_dt(dt) == 0) {
        ry_signaling_flux_default(out);
        return 0;
    }
    var gf: f64 = _ry_guard_unit(input.growth_factor);
    var cytokine: f64 = _ry_guard_unit(input.cytokine);
    var ip3: f64 = _ry_guard_conc(input.ip3);
    if (_ry_trace_on() == 1) {
        var hd[24];
        var b[256];
        var e = _ry_ev(&hd, &b, 256, "rasayan::signaling", "signaling_tick");
        _ry_ev_f(e, "dt", dt);
        _ry_ev_f(e, "gf", gf);
        _ry_ev_f(e, "cytokine", cytokine);
        _ry_ev_f(e, "ip3", ip3);
        _ry_trace(e);
    }
    var w = p;
    var cw = c;
    var ow = out;
    # The crosstalk modifiers, from the start-of-tick state. Ras-GTP → PI3K.
    var ras: f64 = load64(w);
    var ras_boost: f64 = ras * c.ras_pi3k_crosstalk;
    var pi3k_drive: f64 = gf + ras_boost;
    var pi3k_input: f64 = _ry_guard_unit(pi3k_drive);
    # Ca2+ → Ras: calmodulin / RasGRP (Ca2+ normalized by 1 uM).
    var ca: f64 = load64(w + _RY_SIG_CALCIUM);
    var ca_unit: f64 = _ry_guard_unit(ca);
    var ca_boost: f64 = ca_unit * c.ca_ras_crosstalk;
    var mapk_drive: f64 = gf + ca_boost;
    var mapk_input: f64 = _ry_guard_unit(mapk_drive);
    # Akt → Raf: an extra first-order Raf deactivation, proportional to Raf.
    var akt: f64 = load64(w + _RY_SIG_PI3K + 8);
    var akt_unit: f64 = _ry_guard_unit(akt);
    var raf_inhibition: f64 = akt_unit * c.akt_raf_inhibition;
    _ry_mapk_state_tick_with_raf_inhibition(w, cw, mapk_input, raf_inhibition, dt, ow);
    ry_pi3k_state_tick(w + _RY_SIG_PI3K, cw + _RY_SIGCFG_PI3K, pi3k_input, dt, ow + _RY_SIG_PI3K);
    ry_jak_stat_state_tick(w + _RY_SIG_JAK_STAT, cw + _RY_SIGCFG_JAK_STAT, cytokine, dt, ow + _RY_SIG_JAK_STAT);
    ry_calcium_state_tick(w + _RY_SIG_CALCIUM, cw + _RY_SIGCFG_CALCIUM, ip3, dt, ow + _RY_SIG_CALCIUM);
    return 0;
}

# ── JSON (P7: serde_json's documents) ──

# Appends the four nested records at `w` (`kind` 0 the states, 1 the configs, 2 the fluxes, at their offsets) as the
# first four members of the object whose field names start at `names`, on allocator `a`: 0, or nonzero when the builder
# could not grow.
fn _ry_signaling_parts_to_json(a, sb, w, kind, names): i64 {
    var name = names;
    var e = _ry_jw_key(a, sb, name, 1);
    var t = 0;
    var v = 0;
    if (kind == 0) { t, v = ry_mapk_state_to_json_a(a, sb, w); }
    if (kind == 1) { t, v = ry_mapk_config_to_json_a(a, sb, w); }
    if (kind == 2) { t, v = ry_mapk_flux_to_json_a(a, sb, w); }
    if (is_err_result(t) == 1) { e = 1; }
    name = name + strlen(name) + 1;
    e = e | _ry_jw_key(a, sb, name, 0);
    if (kind == 0) { t, v = ry_pi3k_state_to_json_a(a, sb, w + _RY_SIG_PI3K); }
    if (kind == 1) { t, v = ry_pi3k_config_to_json_a(a, sb, w + _RY_SIGCFG_PI3K); }
    if (kind == 2) { t, v = ry_pi3k_flux_to_json_a(a, sb, w + _RY_SIG_PI3K); }
    if (is_err_result(t) == 1) { e = 1; }
    name = name + strlen(name) + 1;
    e = e | _ry_jw_key(a, sb, name, 0);
    if (kind == 0) { t, v = ry_jak_stat_state_to_json_a(a, sb, w + _RY_SIG_JAK_STAT); }
    if (kind == 1) { t, v = ry_jak_stat_config_to_json_a(a, sb, w + _RY_SIGCFG_JAK_STAT); }
    if (kind == 2) { t, v = ry_jak_stat_flux_to_json_a(a, sb, w + _RY_SIG_JAK_STAT); }
    if (is_err_result(t) == 1) { e = 1; }
    name = name + strlen(name) + 1;
    e = e | _ry_jw_key(a, sb, name, 0);
    if (kind == 0) { t, v = ry_calcium_state_to_json_a(a, sb, w + _RY_SIG_CALCIUM); }
    if (kind == 1) { t, v = ry_calcium_config_to_json_a(a, sb, w + _RY_SIGCFG_CALCIUM); }
    if (kind == 2) { t, v = ry_calcium_flux_to_json_a(a, sb, w + _RY_SIG_CALCIUM); }
    if (is_err_result(t) == 1) { e = 1; }
    return e;
}

# Reads the four nested records of node `v` (in `form`, `kind` as above, the field names at `names`) into `w` at their
# offsets: 1, or 0 for a refusal.
#must_use
fn _ry_signaling_parts_from_node(v, form, w, kind, names): i64 {
    var name = names;
    var ok = 0;
    var n0 = _ry_jr_at(v, form, 0, name);
    if (kind == 0) { ok = _ry_mapk_state_from_node(n0, w); }
    if (kind == 1) { ok = _ry_mapk_config_from_node(n0, w); }
    if (kind == 2) { ok = _ry_mapk_flux_from_node(n0, w); }
    name = name + strlen(name) + 1;
    if (ok == 1) {
        var n1 = _ry_jr_at(v, form, 1, name);
        if (kind == 0) { ok = _ry_pi3k_state_from_node(n1, w + _RY_SIG_PI3K); }
        if (kind == 1) { ok = _ry_pi3k_config_from_node(n1, w + _RY_SIGCFG_PI3K); }
        if (kind == 2) { ok = _ry_pi3k_flux_from_node(n1, w + _RY_SIG_PI3K); }
    }
    name = name + strlen(name) + 1;
    if (ok == 1) {
        var n2 = _ry_jr_at(v, form, 2, name);
        if (kind == 0) { ok = _ry_jak_stat_state_from_node(n2, w + _RY_SIG_JAK_STAT); }
        if (kind == 1) { ok = _ry_jak_stat_config_from_node(n2, w + _RY_SIGCFG_JAK_STAT); }
        if (kind == 2) { ok = _ry_jak_stat_flux_from_node(n2, w + _RY_SIG_JAK_STAT); }
    }
    name = name + strlen(name) + 1;
    if (ok == 1) {
        var n3 = _ry_jr_at(v, form, 3, name);
        if (kind == 0) { ok = _ry_calcium_state_from_node(n3, w + _RY_SIG_CALCIUM); }
        if (kind == 1) { ok = _ry_calcium_config_from_node(n3, w + _RY_SIGCFG_CALCIUM); }
        if (kind == 2) { ok = _ry_calcium_flux_from_node(n3, w + _RY_SIG_CALCIUM); }
    }
    return ok;
}

# Appends SignalingNetwork `p` as serde_json writes it (each pathway state nested, in declaration order), on
# allocator `a`: Ok(0), or Err(RY_ERR_OUT_OF_MEMORY) when the builder could not grow.
#must_use
fn ry_signaling_network_to_json_a(a, sb, p: *RySignalingNetwork): Result {
    var e = _ry_jw_byte(a, sb, 123);
    e = e | _ry_signaling_parts_to_json(a, sb, p, 0, &_RY_SIGNALING_NETWORK_FIELDS);
    e = e | _ry_jw_byte(a, sb, 125);
    if (e != 0) { return Err(RY_ERR_OUT_OF_MEMORY); }
    return Ok(0);
}

# ry_signaling_network_to_json_a on the default allocator (a builder from str_builder_new).
#must_use
fn ry_signaling_network_to_json(sb, p: *RySignalingNetwork): Result {
    return ry_signaling_network_to_json_a(default_alloc(), sb, p);
}

# The SignalingNetwork at node `v` of a parsed document, by serde's rules, into the 112 bytes at `w`: 1, or 0 for a
# refusal.
#must_use
fn _ry_signaling_network_from_node(v, w): i64 {
    var form = _ry_jr_form(v, 4);
    if (form == 0) { return 0; }
    return _ry_signaling_parts_from_node(v, form, w, 0, &_RY_SIGNALING_NETWORK_FIELDS);
}

# Reads a SignalingNetwork from the `n`-byte document at `buf` by serde's rules (its tree on allocator `a`): Ok(0)
# with *out filled, or Err(RY_ERR_DESERIALIZE) with *out untouched.
#must_use
fn ry_signaling_network_from_json_a(a, buf, n, out: *RySignalingNetwork): Result {
    var w[112];
    var v = _ry_jr_parse(a, buf, n);
    if (_ry_signaling_network_from_node(v, &w) == 0) {
        return Err(_ry_fail_text(RY_ERR_DESERIALIZE, "SignalingNetwork", 16));
    }
    memcpy(out, &w, _RY_SIG_SIZE);
    return Ok(0);
}

# ry_signaling_network_from_json_a on the default allocator (the tree is never freed: for a one-off read).
#must_use
fn ry_signaling_network_from_json(buf, n, out: *RySignalingNetwork): Result {
    return ry_signaling_network_from_json_a(default_alloc(), buf, n, out);
}

# Appends SignalingConfig `p` as serde_json writes it (each pathway config nested, then the three gains), on
# allocator `a`: Ok(0), or Err(RY_ERR_OUT_OF_MEMORY).
#must_use
fn ry_signaling_config_to_json_a(a, sb, p: *RySignalingConfig): Result {
    var w = p;
    var e = _ry_jw_byte(a, sb, 123);
    e = e | _ry_signaling_parts_to_json(a, sb, w, 1, &_RY_SIGNALING_CONFIG_FIELDS);
    var name = &_RY_SIGNALING_CONFIG_FIELDS;
    var k = 0;
    while (k < 4) {
        name = name + strlen(name) + 1;
        k = k + 1;
    }
    k = 0;
    while (k < 3) {
        e = e | _ry_jw_key(a, sb, name, 0);
        var x: f64 = load64(w + _RY_SIGCFG_GAINS + 8 * k);
        e = e | _ry_jw_f64(a, sb, x);
