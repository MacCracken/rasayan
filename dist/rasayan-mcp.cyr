# Helix nucleus: "a cluster of four helical residues (Hα or hα) out of six"
# (Chou & Fasman 1978, rule 1).
# Rust: rasayan::protein::CF_HELIX_NUCLEUS (private) = 6
const _RY_PROTEIN_CF_HELIX_NUCLEUS = 6;

# Helix formers required in a [`CF_HELIX_NUCLEUS`] window (rule 1).
# Rust: rasayan::protein::CF_HELIX_NUCLEUS_FORMERS (private) = 4
const _RY_PROTEIN_CF_HELIX_NUCLEUS_FORMERS = 4;

# A residue is a helix former (class Hα or hα) when Pα ×100 is at least
# this. In the 1978 table the former classes span Pα 1.06–1.51 and the next
# class (Iα: Asp 1.01, His 1.00) tops out at 1.01, so 1.03 selects exactly
# Hα ∪ hα (Chou & Fasman 1978, class assignments).
# Rust: rasayan::protein::CF_HELIX_FORMER (private) = 103
const _RY_PROTEIN_CF_HELIX_FORMER = 103;

# Sheet nucleus: "a cluster of three β formers out of five residues"
# (Chou & Fasman 1978, rule 2).
# Rust: rasayan::protein::CF_SHEET_NUCLEUS (private) = 5
const _RY_PROTEIN_CF_SHEET_NUCLEUS = 5;

# β formers required in a [`CF_SHEET_NUCLEUS`] window (rule 2).
# Rust: rasayan::protein::CF_SHEET_NUCLEUS_FORMERS (private) = 3
const _RY_PROTEIN_CF_SHEET_NUCLEUS_FORMERS = 3;

# A residue is a β former (class Hβ or hβ) when Pβ ×100 is at least this:
# the former classes span Pβ 1.05–1.70 and the next class (iβ) tops out
# at Arg 0.93 (Chou & Fasman 1978, class assignments).
# Rust: rasayan::protein::CF_SHEET_FORMER (private) = 105
const _RY_PROTEIN_CF_SHEET_FORMER = 105;

# Extension stops at a tetrapeptide breaker, ⟨P⟩ < 1.00 (×100; rules 1–2).
# Rust: rasayan::protein::CF_BREAKER (private) = 100
const _RY_PROTEIN_CF_BREAKER = 100;

# Helix acceptance: ⟨Pα⟩ > 1.03 (×100; rule 1).
# Rust: rasayan::protein::CF_HELIX_ACCEPT (private) = 103
const _RY_PROTEIN_CF_HELIX_ACCEPT = 103;

# Helix acceptance: "at least six residues long" (rule 1).
# Rust: rasayan::protein::CF_HELIX_MIN_LEN (private) = 6
const _RY_PROTEIN_CF_HELIX_MIN_LEN = 6;

# Sheet acceptance: ⟨Pβ⟩ > 1.05 (×100; rule 2).
# Rust: rasayan::protein::CF_SHEET_ACCEPT (private) = 105
const _RY_PROTEIN_CF_SHEET_ACCEPT = 105;

# Turn acceptance: ⟨Pt⟩ > 1.00 (×100; rule 3).
# Rust: rasayan::protein::CF_TURN_ACCEPT (private) = 100
const _RY_PROTEIN_CF_TURN_ACCEPT = 100;

# Turn acceptance: bend probability p(t) = f(i)·f(i+1)·f(i+2)·f(i+3) >
# 0.75×10⁻⁴ (rule 3). The four frequencies are stored ×1000, so the
# product is ×10¹² and the cut is 75 000 000.
# Rust: rasayan::protein::CF_BEND_PRODUCT_MIN (private) = 75_000_000
const _RY_PROTEIN_CF_BEND_PRODUCT_MIN = 75000000;

# Pro may occupy only the first turn — the first three residues — of a
# helix (rule 1: not in the inner helix or at the C-terminal end).
# Rust: rasayan::protein::CF_PRO_HELIX_FIRST_TURN (private) = 3
const _RY_PROTEIN_CF_PRO_HELIX_FIRST_TURN = 3;

# Per-residue work flags for [`chou_fasman`].
# Rust: rasayan::protein::CF_HELIX (private) = 1
const _RY_PROTEIN_CF_HELIX = 1;

# Rust: rasayan::protein::CF_SHEET (private) = 2
const _RY_PROTEIN_CF_SHEET = 2;

# Rust: rasayan::protein::CF_TURN (private) = 4
const _RY_PROTEIN_CF_TURN = 4;

