    99, 121, 116, 111, 112, 108, 97, 115, 109, 105, 99, 95, 99, 97, 0,  # cytoplasmic_ca
    101, 114, 95, 99, 97, 0,  # er_ca
    105, 112, 51, 114, 95, 111, 112, 101, 110, 0,  # ip3r_open
};

# Kinetic parameters for calcium oscillations.
#
# All fluxes are in cytosolic concentration units (see the module docs).
# Rust: rasayan::calcium::CalciumConfig::default()

# IP3R gating relaxation rate toward its open target (s^-1).
# Rust: rasayan::calcium::CalciumConfig::default().ip3r_open_rate
const RY_CALCIUM_CALCIUM_CONFIG_DEFAULT_IP3R_OPEN_RATE = 2.0;

# IP3R Km for IP3 (normalized IP3; must be > 0).
# Rust: rasayan::calcium::CalciumConfig::default().ip3r_km_ip3
const RY_CALCIUM_CALCIUM_CONFIG_DEFAULT_IP3R_KM_IP3 = 0.3;

# CICR gain: Ca2+ positive feedback on IP3R opening.
# Rust: rasayan::calcium::CalciumConfig::default().cicr_gain
const RY_CALCIUM_CALCIUM_CONFIG_DEFAULT_CICR_GAIN = 3.0;

# CICR Km: Ca2+ level for half-maximal CICR (uM; must be > 0).
# Rust: rasayan::calcium::CalciumConfig::default().cicr_km
const RY_CALCIUM_CALCIUM_CONFIG_DEFAULT_CICR_KM = 0.5;

# Rate of a slow Ca2+-dependent IP3R inactivation gate (s^-1).
#
# **Currently unused**: inactivation is applied instantaneously through
# [`ip3r_inactivation_threshold`](Self::ip3r_inactivation_threshold)
# (a slow Li–Rinzel `h` gate would need an extra state field). It is
# still validated (`>= 0`) and kept for compatibility.
# Rust: rasayan::calcium::CalciumConfig::default().ip3r_inactivation_rate
const RY_CALCIUM_CALCIUM_CONFIG_DEFAULT_IP3R_INACTIVATION_RATE = 1.0;

# Ca2+ level (uM) at which IP3R opening is halved by Ca2+-dependent
# inactivation, `1 / (1 + (Ca / threshold)²)`. Must be > 0.
# Rust: rasayan::calcium::CalciumConfig::default().ip3r_inactivation_threshold
const RY_CALCIUM_CALCIUM_CONFIG_DEFAULT_IP3R_INACTIVATION_THRESHOLD = 1.0;

# ER Ca2+ release rate through open IP3R (cytosolic uM/s per open
# fraction, at an ER level of [`ER_CA_REFERENCE`]; scales linearly with
# `er_ca`).
# Rust: rasayan::calcium::CalciumConfig::default().er_release_rate
const RY_CALCIUM_CALCIUM_CONFIG_DEFAULT_ER_RELEASE_RATE = 50.0;

# SERCA pump Vmax (cytosolic uM/s).
# Rust: rasayan::calcium::CalciumConfig::default().serca_vmax
const RY_CALCIUM_CALCIUM_CONFIG_DEFAULT_SERCA_VMAX = 10.0;

# SERCA Km for cytoplasmic Ca2+ (uM; must be > 0).
# Rust: rasayan::calcium::CalciumConfig::default().serca_km
const RY_CALCIUM_CALCIUM_CONFIG_DEFAULT_SERCA_KM = 0.2;

# Plasma membrane Ca2+ extrusion (PMCA) rate constant (s^-1).
# Rust: rasayan::calcium::CalciumConfig::default().pmca_rate
const RY_CALCIUM_CALCIUM_CONFIG_DEFAULT_PMCA_RATE = 0.5;

# Passive ER → cytosol leak coefficient (s^-1): the leak is
# `er_leak_rate · er_ca` in cytosolic uM/s.
#
# The default, 1/150 s^-1, makes the leak at [`ER_CA_REFERENCE`]
# (3.33 uM/s) balance SERCA at resting Ca2+ (`10 · 0.1 / (0.2 + 0.1)`),
# so the default state is a steady state (the ER leak is the
# conventional balancing term, as in Li & Rinzel, J Theor Biol
# 166:461, 1994).
# Rust: rasayan::calcium::CalciumConfig::default().er_leak_rate
const RY_CALCIUM_CALCIUM_CONFIG_DEFAULT_ER_LEAK_RATE = 0.006666666666666667;

# CalciumConfig's field names, NUL-separated, in declaration order.
