# --- glycolysis.cyr ---

# glycolysis.cyr — the glycolytic pathway: the ten enzymatic steps from glucose to pyruvate, with regulation at
# hexokinase, phosphofructokinase-1 and pyruvate kinase (Rust 1.2.0's `glycolysis.rs`, transcribed).
#
# | # | Enzyme | Reaction | Type |
# |---|--------|----------|------|
# | 1 | Hexokinase | Glucose → G6P | Irreversible, ATP-consuming, regulated |
# | 2 | Phosphoglucose isomerase | G6P ⇌ F6P | Reversible |
# | 3 | Phosphofructokinase-1 | F6P → F1,6BP | Irreversible, ATP-consuming, regulated |
# | 4 | Aldolase | F1,6BP ⇌ DHAP + G3P | Reversible |
# | 5 | Triose phosphate isomerase | DHAP ⇌ G3P | Reversible (near diffusion limit) |
# | 6 | GAPDH | G3P → 1,3BPG | NAD+ → NADH |
# | 7 | Phosphoglycerate kinase | 1,3BPG → 3PG | ADP → ATP |
# | 8 | Phosphoglycerate mutase | 3PG ⇌ 2PG | Reversible |
# | 9 | Enolase | 2PG ⇌ PEP | Reversible |
# | 10 | Pyruvate kinase | PEP → Pyruvate | Irreversible, ADP → ATP, regulated |
#
# Concentrations in mM, rates in mM/s, time in seconds. A tick consumes glucose but never replenishes it: the caller
# models the supply (blood glucose, glycogenolysis) by setting `glucose`.
#
# Every operation is in Rust's order (P9: a tick is transcribed, not rewritten): tests/golden/glycolysis.tsv compares
# each method with the oracle's at ≤ 2 ulp where only + − × ÷, √ and `powi(2)` run (class B, expected 0), at 0 ulp
# against the corrected oracle where PFK-1's and pyruvate kinase's Hill fractions call `powf` (class C, ADR 0003:
# `_ry_cr_pow`), and bit for bit over the trajectory scripts (class T).
#
# The Cyrius forms (ADR 0002 rows 7, 10, 14):
# - GlycolysisState, GlycolysisConfig and GlycolysisFlux are structs of f64 (RyGlycolysisState, RyGlycolysisConfig,
#   RyGlycolysisFlux); methods take a pointer, and the tick updates the state in place and fills the caller's flux:
#   `ry_glycolysis_state_tick(&s, &c, atp, adp, nad_ratio, dt, &flux)`;
# - the flux's `step_rates: [f64; 10]` is ten consecutive fields named for their enzymes (`rate_hk` … `rate_pk`, Rust's
#   index order); ry_glycolysis_flux_step_rates(&flux) is their address, the array view (`+ 8 * i` is step_rates[i]);
# - `impl Default` is `ry_glycolysis_state_default(&out)` / `ry_glycolysis_config_default(&out)` from the generated
#   consts (src/glycolysis_data.cyr), and the derived `GlycolysisFlux::default()` is ry_glycolysis_flux_default(&out);
# - the crate-private `gapdh_nad_factor`, `tick_regulated` and `GlycolysisFlux::accumulate`, which the metabolic
#   network calls (M5), are _ry_glycolysis_gapdh_nad_factor, _ry_glycolysis_state_tick_regulated and
#   _ry_glycolysis_flux_accumulate;
# - Rust's `tracing::trace!` event (`glycolysis_tick`) is a level-gated sakshi event under the target
#   `rasayan::glycolysis`, its fields in Rust's order;
# - each serde type's codec is `ry_<type>_to_json` / `_from_json` (and `_a`, on an allocator).

# Concentrations of every glycolytic intermediate (mM). The default is a typical resting mammalian cell at steady
# state. Rust's `GlycolysisState`.
struct RyGlycolysisState {
    glucose: f64;
    g6p: f64;
    f6p: f64;
    f16bp: f64;
    dhap: f64;
    g3p: f64;
    bpg13: f64;
    pg3: f64;
    pg2: f64;
    pep: f64;
    pyruvate: f64;
}

# The enzyme parameters of the ten steps: Vmax in mM/s (already scaled by typical enzyme levels: scale one to model a
# deficiency or overexpression), Km, Ki and K½ in mM, Hill coefficients, PFK-1's ATP/ADP half-inhibition ratio and
# pyruvate kinase's F1,6BP feed-forward. Rust's `GlycolysisConfig`.
struct RyGlycolysisConfig {
    hk_vmax: f64;
    hk_km_glucose: f64;
    hk_ki_g6p: f64;
    pgi_vmax_f: f64;
    pgi_km_f: f64;
    pgi_vmax_r: f64;
    pgi_km_r: f64;
    pfk_vmax: f64;
    pfk_km_f6p: f64;
    pfk_hill_n: f64;
    pfk_atp_half_inhibition: f64;
    aldo_vmax_f: f64;
    aldo_km_f: f64;
    aldo_vmax_r: f64;
    aldo_km_r: f64;
    tpi_vmax_f: f64;
    tpi_km_f: f64;
    tpi_vmax_r: f64;
    tpi_km_r: f64;
    gapdh_vmax: f64;
    gapdh_km_g3p: f64;
    pgk_vmax_f: f64;
    pgk_km_f: f64;
    pgk_vmax_r: f64;
    pgk_km_r: f64;
    pgm_vmax_f: f64;
    pgm_km_f: f64;
    pgm_vmax_r: f64;
    pgm_km_r: f64;
    eno_vmax_f: f64;
    eno_km_f: f64;
    eno_vmax_r: f64;
    eno_km_r: f64;
    pk_vmax: f64;
    pk_km_pep: f64;
    pk_hill_n: f64;
    pk_f16bp_ka: f64;
    pk_f16bp_max_activation: f64;
}

# One tick's flux through glycolysis (mM), for the caller to apply to its cofactor pools: ATP consumed (steps 1 and 3)
# and produced (steps 7 and 10), their difference, NADH (step 6) and pyruvate produced; then each step's effective rate
# (mM/s), the amount it actually moved divided by dt after capping at the pool it drains, negative for a reversible
# step running backwards. Rust's `GlycolysisFlux`.
struct RyGlycolysisFlux {
    atp_consumed: f64;
    atp_produced: f64;
    net_atp: f64;
    nadh_produced: f64;
    pyruvate_produced: f64;
    rate_hk: f64;
    rate_pgi: f64;
    rate_pfk: f64;
    rate_aldo: f64;
    rate_tpi: f64;
    rate_gapdh: f64;
    rate_pgk: f64;
    rate_pgm: f64;
    rate_eno: f64;
    rate_pk: f64;
}

# GlycolysisFlux's five amounts' names, NUL-separated, in Rust's declaration order (JSON); the state's and the
# config's are generated (_RY_GLYCOLYSIS_STATE_FIELDS, _RY_GLYCOLYSIS_CONFIG_FIELDS, src/glycolysis_data.cyr).
var _RY_GLYCOLYSIS_FLUX_FIELDS = "atp_consumed\0atp_produced\0net_atp\0nadh_produced\0pyruvate_produced\0";

# Each config field's rule in GlycolysisConfig::validate, in declaration order: `v` a Vmax (finite, >= 0), `k` a
# divisor (Km, Ki, K½, Hill coefficient, half-inhibition ratio: finite, > 0), `a` the fold change (finite, >= 1).
# Rust checks every `v`, then every `k`, then the `a`, each list in declaration order.
var _RY_GLYCOLYSIS_CONFIG_RULES = "vkkvkvkvkkkvkvkvkvkvkvkvkvkvkvkvkvkkka";

# ── defaults ──

# Fills *out with the resting cell's concentrations (RY_GLYCOLYSIS_GLYCOLYSIS_STATE_DEFAULT_*: glucose 5, G6P 0.083,
# F6P 0.014, F1,6BP 0.031, DHAP 0.14, G3P 0.019, 1,3BPG 0.001, 3PG 0.12, 2PG 0.03, PEP 0.023, pyruvate 0.051 mM;
# Stryer, Table 16.1). Mirrors `GlycolysisState::default()`.
fn ry_glycolysis_state_default(out: *RyGlycolysisState) {
    out.glucose = RY_GLYCOLYSIS_GLYCOLYSIS_STATE_DEFAULT_GLUCOSE;
    out.g6p = RY_GLYCOLYSIS_GLYCOLYSIS_STATE_DEFAULT_G6P;
    out.f6p = RY_GLYCOLYSIS_GLYCOLYSIS_STATE_DEFAULT_F6P;
    out.f16bp = RY_GLYCOLYSIS_GLYCOLYSIS_STATE_DEFAULT_F16BP;
    out.dhap = RY_GLYCOLYSIS_GLYCOLYSIS_STATE_DEFAULT_DHAP;
    out.g3p = RY_GLYCOLYSIS_GLYCOLYSIS_STATE_DEFAULT_G3P;
    out.bpg13 = RY_GLYCOLYSIS_GLYCOLYSIS_STATE_DEFAULT_BPG13;
    out.pg3 = RY_GLYCOLYSIS_GLYCOLYSIS_STATE_DEFAULT_PG3;
    out.pg2 = RY_GLYCOLYSIS_GLYCOLYSIS_STATE_DEFAULT_PG2;
    out.pep = RY_GLYCOLYSIS_GLYCOLYSIS_STATE_DEFAULT_PEP;
    out.pyruvate = RY_GLYCOLYSIS_GLYCOLYSIS_STATE_DEFAULT_PYRUVATE;
    return 0;
}

# Fills *out with the consensus mammalian enzyme parameters (RY_GLYCOLYSIS_GLYCOLYSIS_CONFIG_DEFAULT_*; Stryer,
# Lehninger, Teusink et al. 2000). Mirrors `GlycolysisConfig::default()`.
fn ry_glycolysis_config_default(out: *RyGlycolysisConfig) {
    out.hk_vmax = RY_GLYCOLYSIS_GLYCOLYSIS_CONFIG_DEFAULT_HK_VMAX;
    out.hk_km_glucose = RY_GLYCOLYSIS_GLYCOLYSIS_CONFIG_DEFAULT_HK_KM_GLUCOSE;
    out.hk_ki_g6p = RY_GLYCOLYSIS_GLYCOLYSIS_CONFIG_DEFAULT_HK_KI_G6P;
    out.pgi_vmax_f = RY_GLYCOLYSIS_GLYCOLYSIS_CONFIG_DEFAULT_PGI_VMAX_F;
    out.pgi_km_f = RY_GLYCOLYSIS_GLYCOLYSIS_CONFIG_DEFAULT_PGI_KM_F;
    out.pgi_vmax_r = RY_GLYCOLYSIS_GLYCOLYSIS_CONFIG_DEFAULT_PGI_VMAX_R;
    out.pgi_km_r = RY_GLYCOLYSIS_GLYCOLYSIS_CONFIG_DEFAULT_PGI_KM_R;
    out.pfk_vmax = RY_GLYCOLYSIS_GLYCOLYSIS_CONFIG_DEFAULT_PFK_VMAX;
    out.pfk_km_f6p = RY_GLYCOLYSIS_GLYCOLYSIS_CONFIG_DEFAULT_PFK_KM_F6P;
    out.pfk_hill_n = RY_GLYCOLYSIS_GLYCOLYSIS_CONFIG_DEFAULT_PFK_HILL_N;
    out.pfk_atp_half_inhibition = RY_GLYCOLYSIS_GLYCOLYSIS_CONFIG_DEFAULT_PFK_ATP_HALF_INHIBITION;
    out.aldo_vmax_f = RY_GLYCOLYSIS_GLYCOLYSIS_CONFIG_DEFAULT_ALDO_VMAX_F;
    out.aldo_km_f = RY_GLYCOLYSIS_GLYCOLYSIS_CONFIG_DEFAULT_ALDO_KM_F;
    out.aldo_vmax_r = RY_GLYCOLYSIS_GLYCOLYSIS_CONFIG_DEFAULT_ALDO_VMAX_R;
    out.aldo_km_r = RY_GLYCOLYSIS_GLYCOLYSIS_CONFIG_DEFAULT_ALDO_KM_R;
    out.tpi_vmax_f = RY_GLYCOLYSIS_GLYCOLYSIS_CONFIG_DEFAULT_TPI_VMAX_F;
    out.tpi_km_f = RY_GLYCOLYSIS_GLYCOLYSIS_CONFIG_DEFAULT_TPI_KM_F;
    out.tpi_vmax_r = RY_GLYCOLYSIS_GLYCOLYSIS_CONFIG_DEFAULT_TPI_VMAX_R;
    out.tpi_km_r = RY_GLYCOLYSIS_GLYCOLYSIS_CONFIG_DEFAULT_TPI_KM_R;
    out.gapdh_vmax = RY_GLYCOLYSIS_GLYCOLYSIS_CONFIG_DEFAULT_GAPDH_VMAX;
    out.gapdh_km_g3p = RY_GLYCOLYSIS_GLYCOLYSIS_CONFIG_DEFAULT_GAPDH_KM_G3P;
    out.pgk_vmax_f = RY_GLYCOLYSIS_GLYCOLYSIS_CONFIG_DEFAULT_PGK_VMAX_F;
    out.pgk_km_f = RY_GLYCOLYSIS_GLYCOLYSIS_CONFIG_DEFAULT_PGK_KM_F;
    out.pgk_vmax_r = RY_GLYCOLYSIS_GLYCOLYSIS_CONFIG_DEFAULT_PGK_VMAX_R;
    out.pgk_km_r = RY_GLYCOLYSIS_GLYCOLYSIS_CONFIG_DEFAULT_PGK_KM_R;
    out.pgm_vmax_f = RY_GLYCOLYSIS_GLYCOLYSIS_CONFIG_DEFAULT_PGM_VMAX_F;
    out.pgm_km_f = RY_GLYCOLYSIS_GLYCOLYSIS_CONFIG_DEFAULT_PGM_KM_F;
    out.pgm_vmax_r = RY_GLYCOLYSIS_GLYCOLYSIS_CONFIG_DEFAULT_PGM_VMAX_R;
    out.pgm_km_r = RY_GLYCOLYSIS_GLYCOLYSIS_CONFIG_DEFAULT_PGM_KM_R;
    out.eno_vmax_f = RY_GLYCOLYSIS_GLYCOLYSIS_CONFIG_DEFAULT_ENO_VMAX_F;
    out.eno_km_f = RY_GLYCOLYSIS_GLYCOLYSIS_CONFIG_DEFAULT_ENO_KM_F;
    out.eno_vmax_r = RY_GLYCOLYSIS_GLYCOLYSIS_CONFIG_DEFAULT_ENO_VMAX_R;
    out.eno_km_r = RY_GLYCOLYSIS_GLYCOLYSIS_CONFIG_DEFAULT_ENO_KM_R;
    out.pk_vmax = RY_GLYCOLYSIS_GLYCOLYSIS_CONFIG_DEFAULT_PK_VMAX;
    out.pk_km_pep = RY_GLYCOLYSIS_GLYCOLYSIS_CONFIG_DEFAULT_PK_KM_PEP;
    out.pk_hill_n = RY_GLYCOLYSIS_GLYCOLYSIS_CONFIG_DEFAULT_PK_HILL_N;
    out.pk_f16bp_ka = RY_GLYCOLYSIS_GLYCOLYSIS_CONFIG_DEFAULT_PK_F16BP_KA;
    out.pk_f16bp_max_activation = RY_GLYCOLYSIS_GLYCOLYSIS_CONFIG_DEFAULT_PK_F16BP_MAX_ACTIVATION;
    return 0;
}

# Fills *out with the zero flux (every field +0). Mirrors the derived `GlycolysisFlux::default()`.
fn ry_glycolysis_flux_default(out: *RyGlycolysisFlux) {
    memset(out, 0, 120);
    return 0;
}

# The address of the flux's ten step rates, `rate_hk` … `rate_pk`: Rust's `step_rates: [f64; 10]`, step i + 1 at
# `+ 8 * i` (index 0 hexokinase, 2 PFK-1, 9 pyruvate kinase).
#must_use
#pure
fn ry_glycolysis_flux_step_rates(f: *RyGlycolysisFlux): i64 {
    var w = f;                                   # a plain address: `f + n` would step n · 120 bytes
    return w + 40;
}

# ── validation ──

# Ok(0) when every concentration is finite and >= 0; else the first failing field's `_ry_guard_non_negative` Err
# (RY_ERR_NON_FINITE or RY_ERR_NEGATIVE_CONCENTRATION), in declaration order. Mirrors `GlycolysisState::validate`.
#must_use
fn ry_glycolysis_state_validate(p: *RyGlycolysisState): Result {
    var w = p;                                   # a plain address: `p + n` would step n · 88 bytes
    var name = &_RY_GLYCOLYSIS_STATE_FIELDS;
    var k = 0;
    while (k < 11) {
        var value: f64 = load64(w + 8 * k);
        var t, v = _ry_guard_non_negative(name, value);
        if (is_err_result(t) == 1) { return Err(v); }
        name = name + strlen(name) + 1;
        k = k + 1;
    }
    return Ok(0);
}

# The first refusal among config fields whose rule is `rule` (`v` or `k`, _RY_GLYCOLYSIS_CONFIG_RULES), in declaration
# order: Ok(0), or the guard's Err.
fn _ry_glycolysis_config_check(p: *RyGlycolysisConfig, rule): Result {
    var w = p;                                   # a plain address: `p + n` would step n · 304 bytes
    var name = &_RY_GLYCOLYSIS_CONFIG_FIELDS;
    var k = 0;
    while (k < 38) {
        if (load8(_RY_GLYCOLYSIS_CONFIG_RULES + k) == rule) {
            var value: f64 = load64(w + 8 * k);
            if (rule == 118) {
                var t, v = _ry_guard_non_negative(name, value);
                if (is_err_result(t) == 1) { return Err(v); }
            } else {
                var tp, vp = _ry_guard_positive(name, value);
                if (is_err_result(tp) == 1) { return Err(vp); }
            }
        }
        name = name + strlen(name) + 1;
        k = k + 1;
    }
    return Ok(0);
}

# Ok(0) when every parameter is physically meaningful: each Vmax finite and >= 0 (else RY_ERR_NON_FINITE or
# RY_ERR_NEGATIVE_CONCENTRATION); each Km, Ki, half-inhibition and half-activation constant and both Hill
# coefficients, used as divisors, finite and > 0 (RY_ERR_INVALID_PARAMETER at or below 0); pk_f16bp_max_activation, a
# fold change, finite and >= 1. The Vmax are checked first, then the divisors, then the fold change, each in
# declaration order. Mirrors `GlycolysisConfig::validate`.
#must_use
fn ry_glycolysis_config_validate(p: *RyGlycolysisConfig): Result {
    var t1, v1 = _ry_glycolysis_config_check(p, 118);
    if (is_err_result(t1) == 1) { return Err(v1); }
    var t2, v2 = _ry_glycolysis_config_check(p, 107);
    if (is_err_result(t2) == 1) { return Err(v2); }
    var fold: f64 = p.pk_f16bp_max_activation;
    var t3, v3 = _ry_guard_at_least("pk_f16bp_max_activation", fold, 1.0);
    if (is_err_result(t3) == 1) { return Err(v3); }
    return Ok(0);
}

# ── the rate laws' cofactor terms ──

# GAPDH's NAD+ dependence at the NAD+/NADH ratio `nad_ratio`, normalized to 1 at RY_RESTING_NAD_RATIO. GAPDH is
# Michaelis-Menten in cytosolic NAD+, the pool fraction r / (1 + r), so x / (K + x) is r / (K + (1 + K)·r) with K =
# RY_GLYCOLYSIS_GAPDH_KM_NAD_FRACTION. Unlike the mitochondrial dehydrogenases, which scale with the ratio itself and
# stop with the ETC, glycolysis keeps running at a low ratio while lactate dehydrogenase regenerates NAD+ (the
# anaerobic, Pasteur mode). A NaN, infinite or negative ratio gives 0. Mirrors the crate-private
# `glycolysis::gapdh_nad_factor`.
#must_use
#pure
fn _ry_glycolysis_gapdh_nad_factor(nad_ratio: f64): f64 {
    var r: f64 = _ry_guard_conc(nad_ratio);
    var k: f64 = RY_GLYCOLYSIS_GAPDH_KM_NAD_FRACTION;
    var resting: f64 = RY_RESTING_NAD_RATIO / (k + (1.0 + k) * RY_RESTING_NAD_RATIO);
    var x: f64 = r / (k + (1.0 + k) * r) / resting;
    return x;
}

# The saturation `x / (k + x)` of a co-substrate, 0 for an empty pool. Mirrors glycolysis.rs's private `saturation`.
#must_use
#pure
fn _ry_glycolysis_saturation(x: f64, k: f64): f64 {
    if (x > 0.0) {
        var r: f64 = x / (k + x);
        return r;
    }
    return 0.0;
}

# ── the tick ──

# ry_glycolysis_state_tick with a multiplicative modifier on PFK-1 (`pfk_modifier`, clamped to [0, 1] by
# `_ry_guard_unit`): the metabolic network passes citrate's inhibition here (the Randle cycle), which the pathway
# alone cannot see. Mirrors the crate-private `GlycolysisState::tick_regulated`.
fn _ry_glycolysis_state_tick_regulated(p: *RyGlycolysisState, c: *RyGlycolysisConfig, atp_in: f64, adp_in: f64,
  nad_in: f64, pfk_in: f64, dt: f64, out: *RyGlycolysisFlux) {
    if (_ry_guard_valid_dt(dt) == 0) {
        memset(out, 0, 120);
        return 0;
    }
    var pfk_modifier: f64 = _ry_guard_unit(pfk_in);
    var atp: f64 = _ry_guard_conc(atp_in);
    var adp: f64 = _ry_guard_conc(adp_in);
    var nad_ratio: f64 = _ry_guard_conc(nad_in);
    var glucose: f64 = p.glucose;
    if (_ry_trace_on() == 1) {
        var h[24];
        var b[256];
        var e = _ry_ev(&h, &b, 256, "rasayan::glycolysis", "glycolysis_tick");
        _ry_ev_f(e, "dt", dt);
        _ry_ev_f(e, "atp", atp);
        _ry_ev_f(e, "adp", adp);
        _ry_ev_f(e, "glucose", glucose);
        _ry_trace(e);
    }
    var g6p: f64 = p.g6p;
    var f6p: f64 = p.f6p;
    var f16bp: f64 = p.f16bp;
    var dhap: f64 = p.dhap;
    var g3p: f64 = p.g3p;
    var bpg13: f64 = p.bpg13;
    var pg3: f64 = p.pg3;
    var pg2: f64 = p.pg2;
    var pep: f64 = p.pep;
    var pyruvate: f64 = p.pyruvate;

    # ── the rates (mM/s), from the state at the start of the tick ──
    # Step 1, hexokinase: competitive product inhibition by G6P; ATP is the co-substrate.
    var hk: f64 = ry_competitive_inhibition(glucose, g6p, c.hk_vmax, c.hk_km_glucose, c.hk_ki_g6p);
    var hk_atp: f64 = _ry_glycolysis_saturation(atp, RY_GLYCOLYSIS_HK_KM_ATP);
    var v1: f64 = hk * hk_atp;
    # Step 2, phosphoglucose isomerase.
    var v2: f64 = ry_reversible_michaelis_menten(g6p, f6p, c.pgi_vmax_f, c.pgi_km_f, c.pgi_vmax_r, c.pgi_km_r);
    # Step 3, PFK-1: Hill kinetics, its Vmax scaled down as the ATP/ADP ratio rises (`powi(2)`: one multiply).
    var eps: f64 = 0x3CB0000000000000;           # f64::EPSILON
    var ratio: f64 = RY_MAX_ATP_ADP_RATIO;
    if (adp > eps) { ratio = atp / adp; }
    var q: f64 = ratio / c.pfk_atp_half_inhibition;
    var pfk_atp_factor: f64 = 1.0 / (1.0 + q * q);
    var pfk_vmax: f64 = c.pfk_vmax * pfk_atp_factor * pfk_modifier;
    var pfk: f64 = ry_hill_equation(f6p, pfk_vmax, c.pfk_km_f6p, c.pfk_hill_n);
    var pfk_atp: f64 = _ry_glycolysis_saturation(atp, RY_GLYCOLYSIS_PFK_KM_ATP);
    var v3: f64 = pfk * pfk_atp;
    # Step 4, aldolase: the reverse rate on the trioses' geometric mean (DHAP + G3P → F1,6BP).
    var v4_forward: f64 = ry_michaelis_menten(f16bp, c.aldo_vmax_f, c.aldo_km_f);
    var trioses: f64 = dhap * g3p;
    var triose_product: f64 = f64_sqrt(trioses);
    var v4_reverse: f64 = ry_michaelis_menten(triose_product, c.aldo_vmax_r, c.aldo_km_r);
    var v4: f64 = v4_forward - v4_reverse;
    # Step 5, triose phosphate isomerase.
    var v5: f64 = ry_reversible_michaelis_menten(dhap, g3p, c.tpi_vmax_f, c.tpi_km_f, c.tpi_vmax_r, c.tpi_km_r);
    # Step 6, GAPDH: Michaelis-Menten in cytosolic NAD+.
    var nad_factor: f64 = _ry_glycolysis_gapdh_nad_factor(nad_ratio);
    var gapdh_vmax: f64 = c.gapdh_vmax * nad_factor;
    var v6: f64 = ry_michaelis_menten(g3p, gapdh_vmax, c.gapdh_km_g3p);
    # Step 7, phosphoglycerate kinase: forward needs ADP, the reverse ATP.
    var v7_raw: f64 = ry_reversible_michaelis_menten(bpg13, pg3, c.pgk_vmax_f, c.pgk_km_f, c.pgk_vmax_r, c.pgk_km_r);
    var v7: f64 = 0.0;
    if (v7_raw >= 0.0) {
        var pgk_adp: f64 = _ry_glycolysis_saturation(adp, RY_GLYCOLYSIS_PGK_KM_ADP);
        v7 = v7_raw * pgk_adp;
    } else {
        var pgk_atp: f64 = _ry_glycolysis_saturation(atp, RY_GLYCOLYSIS_PGK_KM_ADP);
        v7 = v7_raw * pgk_atp;
    }
    # Steps 8 and 9, phosphoglycerate mutase and enolase.
    var v8: f64 = ry_reversible_michaelis_menten(pg3, pg2, c.pgm_vmax_f, c.pgm_km_f, c.pgm_vmax_r, c.pgm_km_r);
    var v9: f64 = ry_reversible_michaelis_menten(pg2, pep, c.eno_vmax_f, c.eno_km_f, c.eno_vmax_r, c.eno_km_r);
    # Step 10, pyruvate kinase: Hill kinetics with F1,6BP feed-forward activation, capped at its maximum fold.
    var feed: f64 = 1.0 + f16bp / c.pk_f16bp_ka;
    var f16bp_activation: f64 = _ry_min(feed, c.pk_f16bp_max_activation);
    var pk_vmax: f64 = c.pk_vmax * f16bp_activation;
    var pk: f64 = ry_hill_equation(pep, pk_vmax, c.pk_km_pep, c.pk_hill_n);
    var pk_adp: f64 = _ry_glycolysis_saturation(adp, RY_GLYCOLYSIS_PK_KM_ADP);
    var v10: f64 = pk * pk_adp;

    # ── Euler, step by step in pathway order, each transfer capped at the pool it drains ──
    var a1: f64 = _ry_guard_take(v1 * dt, glucose);
    glucose = glucose - a1;
    g6p = g6p + a1;
    var a2: f64 = _ry_guard_shift(v2 * dt, g6p, f6p);
    g6p = g6p - a2;
    f6p = f6p + a2;
    var a3: f64 = _ry_guard_take(v3 * dt, f6p);
    f6p = f6p - a3;
    f16bp = f16bp + a3;
    var triose_min: f64 = _ry_min(dhap, g3p);   # the reverse consumes one of each triose
    var a4: f64 = _ry_guard_shift(v4 * dt, f16bp, triose_min);
    f16bp = f16bp - a4;
    dhap = dhap + a4;
    g3p = g3p + a4;
    var a5: f64 = _ry_guard_shift(v5 * dt, dhap, g3p);
    dhap = dhap - a5;
    g3p = g3p + a5;
    var a6: f64 = _ry_guard_take(v6 * dt, g3p);
    g3p = g3p - a6;
    bpg13 = bpg13 + a6;
    var a7: f64 = _ry_guard_shift(v7 * dt, bpg13, pg3);
    bpg13 = bpg13 - a7;
    pg3 = pg3 + a7;
    var a8: f64 = _ry_guard_shift(v8 * dt, pg3, pg2);
    pg3 = pg3 - a8;
    pg2 = pg2 + a8;
    var a9: f64 = _ry_guard_shift(v9 * dt, pg2, pep);
    pg2 = pg2 - a9;
    pep = pep + a9;
    var a10: f64 = _ry_guard_take(v10 * dt, pep);
    pep = pep - a10;
    pyruvate = pyruvate + a10;
    p.glucose = glucose;
    p.g6p = g6p;
    p.f6p = f6p;
    p.f16bp = f16bp;
    p.dhap = dhap;
    p.g3p = g3p;
    p.bpg13 = bpg13;
    p.pg3 = pg3;
    p.pg2 = pg2;
    p.pep = pep;
    p.pyruvate = pyruvate;

    # ── the flux: the amounts actually moved ──
    var atp_consumed: f64 = a1 + a3;
    var atp_produced: f64 = a7 + a10;
    var inv_dt: f64 = 1.0 / dt;
    out.atp_consumed = atp_consumed;
    out.atp_produced = atp_produced;
    out.net_atp = atp_produced - atp_consumed;
    out.nadh_produced = a6;
    out.pyruvate_produced = a10;
    out.rate_hk = a1 * inv_dt;
    out.rate_pgi = a2 * inv_dt;
    out.rate_pfk = a3 * inv_dt;
    out.rate_aldo = a4 * inv_dt;
    out.rate_tpi = a5 * inv_dt;
    out.rate_gapdh = a6 * inv_dt;
    out.rate_pgk = a7 * inv_dt;
    out.rate_pgm = a8 * inv_dt;
    out.rate_eno = a9 * inv_dt;
    out.rate_pk = a10 * inv_dt;
    return 0;
}

# Advances glycolysis by `dt` seconds (explicit Euler) and fills *out with the flux. The cofactors `atp`, `adp` (mM)
# and `nad_ratio` (NAD+/NADH) drive regulation and are not modified: the caller applies the flux to its pools. The
# rates come from the concentrations at the start of the tick; the steps then apply in pathway order, each transfer
# capped at the pool it drains (the substrate, or the product for a reversible step running backwards), so no `dt`
# drives a pool negative or creates carbon: ry_glycolysis_state_total_carbon is conserved. The flux reports the capped
# amounts. A non-finite or non-positive dt is "no time passed" (the state untouched, a zero flux); a NaN, infinite or
# negative cofactor counts as 0. Rust recommends dt <= 0.1 s. Mirrors `GlycolysisState::tick`.
fn ry_glycolysis_state_tick(p: *RyGlycolysisState, c: *RyGlycolysisConfig, atp: f64, adp: f64, nad_ratio: f64,
  dt: f64, out: *RyGlycolysisFlux) {
    return _ry_glycolysis_state_tick_regulated(p, c, atp, adp, nad_ratio, 1.0, dt, out);
}

# ── pools ──

# The sum of the intermediates G6P through PEP (mM), without glucose and pyruvate. Not conserved: aldolase splits a
# hexose into two trioses; ry_glycolysis_state_total_carbon is the mass balance. Mirrors
# `GlycolysisState::total_intermediates`.
#must_use
#pure
fn ry_glycolysis_state_total_intermediates(p: *RyGlycolysisState): f64 {
    var r: f64 = p.g6p + p.f6p + p.f16bp + p.dhap + p.g3p + p.bpg13 + p.pg3 + p.pg2 + p.pep;
    return r;
}

# The carbon held in glycolysis (mM of carbon atoms): 6 × the hexoses (glucose, G6P, F6P, F1,6BP) + 3 × the trioses
# (DHAP, G3P, 1,3BPG, 3PG, 2PG, PEP, pyruvate). Every step conserves it, so a tick leaves it unchanged for any dt; only
# the caller's glucose and pyruvate change it. Mirrors `GlycolysisState::total_carbon`.
#must_use
#pure
fn ry_glycolysis_state_total_carbon(p: *RyGlycolysisState): f64 {
    var hexoses: f64 = p.glucose + p.g6p + p.f6p + p.f16bp;
    var trioses: f64 = p.dhap + p.g3p + p.bpg13 + p.pg3 + p.pg2 + p.pep + p.pyruvate;
    var r: f64 = 6.0 * hexoses + 3.0 * trioses;
    return r;
}

# Adds a sub-step's flux `o` into the tick total `t`: the amounts summed, the per-second rates weighted by `weight`
# (the sub-step over the tick's length), so the total reads as if the tick had been one step. Mirrors the
# crate-private `GlycolysisFlux::accumulate`.
fn _ry_glycolysis_flux_accumulate(t: *RyGlycolysisFlux, o: *RyGlycolysisFlux, weight: f64) {
    var wt = t;
    var wo = o;
    var k = 0;
    while (k < 5) {
        var x: f64 = load64(wt + 8 * k);
        var y: f64 = load64(wo + 8 * k);
        var s: f64 = x + y;
        store64(wt + 8 * k, load64(&s));
        k = k + 1;
    }
    while (k < 15) {
        var r: f64 = load64(wt + 8 * k);
        var q: f64 = load64(wo + 8 * k);
        var u: f64 = r + q * weight;
        store64(wt + 8 * k, load64(&u));
        k = k + 1;
    }
    return 0;
}

# ── JSON (P7: serde_json's documents) ──

# Appends GlycolysisState `p` as serde_json writes it, `{"glucose":…,…,"pyruvate":…}`, on allocator `a`: Ok(0), or
# Err(RY_ERR_OUT_OF_MEMORY) when the builder could not grow.
#must_use
fn ry_glycolysis_state_to_json_a(a, sb, p: *RyGlycolysisState): Result {
    if (_ry_jw_f64_fields(a, sb, p, 11, &_RY_GLYCOLYSIS_STATE_FIELDS) != 0) { return Err(RY_ERR_OUT_OF_MEMORY); }
    return Ok(0);
}

# ry_glycolysis_state_to_json_a on the default allocator (a builder from str_builder_new).
#must_use
fn ry_glycolysis_state_to_json(sb, p: *RyGlycolysisState): Result {
    return ry_glycolysis_state_to_json_a(default_alloc(), sb, p);
}

# The GlycolysisState at node `v` of a parsed document, by serde's rules (as ry_glycolysis_state_from_json_a reads it),
# into the 88 bytes at `w`: 1, or 0 for a refusal (what `w` holds then is unspecified). The metabolic network's readers
# call it for their nested values.
#must_use
fn _ry_glycolysis_state_from_node(v, w): i64 {
    return _ry_jr_f64_fields(v, w, 11, &_RY_GLYCOLYSIS_STATE_FIELDS);
}

# Reads a GlycolysisState from the `n`-byte document at `buf` by serde's rules (its tree on allocator `a`, which the
# caller resets): Ok(0) with *out filled, or Err(RY_ERR_DESERIALIZE).
#must_use
fn ry_glycolysis_state_from_json_a(a, buf, n, out: *RyGlycolysisState): Result {
    var w[88];
    var v = _ry_jr_parse(a, buf, n);
    if (_ry_glycolysis_state_from_node(v, &w) == 0) {
        return Err(_ry_fail_text(RY_ERR_DESERIALIZE, "GlycolysisState", 15));
    }
    memcpy(out, &w, 88);
    return Ok(0);
}

# ry_glycolysis_state_from_json_a on the default allocator (the tree is never freed: for a one-off read).
#must_use
fn ry_glycolysis_state_from_json(buf, n, out: *RyGlycolysisState): Result {
    return ry_glycolysis_state_from_json_a(default_alloc(), buf, n, out);
}

# Appends GlycolysisConfig `p` as serde_json writes it, its 38 fields in declaration order, on allocator `a`: Ok(0), or
# Err(RY_ERR_OUT_OF_MEMORY).
#must_use
fn ry_glycolysis_config_to_json_a(a, sb, p: *RyGlycolysisConfig): Result {
    if (_ry_jw_f64_fields(a, sb, p, 38, &_RY_GLYCOLYSIS_CONFIG_FIELDS) != 0) { return Err(RY_ERR_OUT_OF_MEMORY); }
    return Ok(0);
}

# ry_glycolysis_config_to_json_a on the default allocator.
#must_use
fn ry_glycolysis_config_to_json(sb, p: *RyGlycolysisConfig): Result {
    return ry_glycolysis_config_to_json_a(default_alloc(), sb, p);
}

