# --- enzyme.cyr ---

# enzyme.cyr — enzyme kinetics: Michaelis-Menten, inhibition, allosteric regulation, multi-substrate kinetics,
# linearization fits, and the enzyme database (Rust 1.2.0's `enzyme.rs`, transcribed).
#
# Rates for enzyme-catalyzed reactions. Concentrations in molar (M), rates in M/s, temperatures in kelvin, energies in
# J/mol. Rate functions treat a NaN, infinite or negative substrate, product or inhibitor concentration as 0
# (`_ry_guard_conc`), so a bad input yields a finite rate instead of propagating NaN into a simulation.
#
# Every operation is in Rust's order: tests/golden/enzyme.tsv compares each function with the oracle's at ≤ 2 ulp
# where only + − × ÷ run (class B, expected 0) and at 0 ulp against the corrected oracle where Hill and Q10 call `powf`
# and Arrhenius `exp` (class C, ADR 0003: `_ry_cr_pow`, `_ry_cr_exp`).
#
# The Cyrius forms (ADR 0002 rows 2, 3, 10):
# - KineticFit, EnzymeParams and KnownEnzyme are structs (RyKineticFit, RyEnzymeParams, RyKnownEnzyme), methods take
#   a pointer: `ry_enzyme_params_rate(&p, s)`;
# - the fits' Option<KineticFit> is a 1 (Some: *out filled) or 0 (None: *out untouched), and their `&[(f64, f64)]` a
#   pointer to n (s, v) pairs of f64 (16 bytes each);
# - `lookup_enzyme`'s Option<&KnownEnzyme> is the entry's index into the generated table (src/enzyme_data.cyr), or
#   -1; `ry_known_enzyme(i, &e)` fills a RyKnownEnzyme from it;
# - each serde type has `ry_<type>_to_json` (and `_a`, on an allocator) and, for KineticFit and EnzymeParams,
#   `ry_<type>_from_json` (and `_a`), src/json.cyr's writers and readers.

# ── single-substrate rate equations ──

# Michaelis-Menten reaction rate, `v = Vmax * [S] / (Km + [S])`: substrate (M), vmax (M/s), km (M). Mirrors
# `enzyme::michaelis_menten`.
#must_use
#pure
fn ry_michaelis_menten(substrate: f64, vmax: f64, km: f64): f64 {
    var s: f64 = _ry_guard_conc(substrate);
    var denom: f64 = km + s;
    if (denom > 0.0) {
        var r: f64 = vmax * s / denom;
        return r;
    }
    return 0.0;
}

# The Hill equation's fractional saturation, `s^n / (k^n + s^n)`, in [0, 1], evaluated as `1 / (1 + (k/s)^n)` (one
# `powf`, no inf/inf for a large s, no 0/0 when both powers underflow). s NaN, <= 0 or infinite → 0; k == 0 → 1; k
# negative, NaN or +inf → 0; n NaN → 0. Shared by ry_hill_equation and signal's dose-response functions. Mirrors the
# crate-private `enzyme::hill_fraction`.
#must_use
#pure
fn _ry_enzyme_hill_fraction(substrate: f64, k: f64, n: f64): f64 {
    var s: f64 = _ry_guard_conc(substrate);
    if (s <= 0.0 || _ry_is_nan(n) == 1) { return 0.0; }
    if (k == 0.0) { return 1.0; }
    if (k > 0.0 && k < _RY_INF) {
        var q: f64 = k / s;
        var p: f64 = _ry_cr_pow(q, n);
        var r: f64 = 1.0 / (1.0 + p);
        return r;
    }
    return 0.0;
}

# Hill equation for cooperative / allosteric binding, `v = Vmax * [S]^n / (K_half^n + [S]^n)`, as `Vmax / (1 +
# (K_half/[S])^n)`: a NaN, negative or infinite [S] gives 0; K_half == 0 gives Vmax for any positive [S]; a negative or
# non-finite K_half gives 0. Mirrors `enzyme::hill_equation`.
#must_use
#pure
fn ry_hill_equation(substrate: f64, vmax: f64, k_half: f64, n: f64): f64 {
    var frac: f64 = _ry_enzyme_hill_fraction(substrate, k_half, n);
    var r: f64 = vmax * frac;
    return r;
}

# ── inhibition models ──
# With [I] == 0 there is no inhibition whatever Ki is; Ki = +inf means that mode of inhibition is absent; with
# [I] > 0, a Ki that is <= 0 or NaN is the limit Ki → 0 (infinitely tight binding) and the rate is 0.

# The inhibition factor `1 + [I]/Ki` as (1, factor), or (0, 0) when the inhibitor is present and Ki is <= 0 or NaN
# (fully inhibited). Mirrors the private `inhibition_factor`'s Option<f64>.
#must_use
#pure
fn _ry_enzyme_inhibition_factor(inhibitor: f64, ki: f64): (i64, f64) {
    var i: f64 = _ry_guard_conc(inhibitor);
    if (i <= 0.0) { return (1, 1.0); }
    if (ki > 0.0) {
        var f: f64 = 1.0 + i / ki;
        return (1, f);
    }
    return (0, 0.0);
}

# Competitive inhibition, `v = Vmax * [S] / (Km * (1 + [I]/Ki) + [S])`: the apparent Km rises, Vmax is unchanged.
# Mirrors `enzyme::competitive_inhibition`.
#must_use
#pure
fn ry_competitive_inhibition(substrate: f64, inhibitor: f64, vmax: f64, km: f64, ki: f64): f64 {
    var has, factor = _ry_enzyme_inhibition_factor(inhibitor, ki);
    if (has == 0) { return 0.0; }
    var km_app: f64 = km * factor;
    var r: f64 = ry_michaelis_menten(substrate, vmax, km_app);
    return r;
}

# Uncompetitive inhibition, `v = Vmax / (1 + [I]/Ki) * [S] / (Km / (1 + [I]/Ki) + [S])`: Vmax and Km fall together.
# Mirrors `enzyme::uncompetitive_inhibition`.
#must_use
#pure
fn ry_uncompetitive_inhibition(substrate: f64, inhibitor: f64, vmax: f64, km: f64, ki: f64): f64 {
    var has, factor = _ry_enzyme_inhibition_factor(inhibitor, ki);
    if (has == 0) { return 0.0; }
    var vmax_app: f64 = vmax / factor;
    var km_app: f64 = km / factor;
    var r: f64 = ry_michaelis_menten(substrate, vmax_app, km_app);
    return r;
}

# Mixed (noncompetitive) inhibition, `v = Vmax * [S] / (Km * (1 + [I]/Ki) + [S] * (1 + [I]/Ki'))`: the inhibitor
# binds the free enzyme (Ki) and the enzyme-substrate complex (Ki'); Ki == Ki' is pure noncompetitive inhibition.
# Mirrors `enzyme::mixed_inhibition`.
#must_use
#pure
fn ry_mixed_inhibition(substrate: f64, inhibitor: f64, vmax: f64, km: f64, ki: f64, ki_prime: f64): f64 {
    var ha, alpha = _ry_enzyme_inhibition_factor(inhibitor, ki);
    var hp, alpha_prime = _ry_enzyme_inhibition_factor(inhibitor, ki_prime);
    if (ha == 0 || hp == 0) { return 0.0; }
    var s: f64 = _ry_guard_conc(substrate);
    var denom: f64 = km * alpha + s * alpha_prime;
    if (denom > 0.0) {
        var r: f64 = vmax * s / denom;
        return r;
    }
    return 0.0;
}

# Substrate inhibition, `v = Vmax * [S] / (Km + [S] + [S]^2 / Ks)`: Michaelis-Menten at low [S], falling at high [S].
# Ks NaN or <= 0 gives 0; Ks = +inf is plain Michaelis-Menten. Mirrors `enzyme::substrate_inhibition`.
#must_use
#pure
fn ry_substrate_inhibition(substrate: f64, vmax: f64, km: f64, ks: f64): f64 {
    if (_ry_is_nan(ks) == 1 || ks <= 0.0) { return 0.0; }
    var s: f64 = _ry_guard_conc(substrate);
    var denom: f64 = km + s + s * s / ks;
    if (denom > 0.0) {
        var r: f64 = vmax * s / denom;
        return r;
    }
    return 0.0;
}

# ── reversible kinetics ──

# Reversible Michaelis-Menten (Haldane-simplified, no dead-end cross term), `v = (Vf * [S]/Km_f - Vr * [P]/Km_r) /
# (1 + [S]/Km_f + [P]/Km_r)`: positive is net forward. Both Km must be > 0, else 0. Mirrors
# `enzyme::reversible_michaelis_menten`.
#must_use
#pure
fn ry_reversible_michaelis_menten(substrate: f64, product: f64, vmax_f: f64, km_f: f64, vmax_r: f64, km_r: f64): f64 {
    if ((km_f > 0.0 && km_r > 0.0) == 0) { return 0.0; }
    var s: f64 = _ry_guard_conc(substrate);
    var p: f64 = _ry_guard_conc(product);
    var num: f64 = vmax_f * s / km_f - vmax_r * p / km_r;
    var den: f64 = 1.0 + s / km_f + p / km_r;
    if (den > 0.0) {
        var r: f64 = num / den;
        return r;
    }
    return 0.0;
}

# The Haldane relationship, `Keq = (Vmax_f * Km_r) / (Vmax_r * Km_f)`; 0 when `Vmax_r * Km_f <= 0`. Mirrors
# `enzyme::haldane_keq`.
#must_use
#pure
fn ry_haldane_keq(vmax_f: f64, km_f: f64, vmax_r: f64, km_r: f64): f64 {
    var den: f64 = vmax_r * km_f;
    if (den <= 0.0) { return 0.0; }
    var num: f64 = vmax_f * km_r;
    var r: f64 = num / den;
    return r;
}

# ── multi-substrate kinetics ──

# Ping-pong (double-displacement) bi-substrate rate, `v = Vmax * [A] * [B] / (Km_A * [B] + Km_B * [A] + [A] * [B])`.
# Mirrors `enzyme::ping_pong`.
#must_use
#pure
fn ry_ping_pong(a0: f64, b0: f64, vmax: f64, km_a: f64, km_b: f64): f64 {
    var a: f64 = _ry_guard_conc(a0);
    var b: f64 = _ry_guard_conc(b0);
    var denom: f64 = km_a * b + km_b * a + a * b;
    if (denom > 0.0) {
        var r: f64 = vmax * a * b / denom;
        return r;
    }
    return 0.0;
}

# Sequential (ordered or random) bi-substrate rate, `v = Vmax * [A] * [B] / (Ki_A * Km_B + Km_B * [A] + Km_A * [B] +
# [A] * [B])`: both substrates bind before catalysis. Mirrors `enzyme::sequential_bisubstrate`.
#must_use
#pure
fn ry_sequential_bisubstrate(a0: f64, b0: f64, vmax: f64, km_a: f64, km_b: f64, ki_a: f64): f64 {
    var a: f64 = _ry_guard_conc(a0);
    var b: f64 = _ry_guard_conc(b0);
    var denom: f64 = ki_a * km_b + km_b * a + km_a * b + a * b;
    if (denom > 0.0) {
        var r: f64 = vmax * a * b / denom;
        return r;
    }
    return 0.0;
}

# ── temperature dependence ──

# The Q10 model, `rate_new = rate_ref * Q10^((T - T_ref) / 10)`; a Q10 that is <= 0 or non-finite gives 0. Mirrors
# `enzyme::q10_rate`.
#must_use
#pure
fn ry_q10_rate(rate_ref: f64, q10: f64, temp: f64, temp_ref: f64): f64 {
    if (_ry_is_finite(q10) == 1 && q10 > 0.0) {
        var e: f64 = (temp - temp_ref) / 10.0;
        var p: f64 = _ry_cr_pow(q10, e);
        var r: f64 = rate_ref * p;
        return r;
    }
    return 0.0;
}

# The Arrhenius equation, `k = A * exp(-Ea / (R * T))`: pre-exponential A, activation energy Ea (J/mol), T (K); 0 for
# T <= 0. Mirrors `enzyme::arrhenius`.
#must_use
#pure
fn ry_arrhenius(pre_exponential: f64, activation_energy: f64, temp_kelvin: f64): f64 {
    if (temp_kelvin <= 0.0) { return 0.0; }
    var nea: f64 = -activation_energy;
    var rt: f64 = RY_R_GAS * temp_kelvin;
    var x: f64 = nea / rt;
    var e: f64 = _ry_cr_exp(x);
    var r: f64 = pre_exponential * e;
    return r;
}

# The two-temperature Arrhenius form, `k2 = k1 * exp((Ea / R) * (1/T1 - 1/T2))`; 0 when T1 or T2 is <= 0. Mirrors
# `enzyme::arrhenius_relative`.
#must_use
#pure
fn ry_arrhenius_relative(rate_at_t1: f64, activation_energy: f64, t1: f64, t2: f64): f64 {
    if (t1 <= 0.0 || t2 <= 0.0) { return 0.0; }
    var ear: f64 = activation_energy / RY_R_GAS;
    var i1: f64 = 1.0 / t1;
    var i2: f64 = 1.0 / t2;
    var d: f64 = i1 - i2;
    var x: f64 = ear * d;
    var e: f64 = _ry_cr_exp(x);
    var r: f64 = rate_at_t1 * e;
    return r;
}

# ── linearization fits ──

# A kinetic fit: estimated Km (M), Vmax (M/s) and the linear fit's R². Rust's `KineticFit`.
struct RyKineticFit {
    km: f64;
    vmax: f64;
    r_squared: f64;
}

# Point `k` of the n (s, v) pairs at `data`, as the regression of `kind` sees it, into the two words at `xy`: kind 0
# the pair itself; 1 Lineweaver-Burk's (1/s, 1/v) and 2 Eadie-Hofstee's (v/s, v), for a usable point only (finite s
# and v, both > 0: Rust's `valid_point` filter). 1 when the point is in, else 0.
fn _ry_enzyme_point(data, k, kind, xy): i64 {
    var s: f64 = load64(data + 16 * k);
    var v: f64 = load64(data + 16 * k + 8);
    if (kind == 0) {
        store64(xy, load64(&s));
        store64(xy + 8, load64(&v));
        return 1;
    }
    if ((_ry_is_finite(s) == 1 && _ry_is_finite(v) == 1 && s > 0.0 && v > 0.0) == 0) { return 0; }
    if (kind == 1) {
        var x1: f64 = 1.0 / s;
        var y1: f64 = 1.0 / v;
        store64(xy, load64(&x1));
        store64(xy + 8, load64(&y1));
        return 1;
    }
    var x2: f64 = v / s;
    store64(xy, load64(&x2));
    store64(xy + 8, load64(&v));
    return 1;
}

# Ordinary least squares on the points `_ry_enzyme_point(data, k, kind)` gives, with centred two-pass sums (Sxx =
# Σ(x − x̄)², Sxy = Σ(x − x̄)(y − ȳ)) and a relative degeneracy test (Sxx <= 1e-12·Σx²), in Rust's summation order.
# (slope, intercept, R²) into the three words at `out` and 1, or 0 (Rust's None) when fewer than 2 points are in,
# any is non-finite, all x are numerically equal, or the fit overflows. The transform is applied in each pass, so no
# transformed copy of the data is made. Mirrors the private `linear_regression` (over the fits' transformed points).
fn _ry_enzyme_linear_regression(data, n, kind, out): i64 {
    var xy[16];
    var count = 0;
    var sum_x: f64 = 0.0;
    var sum_y: f64 = 0.0;
    var k = 0;
    while (k < n) {
        if (_ry_enzyme_point(data, k, kind, &xy) == 1) {
            var x: f64 = load64(&xy);
            var y: f64 = load64(&xy + 8);
            if (_ry_is_finite(x) == 0 || _ry_is_finite(y) == 0) { return 0; }
            sum_x = sum_x + x;
            sum_y = sum_y + y;
            count = count + 1;
        }
        k = k + 1;
    }
    if (count < 2) { return 0; }
    var nf: f64 = f64_from(count);
    var mean_x: f64 = sum_x / nf;
    var mean_y: f64 = sum_y / nf;
    var sxx: f64 = 0.0;
    var sxy: f64 = 0.0;
    var syy: f64 = 0.0;
    var sum_x2: f64 = 0.0;
    k = 0;
    while (k < n) {
        if (_ry_enzyme_point(data, k, kind, &xy) == 1) {
            var px: f64 = load64(&xy);
            var py: f64 = load64(&xy + 8);
            var dx: f64 = px - mean_x;
            var dy: f64 = py - mean_y;
            sxx = sxx + dx * dx;
            sxy = sxy + dx * dy;
            syy = syy + dy * dy;
            sum_x2 = sum_x2 + px * px;
        }
        k = k + 1;
    }
    var tol: f64 = _RY_ENZYME_REGRESSION_REL_TOL * sum_x2;
    if (_ry_is_finite(sxx) == 0 || sxx <= tol) { return 0; }
    var slope: f64 = sxy / sxx;
    var intercept: f64 = mean_y - slope * mean_x;
    if ((_ry_is_finite(slope) == 1 && _ry_is_finite(intercept) == 1) == 0) { return 0; }
    var r2: f64 = 0.0;
    if (syy > 0.0) {
        var q: f64 = sxy / syy;
        var raw: f64 = slope * q;
        r2 = _ry_clamp(raw, 0.0, 1.0);
    }
    store64(out, load64(&slope));
    store64(out + 8, load64(&intercept));
    store64(out + 16, load64(&r2));
    return 1;
}

# 1 when a fitted Km / Vmax pair is physically meaningful (both finite and > 0), else 0. Mirrors `valid_fit`.
#must_use
#pure
fn _ry_enzyme_valid_fit(km: f64, vmax: f64): i64 {
    if (_ry_is_finite(km) == 1 && _ry_is_finite(vmax) == 1 && km > 0.0 && vmax > 0.0) { return 1; }
    return 0;
}

# Fits Km and Vmax to the n (s, v) pairs at `data` by Lineweaver-Burk (double-reciprocal) linearization, `1/v =
# (Km/Vmax)·(1/[S]) + 1/Vmax`, skipping zero, negative and non-finite points. 1 with *out filled, or 0 (None) when
# fewer than 2 usable points remain, the regression is degenerate, or the fitted Km or Vmax is not finite and > 0.
# Mirrors `enzyme::lineweaver_burk_fit`.
fn ry_lineweaver_burk_fit(data, n, out: *RyKineticFit): i64 {
    var r[24];
    if (_ry_enzyme_linear_regression(data, n, 1, &r) == 0) { return 0; }
    var slope: f64 = load64(&r);
    var intercept: f64 = load64(&r + 8);
    var r2: f64 = load64(&r + 16);
    var vmax: f64 = 1.0 / intercept;
    var km: f64 = slope * vmax;
    if (_ry_enzyme_valid_fit(km, vmax) == 0) { return 0; }
    out.km = km;
    out.vmax = vmax;
    out.r_squared = r2;
    return 1;
}

# Fits Km and Vmax by Eadie-Hofstee linearization, `v = Vmax − Km·(v/[S])` (slope −Km, intercept Vmax): less
# sensitive than Lineweaver-Burk to outliers at extreme concentrations. Same filtering and None cases. Mirrors
# `enzyme::eadie_hofstee_fit`.
fn ry_eadie_hofstee_fit(data, n, out: *RyKineticFit): i64 {
    var r[24];
    if (_ry_enzyme_linear_regression(data, n, 2, &r) == 0) { return 0; }
    var slope: f64 = load64(&r);
    var vmax: f64 = load64(&r + 8);
    var r2: f64 = load64(&r + 16);
    var km: f64 = -slope;
    if (_ry_enzyme_valid_fit(km, vmax) == 0) { return 0; }
    out.km = km;
    out.vmax = vmax;
    out.r_squared = r2;
    return 1;
}

# ── EnzymeParams ──

# Enzyme parameters for one reaction: Vmax (M/s), Km (M), the Hill coefficient (1.0 for Michaelis-Menten), kcat (1/s).
# Rust's `EnzymeParams`.
struct RyEnzymeParams {
    vmax: f64;
    km: f64;
    hill_n: f64;
    kcat: f64;
}

# Ok(0) when every field is finite, vmax and kcat >= 0 and km and hill_n > 0; else the first failing guard's Err (in
# Rust's order: vmax, km, kcat, hill_n). Mirrors `EnzymeParams::validate`.
#must_use
fn ry_enzyme_params_validate(p: *RyEnzymeParams): Result {
    var vmax: f64 = p.vmax;
    var km: f64 = p.km;
    var kcat: f64 = p.kcat;
    var hill_n: f64 = p.hill_n;
    var t1, v1 = _ry_guard_non_negative("vmax", vmax);
    if (is_err_result(t1) == 1) { return Err(v1); }
    var t2, v2 = _ry_guard_positive("km", km);
    if (is_err_result(t2) == 1) { return Err(v2); }
    var t3, v3 = _ry_guard_non_negative("kcat", kcat);
    if (is_err_result(t3) == 1) { return Err(v3); }
    var t4, v4 = _ry_guard_positive("hill_n", hill_n);
    if (is_err_result(t4) == 1) { return Err(v4); }
    return Ok(0);
}

# Catalytic efficiency kcat / Km (0 unless Km > 0). Mirrors `EnzymeParams::catalytic_efficiency`.
#must_use
#pure
fn ry_enzyme_params_catalytic_efficiency(p: *RyEnzymeParams): f64 {
    var km: f64 = p.km;
    var kcat: f64 = p.kcat;
    if (km > 0.0) {
        var r: f64 = kcat / km;
        return r;
    }
    return 0.0;
}

# The reaction rate at `substrate`: Michaelis-Menten when |hill_n − 1| < f64::EPSILON, else the Hill equation with
# K_half = km. Mirrors `EnzymeParams::rate`.
#must_use
#pure
fn ry_enzyme_params_rate(p: *RyEnzymeParams, substrate: f64): f64 {
    var vmax: f64 = p.vmax;
    var km: f64 = p.km;
    var hill_n: f64 = p.hill_n;
    var eps: f64 = 0x3CB0000000000000;
    var d: f64 = hill_n - 1.0;
    var ad: f64 = f64_abs(d);
    if (ad < eps) {
        var mm: f64 = ry_michaelis_menten(substrate, vmax, km);
        return mm;
    }
    var h: f64 = ry_hill_equation(substrate, vmax, km, hill_n);
    return h;
}

# ── the enzyme database ──

# A well-characterized enzyme with published kinetic constants: its name, EC number and primary substrate (C strings
# into the generated table), Km (M), kcat (1/s), the Hill coefficient. Rust's `KnownEnzyme`; the entries are
# src/enzyme_data.cyr's columns (`RY_KNOWN_ENZYME_*`, Rust's KNOWN_ENZYMES).
struct RyKnownEnzyme {
    name;
    ec_number;
    substrate;
    km: f64;
    kcat: f64;
    hill_n: f64;
}

# Fills *out with database entry `i` (0 … RY_KNOWN_ENZYME_COUNT − 1, Rust's `KNOWN_ENZYMES[i]`): 1, or 0 when `i` is no
# entry.
fn ry_known_enzyme(i, out: *RyKnownEnzyme): i64 {
    if (i < 0 || i >= RY_KNOWN_ENZYME_COUNT) { return 0; }
    out.name = &_RY_KNOWN_ENZYME_NAME_BYTES + _RY_KNOWN_ENZYME_NAME_OFF[i];
    out.ec_number = &_RY_KNOWN_ENZYME_EC_NUMBER_BYTES + _RY_KNOWN_ENZYME_EC_NUMBER_OFF[i];
    out.substrate = &_RY_KNOWN_ENZYME_SUBSTRATE_BYTES + _RY_KNOWN_ENZYME_SUBSTRATE_OFF[i];
    var km: f64 = RY_KNOWN_ENZYME_KM[i];
    var kcat: f64 = RY_KNOWN_ENZYME_KCAT[i];
    var hill_n: f64 = RY_KNOWN_ENZYME_HILL_N[i];
    out.km = km;
    out.kcat = kcat;
    out.hill_n = hill_n;
    return 1;
}

# The index of the database entry named [name, name + len), compared ignoring ASCII case (Rust's
# `eq_ignore_ascii_case`), the first that matches; -1 when none does. Mirrors `enzyme::lookup_enzyme`'s
# Option<&KnownEnzyme> (ry_known_enzyme fills the entry).
#must_use
fn ry_lookup_enzyme(name, len): i64 {
    if (len <= 0) { return 0 - 1; }
    var c0 = load8(name);
    if (c0 >= 65 && c0 <= 90) { c0 = c0 + 32; }
    var r = 0;
    while (r < RY_KNOWN_ENZYME_COUNT) {
        var e = &_RY_KNOWN_ENZYME_NAME_BYTES + _RY_KNOWN_ENZYME_NAME_OFF[r];
        # The first byte, case-folded, before the length: most entries differ there.
        var e0 = load8(e);
        if (e0 >= 65 && e0 <= 90) { e0 = e0 + 32; }
        var el = 0;
        if (e0 == c0) { el = strlen(e); }
        if (el == len) {
            var same = 1;
            var k = 0;
            while (k < len) {
                var x = load8(e + k);
                var y = load8(name + k);
                if (x >= 65 && x <= 90) { x = x + 32; }
                if (y >= 65 && y <= 90) { y = y + 32; }
                if (x != y) {
                    same = 0;
                    break;
                }
                k = k + 1;
            }
            if (same == 1) { return r; }
        }
        r = r + 1;
    }
    return 0 - 1;
}

# Fills *out with the EnzymeParams of entry `e` at total enzyme concentration `enzyme_conc` (M): Vmax = kcat·[E], Km,
# hill_n and kcat as the entry's. Mirrors `KnownEnzyme::params`.
fn ry_known_enzyme_params(e: *RyKnownEnzyme, enzyme_conc: f64, out: *RyEnzymeParams) {
    var kcat: f64 = e.kcat;
    var km: f64 = e.km;
    var hill_n: f64 = e.hill_n;
    var vmax: f64 = kcat * enzyme_conc;
    out.vmax = vmax;
    out.km = km;
    out.hill_n = hill_n;
    out.kcat = kcat;
    return 0;
}

# Catalytic efficiency kcat / Km (1/(M·s)) of entry `e` (0 unless Km > 0). Mirrors `KnownEnzyme::catalytic_efficiency`.
#must_use
#pure
fn ry_known_enzyme_catalytic_efficiency(e: *RyKnownEnzyme): f64 {
    var km: f64 = e.km;
    var kcat: f64 = e.kcat;
    if (km > 0.0) {
        var r: f64 = kcat / km;
        return r;
    }
    return 0.0;
}

# ── JSON (P7: serde_json's documents) ──

# The NUL-separated field names of the two all-f64 serde types, in Rust's declaration order.
var _RY_KINETIC_FIT_FIELDS = "km\0vmax\0r_squared\0";
var _RY_ENZYME_PARAMS_FIELDS = "vmax\0km\0hill_n\0kcat\0";

# Appends KineticFit `p` as serde_json writes it, `{"km":…,"vmax":…,"r_squared":…}`, on allocator `a`: Ok(0), or
# Err(RY_ERR_OUT_OF_MEMORY) when the builder could not grow.
#must_use
fn ry_kinetic_fit_to_json_a(a, sb, p: *RyKineticFit): Result {
    if (_ry_jw_f64_fields(a, sb, p, 3, _RY_KINETIC_FIT_FIELDS) != 0) { return Err(RY_ERR_OUT_OF_MEMORY); }
    return Ok(0);
}

# ry_kinetic_fit_to_json_a on the default allocator (a builder from str_builder_new).
#must_use
fn ry_kinetic_fit_to_json(sb, p: *RyKineticFit): Result {
    return ry_kinetic_fit_to_json_a(default_alloc(), sb, p);
}

# Reads a KineticFit from the `n`-byte document at `buf` by serde's rules (its tree on allocator `a`, which the caller
# resets): Ok(0) with *out filled, or Err(RY_ERR_DESERIALIZE).
#must_use
fn ry_kinetic_fit_from_json_a(a, buf, n, out: *RyKineticFit): Result {
    var w[24];
    var v = _ry_jr_parse(a, buf, n);
    if (_ry_jr_f64_fields(v, &w, 3, _RY_KINETIC_FIT_FIELDS) == 0) {
        return Err(_ry_fail_text(RY_ERR_DESERIALIZE, "KineticFit", 10));
    }
    memcpy(out, &w, 24);
    return Ok(0);
}

# ry_kinetic_fit_from_json_a on the default allocator (the tree is never freed: for a one-off read).
#must_use
fn ry_kinetic_fit_from_json(buf, n, out: *RyKineticFit): Result {
    return ry_kinetic_fit_from_json_a(default_alloc(), buf, n, out);
}

# Appends EnzymeParams `p` as serde_json writes it, `{"vmax":…,"km":…,"hill_n":…,"kcat":…}`: Ok(0), or
# Err(RY_ERR_OUT_OF_MEMORY).
#must_use
fn ry_enzyme_params_to_json_a(a, sb, p: *RyEnzymeParams): Result {
    if (_ry_jw_f64_fields(a, sb, p, 4, _RY_ENZYME_PARAMS_FIELDS) != 0) { return Err(RY_ERR_OUT_OF_MEMORY); }
    return Ok(0);
}

# ry_enzyme_params_to_json_a on the default allocator.
#must_use
fn ry_enzyme_params_to_json(sb, p: *RyEnzymeParams): Result {
    return ry_enzyme_params_to_json_a(default_alloc(), sb, p);
}

# Reads an EnzymeParams by serde's rules: Ok(0) with *out filled, or Err(RY_ERR_DESERIALIZE).
#must_use
fn ry_enzyme_params_from_json_a(a, buf, n, out: *RyEnzymeParams): Result {
    var w[32];
    var v = _ry_jr_parse(a, buf, n);
    if (_ry_jr_f64_fields(v, &w, 4, _RY_ENZYME_PARAMS_FIELDS) == 0) {
        return Err(_ry_fail_text(RY_ERR_DESERIALIZE, "EnzymeParams", 12));
    }
    memcpy(out, &w, 32);
    return Ok(0);
}

# ry_enzyme_params_from_json_a on the default allocator.
#must_use
fn ry_enzyme_params_from_json(buf, n, out: *RyEnzymeParams): Result {
    return ry_enzyme_params_from_json_a(default_alloc(), buf, n, out);
}

# Appends KnownEnzyme `e` as serde_json writes it (Serialize only in Rust: `&'static str` fields), `{"name":…,
# "ec_number":…,"substrate":…,"km":…,"kcat":…,"hill_n":…}`: Ok(0), or Err(RY_ERR_OUT_OF_MEMORY).
#must_use
fn ry_known_enzyme_to_json_a(a, sb, e: *RyKnownEnzyme): Result {
    var km: f64 = e.km;
    var kcat: f64 = e.kcat;
    var hill_n: f64 = e.hill_n;
    var r = _ry_jw_byte(a, sb, 123);
    r = r | _ry_jw_key(a, sb, "name", 1);
    r = r | _ry_jw_str(a, sb, e.name, strlen(e.name));
    r = r | _ry_jw_key(a, sb, "ec_number", 0);
    r = r | _ry_jw_str(a, sb, e.ec_number, strlen(e.ec_number));
    r = r | _ry_jw_key(a, sb, "substrate", 0);
    r = r | _ry_jw_str(a, sb, e.substrate, strlen(e.substrate));
    r = r | _ry_jw_key(a, sb, "km", 0);
    r = r | _ry_jw_f64(a, sb, km);
    r = r | _ry_jw_key(a, sb, "kcat", 0);
    r = r | _ry_jw_f64(a, sb, kcat);
    r = r | _ry_jw_key(a, sb, "hill_n", 0);
    r = r | _ry_jw_f64(a, sb, hill_n);
    r = r | _ry_jw_byte(a, sb, 125);
    if (r != 0) { return Err(RY_ERR_OUT_OF_MEMORY); }
    return Ok(0);
}

# ry_known_enzyme_to_json_a on the default allocator.
#must_use
fn ry_known_enzyme_to_json(sb, e: *RyKnownEnzyme): Result {
    return ry_known_enzyme_to_json_a(default_alloc(), sb, e);
}

# --- membrane_data.cyr ---

# rasayan — membrane data: the default membrane permeability ratios and ion concentrations
#
# GENERATED from rasayan 1.2.0's source (rust-old/, the functional spec, read as text). Do not edit.
# Checked: python3 -I -B scripts/oracle/validate.py . (every value against that source)
#
# DEFAULT_PERMEABILITY and IonicState::default(), from rasayan 1.2.0: one f64 const per
# field of each value, as a round-trip decimal. tests/golden/membrane.tsv pins them.

# Ion permeability ratios for the Goldman equation.
#
# Default resting permeability ratios, P_K : P_Na : P_Cl = 1 : 0.04 : 0.45.
#
# These are the classic squid giant axon ratios (Hodgkin & Katz 1949,
# *J. Physiol.* 108:37), widely used as a generic resting-membrane default;
# mammalian neurons vary (P_Na/P_K is often quoted at 0.01-0.05).
# Rust: rasayan::membrane::DEFAULT_PERMEABILITY

# Na+ relative permeability.
# Rust: rasayan::membrane::DEFAULT_PERMEABILITY.p_na
const RY_MEMBRANE_DEFAULT_PERMEABILITY_P_NA = 0.04;

# K+ relative permeability.
# Rust: rasayan::membrane::DEFAULT_PERMEABILITY.p_k
const RY_MEMBRANE_DEFAULT_PERMEABILITY_P_K = 1.0;

# Cl- relative permeability.
# Rust: rasayan::membrane::DEFAULT_PERMEABILITY.p_cl
const RY_MEMBRANE_DEFAULT_PERMEABILITY_P_CL = 0.45;

# Ion concentrations for a typical mammalian neuron.
# Typical mammalian neuron values (the `impl Default for IonicState` literal).
# Rust: rasayan::membrane::IonicState::default()

# Na+ intracellular (mM).
# Rust: rasayan::membrane::IonicState::default().na_in
const RY_MEMBRANE_IONIC_STATE_DEFAULT_NA_IN = 12.0;

# Na+ extracellular (mM).
# Rust: rasayan::membrane::IonicState::default().na_out
const RY_MEMBRANE_IONIC_STATE_DEFAULT_NA_OUT = 145.0;

# K+ intracellular (mM).
# Rust: rasayan::membrane::IonicState::default().k_in
const RY_MEMBRANE_IONIC_STATE_DEFAULT_K_IN = 155.0;

# K+ extracellular (mM).
# Rust: rasayan::membrane::IonicState::default().k_out
const RY_MEMBRANE_IONIC_STATE_DEFAULT_K_OUT = 4.0;

# Cl- intracellular (mM).
# Rust: rasayan::membrane::IonicState::default().cl_in
const RY_MEMBRANE_IONIC_STATE_DEFAULT_CL_IN = 4.0;

# Cl- extracellular (mM).
# Rust: rasayan::membrane::IonicState::default().cl_out
const RY_MEMBRANE_IONIC_STATE_DEFAULT_CL_OUT = 120.0;

# --- membrane.cyr ---

# membrane.cyr — membrane transport: Fick diffusion, the Nernst potential, the Goldman-Hodgkin-Katz equation (Rust
# 1.2.0's `membrane.rs`, transcribed).
#
# Potentials in mV, temperatures in kelvin, concentrations in mM, Fick's flux in SI units (m²/s, mol/m³, m). An
# input where the potential or flux is undefined (a temperature, concentration, weighted sum or ratio that is not a
# finite value > 0; a zero charge; an overflowing flux) gives 0.0, so a bad input never poisons a simulation with NaN.
#
# Every operation is in Rust's order: tests/golden/membrane.tsv compares each function with the oracle's at ≤ 2 ulp
# where only + − × ÷ run (class B, expected 0) and at 0 ulp against the corrected oracle where Nernst and Goldman call
# `ln` (class C, ADR 0003: `_ry_cr_ln`).
#
# The Cyrius forms (ADR 0002 row 10):
# - MembranePermeability and IonicState are structs (RyMembranePermeability, RyIonicState); methods and `goldman`
#   take pointers: `ry_goldman(t, &ions, &perm)`, `ry_ionic_state_resting_potential(&ions)`;
# - `nernst`'s `z: i32` is an i64 charge (`z as f64` is `f64_from(z)`, exact for every i32);
# - DEFAULT_PERMEABILITY and `IonicState::default()`'s values are generated consts (src/membrane_data.cyr,
#   `RY_MEMBRANE_DEFAULT_PERMEABILITY_*`, `RY_MEMBRANE_IONIC_STATE_DEFAULT_*`); `impl Default` is
#   `ry_<type>_default(&out)`, which fills a struct from them;
# - each serde type has `ry_<type>_to_json` / `ry_<type>_from_json` (and `_a`, on an allocator), src/json.cyr's
#   writers and readers.

# `1` for a finite value `> 0` (temperatures, concentrations, ratios that feed a logarithm), else 0. Mirrors
# membrane.rs's private `finite_positive`.
#must_use
#pure
#inline
fn _ry_membrane_finite_positive(x: f64): i64 {
    return _ry_is_finite(x) == 1 && x > 0.0;
}

# ── potentials ──

# The Nernst potential of one ion (mV), `E = (RT/zF) · ln([out]/[in])`: temperature (K), the ion's charge z, the
# extracellular and intracellular concentrations. 0.0 when z == 0, when the temperature or either concentration is
# not a finite value > 0, or when their ratio overflows or underflows (the potential is undefined there). Mirrors
# `membrane::nernst`.
#must_use
#pure
fn ry_nernst(temp_kelvin: f64, z, conc_out: f64, conc_in: f64): f64 {
    if (z == 0) { return 0.0; }
    if (_ry_membrane_finite_positive(temp_kelvin) == 0) { return 0.0; }
    if (_ry_membrane_finite_positive(conc_out) == 0 || _ry_membrane_finite_positive(conc_in) == 0) { return 0.0; }
    var ratio: f64 = conc_out / conc_in;
    if (_ry_membrane_finite_positive(ratio) == 0) { return 0.0; }
    var zf: f64 = f64_from(z);
    var rt: f64 = RY_R_GAS * temp_kelvin;
    var zfar: f64 = zf * RY_FARADAY;
    var k: f64 = rt / zfar;
    var l: f64 = _ry_cr_ln(ratio);
    var r: f64 = k * l * 1000.0;
    return r;
}

# Ion permeability ratios for the Goldman equation: Na+, K+ and Cl- relative permeabilities. Rust's
# `MembranePermeability`.
struct RyMembranePermeability {
    p_na: f64;
    p_k: f64;
    p_cl: f64;
}

# Ion concentrations (mM), intracellular and extracellular, of Na+, K+ and Cl-. Rust's `IonicState`.
struct RyIonicState {
    na_in: f64;
    na_out: f64;
    k_in: f64;
    k_out: f64;
    cl_in: f64;
    cl_out: f64;
}

# The Goldman-Hodgkin-Katz voltage equation for Na+, K+ and Cl- (mV), `(RT/F) · ln(num/den)` with
# `num = P_Na·[Na]out + P_K·[K]out + P_Cl·[Cl]in` and `den = P_Na·[Na]in + P_K·[K]in + P_Cl·[Cl]out`. 0.0 when the
# temperature is not a finite value > 0, or when either weighted sum or their ratio is not (a NaN or ±inf anywhere
# fails those tests, so no input needs sanitizing). Negative concentrations or permeabilities are invalid:
# ry_ionic_state_validate and ry_membrane_permeability_validate refuse them. Mirrors `membrane::goldman`.
#must_use
#pure
fn ry_goldman(temp_kelvin: f64, ions: *RyIonicState, perm: *RyMembranePermeability): f64 {
    if (_ry_membrane_finite_positive(temp_kelvin) == 0) { return 0.0; }
    var p_na: f64 = perm.p_na;
    var p_k: f64 = perm.p_k;
    var p_cl: f64 = perm.p_cl;
    var na_in: f64 = ions.na_in;
    var na_out: f64 = ions.na_out;
    var k_in: f64 = ions.k_in;
    var k_out: f64 = ions.k_out;
    var cl_in: f64 = ions.cl_in;
    var cl_out: f64 = ions.cl_out;
    var num: f64 = p_na * na_out + p_k * k_out + p_cl * cl_in;
    var den: f64 = p_na * na_in + p_k * k_in + p_cl * cl_out;
    if (_ry_membrane_finite_positive(num) == 0 || _ry_membrane_finite_positive(den) == 0) { return 0.0; }
    var ratio: f64 = num / den;
    if (_ry_membrane_finite_positive(ratio) == 0) { return 0.0; }
    var rt: f64 = RY_R_GAS * temp_kelvin;
    var k: f64 = rt / RY_FARADAY;
    var l: f64 = _ry_cr_ln(ratio);
    var r: f64 = k * l * 1000.0;
    return r;
}

# ── diffusion ──

# Fick's first law across a membrane, `J = -D · ΔC / Δx`: D (m²/s), ΔC = C(x + Δx) − C(x) (mol/m³, numerically mM),
# Δx (m); J in mol/(m²·s), positive along +x, so a positive ΔC gives a negative flux. 0.0 when the thickness is not a
# finite value > 0, when ΔC is non-finite or when the flux would overflow; a NaN, infinite or negative D is 0
# (`_ry_guard_conc`), and the zero keeps Rust's sign (−0 · ΔC). Mirrors `membrane::fick_flux`.
#must_use
#pure
fn ry_fick_flux(diffusion_coeff: f64, conc_diff: f64, thickness: f64): f64 {
    if (_ry_membrane_finite_positive(thickness) == 0 || _ry_is_finite(conc_diff) == 0) { return 0.0; }
    var d: f64 = _ry_guard_conc(diffusion_coeff);
    var nd: f64 = -d;
    var flux: f64 = nd * conc_diff / thickness;
    if (_ry_is_finite(flux) == 1) { return flux; }
    return 0.0;
}

# ── MembranePermeability ──

# The NUL-separated field names of the two serde types, in Rust's declaration order (validation, JSON).
var _RY_MEMBRANE_PERMEABILITY_FIELDS = "p_na\0p_k\0p_cl\0";
var _RY_IONIC_STATE_FIELDS = "na_in\0na_out\0k_in\0k_out\0cl_in\0cl_out\0";

# Fills *out with the default resting permeability ratios, P_K : P_Na : P_Cl = 1 : 0.04 : 0.45 (the squid giant axon
# ratios of Hodgkin & Katz 1949, J. Physiol. 108:37; RY_MEMBRANE_DEFAULT_PERMEABILITY_*). Mirrors
# `MembranePermeability::default()` (`DEFAULT_PERMEABILITY`).
fn ry_membrane_permeability_default(out: *RyMembranePermeability) {
    var p_na: f64 = RY_MEMBRANE_DEFAULT_PERMEABILITY_P_NA;
    var p_k: f64 = RY_MEMBRANE_DEFAULT_PERMEABILITY_P_K;
    var p_cl: f64 = RY_MEMBRANE_DEFAULT_PERMEABILITY_P_CL;
    out.p_na = p_na;
    out.p_k = p_k;
    out.p_cl = p_cl;
    return 0;
}

# Ok(0) when every permeability is finite and >= 0 (−0 passes); else, at the first field in declaration order that
# fails, Err(RY_ERR_NON_FINITE) for NaN or ±inf or Err(RY_ERR_INVALID_PARAMETER) below 0 ("permeability must be
# non-negative"). Mirrors `MembranePermeability::validate`.
#must_use
fn ry_membrane_permeability_validate(p: *RyMembranePermeability): Result {
    var w = p;                                   # a plain address: `p + n` would step n · 24 bytes
    var name = _RY_MEMBRANE_PERMEABILITY_FIELDS;
    var k = 0;
    while (k < 3) {
        var value: f64 = load64(w + 8 * k);
        var t, v = _ry_guard_finite(name, value);
        if (is_err_result(t) == 1) { return Err(v); }
        if (value < 0.0) {
            return Err(_ry_fail_f(RY_ERR_INVALID_PARAMETER, name, value, "permeability must be non-negative", 0, 0.0));
        }
        name = name + strlen(name) + 1;
        k = k + 1;
    }
    return Ok(0);
}

# ── IonicState ──

# Fills *out with typical mammalian neuron concentrations (RY_MEMBRANE_IONIC_STATE_DEFAULT_*: Na+ 12 / 145, K+ 155 /
# 4, Cl- 4 / 120 mM, in / out). Mirrors `IonicState::default()`.
fn ry_ionic_state_default(out: *RyIonicState) {
    var na_in: f64 = RY_MEMBRANE_IONIC_STATE_DEFAULT_NA_IN;
    var na_out: f64 = RY_MEMBRANE_IONIC_STATE_DEFAULT_NA_OUT;
    var k_in: f64 = RY_MEMBRANE_IONIC_STATE_DEFAULT_K_IN;
    var k_out: f64 = RY_MEMBRANE_IONIC_STATE_DEFAULT_K_OUT;
    var cl_in: f64 = RY_MEMBRANE_IONIC_STATE_DEFAULT_CL_IN;
    var cl_out: f64 = RY_MEMBRANE_IONIC_STATE_DEFAULT_CL_OUT;
    out.na_in = na_in;
    out.na_out = na_out;
    out.k_in = k_in;
    out.k_out = k_out;
    out.cl_in = cl_in;
    out.cl_out = cl_out;
    return 0;
}

# Ok(0) when every concentration is finite and >= 0; else the first failing field's `_ry_guard_non_negative` Err
# (RY_ERR_NON_FINITE or RY_ERR_NEGATIVE_CONCENTRATION), in declaration order. Mirrors `IonicState::validate`.
#must_use
fn ry_ionic_state_validate(p: *RyIonicState): Result {
    var w = p;                                   # a plain address: `p + n` would step n · 48 bytes
    var name = _RY_IONIC_STATE_FIELDS;
    var k = 0;
    while (k < 6) {
        var value: f64 = load64(w + 8 * k);
        var t, v = _ry_guard_non_negative(name, value);
        if (is_err_result(t) == 1) { return Err(v); }
        name = name + strlen(name) + 1;
        k = k + 1;
    }
    return Ok(0);
}

# The resting membrane potential (mV): ry_goldman at 37 °C (RY_BODY_TEMP_K = 310.15 K) with the default
# permeabilities (P_K : P_Na : P_Cl = 1 : 0.04 : 0.45). Mirrors `IonicState::resting_potential`.
#must_use
#pure
fn ry_ionic_state_resting_potential(p: *RyIonicState): f64 {
    var perm: RyMembranePermeability;
    ry_membrane_permeability_default(&perm);
    var r: f64 = ry_goldman(RY_BODY_TEMP_K, p, &perm);
    return r;
}

# ── JSON (P7: serde_json's documents) ──

# Appends MembranePermeability `p` as serde_json writes it, `{"p_na":…,"p_k":…,"p_cl":…}`, on allocator `a`: Ok(0), or
# Err(RY_ERR_OUT_OF_MEMORY) when the builder could not grow.
#must_use
fn ry_membrane_permeability_to_json_a(a, sb, p: *RyMembranePermeability): Result {
    if (_ry_jw_f64_fields(a, sb, p, 3, _RY_MEMBRANE_PERMEABILITY_FIELDS) != 0) { return Err(RY_ERR_OUT_OF_MEMORY); }
    return Ok(0);
}

# ry_membrane_permeability_to_json_a on the default allocator (a builder from str_builder_new).
#must_use
fn ry_membrane_permeability_to_json(sb, p: *RyMembranePermeability): Result {
    return ry_membrane_permeability_to_json_a(default_alloc(), sb, p);
}

# Reads a MembranePermeability from the `n`-byte document at `buf` by serde's rules (its tree on allocator `a`, which
# the caller resets): Ok(0) with *out filled, or Err(RY_ERR_DESERIALIZE).
#must_use
fn ry_membrane_permeability_from_json_a(a, buf, n, out: *RyMembranePermeability): Result {
    var w[24];
    var v = _ry_jr_parse(a, buf, n);
    if (_ry_jr_f64_fields(v, &w, 3, _RY_MEMBRANE_PERMEABILITY_FIELDS) == 0) {
        return Err(_ry_fail_text(RY_ERR_DESERIALIZE, "MembranePermeability", 20));
    }
    memcpy(out, &w, 24);
    return Ok(0);
}

# ry_membrane_permeability_from_json_a on the default allocator (the tree is never freed: for a one-off read).
#must_use
fn ry_membrane_permeability_from_json(buf, n, out: *RyMembranePermeability): Result {
    return ry_membrane_permeability_from_json_a(default_alloc(), buf, n, out);
}

# Appends IonicState `p` as serde_json writes it, `{"na_in":…,"na_out":…,"k_in":…,"k_out":…,"cl_in":…,"cl_out":…}`:
# Ok(0), or Err(RY_ERR_OUT_OF_MEMORY).
#must_use
fn ry_ionic_state_to_json_a(a, sb, p: *RyIonicState): Result {
    if (_ry_jw_f64_fields(a, sb, p, 6, _RY_IONIC_STATE_FIELDS) != 0) { return Err(RY_ERR_OUT_OF_MEMORY); }
    return Ok(0);
}

# ry_ionic_state_to_json_a on the default allocator.
#must_use
fn ry_ionic_state_to_json(sb, p: *RyIonicState): Result {
    return ry_ionic_state_to_json_a(default_alloc(), sb, p);
}

# Reads an IonicState by serde's rules: Ok(0) with *out filled, or Err(RY_ERR_DESERIALIZE).
#must_use
fn ry_ionic_state_from_json_a(a, buf, n, out: *RyIonicState): Result {
    var w[48];
    var v = _ry_jr_parse(a, buf, n);
    if (_ry_jr_f64_fields(v, &w, 6, _RY_IONIC_STATE_FIELDS) == 0) {
        return Err(_ry_fail_text(RY_ERR_DESERIALIZE, "IonicState", 10));
    }
    memcpy(out, &w, 48);
    return Ok(0);
}

# ry_ionic_state_from_json_a on the default allocator.
#must_use
fn ry_ionic_state_from_json(buf, n, out: *RyIonicState): Result {
    return ry_ionic_state_from_json_a(default_alloc(), buf, n, out);
}

# --- signal_data.cyr ---

# rasayan — signal data: the second messengers' default levels
#
# GENERATED from rasayan 1.2.0's source (rust-old/, the functional spec, read as text). Do not edit.
# Checked: python3 -I -B scripts/oracle/validate.py . (every value against that source)
#
# SecondMessenger::default(), from rasayan 1.2.0: one f64 const per field, as a
# round-trip decimal, checked against the `Self { … }` literal of
# `impl Default for SecondMessenger`. tests/golden/signal.tsv pins them.

# Second messenger state.
#
# All levels are normalized to 0.0-1.0 range. Resting levels are
# maintained by basal activity and decay in [`SecondMessenger::tick`].
# Rust: rasayan::signal::SecondMessenger::default()

# cAMP level (normalized 0.0-1.0).
# Rust: rasayan::signal::SecondMessenger::default().camp
const RY_SIGNAL_SECOND_MESSENGER_DEFAULT_CAMP = 0.1;

# Intracellular Ca2+ (normalized 0.0-1.0).
# Rust: rasayan::signal::SecondMessenger::default().calcium
const RY_SIGNAL_SECOND_MESSENGER_DEFAULT_CALCIUM = 0.05;

# IP3 (inositol trisphosphate, normalized 0.0-1.0).
# Rust: rasayan::signal::SecondMessenger::default().ip3
const RY_SIGNAL_SECOND_MESSENGER_DEFAULT_IP3 = 0.05;

# --- signal.cyr ---

# signal.cyr — signal transduction: receptor binding, dose-response, second messengers (Rust 1.2.0's `signal.rs`,
# transcribed).
#
# Every operation is in Rust's order: tests/golden/signal.tsv compares each function with the oracle's at ≤ 2 ulp
# where only + − × ÷ run (class B, expected 0), at 0 ulp against the corrected oracle where dose_response calls `powf`
# and a tick's relaxation `exp_m1` (class C, ADR 0003: `_ry_cr_pow`, `_ry_cr_expm1`), and bit for bit over the
# trajectory scripts (class T: runs of up to 10⁴ steps at dt 0.001 … 5 s).
#
# The Cyrius forms (ADR 0002 rows 7, 10):
# - SecondMessenger is a struct (RySecondMessenger); its methods take a pointer and update it in place:
#   `ry_second_messenger_tick(&sm, dt)`;
# - `SecondMessenger::default()`'s values are generated consts (src/signal_data.cyr,
#   `RY_SIGNAL_SECOND_MESSENGER_DEFAULT_*`), which ry_second_messenger_default(&out) fills a struct from;
# - Rust's four `tracing::trace!` events (`activate_gs`, `activate_gi`, `activate_gq`, `second_messenger_tick`) are
#   level-gated sakshi events under the target `rasayan::signal`, their fields in Rust's order;
# - SecondMessenger's serde codec is `ry_second_messenger_to_json` / `_from_json` (and `_a`, on an allocator).

# Dose-response by the Hill function (the enzyme Hill equation's math, a different context),
# `response = Emax · [L]^n / (EC50^n + [L]^n)`, computed as `Emax / (1 + (EC50/[L])^n)` (stable for very large and very
# small concentrations). A NaN, negative or infinite ligand gives 0; ec50 == 0 gives emax for any positive ligand; a
# negative or non-finite ec50 gives 0. Mirrors `signal::dose_response`.
#must_use
#pure
fn ry_dose_response(ligand: f64, emax: f64, ec50: f64, hill_n: f64): f64 {
    var frac: f64 = _ry_enzyme_hill_fraction(ligand, ec50, hill_n);
    var r: f64 = emax * frac;
    return r;
}

# Receptor occupancy (the fraction bound), `[L] / (Kd + [L])`, in [0, 1]. A NaN, negative or infinite ligand gives 0;
# kd == 0 gives 1 for any positive ligand; a negative or non-finite kd gives 0. The n = 1 case of the Hill fraction,
# written out (no `powf`). Mirrors `signal::receptor_occupancy`.
#must_use
#pure
fn ry_receptor_occupancy(ligand: f64, kd: f64): f64 {
    var l: f64 = _ry_guard_conc(ligand);
    var denom: f64 = kd + l;
    if (l > 0.0 && kd >= 0.0 && _ry_is_finite(denom) == 1) {
        var r: f64 = l / denom;
        return r;
    }
    return 0.0;
}

# ── second messengers ──

# Second-messenger levels, each normalized to [0, 1]: cAMP, intracellular Ca2+ and IP3 (inositol trisphosphate).
# Resting levels are kept by basal activity and decay in ry_second_messenger_tick. Rust's `SecondMessenger`.
struct RySecondMessenger {
    camp: f64;
    calcium: f64;
    ip3: f64;
}

# The NUL-separated field names, in Rust's declaration order (validation, JSON).
var _RY_SECOND_MESSENGER_FIELDS = "camp\0calcium\0ip3\0";

# Fills *out with the resting levels (RY_SIGNAL_SECOND_MESSENGER_DEFAULT_*: cAMP 0.1, Ca2+ 0.05, IP3 0.05). Mirrors
# `SecondMessenger::default()`.
fn ry_second_messenger_default(out: *RySecondMessenger) {
    var camp: f64 = RY_SIGNAL_SECOND_MESSENGER_DEFAULT_CAMP;
    var calcium: f64 = RY_SIGNAL_SECOND_MESSENGER_DEFAULT_CALCIUM;
    var ip3: f64 = RY_SIGNAL_SECOND_MESSENGER_DEFAULT_IP3;
    out.camp = camp;
    out.calcium = calcium;
    out.ip3 = ip3;
    return 0;
}

# Ok(0) when every level is finite and in [0, 1] (−0 included); else the first failing field's `_ry_guard_fraction`
# Err (RY_ERR_NON_FINITE or RY_ERR_INVALID_PARAMETER), in declaration order. Mirrors `SecondMessenger::validate`.
#must_use
fn ry_second_messenger_validate(p: *RySecondMessenger): Result {
    var w = p;                                   # a plain address: `p + n` would step n · 24 bytes
    var name = _RY_SECOND_MESSENGER_FIELDS;
    var k = 0;
    while (k < 3) {
        var value: f64 = load64(w + 8 * k);
        var t, v = _ry_guard_fraction(name, value);
        if (is_err_result(t) == 1) { return Err(v); }
        name = name + strlen(name) + 1;
        k = k + 1;
    }
    return Ok(0);
}

# Activates the Gs-coupled pathway (stimulatory: cAMP rises by intensity · RY_SIGNAL_ACTIVATION_GAIN). A negative,
# NaN or infinite intensity is 0; cAMP stays in [0, 1]. Mirrors `SecondMessenger::activate_gs`.
fn ry_second_messenger_activate_gs(p: *RySecondMessenger, intensity: f64) {
    var camp: f64 = p.camp;
    if (_ry_trace_on() == 1) {
        var h[24];
        var b[256];
        var e = _ry_ev(&h, &b, 256, "rasayan::signal", "activate_gs");
        _ry_ev_f(e, "intensity", intensity);
        _ry_ev_f(e, "camp_before", camp);
        _ry_trace(e);
    }
    var i: f64 = _ry_guard_conc(intensity);
    var u: f64 = _ry_guard_unit(camp);
    var x: f64 = u + i * RY_SIGNAL_ACTIVATION_GAIN;
    var r: f64 = _ry_guard_unit(x);
    p.camp = r;
    return 0;
}

# Activates the Gi-coupled pathway (inhibitory: cAMP falls by intensity · RY_SIGNAL_ACTIVATION_GAIN). A negative, NaN
# or infinite intensity is 0. cAMP does not fall below RY_SIGNAL_CAMP_FLOOR, or below its current level if that is
# already lower: inhibition never raises cAMP. Mirrors `SecondMessenger::activate_gi`.
fn ry_second_messenger_activate_gi(p: *RySecondMessenger, intensity: f64) {
    var before: f64 = p.camp;
    if (_ry_trace_on() == 1) {
        var h[24];
        var b[256];
        var e = _ry_ev(&h, &b, 256, "rasayan::signal", "activate_gi");
        _ry_ev_f(e, "intensity", intensity);
        _ry_ev_f(e, "camp_before", before);
        _ry_trace(e);
    }
    var i: f64 = _ry_guard_conc(intensity);
    var camp: f64 = _ry_guard_unit(before);
    var lowered: f64 = camp - i * RY_SIGNAL_ACTIVATION_GAIN;
    var floor: f64 = _ry_min(RY_SIGNAL_CAMP_FLOOR, camp);
    var r: f64 = _ry_max(lowered, floor);
    p.camp = r;
    return 0;
}

# Activates the Gq-coupled pathway: IP3 rises by intensity · RY_SIGNAL_ACTIVATION_GAIN (capped at 1), and Ca2+ by
# RY_SIGNAL_IP3_CA_COUPLING times that IP3 increase, so an intensity of 0 changes nothing. A negative, NaN or infinite
# intensity is 0; both levels stay in [0, 1]. Mirrors `SecondMessenger::activate_gq`.
fn ry_second_messenger_activate_gq(p: *RySecondMessenger, intensity: f64) {
    var ip3_in: f64 = p.ip3;
    var ca_in: f64 = p.calcium;
    if (_ry_trace_on() == 1) {
        var h[24];
        var b[256];
        var e = _ry_ev(&h, &b, 256, "rasayan::signal", "activate_gq");
        _ry_ev_f(e, "intensity", intensity);
        _ry_ev_f(e, "ip3_before", ip3_in);
        _ry_ev_f(e, "ca_before", ca_in);
        _ry_trace(e);
    }
    var i: f64 = _ry_guard_conc(intensity);
    var ip3_before: f64 = _ry_guard_unit(ip3_in);
    var raised: f64 = ip3_before + i * RY_SIGNAL_ACTIVATION_GAIN;
    var ip3: f64 = _ry_guard_unit(raised);
    p.ip3 = ip3;
    var ca: f64 = _ry_guard_unit(ca_in);
    var rise: f64 = ip3 - ip3_before;
    var x: f64 = ca + rise * RY_SIGNAL_IP3_CA_COUPLING;
    var r: f64 = _ry_guard_unit(x);
    p.calcium = r;
    return 0;
}

# Relaxes each level exponentially toward its resting floor over `dt` seconds, `dx/dt = -k·(x − floor)`, with the
# RY_SIGNAL_*_DECAY_RATE constants (1/s): cAMP, then IP3, then Ca2+, as Rust writes them. Exact for any dt; the levels
# stay in [0, 1]. A non-finite or non-positive dt does nothing. Mirrors `SecondMessenger::tick`.
fn ry_second_messenger_tick(p: *RySecondMessenger, dt: f64) {
    if (_ry_guard_valid_dt(dt) == 0) { return 0; }
    if (_ry_trace_on() == 1) {
        var h[24];
        var b[256];
        var e = _ry_ev(&h, &b, 256, "rasayan::signal", "second_messenger_tick");
        _ry_ev_f(e, "dt", dt);
        _ry_trace(e);
    }
    var camp: f64 = p.camp;
    var cu: f64 = _ry_guard_unit(camp);
    var c2: f64 = _ry_integrate_relax(cu, RY_SIGNAL_CAMP_FLOOR, RY_SIGNAL_CAMP_DECAY_RATE, dt);
    p.camp = c2;
    var ip3: f64 = p.ip3;
    var iu: f64 = _ry_guard_unit(ip3);
    var i2: f64 = _ry_integrate_relax(iu, RY_SIGNAL_IP3_FLOOR, RY_SIGNAL_IP3_DECAY_RATE, dt);
    p.ip3 = i2;
    var ca: f64 = p.calcium;
    var au: f64 = _ry_guard_unit(ca);
    var a2: f64 = _ry_integrate_relax(au, RY_SIGNAL_CA_FLOOR, RY_SIGNAL_CA_DECAY_RATE, dt);
    p.calcium = a2;
    return 0;
}

# The overall signaling intensity, the mean of the three levels. Mirrors `SecondMessenger::intensity`.
#must_use
#pure
fn ry_second_messenger_intensity(p: *RySecondMessenger): f64 {
    var camp: f64 = p.camp;
    var calcium: f64 = p.calcium;
    var ip3: f64 = p.ip3;
    var r: f64 = (camp + calcium + ip3) / 3.0;
    return r;
}

# ── JSON (P7: serde_json's documents) ──

# Appends SecondMessenger `p` as serde_json writes it, `{"camp":…,"calcium":…,"ip3":…}`, on allocator `a`: Ok(0), or
# Err(RY_ERR_OUT_OF_MEMORY) when the builder could not grow.
#must_use
fn ry_second_messenger_to_json_a(a, sb, p: *RySecondMessenger): Result {
    if (_ry_jw_f64_fields(a, sb, p, 3, _RY_SECOND_MESSENGER_FIELDS) != 0) { return Err(RY_ERR_OUT_OF_MEMORY); }
    return Ok(0);
}

# ry_second_messenger_to_json_a on the default allocator (a builder from str_builder_new).
#must_use
fn ry_second_messenger_to_json(sb, p: *RySecondMessenger): Result {
    return ry_second_messenger_to_json_a(default_alloc(), sb, p);
}

# Reads a SecondMessenger from the `n`-byte document at `buf` by serde's rules (its tree on allocator `a`, which the
# caller resets): Ok(0) with *out filled, or Err(RY_ERR_DESERIALIZE).
#must_use
fn ry_second_messenger_from_json_a(a, buf, n, out: *RySecondMessenger): Result {
    var w[24];
    var v = _ry_jr_parse(a, buf, n);
    if (_ry_jr_f64_fields(v, &w, 3, _RY_SECOND_MESSENGER_FIELDS) == 0) {
        return Err(_ry_fail_text(RY_ERR_DESERIALIZE, "SecondMessenger", 15));
    }
    memcpy(out, &w, 24);
    return Ok(0);
}

# ry_second_messenger_from_json_a on the default allocator (the tree is never freed: for a one-off read).
#must_use
fn ry_second_messenger_from_json(buf, n, out: *RySecondMessenger): Result {
    return ry_second_messenger_from_json_a(default_alloc(), buf, n, out);
}

# --- metabolism_data.cyr ---

# rasayan — metabolism data: the default metabolic state
#
# GENERATED from rasayan 1.2.0's source (rust-old/, the functional spec, read as text). Do not edit.
# Checked: python3 -I -B scripts/oracle/validate.py . (every value against that source)
#
# MetabolicState::default(), from rasayan 1.2.0: one f64 const per field, as a
# round-trip decimal, checked against the `Self { … }` literal of
# `impl Default for MetabolicState`. tests/golden/metabolism.tsv pins them.

# Metabolic state tracking ATP/ADP balance and pathway activity.
# Rust: rasayan::metabolism::MetabolicState::default()

# ATP concentration (mM, typical resting: 5-8 mM).
# Rust: rasayan::metabolism::MetabolicState::default().atp
const RY_METABOLISM_METABOLIC_STATE_DEFAULT_ATP = 6.0;

# Low-energy adenylate, ADP + AMP (mM).
#
# ATP hydrolysis adds to this pool and regeneration draws on it, so
# `atp + adp` is the total adenylate. Adenylate kinase splits it into
# free ADP and AMP ([`free_adp`](Self::free_adp),
# [`amp`](Self::amp)); at the usual ATP/ADP ratios nearly all of it is
# ADP (≈ 97 % in the default state).
# Rust: rasayan::metabolism::MetabolicState::default().adp
const RY_METABOLISM_METABOLIC_STATE_DEFAULT_ADP = 0.5;

# NAD+/NADH ratio (higher = more oxidized, typical: 700).
# Rust: rasayan::metabolism::MetabolicState::default().nad_ratio
const RY_METABOLISM_METABOLIC_STATE_DEFAULT_NAD_RATIO = 700.0;

# Glucose available (mM, typical blood: 4-6 mM).
# Rust: rasayan::metabolism::MetabolicState::default().glucose
const RY_METABOLISM_METABOLIC_STATE_DEFAULT_GLUCOSE = 5.0;

# Oxygen available (normalized, 1.0 = normoxia).
# Rust: rasayan::metabolism::MetabolicState::default().oxygen
const RY_METABOLISM_METABOLIC_STATE_DEFAULT_OXYGEN = 1.0;

# Lactate concentration (mM, typical resting: 0.5-2.0).
# Rust: rasayan::metabolism::MetabolicState::default().lactate
const RY_METABOLISM_METABOLIC_STATE_DEFAULT_LACTATE = 1.0;

# --- metabolism.cyr ---

# metabolism.cyr — the metabolic state: ATP/ADP balance, the adenylate-kinase AMP, the energy charge, ATP use and
# regeneration (Rust 1.2.0's `metabolism.rs`, transcribed).
#
# Concentrations in mM, oxygen normalized (1.0 = normoxia), time in seconds. Every operation is in Rust's order:
# tests/golden/metabolism.tsv compares each method with the oracle's at ≤ 2 ulp where only + − × ÷ and √ run (class B,
# expected 0), at 0 ulp against the corrected oracle where regenerate_atp's lactate clearance calls `exp_m1` (class C,
# ADR 0003: `_ry_cr_expm1`), and bit for bit over the trajectory scripts (class T).
#
# The Cyrius forms (ADR 0002 rows 7, 10):
# - MetabolicState is a struct (RyMetabolicState); its methods take a pointer, and the two mutators update it in place:
#   `ry_metabolic_state_regenerate_atp(&m, dt)`; consume_atp returns the ATP it consumed;
# - `MetabolicState::default()`'s values are generated consts (src/metabolism_data.cyr,
#   `RY_METABOLISM_METABOLIC_STATE_DEFAULT_*`), which ry_metabolic_state_default(&out) fills a struct from;
# - the private `scaled_adenylates`'s `Option<(f64, f64, f64, f64)>` is _ry_metabolism_scaled_adenylates's 1 with four
#   f64s in a caller buffer, or 0 for None;
# - Rust's two `tracing::trace!` events (`consume_atp`, `regenerate_atp`) are level-gated sakshi events under the
#   target `rasayan::metabolism`, their fields in Rust's order;
# - MetabolicState's serde codec is `ry_metabolic_state_to_json` / `_from_json` (and `_a`, on an allocator).

# Metabolic state: ATP/ADP balance and pathway activity. `adp` is the low-energy adenylate pool, ADP + AMP (ATP
# hydrolysis adds to it, regeneration draws on it: `atp + adp` is the total adenylate); adenylate kinase splits it into
# free ADP and AMP (ry_metabolic_state_free_adp, ry_metabolic_state_amp). Rust's `MetabolicState`.
struct RyMetabolicState {
    atp: f64;
    adp: f64;
    nad_ratio: f64;
    glucose: f64;
    oxygen: f64;
    lactate: f64;
}

# The NUL-separated field names, in Rust's declaration order (validation, JSON).
var _RY_METABOLIC_STATE_FIELDS = "atp\0adp\0nad_ratio\0glucose\0oxygen\0lactate\0";

# Fills *out with the default state (RY_METABOLISM_METABOLIC_STATE_DEFAULT_*: ATP 6, ADP + AMP 0.5, NAD+/NADH 700,
# glucose 5, oxygen 1, lactate 1). Mirrors `MetabolicState::default()`.
fn ry_metabolic_state_default(out: *RyMetabolicState) {
    var atp: f64 = RY_METABOLISM_METABOLIC_STATE_DEFAULT_ATP;
    var adp: f64 = RY_METABOLISM_METABOLIC_STATE_DEFAULT_ADP;
    var nad: f64 = RY_METABOLISM_METABOLIC_STATE_DEFAULT_NAD_RATIO;
    var glucose: f64 = RY_METABOLISM_METABOLIC_STATE_DEFAULT_GLUCOSE;
    var oxygen: f64 = RY_METABOLISM_METABOLIC_STATE_DEFAULT_OXYGEN;
    var lactate: f64 = RY_METABOLISM_METABOLIC_STATE_DEFAULT_LACTATE;
    out.atp = atp;
    out.adp = adp;
    out.nad_ratio = nad;
    out.glucose = glucose;
    out.oxygen = oxygen;
    out.lactate = lactate;
    return 0;
}

# Ok(0) when every field is finite and >= 0; else, in Rust's order, the first of atp, adp, glucose, oxygen and lactate
# that `_ry_guard_non_negative` refuses, then nad_ratio: Err(RY_ERR_NON_FINITE), or Err(RY_ERR_INVALID_PARAMETER)
# below 0 ("must be non-negative"). Mirrors `MetabolicState::validate`.
#must_use
fn ry_metabolic_state_validate(p: *RyMetabolicState): Result {
    var w = p;                                   # a plain address: `p + n` would step n · 48 bytes
    var name = _RY_METABOLIC_STATE_FIELDS;
    var k = 0;
    while (k < 6) {
        if (k != 2) {                            # nad_ratio is checked last, by its own rule
            var value: f64 = load64(w + 8 * k);
            var t, v = _ry_guard_non_negative(name, value);
            if (is_err_result(t) == 1) { return Err(v); }
        }
        name = name + strlen(name) + 1;
        k = k + 1;
    }
    var nad: f64 = p.nad_ratio;
    var tf, vf = _ry_guard_finite("nad_ratio", nad);
    if (is_err_result(tf) == 1) { return Err(vf); }
    if (nad < 0.0) {
        return Err(_ry_fail_f(RY_ERR_INVALID_PARAMETER, "nad_ratio", nad, "must be non-negative", 0, 0.0));
    }
    return Ok(0);
}

# ── the adenylates ──

# The adenylate pools divided by s = max(ATP, adp), with the AMP share of adp from the adenylate-kinase equilibrium:
# 1 with out[0..4] = (s, t, l, a), t = ATP/s, l = adp/s, a = AMP/s; 0 (out untouched) when both pools are 0. With
# L = adp held fixed, `ATP·AMP = K′·(L − AMP)²` has the root `AMP = 2K′L² / (2K′L + ATP + √(ATP² + 4K′L·ATP))` in
# [0, L], the cancellation-free form, evaluated on the scaled pools (one of t, l is exactly 1: nothing overflows).
# NaN, infinite or negative pools count as 0. Mirrors metabolism.rs's private `scaled_adenylates`.
fn _ry_metabolism_scaled_adenylates(p: *RyMetabolicState, out): i64 {
    var atp_in: f64 = p.atp;
    var adp_in: f64 = p.adp;
    var atp: f64 = _ry_guard_conc(atp_in);
    var pool: f64 = _ry_guard_conc(adp_in);
    var scale: f64 = _ry_max(atp, pool);
    if (scale <= 0.0) { return 0; }
    var t: f64 = atp / scale;
    var l: f64 = pool / scale;
    var two_k: f64 = 2.0 * RY_METABOLISM_ADENYLATE_KINASE_KEQ;
    var two_k_l: f64 = two_k * l;
    var tt: f64 = t * t;
    var cross: f64 = 2.0 * two_k_l;
    var disc: f64 = tt + cross * t;
    var root: f64 = f64_sqrt(disc);
    var den: f64 = two_k_l + t + root;
    var num: f64 = two_k_l * l;
    var a: f64 = num / den;
    store64(out, load64(&scale));
    store64(out + 8, load64(&t));
    store64(out + 16, load64(&l));
    store64(out + 24, load64(&a));
    return 1;
}

# The AMP concentration (mM) the adenylate-kinase equilibrium implies: the adp pool split so that
# `ATP·AMP = RY_METABOLISM_ADENYLATE_KINASE_KEQ · ADP²` holds for the free ADP. Always finite and in [0, adp]: with no
# ATP the whole pool is AMP, with no pool it is 0. Mirrors `MetabolicState::amp`.
#must_use
#pure
fn ry_metabolic_state_amp(p: *RyMetabolicState): f64 {
    var s[32];
    if (_ry_metabolism_scaled_adenylates(p, &s) == 0) { return 0.0; }
    var scale: f64 = load64(&s);
    var a: f64 = load64(&s + 24);
    var r: f64 = scale * a;
    return r;
}

# The free ADP concentration (mM): the adp pool minus the AMP. Mirrors `MetabolicState::free_adp`.
#must_use
#pure
fn ry_metabolic_state_free_adp(p: *RyMetabolicState): f64 {
    var s[32];
    if (_ry_metabolism_scaled_adenylates(p, &s) == 0) { return 0.0; }
    var scale: f64 = load64(&s);
    var l: f64 = load64(&s + 16);
    var a: f64 = load64(&s + 24);
    var r: f64 = scale * (l - a);
    return r;
}

# The Atkinson energy charge, (ATP + ½ADP) / (ATP + ADP + AMP) with the free ADP and AMP, so the denominator is the
# total adenylate atp + adp: in [0, 1], 1 with all adenylate as ATP, 0 with no ATP; 0 with no adenylate at all. Always
# finite (NaN, infinite or negative pools count as 0). Mirrors `MetabolicState::energy_charge`.
#must_use
#pure
fn ry_metabolic_state_energy_charge(p: *RyMetabolicState): f64 {
    var s[32];
    if (_ry_metabolism_scaled_adenylates(p, &s) == 0) { return 0.0; }
    var t: f64 = load64(&s + 8);
    var l: f64 = load64(&s + 16);
    var a: f64 = load64(&s + 24);
    var free: f64 = l - a;
    var num: f64 = t + 0.5 * free;
    var r: f64 = num / (t + l);
    return r;
}

# ── rates ──

# The net ATP yield per glucose at the current oxygen level, `2 + 28 · O2` with O2 clamped to [0, 1] (NaN as 0): 2 ATP
# from glycolysis alone up to 30 with full oxidative phosphorylation. Mirrors `MetabolicState::aerobic_atp_yield`.
#must_use
#pure
fn ry_metabolic_state_aerobic_atp_yield(p: *RyMetabolicState): f64 {
    var oxygen: f64 = p.oxygen;
    var o2: f64 = _ry_guard_unit(oxygen);
    var r: f64 = 2.0 + 28.0 * o2;
    return r;
}

# 1 when anaerobic metabolism dominates (oxygen below 0.5 or lactate above 4 mM), else 0. Mirrors
# `MetabolicState::is_anaerobic`.
#must_use
#pure
fn ry_metabolic_state_is_anaerobic(p: *RyMetabolicState): i64 {
    var oxygen: f64 = p.oxygen;
    var lactate: f64 = p.lactate;
    if (oxygen < 0.5 || lactate > 4.0) { return 1; }
    return 0;
}

# The metabolic rate relative to basal (1.0 = basal), driven by the ADP share (the demand signal) and capped at 10.
# Mirrors `MetabolicState::metabolic_rate`.
#must_use
#pure
fn ry_metabolic_state_metabolic_rate(p: *RyMetabolicState): f64 {
    var atp: f64 = p.atp;
    var adp: f64 = p.adp;
    var eps: f64 = 0x3CB0000000000000;
    var demand: f64 = adp / (atp + adp + eps);
    var x: f64 = 1.0 + demand * 5.0;
    var r: f64 = _ry_min(x, 10.0);
    return r;
}

# ── ATP use and regeneration ──

# Consumes `amount` ATP for work, converting it to ADP one for one (atp + adp is conserved), and returns what was
# consumed: no more than the ATP there is. A negative, NaN or infinite amount consumes nothing. Mirrors
# `MetabolicState::consume_atp`.
fn ry_metabolic_state_consume_atp(p: *RyMetabolicState, amount: f64): f64 {
    var atp: f64 = p.atp;
    if (_ry_trace_on() == 1) {
        var h[24];
        var b[256];
        var e = _ry_ev(&h, &b, 256, "rasayan::metabolism", "consume_atp");
        _ry_ev_f(e, "amount", amount);
        _ry_ev_f(e, "atp_before", atp);
        _ry_trace(e);
    }
    var want: f64 = _ry_guard_conc(amount);
    var have: f64 = _ry_guard_conc(atp);
    var consumed: f64 = _ry_min(want, have);
    var adp: f64 = p.adp;
    var a2: f64 = atp - consumed;
    var d2: f64 = adp + consumed;
    p.atp = a2;
    p.adp = d2;
    return consumed;
}

# Regenerates ATP from ADP over `dt` seconds. Oxygen sets the yield per glucose, `2 + 28 · O2`; the rate scales with
# the same yield and the metabolic rate, is capped by the ADP pool and by what the glucose can supply, and consumes
# regen / yield glucose. The anaerobic share (1 − O2) of that glucose becomes lactate (2 per glucose), after lactate
# clears first-order at RY_METABOLISM_LACTATE_CLEARANCE_RATE · O2. atp + adp is conserved. A non-finite or
# non-positive dt does nothing. Mirrors `MetabolicState::regenerate_atp`.
fn ry_metabolic_state_regenerate_atp(p: *RyMetabolicState, dt: f64) {
    if (_ry_guard_valid_dt(dt) == 0) { return 0; }
    var atp: f64 = p.atp;
    var adp_in: f64 = p.adp;
    var oxygen: f64 = p.oxygen;
    if (_ry_trace_on() == 1) {
        var h[24];
        var b[256];
        var e = _ry_ev(&h, &b, 256, "rasayan::metabolism", "regenerate_atp");
        _ry_ev_f(e, "dt", dt);
        _ry_ev_f(e, "atp_before", atp);
        _ry_ev_f(e, "adp_before", adp_in);
        _ry_ev_f(e, "oxygen", oxygen);
        _ry_trace(e);
    }
    var o2: f64 = _ry_guard_unit(oxygen);
    var adp: f64 = _ry_guard_conc(adp_in);
    var glucose_in: f64 = p.glucose;
    var glucose: f64 = _ry_guard_conc(glucose_in);
    var atp_per_glc: f64 = 2.0 + 28.0 * o2;
    var mr: f64 = ry_metabolic_state_metabolic_rate(p);
    var eff: f64 = atp_per_glc / 30.0;
    var rate: f64 = mr * 0.5 * eff * dt;
    var cap: f64 = glucose * atp_per_glc;
    var r1: f64 = _ry_min(rate, adp);
    var regen: f64 = _ry_min(r1, cap);
    var used: f64 = regen / atp_per_glc;
    var a2: f64 = atp + regen;
    var d2: f64 = adp - regen;
    var g1: f64 = glucose - used;
    var g2: f64 = _ry_max(g1, 0.0);
    p.atp = a2;
    p.adp = d2;
    p.glucose = g2;
    var lac_in: f64 = p.lactate;
    var lac: f64 = _ry_guard_conc(lac_in);
    var k: f64 = RY_METABOLISM_LACTATE_CLEARANCE_RATE * o2;
    var cleared: f64 = _ry_integrate_relax(lac, 0.0, k, dt);
    var anaerobic: f64 = 2.0 * (1.0 - o2);
    var made: f64 = anaerobic * used;
    var l2: f64 = cleared + made;
    p.lactate = l2;
    return 0;
}

# ── JSON (P7: serde_json's documents) ──

# Appends MetabolicState `p` as serde_json writes it,
# `{"atp":…,"adp":…,"nad_ratio":…,"glucose":…,"oxygen":…,"lactate":…}`, on allocator `a`: Ok(0), or
# Err(RY_ERR_OUT_OF_MEMORY) when the builder could not grow.
#must_use
fn ry_metabolic_state_to_json_a(a, sb, p: *RyMetabolicState): Result {
    if (_ry_jw_f64_fields(a, sb, p, 6, _RY_METABOLIC_STATE_FIELDS) != 0) { return Err(RY_ERR_OUT_OF_MEMORY); }
    return Ok(0);
}

# ry_metabolic_state_to_json_a on the default allocator (a builder from str_builder_new).
#must_use
fn ry_metabolic_state_to_json(sb, p: *RyMetabolicState): Result {
    return ry_metabolic_state_to_json_a(default_alloc(), sb, p);
}

# Reads a MetabolicState from the `n`-byte document at `buf` by serde's rules (its tree on allocator `a`, which the
# caller resets): Ok(0) with *out filled, or Err(RY_ERR_DESERIALIZE).
#must_use
fn ry_metabolic_state_from_json_a(a, buf, n, out: *RyMetabolicState): Result {
    var w[48];
    var v = _ry_jr_parse(a, buf, n);
    if (_ry_jr_f64_fields(v, &w, 6, _RY_METABOLIC_STATE_FIELDS) == 0) {
        return Err(_ry_fail_text(RY_ERR_DESERIALIZE, "MetabolicState", 14));
    }
    memcpy(out, &w, 48);
    return Ok(0);
}

# ry_metabolic_state_from_json_a on the default allocator (the tree is never freed: for a one-off read).
#must_use
fn ry_metabolic_state_from_json(buf, n, out: *RyMetabolicState): Result {
    return ry_metabolic_state_from_json_a(default_alloc(), buf, n, out);
}

# --- energy_data.cyr ---

# rasayan — energy data: the default bioenergetic state
#
# GENERATED from rasayan 1.2.0's source (rust-old/, the functional spec, read as text). Do not edit.
# Checked: python3 -I -B scripts/oracle/validate.py . (every value against that source)
#
# BioenergyState::default(), from rasayan 1.2.0: one f64 const per field, as a
# round-trip decimal, checked against the `Self { … }` literal of
# `impl Default for BioenergyState`. tests/golden/energy.tsv pins them.

# Bioenergetic state of an entity.
#
# Reserves are fractions of the resting, well-fed muscle store. Time in
# [`tick`](Self::tick) is in minutes.
# Rust: rasayan::energy::BioenergyState::default()

# Phosphocreatine reserve (0.0-1.0). Immediate energy buffer.
#
# 1.0 = resting muscle PCr, ≈ 75–85 mmol/kg dry muscle (≈ 20–25
# mmol/kg wet; Harris et al. 1976).
# Rust: rasayan::energy::BioenergyState::default().phosphocreatine
const RY_ENERGY_BIOENERGY_STATE_DEFAULT_PHOSPHOCREATINE = 0.9;

# Glycogen reserve (0.0-1.0). Short-term fuel.
#
# 1.0 = resting muscle glycogen on a mixed diet, ≈ 1.75 g/100 g wet
# muscle ≈ 110 mmol glucosyl units/kg wet (Bergström et al. 1967);
# carbohydrate loading can roughly double it, which this fraction does
# not represent.
# Rust: rasayan::energy::BioenergyState::default().glycogen
const RY_ENERGY_BIOENERGY_STATE_DEFAULT_GLYCOGEN = 0.8;

# Current MET level (1.0 = resting, 10+ = vigorous exercise).
# Rust: rasayan::energy::BioenergyState::default().met
const RY_ENERGY_BIOENERGY_STATE_DEFAULT_MET = 1.0;

# Anaerobic threshold (MET level where lactate accumulates).
#
# Above it, phosphocreatine is drawn down and glycogen use gains an
# anaerobic term (see [`tick`](Self::tick)).
# Rust: rasayan::energy::BioenergyState::default().anaerobic_threshold
const RY_ENERGY_BIOENERGY_STATE_DEFAULT_ANAEROBIC_THRESHOLD = 6.0;

# --- energy.cyr ---

# energy.cyr — bioenergetics: phosphocreatine and glycogen reserves under exertion, ATP demand, and the bridge
# functions sharira and kiran call (Rust 1.2.0's `energy.rs`, transcribed).
#
# Reserves are fractions of the resting, well-fed muscle store; exertion in MET; BioenergyState's time step in
# minutes. Every operation is in Rust's order: tests/golden/energy.tsv compares each function with the oracle's at
# ≤ 2 ulp where only + − × ÷ run (class B, expected 0), at 0 ulp against the corrected oracle where a tick's
# phosphocreatine activation calls `exp_m1` (class C, ADR 0003: `_ry_cr_expm1`), bit for bit over the trajectory
# scripts (class T), and sharira 1.1.0's per-tick call shape on its own rows (`sharira::MetabolicCoupling::tick`).
#
# The Cyrius forms (ADR 0002 rows 7, 10):
# - BioenergyState is a struct (RyBioenergyState); its methods take a pointer, and the two mutators update it in
#   place: `ry_bioenergy_state_tick(&b, dt_minutes)`;
# - `BioenergyState::default()`'s values are generated consts (src/energy_data.cyr,
#   `RY_ENERGY_BIOENERGY_STATE_DEFAULT_*`), which ry_bioenergy_state_default(&out) fills a struct from;
# - `recovery_rate_modifier`'s `is_anaerobic: bool` is an i64, nonzero for true;
# - Rust's two `tracing::trace!` events (`set_exertion`, `bioenergy_tick`) are level-gated sakshi events under the
#   target `rasayan::energy`, their fields in Rust's order;
# - BioenergyState's serde codec is `ry_bioenergy_state_to_json` / `_from_json` (and `_a`, on an allocator).

# The bioenergetic state of an entity: the phosphocreatine and glycogen reserves (0–1, fractions of the resting
# muscle store), the current exertion (MET, 1.0 = resting) and the anaerobic threshold (MET). Rust's
# `BioenergyState`.
struct RyBioenergyState {
    phosphocreatine: f64;
    glycogen: f64;
    met: f64;
    anaerobic_threshold: f64;
}

# The NUL-separated field names, in Rust's declaration order (JSON).
var _RY_BIOENERGY_STATE_FIELDS = "phosphocreatine\0glycogen\0met\0anaerobic_threshold\0";

# Fills *out with the default state (RY_ENERGY_BIOENERGY_STATE_DEFAULT_*: phosphocreatine 0.9, glycogen 0.8, MET 1,
# anaerobic threshold 6). Mirrors `BioenergyState::default()`.
fn ry_bioenergy_state_default(out: *RyBioenergyState) {
    var pcr: f64 = RY_ENERGY_BIOENERGY_STATE_DEFAULT_PHOSPHOCREATINE;
    var gly: f64 = RY_ENERGY_BIOENERGY_STATE_DEFAULT_GLYCOGEN;
    var met: f64 = RY_ENERGY_BIOENERGY_STATE_DEFAULT_MET;
    var thr: f64 = RY_ENERGY_BIOENERGY_STATE_DEFAULT_ANAEROBIC_THRESHOLD;
    out.phosphocreatine = pcr;
    out.glycogen = gly;
    out.met = met;
    out.anaerobic_threshold = thr;
    return 0;
}

# Ok(0) when the reserves are finite and in [0, 1] and met and anaerobic_threshold are finite and >= 1; else, in that
# order, the first refusal (`_ry_guard_fraction`, `_ry_guard_at_least`). Mirrors `BioenergyState::validate`.
#must_use
fn ry_bioenergy_state_validate(p: *RyBioenergyState): Result {
    var pcr: f64 = p.phosphocreatine;
    var gly: f64 = p.glycogen;
    var met: f64 = p.met;
    var thr: f64 = p.anaerobic_threshold;
    var t1, v1 = _ry_guard_fraction("phosphocreatine", pcr);
    if (is_err_result(t1) == 1) { return Err(v1); }
    var t2, v2 = _ry_guard_fraction("glycogen", gly);
    if (is_err_result(t2) == 1) { return Err(v2); }
    var t3, v3 = _ry_guard_at_least("met", met, 1.0);
    if (is_err_result(t3) == 1) { return Err(v3); }
    var t4, v4 = _ry_guard_at_least("anaerobic_threshold", thr, 1.0);
    if (is_err_result(t4) == 1) { return Err(v4); }
    return Ok(0);
}

# 1 when exercising above the anaerobic threshold, else 0. Mirrors `BioenergyState::is_anaerobic`.
#must_use
#pure
fn ry_bioenergy_state_is_anaerobic(p: *RyBioenergyState): i64 {
    var met: f64 = p.met;
    var thr: f64 = p.anaerobic_threshold;
    if (met > thr) { return 1; }
    return 0;
}

# The O2 consumption rate (mL/kg/min), MET · RY_ENERGY_MET_O2_RATE. Mirrors `BioenergyState::o2_consumption`.
#must_use
#pure
fn ry_bioenergy_state_o2_consumption(p: *RyBioenergyState): f64 {
    var met: f64 = p.met;
    var r: f64 = met * RY_ENERGY_MET_O2_RATE;
    return r;
}

# Sets the exertion level (MET): below 1.0 (resting) it is raised to 1.0; NaN or infinite is resting. Mirrors
# `BioenergyState::set_exertion`.
fn ry_bioenergy_state_set_exertion(p: *RyBioenergyState, met: f64) {
    if (_ry_trace_on() == 1) {
        var h[24];
        var b[256];
        var e = _ry_ev(&h, &b, 256, "rasayan::energy", "set_exertion");
        _ry_ev_f(e, "met", met);
        _ry_trace(e);
    }
    var c: f64 = _ry_guard_conc(met);
    var r: f64 = _ry_max(c, 1.0);
    p.met = r;
    return 0;
}

# Ticks the reserves at the current exertion over `dt_minutes`. With x = MET − 1 (NaN or infinite MET counts as
# resting) and e = max(0, MET − threshold) (0 for a NaN or +inf threshold): phosphocreatine relaxes,
# `dP/dt = k_rec·(1 − P) − k_use·P` with k_rec = RY_ENERGY_PCR_RECOVERY_RATE and k_use = RY_ENERGY_PCR_DEPLETION_RATE·e
# (`_ry_integrate_activate`, exact); glycogen is used at GLYCOGEN_DEPLETION_RATE·x + GLYCOGEN_ANAEROBIC_RATE·e² per
# minute and resynthesized at GLYCOGEN_RECOVERY_RATE when MET <= GLYCOGEN_RECOVERY_THRESHOLD, capped to [0, 1]
# (`_ry_guard_shift`). Reserves outside [0, 1] or NaN are mapped into it first. A non-finite or non-positive dt does
# nothing. Mirrors `BioenergyState::tick`.
fn ry_bioenergy_state_tick(p: *RyBioenergyState, dt_minutes: f64) {
    if (_ry_guard_valid_dt(dt_minutes) == 0) { return 0; }
    var met_in: f64 = p.met;
    var thr: f64 = p.anaerobic_threshold;
    if (_ry_trace_on() == 1) {
        var h[24];
        var b[256];
        var e = _ry_ev(&h, &b, 256, "rasayan::energy", "bioenergy_tick");
        _ry_ev_f(e, "dt_minutes", dt_minutes);
        _ry_ev_f(e, "met", met_in);
        _ry_ev_f(e, "anaerobic_threshold", thr);
        _ry_trace(e);
    }
    var above_rest: f64 = _ry_guard_conc(met_in - 1.0);
    var met: f64 = 1.0 + above_rest;
    var above: f64 = _ry_guard_conc(met - thr);
    var pcr_in: f64 = p.phosphocreatine;
    var pcr: f64 = _ry_guard_unit(pcr_in);
    var k_use: f64 = RY_ENERGY_PCR_DEPLETION_RATE * above;
    var p2: f64 = _ry_integrate_activate(pcr, RY_ENERGY_PCR_RECOVERY_RATE, k_use, dt_minutes);
    p.phosphocreatine = p2;
    var aerobic: f64 = RY_ENERGY_GLYCOGEN_DEPLETION_RATE * above_rest;
    var anaerobic: f64 = RY_ENERGY_GLYCOGEN_ANAEROBIC_RATE * above * above;
    var net: f64 = aerobic + anaerobic;
    if (met <= RY_ENERGY_GLYCOGEN_RECOVERY_THRESHOLD) { net = net - RY_ENERGY_GLYCOGEN_RECOVERY_RATE; }
    var gly_in: f64 = p.glycogen;
    var gly: f64 = _ry_guard_unit(gly_in);
    var room: f64 = 1.0 - gly;
    var moved: f64 = _ry_guard_shift(net * dt_minutes, gly, room);
    var g2: f64 = gly - moved;
    p.glycogen = g2;
    return 0;
}

# The overall energy availability, `0.3 · phosphocreatine + 0.7 · glycogen` clamped to [0, 1] (a NaN passes through,
# as Rust's `clamp`). Mirrors `BioenergyState::energy_available`.
#must_use
#pure
fn ry_bioenergy_state_energy_available(p: *RyBioenergyState): f64 {
    var pcr: f64 = p.phosphocreatine;
    var gly: f64 = p.glycogen;
    var x: f64 = pcr * 0.3 + gly * 0.7;
    var r: f64 = _ry_clamp(x, 0.0, 1.0);
    return r;
}

# ── bridge functions (sharira, kiran) ──

# The ATP turnover (mmol/s) of a mechanical power output (W): ~40 % efficiency and |ΔG°′| of ATP hydrolysis
# (RY_ENERGY_ATP_HYDROLYSIS_DG, 30.5 kJ/mol). An amount per second for the whole working muscle; negative, NaN or
# infinite power is 0. Mirrors `energy::atp_demand_from_power`.
#must_use
#pure
fn ry_atp_demand_from_power(mechanical_power_w: f64): f64 {
    var power: f64 = _ry_guard_conc(mechanical_power_w);
    var metabolic: f64 = power / 0.40;
    var dg: f64 = f64_abs(RY_ENERGY_ATP_HYDROLYSIS_DG);
    var per_mol: f64 = dg * 1000.0;
    var r: f64 = (metabolic / per_mol) * 1000.0;
    return r;
}

# The fatigue rate multiplier at an energy availability: 1 at full energy, max_multiplier at none. Always finite and
# >= 1: a max_multiplier below 1, NaN or infinite counts as 1; the availability is clamped to [0, 1], NaN as 0.
# Mirrors `energy::fatigue_rate_from_energy`.
#must_use
#pure
fn ry_fatigue_rate_from_energy(energy_available: f64, max_multiplier: f64): f64 {
    var e: f64 = _ry_guard_unit(energy_available);
    var extra: f64 = _ry_guard_conc(max_multiplier - 1.0);
    var r: f64 = 1.0 + extra * (1.0 - e);
    return r;
}

# The recovery rate multiplier: 1 when aerobic (is_anaerobic 0), else anaerobic_fraction clamped to [0, 1] (NaN as
# 0). Mirrors `energy::recovery_rate_modifier`.
#must_use
#pure
fn ry_recovery_rate_modifier(is_anaerobic, anaerobic_fraction: f64): f64 {
    if (is_anaerobic != 0) {
        var r: f64 = _ry_guard_unit(anaerobic_fraction);
        return r;
    }
    return 1.0;
}

# The MET of a mechanical power output (W) at a body mass (kg), by the ACSM leg-ergometry equation:
# `VO2 = 3.5 + 3.5 + 1.8 · WR / mass` (mL/kg/min, WR in kg·m/min, 1 W = 6.12 kg·m/min; the unloaded-cycling 3.5 only
# for power > 0), MET = VO2 / 3.5, at least 1. 1 for a mass that is not finite and > 0; negative, NaN or infinite
# power is 0 W. Mirrors `energy::met_from_power`.
#must_use
#pure
fn ry_met_from_power(mechanical_power_w: f64, body_mass_kg: f64): f64 {
    if (_ry_is_finite(body_mass_kg) == 0 || body_mass_kg <= 0.0) { return 1.0; }
    var power: f64 = _ry_guard_conc(mechanical_power_w);
    var vo2: f64 = RY_ENERGY_MET_O2_RATE;
    if (power > 0.0) {
        var k: f64 = 1.8 * _RY_ENERGY_KGM_PER_MIN_PER_WATT;
        var work: f64 = k * power / body_mass_kg;
        var add: f64 = RY_ENERGY_MET_O2_RATE + work;
        vo2 = vo2 + add;
    }
    var m: f64 = vo2 / RY_ENERGY_MET_O2_RATE;
    var r: f64 = _ry_max(m, 1.0);
    return r;
}

# ── JSON (P7: serde_json's documents) ──

# Appends BioenergyState `p` as serde_json writes it,
# `{"phosphocreatine":…,"glycogen":…,"met":…,"anaerobic_threshold":…}`, on allocator `a`: Ok(0), or
# Err(RY_ERR_OUT_OF_MEMORY) when the builder could not grow.
#must_use
fn ry_bioenergy_state_to_json_a(a, sb, p: *RyBioenergyState): Result {
    if (_ry_jw_f64_fields(a, sb, p, 4, _RY_BIOENERGY_STATE_FIELDS) != 0) { return Err(RY_ERR_OUT_OF_MEMORY); }
    return Ok(0);
}

# ry_bioenergy_state_to_json_a on the default allocator (a builder from str_builder_new).
#must_use
fn ry_bioenergy_state_to_json(sb, p: *RyBioenergyState): Result {
    return ry_bioenergy_state_to_json_a(default_alloc(), sb, p);
}

# Reads a BioenergyState from the `n`-byte document at `buf` by serde's rules (its tree on allocator `a`, which the
# caller resets): Ok(0) with *out filled, or Err(RY_ERR_DESERIALIZE).
#must_use
fn ry_bioenergy_state_from_json_a(a, buf, n, out: *RyBioenergyState): Result {
    var w[32];
    var v = _ry_jr_parse(a, buf, n);
    if (_ry_jr_f64_fields(v, &w, 4, _RY_BIOENERGY_STATE_FIELDS) == 0) {
        return Err(_ry_fail_text(RY_ERR_DESERIALIZE, "BioenergyState", 14));
    }
    memcpy(out, &w, 32);
    return Ok(0);
}

# ry_bioenergy_state_from_json_a on the default allocator (the tree is never freed: for a one-off read).
#must_use
fn ry_bioenergy_state_from_json(buf, n, out: *RyBioenergyState): Result {
    return ry_bioenergy_state_from_json_a(default_alloc(), buf, n, out);
}

# --- protein.cyr ---

# protein.cyr — protein structure primitives: amino-acid properties, molecular weight, composition, net charge and the
# isoelectric point with selectable pKa sets, the extinction coefficient, Chou-Fasman secondary structure (Rust
# 1.2.0's `protein.rs`, transcribed).
#
# A sequence is `(seq, n)`: n bytes of UTF-8 at seq (Rust's `&str`). Rust iterates `chars()`; here every function
# reads bytes. For valid UTF-8 the answers are the same (port plan §2 item 6): every byte of a non-ASCII character is
# >= 0x80, never an ASCII letter, so a function that rejects an unknown residue rejects it at its first byte, and one
# that skips non-residues (composition, the net charge, the Bjellqvist termini) skips all its bytes. Invalid UTF-8,
# which a Rust `&str` cannot hold, reads as unknown residues too.
#
# Every operation is in Rust's order: tests/golden/protein.tsv compares each function with the oracle's bit for bit
# where only + − × ÷ run (classes A and B) and at 0 ulp against the corrected oracle where the Henderson-Hasselbalch
# charge calls `powf` (class C, ADR 0003: `_ry_cr_pow`).
#
# The Cyrius forms (ADR 0002 rows 1–3, 10):
# - AminoAcid is a struct (RyAminoAcid), filled from the generated table (src/protein_data.cyr) by
#   ry_amino_acid(i, &aa); its `side_chain_pka: Option<f64>` is has_side_chain_pka (1 / 0) and the value (0.0 for
#   None). `lookup`'s Option<AminoAcid> is the table index or -1, `try_lookup`'s Result Ok(index) or
#   Err(RY_ERR_UNKNOWN_AMINO_ACID);
# - an `Option<f64>` or `Option<ExtinctionCoefficient>` result is 1 with *out filled, or 0 for None (out untouched);
# - `composition`'s `Vec<(char, usize)>` fills a caller buffer of (letter, count) pairs, two words each, and returns
#   Ok(count), or Err(RY_ERR_BUFFER_TOO_SMALL) when the buffer holds fewer pairs (26 always suffice);
# - PkaSet is `enum RyPkaSet`, its values Rust's declaration order (append-only), each also the row of its pKa values
#   in the generated columns;
# - the serde types write `ry_<type>_to_json` (and `_a`, on an allocator): AminoAcid, ExtinctionCoefficient, PkaSet.

# Which published pKa values ry_isoelectric_point_with and ry_net_charge_with use (Rust's `PkaSet`): the free amino
# acids (Lehninger, the default), Bjellqvist's 2-D gel set as ExPASy uses it (position-dependent termini), EMBOSS's
# `Epk.dat`, and Kozlowski's IPC_protein. The values are append-only.
enum RyPkaSet {
    RY_PKA_SET_LEHNINGER = 0;
    RY_PKA_SET_BJELLQVIST = 1;
    RY_PKA_SET_EMBOSS = 2;
    RY_PKA_SET_IPC = 3;
}

# The number of pKa sets.
const RY_PKA_SET_COUNT = 4;

# The default pKa set, RY_PKA_SET_LEHNINGER. Mirrors `PkaSet::default()`.
#must_use
#pure
fn ry_pka_set_default(): i64 {
    return RY_PKA_SET_LEHNINGER;
}

# The variant name of a pKa set (`"Lehninger"`, …, as serde writes it), or 0 for a value that is no set.
#must_use
#pure
fn ry_pka_set_name(set): cstring {
    match set {
        RY_PKA_SET_LEHNINGER => { return "Lehninger"; }
        RY_PKA_SET_BJELLQVIST => { return "Bjellqvist"; }
        RY_PKA_SET_EMBOSS => { return "Emboss"; }
        RY_PKA_SET_IPC => { return "Ipc"; }
        _ => { return 0; }
    }
    return 0;
}

# ── amino acids ──

# A standard amino acid: its single-letter code (an ASCII byte), its three-letter abbreviation and full name (C strings
# into the generated table), the free amino acid's average molecular weight (Da), its Kyte-Doolittle hydrophobicity,
# and its side chain's pKa (has_side_chain_pka 0 when uncharged). Rust's `AminoAcid`.
struct RyAminoAcid {
    code;
    abbr;
    name;
    mw: f64;
    hydrophobicity: f64;
    has_side_chain_pka;
    side_chain_pka: f64;
}

# A string blob's entry at `off`.
#must_use
#pure
fn _ry_protein_blob(bytes, off): i64 {
    return bytes + off;
}

# Fills *out with entry i of the 20 standard amino acids (RY_AMINO_ACID_*, Rust's AMINO_ACIDS order): 1, or 0 for an
# i outside 0 .. RY_AMINO_ACID_COUNT − 1 (out untouched).
fn ry_amino_acid(i, out: *RyAminoAcid): i64 {
    if (i < 0 || i >= RY_AMINO_ACID_COUNT) { return 0; }
    out.code = RY_AMINO_ACID_CODE[i];
    out.abbr = _ry_protein_blob(&_RY_AMINO_ACID_ABBR_BYTES, _RY_AMINO_ACID_ABBR_OFF[i]);
    out.name = _ry_protein_blob(&_RY_AMINO_ACID_NAME_BYTES, _RY_AMINO_ACID_NAME_OFF[i]);
    var mw: f64 = RY_AMINO_ACID_MW[i];
    var h: f64 = RY_AMINO_ACID_HYDROPHOBICITY[i];
    var pka: f64 = RY_AMINO_ACID_SIDE_CHAIN_PKA[i];
    out.mw = mw;
    out.hydrophobicity = h;
    out.has_side_chain_pka = RY_AMINO_ACID_HAS_SIDE_CHAIN_PKA[i];
    out.side_chain_pka = pka;
    return 1;
}

# The amino acid of the character `code` (a Unicode scalar value, upper or lowercase): its index into the table
# (RY_AMINO_ACID_*), or -1 for anything that is not one of the 20 standard one-letter codes (whitespace, digits,
# non-ASCII). O(1) through the generated 26-entry index. Mirrors `protein::lookup`.
#must_use
#pure
fn ry_lookup(code): i64 {
    var c = code;
    if (c >= 97 && c <= 122) { c = c - 32; }
    if (c < 65 || c > 90) { return 0 - 1; }
    var slot = _RY_PROTEIN_LOOKUP_INDEX[c - 65];
    if (slot >= RY_AMINO_ACID_COUNT) { return 0 - 1; }
    return slot;
}

# The UTF-8 bytes of the scalar value `cp` into buf (4 bytes): their count. A value that is no scalar value (a
# surrogate, past U+10FFFF, negative) writes U+FFFD.
fn _ry_protein_utf8(cp, buf): i64 {
    var c = cp;
    if (c < 0 || c > 1114111 || (c >= 55296 && c <= 57343)) { c = 65533; }
    if (c < 128) {
        store8(buf, c);
        return 1;
    }
    if (c < 2048) {
        store8(buf, 192 | (c >> 6));
        store8(buf + 1, 128 | (c & 63));
        return 2;
    }
    if (c < 65536) {
        store8(buf, 224 | (c >> 12));
        store8(buf + 1, 128 | ((c >> 6) & 63));
        store8(buf + 2, 128 | (c & 63));
        return 3;
    }
    store8(buf, 240 | (c >> 18));
    store8(buf + 1, 128 | ((c >> 12) & 63));
    store8(buf + 2, 128 | ((c >> 6) & 63));
    store8(buf + 3, 128 | (c & 63));
    return 4;
}

# ry_lookup as a Result: Ok(index), or Err(RY_ERR_UNKNOWN_AMINO_ACID), whose DEBUG event is Rust's Display text,
# `unknown amino acid: <the character>`. Mirrors `protein::try_lookup`.
#must_use
fn ry_try_lookup(code): Result {
    var i = ry_lookup(code);
    if (i >= 0) { return Ok(i); }
    var buf[8];
    var n = _ry_protein_utf8(code, &buf);
    return Err(_ry_fail_text(RY_ERR_UNKNOWN_AMINO_ACID, &buf, n));
}

# ── molecular weight and composition ──

# The average molecular weight of the peptide (Da): the free amino acids' masses minus one water per peptide bond (n − 1
# waters for n residues, the termini keep one). 1 with *out filled, or 0 for an empty sequence or one with any
# character that is not a standard code (whitespace included). Mirrors `protein::molecular_weight`.
#must_use
fn ry_molecular_weight(seq, n, out): i64 {
    if (n == 0) { return 0; }
    var water: f64 = _RY_PROTEIN_WATER_AVG_MASS;
    var total: f64 = water;
    var i = 0;
    while (i < n) {
        var slot = ry_lookup(load8(seq + i));
        if (slot < 0) { return 0; }
        var mw: f64 = RY_AMINO_ACID_MW[slot];
        var residue: f64 = mw - water;
        total = total + residue;
        i = i + 1;
    }
    store64(out, load64(&total));
    return 1;
}

# The count of each letter in the sequence (upper and lowercase together; every ASCII letter, not only the 20 codes):
# the (letter, count) pairs of the letters that occur, in alphabetical order, into the `cap` pairs at out (the letter
# an uppercase ASCII byte, then the count; two words each). Ok(count), or Err(RY_ERR_BUFFER_TOO_SMALL) when more than
# `cap` letters occur (nothing is written). Mirrors `protein::composition`.
#must_use
fn ry_composition(seq, n, out, cap): Result {
    var counts[208];
    memset(&counts, 0, 208);
    var i = 0;
    while (i < n) {
        var c = load8(seq + i);
        if (c >= 97 && c <= 122) { c = c - 32; }
        if (c >= 65 && c <= 90) {
            var at = &counts + 8 * (c - 65);
            store64(at, load64(at) + 1);
        }
        i = i + 1;
    }
    var found = 0;
    var k = 0;
    while (k < 26) {
        if (load64(&counts + 8 * k) > 0) { found = found + 1; }
        k = k + 1;
    }
    if (found > cap) { return Err(_ry_fail_text(RY_ERR_BUFFER_TOO_SMALL, "composition", 11)); }
    var w = 0;
    k = 0;
    while (k < 26) {
        var count = load64(&counts + 8 * k);
        if (count > 0) {
            store64(out + 16 * w, 65 + k);
            store64(out + 16 * w + 8, count);
            w = w + 1;
        }
        k = k + 1;
    }
    return Ok(found);
}

# ── net charge and the isoelectric point ──

# The ionizable side chains of the sequence, counted into the 7 words at counts in SIDE_CHAINS order (D, E, C, Y, H, K,
# R), each saturating at u32::MAX as Rust's. strict 1: 1, or 0 when any character is not a standard code (Rust's
# `IonizableCounts::strict`); strict 0: other characters are ignored, and the result is 1 (`lenient`).
fn _ry_protein_counts(seq, n, strict, counts): i64 {
    memset(counts, 0, 56);
    var i = 0;
    while (i < n) {
        var c = load8(seq + i);
        if (strict == 1 && ry_lookup(c) < 0) { return 0; }
        if (c >= 97 && c <= 122) { c = c - 32; }
        var slot = 0 - 1;
        var j = 0;
        while (j < _RY_PROTEIN_SIDE_CHAIN_COUNT) {
            if (_RY_PROTEIN_SIDE_CHAIN_CODE[j] == c) { slot = j; }
            j = j + 1;
        }
        if (slot >= 0) {
            var at = counts + 8 * slot;
            var v = load64(at);
            if (v < 4294967295) { store64(at, v + 1); }
        }
        i = i + 1;
    }
    return 1;
}

# The uppercase code of the first (from_end 0) or last (from_end 1) standard residue of the sequence, or -1 if it has
# none (Rust's `sequence.chars().find_map(lookup)`, forwards or reversed).
#must_use
fn _ry_protein_terminal(seq, n, from_end): i64 {
    var k = 0;
    while (k < n) {
        var i = k;
        if (from_end == 1) { i = n - 1 - k; }
        var slot = ry_lookup(load8(seq + i));
        if (slot >= 0) { return RY_AMINO_ACID_CODE[slot]; }
        k = k + 1;
    }
    return 0 - 1;
}

# The pKa values `set` assigns to this chain into the 9 f64 at pka: the α-amino and α-carboxyl pKa, then the side
# chains in SIDE_CHAINS order. Bjellqvist's termini follow the first and last standard residues
# (_RY_PROTEIN_BJELLQVIST_*); a value that is no set is RY_PKA_SET_LEHNINGER. Mirrors `PkaSet::for_chain`.
fn _ry_protein_for_chain(set, seq, n, pka) {
    var row = _RY_PROTEIN_PKA_SET_LEHNINGER;
    match set {
        RY_PKA_SET_BJELLQVIST => { row = _RY_PROTEIN_PKA_SET_BJELLQVIST; }
        RY_PKA_SET_EMBOSS => { row = _RY_PROTEIN_PKA_SET_EMBOSS; }
        RY_PKA_SET_IPC => { row = _RY_PROTEIN_PKA_SET_IPC_PROTEIN; }
        _ => { row = _RY_PROTEIN_PKA_SET_LEHNINGER; }
    }
    var nt: f64 = _RY_PROTEIN_PKA_SET_N_TERM[row];
    var ct: f64 = _RY_PROTEIN_PKA_SET_C_TERM[row];
    if (set == RY_PKA_SET_BJELLQVIST) {
        var first = _ry_protein_terminal(seq, n, 0);
        var last = _ry_protein_terminal(seq, n, 1);
        var j = 0;
        while (j < _RY_PROTEIN_BJELLQVIST_N_TERM_COUNT) {
            if (_RY_PROTEIN_BJELLQVIST_N_TERM_CODE[j] == first) {
                nt = _RY_PROTEIN_BJELLQVIST_N_TERM_PKA[j];
                break;
            }
            j = j + 1;
        }
        j = 0;
        while (j < _RY_PROTEIN_BJELLQVIST_C_TERM_COUNT) {
            if (_RY_PROTEIN_BJELLQVIST_C_TERM_CODE[j] == last) {
                ct = _RY_PROTEIN_BJELLQVIST_C_TERM_PKA[j];
                break;
            }
            j = j + 1;
        }
    }
    store64(pka, load64(&nt));
    store64(pka + 8, load64(&ct));
    var k = 0;
    while (k < _RY_PROTEIN_SIDE_CHAIN_COUNT) {
        var x: f64 = _RY_PROTEIN_PKA_SET_SIDE[row * _RY_PROTEIN_SIDE_CHAIN_COUNT + k];
        store64(pka + 16 + 8 * k, load64(&x));
        k = k + 1;
    }
    return 0;
}

# The net charge at `ph` of the counted groups with the chain's pKa values (Henderson-Hasselbalch: the N-terminus
# basic, the C-terminus acidic, each side chain by its sign). Mirrors `IonizableCounts::charge_at`.
#must_use
fn _ry_protein_charge_at(counts, ph: f64, pka): f64 {
    var nt: f64 = load64(pka);
    var ct: f64 = load64(pka + 8);
    var x: f64 = ph - nt;
    var p: f64 = _ry_cr_pow(10.0, x);
    var charge: f64 = 1.0 / (1.0 + p);
    x = ct - ph;
    p = _ry_cr_pow(10.0, x);
    var acid: f64 = 1.0 / (1.0 + p);
    charge = charge - acid;
    var k = 0;
    while (k < _RY_PROTEIN_SIDE_CHAIN_COUNT) {
        var count = load64(counts + 8 * k);
        if (count != 0) {
            var nf: f64 = f64_from(count);
            var sign: f64 = _RY_PROTEIN_SIDE_CHAIN_SIGN[k];
            var gp: f64 = load64(pka + 16 + 8 * k);
            if (sign > 0.0) {
                x = ph - gp;
                p = _ry_cr_pow(10.0, x);
                var base: f64 = nf / (1.0 + p);
                charge = charge + base;
            } else {
                x = gp - ph;
                p = _ry_cr_pow(10.0, x);
                var acidic: f64 = nf / (1.0 + p);
                charge = charge - acidic;
            }
        }
        k = k + 1;
    }
    return charge;
}

# The net charge of the peptide at `ph` with pKa set `set` (Henderson-Hasselbalch over the termini and every ionizable
# side chain). Characters that are not standard codes are ignored; Bjellqvist's termini are the first and last
# standard residues. A NaN ph gives NaN. Mirrors `protein::net_charge_with`.
#must_use
fn ry_net_charge_with(seq, n, ph: f64, set): f64 {
    var counts[56];
    var pka[72];
    _ry_protein_counts(seq, n, 0, &counts);
    _ry_protein_for_chain(set, seq, n, &pka);
    var r: f64 = _ry_protein_charge_at(&counts, ph, &pka);
    return r;
}

# ry_net_charge_with with the free-amino-acid pKa values (RY_PKA_SET_LEHNINGER). Mirrors `protein::net_charge`.
#must_use
fn ry_net_charge(seq, n, ph: f64): f64 {
    var r: f64 = ry_net_charge_with(seq, n, ph, RY_PKA_SET_LEHNINGER);
    return r;
}

# The isoelectric point with pKa set `set`: the pH in [0, 14] where the net charge is zero, by bisection until the
# bracket is at most 0.001 wide (14 halvings), the bracket's midpoint. 1 with *out filled, or 0 for an empty sequence
# or one with any character that is not a standard code. The groups are counted once, so each step is O(1) in length.
# Mirrors `protein::isoelectric_point_with`.
#must_use
fn ry_isoelectric_point_with(seq, n, set, out): i64 {
    if (n == 0) { return 0; }
    var counts[56];
    if (_ry_protein_counts(seq, n, 1, &counts) == 0) { return 0; }
    var pka[72];
    _ry_protein_for_chain(set, seq, n, &pka);
    var lo: f64 = 0.0;
    var hi: f64 = 14.0;
    var precision: f64 = 0.001;
    var width: f64 = hi - lo;
    while (width > precision) {
        var mid: f64 = (lo + hi) / 2.0;
        var z: f64 = _ry_protein_charge_at(&counts, mid, &pka);
        if (z > 0.0) {
            lo = mid;
        } else {
            hi = mid;
        }
        width = hi - lo;
    }
    var pi: f64 = (lo + hi) / 2.0;
    store64(out, load64(&pi));
    return 1;
}

# ry_isoelectric_point_with with the free-amino-acid pKa values (RY_PKA_SET_LEHNINGER). Mirrors
# `protein::isoelectric_point`.
#must_use
fn ry_isoelectric_point(seq, n, out): i64 {
    return ry_isoelectric_point_with(seq, n, RY_PKA_SET_LEHNINGER, out);
}

# ── extinction coefficient ──

# A molar extinction coefficient at 280 nm (M⁻¹ cm⁻¹): with every Cys in a disulfide bond (oxidized) and with none
# (reduced). Rust's `ExtinctionCoefficient`.
struct RyExtinctionCoefficient {
    oxidized: f64;
    reduced: f64;
}

# The molar extinction coefficient at 280 nm by Pace's method: 5500 per Trp, 1490 per Tyr, and 125 per cystine (half
# the Cys, rounded down) when oxidized. 1 with *out filled, or 0 for an empty sequence or an unknown residue. Mirrors
# `protein::extinction_coefficient`.
#must_use
fn ry_extinction_coefficient(seq, n, out: *RyExtinctionCoefficient): i64 {
    if (n == 0) { return 0; }
    var n_trp = 0;
    var n_tyr = 0;
    var n_cys = 0;
    var i = 0;
    while (i < n) {
        var c = load8(seq + i);
        if (c >= 97 && c <= 122) { c = c - 32; }
        if (ry_lookup(c) < 0) { return 0; }
        if (c == 87) { n_trp = n_trp + 1; }
        if (c == 89) { n_tyr = n_tyr + 1; }
        if (c == 67) { n_cys = n_cys + 1; }
        i = i + 1;
    }
    var trp: f64 = f64_from(n_trp);
    var tyr: f64 = f64_from(n_tyr);
    var base: f64 = trp * _RY_PROTEIN_EXT_TRP + tyr * _RY_PROTEIN_EXT_TYR;
    var cystines: f64 = f64_from(n_cys / 2);
    var ox: f64 = base + cystines * _RY_PROTEIN_EXT_CYSTINE;
    out.oxidized = ox;
    out.reduced = base;
    return 1;
}

# ── JSON (P7: serde_json's documents) ──

# Appends AminoAcid `aa` as serde_json writes it,
# `{"code":"A","abbr":"Ala","name":"Alanine","mw":…,"hydrophobicity":…,"side_chain_pka":…}` (null for None), on
# allocator `a`: Ok(0), or Err(RY_ERR_OUT_OF_MEMORY). Serialize only in Rust (`&'static str` fields).
#must_use
fn ry_amino_acid_to_json_a(a, sb, aa: *RyAminoAcid): Result {
    var code[8];
    store8(&code, aa.code);
    var mw: f64 = aa.mw;
    var h: f64 = aa.hydrophobicity;
    var pka: f64 = aa.side_chain_pka;
    var r = _ry_jw_byte(a, sb, 123);
    r = r | _ry_jw_key(a, sb, "code", 1);
    r = r | _ry_jw_char(a, sb, &code, 1);
    r = r | _ry_jw_key(a, sb, "abbr", 0);
    r = r | _ry_jw_str(a, sb, aa.abbr, strlen(aa.abbr));
    r = r | _ry_jw_key(a, sb, "name", 0);
    r = r | _ry_jw_str(a, sb, aa.name, strlen(aa.name));
    r = r | _ry_jw_key(a, sb, "mw", 0);
    r = r | _ry_jw_f64(a, sb, mw);
    r = r | _ry_jw_key(a, sb, "hydrophobicity", 0);
    r = r | _ry_jw_f64(a, sb, h);
    r = r | _ry_jw_key(a, sb, "side_chain_pka", 0);
    r = r | _ry_jw_opt_f64(a, sb, aa.has_side_chain_pka, pka);
    r = r | _ry_jw_byte(a, sb, 125);
    if (r != 0) { return Err(RY_ERR_OUT_OF_MEMORY); }
    return Ok(0);
}

# ry_amino_acid_to_json_a on the default allocator (a builder from str_builder_new).
#must_use
fn ry_amino_acid_to_json(sb, aa: *RyAminoAcid): Result {
    return ry_amino_acid_to_json_a(default_alloc(), sb, aa);
}

# The field names of ExtinctionCoefficient, in Rust's declaration order.
var _RY_EXTINCTION_COEFFICIENT_FIELDS = "oxidized\0reduced\0";

# Appends ExtinctionCoefficient `ec` as serde_json writes it, `{"oxidized":…,"reduced":…}`: Ok(0), or
# Err(RY_ERR_OUT_OF_MEMORY). Serialize only in Rust.
#must_use
fn ry_extinction_coefficient_to_json_a(a, sb, ec: *RyExtinctionCoefficient): Result {
    if (_ry_jw_f64_fields(a, sb, ec, 2, _RY_EXTINCTION_COEFFICIENT_FIELDS) != 0) { return Err(RY_ERR_OUT_OF_MEMORY); }
    return Ok(0);
}

# ry_extinction_coefficient_to_json_a on the default allocator.
#must_use
fn ry_extinction_coefficient_to_json(sb, ec: *RyExtinctionCoefficient): Result {
    return ry_extinction_coefficient_to_json_a(default_alloc(), sb, ec);
}

# Appends PkaSet `set` as serde_json writes a unit variant, its name in quotes (`"Lehninger"`): Ok(0),
# Err(RY_ERR_INVALID_PARAMETER) for a value that is no set, or Err(RY_ERR_OUT_OF_MEMORY). Serialize only in Rust.
#must_use
fn ry_pka_set_to_json_a(a, sb, set): Result {
    var name = ry_pka_set_name(set);
    if (name == 0) { return Err(RY_ERR_INVALID_PARAMETER); }
    if (_ry_jw_unit(a, sb, name) != 0) { return Err(RY_ERR_OUT_OF_MEMORY); }
    return Ok(0);
}

# ry_pka_set_to_json_a on the default allocator.
#must_use
fn ry_pka_set_to_json(sb, set): Result {
    return ry_pka_set_to_json_a(default_alloc(), sb, set);
}

# ── Chou-Fasman secondary structure ──

# The secondary structure of one residue (Rust's `SecondaryStructure`): α-helix, β-sheet (strand), β-turn, coil. The
# values are append-only.
enum RySecondaryStructure {
    RY_SECONDARY_STRUCTURE_HELIX = 0;
    RY_SECONDARY_STRUCTURE_SHEET = 1;
    RY_SECONDARY_STRUCTURE_TURN = 2;
    RY_SECONDARY_STRUCTURE_COIL = 3;
}

# The variant name of a secondary structure (`"Helix"`, …, as serde writes it), or 0 for a value that is none.
#must_use
#pure
fn ry_secondary_structure_name(x): cstring {
    match x {
        RY_SECONDARY_STRUCTURE_HELIX => { return "Helix"; }
        RY_SECONDARY_STRUCTURE_SHEET => { return "Sheet"; }
        RY_SECONDARY_STRUCTURE_TURN => { return "Turn"; }
        RY_SECONDARY_STRUCTURE_COIL => { return "Coil"; }
        _ => { return 0; }
    }
    return 0;
}

# Pα (which 0), Pβ (1) or Pt (2), ×100, of the residue in table slot `slot`. CHOU_FASMAN's rows are in AMINO_ACIDS
# order (the generator checks it), so a residue's ry_lookup slot indexes both tables.
#must_use
#pure
fn _ry_cf_p(slot, which): i64 {
    if (which == 0) { return _RY_PROTEIN_CHOU_FASMAN_P_ALPHA[slot]; }
    if (which == 1) { return _RY_PROTEIN_CHOU_FASMAN_P_BETA[slot]; }
    return _RY_PROTEIN_CHOU_FASMAN_P_TURN[slot];
}

# Σ P over the residues from .. to − 1 (their slots are bytes at `slots`). Mirrors `cf_sums`, one field at a time; the
# column is chosen once, not per residue (the sums are the prediction's inner loop).
#must_use
#pure
fn _ry_cf_sum(slots, from, to, which): i64 {
    var s = 0;
    var k = from;
    if (which == 0) {
        while (k < to) {
            s = s + _RY_PROTEIN_CHOU_FASMAN_P_ALPHA[load8(slots + k)];
            k = k + 1;
        }
    } elif (which == 1) {
        while (k < to) {
            s = s + _RY_PROTEIN_CHOU_FASMAN_P_BETA[load8(slots + k)];
            k = k + 1;
        }
    } else {
        while (k < to) {
            s = s + _RY_PROTEIN_CHOU_FASMAN_P_TURN[load8(slots + k)];
            k = k + 1;
        }
    }
    return s;
}

# 1 when residue k is Pro.
#must_use
#pure
fn _ry_cf_pro(slots, k): i64 {
    return _RY_PROTEIN_CHOU_FASMAN_CODE[load8(slots + k)] == 80;
}

# Rule 1 nucleus at i: >= 4 helix formers among the six residues, and no Pro past the first turn. Mirrors
# `is_helix_nucleus`.
#must_use
fn _ry_cf_helix_nucleus(slots, i): i64 {
    var formers = 0;
    var off = 0;
    while (off < _RY_PROTEIN_CF_HELIX_NUCLEUS) {
        if (_ry_cf_pro(slots, i + off) == 1 && off >= _RY_PROTEIN_CF_PRO_HELIX_FIRST_TURN) { return 0; }
        if (_ry_cf_p(load8(slots + i + off), 0) >= _RY_PROTEIN_CF_HELIX_FORMER) { formers = formers + 1; }
        off = off + 1;
    }
    if (formers >= _RY_PROTEIN_CF_HELIX_NUCLEUS_FORMERS) { return 1; }
    return 0;
}

# Rule 2 nucleus at i: >= 3 β formers among the five residues, and no Pro. Mirrors `is_sheet_nucleus`.
#must_use
fn _ry_cf_sheet_nucleus(slots, i): i64 {
    var formers = 0;
    var off = 0;
    while (off < _RY_PROTEIN_CF_SHEET_NUCLEUS) {
        if (_ry_cf_pro(slots, i + off) == 1) { return 0; }
        if (_ry_cf_p(load8(slots + i + off), 1) >= _RY_PROTEIN_CF_SHEET_FORMER) { formers = formers + 1; }
        off = off + 1;
    }
    if (formers >= _RY_PROTEIN_CF_SHEET_NUCLEUS_FORMERS) { return 1; }
    return 0;
}

# The helix nucleus at `nucleus` grown both ways (rule 1), the half-open segment (start, end): C-terminally unless the
# residue is Pro or the tetrapeptide ending at it is a breaker; N-terminally unless the tetrapeptide starting at it is
# a breaker or the residue would push a Pro out of the first turn. Mirrors `extend_helix`.
#must_use
fn _ry_cf_extend_helix(slots, n, nucleus): (i64, i64) {
    var start = nucleus;
    var end = nucleus + _RY_PROTEIN_CF_HELIX_NUCLEUS;
    var breaker = 4 * _RY_PROTEIN_CF_BREAKER;
    while (end < n && _ry_cf_pro(slots, end) == 0 && _ry_cf_sum(slots, end - 3, end + 1, 0) >= breaker) {
        end = end + 1;
    }
    # The highest-index Pro in the segment, or -1.
    var last_pro = 0 - 1;
    var k = end - 1;
    while (k >= start) {
        if (_ry_cf_pro(slots, k) == 1) {
            last_pro = k;
            break;
        }
        k = k - 1;
    }
    while (start > 0) {
        var cand = start - 1;
        if (_ry_cf_sum(slots, cand, cand + 4, 0) < breaker) { break; }
        var pro = last_pro;
        if (_ry_cf_pro(slots, cand) == 1 && last_pro < 0) { pro = cand; }
        if (pro >= 0 && pro - cand >= _RY_PROTEIN_CF_PRO_HELIX_FIRST_TURN) { break; }
        last_pro = pro;
        start = cand;
    }
    return (start, end);
}

# The sheet nucleus at `nucleus` grown both ways (rule 2) until a tetrapeptide breaker or a Pro: (start, end).
# Mirrors `extend_sheet`.
#must_use
fn _ry_cf_extend_sheet(slots, n, nucleus): (i64, i64) {
    var start = nucleus;
    var end = nucleus + _RY_PROTEIN_CF_SHEET_NUCLEUS;
    var breaker = 4 * _RY_PROTEIN_CF_BREAKER;
    while (end < n && _ry_cf_pro(slots, end) == 0 && _ry_cf_sum(slots, end - 3, end + 1, 1) >= breaker) {
        end = end + 1;
    }
    while (start > 0 && _ry_cf_pro(slots, start - 1) == 0 && _ry_cf_sum(slots, start - 1, start + 3, 1) >= breaker) {
        start = start - 1;
    }
    return (start, end);
}

# Sets `flag` on residues from .. to − 1 of the byte flags. Mirrors `cf_mark`.
fn _ry_cf_mark(flags, from, to, flag) {
    var k = from;
    while (k < to) {
        store8(flags + k, load8(flags + k) | flag);
        k = k + 1;
    }
    return 0;
}

# Rule 4: each maximal run claimed by both a helix and a sheet goes to the higher Σ over the run (a tie to the helix).
# Mirrors `cf_resolve_overlaps`.
fn _ry_cf_resolve_overlaps(slots, flags, n) {
    var both = _RY_PROTEIN_CF_HELIX | _RY_PROTEIN_CF_SHEET;
    var k = 0;
    while (k < n) {
        if ((load8(flags + k) & both) != both) {
            k = k + 1;
            continue;
        }
        var run = k;
        while (k < n && (load8(flags + k) & both) == both) { k = k + 1; }
        var keep = _RY_PROTEIN_CF_HELIX;
        if (_ry_cf_sum(slots, run, k, 1) > _ry_cf_sum(slots, run, k, 0)) { keep = _RY_PROTEIN_CF_SHEET; }
        var j = run;
        while (j < k) {
            store8(flags + j, keep);
            j = j + 1;
        }
    }
    return 0;
}

# 1 when candidate x (two words: p(t), position) goes before candidate y: the higher p(t), then the lower position
# (Rust's `y.0.cmp(&x.0).then(x.1.cmp(&y.1))`).
#must_use
#pure
fn _ry_cf_before(x, y): i64 {
    var px = load64(x);
    var py = load64(y);
    if (px != py) { return px > py; }
    return load64(x + 8) < load64(y + 8);
}

# Swaps candidates i and j of the array at c.
fn _ry_cf_swap(c, i, j) {
    var a = c + 16 * i;
    var b = c + 16 * j;
    var p = load64(a);
    var q = load64(a + 8);
    store64(a, load64(b));
    store64(a + 8, load64(b + 8));
    store64(b, p);
    store64(b + 8, q);
    return 0;
}

# Sift candidate `root` down the heap of the first `len` candidates (the root of the heap goes last).
fn _ry_cf_sift(c, root, len) {
    var r = root;
    while (2 * r + 1 < len) {
        var child = 2 * r + 1;
        if (child + 1 < len && _ry_cf_before(c + 16 * child, c + 16 * (child + 1)) == 1) { child = child + 1; }
        if (_ry_cf_before(c + 16 * r, c + 16 * child) == 0) { return 0; }
        _ry_cf_swap(c, r, child);
        r = child;
    }
    return 0;
}

# Sorts the `len` candidates at c into Rust's order (an in-place heapsort; the keys are distinct, so any correct sort
# gives Rust's order).
fn _ry_cf_sort(c, len) {
    var start = len / 2 - 1;
    while (start >= 0) {
        _ry_cf_sift(c, start, len);
        start = start - 1;
    }
    var end = len - 1;
    while (end > 0) {
        _ry_cf_swap(c, 0, end);
        _ry_cf_sift(c, 0, end);
        end = end - 1;
    }
    return 0;
}

# Rule 3 turns: a tetrapeptide with p(t) = f(i)·f(i+1)·f(i+2)·f(i+3) > 0.75×10⁻⁴, ⟨Pt⟩ > 1.00 and ⟨Pα⟩ < ⟨Pt⟩ > ⟨Pβ⟩
# is a candidate; candidates are taken by higher p(t) (then lower position), each marked unless it overlaps a turn
# already marked. `cand` holds n − 3 candidates (two words each). Mirrors `cf_assign_turns`.
fn _ry_cf_assign_turns(slots, flags, n, cand) {
    var count = 0;
    var i = 0;
    while (i + 3 < n) {
        var p_t = 1;
        var j = 0;
        while (j < 4) {
            p_t = p_t * _RY_PROTEIN_CHOU_FASMAN_BEND[load8(slots + i + j) * 4 + j];
            j = j + 1;
        }
        var turn = _ry_cf_sum(slots, i, i + 4, 2);
        if (p_t > _RY_PROTEIN_CF_BEND_PRODUCT_MIN && turn > _RY_PROTEIN_CF_TURN_ACCEPT * 4
          && turn > _ry_cf_sum(slots, i, i + 4, 0) && turn > _ry_cf_sum(slots, i, i + 4, 1)) {
            store64(cand + 16 * count, p_t);
            store64(cand + 16 * count + 8, i);
            count = count + 1;
        }
        i = i + 1;
    }
    _ry_cf_sort(cand, count);
    var k = 0;
    while (k < count) {
        var at = load64(cand + 16 * k + 8);
        var free = 1;
        var m = 0;
        while (m < 4) {
            if ((load8(flags + at + m) & _RY_PROTEIN_CF_TURN) != 0) { free = 0; }
            m = m + 1;
        }
        if (free == 1) { _ry_cf_mark(flags, at, at + 4, _RY_PROTEIN_CF_TURN); }
        k = k + 1;
    }
    return 0;
}

# The Chou-Fasman secondary structure of the sequence, one RySecondaryStructure value per residue as a byte into the
# `cap` bytes at out: Ok(n), Ok(0) for Rust's None (an empty sequence or an unknown residue; a Some is never empty),
# Err(RY_ERR_BUFFER_TOO_SMALL) when cap < n (nothing is written), or Err(RY_ERR_OUT_OF_MEMORY) when allocator `a`
# refuses the per-call scratch (n bytes of table slots and 16 bytes per turn candidate; the caller resets `a`). The
# rules, as protein.rs reads Chou & Fasman 1978 and Prevelige & Fasman 1989: helices (rule 1), then sheets (rule 2),
# each nucleus grown into a region accepted or rejected as a whole and the search resumed after it; overlaps resolved
# (rule 4); then turns, which override (rule 3). All on the integer table values, so the result is exact. Mirrors
# `protein::chou_fasman`.
#must_use
fn ry_chou_fasman_a(a, seq, n, out, cap): Result {
    if (n == 0) { return Ok(0); }
    var i = 0;
    while (i < n) {
        if (ry_lookup(load8(seq + i)) < 0) { return Ok(0); }
        i = i + 1;
    }
    if (cap < n) { return Err(_ry_fail_text(RY_ERR_BUFFER_TOO_SMALL, "chou_fasman", 11)); }
    var slots = alloc_via(a, n + 16 * n);
    if (slots == 0) { return Err(RY_ERR_OUT_OF_MEMORY); }
    var cand = slots + n;
    i = 0;
    while (i < n) {
        store8(slots + i, ry_lookup(load8(seq + i)));
        store8(out + i, 0);
        i = i + 1;
    }
    # Rule 1: helices.
    i = 0;
    while (i + _RY_PROTEIN_CF_HELIX_NUCLEUS <= n) {
        if (_ry_cf_helix_nucleus(slots, i) == 0) {
            i = i + 1;
            continue;
        }
        var hs, he = _ry_cf_extend_helix(slots, n, i);
        var alpha = _ry_cf_sum(slots, hs, he, 0);
        var beta = _ry_cf_sum(slots, hs, he, 1);
        var long_enough = he - hs >= _RY_PROTEIN_CF_HELIX_MIN_LEN;
        if (long_enough && alpha > _RY_PROTEIN_CF_HELIX_ACCEPT * (he - hs) && alpha > beta) {
            _ry_cf_mark(out, hs, he, _RY_PROTEIN_CF_HELIX);
        }
        i = he;
    }
    # Rule 2: sheets.
    i = 0;
    while (i + _RY_PROTEIN_CF_SHEET_NUCLEUS <= n) {
        if (_ry_cf_sheet_nucleus(slots, i) == 0) {
            i = i + 1;
            continue;
        }
        var ss, se = _ry_cf_extend_sheet(slots, n, i);
        var sa = _ry_cf_sum(slots, ss, se, 0);
        var sb = _ry_cf_sum(slots, ss, se, 1);
        if (sb > _RY_PROTEIN_CF_SHEET_ACCEPT * (se - ss) && sb > sa) { _ry_cf_mark(out, ss, se, _RY_PROTEIN_CF_SHEET); }
        i = se;
    }
    # Rule 4, then rule 3 (turns override).
    _ry_cf_resolve_overlaps(slots, out, n);
    _ry_cf_assign_turns(slots, out, n, cand);
    i = 0;
    while (i < n) {
        var fl = load8(out + i);
        var x = RY_SECONDARY_STRUCTURE_COIL;
        if ((fl & _RY_PROTEIN_CF_TURN) != 0) {
            x = RY_SECONDARY_STRUCTURE_TURN;
        } elif ((fl & _RY_PROTEIN_CF_HELIX) != 0) {
            x = RY_SECONDARY_STRUCTURE_HELIX;
        } elif ((fl & _RY_PROTEIN_CF_SHEET) != 0) {
            x = RY_SECONDARY_STRUCTURE_SHEET;
        }
        store8(out + i, x);
        i = i + 1;
    }
    return Ok(n);
}

# ry_chou_fasman_a on the default allocator (its scratch is never freed: for a one-off call).
#must_use
fn ry_chou_fasman(seq, n, out, cap): Result {
    return ry_chou_fasman_a(default_alloc(), seq, n, out, cap);
}

# Appends SecondaryStructure `x` as serde_json writes a unit variant (`"Helix"`): Ok(0),
# Err(RY_ERR_INVALID_PARAMETER) for a value that is none, or Err(RY_ERR_OUT_OF_MEMORY). Serialize only in Rust.
#must_use
fn ry_secondary_structure_to_json_a(a, sb, x): Result {
    var name = ry_secondary_structure_name(x);
    if (name == 0) { return Err(RY_ERR_INVALID_PARAMETER); }
    if (_ry_jw_unit(a, sb, name) != 0) { return Err(RY_ERR_OUT_OF_MEMORY); }
    return Ok(0);
}

# ry_secondary_structure_to_json_a on the default allocator.
#must_use
fn ry_secondary_structure_to_json(sb, x): Result {
    return ry_secondary_structure_to_json_a(default_alloc(), sb, x);
}

# --- alignment.cyr ---

# alignment.cyr — sequence alignment scoring: the BLOSUM62 and PAM250 substitution matrices, ungapped pairwise
# scoring, and the Needleman-Wunsch global alignment score (Rust 1.2.0's `alignment.rs`, transcribed).
#
# A sequence is `(seq, n)`: n bytes of UTF-8 (Rust's `&str`), read as bytes. For valid UTF-8 that gives Rust's
# `chars()` answers (port plan §2 item 6): every function rejects a non-residue, and no byte of a non-ASCII character
# is an ASCII letter. Every result is integer arithmetic, exact (class A in tests/golden/alignment.tsv), with Rust's
# saturating `i32` sums.
#
# The Cyrius forms (ADR 0002 rows 2, 10):
# - Matrix is `enum RyMatrix`, its values Rust's declaration order (append-only); the matrices are the generated i8
#   tables (src/alignment_data.cyr);
# - `substitution_score`'s `Option<i8>` and `needleman_wunsch`'s `Option<i32>` are 1 with *out filled, or 0;
#   `score_alignment`'s `Option<AlignmentScore>` fills a RyAlignmentScore;
# - Needleman-Wunsch keeps two rows of the shorter sequence's length, as Rust does; they and the column indices are
#   scratch whose size the input sets, so ry_needleman_wunsch_a takes an allocator;
# - the gap penalty and the scores are Rust's `i32`: a gap outside its range is clamped to it, every sum saturates at
#   its bounds;
# - Matrix and AlignmentScore write `ry_<type>_to_json` (and `_a`, on an allocator).

# The substitution matrices (Rust's `Matrix`): BLOSUM62, the database-search default, and PAM250, for distant
# relatives. The values are append-only.
enum RyMatrix {
    RY_MATRIX_BLOSUM62 = 0;
    RY_MATRIX_PAM250 = 1;
}

# The number of matrices.
const RY_MATRIX_COUNT = 2;

# Rust's i32 bounds, which the alignment scores saturate at.
const _RY_ALIGNMENT_I32_MIN = -2147483648;
const _RY_ALIGNMENT_I32_MAX = 2147483647;

# The variant name of a matrix (`"Blosum62"`, `"Pam250"`, as serde writes it), or 0 for a value that is none.
#must_use
#pure
fn ry_matrix_name(matrix): cstring {
    match matrix {
        RY_MATRIX_BLOSUM62 => { return "Blosum62"; }
        RY_MATRIX_PAM250 => { return "Pam250"; }
        _ => { return 0; }
    }
    return 0;
}

# The matrix index (A C D E F G H I K L M N P Q R S T V W Y) of the character `c`, upper or lowercase, or -1 for
# anything that is not one of the 20 standard codes. Mirrors alignment.rs's private `aa_index`.
#must_use
#pure
fn _ry_alignment_index(c): i64 {
    var u = c;
    if (u >= 97 && u <= 122) { u = u - 32; }
    if (u < 65 || u > 90) { return 0 - 1; }
    var i = _RY_ALIGNMENT_AA_INDEX[u - 65];
    if (i >= _RY_ALIGNMENT_RESIDUE_COUNT) { return 0 - 1; }
    return i;
}

# The 400 signed bytes of a matrix, row-major (a value that is no matrix: BLOSUM62). Mirrors `matrix_table`.
#must_use
#pure
fn _ry_alignment_table(matrix): i64 {
    if (matrix == RY_MATRIX_PAM250) { return &_RY_ALIGNMENT_PAM250; }
    return &_RY_ALIGNMENT_BLOSUM62;
}

# The signed score at row i, column j of the 400-byte table at `tab` (the byte sign-extended without a branch).
#must_use
#pure
fn _ry_alignment_cell(tab, i, j): i64 {
    return (load8(tab + i * _RY_ALIGNMENT_RESIDUE_COUNT + j) ^ 128) - 128;
}

# Rust's `i32::saturating_add`: a + b clamped to the i32 range (a and b in it, so the i64 sum is exact).
#must_use
#pure
fn _ry_alignment_sat(x): i64 {
    if (x < _RY_ALIGNMENT_I32_MIN) { return _RY_ALIGNMENT_I32_MIN; }
    if (x > _RY_ALIGNMENT_I32_MAX) { return _RY_ALIGNMENT_I32_MAX; }
    return x;
}

# The substitution score of characters a and b (Unicode scalar values, upper or lowercase) in `matrix`: 1 with *out
# set, or 0 if either is not a standard amino acid. Mirrors `alignment::substitution_score`.
#must_use
fn ry_substitution_score(a, b, matrix, out): i64 {
    var i = _ry_alignment_index(a);
    if (i < 0) { return 0; }
    var j = _ry_alignment_index(b);
    if (j < 0) { return 0; }
    # _ry_alignment_table and _ry_alignment_cell written in place: two calls fewer (23 → 18 ns, the bench).
    var tab = &_RY_ALIGNMENT_BLOSUM62;
    if (matrix == RY_MATRIX_PAM250) { tab = &_RY_ALIGNMENT_PAM250; }
    store64(out, (load8(tab + i * _RY_ALIGNMENT_RESIDUE_COUNT + j) ^ 128) - 128);
    return 1;
}

# The result of an ungapped pairwise scoring (Rust's `AlignmentScore`): the total score, the identical positions, the
# positions compared, and the identity fraction.
struct RyAlignmentScore {
    score;
    identities;
    length;
    identity: f64;
}

# Scores two equal-length sequences position by position (no gaps) with `matrix`: 1 with *out filled, or 0 for
# different byte lengths, an empty input, or an unknown residue. Identical positions compare ASCII case-insensitively.
# Mirrors `alignment::score_alignment`.
#must_use
fn ry_score_alignment(seq_a, na, seq_b, nb, matrix, out: *RyAlignmentScore): i64 {
    if (na == 0 || na != nb) { return 0; }
    var tab = _ry_alignment_table(matrix);
    var score = 0;
    var identities = 0;
    var k = 0;
    while (k < na) {
        var x = load8(seq_a + k);
        var y = load8(seq_b + k);
        var i = _ry_alignment_index(x);
        var j = _ry_alignment_index(y);
        if (i < 0 || j < 0) { return 0; }
        score = score + _ry_alignment_cell(tab, i, j);
        if (score < _RY_ALIGNMENT_I32_MIN) { score = _RY_ALIGNMENT_I32_MIN; }
        if (score > _RY_ALIGNMENT_I32_MAX) { score = _RY_ALIGNMENT_I32_MAX; }
        if (x >= 97) { x = x - 32; }
        if (y >= 97) { y = y - 32; }
        if (x == y) { identities = identities + 1; }
        k = k + 1;
    }
    out.score = score;
    out.identities = identities;
    out.length = na;
    var idf: f64 = f64_from(identities);
    var lf: f64 = f64_from(na);
    var r: f64 = idf / lf;
    out.identity = r;
    return 1;
}

# The Needleman-Wunsch global alignment score of two sequences with `matrix` and the linear `gap_penalty` (negative,
# e.g. -4 for BLOSUM62; Rust's i32, a value outside it clamped): Ok(1) with *out the score, Ok(0) for Rust's None
# (either sequence empty or holding an unknown residue), or Err(RY_ERR_OUT_OF_MEMORY) when allocator `a` refuses the
# scratch (two rows of the shorter sequence's length plus its indices; the caller resets `a`). O(m·n) time and
# O(min(m, n)) memory; every sum saturates at the i32 bounds. The sequences are swapped so the shorter runs along the
# row, as Rust's (the matrices are symmetric, and the swap is kept exactly, as saturation is not). A cell clamps once:
# Rust's max of three saturated sums is the clamp of the max of the exact i64 sums (a clamp is monotone), and the two
# gap sums share their gap, so each cell is Rust's value exactly. Mirrors `alignment::needleman_wunsch`.
#must_use
fn ry_needleman_wunsch_a(a, seq_a, na, seq_b, nb, matrix, gap_penalty, out): Result {
    var k = 0;
    while (k < na) {
        if (_ry_alignment_index(load8(seq_a + k)) < 0) { return Ok(0); }
        k = k + 1;
    }
    k = 0;
    while (k < nb) {
        if (_ry_alignment_index(load8(seq_b + k)) < 0) { return Ok(0); }
        k = k + 1;
    }
    if (na == 0 || nb == 0) { return Ok(0); }
    var gap = _ry_alignment_sat(gap_penalty);
    var rows = seq_a;
    var nr = na;
    var cols = seq_b;
    var nc = nb;
    if (na < nb) {
        rows = seq_b;
        nr = nb;
        cols = seq_a;
        nc = na;
    }
    var col_idx = alloc_via(a, nc + 16 * (nc + 1) + 8);
    if (col_idx == 0) { return Err(RY_ERR_OUT_OF_MEMORY); }
    var prev = col_idx + nc;
    while ((prev & 7) != 0) { prev = prev + 1; }
    var curr = prev + 8 * (nc + 1);
    var j = 0;
    while (j < nc) {
        store8(col_idx + j, _ry_alignment_index(load8(cols + j)));
        j = j + 1;
    }
    var edge = 0;
    store64(prev, edge);
    j = 0;
    while (j < nc) {
        edge = _ry_alignment_sat(edge + gap);
        store64(prev + 8 * (j + 1), edge);
        j = j + 1;
    }
    var tab = _ry_alignment_table(matrix);
    var lo = _RY_ALIGNMENT_I32_MIN;
    var hi = _RY_ALIGNMENT_I32_MAX;
    var r = 0;
    var col_end = col_idx + nc;
    while (r < nr) {
        var sub_row = tab + _ry_alignment_index(load8(rows + r)) * _RY_ALIGNMENT_RESIDUE_COUNT;
        var pj = load64(prev);
        var cj = pj + gap;
        if (cj < lo) { cj = lo; } elif (cj > hi) { cj = hi; }
        store64(curr, cj);
        var pp = prev;
        var cp = curr;
        var ci = col_idx;
        while (ci < col_end) {
            pp = pp + 8;
            var pj1 = load64(pp);
            var best = pj1;
            if (cj > best) { best = cj; }
            best = best + gap;
            var diag = pj + ((load8(sub_row + load8(ci)) ^ 128) - 128);
            if (diag > best) { best = diag; }
            if (best < lo) { best = lo; } elif (best > hi) { best = hi; }
            cp = cp + 8;
            store64(cp, best);
            cj = best;
            pj = pj1;
            ci = ci + 1;
        }
        var t = prev;
        prev = curr;
        curr = t;
        r = r + 1;
    }
    store64(out, load64(prev + 8 * nc));
    return Ok(1);
}

# ry_needleman_wunsch_a on the default allocator (its scratch is never freed: for a one-off call).
#must_use
fn ry_needleman_wunsch(seq_a, na, seq_b, nb, matrix, gap_penalty, out): Result {
    return ry_needleman_wunsch_a(default_alloc(), seq_a, na, seq_b, nb, matrix, gap_penalty, out);
}

# ── JSON (P7: serde_json's documents) ──

# Appends Matrix `matrix` as serde_json writes a unit variant (`"Blosum62"`): Ok(0), Err(RY_ERR_INVALID_PARAMETER)
# for a value that is no matrix, or Err(RY_ERR_OUT_OF_MEMORY). Serialize only in Rust.
#must_use
fn ry_matrix_to_json_a(a, sb, matrix): Result {
    var name = ry_matrix_name(matrix);
    if (name == 0) { return Err(RY_ERR_INVALID_PARAMETER); }
    if (_ry_jw_unit(a, sb, name) != 0) { return Err(RY_ERR_OUT_OF_MEMORY); }
    return Ok(0);
}

# ry_matrix_to_json_a on the default allocator (a builder from str_builder_new).
#must_use
fn ry_matrix_to_json(sb, matrix): Result {
    return ry_matrix_to_json_a(default_alloc(), sb, matrix);
}

# Appends AlignmentScore `s` as serde_json writes it, `{"score":…,"identities":…,"length":…,"identity":…}`: Ok(0),
# or Err(RY_ERR_OUT_OF_MEMORY). Serialize only in Rust.
#must_use
fn ry_alignment_score_to_json_a(a, sb, s: *RyAlignmentScore): Result {
    var identity: f64 = s.identity;
    var r = _ry_jw_byte(a, sb, 123);
    r = r | _ry_jw_key(a, sb, "score", 1);
    r = r | _ry_jw_i64(a, sb, s.score);
    r = r | _ry_jw_key(a, sb, "identities", 0);
    r = r | _ry_jw_u64(a, sb, s.identities);
    r = r | _ry_jw_key(a, sb, "length", 0);
    r = r | _ry_jw_u64(a, sb, s.length);
    r = r | _ry_jw_key(a, sb, "identity", 0);
    r = r | _ry_jw_f64(a, sb, identity);
    r = r | _ry_jw_byte(a, sb, 125);
    if (r != 0) { return Err(RY_ERR_OUT_OF_MEMORY); }
    return Ok(0);
}

# ry_alignment_score_to_json_a on the default allocator.
#must_use
fn ry_alignment_score_to_json(sb, s: *RyAlignmentScore): Result {
    return ry_alignment_score_to_json_a(default_alloc(), sb, s);
}

# --- ptm.cyr ---

# ptm.cyr — post-translational modification site prediction: the PROSITE N-glycosylation (PS00001), PKA (PS00004),
# CK2 (PS00006) and N-myristoylation (PS00008) motifs, the generic Ser/Thr/Tyr phospho-acceptors and the Cys disulfide
# candidates (Rust 1.2.0's `ptm.rs`, transcribed). Short consensus patterns with high false-positive rates: a hit is a
# candidate, not a prediction of an actual modification.
#
# A sequence is `(seq, n)`: n bytes of UTF-8 at seq (Rust's `&str`). Rust matches `chars()` and reports character
# indices, and its wildcard (`x`) and exclusion (`{P}`) slots take any character, a non-ASCII one included; so the
# scan here steps by character (a lead byte and its continuation bytes), counts positions in characters, and lets a
# non-ASCII character fill a slot that wants no particular residue. Invalid UTF-8, which a Rust `&str` cannot hold,
# is read the same way: an ASCII byte is one character, any other byte begins one that takes the continuation bytes
# after it (so a stray continuation byte begins a non-ASCII character). Every result is exact (class A in
# tests/golden/ptm.tsv).
#
# The Cyrius forms (ADR 0002 rows 2–4):
# - PtmType is `enum RyPtmType`, its values Rust's declaration order (append-only);
# - `scan_ptm_sites`'s `Option<Vec<PtmSite>>` fills a caller buffer of RyPtmSite records and returns Ok(count), Ok(-1)
#   for None (an empty sequence; a Some may be empty), or Err(RY_ERR_BUFFER_TOO_SMALL), with nothing written;
# - PtmSite's `motif: String` is a byte range into the caller's sequence, Rust's motif being those characters with
#   ASCII letters uppercased (`ry_ptm_site_motif` writes it); its `residue: char` is the code point;
# - PtmType and PtmSite write `ry_<type>_to_json` (and `_a`, on an allocator).

# The kinds of modification site (Rust's `PtmType`). The values are append-only.
enum RyPtmType {
    RY_PTM_TYPE_N_GLYCOSYLATION = 0;
    RY_PTM_TYPE_PHOSPHO_SER = 1;
    RY_PTM_TYPE_PHOSPHO_THR = 2;
    RY_PTM_TYPE_PHOSPHO_TYR = 3;
    RY_PTM_TYPE_DISULFIDE_BOND = 4;
    RY_PTM_TYPE_PKA_SITE = 5;
    RY_PTM_TYPE_CK2_SITE = 6;
    RY_PTM_TYPE_MYRISTOYLATION = 7;
}

# The number of PtmType values.
const RY_PTM_TYPE_COUNT = 8;

# The most sites one character carries (an S or T: CK2, the phospho-acceptor and a PKA acceptor), so 3 · n records
# always hold the sites of an n-byte sequence.
const RY_PTM_MAX_SITES_PER_RESIDUE = 3;

# The variant name of a PtmType (`"NGlycosylation"`, as serde writes it), or 0 for a value that is none.
#must_use
#pure
fn ry_ptm_type_name(t): cstring {
    match t {
        RY_PTM_TYPE_N_GLYCOSYLATION => { return "NGlycosylation"; }
        RY_PTM_TYPE_PHOSPHO_SER => { return "PhosphoSer"; }
        RY_PTM_TYPE_PHOSPHO_THR => { return "PhosphoThr"; }
        RY_PTM_TYPE_PHOSPHO_TYR => { return "PhosphoTyr"; }
        RY_PTM_TYPE_DISULFIDE_BOND => { return "DisulfideBond"; }
        RY_PTM_TYPE_PKA_SITE => { return "PkaSite"; }
        RY_PTM_TYPE_CK2_SITE => { return "Ck2Site"; }
        RY_PTM_TYPE_MYRISTOYLATION => { return "Myristoylation"; }
        _ => { return 0; }
    }
    return 0;
}

# A predicted modification site (Rust's `PtmSite`): the character index, the residue (an uppercase ASCII code point),
# the RyPtmType, and the motif as the byte range [motif_start, motif_start + motif_len) of the scanned sequence.
struct RyPtmSite {
    position;
    residue;
    ptm_type;
    motif_start;
    motif_len;
}

# The byte length of the character starting at byte k of the n bytes at seq (k < n): 1 for an ASCII byte, else the
# byte and the continuation bytes after it.
#must_use
fn _ry_ptm_char_len(seq, n, k): i64 {
    if (load8(seq + k) < 128) { return 1; }
    var e = k + 1;
    while (e < n && (load8(seq + e) & 192) == 128) { e = e + 1; }
    return e - k;
}

# The character starting at byte k, as the scan compares it: an ASCII byte uppercased (Rust's `to_ascii_uppercase`),
# 256 for a non-ASCII character (it equals no residue), -1 past the end (k >= n).
#must_use
fn _ry_ptm_code(seq, n, k): i64 {
    if (k >= n) { return 0 - 1; }
    var c = load8(seq + k);
    if (c >= 128) { return 256; }
    if (c >= 97 && c <= 122) { c = c - 32; }
    return c;
}

# Writes site k (when k < cap) and returns k + 1.
#must_use
fn _ry_ptm_put(out: *RyPtmSite, cap, k, position, residue, ptm_type, start, end): i64 {
    if (k < cap) {
        var s: *RyPtmSite = out + k;
        s.position = position;
        s.residue = residue;
        s.ptm_type = ptm_type;
        s.motif_start = start;
        s.motif_len = end - start;
    }
    return k + 1;
}

# 1 when the code is S or T.
#must_use
#pure
#inline
fn _ry_ptm_st(c): i64 { return c == 83 || c == 84; }

# The position of the N-myristoylation Gly (PS00008 `G-{EDRKHPFYW}-x(2)-[STAGCN]-{P}` on the six characters from
# index 0, or from index 1 after an initiator Met) and its window's byte range, or (-1, 0, 0) for none.
#must_use
fn _ry_ptm_myristoyl(seq, n): (i64, i64, i64) {
    var gly = 0;
    var b = 0;
    var c0 = _ry_ptm_code(seq, n, 0);
    if (c0 == 77) {
        gly = 1;
        b = _ry_ptm_char_len(seq, n, 0);
        c0 = _ry_ptm_code(seq, n, b);
    }
    # No Gly where the pattern starts: no site (the window's first test, made before the window is read).
    if (c0 != 71) { return (0 - 1, 0, 0); }
    var w[56];
    var start = b;
    var k = 0;
    while (k < _RY_PTM_MYRISTOYL_LEN) {
        if (b >= n) { return (0 - 1, 0, 0); }
        store64(&w + 8 * k, _ry_ptm_code(seq, n, b));
        b = b + _ry_ptm_char_len(seq, n, b);
        k = k + 1;
    }
    if (load64(&w) != 71) { return (0 - 1, 0, 0); }
    var c1 = load64(&w + 8);
    if (c1 == 69 || c1 == 68 || c1 == 82 || c1 == 75 || c1 == 72 || c1 == 80 || c1 == 70 || c1 == 89 || c1 == 87) {
        return (0 - 1, 0, 0);
    }
    var c4 = load64(&w + 32);
    if (c4 != 83 && c4 != 84 && c4 != 65 && c4 != 71 && c4 != 67 && c4 != 78) { return (0 - 1, 0, 0); }
    if (load64(&w + 40) == 80) { return (0 - 1, 0, 0); }
    return (gly, start, b);
}

# The scan: the sites of the n > 0 bytes at seq in Rust's order, the first `cap` written to out (none when cap is 0);
# returns how many there are. Rust pushes each position's sites as it passes it, a PKA site three characters on (at its
# acceptor) and the myristoyl Gly last, then sorts stably by position; so at each position this emits the PKA site
# found three characters back, then the position's own sites in Rust's push order, then the myristoyl site, which is
# the sorted order, with no sort.
#must_use
fn _ry_ptm_scan(seq, n, out: *RyPtmSite, cap): i64 {
    var myr, myr_start, myr_end = _ry_ptm_myristoyl(seq, n);
    # The pending PKA sites, by acceptor position mod 4: the position (-1 for none), its residue and motif range.
    var pk[128];
    var q = 0;
    while (q < 4) {
        store64(&pk + 32 * q, 0 - 1);
        q = q + 1;
    }
    # The characters at positions i .. i + 3 (c0 .. c3, -1 past the end) and the bytes where i .. i + 4 start.
    var b0 = 0;
    var b1 = _ry_ptm_char_len(seq, n, 0);
    var b2 = b1;
    if (b2 < n) { b2 = b2 + _ry_ptm_char_len(seq, n, b2); }
    var b3 = b2;
    if (b3 < n) { b3 = b3 + _ry_ptm_char_len(seq, n, b3); }
    var b4 = b3;
    if (b4 < n) { b4 = b4 + _ry_ptm_char_len(seq, n, b4); }
    var c0 = _ry_ptm_code(seq, n, 0);
    var c1 = _ry_ptm_code(seq, n, b1);
    var c2 = _ry_ptm_code(seq, n, b2);
    var c3 = _ry_ptm_code(seq, n, b3);
    var k = 0;
    var i = 0;
    while (c0 >= 0) {
        var slot = &pk + 32 * (i & 3);
        if (load64(slot) == i) {
            var pk_res = load64(slot + 8);
            k = _ry_ptm_put(out, cap, k, i, pk_res, RY_PTM_TYPE_PKA_SITE, load64(slot + 16), load64(slot + 24));
        }
        if (c0 == 78 && c3 >= 0 && c1 != 80 && _ry_ptm_st(c2) && c3 != 80) {
            k = _ry_ptm_put(out, cap, k, i, 78, RY_PTM_TYPE_N_GLYCOSYLATION, b0, b4);
        }
        if (c0 == 89) { k = _ry_ptm_put(out, cap, k, i, 89, RY_PTM_TYPE_PHOSPHO_TYR, b0, b1); }
        if ((c0 == 82 || c0 == 75) && (c1 == 82 || c1 == 75) && _ry_ptm_st(c3)) {
            var ps = &pk + 32 * ((i + 3) & 3);
            store64(ps, i + 3);
            store64(ps + 8, c3);
            store64(ps + 16, b0);
            store64(ps + 24, b4);
        }
        if (_ry_ptm_st(c0) && (c3 == 68 || c3 == 69)) {
            k = _ry_ptm_put(out, cap, k, i, c0, RY_PTM_TYPE_CK2_SITE, b0, b4);
        }
        if (c0 == 83) { k = _ry_ptm_put(out, cap, k, i, 83, RY_PTM_TYPE_PHOSPHO_SER, b0, b1); }
        if (c0 == 84) { k = _ry_ptm_put(out, cap, k, i, 84, RY_PTM_TYPE_PHOSPHO_THR, b0, b1); }
        if (c0 == 67) { k = _ry_ptm_put(out, cap, k, i, 67, RY_PTM_TYPE_DISULFIDE_BOND, b0, b1); }
        if (i == myr) { k = _ry_ptm_put(out, cap, k, i, 71, RY_PTM_TYPE_MYRISTOYLATION, myr_start, myr_end); }
        # The next character, as _ry_ptm_code and _ry_ptm_char_len read it, written in place (one call fewer each).
        c0 = c1;
        c1 = c2;
        c2 = c3;
        b0 = b1;
        b1 = b2;
        b2 = b3;
        b3 = b4;
        c3 = 0 - 1;
        if (b4 < n) {
            var lead = load8(seq + b4);
            b4 = b4 + 1;
            if (lead >= 128) {
                lead = 256;
                while (b4 < n && (load8(seq + b4) & 192) == 128) { b4 = b4 + 1; }
            } elif (lead >= 97 && lead <= 122) {
                lead = lead - 32;
            }
            c3 = lead;
        }
        i = i + 1;
    }
    return k;
}

# Scans the n bytes of UTF-8 at seq for candidate modification sites into the `cap` RyPtmSite records at out, sorted by
# position (the sites at one position in Rust's detection order). Ok(count) (0 when none is found), Ok(-1) for an
# empty sequence (Rust's None), or Err(RY_ERR_BUFFER_TOO_SMALL) when more than `cap` sites are found (nothing is
# written; RY_PTM_MAX_SITES_PER_RESIDUE · n records always suffice). Unknown residues, whitespace and non-ASCII are
# not validated: they never fill a slot that wants a particular residue, and they do fill the wildcard and exclusion
# slots. Positions are character indices. Mirrors `ptm::scan_ptm_sites`.
#must_use
fn ry_scan_ptm_sites(seq, n, out: *RyPtmSite, cap): Result {
    if (n <= 0) { return Ok(0 - 1); }
    if (cap < RY_PTM_MAX_SITES_PER_RESIDUE * n && _ry_ptm_scan(seq, n, out, 0) > cap) {
        return Err(_ry_fail_text(RY_ERR_BUFFER_TOO_SMALL, "scan_ptm_sites", 14));
    }
    return Ok(_ry_ptm_scan(seq, n, out, cap));
}

# The number of potential disulfide bonds in the n bytes at seq: its Cys residues (C or c) in pairs, rounded down.
# Mirrors `ptm::disulfide_bond_count`.
#must_use
#pure
fn ry_disulfide_bond_count(seq, n): i64 {
    var cys = 0;
    var k = 0;
    while (k < n) {
        var c = load8(seq + k);
        if (c == 67 || c == 99) { cys = cys + 1; }
        k = k + 1;
    }
    return cys / 2;
}

# Writes site s's motif, as Rust's `PtmSite::motif` holds it (the bytes of seq it spans, ASCII letters uppercased),
# into the `cap` bytes at buf: Ok(length), or Err(RY_ERR_BUFFER_TOO_SMALL) (nothing written). A motif is at most six
# characters, 24 bytes.
#must_use
fn ry_ptm_site_motif(seq, s: *RyPtmSite, buf, cap): Result {
    var len = s.motif_len;
    if (len > cap) { return Err(RY_ERR_BUFFER_TOO_SMALL); }
    var p = seq + s.motif_start;
    var k = 0;
    while (k < len) {
        var c = load8(p + k);
        if (c >= 97 && c <= 122) { c = c - 32; }
        store8(buf + k, c);
        k = k + 1;
    }
    return Ok(len);
}

# ── JSON (P7: serde_json's documents) ──

# Appends PtmType `t` as serde_json writes a unit variant (`"PkaSite"`): Ok(0), Err(RY_ERR_INVALID_PARAMETER) for a
# value that is none, or Err(RY_ERR_OUT_OF_MEMORY). Serialize only in Rust.
#must_use
fn ry_ptm_type_to_json_a(a, sb, t): Result {
    var name = ry_ptm_type_name(t);
    if (name == 0) { return Err(RY_ERR_INVALID_PARAMETER); }
    if (_ry_jw_unit(a, sb, name) != 0) { return Err(RY_ERR_OUT_OF_MEMORY); }
    return Ok(0);
}

# ry_ptm_type_to_json_a on the default allocator (a builder from str_builder_new).
#must_use
fn ry_ptm_type_to_json(sb, t): Result {
    return ry_ptm_type_to_json_a(default_alloc(), sb, t);
}

# Appends PtmSite `s` of sequence `seq` as serde_json writes it, `{"position":…,"residue":…,"ptm_type":…,"motif":…}`
# (the residue a one-character string, the motif as ry_ptm_site_motif gives it): Ok(0), Err(RY_ERR_INVALID_PARAMETER)
# for a site that no scan gives (a type that is none, a residue outside ASCII, a motif over 24 bytes), or
# Err(RY_ERR_OUT_OF_MEMORY). Serialize only in Rust.
#must_use
fn ry_ptm_site_to_json_a(a, sb, seq, s: *RyPtmSite): Result {
    var name = ry_ptm_type_name(s.ptm_type);
    var res = s.residue;
    if (name == 0 || res < 0 || res > 127) { return Err(RY_ERR_INVALID_PARAMETER); }
    var m[24];
    var tm, len = ry_ptm_site_motif(seq, s, &m, 24);
    if (is_err_result(tm) == 1) { return Err(RY_ERR_INVALID_PARAMETER); }
    var rb[8];
    store8(&rb, res);
    var r = _ry_jw_byte(a, sb, 123);
    r = r | _ry_jw_key(a, sb, "position", 1);
    r = r | _ry_jw_u64(a, sb, s.position);
    r = r | _ry_jw_key(a, sb, "residue", 0);
    r = r | _ry_jw_char(a, sb, &rb, 1);
    r = r | _ry_jw_key(a, sb, "ptm_type", 0);
    r = r | _ry_jw_unit(a, sb, name);
    r = r | _ry_jw_key(a, sb, "motif", 0);
    r = r | _ry_jw_str(a, sb, &m, len);
    r = r | _ry_jw_byte(a, sb, 125);
    if (r != 0) { return Err(RY_ERR_OUT_OF_MEMORY); }
    return Ok(0);
}

# ry_ptm_site_to_json_a on the default allocator.
#must_use
fn ry_ptm_site_to_json(sb, seq, s: *RyPtmSite): Result {
    return ry_ptm_site_to_json_a(default_alloc(), sb, seq, s);
}

# --- domain.cyr ---

# domain.cyr — motif-based protein domain detection: the C2H2 zinc finger (PROSITE PS00028), the EF-hand loop
# (PS00018), Walker A / P-loop (PS00017), leucine-zipper heptads, the DEAD tetrapeptide, RGD, a basic NLS tetrapeptide
# and C-terminal KDEL (Rust 1.2.0's `domain.rs`, transcribed). Consensus patterns, not profile models: the short ones
# occur by chance in most proteins, so a hit is a candidate.
#
# A sequence is `(seq, n)`: n bytes of UTF-8 at seq (Rust's `&str`). Rust matches `chars()` and reports character
# indices, and its wildcard (`x`) and exclusion (`{W}`) slots take any character, a non-ASCII one included; so the scan
# steps by character and counts positions in characters, as src/ptm.cyr does. An ASCII byte is one character, any
# other byte begins one that takes the continuation bytes after it (Rust's `chars()` for valid UTF-8; invalid input,
# which a Rust `&str` cannot hold, is read the same way). Every result is exact (class A in tests/golden/domain.tsv).
#
# The Cyrius forms (ADR 0002 rows 2–4):
# - DomainType is `enum RyDomainType`, its values Rust's declaration order (append-only); CatalyticTriad is reserved,
#   as in Rust: no scan reports it;
# - `scan_domains`'s `Option<Vec<DomainHit>>` fills a caller buffer of RyDomainHit records and returns Ok(count),
#   Ok(-1) for None (an empty sequence; a Some may be empty), or Err(RY_ERR_BUFFER_TOO_SMALL), with nothing written;
# - DomainHit's `fragment: String` is a byte range into the caller's sequence, Rust's fragment being those characters
#   with ASCII letters uppercased (`ry_domain_hit_fragment` writes it);
# - DomainType and DomainHit write `ry_<type>_to_json` (and `_a`, on an allocator).

# The kinds of domain and motif (Rust's `DomainType`). The values are append-only.
enum RyDomainType {
    RY_DOMAIN_TYPE_ZINC_FINGER_C2H2 = 0;
    RY_DOMAIN_TYPE_LEU_ZIPPER = 1;
    RY_DOMAIN_TYPE_EF_HAND = 2;
    RY_DOMAIN_TYPE_WALKER_A = 3;
    RY_DOMAIN_TYPE_RGD_MOTIF = 4;
    RY_DOMAIN_TYPE_DEAD_BOX = 5;
    RY_DOMAIN_TYPE_CATALYTIC_TRIAD = 6;
    RY_DOMAIN_TYPE_NLS = 7;
    RY_DOMAIN_TYPE_KDEL_SIGNAL = 8;
}

# The number of DomainType values.
const RY_DOMAIN_TYPE_COUNT = 9;

# The most hits that start at one character (a C starting a C2H2 finger at each of its 3 × 3 spacings), so 9 · n
# records always hold the hits of an n-byte sequence.
const RY_DOMAIN_MAX_HITS_PER_RESIDUE = 9;

# The longest fragment: a C2H2 finger at its widest spacings, C-x(4)-C-x(3)-[..]-x(8)-H-x(5)-H, 25 characters of at
# most 4 bytes.
const RY_DOMAIN_MAX_FRAGMENT_BYTES = 100;

# The variant name of a DomainType (`"ZincFingerC2H2"`, as serde writes it), or 0 for a value that is none.
#must_use
#pure
fn ry_domain_type_name(t): cstring {
    match t {
        RY_DOMAIN_TYPE_ZINC_FINGER_C2H2 => { return "ZincFingerC2H2"; }
        RY_DOMAIN_TYPE_LEU_ZIPPER => { return "LeuZipper"; }
        RY_DOMAIN_TYPE_EF_HAND => { return "EfHand"; }
        RY_DOMAIN_TYPE_WALKER_A => { return "WalkerA"; }
        RY_DOMAIN_TYPE_RGD_MOTIF => { return "RgdMotif"; }
        RY_DOMAIN_TYPE_DEAD_BOX => { return "DeadBox"; }
        RY_DOMAIN_TYPE_CATALYTIC_TRIAD => { return "CatalyticTriad"; }
        RY_DOMAIN_TYPE_NLS => { return "Nls"; }
        RY_DOMAIN_TYPE_KDEL_SIGNAL => { return "KdelSignal"; }
        _ => { return 0; }
    }
    return 0;
}

# A detected domain or motif (Rust's `DomainHit`): the first and last character index (inclusive), the RyDomainType,
# and the fragment as the byte range [fragment_start, fragment_start + fragment_len) of the scanned sequence.
struct RyDomainHit {
    start;
    end;
    domain_type;
    fragment_start;
    fragment_len;
}

# Word p of the 32-slot ring at r (a position's character code or start byte).
#must_use
#inline
fn _ry_domain_at(r, p): i64 { return load64(r + 8 * (p & 31)); }

# Writes hit k (when k < cap) and returns k + 1.
#must_use
fn _ry_domain_put(out: *RyDomainHit, cap, k, start, end, domain_type, from, to): i64 {
    if (k < cap) {
        var h: *RyDomainHit = out + k;
        h.start = start;
        h.end = end;
        h.domain_type = domain_type;
        h.fragment_start = from;
        h.fragment_len = to - from;
    }
    return k + 1;
}

# 1 when the 12 characters from position i of code ring rc are a PS00018 EF-hand loop,
# `D-{W}-[DNS]-{ILVFYW}-[DENSTG]-[DNQGHRK]-{GP}-[LIVMC]-[DENQSTAGC]-x(2)-[DE]` (the D at i already tested; a position
# past the end is -1 and matches nothing). Mirrors domain.rs's private `is_ef_hand_loop`.
#must_use
fn _ry_domain_ef_hand(rc, i): i64 {
    var p11 = _ry_domain_at(rc, i + 11);
    if (p11 != 68 && p11 != 69) { return 0; }
    if (_ry_domain_at(rc, i + 1) == 87) { return 0; }
    var p2 = _ry_domain_at(rc, i + 2);
    if (p2 != 68 && p2 != 78 && p2 != 83) { return 0; }
    var p3 = _ry_domain_at(rc, i + 3);
    if (p3 == 73 || p3 == 76 || p3 == 86 || p3 == 70 || p3 == 89 || p3 == 87) { return 0; }
    var p4 = _ry_domain_at(rc, i + 4);
    if (p4 != 68 && p4 != 69 && p4 != 78 && p4 != 83 && p4 != 84 && p4 != 71) { return 0; }
    var p5 = _ry_domain_at(rc, i + 5);
    if (p5 != 68 && p5 != 78 && p5 != 81 && p5 != 71 && p5 != 72 && p5 != 82 && p5 != 75) { return 0; }
    var p6 = _ry_domain_at(rc, i + 6);
    if (p6 == 71 || p6 == 80) { return 0; }
    var p7 = _ry_domain_at(rc, i + 7);
    if (p7 != 76 && p7 != 73 && p7 != 86 && p7 != 77 && p7 != 67) { return 0; }
    var p8 = _ry_domain_at(rc, i + 8);
    var d8 = p8 == 68 || p8 == 69 || p8 == 78 || p8 == 81 || p8 == 83;
    if (d8 == 0 && p8 != 84 && p8 != 65 && p8 != 71 && p8 != 67) { return 0; }
    return 1;
}

# The scan: the hits of the n > 0 bytes at seq in Rust's order, the first `cap` written to out (none when cap is 0);
# returns how many there are. Rust runs each pattern over the whole sequence in turn and then sorts the hits stably by
# start; every pattern is anchored at its start, so at each position this emits that position's hits in the order of
# Rust's passes (RGD, DEAD, KDEL, NLS, Walker A, EF-hand, the zipper, the C2H2 fingers by spacing), which is the sorted
# order, with no sort. Each pattern names its first residue, so the position's first character picks the passes. A
# 32-slot ring holds the codes (an ASCII byte uppercased, 256 for a non-ASCII character, -1 past the end) and start
# bytes of positions i .. i + 25, the farthest a finger reaches; past the end a start is n.
#must_use
fn _ry_domain_scan(seq, n, out: *RyDomainHit, cap): i64 {
    var rc[256];
    var rb[256];
    var top = 0;
    var tb = 0;
    var k = 0;
    var i = 0;
    while (1 == 1) {
        while (top < i + 26) {
            var slot = 8 * (top & 31);
            if (tb < n) {
                var lead = load8(seq + tb);
                store64(&rb + slot, tb);
                tb = tb + 1;
                if (lead >= 128) {
                    lead = 256;
                    while (tb < n && (load8(seq + tb) & 192) == 128) { tb = tb + 1; }
                } elif (lead >= 97 && lead <= 122) {
                    lead = lead - 32;
                }
                store64(&rc + slot, lead);
            } else {
                store64(&rc + slot, 0 - 1);
                store64(&rb + slot, n);
            }
            top = top + 1;
        }
        # Position i's code and start byte, loaded in place (the helper's call costs about 1 ns a load here).
        var c0 = load64(&rc + 8 * (i & 31));
        if (c0 < 0) { return k; }
        var b0 = load64(&rb + 8 * (i & 31));
        if (c0 == 82 || c0 == 75) {
            var c1 = _ry_domain_at(&rc, i + 1);
            var c2 = _ry_domain_at(&rc, i + 2);
            var c3 = _ry_domain_at(&rc, i + 3);
            if (c0 == 82 && c1 == 71 && c2 == 68) {
                k = _ry_domain_put(out, cap, k, i, i + 2, RY_DOMAIN_TYPE_RGD_MOTIF, b0, _ry_domain_at(&rb, i + 3));
            }
            if (c0 == 75 && c1 == 68 && c2 == 69 && c3 == 76 && _ry_domain_at(&rc, i + 4) < 0) {
                k = _ry_domain_put(out, cap, k, i, i + 3, RY_DOMAIN_TYPE_KDEL_SIGNAL, b0, _ry_domain_at(&rb, i + 4));
            }
            if ((c1 == 75 || c1 == 82) && (c3 == 75 || c3 == 82)) {
                k = _ry_domain_put(out, cap, k, i, i + 3, RY_DOMAIN_TYPE_NLS, b0, _ry_domain_at(&rb, i + 4));
            }
        } elif (c0 == 68) {
            var d1 = _ry_domain_at(&rc, i + 1);
            var d2 = _ry_domain_at(&rc, i + 2);
            var d3 = _ry_domain_at(&rc, i + 3);
            if (d1 == 69 && d2 == 65 && d3 == 68) {
                k = _ry_domain_put(out, cap, k, i, i + 3, RY_DOMAIN_TYPE_DEAD_BOX, b0, _ry_domain_at(&rb, i + 4));
            }
            if (_ry_domain_ef_hand(&rc, i) == 1) {
                k = _ry_domain_put(out, cap, k, i, i + 11, RY_DOMAIN_TYPE_EF_HAND, b0, _ry_domain_at(&rb, i + 12));
            }
        } elif (c0 == 65 || c0 == 71) {
            var w7 = _ry_domain_at(&rc, i + 7);
            var walker = _ry_domain_at(&rc, i + 5) == 71 && _ry_domain_at(&rc, i + 6) == 75;
            if (walker && (w7 == 83 || w7 == 84)) {
                k = _ry_domain_put(out, cap, k, i, i + 7, RY_DOMAIN_TYPE_WALKER_A, b0, _ry_domain_at(&rb, i + 8));
            }
        } elif (c0 == 76) {
            var heptads = _ry_domain_at(&rc, i + 7) == 76 && _ry_domain_at(&rc, i + 14) == 76;
            if (heptads && _ry_domain_at(&rc, i + 21) == 76) {
                k = _ry_domain_put(out, cap, k, i, i + 21, RY_DOMAIN_TYPE_LEU_ZIPPER, b0, _ry_domain_at(&rb, i + 22));
            }
        } elif (c0 == 67) {
            var gap1 = 2;
            while (gap1 <= 4) {
                var cp = i + 1 + gap1;
                var hy = _ry_domain_at(&rc, cp + 4);
                var hydrophobic = hy == 76 || hy == 73 || hy == 86 || hy == 77;
                hydrophobic = hydrophobic || hy == 70 || hy == 89 || hy == 87 || hy == 67;
                var h1 = cp + 13;
                if (_ry_domain_at(&rc, cp) == 67 && hydrophobic && _ry_domain_at(&rc, h1) == 72) {
                    var gap2 = 3;
                    while (gap2 <= 5) {
                        var h2 = h1 + 1 + gap2;
                        if (_ry_domain_at(&rc, h2) == 72) {
                            var to = _ry_domain_at(&rb, h2 + 1);
                            k = _ry_domain_put(out, cap, k, i, h2, RY_DOMAIN_TYPE_ZINC_FINGER_C2H2, b0, to);
                        }
                        gap2 = gap2 + 1;
                    }
                }
                gap1 = gap1 + 1;
            }
        }
        i = i + 1;
    }
    return k;
}

# Scans the n bytes of UTF-8 at seq for known domain motifs into the `cap` RyDomainHit records at out, sorted by start
# (the hits at one start in Rust's detection order). Ok(count) (0 when none is found), Ok(-1) for an empty sequence
# (Rust's None), or Err(RY_ERR_BUFFER_TOO_SMALL) when more than `cap` hits are found (nothing is written;
# RY_DOMAIN_MAX_HITS_PER_RESIDUE · n records always suffice). Positions are character indices. Mirrors
# `domain::scan_domains`.
#must_use
fn ry_scan_domains(seq, n, out: *RyDomainHit, cap): Result {
    if (n <= 0) { return Ok(0 - 1); }
    if (cap < RY_DOMAIN_MAX_HITS_PER_RESIDUE * n && _ry_domain_scan(seq, n, out, 0) > cap) {
        return Err(_ry_fail_text(RY_ERR_BUFFER_TOO_SMALL, "scan_domains", 12));
    }
    return Ok(_ry_domain_scan(seq, n, out, cap));
}

# Writes hit h's fragment, as Rust's `DomainHit::fragment` holds it (the bytes of seq it spans, ASCII letters
# uppercased), into the `cap` bytes at buf: Ok(length), or Err(RY_ERR_BUFFER_TOO_SMALL) (nothing written).
# RY_DOMAIN_MAX_FRAGMENT_BYTES always suffice.
#must_use
fn ry_domain_hit_fragment(seq, h: *RyDomainHit, buf, cap): Result {
    var len = h.fragment_len;
    if (len > cap) { return Err(RY_ERR_BUFFER_TOO_SMALL); }
    var p = seq + h.fragment_start;
    var k = 0;
    while (k < len) {
        var c = load8(p + k);
        if (c >= 97 && c <= 122) { c = c - 32; }
        store8(buf + k, c);
        k = k + 1;
    }
    return Ok(len);
}

# ── JSON (P7: serde_json's documents) ──

# Appends DomainType `t` as serde_json writes a unit variant (`"EfHand"`): Ok(0), Err(RY_ERR_INVALID_PARAMETER) for a
# value that is none, or Err(RY_ERR_OUT_OF_MEMORY). Serialize only in Rust.
#must_use
fn ry_domain_type_to_json_a(a, sb, t): Result {
    var name = ry_domain_type_name(t);
    if (name == 0) { return Err(RY_ERR_INVALID_PARAMETER); }
    if (_ry_jw_unit(a, sb, name) != 0) { return Err(RY_ERR_OUT_OF_MEMORY); }
    return Ok(0);
}

# ry_domain_type_to_json_a on the default allocator (a builder from str_builder_new).
#must_use
fn ry_domain_type_to_json(sb, t): Result {
    return ry_domain_type_to_json_a(default_alloc(), sb, t);
}

# Appends DomainHit `h` of sequence `seq` as serde_json writes it, `{"start":…,"end":…,"domain_type":…,"fragment":…}`
# (the fragment as ry_domain_hit_fragment gives it): Ok(0), Err(RY_ERR_INVALID_PARAMETER) for a hit that no scan gives
# (a type that is none, a fragment over RY_DOMAIN_MAX_FRAGMENT_BYTES), or Err(RY_ERR_OUT_OF_MEMORY). Serialize only in
# Rust.
#must_use
fn ry_domain_hit_to_json_a(a, sb, seq, h: *RyDomainHit): Result {
    var name = ry_domain_type_name(h.domain_type);
    if (name == 0) { return Err(RY_ERR_INVALID_PARAMETER); }
    var f[104];
    var tf, len = ry_domain_hit_fragment(seq, h, &f, RY_DOMAIN_MAX_FRAGMENT_BYTES);
    if (is_err_result(tf) == 1) { return Err(RY_ERR_INVALID_PARAMETER); }
    var r = _ry_jw_byte(a, sb, 123);
    r = r | _ry_jw_key(a, sb, "start", 1);
    r = r | _ry_jw_u64(a, sb, h.start);
    r = r | _ry_jw_key(a, sb, "end", 0);
    r = r | _ry_jw_u64(a, sb, h.end);
    r = r | _ry_jw_key(a, sb, "domain_type", 0);
    r = r | _ry_jw_unit(a, sb, name);
    r = r | _ry_jw_key(a, sb, "fragment", 0);
    r = r | _ry_jw_str(a, sb, &f, len);
    r = r | _ry_jw_byte(a, sb, 125);
    if (r != 0) { return Err(RY_ERR_OUT_OF_MEMORY); }
    return Ok(0);
}

# ry_domain_hit_to_json_a on the default allocator.
#must_use
fn ry_domain_hit_to_json(sb, seq, h: *RyDomainHit): Result {
    return ry_domain_hit_to_json_a(default_alloc(), sb, seq, h);
}

# --- glycolysis_data.cyr ---

# rasayan — glycolysis data: the default state and enzyme parameters
#
# GENERATED from rasayan 1.2.0's source (rust-old/, the functional spec, read as text). Do not edit.
