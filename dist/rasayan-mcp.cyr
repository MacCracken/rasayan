# Pi3kState::default() and Pi3kConfig::default(), from rasayan 1.2.0: one f64 const per
# field, as a round-trip decimal, checked against the `Self { … }` literals.
# tests/golden/pi3k.tsv pins them.

# PI3K/Akt/mTOR pathway activation state (fractions 0.0-1.0).
# Rust: rasayan::pi3k::Pi3kState::default()

# PIP3 level (normalized). Product of PI3K, substrate of PTEN.
# Rust: rasayan::pi3k::Pi3kState::default().pip3
const RY_PI3K_PI3K_STATE_DEFAULT_PIP3 = 0.05;

# Akt active (phosphorylated) fraction.
# Rust: rasayan::pi3k::Pi3kState::default().akt_active
const RY_PI3K_PI3K_STATE_DEFAULT_AKT_ACTIVE = 0.03;

# mTOR active fraction.
# Rust: rasayan::pi3k::Pi3kState::default().mtor_active
const RY_PI3K_PI3K_STATE_DEFAULT_MTOR_ACTIVE = 0.02;

# Pi3kState's field names, NUL-separated, in declaration order.
var _RY_PI3K_STATE_FIELDS: u8[28] = {
    112, 105, 112, 51, 0,  # pip3
    97, 107, 116, 95, 97, 99, 116, 105, 118, 101, 0,  # akt_active
    109, 116, 111, 114, 95, 97, 99, 116, 105, 118, 101, 0,  # mtor_active
};

# Kinetic parameters for PI3K/Akt/mTOR.
# Rust: rasayan::pi3k::Pi3kConfig::default()

# PI3K-driven PIP3 production Vmax (s^-1 per unit of unconverted PIP2
# headroom, `1 − pip3`).
# Rust: rasayan::pi3k::Pi3kConfig::default().pi3k_vmax
const RY_PI3K_PI3K_CONFIG_DEFAULT_PI3K_VMAX = 0.4;

# Receptor activity giving half-maximal PI3K activity (must be > 0).
# Rust: rasayan::pi3k::Pi3kConfig::default().pi3k_km
const RY_PI3K_PI3K_CONFIG_DEFAULT_PI3K_KM = 0.1;

# PTEN dephosphorylation rate of PIP3 (s^-1).
