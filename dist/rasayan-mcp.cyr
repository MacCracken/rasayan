# --- tca.cyr ---

# tca.cyr — the TCA (Krebs) cycle: pyruvate dehydrogenase and the eight steps oxidizing acetyl-CoA, regulated by the
# energy charge (Rust 1.2.0's `tca.rs`, transcribed).
#
# | # | Enzyme | Reaction | Output |
# |---|--------|----------|--------|
# | 0 | Pyruvate dehydrogenase | Pyruvate → Acetyl-CoA + CO2 | NADH |
# | 1 | Citrate synthase | OAA + Acetyl-CoA → Citrate | — |
# | 2 | Aconitase | Citrate ⇌ Isocitrate | — |
# | 3 | Isocitrate dehydrogenase | Isocitrate → α-KG + CO2 | NADH |
# | 4 | α-Ketoglutarate dehydrogenase | α-KG → Succinyl-CoA + CO2 | NADH |
# | 5 | Succinyl-CoA synthetase | Succinyl-CoA → Succinate | GTP |
# | 6 | Succinate dehydrogenase | Succinate → Fumarate | FADH2 |
# | 7 | Fumarase | Fumarate ⇌ Malate | — |
# | 8 | Malate dehydrogenase | Malate ⇌ OAA | NADH |
#
# Three irreversible steps are regulated by the energy charge (the ATP/ADP ratio): citrate synthase (inhibited by ATP
# and citrate), isocitrate dehydrogenase (allosteric: activated by ADP, inhibited by ATP and NADH) and α-KG
# dehydrogenase (inhibited by succinyl-CoA, NADH and ATP). Concentrations in mM, rates in mM/s, time in seconds.
#
# Every operation is in Rust's order (P9): tests/golden/tca.tsv compares each method with the oracle's at ≤ 2 ulp where
# only + − × ÷, √ and `powi(2)` run (class B, expected 0), at 0 ulp against the corrected oracle where isocitrate
# dehydrogenase's Hill fraction calls `powf` (class C, ADR 0003: `_ry_cr_pow`), and bit for bit over the trajectory
# scripts (class T).
#
# The Cyrius forms (ADR 0002 rows 7, 10, 14), as glycolysis's:
# - TcaState, TcaConfig and TcaFlux are structs of f64 (RyTcaState, RyTcaConfig, RyTcaFlux); the tick updates the
#   state in place and fills the caller's flux: `ry_tca_state_tick(&s, &c, pyruvate, atp, adp, nad_ratio, dt, &flux)`;
# - the flux's `step_rates: [f64; 9]` is nine consecutive fields named for their enzymes (`rate_pdh` … `rate_mdh`,
#   Rust's index order); ry_tca_flux_step_rates(&flux) is their address, the array view;
# - `impl Default` is `ry_tca_state_default(&out)` / `ry_tca_config_default(&out)` from the generated consts
#   (src/tca_data.cyr), and the derived `TcaFlux::default()` is ry_tca_flux_default(&out);
# - the crate-private `TcaFlux::accumulate`, which the metabolic network calls (M5), is _ry_tca_flux_accumulate;
# - Rust's `tracing::trace!` event (`tca_tick`) is a level-gated sakshi event under the target `rasayan::tca`, its
#   fields in Rust's order;
# - each serde type's codec is `ry_<type>_to_json` / `_from_json` (and `_a`, on an allocator).

# Concentrations of the TCA cycle intermediates and acetyl-CoA (mM). The default is a typical resting mammalian cell.
# Rust's `TcaState`.
struct RyTcaState {
    acetyl_coa: f64;
    citrate: f64;
    isocitrate: f64;
    alpha_kg: f64;
    succinyl_coa: f64;
    succinate: f64;
    fumarate: f64;
    malate: f64;
    oxaloacetate: f64;
}

# The enzyme parameters of PDH and the eight steps (Vmax in mM/s; Km, Ki and K½ in mM; IDH's Hill coefficient and its
# ADP activation) and the ATP/ADP ratio at which the energy charge half-inhibits the regulated steps. Rust's
# `TcaConfig`.
struct RyTcaConfig {
    pdh_vmax: f64;
    pdh_km_pyruvate: f64;
    cs_vmax: f64;
    cs_km_oaa: f64;
    cs_km_accoa: f64;
    cs_ki_oaa: f64;
    cs_ki_citrate: f64;
    acon_vmax_f: f64;
    acon_km_f: f64;
    acon_vmax_r: f64;
    acon_km_r: f64;
    idh_vmax: f64;
    idh_km_isocitrate: f64;
    idh_hill_n: f64;
    idh_adp_ka: f64;
    idh_adp_max_activation: f64;
    kgdh_vmax: f64;
    kgdh_km_akg: f64;
    kgdh_ki_succoa: f64;
    scs_vmax: f64;
    scs_km: f64;
    sdh_vmax: f64;
    sdh_km: f64;
    fum_vmax_f: f64;
    fum_km_f: f64;
    fum_vmax_r: f64;
    fum_km_r: f64;
    mdh_vmax_f: f64;
    mdh_km_f: f64;
    mdh_vmax_r: f64;
    mdh_km_r: f64;
    energy_half_inhibition: f64;
}

# One tick's flux through the cycle (mM), for the caller to apply to its pools: the pyruvate PDH consumed, NADH (PDH
# and steps 3, 4, 8: up to 4 per acetyl-CoA), FADH2 (step 6), GTP (step 5) and CO2 (PDH and steps 3, 4: 3 per
# pyruvate); then each step's effective rate (mM/s), the amount it moved divided by dt after capping, negative for a
# reversible step running backwards. Rust's `TcaFlux`.
struct RyTcaFlux {
    pyruvate_consumed: f64;
    nadh_produced: f64;
    fadh2_produced: f64;
    gtp_produced: f64;
    co2_produced: f64;
    rate_pdh: f64;
    rate_cs: f64;
    rate_acon: f64;
    rate_idh: f64;
    rate_kgdh: f64;
    rate_scs: f64;
    rate_sdh: f64;
    rate_fum: f64;
    rate_mdh: f64;
}

# TcaFlux's five amounts' names, NUL-separated, in Rust's declaration order (JSON); the state's and the config's are
# generated (_RY_TCA_STATE_FIELDS, _RY_TCA_CONFIG_FIELDS, src/tca_data.cyr).
var _RY_TCA_FLUX_FIELDS = "pyruvate_consumed\0nadh_produced\0fadh2_produced\0gtp_produced\0co2_produced\0";

# Each config field's rule in TcaConfig::validate, in declaration order: `v` a Vmax (finite, >= 0), `k` a divisor (Km,
# Ki, K½, the Hill coefficient, the half-inhibition ratio: finite, > 0), `a` the fold change (finite, >= 1). Rust
# checks every `v`, then every `k`, then the `a`, each list in declaration order.
var _RY_TCA_CONFIG_RULES = "vkvkkkkvkvkvkkkavkkvkvkvkvkvkvkk";

# ── defaults ──

# Fills *out with the resting cell's concentrations (RY_TCA_TCA_STATE_DEFAULT_*: acetyl-CoA 0.05, citrate 0.3,
# isocitrate 0.02, α-KG 0.3, succinyl-CoA 0.1, succinate 0.5, fumarate 0.05, malate 0.3, oxaloacetate 0.01 mM).
# Mirrors `TcaState::default()`.
fn ry_tca_state_default(out: *RyTcaState) {
    out.acetyl_coa = RY_TCA_TCA_STATE_DEFAULT_ACETYL_COA;
    out.citrate = RY_TCA_TCA_STATE_DEFAULT_CITRATE;
    out.isocitrate = RY_TCA_TCA_STATE_DEFAULT_ISOCITRATE;
    out.alpha_kg = RY_TCA_TCA_STATE_DEFAULT_ALPHA_KG;
    out.succinyl_coa = RY_TCA_TCA_STATE_DEFAULT_SUCCINYL_COA;
    out.succinate = RY_TCA_TCA_STATE_DEFAULT_SUCCINATE;
    out.fumarate = RY_TCA_TCA_STATE_DEFAULT_FUMARATE;
    out.malate = RY_TCA_TCA_STATE_DEFAULT_MALATE;
    out.oxaloacetate = RY_TCA_TCA_STATE_DEFAULT_OXALOACETATE;
    return 0;
}

# Fills *out with the consensus mammalian enzyme parameters (RY_TCA_TCA_CONFIG_DEFAULT_*; Stryer, Lehninger, Cortassa
# et al. 2003). Mirrors `TcaConfig::default()`.
fn ry_tca_config_default(out: *RyTcaConfig) {
    out.pdh_vmax = RY_TCA_TCA_CONFIG_DEFAULT_PDH_VMAX;
    out.pdh_km_pyruvate = RY_TCA_TCA_CONFIG_DEFAULT_PDH_KM_PYRUVATE;
    out.cs_vmax = RY_TCA_TCA_CONFIG_DEFAULT_CS_VMAX;
    out.cs_km_oaa = RY_TCA_TCA_CONFIG_DEFAULT_CS_KM_OAA;
    out.cs_km_accoa = RY_TCA_TCA_CONFIG_DEFAULT_CS_KM_ACCOA;
    out.cs_ki_oaa = RY_TCA_TCA_CONFIG_DEFAULT_CS_KI_OAA;
    out.cs_ki_citrate = RY_TCA_TCA_CONFIG_DEFAULT_CS_KI_CITRATE;
    out.acon_vmax_f = RY_TCA_TCA_CONFIG_DEFAULT_ACON_VMAX_F;
    out.acon_km_f = RY_TCA_TCA_CONFIG_DEFAULT_ACON_KM_F;
    out.acon_vmax_r = RY_TCA_TCA_CONFIG_DEFAULT_ACON_VMAX_R;
    out.acon_km_r = RY_TCA_TCA_CONFIG_DEFAULT_ACON_KM_R;
    out.idh_vmax = RY_TCA_TCA_CONFIG_DEFAULT_IDH_VMAX;
    out.idh_km_isocitrate = RY_TCA_TCA_CONFIG_DEFAULT_IDH_KM_ISOCITRATE;
    out.idh_hill_n = RY_TCA_TCA_CONFIG_DEFAULT_IDH_HILL_N;
    out.idh_adp_ka = RY_TCA_TCA_CONFIG_DEFAULT_IDH_ADP_KA;
    out.idh_adp_max_activation = RY_TCA_TCA_CONFIG_DEFAULT_IDH_ADP_MAX_ACTIVATION;
    out.kgdh_vmax = RY_TCA_TCA_CONFIG_DEFAULT_KGDH_VMAX;
    out.kgdh_km_akg = RY_TCA_TCA_CONFIG_DEFAULT_KGDH_KM_AKG;
    out.kgdh_ki_succoa = RY_TCA_TCA_CONFIG_DEFAULT_KGDH_KI_SUCCOA;
    out.scs_vmax = RY_TCA_TCA_CONFIG_DEFAULT_SCS_VMAX;
    out.scs_km = RY_TCA_TCA_CONFIG_DEFAULT_SCS_KM;
    out.sdh_vmax = RY_TCA_TCA_CONFIG_DEFAULT_SDH_VMAX;
    out.sdh_km = RY_TCA_TCA_CONFIG_DEFAULT_SDH_KM;
    out.fum_vmax_f = RY_TCA_TCA_CONFIG_DEFAULT_FUM_VMAX_F;
    out.fum_km_f = RY_TCA_TCA_CONFIG_DEFAULT_FUM_KM_F;
    out.fum_vmax_r = RY_TCA_TCA_CONFIG_DEFAULT_FUM_VMAX_R;
    out.fum_km_r = RY_TCA_TCA_CONFIG_DEFAULT_FUM_KM_R;
    out.mdh_vmax_f = RY_TCA_TCA_CONFIG_DEFAULT_MDH_VMAX_F;
    out.mdh_km_f = RY_TCA_TCA_CONFIG_DEFAULT_MDH_KM_F;
    out.mdh_vmax_r = RY_TCA_TCA_CONFIG_DEFAULT_MDH_VMAX_R;
    out.mdh_km_r = RY_TCA_TCA_CONFIG_DEFAULT_MDH_KM_R;
    out.energy_half_inhibition = RY_TCA_TCA_CONFIG_DEFAULT_ENERGY_HALF_INHIBITION;
    return 0;
}

# Fills *out with the zero flux (every field +0). Mirrors the derived `TcaFlux::default()`.
fn ry_tca_flux_default(out: *RyTcaFlux) {
    memset(out, 0, 112);
    return 0;
}

# The address of the flux's nine step rates, `rate_pdh` … `rate_mdh`: Rust's `step_rates: [f64; 9]`, index i at
# `+ 8 * i` (0 PDH, 1 citrate synthase, 3 isocitrate dehydrogenase, 8 malate dehydrogenase).
#must_use
#pure
fn ry_tca_flux_step_rates(f: *RyTcaFlux): i64 {
    var w = f;                                   # a plain address: `f + n` would step n · 112 bytes
    return w + 40;
}

# ── validation ──

# Ok(0) when every concentration is finite and >= 0; else the first failing field's `_ry_guard_non_negative` Err
# (RY_ERR_NON_FINITE or RY_ERR_NEGATIVE_CONCENTRATION), in declaration order. Mirrors `TcaState::validate`.
#must_use
fn ry_tca_state_validate(p: *RyTcaState): Result {
    var w = p;                                   # a plain address: `p + n` would step n · 72 bytes
    var name = &_RY_TCA_STATE_FIELDS;
    var k = 0;
    while (k < 9) {
        var value: f64 = load64(w + 8 * k);
        var t, v = _ry_guard_non_negative(name, value);
        if (is_err_result(t) == 1) { return Err(v); }
        name = name + strlen(name) + 1;
        k = k + 1;
    }
    return Ok(0);
}

# The first refusal among config fields whose rule is `rule` (`v` or `k`, _RY_TCA_CONFIG_RULES), in declaration order:
# Ok(0), or the guard's Err.
fn _ry_tca_config_check(p: *RyTcaConfig, rule): Result {
    var w = p;                                   # a plain address: `p + n` would step n · 256 bytes
    var name = &_RY_TCA_CONFIG_FIELDS;
    var k = 0;
    while (k < 32) {
        if (load8(_RY_TCA_CONFIG_RULES + k) == rule) {
            var value: f64 = load64(w + 8 * k);
            if (rule == 118) {
                var t, v = _ry_guard_non_negative(name, value);
                if (is_err_result(t) == 1) { return Err(v); }
            } else {
                var tp, vp = _ry_guard_positive(name, value);
                if (is_err_result(tp) == 1) { return Err(vp); }
            }
        }
        name = name + strlen(name) + 1;
        k = k + 1;
    }
    return Ok(0);
}

# Ok(0) when every parameter is physically meaningful: each Vmax finite and >= 0 (else RY_ERR_NON_FINITE or
# RY_ERR_NEGATIVE_CONCENTRATION); each Km, Ki and half-saturation constant (energy_half_inhibition included) and
# idh_hill_n, used as divisors, finite and > 0 (RY_ERR_INVALID_PARAMETER at or below 0); idh_adp_max_activation, a fold
# change, finite and >= 1. The Vmax are checked first, then the divisors, then the fold change, each in declaration
# order. Mirrors `TcaConfig::validate`.
#must_use
fn ry_tca_config_validate(p: *RyTcaConfig): Result {
    var t1, v1 = _ry_tca_config_check(p, 118);
    if (is_err_result(t1) == 1) { return Err(v1); }
    var t2, v2 = _ry_tca_config_check(p, 107);
    if (is_err_result(t2) == 1) { return Err(v2); }
    var fold: f64 = p.idh_adp_max_activation;
    var t3, v3 = _ry_guard_at_least("idh_adp_max_activation", fold, 1.0);
    if (is_err_result(t3) == 1) { return Err(v3); }
    return Ok(0);
}

# ── the tick ──

# Advances the TCA cycle by `dt` seconds (explicit Euler) and fills *out with the flux. PDH (step 0) converts the
# `pyruvate` supplied to acetyl-CoA, which the eight steps oxidize. The cofactors `atp`, `adp` (mM) and `nad_ratio`
# (NAD+/NADH) drive regulation and are not modified: the caller applies the flux to its pools. The rates come from the
# concentrations at the start of the tick; the steps then apply in cycle order, each transfer capped at the pool it
# drains. PDH is capped at the pyruvate passed in, so `pyruvate_consumed <= pyruvate` and the caller can subtract it
# without clamping. No pool goes negative and no carbon is created for any dt. A non-finite or non-positive dt is "no
# time passed" (the state untouched, a zero flux); a NaN, infinite or negative input counts as 0. Rust recommends
# dt <= 0.1 s. Mirrors `TcaState::tick`.
fn ry_tca_state_tick(p: *RyTcaState, c: *RyTcaConfig, pyruvate_in: f64, atp_in: f64, adp_in: f64, nad_in: f64,
  dt: f64, out: *RyTcaFlux) {
    if (_ry_guard_valid_dt(dt) == 0) {
        memset(out, 0, 112);
        return 0;
    }
    var pyruvate: f64 = _ry_guard_conc(pyruvate_in);
    var atp: f64 = _ry_guard_conc(atp_in);
    var adp: f64 = _ry_guard_conc(adp_in);
    var nad_ratio: f64 = _ry_guard_conc(nad_in);
    var acetyl_coa: f64 = p.acetyl_coa;
    if (_ry_trace_on() == 1) {
        var h[24];
        var b[256];
        var e = _ry_ev(&h, &b, 256, "rasayan::tca", "tca_tick");
        _ry_ev_f(e, "dt", dt);
        _ry_ev_f(e, "pyruvate", pyruvate);
        _ry_ev_f(e, "atp", atp);
        _ry_ev_f(e, "acetyl_coa", acetyl_coa);
        _ry_trace(e);
    }
    var citrate: f64 = p.citrate;
    var isocitrate: f64 = p.isocitrate;
    var alpha_kg: f64 = p.alpha_kg;
    var succinyl_coa: f64 = p.succinyl_coa;
    var succinate: f64 = p.succinate;
    var fumarate: f64 = p.fumarate;
    var malate: f64 = p.malate;
    var oxaloacetate: f64 = p.oxaloacetate;

    # ── the shared factors ──
    var nad_scaled: f64 = nad_ratio / RY_RESTING_NAD_RATIO;
    var nad_factor: f64 = _ry_min(nad_scaled, RY_MAX_NAD_FACTOR);
    var eps: f64 = 0x3CB0000000000000;           # f64::EPSILON
    var ratio: f64 = RY_MAX_ATP_ADP_RATIO;
    if (adp > eps) { ratio = atp / adp; }
    var q: f64 = ratio / c.energy_half_inhibition;
    var energy_inhibition: f64 = 1.0 / (1.0 + q * q);   # `powi(2)`: one multiply

    # ── the rates (mM/s), from the state at the start of the tick ──
    # Step 0, PDH: product inhibition by acetyl-CoA (the E2 subunit's acetyl-CoA/CoA control, the Randle cycle's
    # brake that matches PDH to the cycle's capacity).
    var accoa_inhibition: f64 = 1.0 / (1.0 + acetyl_coa / RY_TCA_PDH_KI_ACETYL_COA);
    var pdh_factor: f64 = energy_inhibition * nad_factor * accoa_inhibition;
    var pdh_vmax: f64 = c.pdh_vmax * pdh_factor;
    var v_pdh: f64 = ry_michaelis_menten(pyruvate, pdh_vmax, c.pdh_km_pyruvate);
    # Step 1, citrate synthase: inhibited by its product and by the energy charge (its square root).
    var cs_base: f64 = ry_sequential_bisubstrate(oxaloacetate, acetyl_coa, c.cs_vmax, c.cs_km_oaa, c.cs_km_accoa,
      c.cs_ki_oaa);
    var ei_root: f64 = f64_sqrt(energy_inhibition);
    var cs_inhibition: f64 = 1.0 / (1.0 + citrate / c.cs_ki_citrate) * ei_root;
    var v1: f64 = cs_base * cs_inhibition;
    # Step 2, aconitase.
    var v2: f64 = ry_reversible_michaelis_menten(citrate, isocitrate, c.acon_vmax_f, c.acon_km_f, c.acon_vmax_r,
      c.acon_km_r);
    # Step 3, isocitrate dehydrogenase: Hill kinetics, activated by ADP up to its maximum fold.
    var adp_term: f64 = 1.0 + adp / c.idh_adp_ka;
    var idh_activation: f64 = _ry_min(adp_term, c.idh_adp_max_activation);
    var idh_vmax: f64 = c.idh_vmax * energy_inhibition * nad_factor * idh_activation;
    var v3: f64 = ry_hill_equation(isocitrate, idh_vmax, c.idh_km_isocitrate, c.idh_hill_n);
    # Step 4, α-KG dehydrogenase: competitive product inhibition by succinyl-CoA.
    var kgdh_vmax: f64 = c.kgdh_vmax * energy_inhibition * nad_factor;
    var v4: f64 = ry_competitive_inhibition(alpha_kg, succinyl_coa, kgdh_vmax, c.kgdh_km_akg, c.kgdh_ki_succoa);
    # Steps 5 and 6, succinyl-CoA synthetase and succinate dehydrogenase.
    var v5: f64 = ry_michaelis_menten(succinyl_coa, c.scs_vmax, c.scs_km);
    var v6: f64 = ry_michaelis_menten(succinate, c.sdh_vmax, c.sdh_km);
    # Step 7, fumarase.
    var v7: f64 = ry_reversible_michaelis_menten(fumarate, malate, c.fum_vmax_f, c.fum_km_f, c.fum_vmax_r, c.fum_km_r);
    # Step 8, malate dehydrogenase: unfavorable (ΔG°' > 0), pulled forward by low OAA and citrate synthase; NAD+ scales
    # the forward rate, and a low NAD+ speeds the reverse (its factor floored at 0.1).
    var mdh_vmax_f: f64 = c.mdh_vmax_f * nad_factor;
    var nad_floor: f64 = _ry_max(nad_factor, 0.1);
    var mdh_vmax_r: f64 = c.mdh_vmax_r / nad_floor;
    var v8: f64 = ry_reversible_michaelis_menten(malate, oxaloacetate, mdh_vmax_f, c.mdh_km_f, mdh_vmax_r, c.mdh_km_r);

    # ── Euler, step by step in cycle order, each transfer capped at the pool it drains ──
    var a_pdh: f64 = _ry_guard_take(v_pdh * dt, pyruvate);
    acetyl_coa = acetyl_coa + a_pdh;
    var cs_pool: f64 = _ry_min(oxaloacetate, acetyl_coa);   # citrate synthase consumes one of each
    var a1: f64 = _ry_guard_take(v1 * dt, cs_pool);
    oxaloacetate = oxaloacetate - a1;
    acetyl_coa = acetyl_coa - a1;
    citrate = citrate + a1;
    var a2: f64 = _ry_guard_shift(v2 * dt, citrate, isocitrate);
    citrate = citrate - a2;
    isocitrate = isocitrate + a2;
    var a3: f64 = _ry_guard_take(v3 * dt, isocitrate);
    isocitrate = isocitrate - a3;
    alpha_kg = alpha_kg + a3;
    var a4: f64 = _ry_guard_take(v4 * dt, alpha_kg);
    alpha_kg = alpha_kg - a4;
    succinyl_coa = succinyl_coa + a4;
    var a5: f64 = _ry_guard_take(v5 * dt, succinyl_coa);
    succinyl_coa = succinyl_coa - a5;
    succinate = succinate + a5;
    var a6: f64 = _ry_guard_take(v6 * dt, succinate);
    succinate = succinate - a6;
    fumarate = fumarate + a6;
    var a7: f64 = _ry_guard_shift(v7 * dt, fumarate, malate);
    fumarate = fumarate - a7;
    malate = malate + a7;
    var a8: f64 = _ry_guard_shift(v8 * dt, malate, oxaloacetate);
    malate = malate - a8;
    oxaloacetate = oxaloacetate + a8;
    p.acetyl_coa = acetyl_coa;
    p.citrate = citrate;
    p.isocitrate = isocitrate;
    p.alpha_kg = alpha_kg;
    p.succinyl_coa = succinyl_coa;
    p.succinate = succinate;
    p.fumarate = fumarate;
    p.malate = malate;
    p.oxaloacetate = oxaloacetate;

    # ── the flux: the amounts actually moved ──
    var inv_dt: f64 = 1.0 / dt;
    out.pyruvate_consumed = a_pdh;
    out.nadh_produced = a_pdh + a3 + a4 + a8;
    out.fadh2_produced = a6;
    out.gtp_produced = a5;
    out.co2_produced = a_pdh + a3 + a4;
    out.rate_pdh = a_pdh * inv_dt;
    out.rate_cs = a1 * inv_dt;
    out.rate_acon = a2 * inv_dt;
    out.rate_idh = a3 * inv_dt;
    out.rate_kgdh = a4 * inv_dt;
    out.rate_scs = a5 * inv_dt;
    out.rate_sdh = a6 * inv_dt;
    out.rate_fum = a7 * inv_dt;
    out.rate_mdh = a8 * inv_dt;
    return 0;
}

# ── pools ──

# The total of the cycle intermediates (mM), acetyl-CoA excluded. The cycle itself keeps it (each turn regenerates
# OAA); only anaplerotic and cataplerotic inputs change it. Mirrors `TcaState::total_pool`.
#must_use
#pure
fn ry_tca_state_total_pool(p: *RyTcaState): f64 {
    var r: f64 = p.citrate + p.isocitrate + p.alpha_kg + p.succinyl_coa + p.succinate + p.fumarate + p.malate
    + p.oxaloacetate;
    return r;
}

# Adds a sub-step's flux `o` into the tick total `t`: the amounts summed, the per-second rates weighted by `weight`
# (the sub-step over the tick's length). Mirrors the crate-private `TcaFlux::accumulate`.
fn _ry_tca_flux_accumulate(t: *RyTcaFlux, o: *RyTcaFlux, weight: f64) {
    var wt = t;
    var wo = o;
    var k = 0;
    while (k < 5) {
        var x: f64 = load64(wt + 8 * k);
        var y: f64 = load64(wo + 8 * k);
        var s: f64 = x + y;
        store64(wt + 8 * k, load64(&s));
        k = k + 1;
    }
    while (k < 14) {
        var r: f64 = load64(wt + 8 * k);
        var q: f64 = load64(wo + 8 * k);
        var u: f64 = r + q * weight;
        store64(wt + 8 * k, load64(&u));
        k = k + 1;
    }
    return 0;
}

# ── JSON (P7: serde_json's documents) ──

# Appends TcaState `p` as serde_json writes it, `{"acetyl_coa":…,…,"oxaloacetate":…}`, on allocator `a`: Ok(0), or
# Err(RY_ERR_OUT_OF_MEMORY) when the builder could not grow.
#must_use
fn ry_tca_state_to_json_a(a, sb, p: *RyTcaState): Result {
    if (_ry_jw_f64_fields(a, sb, p, 9, &_RY_TCA_STATE_FIELDS) != 0) { return Err(RY_ERR_OUT_OF_MEMORY); }
    return Ok(0);
}

# ry_tca_state_to_json_a on the default allocator (a builder from str_builder_new).
#must_use
fn ry_tca_state_to_json(sb, p: *RyTcaState): Result {
    return ry_tca_state_to_json_a(default_alloc(), sb, p);
}

# The TcaState at node `v` of a parsed document, by serde's rules (as ry_tca_state_from_json_a reads it), into the 72
# bytes at `w`: 1, or 0 for a refusal (what `w` holds then is unspecified). The metabolic network's readers call it for
# their nested values.
#must_use
fn _ry_tca_state_from_node(v, w): i64 {
    return _ry_jr_f64_fields(v, w, 9, &_RY_TCA_STATE_FIELDS);
}

# Reads a TcaState from the `n`-byte document at `buf` by serde's rules (its tree on allocator `a`, which the caller
# resets): Ok(0) with *out filled, or Err(RY_ERR_DESERIALIZE).
#must_use
fn ry_tca_state_from_json_a(a, buf, n, out: *RyTcaState): Result {
    var w[72];
    var v = _ry_jr_parse(a, buf, n);
    if (_ry_tca_state_from_node(v, &w) == 0) {
        return Err(_ry_fail_text(RY_ERR_DESERIALIZE, "TcaState", 8));
    }
    memcpy(out, &w, 72);
    return Ok(0);
}

# ry_tca_state_from_json_a on the default allocator (the tree is never freed: for a one-off read).
#must_use
fn ry_tca_state_from_json(buf, n, out: *RyTcaState): Result {
    return ry_tca_state_from_json_a(default_alloc(), buf, n, out);
}

# Appends TcaConfig `p` as serde_json writes it, its 32 fields in declaration order, on allocator `a`: Ok(0), or
# Err(RY_ERR_OUT_OF_MEMORY).
#must_use
fn ry_tca_config_to_json_a(a, sb, p: *RyTcaConfig): Result {
    if (_ry_jw_f64_fields(a, sb, p, 32, &_RY_TCA_CONFIG_FIELDS) != 0) { return Err(RY_ERR_OUT_OF_MEMORY); }
    return Ok(0);
}

# ry_tca_config_to_json_a on the default allocator.
#must_use
fn ry_tca_config_to_json(sb, p: *RyTcaConfig): Result {
    return ry_tca_config_to_json_a(default_alloc(), sb, p);
}

# The TcaConfig at node `v` of a parsed document, by serde's rules (as ry_tca_config_from_json_a reads it), into the 256
# bytes at `w`: 1, or 0 for a refusal (what `w` holds then is unspecified). The metabolic network's readers call it for
# their nested values.
#must_use
fn _ry_tca_config_from_node(v, w): i64 {
    return _ry_jr_f64_fields(v, w, 32, &_RY_TCA_CONFIG_FIELDS);
}

# Reads a TcaConfig from the `n`-byte document at `buf` by serde's rules (its tree on allocator `a`): Ok(0) with *out
# filled, or Err(RY_ERR_DESERIALIZE).
#must_use
fn ry_tca_config_from_json_a(a, buf, n, out: *RyTcaConfig): Result {
    var w[256];
    var v = _ry_jr_parse(a, buf, n);
    if (_ry_tca_config_from_node(v, &w) == 0) {
        return Err(_ry_fail_text(RY_ERR_DESERIALIZE, "TcaConfig", 9));
    }
    memcpy(out, &w, 256);
    return Ok(0);
}

# ry_tca_config_from_json_a on the default allocator (the tree is never freed: for a one-off read).
#must_use
fn ry_tca_config_from_json(buf, n, out: *RyTcaConfig): Result {
    return ry_tca_config_from_json_a(default_alloc(), buf, n, out);
}

# Appends TcaFlux `f` as serde_json writes it, `{"pyruvate_consumed":…,…,"co2_produced":…,"step_rates":[…]}` (the nine
# rates as one array), on allocator `a`: Ok(0), or Err(RY_ERR_OUT_OF_MEMORY).
#must_use
fn ry_tca_flux_to_json_a(a, sb, f: *RyTcaFlux): Result {
    var w = f;
    var e = _ry_jw_byte(a, sb, 123);
    var name = _RY_TCA_FLUX_FIELDS;
    var k = 0;
    while (k < 5) {
        var first = 0;
        if (k == 0) { first = 1; }
        e = e | _ry_jw_key(a, sb, name, first);
        var x: f64 = load64(w + 8 * k);
        e = e | _ry_jw_f64(a, sb, x);
        name = name + strlen(name) + 1;
        k = k + 1;
    }
    e = e | _ry_jw_key(a, sb, "step_rates", 0);
    e = e | _ry_jw_f64_array(a, sb, w + 40, 9);
    e = e | _ry_jw_byte(a, sb, 125);
    if (e != 0) { return Err(RY_ERR_OUT_OF_MEMORY); }
    return Ok(0);
}

# ry_tca_flux_to_json_a on the default allocator.
#must_use
fn ry_tca_flux_to_json(sb, f: *RyTcaFlux): Result {
    return ry_tca_flux_to_json_a(default_alloc(), sb, f);
}

# The TcaFlux at node `v` of a parsed document, by serde's rules (as ry_tca_flux_from_json_a reads it), into the 112
# bytes at `w`: 1, or 0 for a refusal (what `w` holds then is unspecified). The metabolic network's readers call it for
# their nested values.
#must_use
fn _ry_tca_flux_from_node(v, w): i64 {
    var form = _ry_jr_form(v, 6);
    var ok = 0;
    if (form != 0) {
        ok = 1;
        var name = _RY_TCA_FLUX_FIELDS;
        var k = 0;
        while (k < 5 && ok == 1) {
            if (_ry_jr_f64(_ry_jr_at(v, form, k, name), w + 8 * k) == 0) { ok = 0; }
            name = name + strlen(name) + 1;
            k = k + 1;
        }
        if (ok == 1 && _ry_jr_f64_array(_ry_jr_at(v, form, 5, "step_rates"), w + 40, 9) == 0) { ok = 0; }
    }
    return ok;
}

# Reads a TcaFlux from the `n`-byte document at `buf` by serde's rules (an object by field name, or an array of its six
# fields; `step_rates` an array of exactly nine numbers), its tree on allocator `a`: Ok(0) with *out filled, or
# Err(RY_ERR_DESERIALIZE).
#must_use
fn ry_tca_flux_from_json_a(a, buf, n, out: *RyTcaFlux): Result {
    var w[112];
    var v = _ry_jr_parse(a, buf, n);
    if (_ry_tca_flux_from_node(v, &w) == 0) {
        return Err(_ry_fail_text(RY_ERR_DESERIALIZE, "TcaFlux", 7));
    }
    memcpy(out, &w, 112);
    return Ok(0);
}

# ry_tca_flux_from_json_a on the default allocator (the tree is never freed: for a one-off read).
#must_use
fn ry_tca_flux_from_json(buf, n, out: *RyTcaFlux): Result {
    return ry_tca_flux_from_json_a(default_alloc(), buf, n, out);
}

# --- etc_data.cyr ---

# rasayan — etc data: the default state and kinetic parameters
#
# GENERATED from rasayan 1.2.0's source (rust-old/, the functional spec, read as text). Do not edit.
# Checked: python3 -I -B scripts/oracle/validate.py . (every value against that source)
#
# EtcState::default() and EtcConfig::default(), from rasayan 1.2.0: one
# f64 const per field, as a round-trip decimal, checked against the `Self { … }` literals
# of `impl Default for EtcState` / `for EtcConfig`.
# tests/golden/etc.tsv pins them.

# Internal state of the electron transport chain.
#
# Tracks the proton motive force and electron carrier pools that couple
# substrate oxidation to ATP synthesis.
# Rust: rasayan::etc::EtcState::default()

# Proton motive force across inner mitochondrial membrane (normalized 0.0-1.0).
# Built by complexes I/III/IV, consumed by ATP synthase and proton leak.
# Rust: rasayan::etc::EtcState::default().pmf
const RY_ETC_ETC_STATE_DEFAULT_PMF = 0.6;

# Fraction of ubiquinone pool in reduced form QH2 (0.0-1.0).
# Increased by complexes I and II, decreased by complex III.
# Rust: rasayan::etc::EtcState::default().qh2_fraction
const RY_ETC_ETC_STATE_DEFAULT_QH2_FRACTION = 0.3;

# Fraction of cytochrome c pool in reduced form (0.0-1.0).
# Increased by complex III, decreased by complex IV.
# Rust: rasayan::etc::EtcState::default().cytc_reduced
const RY_ETC_ETC_STATE_DEFAULT_CYTC_REDUCED = 0.2;

# EtcState's field names, NUL-separated, in declaration order.
var _RY_ETC_STATE_FIELDS: u8[30] = {
    112, 109, 102, 0,  # pmf
    113, 104, 50, 95, 102, 114, 97, 99, 116, 105, 111, 110, 0,  # qh2_fraction
    99, 121, 116, 99, 95, 114, 101, 100, 117, 99, 101, 100, 0,  # cytc_reduced
};

# Kinetic parameters for the electron transport chain.
#
# Vmax values in mM/s. Default values produce physiologically reasonable
# ATP output (~2.5 ATP/NADH, ~1.5 ATP/FADH2) under resting conditions.
# Rust: rasayan::etc::EtcConfig::default()

# Complex I (NADH dehydrogenase) Vmax (mM/s).
# Rust: rasayan::etc::EtcConfig::default().complex_i_vmax
const RY_ETC_ETC_CONFIG_DEFAULT_COMPLEX_I_VMAX = 3.5;

# Complex II (succinate dehydrogenase) Vmax (mM/s).
# Rust: rasayan::etc::EtcConfig::default().complex_ii_vmax
const RY_ETC_ETC_CONFIG_DEFAULT_COMPLEX_II_VMAX = 0.5;

# Complex III (cytochrome bc1) Vmax (mM/s).
# Rust: rasayan::etc::EtcConfig::default().complex_iii_vmax
const RY_ETC_ETC_CONFIG_DEFAULT_COMPLEX_III_VMAX = 6.0;

# Complex IV (cytochrome c oxidase) Vmax (mM/s).
# Rust: rasayan::etc::EtcConfig::default().complex_iv_vmax
const RY_ETC_ETC_CONFIG_DEFAULT_COMPLEX_IV_VMAX = 7.0;

# Complex IV Km for O2 (normalized, ~0.01 = high affinity).
# Rust: rasayan::etc::EtcConfig::default().complex_iv_km_o2
const RY_ETC_ETC_CONFIG_DEFAULT_COMPLEX_IV_KM_O2 = 0.01;

# ATP synthase (Complex V) Vmax (mM/s).
# Rust: rasayan::etc::EtcConfig::default().atp_synthase_vmax
const RY_ETC_ETC_CONFIG_DEFAULT_ATP_SYNTHASE_VMAX = 3.3;

# Minimum pmf for ATP synthase to operate (threshold).
# Rust: rasayan::etc::EtcConfig::default().atp_synthase_pmf_threshold
const RY_ETC_ETC_CONFIG_DEFAULT_ATP_SYNTHASE_PMF_THRESHOLD = 0.3;

# ATP synthase Km for ADP (mM).
# Rust: rasayan::etc::EtcConfig::default().atp_synthase_km_adp
const RY_ETC_ETC_CONFIG_DEFAULT_ATP_SYNTHASE_KM_ADP = 0.1;

# Proton leak rate constant (s^-1). Basal uncoupling.
# Rust: rasayan::etc::EtcConfig::default().proton_leak_rate
const RY_ETC_ETC_CONFIG_DEFAULT_PROTON_LEAK_RATE = 0.05;

# H+ equivalents dissipated per unit leak rate. Converts leak flux to H+ units.
# Rust: rasayan::etc::EtcConfig::default().proton_leak_h_per_unit
const RY_ETC_ETC_CONFIG_DEFAULT_PROTON_LEAK_H_PER_UNIT = 10.0;

# Proton pool capacity (mM equivalent). Normalizes H+ flux to pmf units.
# Higher values = more sluggish pmf response.
# Rust: rasayan::etc::EtcConfig::default().pmf_capacity
const RY_ETC_ETC_CONFIG_DEFAULT_PMF_CAPACITY = 100.0;

# H+ pumped per NADH oxidized (CI=4 + CIII=4 + CIV=2 = 10).
# Complex I pumps `h_per_nadh − h_per_fadh2`.
# Rust: rasayan::etc::EtcConfig::default().h_per_nadh
const RY_ETC_ETC_CONFIG_DEFAULT_H_PER_NADH = 10.0;

# H+ pumped per FADH2 oxidized (CII=0 + CIII=4 + CIV=2 = 6).
# Split 4:2 between Complexes III and IV.
# Rust: rasayan::etc::EtcConfig::default().h_per_fadh2
const RY_ETC_ETC_CONFIG_DEFAULT_H_PER_FADH2 = 6.0;

# H+ consumed per ATP synthesized (~2.7 at the synthase + 1 for
# ADP/Pi transport).
# Rust: rasayan::etc::EtcConfig::default().h_per_atp
const RY_ETC_ETC_CONFIG_DEFAULT_H_PER_ATP = 4.0;

# EtcConfig's field names, NUL-separated, in declaration order.
var _RY_ETC_CONFIG_FIELDS: u8[232] = {
    99, 111, 109, 112, 108, 101, 120, 95, 105, 95, 118, 109, 97, 120, 0,  # complex_i_vmax
    99, 111, 109, 112, 108, 101, 120, 95, 105, 105, 95, 118, 109, 97, 120, 0,  # complex_ii_vmax
    99, 111, 109, 112, 108, 101, 120, 95, 105, 105, 105, 95, 118, 109, 97, 120, 0,  # complex_iii_vmax
    99, 111, 109, 112, 108, 101, 120, 95, 105, 118, 95, 118, 109, 97, 120, 0,  # complex_iv_vmax
    99, 111, 109, 112, 108, 101, 120, 95, 105, 118, 95, 107, 109, 95, 111, 50, 0,  # complex_iv_km_o2
    97, 116, 112, 95, 115, 121, 110, 116, 104, 97, 115, 101, 95, 118, 109, 97, 120, 0,  # atp_synthase_vmax
    97, 116, 112, 95, 115, 121, 110, 116, 104, 97, 115, 101, 95, 112, 109, 102,  # atp_synthase_pmf_threshold
    95, 116, 104, 114, 101, 115, 104, 111, 108, 100, 0,
    97, 116, 112, 95, 115, 121, 110, 116, 104, 97, 115, 101, 95, 107, 109, 95, 97, 100, 112, 0,  # atp_synthase_km_adp
    112, 114, 111, 116, 111, 110, 95, 108, 101, 97, 107, 95, 114, 97, 116, 101, 0,  # proton_leak_rate
    112, 114, 111, 116, 111, 110, 95, 108, 101, 97, 107, 95, 104, 95, 112, 101,  # proton_leak_h_per_unit
    114, 95, 117, 110, 105, 116, 0,
    112, 109, 102, 95, 99, 97, 112, 97, 99, 105, 116, 121, 0,  # pmf_capacity
    104, 95, 112, 101, 114, 95, 110, 97, 100, 104, 0,  # h_per_nadh
    104, 95, 112, 101, 114, 95, 102, 97, 100, 104, 50, 0,  # h_per_fadh2
    104, 95, 112, 101, 114, 95, 97, 116, 112, 0,  # h_per_atp
};

# --- etc.cyr ---

# etc.cyr — the electron transport chain: oxidative phosphorylation, NADH and FADH2 oxidized through Complexes I–IV
# to build the proton motive force that drives ATP synthase, with respiratory control (Rust 1.2.0's `etc.rs`,
# transcribed).
#
#     NADH → [Complex I] → Q → [Complex III] → Cyt c → [Complex IV] → O2 → H2O
#     FADH2 → [Complex II] → Q ↗                          ↓ H+ pumped
#                                                  proton motive force (pmf)
#                                                          ↓
#                                                  [ATP synthase] → ATP
#
# Per NADH 10 H+ are pumped (CI 4, CIII 4, CIV 2) for ~2.5 ATP; per FADH2 6 (CIII 4, CIV 2) for ~1.5 ATP; per ATP ~3.7
# H+ are consumed (the synthase and the ADP/Pi carriers), lumped as `h_per_atp` = 4; per O2, 4 e⁻ make 2 H2O. The
# per-complex split comes from `h_per_nadh` and `h_per_fadh2`. Every complex rate is in electron-pair
# (NADH-equivalent) units, and the Q and cytochrome c pools are reduced fractions in the same units (an implicit 1 mM
# pool). NADH enters Complex I by Michaelis-Menten kinetics in its concentration (RY_ETC_COMPLEX_I_KM_NADH);
# FAD-linked electrons are not a free pool: the `fadh2` input is the electron pairs delivered this step, which enter Q
# up to Complex II's capacity and the oxidized-Q room left.
#
# Every operation is in Rust's order (P9): tests/golden/etc.tsv compares each method with the oracle's at ≤ 2 ulp
# (class B, expected 0: nothing here calls a transcendental) and bit for bit over the trajectory scripts and Rust's
# full respiration pipeline (class T).
#
# The Cyrius forms (ADR 0002 rows 7, 10, 14), as glycolysis's:
# - EtcState, EtcConfig and EtcFlux are structs of f64 (RyEtcState, RyEtcConfig, RyEtcFlux); the tick updates the
#   state in place and fills the caller's flux: `ry_etc_state_tick(&s, &c, nadh, fadh2, oxygen, adp, dt, &flux)`;
# - the flux's `complex_rates: [f64; 5]` is five consecutive fields (`rate_ci` … `rate_civ`, `rate_atp_synthase`,
#   Rust's index order); ry_etc_flux_complex_rates(&flux) is their address, the array view;
# - `impl Default` is `ry_etc_state_default(&out)` / `ry_etc_config_default(&out)` from the generated consts
#   (src/etc_data.cyr), and the derived `EtcFlux::default()` is ry_etc_flux_default(&out);
# - the crate-private items the metabolic network calls (M5): `EtcDrive` is the private struct _RyEtcDrive,
#   `EtcState::step` _ry_etc_state_step(&s, &c, &drive, dt, &flux), `complex_i_capacity`
#   _ry_etc_state_complex_i_capacity, `EtcFlux::accumulate` _ry_etc_flux_accumulate; the private
#   `EtcConfig::pump_stoichiometry` is _ry_etc_config_pump_stoichiometry, its tuple a three-value return;
# - Rust's `tracing::trace!` event (`etc_tick`) is a level-gated sakshi event under the target `rasayan::etc`, its
#   fields in Rust's order;
# - each serde type's codec is `ry_<type>_to_json` / `_from_json` (and `_a`, on an allocator).

# The ETC's internal state: the proton motive force across the inner mitochondrial membrane (normalized to [0, 1]:
# built by Complexes I, III and IV, used by ATP synthase and the proton leak), the reduced fraction of the ubiquinone
# pool (QH2: raised by Complexes I and II, lowered by III) and of cytochrome c (raised by III, lowered by IV). Rust's
# `EtcState`.
struct RyEtcState {
    pmf: f64;
    qh2_fraction: f64;
    cytc_reduced: f64;
}

# The ETC's kinetic parameters: the five Vmax (mM/s), Complex IV's Km for O2 (normalized), ATP synthase's pmf threshold
# and Km for ADP, the proton leak (rate constant and H+ per unit), the proton pool's capacity, and the H+ per NADH, per
# FADH2 and per ATP. Rust's `EtcConfig`.
struct RyEtcConfig {
    complex_i_vmax: f64;
    complex_ii_vmax: f64;
    complex_iii_vmax: f64;
    complex_iv_vmax: f64;
    complex_iv_km_o2: f64;
    atp_synthase_vmax: f64;
    atp_synthase_pmf_threshold: f64;
    atp_synthase_km_adp: f64;
    proton_leak_rate: f64;
    proton_leak_h_per_unit: f64;
    pmf_capacity: f64;
    h_per_nadh: f64;
    h_per_fadh2: f64;
    h_per_atp: f64;
}

# One tick's flux through the ETC (mM), for the caller to apply to its pools: NADH and FADH2 consumed (never more than
# passed in), O2 consumed (½ per electron pair), ATP produced (never more than the ADP passed in), H2O produced (twice
# the O2); then each complex's effective rate (mM/s, electron pairs for CI–CIV), the amount it moved divided by dt.
# Rust's `EtcFlux`.
struct RyEtcFlux {
    nadh_consumed: f64;
    fadh2_consumed: f64;
    o2_consumed: f64;
    atp_produced: f64;
    h2o_produced: f64;
    rate_ci: f64;
    rate_cii: f64;
    rate_ciii: f64;
    rate_civ: f64;
    rate_atp_synthase: f64;
}

# The inputs of one ETC step: the NADH concentration Complex I's rate is evaluated at and the NADH it may consume at
# most (mM), the FAD-linked electron pairs delivered this step (mM), O2 availability (0–1) and ADP for ATP synthase
# (mM). Mirrors the crate-private `EtcDrive`.
struct _RyEtcDrive {
    nadh_conc: f64;
    nadh_avail: f64;
    fadh2: f64;
    oxygen: f64;
    adp: f64;
}

# EtcFlux's five amounts' names, NUL-separated, in Rust's declaration order (JSON); the state's and the config's are
# generated (_RY_ETC_STATE_FIELDS, _RY_ETC_CONFIG_FIELDS, src/etc_data.cyr).
var _RY_ETC_FLUX_FIELDS = "nadh_consumed\0fadh2_consumed\0o2_consumed\0atp_produced\0h2o_produced\0";

# Each config field's rule in EtcConfig::validate, in declaration order: `v` finite and >= 0 (the Vmax, the leak, H+
# per FADH2 and per ATP), `k` a divisor (finite, > 0), `f` the ATP synthase threshold (in [0, 1)), `a` H+ per NADH (at
# least H+ per FADH2). Rust checks every `v`, then every `k`, then the threshold, then H+ per NADH.
var _RY_ETC_CONFIG_RULES = "vvvvkvfkvvkavv";

# ── defaults ──

# Fills *out with the resting chain: pmf 0.6, QH2 0.3, reduced cytochrome c 0.2 (RY_ETC_ETC_STATE_DEFAULT_*). Mirrors
# `EtcState::default()`.
fn ry_etc_state_default(out: *RyEtcState) {
    out.pmf = RY_ETC_ETC_STATE_DEFAULT_PMF;
    out.qh2_fraction = RY_ETC_ETC_STATE_DEFAULT_QH2_FRACTION;
    out.cytc_reduced = RY_ETC_ETC_STATE_DEFAULT_CYTC_REDUCED;
    return 0;
}

# Fills *out with parameters giving ~2.5 ATP per NADH and ~1.5 per FADH2 at rest (RY_ETC_ETC_CONFIG_DEFAULT_*).
# Mirrors `EtcConfig::default()`.
fn ry_etc_config_default(out: *RyEtcConfig) {
    out.complex_i_vmax = RY_ETC_ETC_CONFIG_DEFAULT_COMPLEX_I_VMAX;
    out.complex_ii_vmax = RY_ETC_ETC_CONFIG_DEFAULT_COMPLEX_II_VMAX;
    out.complex_iii_vmax = RY_ETC_ETC_CONFIG_DEFAULT_COMPLEX_III_VMAX;
    out.complex_iv_vmax = RY_ETC_ETC_CONFIG_DEFAULT_COMPLEX_IV_VMAX;
    out.complex_iv_km_o2 = RY_ETC_ETC_CONFIG_DEFAULT_COMPLEX_IV_KM_O2;
    out.atp_synthase_vmax = RY_ETC_ETC_CONFIG_DEFAULT_ATP_SYNTHASE_VMAX;
    out.atp_synthase_pmf_threshold = RY_ETC_ETC_CONFIG_DEFAULT_ATP_SYNTHASE_PMF_THRESHOLD;
    out.atp_synthase_km_adp = RY_ETC_ETC_CONFIG_DEFAULT_ATP_SYNTHASE_KM_ADP;
    out.proton_leak_rate = RY_ETC_ETC_CONFIG_DEFAULT_PROTON_LEAK_RATE;
    out.proton_leak_h_per_unit = RY_ETC_ETC_CONFIG_DEFAULT_PROTON_LEAK_H_PER_UNIT;
    out.pmf_capacity = RY_ETC_ETC_CONFIG_DEFAULT_PMF_CAPACITY;
    out.h_per_nadh = RY_ETC_ETC_CONFIG_DEFAULT_H_PER_NADH;
    out.h_per_fadh2 = RY_ETC_ETC_CONFIG_DEFAULT_H_PER_FADH2;
    out.h_per_atp = RY_ETC_ETC_CONFIG_DEFAULT_H_PER_ATP;
    return 0;
}

# Fills *out with the zero flux (every field +0). Mirrors the derived `EtcFlux::default()`.
fn ry_etc_flux_default(out: *RyEtcFlux) {
    memset(out, 0, 80);
    return 0;
}

# The address of the flux's five complex rates, `rate_ci` … `rate_atp_synthase`: Rust's `complex_rates: [f64; 5]`
# ([CI, CII, CIII, CIV, ATP synthase]), index i at `+ 8 * i`.
#must_use
#pure
fn ry_etc_flux_complex_rates(f: *RyEtcFlux): i64 {
    var w = f;                                   # a plain address: `f + n` would step n · 80 bytes
    return w + 40;
}

# ── validation ──

# Ok(0) when every field is finite and in [0, 1]; else the first failing field's `_ry_guard_fraction` Err
# (RY_ERR_NON_FINITE or RY_ERR_INVALID_PARAMETER), in declaration order. Mirrors `EtcState::validate`.
#must_use
fn ry_etc_state_validate(p: *RyEtcState): Result {
    var w = p;                                   # a plain address: `p + n` would step n · 24 bytes
    var name = &_RY_ETC_STATE_FIELDS;
    var k = 0;
    while (k < 3) {
        var value: f64 = load64(w + 8 * k);
        var t, v = _ry_guard_fraction(name, value);
        if (is_err_result(t) == 1) { return Err(v); }
        name = name + strlen(name) + 1;
        k = k + 1;
    }
    return Ok(0);
}

# The first refusal among config fields whose rule is `rule` (`v` or `k`, _RY_ETC_CONFIG_RULES), in declaration order:
# Ok(0), or the guard's Err.
fn _ry_etc_config_check(p: *RyEtcConfig, rule): Result {
    var w = p;                                   # a plain address: `p + n` would step n · 112 bytes
    var name = &_RY_ETC_CONFIG_FIELDS;
    var k = 0;
    while (k < 14) {
        if (load8(_RY_ETC_CONFIG_RULES + k) == rule) {
            var value: f64 = load64(w + 8 * k);
            if (rule == 118) {
                var t, v = _ry_guard_non_negative(name, value);
                if (is_err_result(t) == 1) { return Err(v); }
            } else {
                var tp, vp = _ry_guard_positive(name, value);
                if (is_err_result(tp) == 1) { return Err(vp); }
            }
        }
        name = name + strlen(name) + 1;
        k = k + 1;
    }
    return Ok(0);
}

# Ok(0) when every parameter is physically meaningful: the Vmax, the leak and the H+ per FADH2 and per ATP finite and
# >= 0 (else RY_ERR_NON_FINITE or RY_ERR_NEGATIVE_CONCENTRATION); complex_iv_km_o2, atp_synthase_km_adp and
# pmf_capacity, divisors, finite and > 0 (RY_ERR_INVALID_PARAMETER); atp_synthase_pmf_threshold in [0, 1) (the drive
# is normalized by 1 − threshold); h_per_nadh at least h_per_fadh2 (Complex I pumps the difference). Checked in that
# order. Mirrors `EtcConfig::validate`.
#must_use
fn ry_etc_config_validate(p: *RyEtcConfig): Result {
    var t1, v1 = _ry_etc_config_check(p, 118);
    if (is_err_result(t1) == 1) { return Err(v1); }
    var t2, v2 = _ry_etc_config_check(p, 107);
    if (is_err_result(t2) == 1) { return Err(v2); }
    var threshold: f64 = p.atp_synthase_pmf_threshold;
    var t3, v3 = _ry_guard_fraction("atp_synthase_pmf_threshold", threshold);
    if (is_err_result(t3) == 1) { return Err(v3); }
    if (threshold >= 1.0) {
        var code = _ry_fail_f(RY_ERR_INVALID_PARAMETER, "atp_synthase_pmf_threshold", threshold, "must be < 1", 0, 0.0);
        return Err(code);
    }
    var per_nadh: f64 = p.h_per_nadh;
    var per_fadh2: f64 = p.h_per_fadh2;
    var t4, v4 = _ry_guard_at_least("h_per_nadh", per_nadh, per_fadh2);
    if (is_err_result(t4) == 1) { return Err(v4); }
    return Ok(0);
}

# The H+ pumped per electron pair by Complexes I, III and IV, (ci, ciii, civ), from h_per_nadh and h_per_fadh2:
# Complex I pumps their difference, III and IV share h_per_fadh2 4:2 (the defaults 10 / 6 give exactly 4 / 4 / 2).
# Each is floored at 0 (Rust's `.max(0.0)`, NaN to 0). Mirrors the private `EtcConfig::pump_stoichiometry`.
#must_use
#pure
fn _ry_etc_config_pump_stoichiometry(c: *RyEtcConfig): (f64, f64, f64) {
    var per_nadh: f64 = c.h_per_nadh;
    var per_fadh2: f64 = c.h_per_fadh2;
    var d: f64 = per_nadh - per_fadh2;
    var ci: f64 = _ry_max(d, 0.0);
    var third: f64 = per_fadh2 / 3.0;
    var civ: f64 = _ry_max(third, 0.0);
    var rest: f64 = per_fadh2 - civ;
    var ciii: f64 = _ry_max(rest, 0.0);
    return (ci, ciii, civ);
}

# ── the step ──

# Complex I's first-order capacity this step, `complex_i_vmax × oxidized Q × (1 − pmf)` (mM/s at saturating NADH),
# from the sanitized state; the metabolic network uses it to solve its NADH pool implicitly. Mirrors the
# crate-private `EtcState::complex_i_capacity`.
#must_use
#pure
fn _ry_etc_state_complex_i_capacity(p: *RyEtcState, c: *RyEtcConfig): f64 {
    var q_in: f64 = p.qh2_fraction;
    var pmf_in: f64 = p.pmf;
    var q: f64 = _ry_guard_unit(q_in);
    var pmf: f64 = _ry_guard_unit(pmf_in);
    var q_available: f64 = 1.0 - q;
    var pumping_capacity: f64 = 1.0 - pmf;
    var vmax_in: f64 = c.complex_i_vmax;
    var vmax: f64 = _ry_guard_conc(vmax_in);
    var r: f64 = vmax * q_available * pumping_capacity;
    return r;
}

# One ETC step of `dt` seconds with Complex I's rate evaluated at `d.nadh_conc` but its consumption capped at
# `d.nadh_avail`, filling *out with the flux. ry_etc_state_tick passes the same value for both; the metabolic network
# passes its implicit end-of-step NADH concentration and the pool plus this step's production, which makes Complex I
# consume exactly the backward-Euler amount, stable for any dt. Mirrors the crate-private `EtcState::step`.
fn _ry_etc_state_step(p: *RyEtcState, c: *RyEtcConfig, d: *_RyEtcDrive, dt: f64, out: *RyEtcFlux) {
    if (_ry_guard_valid_dt(dt) == 0) {
        memset(out, 0, 80);
        return 0;
    }
    var nc_in: f64 = d.nadh_conc;
    var na_in: f64 = d.nadh_avail;
    var fa_in: f64 = d.fadh2;
    var o_in: f64 = d.oxygen;
    var adp_in: f64 = d.adp;
    var nadh_conc: f64 = _ry_guard_conc(nc_in);
    var nadh_avail: f64 = _ry_guard_conc(na_in);
    var fadh2: f64 = _ry_guard_conc(fa_in);
    var oxygen: f64 = _ry_guard_unit(o_in);
    var adp: f64 = _ry_guard_conc(adp_in);
    var pmf_in: f64 = p.pmf;
    if (_ry_trace_on() == 1) {
        var h[24];
        var b[256];
        var e = _ry_ev(&h, &b, 256, "rasayan::etc", "etc_tick");
        _ry_ev_f(e, "dt", dt);
        _ry_ev_f(e, "nadh_conc", nadh_conc);
        _ry_ev_f(e, "fadh2", fadh2);
        _ry_ev_f(e, "oxygen", oxygen);
        _ry_ev_f(e, "pmf", pmf_in);
        _ry_trace(e);
    }
    # Sanitized copies of the state: a NaN or out-of-range field (set directly by a caller) cannot poison the update.
    var pmf: f64 = _ry_guard_unit(pmf_in);
    var q_in: f64 = p.qh2_fraction;
    var cytc_in: f64 = p.cytc_reduced;
    var qh2: f64 = _ry_guard_unit(q_in);
    var cytc: f64 = _ry_guard_unit(cytc_in);
    # Respiratory control: a high pmf opposes proton pumping (thermodynamic backpressure).
    var pumping_capacity: f64 = 1.0 - pmf;
    var ci_h, ciii_h, civ_h = _ry_etc_config_pump_stoichiometry(c);

    # ── the rates (mM/s, electron pairs), from the start-of-tick state ──
    # Complex I: Michaelis-Menten in NADH, scaled by oxidized Q and the backpressure.
    var q_available: f64 = 1.0 - qh2;
    var nadh_saturation: f64 = nadh_conc / (RY_ETC_COMPLEX_I_KM_NADH + nadh_conc);
    var v_ci: f64 = c.complex_i_vmax * nadh_saturation * q_available * pumping_capacity;
    # Complex II / ETF: the FAD-linked pairs delivered enter Q up to Complex II's capacity (no pump, no backpressure).
    var cii_capacity: f64 = c.complex_ii_vmax * q_available * dt;
    # Complex III: QH2 → 2 cyt c.
    var cytc_oxidized: f64 = 1.0 - cytc;
    var v_ciii: f64 = c.complex_iii_vmax * qh2 * cytc_oxidized * pumping_capacity;
    # Complex IV: 2 cyt c → ½ O2 → H2O; a high O2 affinity.
    var o2_factor: f64 = oxygen / (c.complex_iv_km_o2 + oxygen);
    var v_civ: f64 = c.complex_iv_vmax * cytc * o2_factor * pumping_capacity;
    # ATP synthase: needs the pmf above its threshold, and ADP.
    var threshold: f64 = c.atp_synthase_pmf_threshold;
    var pmf_drive: f64 = 0.0;
    if (pmf > threshold) { pmf_drive = (pmf - threshold) / (1.0 - threshold); }
    var adp_factor: f64 = adp / (c.atp_synthase_km_adp + adp);
    var v_atp: f64 = c.atp_synthase_vmax * pmf_drive * adp_factor;
    # The proton leak (uncoupling).
    var v_leak: f64 = c.proton_leak_rate * pmf;

    # ── capped transfers: each carrier pool's consumers run before its producers ──
    var a_civ: f64 = _ry_guard_take(v_civ * dt, cytc);
    cytc = cytc - a_civ;
    var cytc_room: f64 = 1.0 - cytc;
    var ciii_pool: f64 = _ry_min(qh2, cytc_room);
    var a_ciii: f64 = _ry_guard_take(v_ciii * dt, ciii_pool);
    qh2 = qh2 - a_ciii;
    cytc = cytc + a_ciii;
    var q_room: f64 = 1.0 - qh2;
    var ci_pool: f64 = _ry_min(nadh_avail, q_room);
    var a_ci: f64 = _ry_guard_take(v_ci * dt, ci_pool);
    qh2 = qh2 + a_ci;
    var cii_in: f64 = _ry_min(fadh2, cii_capacity);
    var q_left: f64 = 1.0 - qh2;
    var a_cii: f64 = _ry_guard_take(cii_in, q_left);
    qh2 = qh2 + a_cii;
    # The proton motive force: pumping adds H+; the synthase and the leak remove them, capped at what is there.
    var h_pumped: f64 = a_ci * ci_h + a_ciii * ciii_h + a_civ * civ_h;
    var h_available: f64 = pmf * c.pmf_capacity + h_pumped;
    var a_atp: f64 = _ry_guard_take(v_atp * dt, adp);
    var leak: f64 = v_leak * dt * c.proton_leak_h_per_unit;
    var h_leak: f64 = _ry_guard_conc(leak);
    var h_demand: f64 = a_atp * c.h_per_atp + h_leak;
    if (h_demand > h_available) {
        var scale: f64 = h_available / h_demand;
        a_atp = a_atp * scale;
        h_leak = h_leak * scale;
    }
    var h_consumed: f64 = a_atp * c.h_per_atp + h_leak;
    var new_pmf: f64 = pmf + (h_pumped - h_consumed) / c.pmf_capacity;
    # Capping keeps every pool in range; `unit` only absorbs rounding.
    var pmf_out: f64 = _ry_guard_unit(new_pmf);
    var qh2_out: f64 = _ry_guard_unit(qh2);
    var cytc_out: f64 = _ry_guard_unit(cytc);
    p.pmf = pmf_out;
    p.qh2_fraction = qh2_out;
    p.cytc_reduced = cytc_out;

    # ── the flux: the amounts actually moved; one pair at CIV reduces ½ O2 to one H2O ──
    var o2_consumed: f64 = 0.5 * a_civ;
    var inv_dt: f64 = 1.0 / dt;
    out.nadh_consumed = a_ci;
    out.fadh2_consumed = a_cii;
    out.o2_consumed = o2_consumed;
    out.atp_produced = a_atp;
    out.h2o_produced = 2.0 * o2_consumed;
    out.rate_ci = a_ci * inv_dt;
    out.rate_cii = a_cii * inv_dt;
    out.rate_ciii = a_ciii * inv_dt;
    out.rate_civ = a_civ * inv_dt;
    out.rate_atp_synthase = a_atp * inv_dt;
    return 0;
}

# Advances the ETC by `dt` seconds (explicit Euler) and fills *out with the flux. NADH and FADH2 (from glycolysis and
# the TCA cycle) are oxidized through the complexes, building the proton gradient that drives ATP synthesis;
# respiratory control emerges: a high pmf opposes further pumping, slowing electron flow when ATP demand is low. The
# rates come from the state at the start of the tick; each transfer is then capped at what it drains (Complex I at
# `nadh` and oxidized Q, Complex II at `fadh2`, its capacity and oxidized Q, Complex III at QH2 and oxidized cyt c,
# Complex IV at reduced cyt c, ATP synthase at `adp` and the protons available), so electrons are conserved for any dt
# (in = out + stored in Q and cyt c) and the three fractions stay in [0, 1]. A non-finite or non-positive dt is "no
# time passed" (the state untouched, a zero flux); a NaN or negative `nadh`, `fadh2` or `adp` counts as 0, and
# `oxygen` is mapped into [0, 1] (NaN to 0). Rust recommends dt <= 0.1 s. Mirrors `EtcState::tick`.
fn ry_etc_state_tick(p: *RyEtcState, c: *RyEtcConfig, nadh_in: f64, fadh2: f64, oxygen: f64, adp: f64, dt: f64,
  out: *RyEtcFlux) {
    var d: _RyEtcDrive;
    var nadh: f64 = _ry_guard_conc(nadh_in);
    d.nadh_conc = nadh;
    d.nadh_avail = nadh;
    d.fadh2 = fadh2;
    d.oxygen = oxygen;
    d.adp = adp;
    return _ry_etc_state_step(p, c, &d, dt, out);
}

# Adds a sub-step's flux `o` into the tick total `t`: the amounts summed, the per-second rates weighted by `weight`
# (the sub-step over the tick's length). Mirrors the crate-private `EtcFlux::accumulate`.
fn _ry_etc_flux_accumulate(t: *RyEtcFlux, o: *RyEtcFlux, weight: f64) {
    var wt = t;
    var wo = o;
    var k = 0;
    while (k < 5) {
        var x: f64 = load64(wt + 8 * k);
        var y: f64 = load64(wo + 8 * k);
        var s: f64 = x + y;
        store64(wt + 8 * k, load64(&s));
        k = k + 1;
    }
    while (k < 10) {
        var r: f64 = load64(wt + 8 * k);
        var q: f64 = load64(wo + 8 * k);
        var u: f64 = r + q * weight;
        store64(wt + 8 * k, load64(&u));
        k = k + 1;
    }
    return 0;
}

# ── JSON (P7: serde_json's documents) ──

# Appends EtcState `p` as serde_json writes it, `{"pmf":…,"qh2_fraction":…,"cytc_reduced":…}`, on allocator `a`:
# Ok(0), or Err(RY_ERR_OUT_OF_MEMORY) when the builder could not grow.
#must_use
fn ry_etc_state_to_json_a(a, sb, p: *RyEtcState): Result {
    if (_ry_jw_f64_fields(a, sb, p, 3, &_RY_ETC_STATE_FIELDS) != 0) { return Err(RY_ERR_OUT_OF_MEMORY); }
    return Ok(0);
}

# ry_etc_state_to_json_a on the default allocator (a builder from str_builder_new).
#must_use
fn ry_etc_state_to_json(sb, p: *RyEtcState): Result {
    return ry_etc_state_to_json_a(default_alloc(), sb, p);
}

# The EtcState at node `v` of a parsed document, by serde's rules (as ry_etc_state_from_json_a reads it), into the 24
# bytes at `w`: 1, or 0 for a refusal (what `w` holds then is unspecified). The metabolic network's readers call it for
# their nested values.
#must_use
fn _ry_etc_state_from_node(v, w): i64 {
    return _ry_jr_f64_fields(v, w, 3, &_RY_ETC_STATE_FIELDS);
}

# Reads an EtcState from the `n`-byte document at `buf` by serde's rules (its tree on allocator `a`, which the caller
# resets): Ok(0) with *out filled, or Err(RY_ERR_DESERIALIZE). Serde reads any f64: a fraction outside [0, 1] is
# validate's to refuse.
#must_use
fn ry_etc_state_from_json_a(a, buf, n, out: *RyEtcState): Result {
    var w[24];
    var v = _ry_jr_parse(a, buf, n);
    if (_ry_etc_state_from_node(v, &w) == 0) {
        return Err(_ry_fail_text(RY_ERR_DESERIALIZE, "EtcState", 8));
    }
    memcpy(out, &w, 24);
    return Ok(0);
}

# ry_etc_state_from_json_a on the default allocator (the tree is never freed: for a one-off read).
#must_use
fn ry_etc_state_from_json(buf, n, out: *RyEtcState): Result {
    return ry_etc_state_from_json_a(default_alloc(), buf, n, out);
}

# Appends EtcConfig `p` as serde_json writes it, its 14 fields in declaration order, on allocator `a`: Ok(0), or
# Err(RY_ERR_OUT_OF_MEMORY).
#must_use
fn ry_etc_config_to_json_a(a, sb, p: *RyEtcConfig): Result {
    if (_ry_jw_f64_fields(a, sb, p, 14, &_RY_ETC_CONFIG_FIELDS) != 0) { return Err(RY_ERR_OUT_OF_MEMORY); }
    return Ok(0);
}

# ry_etc_config_to_json_a on the default allocator.
#must_use
fn ry_etc_config_to_json(sb, p: *RyEtcConfig): Result {
    return ry_etc_config_to_json_a(default_alloc(), sb, p);
}

# The EtcConfig at node `v` of a parsed document, by serde's rules (as ry_etc_config_from_json_a reads it), into the 112
# bytes at `w`: 1, or 0 for a refusal (what `w` holds then is unspecified). The metabolic network's readers call it for
# their nested values.
#must_use
fn _ry_etc_config_from_node(v, w): i64 {
    return _ry_jr_f64_fields(v, w, 14, &_RY_ETC_CONFIG_FIELDS);
}

# Reads an EtcConfig from the `n`-byte document at `buf` by serde's rules (its tree on allocator `a`): Ok(0) with *out
# filled, or Err(RY_ERR_DESERIALIZE).
#must_use
fn ry_etc_config_from_json_a(a, buf, n, out: *RyEtcConfig): Result {
    var w[112];
    var v = _ry_jr_parse(a, buf, n);
    if (_ry_etc_config_from_node(v, &w) == 0) {
        return Err(_ry_fail_text(RY_ERR_DESERIALIZE, "EtcConfig", 9));
    }
    memcpy(out, &w, 112);
    return Ok(0);
}

# ry_etc_config_from_json_a on the default allocator (the tree is never freed: for a one-off read).
#must_use
fn ry_etc_config_from_json(buf, n, out: *RyEtcConfig): Result {
    return ry_etc_config_from_json_a(default_alloc(), buf, n, out);
}

# Appends EtcFlux `f` as serde_json writes it, `{"nadh_consumed":…,…,"h2o_produced":…,"complex_rates":[…]}` (the five
# rates as one array), on allocator `a`: Ok(0), or Err(RY_ERR_OUT_OF_MEMORY).
#must_use
fn ry_etc_flux_to_json_a(a, sb, f: *RyEtcFlux): Result {
    var w = f;
    var e = _ry_jw_byte(a, sb, 123);
    var name = _RY_ETC_FLUX_FIELDS;
    var k = 0;
    while (k < 5) {
        var first = 0;
        if (k == 0) { first = 1; }
        e = e | _ry_jw_key(a, sb, name, first);
        var x: f64 = load64(w + 8 * k);
        e = e | _ry_jw_f64(a, sb, x);
        name = name + strlen(name) + 1;
        k = k + 1;
    }
    e = e | _ry_jw_key(a, sb, "complex_rates", 0);
    e = e | _ry_jw_f64_array(a, sb, w + 40, 5);
    e = e | _ry_jw_byte(a, sb, 125);
    if (e != 0) { return Err(RY_ERR_OUT_OF_MEMORY); }
    return Ok(0);
}

# ry_etc_flux_to_json_a on the default allocator.
#must_use
fn ry_etc_flux_to_json(sb, f: *RyEtcFlux): Result {
    return ry_etc_flux_to_json_a(default_alloc(), sb, f);
}

# The EtcFlux at node `v` of a parsed document, by serde's rules (as ry_etc_flux_from_json_a reads it), into the 80
# bytes at `w`: 1, or 0 for a refusal (what `w` holds then is unspecified). The metabolic network's readers call it for
# their nested values.
#must_use
fn _ry_etc_flux_from_node(v, w): i64 {
    var form = _ry_jr_form(v, 6);
    var ok = 0;
    if (form != 0) {
        ok = 1;
        var name = _RY_ETC_FLUX_FIELDS;
        var k = 0;
        while (k < 5 && ok == 1) {
            if (_ry_jr_f64(_ry_jr_at(v, form, k, name), w + 8 * k) == 0) { ok = 0; }
            name = name + strlen(name) + 1;
            k = k + 1;
        }
        if (ok == 1 && _ry_jr_f64_array(_ry_jr_at(v, form, 5, "complex_rates"), w + 40, 5) == 0) { ok = 0; }
    }
    return ok;
}

# Reads an EtcFlux from the `n`-byte document at `buf` by serde's rules (an object by field name, or an array of its six
# fields; `complex_rates` an array of exactly five numbers), its tree on allocator `a`: Ok(0) with *out filled, or
# Err(RY_ERR_DESERIALIZE).
#must_use
fn ry_etc_flux_from_json_a(a, buf, n, out: *RyEtcFlux): Result {
    var w[80];
    var v = _ry_jr_parse(a, buf, n);
    if (_ry_etc_flux_from_node(v, &w) == 0) {
        return Err(_ry_fail_text(RY_ERR_DESERIALIZE, "EtcFlux", 7));
    }
    memcpy(out, &w, 80);
    return Ok(0);
}

# ry_etc_flux_from_json_a on the default allocator (the tree is never freed: for a one-off read).
#must_use
fn ry_etc_flux_from_json(buf, n, out: *RyEtcFlux): Result {
    return ry_etc_flux_from_json_a(default_alloc(), buf, n, out);
}

# --- beta_oxidation_data.cyr ---

# rasayan — beta_oxidation data: the default pools and kinetic parameters
#
# GENERATED from rasayan 1.2.0's source (rust-old/, the functional spec, read as text). Do not edit.
# Checked: python3 -I -B scripts/oracle/validate.py . (every value against that source)
#
# BetaOxState::default() and BetaOxConfig::default(), from rasayan 1.2.0: one const
# per field (an f64 as a round-trip decimal, chain_length's u32 as an integer), checked
# against the `Self { … }` literals of `impl Default for BetaOxState` / `for BetaOxConfig`.
# tests/golden/beta_oxidation.tsv pins them.

# State of the beta-oxidation pathway.
#
# Tracks the pool of fatty acyl-CoA available for oxidation.
# Concentrations are in palmitate equivalents (C16) by default.
# Rust: rasayan::beta_oxidation::BetaOxState::default()

# Long-chain fatty acyl-CoA pool (mM).
# This is the activated form ready for mitochondrial import.
# Rust: rasayan::beta_oxidation::BetaOxState::default().acyl_coa
const RY_BETA_OXIDATION_BETA_OX_STATE_DEFAULT_ACYL_COA = 0.02;

# Free fatty acid pool (mM). Requires activation before oxidation.
# Rust: rasayan::beta_oxidation::BetaOxState::default().free_fatty_acid
const RY_BETA_OXIDATION_BETA_OX_STATE_DEFAULT_FREE_FATTY_ACID = 0.3;

# BetaOxState's field names, NUL-separated, in declaration order.
var _RY_BETA_OX_STATE_FIELDS: u8[25] = {
    97, 99, 121, 108, 95, 99, 111, 97, 0,  # acyl_coa
    102, 114, 101, 101, 95, 102, 97, 116, 116, 121, 95, 97, 99, 105, 100, 0,  # free_fatty_acid
};

# Kinetic parameters for fatty acid beta-oxidation.
#
# Default values model palmitate (C16) oxidation under physiological
# conditions. Adjust `chain_length` for other fatty acids.
# Rust: rasayan::beta_oxidation::BetaOxConfig::default()

# Carbon chain length of the fatty acid (must be even, >= 4).
# Default: 16 (palmitate).
# Rust: rasayan::beta_oxidation::BetaOxConfig::default().chain_length
const RY_BETA_OXIDATION_BETA_OX_CONFIG_DEFAULT_CHAIN_LENGTH = 16;

# Fatty acid activation Vmax (mM/s). Acyl-CoA synthetase.
# Rust: rasayan::beta_oxidation::BetaOxConfig::default().activation_vmax
const RY_BETA_OXIDATION_BETA_OX_CONFIG_DEFAULT_ACTIVATION_VMAX = 0.05;

# Activation Km for free fatty acid (mM).
# Rust: rasayan::beta_oxidation::BetaOxConfig::default().activation_km
const RY_BETA_OXIDATION_BETA_OX_CONFIG_DEFAULT_ACTIVATION_KM = 0.1;

# Beta-oxidation cycle Vmax (mM acyl-CoA processed per second).
# Rust: rasayan::beta_oxidation::BetaOxConfig::default().cycle_vmax
const RY_BETA_OXIDATION_BETA_OX_CONFIG_DEFAULT_CYCLE_VMAX = 0.03;

# Beta-oxidation Km for acyl-CoA (mM).
# Rust: rasayan::beta_oxidation::BetaOxConfig::default().cycle_km
const RY_BETA_OXIDATION_BETA_OX_CONFIG_DEFAULT_CYCLE_KM = 0.01;

# CPT-I Ki for malonyl-CoA inhibition (mM).
# Malonyl-CoA (high in fed state) blocks fatty acid import into mitochondria.
# Rust: rasayan::beta_oxidation::BetaOxConfig::default().cpt1_ki_malonyl_coa
const RY_BETA_OXIDATION_BETA_OX_CONFIG_DEFAULT_CPT1_KI_MALONYL_COA = 0.01;

# BetaOxConfig's field names, NUL-separated, in declaration order.
var _RY_BETA_OX_CONFIG_FIELDS: u8[83] = {
    99, 104, 97, 105, 110, 95, 108, 101, 110, 103, 116, 104, 0,  # chain_length
    97, 99, 116, 105, 118, 97, 116, 105, 111, 110, 95, 118, 109, 97, 120, 0,  # activation_vmax
    97, 99, 116, 105, 118, 97, 116, 105, 111, 110, 95, 107, 109, 0,  # activation_km
    99, 121, 99, 108, 101, 95, 118, 109, 97, 120, 0,  # cycle_vmax
    99, 121, 99, 108, 101, 95, 107, 109, 0,  # cycle_km
    99, 112, 116, 49, 95, 107, 105, 95, 109, 97, 108, 111, 110, 121, 108, 95, 99, 111, 97, 0,  # cpt1_ki_malonyl_coa
};

# Metabolic flux through beta-oxidation for a single tick.
#
# Returned by [`BetaOxState::tick`]. Contains cofactor accounting that
# the caller should apply to their pools.
# BetaOxFlux's field names, NUL-separated, in declaration order.
var _RY_BETA_OX_FLUX_FIELDS: u8[124] = {
    102, 102, 97, 95, 99, 111, 110, 115, 117, 109, 101, 100, 0,  # ffa_consumed
    97, 99, 121, 108, 95, 99, 111, 97, 95, 99, 111, 110, 115, 117, 109, 101, 100, 0,  # acyl_coa_consumed
    97, 99, 101, 116, 121, 108, 95, 99, 111, 97, 95, 112, 114, 111, 100, 117, 99, 101, 100, 0,  # acetyl_coa_produced
    110, 97, 100, 104, 95, 112, 114, 111, 100, 117, 99, 101, 100, 0,  # nadh_produced
    102, 97, 100, 104, 50, 95, 112, 114, 111, 100, 117, 99, 101, 100, 0,  # fadh2_produced
    97, 116, 112, 95, 99, 111, 110, 115, 117, 109, 101, 100, 0,  # atp_consumed
    111, 120, 105, 100, 97, 116, 105, 111, 110, 95, 114, 97, 116, 101, 0,  # oxidation_rate
    97, 99, 116, 105, 118, 97, 116, 105, 111, 110, 95, 114, 97, 116, 101, 0,  # activation_rate
};

# --- beta_oxidation.cyr ---

# beta_oxidation.cyr — β-oxidation of fatty acids: activation of free fatty acid to acyl-CoA, CPT-I's import (gated by
# malonyl-CoA), and the spiral that shortens the chain by two carbons a cycle into acetyl-CoA, NADH and FADH2 (Rust
# 1.2.0's `beta_oxidation.rs`, transcribed).
#
#     Fatty acid + CoA + 2 ATP → Fatty acyl-CoA    (activation, cytoplasm)
#                        ↓ CPT-I (regulated by malonyl-CoA)
#     Acyl-CoA(Cn) → Acyl-CoA(Cn-2) + Acetyl-CoA + NADH + FADH2   (repeated n/2 − 1 times; the last thiolysis → 2)
#
# Palmitate (C16): 7 cycles, 8 acetyl-CoA, 7 NADH, 7 FADH2, 2 ATP to activate (~106 ATP by full oxidation). The spiral
# is one effective step a tick: each acyl-CoA consumed gives all its products at once. validate accepts only even
# chains >= 4; a tick on an odd chain still conserves carbon, reporting `chain_length / 2` acetyl-CoA carbon-equivalents
# per acyl-CoA (the terminal propionyl-CoA as 1.5, since the flux has no field for it), while NADH and FADH2 follow
# ry_beta_ox_config_cycles. Concentrations in mM (palmitate equivalents), time in seconds.
#
# Every operation is in Rust's order (P9): tests/golden/beta_oxidation.tsv compares each method with the oracle's at
# ≤ 2 ulp (class B, expected 0: nothing here calls a transcendental) and bit for bit over the trajectory scripts and
# Rust's β-oxidation-to-TCA coupling (class T).
#
# The Cyrius forms (ADR 0002 rows 7, 10), as the other pathways':
# - BetaOxState, BetaOxConfig and BetaOxFlux are structs (RyBetaOxState, RyBetaOxConfig, RyBetaOxFlux; the config's
#   `chain_length: u32` an integer word, the rest f64); the tick updates the state in place and fills the caller's
#   flux: `ry_beta_ox_state_tick(&s, &c, malonyl_coa, nad_ratio, dt, &flux)`;
# - `impl Default` is `ry_beta_ox_state_default(&out)` / `ry_beta_ox_config_default(&out)` from the generated consts
#   (src/beta_oxidation_data.cyr), and the derived `BetaOxFlux::default()` is ry_beta_ox_flux_default(&out);
# - the private `BetaOxConfig::acetyl_carbon_equivalents` is _ry_beta_ox_config_acetyl_carbon_equivalents, and the
#   crate-private `BetaOxFlux::accumulate` the metabolic network calls (M5) _ry_beta_ox_flux_accumulate;
# - Rust's `tracing::trace!` event (`beta_oxidation_tick`) is a level-gated sakshi event under the target
#   `rasayan::beta_oxidation`, its fields in Rust's order;
# - each serde type's codec is `ry_<type>_to_json` / `_from_json` (and `_a`, on an allocator); `chain_length` is a JSON
#   integer in u32's range; the three types' field names are generated (src/beta_oxidation_data.cyr).

# The β-oxidation pools (mM): the long-chain fatty acyl-CoA ready for mitochondrial import, and the free fatty acid
# that must be activated first. Rust's `BetaOxState`.
struct RyBetaOxState {
    acyl_coa: f64;
    free_fatty_acid: f64;
}

# The kinetic parameters: the fatty acid's carbon chain length (a u32: even, >= 4; 16, palmitate, by default),
# acyl-CoA synthetase's Vmax and Km, the β-oxidation cycle's Vmax and Km, and CPT-I's Ki for malonyl-CoA (high in the
# fed state, which blocks fatty acid import). Rust's `BetaOxConfig`.
struct RyBetaOxConfig {
    chain_length;
    activation_vmax: f64;
    activation_km: f64;
    cycle_vmax: f64;
    cycle_km: f64;
    cpt1_ki_malonyl_coa: f64;
}

# One tick's flux through β-oxidation (mM), for the caller to apply to its pools: free fatty acid and acyl-CoA
# consumed, acetyl-CoA produced (`chain_length / 2` per acyl-CoA), NADH and FADH2 produced (one each per cycle), ATP
# consumed by activation (2 per fatty acid), then the effective oxidation and activation rates (mM/s). Rust's
# `BetaOxFlux`.
struct RyBetaOxFlux {
    ffa_consumed: f64;
    acyl_coa_consumed: f64;
    acetyl_coa_produced: f64;
    nadh_produced: f64;
    fadh2_produced: f64;
    atp_consumed: f64;
    oxidation_rate: f64;
    activation_rate: f64;
}

# ── defaults ──

# Fills *out with the resting pools: acyl-CoA 0.02, free fatty acid 0.3 mM (RY_BETA_OXIDATION_BETA_OX_STATE_DEFAULT_*).
# Mirrors `BetaOxState::default()`.
fn ry_beta_ox_state_default(out: *RyBetaOxState) {
    out.acyl_coa = RY_BETA_OXIDATION_BETA_OX_STATE_DEFAULT_ACYL_COA;
    out.free_fatty_acid = RY_BETA_OXIDATION_BETA_OX_STATE_DEFAULT_FREE_FATTY_ACID;
    return 0;
}

# Fills *out with palmitate's parameters under physiological conditions (RY_BETA_OXIDATION_BETA_OX_CONFIG_DEFAULT_*).
# Mirrors `BetaOxConfig::default()`.
fn ry_beta_ox_config_default(out: *RyBetaOxConfig) {
    out.chain_length = RY_BETA_OXIDATION_BETA_OX_CONFIG_DEFAULT_CHAIN_LENGTH;
    out.activation_vmax = RY_BETA_OXIDATION_BETA_OX_CONFIG_DEFAULT_ACTIVATION_VMAX;
    out.activation_km = RY_BETA_OXIDATION_BETA_OX_CONFIG_DEFAULT_ACTIVATION_KM;
    out.cycle_vmax = RY_BETA_OXIDATION_BETA_OX_CONFIG_DEFAULT_CYCLE_VMAX;
    out.cycle_km = RY_BETA_OXIDATION_BETA_OX_CONFIG_DEFAULT_CYCLE_KM;
    out.cpt1_ki_malonyl_coa = RY_BETA_OXIDATION_BETA_OX_CONFIG_DEFAULT_CPT1_KI_MALONYL_COA;
    return 0;
}

# Fills *out with the zero flux (every field +0). Mirrors the derived `BetaOxFlux::default()`.
fn ry_beta_ox_flux_default(out: *RyBetaOxFlux) {
    memset(out, 0, 64);
    return 0;
}

# ── the chain ──

# The number of β-oxidation cycles for the chain length, `chain_length / 2 − 1` (palmitate 7; an odd chain's
# `(n − 3) / 2` too, its last thiolysis giving propionyl-CoA), 0 below 4. Mirrors `BetaOxConfig::cycles`.
#must_use
#pure
fn ry_beta_ox_config_cycles(c: *RyBetaOxConfig): i64 {
    var n = c.chain_length;
    if (n >= 4) { return n / 2 - 1; }
    return 0;
}

# The acetyl-CoA units per fatty acid, `chain_length / 2` (palmitate 8), 0 below 4: exact for the even chains validate
# accepts (an odd chain's integer division counts the propionyl-CoA as one unit; a tick reports carbon-equivalents
# instead). Mirrors `BetaOxConfig::acetyl_coa_per_fa`.
#must_use
#pure
fn ry_beta_ox_config_acetyl_coa_per_fa(c: *RyBetaOxConfig): i64 {
    var n = c.chain_length;
    if (n >= 4) { return n / 2; }
    return 0;
}

# The acetyl-CoA carbon-equivalents per acyl-CoA oxidized, `chain_length / 2` as an f64 (equal to
# ry_beta_ox_config_acetyl_coa_per_fa for an even chain; 7.5 for C15, conserving its carbon). Mirrors the private
# `BetaOxConfig::acetyl_carbon_equivalents`.
#must_use
#pure
fn _ry_beta_ox_config_acetyl_carbon_equivalents(c: *RyBetaOxConfig): f64 {
    var n: f64 = f64_from(c.chain_length);
    var r: f64 = n / 2.0;
    return r;
}

# ── validation ──

# Ok(0) when both pools are finite and >= 0; else the first failing one's `_ry_guard_non_negative` Err
# (RY_ERR_NON_FINITE or RY_ERR_NEGATIVE_CONCENTRATION). Mirrors `BetaOxState::validate`.
#must_use
fn ry_beta_ox_state_validate(p: *RyBetaOxState): Result {
    var acyl: f64 = p.acyl_coa;
    var ffa: f64 = p.free_fatty_acid;
    var t1, v1 = _ry_guard_non_negative("acyl_coa", acyl);
    if (is_err_result(t1) == 1) { return Err(v1); }
    var t2, v2 = _ry_guard_non_negative("free_fatty_acid", ffa);
    if (is_err_result(t2) == 1) { return Err(v2); }
    return Ok(0);
}

# Ok(0) when every parameter is physically meaningful: the chain length even and >= 4 (else RY_ERR_INVALID_PARAMETER:
# an odd chain ends in propionyl-CoA, which the model has no output for); the two Vmax finite and >= 0; activation_km,
# cycle_km and cpt1_ki_malonyl_coa, divisors, finite and > 0. Checked in that order. Mirrors `BetaOxConfig::validate`.
#must_use
fn ry_beta_ox_config_validate(p: *RyBetaOxConfig): Result {
    var n = p.chain_length;
    if (n < 4 || n % 2 != 0) {
        var nf: f64 = f64_from(n);
        var code = _ry_fail_f(RY_ERR_INVALID_PARAMETER, "chain_length", nf, "must be even and >= 4", 0, 0.0);
        return Err(code);
    }
    var av: f64 = p.activation_vmax;
    var cv: f64 = p.cycle_vmax;
    var ak: f64 = p.activation_km;
    var ck: f64 = p.cycle_km;
    var ki: f64 = p.cpt1_ki_malonyl_coa;
    var t1, v1 = _ry_guard_non_negative("activation_vmax", av);
    if (is_err_result(t1) == 1) { return Err(v1); }
    var t2, v2 = _ry_guard_non_negative("cycle_vmax", cv);
    if (is_err_result(t2) == 1) { return Err(v2); }
    var t3, v3 = _ry_guard_positive("activation_km", ak);
    if (is_err_result(t3) == 1) { return Err(v3); }
    var t4, v4 = _ry_guard_positive("cycle_km", ck);
    if (is_err_result(t4) == 1) { return Err(v4); }
    var t5, v5 = _ry_guard_positive("cpt1_ki_malonyl_coa", ki);
    if (is_err_result(t5) == 1) { return Err(v5); }
    return Ok(0);
}

# ── the tick ──

# Advances β-oxidation by `dt` seconds and fills *out with the flux: free fatty acid is activated to acyl-CoA (2 ATP
# each), and acyl-CoA is oxidized to acetyl-CoA, NADH and FADH2, its rate gated by CPT-I (malonyl-CoA's inhibition, the
# fed state's brake on fat burning) and scaled by the NAD+/NADH factor. Activation is capped at the free fatty acid
# and oxidation at the acyl-CoA (including what was activated this tick), so no pool goes negative and no carbon is
# created for any dt. A non-finite or non-positive dt is "no time passed" (the state untouched, a zero flux); a NaN,
# infinite or negative `malonyl_coa` or `nad_ratio` counts as 0. Mirrors `BetaOxState::tick`.
fn ry_beta_ox_state_tick(p: *RyBetaOxState, c: *RyBetaOxConfig, malonyl_in: f64, nad_in: f64, dt: f64,
  out: *RyBetaOxFlux) {
    if (_ry_guard_valid_dt(dt) == 0) {
        memset(out, 0, 64);
        return 0;
    }
    var malonyl_coa: f64 = _ry_guard_conc(malonyl_in);
    var nad_ratio: f64 = _ry_guard_conc(nad_in);
    var acyl: f64 = p.acyl_coa;
    var ffa: f64 = p.free_fatty_acid;
    if (_ry_trace_on() == 1) {
        var h[24];
        var b[256];
        var e = _ry_ev(&h, &b, 256, "rasayan::beta_oxidation", "beta_oxidation_tick");
        _ry_ev_f(e, "dt", dt);
        _ry_ev_f(e, "acyl_coa", acyl);
        _ry_ev_f(e, "ffa", ffa);
        _ry_trace(e);
    }
    var nad_scaled: f64 = nad_ratio / RY_RESTING_NAD_RATIO;
    var nad_factor: f64 = _ry_min(nad_scaled, RY_MAX_NAD_FACTOR);
    var cycles: f64 = f64_from(ry_beta_ox_config_cycles(c));
    var accoa_per_fa: f64 = _ry_beta_ox_config_acetyl_carbon_equivalents(c);
    # Activation: FFA + 2 ATP → acyl-CoA.
    var v_activation: f64 = ry_michaelis_menten(ffa, c.activation_vmax, c.activation_km);
    # CPT-I: malonyl-CoA's inhibition of mitochondrial import, the key regulatory step.
    var ki: f64 = c.cpt1_ki_malonyl_coa;
    var cpt1_factor: f64 = 1.0;
    if (ki > 0.0) { cpt1_factor = 1.0 / (1.0 + malonyl_coa / ki); }
    # The β-oxidation cycle, limited by acyl-CoA, the CPT-I gate and NAD+.
    var cycle_vmax: f64 = c.cycle_vmax * cpt1_factor * nad_factor;
    var v_oxidation: f64 = ry_michaelis_menten(acyl, cycle_vmax, c.cycle_km);
    # The pools, each transfer capped at the pool it drains.
    var activated: f64 = _ry_guard_take(v_activation * dt, ffa);
    ffa = ffa - activated;
    acyl = acyl + activated;
    var oxidized: f64 = _ry_guard_take(v_oxidation * dt, acyl);
    acyl = acyl - oxidized;
    p.acyl_coa = acyl;
    p.free_fatty_acid = ffa;
    # The flux: the amounts actually moved.
    out.ffa_consumed = activated;
    out.acyl_coa_consumed = oxidized;
    out.acetyl_coa_produced = oxidized * accoa_per_fa;
    out.nadh_produced = oxidized * cycles;
    out.fadh2_produced = oxidized * cycles;
    out.atp_consumed = activated * 2.0;
    out.oxidation_rate = oxidized / dt;
    out.activation_rate = activated / dt;
    return 0;
}

# Adds a sub-step's flux `o` into the tick total `t`: the six amounts summed, the two per-second rates weighted by
# `weight` (the sub-step over the tick's length). Mirrors the crate-private `BetaOxFlux::accumulate`.
fn _ry_beta_ox_flux_accumulate(t: *RyBetaOxFlux, o: *RyBetaOxFlux, weight: f64) {
    var wt = t;
    var wo = o;
    var k = 0;
    while (k < 6) {
        var x: f64 = load64(wt + 8 * k);
        var y: f64 = load64(wo + 8 * k);
        var s: f64 = x + y;
        store64(wt + 8 * k, load64(&s));
        k = k + 1;
    }
    while (k < 8) {
        var r: f64 = load64(wt + 8 * k);
        var q: f64 = load64(wo + 8 * k);
        var u: f64 = r + q * weight;
        store64(wt + 8 * k, load64(&u));
        k = k + 1;
    }
    return 0;
}

# ── JSON (P7: serde_json's documents) ──

# Appends BetaOxState `p` as serde_json writes it, `{"acyl_coa":…,"free_fatty_acid":…}`, on allocator `a`: Ok(0), or
# Err(RY_ERR_OUT_OF_MEMORY) when the builder could not grow.
#must_use
fn ry_beta_ox_state_to_json_a(a, sb, p: *RyBetaOxState): Result {
    if (_ry_jw_f64_fields(a, sb, p, 2, &_RY_BETA_OX_STATE_FIELDS) != 0) { return Err(RY_ERR_OUT_OF_MEMORY); }
    return Ok(0);
}

# ry_beta_ox_state_to_json_a on the default allocator (a builder from str_builder_new).
#must_use
fn ry_beta_ox_state_to_json(sb, p: *RyBetaOxState): Result {
    return ry_beta_ox_state_to_json_a(default_alloc(), sb, p);
}

# The BetaOxState at node `v` of a parsed document, by serde's rules (as ry_beta_ox_state_from_json_a reads it), into
# the 16 bytes at `w`: 1, or 0 for a refusal (what `w` holds then is unspecified). The metabolic network's readers call
# it for their nested values.
#must_use
fn _ry_beta_ox_state_from_node(v, w): i64 {
    return _ry_jr_f64_fields(v, w, 2, &_RY_BETA_OX_STATE_FIELDS);
}

# Reads a BetaOxState from the `n`-byte document at `buf` by serde's rules (its tree on allocator `a`, which the caller
# resets): Ok(0) with *out filled, or Err(RY_ERR_DESERIALIZE).
#must_use
fn ry_beta_ox_state_from_json_a(a, buf, n, out: *RyBetaOxState): Result {
    var w[16];
    var v = _ry_jr_parse(a, buf, n);
    if (_ry_beta_ox_state_from_node(v, &w) == 0) {
        return Err(_ry_fail_text(RY_ERR_DESERIALIZE, "BetaOxState", 11));
    }
    memcpy(out, &w, 16);
    return Ok(0);
}

# ry_beta_ox_state_from_json_a on the default allocator (the tree is never freed: for a one-off read).
#must_use
fn ry_beta_ox_state_from_json(buf, n, out: *RyBetaOxState): Result {
    return ry_beta_ox_state_from_json_a(default_alloc(), buf, n, out);
}

# Appends BetaOxConfig `p` as serde_json writes it, `{"chain_length":16,"activation_vmax":…,…}` (the chain length an
# unsigned integer), on allocator `a`: Ok(0), or Err(RY_ERR_OUT_OF_MEMORY).
#must_use
fn ry_beta_ox_config_to_json_a(a, sb, p: *RyBetaOxConfig): Result {
    var w = p;
    var name = &_RY_BETA_OX_CONFIG_FIELDS;
    var e = _ry_jw_byte(a, sb, 123);
    e = e | _ry_jw_key(a, sb, name, 1);
    e = e | _ry_jw_u64(a, sb, p.chain_length);
    var k = 1;
    while (k < 6) {
        name = name + strlen(name) + 1;
        e = e | _ry_jw_key(a, sb, name, 0);
        var x: f64 = load64(w + 8 * k);
        e = e | _ry_jw_f64(a, sb, x);
        k = k + 1;
    }
    e = e | _ry_jw_byte(a, sb, 125);
    if (e != 0) { return Err(RY_ERR_OUT_OF_MEMORY); }
    return Ok(0);
}

# ry_beta_ox_config_to_json_a on the default allocator.
#must_use
fn ry_beta_ox_config_to_json(sb, p: *RyBetaOxConfig): Result {
    return ry_beta_ox_config_to_json_a(default_alloc(), sb, p);
}

# The BetaOxConfig at node `v` of a parsed document, by serde's rules (as ry_beta_ox_config_from_json_a reads it), into
# the 48 bytes at `w`: 1, or 0 for a refusal (what `w` holds then is unspecified). The metabolic network's readers call
# it for their nested values.
#must_use
fn _ry_beta_ox_config_from_node(v, w): i64 {
    var form = _ry_jr_form(v, 6);
    var ok = 0;
    if (form != 0) {
        var name = &_RY_BETA_OX_CONFIG_FIELDS;
        ok = _ry_jr_int(_ry_jr_at(v, form, 0, name), 0, 4294967295, w);
        var k = 1;
        while (k < 6 && ok == 1) {
            name = name + strlen(name) + 1;
            if (_ry_jr_f64(_ry_jr_at(v, form, k, name), w + 8 * k) == 0) { ok = 0; }
            k = k + 1;
        }
    }
    return ok;
}

# Reads a BetaOxConfig from the `n`-byte document at `buf` by serde's rules (an object by field name, or an array of its
# six fields; `chain_length` a JSON integer in [0, 2^32), never a float), its tree on allocator `a`: Ok(0) with *out
# filled, or Err(RY_ERR_DESERIALIZE). Serde reads any u32: an odd or short chain is validate's to refuse.
#must_use
fn ry_beta_ox_config_from_json_a(a, buf, n, out: *RyBetaOxConfig): Result {
    var w[48];
    var v = _ry_jr_parse(a, buf, n);
    if (_ry_beta_ox_config_from_node(v, &w) == 0) {
        return Err(_ry_fail_text(RY_ERR_DESERIALIZE, "BetaOxConfig", 12));
    }
    memcpy(out, &w, 48);
    return Ok(0);
}

# ry_beta_ox_config_from_json_a on the default allocator (the tree is never freed: for a one-off read).
#must_use
fn ry_beta_ox_config_from_json(buf, n, out: *RyBetaOxConfig): Result {
    return ry_beta_ox_config_from_json_a(default_alloc(), buf, n, out);
}

# Appends BetaOxFlux `f` as serde_json writes it, its eight fields in declaration order, on allocator `a`: Ok(0), or
# Err(RY_ERR_OUT_OF_MEMORY).
#must_use
fn ry_beta_ox_flux_to_json_a(a, sb, f: *RyBetaOxFlux): Result {
    if (_ry_jw_f64_fields(a, sb, f, 8, &_RY_BETA_OX_FLUX_FIELDS) != 0) { return Err(RY_ERR_OUT_OF_MEMORY); }
    return Ok(0);
}

# ry_beta_ox_flux_to_json_a on the default allocator.
#must_use
fn ry_beta_ox_flux_to_json(sb, f: *RyBetaOxFlux): Result {
    return ry_beta_ox_flux_to_json_a(default_alloc(), sb, f);
}

# The BetaOxFlux at node `v` of a parsed document, by serde's rules (as ry_beta_ox_flux_from_json_a reads it), into the
# 64 bytes at `w`: 1, or 0 for a refusal (what `w` holds then is unspecified). The metabolic network's readers call it
# for their nested values.
#must_use
fn _ry_beta_ox_flux_from_node(v, w): i64 {
    return _ry_jr_f64_fields(v, w, 8, &_RY_BETA_OX_FLUX_FIELDS);
}

# Reads a BetaOxFlux from the `n`-byte document at `buf` by serde's rules (its tree on allocator `a`): Ok(0) with *out
# filled, or Err(RY_ERR_DESERIALIZE).
#must_use
fn ry_beta_ox_flux_from_json_a(a, buf, n, out: *RyBetaOxFlux): Result {
    var w[64];
    var v = _ry_jr_parse(a, buf, n);
    if (_ry_beta_ox_flux_from_node(v, &w) == 0) {
        return Err(_ry_fail_text(RY_ERR_DESERIALIZE, "BetaOxFlux", 10));
    }
    memcpy(out, &w, 64);
    return Ok(0);
}

# ry_beta_ox_flux_from_json_a on the default allocator (the tree is never freed: for a one-off read).
#must_use
fn ry_beta_ox_flux_from_json(buf, n, out: *RyBetaOxFlux): Result {
    return ry_beta_ox_flux_from_json_a(default_alloc(), buf, n, out);
}

# --- amino_catabolism_data.cyr ---

# rasayan — amino_catabolism data: the default pools, routing and kinetic parameters
#
# GENERATED from rasayan 1.2.0's source (rust-old/, the functional spec, read as text). Do not edit.
# Checked: python3 -I -B scripts/oracle/validate.py . (every value against that source)
#
# CarbonSkeletonOutput::default(), AminoCatabState::default() and AminoCatabConfig::default(),
# from rasayan 1.2.0: one f64 const per scalar field, as a round-trip decimal, checked
# against the `Self { … }` literals (the config's routing is CarbonSkeletonOutput::default()).
# tests/golden/amino_catabolism.tsv pins them.

# Fractional output of carbon skeleton routing per unit amino acid catabolized.
#
# Represents the weighted average of all 20 amino acids' carbon skeleton
# destinations, assuming a typical mixed protein composition.
# Rust: rasayan::amino_catabolism::CarbonSkeletonOutput::default()

# Fraction routed to pyruvate.
# Rust: rasayan::amino_catabolism::CarbonSkeletonOutput::default().pyruvate
const RY_AMINO_CATABOLISM_CARBON_SKELETON_OUTPUT_DEFAULT_PYRUVATE = 0.3;

# Fraction routed to acetyl-CoA.
# Rust: rasayan::amino_catabolism::CarbonSkeletonOutput::default().acetyl_coa
const RY_AMINO_CATABOLISM_CARBON_SKELETON_OUTPUT_DEFAULT_ACETYL_COA = 0.15;

# Fraction routed to α-ketoglutarate.
# Rust: rasayan::amino_catabolism::CarbonSkeletonOutput::default().alpha_kg
const RY_AMINO_CATABOLISM_CARBON_SKELETON_OUTPUT_DEFAULT_ALPHA_KG = 0.25;

# Fraction routed to succinyl-CoA.
