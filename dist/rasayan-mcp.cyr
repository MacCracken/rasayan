# Metabolic state tracking ATP/ADP balance and pathway activity.
# Rust: rasayan::metabolism::MetabolicState::default()

# ATP concentration (mM, typical resting: 5-8 mM).
# Rust: rasayan::metabolism::MetabolicState::default().atp
const RY_METABOLISM_METABOLIC_STATE_DEFAULT_ATP = 6.0;

# Low-energy adenylate, ADP + AMP (mM).
#
# ATP hydrolysis adds to this pool and regeneration draws on it, so
# `atp + adp` is the total adenylate. Adenylate kinase splits it into
# free ADP and AMP ([`free_adp`](Self::free_adp),
# [`amp`](Self::amp)); at the usual ATP/ADP ratios nearly all of it is
# ADP (≈ 97 % in the default state).
# Rust: rasayan::metabolism::MetabolicState::default().adp
const RY_METABOLISM_METABOLIC_STATE_DEFAULT_ADP = 0.5;

# NAD+/NADH ratio (higher = more oxidized, typical: 700).
# Rust: rasayan::metabolism::MetabolicState::default().nad_ratio
const RY_METABOLISM_METABOLIC_STATE_DEFAULT_NAD_RATIO = 700.0;

# Glucose available (mM, typical blood: 4-6 mM).
# Rust: rasayan::metabolism::MetabolicState::default().glucose
const RY_METABOLISM_METABOLIC_STATE_DEFAULT_GLUCOSE = 5.0;

# Oxygen available (normalized, 1.0 = normoxia).
# Rust: rasayan::metabolism::MetabolicState::default().oxygen
const RY_METABOLISM_METABOLIC_STATE_DEFAULT_OXYGEN = 1.0;

# Lactate concentration (mM, typical resting: 0.5-2.0).
# Rust: rasayan::metabolism::MetabolicState::default().lactate
const RY_METABOLISM_METABOLIC_STATE_DEFAULT_LACTATE = 1.0;

# --- metabolism.cyr ---

# metabolism.cyr — the metabolic state: ATP/ADP balance, the adenylate-kinase AMP, the energy charge, ATP use and
# regeneration (Rust 1.2.0's `metabolism.rs`, transcribed).
#
# Concentrations in mM, oxygen normalized (1.0 = normoxia), time in seconds. Every operation is in Rust's order:
# tests/golden/metabolism.tsv compares each method with the oracle's at ≤ 2 ulp where only + − × ÷ and √ run (class B,
# expected 0), at 0 ulp against the corrected oracle where regenerate_atp's lactate clearance calls `exp_m1` (class C,
# ADR 0003: `_ry_cr_expm1`), and bit for bit over the trajectory scripts (class T).
#
# The Cyrius forms (ADR 0002 rows 7, 10):
# - MetabolicState is a struct (RyMetabolicState); its methods take a pointer, and the two mutators update it in place:
#   `ry_metabolic_state_regenerate_atp(&m, dt)`; consume_atp returns the ATP it consumed;
# - `MetabolicState::default()`'s values are generated consts (src/metabolism_data.cyr,
#   `RY_METABOLISM_METABOLIC_STATE_DEFAULT_*`), which ry_metabolic_state_default(&out) fills a struct from;
# - the private `scaled_adenylates`'s `Option<(f64, f64, f64, f64)>` is _ry_metabolism_scaled_adenylates's 1 with four
#   f64s in a caller buffer, or 0 for None;
# - Rust's two `tracing::trace!` events (`consume_atp`, `regenerate_atp`) are level-gated sakshi events under the
#   target `rasayan::metabolism`, their fields in Rust's order;
# - MetabolicState's serde codec is `ry_metabolic_state_to_json` / `_from_json` (and `_a`, on an allocator).

# Metabolic state: ATP/ADP balance and pathway activity. `adp` is the low-energy adenylate pool, ADP + AMP (ATP
# hydrolysis adds to it, regeneration draws on it: `atp + adp` is the total adenylate); adenylate kinase splits it into
# free ADP and AMP (ry_metabolic_state_free_adp, ry_metabolic_state_amp). Rust's `MetabolicState`.
struct RyMetabolicState {
    atp: f64;
    adp: f64;
    nad_ratio: f64;
    glucose: f64;
    oxygen: f64;
    lactate: f64;
}

# The NUL-separated field names, in Rust's declaration order (validation, JSON).
var _RY_METABOLIC_STATE_FIELDS = "atp\0adp\0nad_ratio\0glucose\0oxygen\0lactate\0";

# Fills *out with the default state (RY_METABOLISM_METABOLIC_STATE_DEFAULT_*: ATP 6, ADP + AMP 0.5, NAD+/NADH 700,
# glucose 5, oxygen 1, lactate 1). Mirrors `MetabolicState::default()`.
fn ry_metabolic_state_default(out: *RyMetabolicState) {
    var atp: f64 = RY_METABOLISM_METABOLIC_STATE_DEFAULT_ATP;
    var adp: f64 = RY_METABOLISM_METABOLIC_STATE_DEFAULT_ADP;
    var nad: f64 = RY_METABOLISM_METABOLIC_STATE_DEFAULT_NAD_RATIO;
    var glucose: f64 = RY_METABOLISM_METABOLIC_STATE_DEFAULT_GLUCOSE;
    var oxygen: f64 = RY_METABOLISM_METABOLIC_STATE_DEFAULT_OXYGEN;
    var lactate: f64 = RY_METABOLISM_METABOLIC_STATE_DEFAULT_LACTATE;
    out.atp = atp;
    out.adp = adp;
    out.nad_ratio = nad;
    out.glucose = glucose;
    out.oxygen = oxygen;
    out.lactate = lactate;
    return 0;
}

# Ok(0) when every field is finite and >= 0; else, in Rust's order, the first of atp, adp, glucose, oxygen and lactate
# that `_ry_guard_non_negative` refuses, then nad_ratio: Err(RY_ERR_NON_FINITE), or Err(RY_ERR_INVALID_PARAMETER)
# below 0 ("must be non-negative"). Mirrors `MetabolicState::validate`.
#must_use
fn ry_metabolic_state_validate(p: *RyMetabolicState): Result {
    var w = p;                                   # a plain address: `p + n` would step n · 48 bytes
    var name = _RY_METABOLIC_STATE_FIELDS;
    var k = 0;
    while (k < 6) {
        if (k != 2) {                            # nad_ratio is checked last, by its own rule
            var value: f64 = load64(w + 8 * k);
            var t, v = _ry_guard_non_negative(name, value);
            if (is_err_result(t) == 1) { return Err(v); }
        }
        name = name + strlen(name) + 1;
        k = k + 1;
    }
    var nad: f64 = p.nad_ratio;
    var tf, vf = _ry_guard_finite("nad_ratio", nad);
    if (is_err_result(tf) == 1) { return Err(vf); }
    if (nad < 0.0) {
        return Err(_ry_fail_f(RY_ERR_INVALID_PARAMETER, "nad_ratio", nad, "must be non-negative", 0, 0.0));
    }
    return Ok(0);
}

# ── the adenylates ──

# The adenylate pools divided by s = max(ATP, adp), with the AMP share of adp from the adenylate-kinase equilibrium:
# 1 with out[0..4] = (s, t, l, a), t = ATP/s, l = adp/s, a = AMP/s; 0 (out untouched) when both pools are 0. With
# L = adp held fixed, `ATP·AMP = K′·(L − AMP)²` has the root `AMP = 2K′L² / (2K′L + ATP + √(ATP² + 4K′L·ATP))` in
# [0, L], the cancellation-free form, evaluated on the scaled pools (one of t, l is exactly 1: nothing overflows).
# NaN, infinite or negative pools count as 0. Mirrors metabolism.rs's private `scaled_adenylates`.
fn _ry_metabolism_scaled_adenylates(p: *RyMetabolicState, out): i64 {
    var atp_in: f64 = p.atp;
    var adp_in: f64 = p.adp;
    var atp: f64 = _ry_guard_conc(atp_in);
    var pool: f64 = _ry_guard_conc(adp_in);
    var scale: f64 = _ry_max(atp, pool);
    if (scale <= 0.0) { return 0; }
    var t: f64 = atp / scale;
    var l: f64 = pool / scale;
    var two_k: f64 = 2.0 * RY_METABOLISM_ADENYLATE_KINASE_KEQ;
    var two_k_l: f64 = two_k * l;
    var tt: f64 = t * t;
    var cross: f64 = 2.0 * two_k_l;
    var disc: f64 = tt + cross * t;
    var root: f64 = f64_sqrt(disc);
    var den: f64 = two_k_l + t + root;
    var num: f64 = two_k_l * l;
    var a: f64 = num / den;
    store64(out, load64(&scale));
    store64(out + 8, load64(&t));
    store64(out + 16, load64(&l));
    store64(out + 24, load64(&a));
    return 1;
}

# The AMP concentration (mM) the adenylate-kinase equilibrium implies: the adp pool split so that
# `ATP·AMP = RY_METABOLISM_ADENYLATE_KINASE_KEQ · ADP²` holds for the free ADP. Always finite and in [0, adp]: with no
# ATP the whole pool is AMP, with no pool it is 0. Mirrors `MetabolicState::amp`.
#must_use
#pure
fn ry_metabolic_state_amp(p: *RyMetabolicState): f64 {
    var s[32];
    if (_ry_metabolism_scaled_adenylates(p, &s) == 0) { return 0.0; }
    var scale: f64 = load64(&s);
    var a: f64 = load64(&s + 24);
    var r: f64 = scale * a;
    return r;
}

# The free ADP concentration (mM): the adp pool minus the AMP. Mirrors `MetabolicState::free_adp`.
#must_use
#pure
fn ry_metabolic_state_free_adp(p: *RyMetabolicState): f64 {
    var s[32];
    if (_ry_metabolism_scaled_adenylates(p, &s) == 0) { return 0.0; }
    var scale: f64 = load64(&s);
    var l: f64 = load64(&s + 16);
    var a: f64 = load64(&s + 24);
    var r: f64 = scale * (l - a);
    return r;
}

# The Atkinson energy charge, (ATP + ½ADP) / (ATP + ADP + AMP) with the free ADP and AMP, so the denominator is the
# total adenylate atp + adp: in [0, 1], 1 with all adenylate as ATP, 0 with no ATP; 0 with no adenylate at all. Always
# finite (NaN, infinite or negative pools count as 0). Mirrors `MetabolicState::energy_charge`.
#must_use
#pure
fn ry_metabolic_state_energy_charge(p: *RyMetabolicState): f64 {
    var s[32];
    if (_ry_metabolism_scaled_adenylates(p, &s) == 0) { return 0.0; }
    var t: f64 = load64(&s + 8);
    var l: f64 = load64(&s + 16);
    var a: f64 = load64(&s + 24);
    var free: f64 = l - a;
    var num: f64 = t + 0.5 * free;
    var r: f64 = num / (t + l);
    return r;
}

# ── rates ──

# The net ATP yield per glucose at the current oxygen level, `2 + 28 · O2` with O2 clamped to [0, 1] (NaN as 0): 2 ATP
# from glycolysis alone up to 30 with full oxidative phosphorylation. Mirrors `MetabolicState::aerobic_atp_yield`.
#must_use
#pure
fn ry_metabolic_state_aerobic_atp_yield(p: *RyMetabolicState): f64 {
    var oxygen: f64 = p.oxygen;
    var o2: f64 = _ry_guard_unit(oxygen);
    var r: f64 = 2.0 + 28.0 * o2;
    return r;
}

# 1 when anaerobic metabolism dominates (oxygen below 0.5 or lactate above 4 mM), else 0. Mirrors
# `MetabolicState::is_anaerobic`.
#must_use
#pure
fn ry_metabolic_state_is_anaerobic(p: *RyMetabolicState): i64 {
    var oxygen: f64 = p.oxygen;
    var lactate: f64 = p.lactate;
    if (oxygen < 0.5 || lactate > 4.0) { return 1; }
    return 0;
}

# The metabolic rate relative to basal (1.0 = basal), driven by the ADP share (the demand signal) and capped at 10.
# Mirrors `MetabolicState::metabolic_rate`.
#must_use
#pure
fn ry_metabolic_state_metabolic_rate(p: *RyMetabolicState): f64 {
    var atp: f64 = p.atp;
    var adp: f64 = p.adp;
    var eps: f64 = 0x3CB0000000000000;
    var demand: f64 = adp / (atp + adp + eps);
    var x: f64 = 1.0 + demand * 5.0;
    var r: f64 = _ry_min(x, 10.0);
    return r;
}

# ── ATP use and regeneration ──

# Consumes `amount` ATP for work, converting it to ADP one for one (atp + adp is conserved), and returns what was
# consumed: no more than the ATP there is. A negative, NaN or infinite amount consumes nothing. Mirrors
# `MetabolicState::consume_atp`.
fn ry_metabolic_state_consume_atp(p: *RyMetabolicState, amount: f64): f64 {
    var atp: f64 = p.atp;
    if (_ry_trace_on() == 1) {
        var h[24];
        var b[256];
        var e = _ry_ev(&h, &b, 256, "rasayan::metabolism", "consume_atp");
        _ry_ev_f(e, "amount", amount);
        _ry_ev_f(e, "atp_before", atp);
        _ry_trace(e);
    }
    var want: f64 = _ry_guard_conc(amount);
    var have: f64 = _ry_guard_conc(atp);
    var consumed: f64 = _ry_min(want, have);
    var adp: f64 = p.adp;
    var a2: f64 = atp - consumed;
    var d2: f64 = adp + consumed;
    p.atp = a2;
    p.adp = d2;
    return consumed;
}

# Regenerates ATP from ADP over `dt` seconds. Oxygen sets the yield per glucose, `2 + 28 · O2`; the rate scales with
# the same yield and the metabolic rate, is capped by the ADP pool and by what the glucose can supply, and consumes
# regen / yield glucose. The anaerobic share (1 − O2) of that glucose becomes lactate (2 per glucose), after lactate
# clears first-order at RY_METABOLISM_LACTATE_CLEARANCE_RATE · O2. atp + adp is conserved. A non-finite or
# non-positive dt does nothing. Mirrors `MetabolicState::regenerate_atp`.
fn ry_metabolic_state_regenerate_atp(p: *RyMetabolicState, dt: f64) {
    if (_ry_guard_valid_dt(dt) == 0) { return 0; }
    var atp: f64 = p.atp;
    var adp_in: f64 = p.adp;
    var oxygen: f64 = p.oxygen;
    if (_ry_trace_on() == 1) {
        var h[24];
        var b[256];
        var e = _ry_ev(&h, &b, 256, "rasayan::metabolism", "regenerate_atp");
        _ry_ev_f(e, "dt", dt);
        _ry_ev_f(e, "atp_before", atp);
        _ry_ev_f(e, "adp_before", adp_in);
        _ry_ev_f(e, "oxygen", oxygen);
        _ry_trace(e);
    }
    var o2: f64 = _ry_guard_unit(oxygen);
    var adp: f64 = _ry_guard_conc(adp_in);
    var glucose_in: f64 = p.glucose;
    var glucose: f64 = _ry_guard_conc(glucose_in);
    var atp_per_glc: f64 = 2.0 + 28.0 * o2;
    var mr: f64 = ry_metabolic_state_metabolic_rate(p);
    var eff: f64 = atp_per_glc / 30.0;
    var rate: f64 = mr * 0.5 * eff * dt;
    var cap: f64 = glucose * atp_per_glc;
    var r1: f64 = _ry_min(rate, adp);
    var regen: f64 = _ry_min(r1, cap);
    var used: f64 = regen / atp_per_glc;
    var a2: f64 = atp + regen;
    var d2: f64 = adp - regen;
    var g1: f64 = glucose - used;
    var g2: f64 = _ry_max(g1, 0.0);
    p.atp = a2;
    p.adp = d2;
    p.glucose = g2;
    var lac_in: f64 = p.lactate;
    var lac: f64 = _ry_guard_conc(lac_in);
    var k: f64 = RY_METABOLISM_LACTATE_CLEARANCE_RATE * o2;
    var cleared: f64 = _ry_integrate_relax(lac, 0.0, k, dt);
    var anaerobic: f64 = 2.0 * (1.0 - o2);
    var made: f64 = anaerobic * used;
    var l2: f64 = cleared + made;
    p.lactate = l2;
    return 0;
}

# ── JSON (P7: serde_json's documents) ──

# Appends MetabolicState `p` as serde_json writes it,
# `{"atp":…,"adp":…,"nad_ratio":…,"glucose":…,"oxygen":…,"lactate":…}`, on allocator `a`: Ok(0), or
# Err(RY_ERR_OUT_OF_MEMORY) when the builder could not grow.
#must_use
fn ry_metabolic_state_to_json_a(a, sb, p: *RyMetabolicState): Result {
    if (_ry_jw_f64_fields(a, sb, p, 6, _RY_METABOLIC_STATE_FIELDS) != 0) { return Err(RY_ERR_OUT_OF_MEMORY); }
    return Ok(0);
}

# ry_metabolic_state_to_json_a on the default allocator (a builder from str_builder_new).
#must_use
fn ry_metabolic_state_to_json(sb, p: *RyMetabolicState): Result {
    return ry_metabolic_state_to_json_a(default_alloc(), sb, p);
}

# Reads a MetabolicState from the `n`-byte document at `buf` by serde's rules (its tree on allocator `a`, which the
# caller resets): Ok(0) with *out filled, or Err(RY_ERR_DESERIALIZE).
#must_use
fn ry_metabolic_state_from_json_a(a, buf, n, out: *RyMetabolicState): Result {
    var w[48];
    var v = _ry_jr_parse(a, buf, n);
    if (_ry_jr_f64_fields(v, &w, 6, _RY_METABOLIC_STATE_FIELDS) == 0) {
        return Err(_ry_fail_text(RY_ERR_DESERIALIZE, "MetabolicState", 14));
    }
    memcpy(out, &w, 48);
    return Ok(0);
}

# ry_metabolic_state_from_json_a on the default allocator (the tree is never freed: for a one-off read).
#must_use
fn ry_metabolic_state_from_json(buf, n, out: *RyMetabolicState): Result {
    return ry_metabolic_state_from_json_a(default_alloc(), buf, n, out);
}

# --- energy_data.cyr ---

# rasayan — energy data: the default bioenergetic state
#
# GENERATED by scripts/oracle from rasayan 1.2.0 (rust-old/). Do not edit.
# Regenerate: cargo run --release --locked --manifest-path scripts/oracle/Cargo.toml
#
# BioenergyState::default(), from the oracle's API: one f64 const per field, as a
# round-trip decimal, checked against the `Self { … }` literal of
