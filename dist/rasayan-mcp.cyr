    var name = &_RY_SIGNALING_CONFIG_FIELDS;
    var k = 0;
    while (k < 4) {
        name = name + strlen(name) + 1;
        k = k + 1;
    }
    while (k < 7) {
        if (_ry_jr_f64(_ry_jr_at(v, form, k, name), w + _RY_SIGCFG_GAINS + 8 * (k - 4)) == 0) { return 0; }
        name = name + strlen(name) + 1;
