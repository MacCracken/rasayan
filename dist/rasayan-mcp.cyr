#
# CalciumState::default() and CalciumConfig::default(), from rasayan 1.2.0: one f64 const per
# field, as a round-trip decimal, checked against the `Self { … }` literals.
# tests/golden/calcium.tsv pins them.

# Calcium oscillation state.
# Rust: rasayan::calcium::CalciumState::default()

# Cytoplasmic Ca2+ concentration (uM). Resting ~0.1 uM, peak ~1-10 uM.
# Rust: rasayan::calcium::CalciumState::default().cytoplasmic_ca
const RY_CALCIUM_CALCIUM_STATE_DEFAULT_CYTOPLASMIC_CA = 0.1;

# ER Ca2+ concentration (uM, per ER volume). Resting ~500 uM.
# Rust: rasayan::calcium::CalciumState::default().er_ca
const RY_CALCIUM_CALCIUM_STATE_DEFAULT_ER_CA = 500.0;

# IP3R channel open fraction (0.0-1.0).
# Rust: rasayan::calcium::CalciumState::default().ip3r_open
const RY_CALCIUM_CALCIUM_STATE_DEFAULT_IP3R_OPEN = 0.01;

# CalciumState's field names, NUL-separated, in declaration order.
