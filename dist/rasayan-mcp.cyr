# Checked: python3 -I -B scripts/oracle/validate.py . (every value against that source)
#
# MapkState::default() and MapkConfig::default(), from rasayan 1.2.0: one f64 const per
# field, as a round-trip decimal, checked against the `Self { … }` literals.
# tests/golden/mapk.tsv pins them.

# MAPK cascade activation state.
#
# Each kinase level tracks the fraction in active (phosphorylated) form
# (0.0-1.0). MEK and ERK follow the quasi-steady state of distributive dual
# phosphorylation (see the module docs); the mono-phosphorylated
# intermediates are not tracked.
# Rust: rasayan::mapk::MapkState::default()

# Ras-GTP fraction (0.0-1.0). Activated by receptor/SOS.
# Rust: rasayan::mapk::MapkState::default().ras_gtp
const RY_MAPK_MAPK_STATE_DEFAULT_RAS_GTP = 0.05;

# Raf active fraction (0.0-1.0). Phosphorylated by Ras-GTP.
# Rust: rasayan::mapk::MapkState::default().raf_active
const RY_MAPK_MAPK_STATE_DEFAULT_RAF_ACTIVE = 0.02;

# Active (doubly phosphorylated) MEK fraction (0.0-1.0).
# Rust: rasayan::mapk::MapkState::default().mek_pp
const RY_MAPK_MAPK_STATE_DEFAULT_MEK_PP = 0.01;

# Active (doubly phosphorylated) ERK fraction (0.0-1.0). Primary output.
# Rust: rasayan::mapk::MapkState::default().erk_pp
